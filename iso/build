#!/usr/bin/env bash
# Builds the mazapan ISO: Arch's own live profile (archiso's releng) with a
# desktop live session on top (iso/airootfs), and mazapan as a package
# (pkg/PKGBUILD) from this checkout, in a repository of the ISO's own.
#
#   iso/build [outdir]     default: out/ in the checkout
#
# On Arch, with archiso, as a user with sudo (makepkg won't run as root);
# the dev VM does it: vm/vm iso. Build core first (core/build): the package
# takes bin/mazapan as it is.
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
out="${1:-$repo/out}"
work="${MAZAPAN_ISO_WORK:-/var/tmp/mazapan-iso}"
releng=/usr/share/archiso/configs/releng

log() { printf '\e[1;35m[iso]\e[0m %s\n' "$*"; }
die() { printf '\e[1;31m[iso]\e[0m %s\n' "$*" >&2; exit 1; }

[[ $EUID -ne 0 ]] || die "run as a user with sudo, not root"
[[ -d $releng ]] || die "needs archiso (pacman -S archiso)"
[[ -x $repo/bin/mazapan ]] || die "no bin/mazapan: core/build first"

sudo rm -rf "$work"
mkdir -p "$work"/{pkg,repo} "$out"

# MAZAPAN_REPO_SERVER and MAZAPAN_KEYS reach the packages (a test
# repository and its key, in the VMs): see pkg/PKGBUILD.
# Every package of Mazapán's own: pkg/PKGBUILD, and each pkg/*/PKGBUILD.
for p in mazapan $(cd "$repo/pkg" && ls -d */ | tr -d / | while read -r d; do [[ -f $d/PKGBUILD ]] && echo "$d"; done); do
  log "$p package"
  d="$work/pkg/$p"
  mkdir -p "$d"
  if [[ $p == mazapan ]]; then cp "$repo/pkg/PKGBUILD" "$d/"; else cp "$repo/pkg/$p"/* "$d/"; fi
  (cd "$d" && MAZAPAN_REPO="$repo" BUILDDIR="$d/build" PKGDEST="$work/repo" \
    SRCDEST="$d" LOGDEST="$d" PKGEXT=.pkg.tar.zst makepkg --nodeps --force --noconfirm --nosign >"$d/makepkg.log" 2>&1) \
    || { tail -20 "$d/makepkg.log" >&2; die "makepkg $p failed"; }
done
repo-add -q "$work/repo/mazapan.db.tar.gz" "$work"/repo/*.pkg.tar.zst

# Arch's repositories, and this one: to build with (mkarchiso), and to fill
# the offline repository from.
conf="$work/pacman.conf"
sed '/^\[mazapan\]/,$d' "$releng/pacman.conf" > "$conf"
cat >> "$conf" <<CONF

[mazapan]
SigLevel = Optional TrustAll
Server = file://$work/repo
CONF

# The offline repository: everything an install puts on the disk, with
# every dependency (an empty database, so none counts as installed), so the
# install downloads nothing. It's the live system's only repository too.
log "offline repository"
offline="$work/offline"
mkdir -p "$offline" "$work/offline-db"
mapfile -t target < <(sed -e 's/#.*//' -e '/^\s*$/d' "$repo/iso/target-packages.txt")
sudo pacman --config "$conf" --dbpath "$work/offline-db" --cachedir "$offline" -Syw --noconfirm "${target[@]}" \
  >"$work/offline.log" 2>&1 || { tail -20 "$work/offline.log" >&2; die "downloading the offline repository failed"; }
sudo rm -rf "$work/offline-db"
sudo chown -R "$(id -u):$(id -g)" "$offline"
rm -f "$offline"/*.sig
repo-add -q "$offline/offline.db.tar.gz" "$offline"/*.pkg.tar.zst
log "offline repository: $(ls "$offline"/*.pkg.tar.zst | wc -l) packages, $(du -sh "$offline" | cut -f1)"

log "profile"
cp -a "$releng" "$work/profile"
p="$work/profile"
cp -a "$repo/iso/airootfs/." "$p/airootfs/"

# The network: NetworkManager (what the shell's Wi-Fi talks to) instead of
# releng's systemd-networkd and iwd.
w="$p/airootfs/etc/systemd/system"
rm -f "$w"/multi-user.target.wants/{iwd,systemd-networkd}.service "$w"/sockets.target.wants/systemd-networkd.socket \
  "$w"/network-online.target.wants/systemd-networkd-wait-online.service "$w"/dbus-org.freedesktop.network1.service
rm -rf "$w"/systemd-networkd-wait-online.service.d
ln -s /usr/lib/systemd/system/NetworkManager.service "$w/multi-user.target.wants/NetworkManager.service"
ln -s /usr/lib/systemd/system/NetworkManager-dispatcher.service "$w/dbus-org.freedesktop.nm-dispatcher.service"
mkdir -p "$w/network-online.target.wants"
ln -s /usr/lib/systemd/system/NetworkManager-wait-online.service "$w/network-online.target.wants/NetworkManager-wait-online.service"

sed -e '/^#/d' -e '/^\s*$/d' "$repo/iso/packages.txt" >> "$p/packages.x86_64"
cp "$conf" "$p/pacman.conf"
mkdir -p "$p/airootfs/var/cache/mazapan"
cp -a "$offline" "$p/airootfs/var/cache/mazapan/offline"

sed -i -e 's/^iso_name=.*/iso_name="mazapan"/' \
  -e 's/^iso_label=.*/iso_label="MAZAPAN_$(date --date="@${SOURCE_DATE_EPOCH:-$(date +%s)}" +%Y%m)"/' \
  -e 's/^iso_publisher=.*/iso_publisher="mazapan"/' \
  -e 's/^iso_application=.*/iso_application="mazapan live and installer"/' "$p/profiledef.sh"
# zstd, not xz: a little bigger, much faster to build and to boot from.
sed -i "s/^airootfs_image_tool_options=.*/airootfs_image_tool_options=('-comp' 'zstd' '-Xcompression-level' '15' '-b' '1M')/" "$p/profiledef.sh"
cat >> "$p/profiledef.sh" <<'CONF'
file_permissions+=(
  ["/home/live/"]="1000:1000:750"
  ["/etc/sudoers.d"]="0:0:750"
  ["/etc/sudoers.d/mazapan-live"]="0:0:440"
  ["/usr/local/bin/mazapan-unattended"]="0:0:755"
  ["/usr/local/bin/mazapan-install-text"]="0:0:755"
)
CONF
# The boot menus say what this is.
sed -i 's/Arch Linux install medium/mazapan/' "$p"/efiboot/loader/entries/*.conf "$p"/syslinux/*.cfg "$p"/grub/*.cfg
# Run from the stick, not copied to memory: archiso copies its 4 GB image to
# RAM when it thinks there's room, and on an 8 GB machine the live desktop
# and the install then run out of it (the install stalls).
sed -i 's/archisosearchuuid=%ARCHISO_UUID%/& copytoram=n/' "$p"/efiboot/loader/entries/*.conf "$p"/syslinux/*.cfg "$p"/grub/*.cfg
grep -q 'copytoram=n' "$p"/efiboot/loader/entries/*.conf || die "the boot entries changed: copytoram=n wasn't added"

log "mkarchiso (a few minutes)"
sudo mkarchiso -v -w "$work/mkarchiso" -o "$out" "$p" >"$work/mkarchiso.log" 2>&1 \
  || { tail -30 "$work/mkarchiso.log" >&2; die "mkarchiso failed (log: $work/mkarchiso.log)"; }
sudo rm -rf "$work/mkarchiso"
iso=$(ls -t "$out"/mazapan-*.iso | head -1)
log "built $iso ($(du -h "$iso" | cut -f1))"
