#!/usr/bin/env bash
# ask() assigns its answers with printf -v, which shellcheck doesn't follow.
# shellcheck disable=SC2154
# The installer in text, for when the live desktop can't start (graphics
# the ISO's drivers don't handle yet): the same questions as the graphical
# one, the same answers file, the same `mazapan install run`. The disk is
# encrypted, with a recovery key shown at the end: write it down.
set -uo pipefail

bold=$'\e[1m' dim=$'\e[2m' amber=$'\e[33m' green=$'\e[32m' red=$'\e[31m' off=$'\e[0m'
ask() { # ask VAR "question" [default]
  local v
  read -r -p "$2${3:+ ${dim}[$3]${off}}: " v
  printf -v "$1" '%s' "${v:-${3:-}}"
}

echo "${bold}Mazapán: install in text${off}"
echo "Everything on the disk you pick is erased. Ctrl+C stops at any question."
echo

mapfile -t disks < <(mazapan install disks --json | jq -r '.[] | select(.too_small | not) | "\(.path)\t\(.size)\t\(.model)\t\(.systems | join(","))"')
if [[ ${#disks[@]} -eq 0 ]]; then
  echo "${red}No disk big enough to install on.${off}"
  exit 1
fi
echo "${bold}Disks${off}"
for i in "${!disks[@]}"; do
  IFS=$'\t' read -r path size model systems <<<"${disks[$i]}"
  printf '  %d) %-14s %6s GB  %s%s\n' $((i + 1)) "$path" $((size / 1000000000)) "${model:--}" "${systems:+  (has $systems)}"
done
while :; do
  ask n "Install on" 1
  [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#disks[@]} )) && break
done
disk=$(cut -f1 <<<"${disks[$((n - 1))]}")

echo
ask fullname "Your name" ""
while :; do
  ask user "User name (lowercase)" "$(tr '[:upper:]' '[:lower:]' <<<"${fullname%% *}" | tr -cd 'a-z0-9_-')"
  [[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && break
  echo "  lowercase letters, digits, - and _, starting with a letter"
done
while :; do
  read -r -s -p "Password (the disk's and the account's): " pass; echo
  read -r -s -p "Again: " pass2; echo
  [[ ${#pass} -ge 8 && $pass == "$pass2" ]] && break
  echo "  ${amber}They don't match, or it's shorter than 8 characters (it opens the disk, the account and the keyring).${off}"
done

echo
echo "Language: en, es, pt, fr, de"
ask lang "Language" "en"
case $lang in es) locale=es_ES.UTF-8 ;; pt) locale=pt_BR.UTF-8 ;; fr) locale=fr_FR.UTF-8 ;; de) locale=de_DE.UTF-8 ;; *) lang=en; locale=en_US.UTF-8 ;; esac
echo "Keyboard: us, latam, es, br, fr, de… (as typed at the disk's password too)"
while :; do
  ask kb "Keyboard layout" "us"
  [[ -f /usr/share/X11/xkb/symbols/$kb ]] && break
  echo "  ${amber}No layout called $kb.${off}"
done
while :; do
  ask tz "Time zone (Region/City, e.g. America/Mexico_City)" "UTC"
  [[ -f /usr/share/zoneinfo/$tz ]] && break
  echo "  ${amber}No time zone called $tz.${off}"
done

echo
echo "${bold}About to install${off} on $disk (erased), for $fullname ($user), $lang, keyboard $kb, $tz; the disk encrypted."
ask go "Type yes to go ahead" ""
[[ $go == yes ]] || { echo "Nothing was done."; exit 1; }

# Yours alone (the password is in it), gone at the end.
tmp=${XDG_RUNTIME_DIR:-/tmp}
answers=$(umask 077; mktemp "$tmp/mazapan-text-XXXXXX.json") || { echo "${red}Can't write in $tmp.${off}"; exit 1; }
jq -n --arg disk "$disk" --arg user "$user" --arg full "$fullname" --arg pass "$pass" --arg tz "$tz" \
  --arg lang "$lang" --arg locale "$locale" --arg kb "$kb" \
  '{disk: $disk, encrypt: true, user: $user, fullname: $full, password: $pass, timezone: $tz,
    language: $lang, locale: $locale, kb_layout: $kb, kb_variant: "", apps: []}' > "$answers"
unset pass pass2

echo
log=$(umask 077; mktemp "$tmp/mazapan-text-XXXXXX.log")
sudo mazapan install run "$answers" 2>&1 | tee "$log" | while IFS= read -r l; do
  case $l in
    "step "*) echo "  ${l#step }…" ;;
    "fail "*) echo "${red}${l#fail }${off}" ;;
  esac
done
code=${PIPESTATUS[0]}
rm -f "$answers"
if [[ $code != 0 ]]; then
  echo "${red}The install failed.${off} What happened: /var/log/mazapan-install.log"
  exit "$code"
fi
key=$(sed -n 's/^recovery //p' "$log")
rm -f "$log"
echo
echo "${green}${bold}Installed.${off}"
if [[ -n $key ]]; then
  echo "${bold}Your recovery key${off} opens the disk if you forget the password. Write it down now:"
  echo
  echo "    ${bold}$key${off}"
  echo
  command -v qrencode >/dev/null && qrencode -t ansiutf8 "$key"
fi
echo "Take the USB stick out and restart: sudo reboot"
