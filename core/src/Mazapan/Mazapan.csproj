<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mazapan</AssemblyName>
    <RootNamespace>Mazapan</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- core/build sets it from pkg/version; built without it, a dev build. -->
    <InformationalVersion>0.0.0-dev</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mazapan.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Scriban" Version="7.5.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>
</Project>
