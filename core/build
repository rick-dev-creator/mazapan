#!/bin/sh
# Builds bin/mazapan: one native binary (.NET Native AOT), nothing to install
# next to it. Needs the .NET 10 SDK and clang.
#   core/build          build
#   core/build test     run the tests first
set -e
cd "$(dirname "$0")"
if [ "$1" = test ]; then
  dotnet test tests/Mazapan.Tests --nologo -v q
fi
# The version `mazapan --version` says: the package's (pkg/version).
version=$(../pkg/version)
dotnet publish src/Mazapan -c Release -r linux-x64 -o obj/publish --nologo -v q -p:InformationalVersion="$version"
mkdir -p ../bin
install -m 755 obj/publish/mazapan ../bin/mazapan
echo "built ../bin/mazapan $version"
