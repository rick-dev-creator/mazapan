#!/usr/bin/env bash
# Dev VM for my-arch: official Arch cloud image + cloud-init, repo shared
# live over 9p at /home/arch/my-arch.
#
#   vm/vm create      download base image, build overlay disk + seed
#   vm/vm start       boot with a GL window (virtio-vga-gl)
#   vm/vm headless    boot without a window (provisioning, CI)
#   vm/vm wait        block until SSH is up and cloud-init has finished
#   vm/vm ssh [cmd]   shell (or command) in the guest as user "arch"
#   vm/vm provision   re-run vm/guest/provision.sh (after editing packages)
#   vm/vm run <cmd>   run a command inside the guest's Hyprland session
#   vm/vm exec <cmd>  launch an app through Hyprland (outlives the SSH call)
#   vm/vm key <combo> press keys as the guest keyboard, e.g. meta_l-equal
#   vm/vm mouse ...   move / press / drag the guest pointer, in layout pixels:
#                     move X Y | down | up | click X Y | rclick X Y | mclick X Y
#                     | wheel X Y up|down [notches] | drag X1 Y1 X2 Y2 [ms]
#   vm/vm shot [file] screenshot of the guest desktop (default vm/.state/shot.png)
#   vm/vm screen [file] the screen as QEMU sees it (boot, GRUB, the disk's
#                     password), when started with MAZAPAN_VGA=std
#   vm/vm stop        power off
#   vm/vm reset       throw away the overlay and seed: fresh first boot
#   vm/vm destroy     delete all VM state, including the base image
#   vm/vm iso         build the ISO inside this VM (iso/build) into vm/.state/iso
#
# A second VM, to try the ISO: UEFI, a blank disk, the newest ISO in
# vm/.state/iso as its CD (or $MAZAPAN_ISO). The same commands after "try",
# as root over SSH; run/exec/shot act in the live session's desktop.
#   vm/vm try start | headless | wait | ssh | run | exec | key | mouse | shot | stop | reset
# Once installed: MAZAPAN_TRY_USER=<the account> vm/vm try ssh|run|shot…
# (MAZAPAN_TRY_NOISO=1 vm/vm try headless: the disk alone, the ISO out;
#  MAZAPAN_TRY_ANSWERS=file vm/vm try reset: an unattended install, see vm/gate)
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
state="$repo/vm/.state"

image_url="${MAZAPAN_IMAGE_URL:-https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-cloudimg.qcow2}"
disk_size="${MAZAPAN_DISK:-40G}"
mem="${MAZAPAN_MEM:-8G}"
cpus="${MAZAPAN_CPUS:-8}"
res="${MAZAPAN_RES:-1920x1080}"
ssh_port="${MAZAPAN_SSH_PORT:-2222}"
outputs="${MAZAPAN_OUTPUTS:-1}" # screens the guest sees (each one a window here)

base="$state/base.qcow2"
key="$state/id_ed25519"
mode=dev
if [[ ${1:-} == try ]]; then mode=try; shift; fi
if [[ $mode == try ]]; then
  name=myarch-try tag=try-
  disk="$state/try.qcow2"
  seed="$state/try-seed.iso"
  vars="$state/try-vars.fd"
  pidfile="$state/try.pid"
  # Root on the live system; on what it installed, the account it made
  # (the installer gives it the live system's SSH keys): MAZAPAN_TRY_USER.
  ssh_port="${MAZAPAN_TRY_SSH_PORT:-2223}" ssh_user="${MAZAPAN_TRY_USER:-root}"
else
  name=myarch-vm tag=
  disk="$state/disk.qcow2"
  seed="$state/seed.iso"
  pidfile="$state/qemu.pid"
  ssh_user=arch
fi
mon_sock="$state/${tag}monitor.sock"
qmp_sock="$state/${tag}qmp.sock"
serial="$state/${tag}serial.log"
ovmf=/usr/share/edk2/x64

log() { printf '\e[1;35m[vm]\e[0m %s\n' "$*"; }
die() { printf '\e[1;31m[vm]\e[0m %s\n' "$*" >&2; exit 1; }

running() { [[ -f $pidfile ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }

ssh_opts=(-i "$key" -p "$ssh_port"
  -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
  -o LogLevel=ERROR -o ConnectTimeout=3)

fetch_base() {
  [[ -f $base ]] && return
  log "downloading $image_url"
  curl -fL --progress-bar -o "$base.part" "$image_url"
  local want
  want="$(curl -fsSL "$image_url.SHA256" | awk '{print $1}')"
  echo "$want  $base.part" | sha256sum -c --quiet - || die "checksum mismatch"
  mv "$base.part" "$base"
}

make_seed() {
  [[ -f $key ]] || ssh-keygen -q -t ed25519 -N '' -C myarch-vm -f "$key"
  local tmp; tmp="$(mktemp -d)"
  sed "s|@SSH_PUBKEY@|$(cat "$key.pub")|" "$repo/vm/cloud-init/${tag}user-data.tmpl" > "$tmp/user-data"
  cp "$repo/vm/cloud-init/meta-data" "$tmp/meta-data"
  local files=("$tmp/user-data" "$tmp/meta-data")
  # An unattended install (the ISO's mazapan-unattended): its answers on the seed.
  if [[ $mode == try && -n ${MAZAPAN_TRY_ANSWERS:-} ]]; then
    cp "$MAZAPAN_TRY_ANSWERS" "$tmp/mazapan.json"
    files+=("$tmp/mazapan.json")
  fi
  xorriso -as mkisofs -quiet -V cidata -J -R -o "$seed" "${files[@]}" \
    2>"$state/xorriso.log" || { cat "$state/xorriso.log" >&2; die "seed build failed"; }
  rm -rf "$tmp"
}

make_disk() {
  qemu-img create -q -f qcow2 -F qcow2 -b "$base" "$disk" "$disk_size"
}

cmd_create() {
  mkdir -p "$state"
  if [[ $mode == try ]]; then
    [[ -f $disk ]] || { log "creating a blank disk ($disk_size)"; qemu-img create -q -f qcow2 "$disk" "$disk_size"; }
    [[ -f $vars ]] || install -m 644 "$ovmf/OVMF_VARS.4m.fd" "$vars"
    [[ -f $seed ]] || { log "building cloud-init seed"; make_seed; }
    return
  fi
  fetch_base
  [[ -f $disk ]] || { log "creating overlay disk ($disk_size)"; make_disk; }
  [[ -f $seed ]] || { log "building cloud-init seed"; make_seed; }
  log "ready: vm/vm start"
}

boot() {
  local display=("$@")
  running && die "already running (pid $(cat "$pidfile"))"
  [[ -f $disk && -f $seed ]] || cmd_create
  local w=${res%x*} h=${res#*x} machine
  if [[ $mode == try ]]; then
    local iso="${MAZAPAN_ISO:-$(ls -t "$state"/iso/*.iso 2>/dev/null | head -1)}" cd=()
    # MAZAPAN_TRY_NOISO=1: the disk alone (what was installed), as with the
    # stick taken out (firmware would start the ISO first otherwise).
    if [[ ${MAZAPAN_TRY_NOISO:-} == 1 ]]; then
      log "booting the disk (no ISO)"
    else
      [[ -f $iso ]] || die "no ISO: vm/vm iso first (or MAZAPAN_ISO=path)"
      log "booting ${iso##*/} (UEFI, blank disk $disk_size)"
      cd=(-drive "file=$iso,media=cdrom,readonly=on")
    fi
    [[ -f $vars ]] || cmd_create
    machine=(
      -drive "if=pflash,format=raw,unit=0,readonly=on,file=$ovmf/OVMF_CODE.4m.fd"
      -drive "if=pflash,format=raw,unit=1,file=$vars"
      -drive "file=$disk,if=virtio,discard=unmap"
      "${cd[@]}"
      -drive "file=$seed,media=cdrom,readonly=on"
      -nic "user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$ssh_port-:22"
    )
  else
    machine=(
      -drive "file=$disk,if=virtio,discard=unmap"
      -drive "file=$seed,media=cdrom,readonly=on"
      -nic "user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:$ssh_port-:22"
      -virtfs "local,path=$repo,mount_tag=myarch,security_model=none,id=myarch"
    )
  fi
  # MAZAPAN_VGA=std: a plain VGA card, whose screen QEMU can capture before
  # the system draws its own (firmware, GRUB, the disk's password): vm/vm
  # try screen. Slower graphics; for looking at boot only.
  local gpu=(-device "virtio-vga-gl,xres=$w,yres=$h,max_outputs=$outputs")
  if [[ ${MAZAPAN_VGA:-} == std ]]; then gpu=(-device VGA,vgamem_mb=64); display=(-display none); fi
  log "booting ($cpus cpus, $mem, ${res}); serial log: vm/.state/${serial##*/}"
  setsid -f qemu-system-x86_64 \
    -name "$name" \
    -machine q35,accel=kvm -cpu host -smp "$cpus" -m "$mem" \
    "${machine[@]}" \
    -device virtio-tablet-pci -device virtio-keyboard-pci \
    -audiodev pipewire,id=snd0 -device ich9-intel-hda -device hda-duplex,audiodev=snd0 \
    "${gpu[@]}" \
    "${display[@]}" \
    -serial "file:$serial" \
    -monitor "unix:$mon_sock,server,nowait" \
    -qmp "unix:$qmp_sock,server,nowait" \
    -pidfile "$pidfile" \
    >"$state/${tag}qemu.log" 2>&1
  sleep 1
  running || { cat "$state/${tag}qemu.log" >&2; die "qemu failed to start"; }
}

cmd_start()    { boot -display "${MAZAPAN_DISPLAY:-gtk,gl=on,zoom-to-fit=off,grab-on-hover=on}"; }
cmd_headless() { boot -display egl-headless; }

cmd_wait() {
  log "waiting for SSH"
  until ssh "${ssh_opts[@]}" "$ssh_user@127.0.0.1" true 2>/dev/null; do
    running || die "VM is not running"
    sleep 2
  done
  [[ $mode == try ]] && { log "up"; return; }
  log "waiting for cloud-init (first boot installs packages; a few minutes)"
  ssh "${ssh_opts[@]}" arch@127.0.0.1 cloud-init status --wait >/dev/null || true
  ssh "${ssh_opts[@]}" arch@127.0.0.1 cloud-init status --long
}

cmd_ssh() { exec ssh "${ssh_opts[@]}" -t "$ssh_user@127.0.0.1" "$@"; }

cmd_provision() {
  ssh "${ssh_opts[@]}" arch@127.0.0.1 sudo bash /home/arch/my-arch/vm/guest/provision.sh
}

# Env of the logged-in graphical session, for hyprctl, gsettings, grim...
session_env='export XDG_RUNTIME_DIR=/run/user/$(id -u)
export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
export WAYLAND_DISPLAY=$(ls $XDG_RUNTIME_DIR | grep -m1 "^wayland-[0-9]*$")
export HYPRLAND_INSTANCE_SIGNATURE=$(ls -t $XDG_RUNTIME_DIR/hypr 2>/dev/null | head -1)'

cmd_run() {
  if [[ $mode == try ]]; then
    # The live session is user "live"'s; the command goes in on stdin.
    local as='runuser -u live -- bash -s'
    [[ $ssh_user == root ]] || as='bash -s'
    printf '%s\ncd\n%s\n' "$session_env" "$*" | ssh "${ssh_opts[@]}" "$ssh_user@127.0.0.1" "$as"
    return
  fi
  ssh "${ssh_opts[@]}" arch@127.0.0.1 "$session_env
export PATH=\$HOME/my-arch/bin:\$PATH
cd \$HOME/my-arch
$*"
}

cmd_exec() {
  local cmd="$*"
  cmd=${cmd//\\/\\\\}; cmd=${cmd//\"/\\\"}
  cmd_run "hyprctl dispatch 'hl.dsp.exec_cmd(\"$cmd\")' >/dev/null"
}

# QEMU keycodes (see `sendkey` in the QEMU monitor): meta_l-equal, ctrl-alt-f2…
cmd_key() {
  running || die "VM is not running"
  local combo
  for combo in "$@"; do
    python3 - "$mon_sock" "sendkey $combo" <<'PY'
import socket, sys, time
s = socket.socket(socket.AF_UNIX)
s.connect(sys.argv[1])
s.sendall((sys.argv[2] + "\n").encode())
time.sleep(0.2)
s.close()
PY
  done
}

# The guest pointer is an absolute tablet: QMP input-send-event with x/y in
# 0..32767 across the guest screen, so guest pixels are scaled by its size.
cmd_mouse() {
  running || die "VM is not running"
  # The tablet spans the whole layout (every screen), in logical pixels;
  # coordinates here are in that same space, with 0,0 at its top-left.
  local size
  size=$(cmd_run 'hyprctl monitors -j | jq -r "[.[] | {r: (.x + (if .transform % 2 == 1 then .height else .width end) / .scale), b: (.y + (if .transform % 2 == 1 then .width else .height end) / .scale)}] | \"\(map(.r) | max | floor) \(map(.b) | max | floor)\""')
  python3 - "$qmp_sock" $size "$@" <<'PY'
import json, socket, sys, time

sock_path, width, height, cmd, *args = sys.argv[1:]
width, height = int(width), int(height)
s = socket.socket(socket.AF_UNIX)
s.connect(sock_path)
f = s.makefile("rw")
f.readline()  # greeting

def qmp(execute, arguments=None):
    msg = {"execute": execute}
    if arguments:
        msg["arguments"] = arguments
    f.write(json.dumps(msg) + "\n")
    f.flush()
    while True:
        reply = json.loads(f.readline())
        if "return" in reply or "error" in reply:
            return reply

def send(*events):
    qmp("input-send-event", {"events": list(events)})

def move(x, y):
    send({"type": "abs", "data": {"axis": "x", "value": round(float(x) * 32767 / width)}},
         {"type": "abs", "data": {"axis": "y", "value": round(float(y) * 32767 / height)}})

def button(down, which="left"):
    send({"type": "btn", "data": {"down": down, "button": which}})

qmp("qmp_capabilities")
if cmd == "move":
    move(*args)
elif cmd == "down":
    button(True)
elif cmd == "up":
    button(False)
elif cmd in ("click", "rclick", "mclick"):
    which = {"click": "left", "rclick": "right", "mclick": "middle"}[cmd]
    move(*args); time.sleep(0.05); button(True, which); time.sleep(0.05); button(False, which)
elif cmd == "wheel":
    x, y, direction = args[:3]
    notches = int(args[3]) if len(args) > 3 else 1
    move(x, y); time.sleep(0.05)
    for _ in range(notches):
        button(True, "wheel-" + direction); button(False, "wheel-" + direction); time.sleep(0.08)
elif cmd == "drag":
    x1, y1, x2, y2 = map(float, args[:4])
    ms = float(args[4]) if len(args) > 4 else 600
    steps = max(2, int(ms / 16))
    move(x1, y1); time.sleep(0.1); button(True); time.sleep(0.15)
    for i in range(1, steps + 1):
        t = i / steps
        move(x1 + (x2 - x1) * t, y1 + (y2 - y1) * t)
        time.sleep(ms / 1000 / steps)
    time.sleep(0.15); button(False)
else:
    sys.exit(f"unknown mouse command: {cmd}")
PY
}

# The screen as QEMU sees it, whatever draws it (MAZAPAN_VGA=std).
# One QMP command (system_powerdown…), no output.
qmp() {
  [[ -S $qmp_sock ]] || return 1
  python3 - "$qmp_sock" "$1" <<'PY'
import socket, sys, json
s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); f = s.makefile("rw"); f.readline()
for c in [{"execute": "qmp_capabilities"}, {"execute": sys.argv[2]}]:
    f.write(json.dumps(c) + "\n"); f.flush(); r = json.loads(f.readline())
    if "error" in r: sys.exit(r["error"]["desc"])
PY
}

cmd_screen() {
  local out="${1:-$state/screen.png}"
  python3 - "$qmp_sock" "$(realpath -m "$out")" <<'PY'
import socket, sys, json
s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); f = s.makefile("rw"); f.readline()
for c in [{"execute": "qmp_capabilities"}, {"execute": "screendump", "arguments": {"filename": sys.argv[2], "format": "png"}}]:
    f.write(json.dumps(c) + "\n"); f.flush(); r = json.loads(f.readline())
    if "error" in r: sys.exit("screendump: " + r["error"]["desc"])
PY
  log "saved $out"
}

cmd_shot() {
  local out="${1:-$state/shot.png}"
  cmd_run grim - > "$out"
  log "saved $out"
}

cmd_stop() {
  running || { log "not running"; return; }
  # Shut down, not pulled out: a hard stop can leave files written but empty
  # (btrfs commits every 30 s; SSH host keys from the first boot were).
  # The power button (ACPI, through QMP) when SSH can't do it; killed only
  # if it hasn't stopped in 90 s.
  ssh "${ssh_opts[@]}" "$ssh_user@127.0.0.1" sudo systemctl poweroff 2>/dev/null || qmp system_powerdown || true
  local i
  for i in $(seq 1 90); do running || break; sleep 1; done
  running && kill "$(cat "$pidfile")"
  while running; do sleep 1; done
  rm -f "$pidfile"
  log "stopped"
}

cmd_reset() {
  running && die "stop the VM first"
  rm -f "$disk" "$seed"
  [[ $mode == try ]] && rm -f "$vars"
  cmd_create
}

cmd_iso() {
  [[ $mode == dev ]] || die "the ISO is built in the dev VM: vm/vm iso"
  running || die "VM is not running (vm/vm start)"
  ssh "${ssh_opts[@]}" -t arch@127.0.0.1 bash /home/arch/my-arch/iso/build /home/arch/my-arch/vm/.state/iso "$@"
}

cmd_destroy() {
  [[ $mode == try ]] && die "vm/vm try reset throws the try VM's disk away"
  running && die "stop the VM first"
  rm -rf "$state"
  log "destroyed"
}

case "${1:-}" in
  create|start|headless|wait|ssh|provision|run|exec|key|mouse|shot|screen|stop|reset|destroy|iso)
    c=$1; shift; "cmd_$c" "$@" ;;
  *) sed -n "2,/^set -e/{/^set -e/d;s/^# \\{0,1\\}//p}" "$0"; exit 1 ;;
esac
