# Generated by mazapan (plugin {{ plugin }}): Docker's socket, started at
# every start while this file is there (the daemon starts with the first
# command).
[Socket]
{{- if settings.group }}
# {{ user }} in the docker group, so docker needs no sudo (as powerful as
# root): added as it starts (before the login), taken out as it stops (and
# so when this plugin is turned off).
ExecStartPost=-/usr/bin/usermod -aG docker {{ user }}
ExecStopPost=-/usr/bin/gpasswd -d {{ user }} docker
{{- else }}
# docker needs sudo (group off): {{ user }} kept out of its group.
ExecStartPost=-/usr/bin/gpasswd -d {{ user }} docker
{{- end }}
