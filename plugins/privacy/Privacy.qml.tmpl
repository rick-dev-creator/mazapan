// Generated by mazapan (plugin {{ plugin }}).
//
// Dots while something listens or watches, as macOS shows them: orange for
// the microphone, green for the camera, blue for the screen shared; a click
// says which app. Nothing at all in the bar while nothing is in use.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import qs
import "../../components/kit"

BarItem {
  id: root

  property var mic: []
  property var cam: []
  property var screen: []
  readonly property bool any: mic.length + cam.length + screen.length > 0

  shown: any
  open: popup.visible
  onClicked: popup.toggle()


  Process {
    id: probe
    command: ["sh", Quickshell.env("HOME") + "/.local/share/mazapan/bin/privacy"]
    stdout: StdioCollector {
      onStreamFinished: {
        let o = {}
        try {
          o = JSON.parse(text)
        } catch (e) {}
        // A list's length is the dot: its names only say who.
        const list = x => Array.isArray(x) ? x.map(a => String(a) || "?") : []
        root.mic = list(o.mic)
        root.cam = list(o.cam)
        root.screen = list(o.screen)
      }
    }
  }
  Timer {
    interval: {{ settings.every }} * 1000
    repeat: true
    running: true
    triggeredOnStart: true
    onTriggered: if (!probe.running) probe.running = true
  }

  Row {
    anchors.verticalCenter: parent.verticalCenter
    spacing: 4
    Repeater {
      model: [[root.mic.length > 0, Theme.warning], [root.cam.length > 0, Theme.success], [root.screen.length > 0, Theme.info]]
      Rectangle {
        required property var modelData
        visible: modelData[0]
        width: 7
        height: 7
        radius: 3.5
        color: modelData[1]
        anchors.verticalCenter: parent.verticalCenter
      }
    }
  }

  BarPopup {
    id: popup
    owner: root
    cardWidth: 300

    Repeater {
      model: [[{{ tq "mic" }}, "󰍬", root.mic, Theme.warning], [{{ tq "cam" }}, "󰄀", root.cam, Theme.success],
              [{{ tq "screen" }}, "󰹑", root.screen, Theme.info]]
      ColumnLayout {
        required property var modelData
        visible: modelData[2].length > 0
        Layout.fillWidth: true
        spacing: 2
        RowLayout {
          spacing: 8
          Glyph { text: modelData[1]; color: modelData[3] }
          Label { text: modelData[0]; font.bold: true }
        }
        Caption {
          text: modelData[2].map(a => a === "?" ? {{ tq "unknown" }} : a).join(", ")
          wrapMode: Text.Wrap
          Layout.fillWidth: true
          Layout.leftMargin: 26
        }
      }
    }
  }
}
