# Generated by mazapan (plugin {{ plugin }}): what's using the microphone,
# the camera and the screen, as JSON: {"mic": [APP…], "cam": […], "screen": […]}
# (a list empty only when nothing is; an app without a usable name is "?",
# so no name can hide a dot).
# PipeWire's running nodes (Waybar's privacy module does the same): an app
# recording sound is a running Stream/Input/Audio; a camera, a running
# Video/Source that isn't the screen; the screen shared, a running
# xdg-desktop-portal-hyprland source. Who watches a source is the app
# reading it (Stream/Input/Video). Cameras opened past PipeWire (some
# browsers open /dev/video directly) count as the camera too: found by one
# find over the open files, not a process per file.
v4l=$(find /proc/[0-9]*/fd -lname '/dev/video*' 2>/dev/null | cut -d/ -f3 | sort -u | while read -r pid; do
  c=$(cat "/proc/$pid/comm" 2>/dev/null | tr -d ',\n'); printf '%s\n' "${c:-?}"
done | sort -u | paste -sd, -)
pw-dump 2>/dev/null | jq -c --arg v4l "$v4l" '
  [ .[] | select(.type == "PipeWire:Interface:Node") | .info | select(.state == "running") | .props ] as $n
  | def name: [ .["application.name"], .["application.process.binary"], .["node.description"], .["node.name"] ]
      | map(select(. != null) | tostring | gsub("[,\n]"; " ") | gsub("^\\s+|\\s+$"; "")) | map(select(. != "")) | (.[0] // "?");
    def screen: ((.["node.name"] // "") | test("xdph|screencast|screen"; "i"));
    def some: if length == 0 then ["?"] else . end;
    ([ $n[] | select(.["media.class"] == "Video/Source" and screen) ] | length) as $sharing
  | ([ $n[] | select(.["media.class"] == "Video/Source" and (screen | not)) ] | length) as $cams
  | ([ $n[] | select(.["media.class"] == "Stream/Input/Video") | name ] | unique) as $watchers
  | ($v4l | split(",") | map(select(. != ""))) as $direct
  | { mic: ([ $n[] | select(.["media.class"] == "Stream/Input/Audio") | name ] | unique),
      cam: (if $cams > 0 or ($direct | length) > 0 then ($watchers + $direct | unique | some) else [] end),
      screen: (if $sharing > 0 then ($watchers | some) else [] end) }
' 2>/dev/null || echo '{"mic":[],"cam":[],"screen":[]}'
