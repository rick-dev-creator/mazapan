-- Generated by mazapan (plugin {{ plugin }}): an app that wants to see the
-- screen asks first (Hyprland's own dialog), as macOS does, unless it
-- goes through the screen-sharing portal, which shows its own picker.
-- The desktop's own tools that read the screen for you don't ask
-- (each binary is a regular expression, matched on the full path).
--
-- Decided as Hyprland starts and kept until it ends: Hyprland takes its
-- permission rules on its first load only, and turned on later it would
-- ask about the desktop's own tools too. So what it started with is written
-- down (a file in the runtime directory, per Hyprland instance) and reloads
-- keep to it; a change counts from the next login. Whether this is that
-- first load, hypr-base knows (mazapan_first_load).
local wanted = {{ settings.screen_ask }}
local started = false
pcall(function()
  local sig = os.getenv("HYPRLAND_INSTANCE_SIGNATURE")
  local marker = os.getenv("XDG_RUNTIME_DIR") .. "/mazapan-screen-ask-" .. sig
  local f = io.open(marker, "r")
  if f then
    started = f:read("l") == "on"
    f:close()
    return
  end
  started = wanted and mazapan_first_load == true
  f = io.open(marker, "w")
  f:write(started and "on" or "off")
  f:close()
end)

if started then
  hl.config({ ecosystem = { enforce_permissions = true } })
  for _, binary in ipairs({
    "/usr/bin/grim",                        -- capture
    "/usr/bin/wf-recorder",                 -- screen recording
    "/usr/bin/hyprpicker",                  -- color picker
    "/usr/bin/quickshell",                  -- the bar's workspace previews
    "/usr/bin/hyprlock",                    -- the lock screen
    "/usr/lib/xdg-desktop-portal-hyprland", -- the portal: it asks itself
  }) do
    hl.permission({ binary = binary, type = "screencopy", mode = "allow" })
  end
end
