#!/bin/sh
# Generated by mazapan (plugin {{ plugin }}): the boot menu in the theme
# ({{ theme.id }}). grub-mkconfig runs it, last: it writes GRUB's theme next
# to grub.cfg and points GRUB at it. GRUB draws its own text (Unifont).
set -e
dir=/boot/grub/themes/mazapan
mkdir -p "$dir" /boot/grub/fonts
# The font it draws with (grub-install puts it there; not every install did).
[ -f /boot/grub/fonts/unicode.pf2 ] || cp /usr/share/grub/unicode.pf2 /boot/grub/fonts/
cat > "$dir/theme.txt" <<'THEME'
# Generated by mazapan from the theme {{ theme.id }}.
title-text: "Mazapan"
title-font: "Unifont Regular 16"
title-color: "{{ c "accent_text" }}"
desktop-color: "{{ c "bg" }}"
message-font: "Unifont Regular 16"
message-color: "{{ c "fg_muted" }}"
terminal-font: "Unifont Regular 16"

+ boot_menu {
  left = 20%
  top = 28%
  width = 60%
  height = 50%
  item_font = "Unifont Regular 16"
  item_color = "{{ c "fg" }}"
  selected_item_font = "Unifont Regular 16"
  selected_item_color = "{{ c "accent_text" }}"
  item_height = 26
  item_padding = 6
  item_spacing = 4
  icon_width = 0
  icon_height = 0
  scrollbar = false
}
THEME
# Drawn only where GRUB can (its font, a graphics mode): else its text menu.
cat <<'GRUB'
### mazapan: the boot menu in the theme
if loadfont unicode; then
  set gfxmode=auto
  insmod all_video
  insmod gfxterm
  insmod gfxmenu
  terminal_output gfxterm
  set theme=${prefix}/themes/mazapan/theme.txt
  export theme
fi
GRUB
