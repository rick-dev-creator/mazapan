# Generated by mazapan (plugin {{ plugin }}): web apps, a site as an app of
# its own (a window without the browser's bars, its own icon, in the
# palette and the launcher). Each one is a .desktop file of yours in
# ~/.local/share/applications (mazapan-webapp-ID.desktop); its icon is in
# ~/.local/share/mazapan-webapps/.
#
#   webapp add NAME URL [ICON]   ICON: a picture's path or http(s) URL;
#                                none: the site's own, looked up
#   webapp remove ID
#   webapp list                  ID <tab> NAME <tab> URL <tab> ICON
#   webapp open ID|URL           its window if it's open, else a new one
#   webapp browser               the browser it uses (or nothing)
set -u
apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
icons="${XDG_DATA_HOME:-$HOME/.local/share}/mazapan-webapps"
self="$HOME/.local/share/mazapan/bin/webapp"

die() { echo "webapp: $*" >&2; exit 1; }

# A Chromium-based browser (only those open a site as an app): the
# default one if it is, else the first installed. Its command, from its
# .desktop file.
browser() {
  def=$(xdg-settings get default-web-browser 2>/dev/null || true)
  for d in "$def" chromium.desktop google-chrome.desktop brave-browser.desktop vivaldi-stable.desktop \
      microsoft-edge.desktop helium.desktop thorium-browser.desktop; do
    case "$d" in
      chromium*|google-chrome*|brave*|vivaldi*|microsoft-edge*|helium*|thorium*|opera*) ;;
      *) continue ;;
    esac
    for dir in "$HOME/.local/share/applications" /usr/local/share/applications /usr/share/applications; do
      [ -r "$dir/$d" ] || continue
      cmd=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$dir/$d" | head -n 1)
      # A wrapper (flatpak, env) isn't the browser itself: not this one.
      case "${cmd##*/}" in flatpak|env|sh|bash) continue ;; esac
      [ -n "$cmd" ] && command -v "$cmd" >/dev/null && { echo "$cmd"; return 0; }
    done
  done
  return 1
}

# A name for files: ASCII (accents dropped) lower case, letters and
# digits, dashes between; the same whatever the locale.
slug() {
  printf %s "$1" | LC_ALL=C.UTF-8 iconv -f UTF-8 -t ASCII//TRANSLIT 2>/dev/null \
    | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed 's/[^a-z0-9]\{1,\}/-/g; s/^-//' | cut -c1-40 | sed 's/-*$//'
}

# An id as given (the .desktop's own), else made from the name.
id_of() {
  case "$1" in
    ''|*[!a-z0-9-]*) slug "$1" ;;
    *) printf %s "$1" ;;
  esac
}

# Only http(s), no spaces or control characters: a browser opens other
# schemes (javascript:, file:) as a document to run.
url_ok() {
  case "$1" in
    http://?*|https://?*) ;;
    *) return 1 ;;
  esac
  ! printf %s "$1" | LC_ALL=C grep -q '[[:space:][:cntrl:]\\]'
}

# A Desktop Entry string (no new lines: they'd start a key of their own).
entry_string() { printf %s "$1" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g'; }

# The host, as the browser has it: lower case, without a user or a port.
host_of() { printf %s "$1" | sed -E 's|^[A-Za-z]+://([^/?#]*@)?([^/?#:]+).*|\2|' | LC_ALL=C tr '[:upper:]' '[:lower:]'; }

# The path (/ when none), without its query.
path_of() {
  p=$(printf %s "$1" | sed -E 's|^[A-Za-z]+://[^/?#]*||; s|[?#].*||')
  printf %s "${p:-/}"
}

# Only http(s), at most 2 MB, within 10 seconds: a site can't fill the disk.
curl_() { curl -fsSL --max-time 10 --max-filesize 2000000 --proto '=https,http' --proto-redir '=https,http' "$@"; }

fetch() { curl_ -o "$2" "$1" 2>/dev/null && [ -s "$2" ] && file -b --mime-type "$2" | grep -q '^image/'; }

# The site's own icon: its apple-touch-icon (large), then the usual place,
# then DuckDuckGo's icon service.
site_icon() {
  origin=$(printf %s "$1" | sed -E 's|^(https?://[^/?#]+).*|\1|')
  href=$(curl_ "$1" 2>/dev/null | head -c 200000 | tr '\n' ' ' \
    | grep -oiE "<link[^>]*rel=[\"'][^\"']*apple-touch-icon[^\"']*[\"'][^>]*>" | head -n 1 \
    | grep -oiE "href=[\"'][^\"']+" | sed -E "s/^href=[\"']//")
  case "$href" in
    http://*|https://*) ;;
    //*) href="https:$href" ;;
    /*) href="$origin$href" ;;
    ?*) href="$origin/$href" ;;
  esac
  { [ -n "$href" ] && fetch "$href" "$2"; } || fetch "$origin/apple-touch-icon.png" "$2" \
    || fetch "https://icons.duckduckgo.com/ip3/$(host_of "$1").ico" "$2"
}

# A PNG, which every launcher shows (sites serve WebP, ICO, JPEG too):
# converted when ImageMagick or ffmpeg is here, else kept as it is, named
# for what it is. An SVG stays an SVG (a drawing: launchers show it, and
# converting one could read other files). Prints its path.
as_png() {
  mime=$(file -b --mime-type "$1")
  case "$mime" in
    image/png) e=png; dec="" ;;
    image/webp) e=webp; dec=webp ;;
    image/vnd.microsoft.icon|image/x-icon) e=ico; dec=ico ;;
    image/jpeg) e=jpg; dec=jpeg ;;
    image/gif) e=gif; dec=gif ;;
    image/svg+xml) mv -f "$1" "$2.svg"; echo "$2.svg"; return ;;
    *) rm -f "$1"; echo applications-internet; return ;;
  esac
  if [ -z "$dec" ]; then
    mv -f "$1" "$2.png"
  elif command -v magick >/dev/null && magick -limit memory 64MiB -limit disk 64MiB "$dec:$1[0]" -resize '256x256>' "$2.png" 2>/dev/null; then
    rm -f "$1"
  elif command -v ffmpeg >/dev/null && ffmpeg -loglevel error -y -f image2 -i "$1" -frames:v 1 "$2.png" 2>/dev/null </dev/null; then
    rm -f "$1"
  else
    mv -f "$1" "$2.$e"
    echo "$2.$e"
    return
  fi
  echo "$2.png"
}

case "${1:-}" in
  add)
    [ $# -ge 3 ] || die "add NAME URL [ICON]"
    name=$(printf %s "$2" | tr -d '\n\r\t\\' | sed 's/^ *//; s/ *$//')
    url="$3"
    case "$url" in *://*) ;; *) url="https://$url" ;; esac
    [ -n "$name" ] || die "a name, please"
    url_ok "$url" || die "not a web address: $url"
    id=$(slug "$name")
    [ -n "$id" ] || id=$(slug "$(host_of "$url")")
    [ -n "$id" ] || id=app
    mkdir -p "$apps" "$icons"
    # Another app with the same id (a similar name): this one gets its own
    # (-2, -3…). The same app added again replaces itself.
    base=$id; n=1
    while [ -e "$apps/mazapan-webapp-$id.desktop" ] \
      && [ "$(sed -n 's/^X-Mazapan-WebApp=//p' "$apps/mazapan-webapp-$id.desktop" | head -n 1)" != "$url" ]; do
      n=$((n + 1)); id="$base-$n"
    done
    part="$icons/.$id.part"
    got=no
    if [ -n "${4:-}" ]; then
      case "$4" in
        http://*|https://*) fetch "$4" "$part" && got=yes ;;
        *) [ -f "$4" ] && file -b --mime-type "$4" | grep -q '^image/' && cp "$4" "$part" && got=yes ;;
      esac
    else
      site_icon "$url" "$part" && got=yes
    fi
    # The one it had (added again: a new icon, maybe of another kind).
    rm -f "$icons/$id".*
    if [ "$got" = yes ]; then icon=$(as_png "$part" "$icons/$id"); else rm -f "$part"; icon=applications-internet; fi
    host=$(host_of "$url")
    {
      echo "[Desktop Entry]"
      echo "Type=Application"
      echo "Name=$(entry_string "$name")"
      echo "Comment=$(entry_string "$host")"
      echo "Exec=sh \"$(entry_string "$self")\" open $id"
      echo "Icon=$(entry_string "$icon")"
      echo "Categories=Network;"
      echo "StartupNotify=true"
      echo "X-Mazapan-WebApp=$(entry_string "$url")"
    } > "$apps/mazapan-webapp-$id.desktop.part"
    mv -f "$apps/mazapan-webapp-$id.desktop.part" "$apps/mazapan-webapp-$id.desktop"
    echo "$id"
    ;;
  remove)
    id=$(id_of "${2:-}")
    [ -n "$id" ] || die "remove ID"
    rm -f "$apps/mazapan-webapp-$id.desktop" "$icons/$id".*
    ;;
  list)
    for f in "$apps"/mazapan-webapp-*.desktop; do
      [ -e "$f" ] || continue
      id=${f##*/mazapan-webapp-}; id=${id%.desktop}
      printf '%s\t%s\t%s\t%s\n' "$id" "$(sed -n 's/^Name=//p' "$f" | head -n 1)" \
        "$(sed -n 's/^X-Mazapan-WebApp=//p' "$f" | head -n 1)" "$(sed -n 's/^Icon=//p' "$f" | head -n 1)"
    done
    ;;
  open)
    what="${2:-}"
    case "$what" in
      http://*|https://*) url="$what" ;;
      *) url=$(sed -n 's/^X-Mazapan-WebApp=//p' "$apps/mazapan-webapp-$(id_of "$what").desktop" 2>/dev/null | head -n 1) ;;
    esac
    url_ok "${url:-}" || die "no web app $what"
    # Already open: its window (Chromium names an app's window
    # <browser>-<host>_<path, / as _>-<profile>).
    app="$(host_of "$url")_$(path_of "$url" | tr / _)"
    addr=$(hyprctl clients -j 2>/dev/null | jq -r --arg h "-$app-" \
      '[.[] | select(.class | contains($h))][0].address // empty' 2>/dev/null)
    if [ -n "$addr" ]; then
      hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
      exit 0
    fi
    b=$(browser) || { notify-send -a {{ shq (t "title") }} {{ shq (t "no_browser") }} {{ shq (t "no_browser_body") }}; exit 1; }
    # --no-first-run: a first start of the browser opens the app, not its
    # welcome pages.
    setsid -f "$b" --no-first-run --app="$url" >/dev/null 2>&1 </dev/null
    ;;
  browser) browser ;;
  *) echo "usage: webapp add NAME URL [ICON] | remove ID | list | open ID|URL | browser" >&2; exit 2 ;;
esac
