// Generated by mazapan (plugin {{ plugin }}).
//
// Web apps: a site as an app of its own. The ones you have (open, remove),
// a name and an address to add one (its icon is the site's own), and a
// few to add with a click. They're in the palette and the launcher like
// any app; opened again, the window already open comes forward.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null

  readonly property string helper: Quickshell.env("HOME") + "/.local/share/mazapan/bin/webapp"

  // [{id, name, url, icon}]
  property var apps: []
  // The browser that opens them ("": none that can).
  property string browser: ""
  property bool checked: false
  property string status: ""
  property bool failed: false

  // A few to start with (only those not added yet).
  readonly property var suggested: [
    ["WhatsApp", "https://web.whatsapp.com/"],
    ["Gmail", "https://mail.google.com/"],
    ["Google Calendar", "https://calendar.google.com/"],
    ["YouTube Music", "https://music.youtube.com/"],
    ["Telegram", "https://web.telegram.org/"],
    ["Discord", "https://discord.com/app"],
    ["Notion", "https://www.notion.so/"],
    ["Figma", "https://www.figma.com/"],
    ["Claude", "https://claude.ai/"],
    ["ChatGPT", "https://chatgpt.com/"],
    ["Outlook", "https://outlook.live.com/"],
    ["Spotify", "https://open.spotify.com/"],
  ].filter(s => !apps.some(a => a.url.replace(/\/$/, "") === s[1].replace(/\/$/, "")))

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    status = ""
    failed = false
    nameField.text = ""
    urlField.text = ""
    refresh()
    open = true
    Qt.callLater(() => nameField.focusInput())
  }

  function close() { open = false }

  function refresh() {
    lister.running = true
    finder.running = true
  }

  Process {
    id: lister
    command: ["sh", root.helper, "list"]
    stdout: StdioCollector {
      onStreamFinished: root.apps = text.split("\n").filter(l => l !== "").map(l => {
        const f = l.split("\t")
        return { id: f[0], name: f[1] || f[0], url: f[2] || "", icon: f[3] || "" }
      })
    }
  }

  Process {
    id: finder
    command: ["sh", root.helper, "browser"]
    stdout: StdioCollector {
      onStreamFinished: {
        root.browser = text.trim()
        root.checked = true
      }
    }
  }

  // Adding one takes a moment (its icon is fetched): one at a time.
  Process {
    id: adder
    property string name: ""
    stdout: StdioCollector { id: added }
    stderr: StdioCollector { id: why }
    onExited: code => {
      root.failed = code !== 0
      root.status = code === 0 ? {{ tq "added" }}.arg(adder.name) : {{ tq "failed" }}.arg(why.text.replace(/^webapp: /, "").trim())
      if (code === 0) {
        nameField.text = ""
        urlField.text = ""
      }
      root.refresh()
    }
  }

  function add(name, url) {
    name = name.trim()
    url = url.trim()
    if (name === "" || url === "" || adder.running) return
    status = {{ tq "adding" }}.arg(name)
    failed = false
    adder.name = name
    adder.command = ["sh", root.helper, "add", name, url]
    adder.running = true
  }

  function remove(a) {
    Quickshell.execDetached(["sh", root.helper, "remove", a.id])
    apps = apps.filter(x => x.id !== a.id)
    status = {{ tq "removed" }}.arg(a.name)
    failed = false
  }

  function launch(a) {
    close()
    Quickshell.execDetached(["sh", root.helper, "open", a.id])
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: 560
    implicitHeight: Math.min(640, (screen ? screen.height : 900) * 0.85)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-webapps"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      anchors.fill: parent
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius
      Keys.onEscapePressed: root.close()

      ColumnLayout {
        anchors.fill: parent
        anchors.margins: 16
        spacing: 12

        Caption { text: {{ tq "title" }}.toUpperCase() }

        // None of the browsers here can open a site as an app.
        Label {
          visible: root.checked && root.browser === ""
          text: {{ tq "no_browser_body" }}
          color: Theme.warning
          wrapMode: Text.Wrap
          Layout.fillWidth: true
          Layout.preferredWidth: 0
        }

        // The ones you have.
        ListView {
          id: list
          Layout.fillWidth: true
          Layout.fillHeight: true
          clip: true
          spacing: 2
          model: root.apps
          boundsBehavior: Flickable.StopAtBounds

          delegate: Rectangle {
            id: row
            required property var modelData
            width: ListView.view.width
            height: 44
            radius: Theme.radius
            color: area.containsMouse ? Theme.surface : "transparent"

            MouseArea {
              id: area
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: root.launch(row.modelData)
            }

            RowLayout {
              anchors.fill: parent
              anchors.leftMargin: 8
              anchors.rightMargin: 8
              spacing: 10

              Item {
                Layout.preferredWidth: 28
                Layout.preferredHeight: 28
                Image {
                  id: pic
                  anchors.fill: parent
                  source: row.modelData.icon.startsWith("/") ? "file://" + row.modelData.icon.split("/").map(encodeURIComponent).join("/") : ""
                  sourceSize: Qt.size(56, 56)
                  fillMode: Image.PreserveAspectFit
                  asynchronous: true
                  visible: status === Image.Ready
                }
                Glyph {
                  anchors.centerIn: parent
                  visible: pic.status !== Image.Ready
                  text: String.fromCodePoint(0xF059F) // web
                  color: Theme.fgMuted
                  font.pointSize: 14
                }
              }
              ColumnLayout {
                spacing: 0
                Layout.fillWidth: true
                Label {
                  text: row.modelData.name
                  elide: Text.ElideRight
                  Layout.fillWidth: true
                }
                Caption {
                  text: row.modelData.url.replace(/^https?:\/\//, "").replace(/\/$/, "")
                  elide: Text.ElideRight
                  Layout.fillWidth: true
                }
              }
              Glyph {
                visible: area.containsMouse || removeArea.containsMouse
                text: String.fromCodePoint(0xF0A7A) // trash
                color: removeArea.containsMouse ? Theme.danger : Theme.fgSubtle
                MouseArea {
                  id: removeArea
                  anchors.fill: parent
                  anchors.margins: -6
                  hoverEnabled: true
                  cursorShape: Qt.PointingHandCursor
                  onClicked: root.remove(row.modelData)
                }
              }
            }
          }

          Label {
            anchors.centerIn: parent
            visible: root.apps.length === 0
            text: {{ tq "empty" }}
            color: Theme.fgSubtle
          }
        }

        Rule { Layout.fillWidth: true }

        // A new one.
        RowLayout {
          Layout.fillWidth: true
          spacing: 8
          TextField {
            id: nameField
            Layout.preferredWidth: 150
            placeholder: {{ tq "name" }}
            onAccepted: urlField.focusInput()
            Keys.onTabPressed: urlField.focusInput()
          }
          TextField {
            id: urlField
            Layout.fillWidth: true
            placeholder: {{ tq "address" }}
            onAccepted: root.add(nameField.text, urlField.text)
            Keys.onBacktabPressed: nameField.focusInput()
          }
          Button {
            text: {{ tq "add" }}
            primary: true
            enabled: !adder.running && nameField.text.trim() !== "" && urlField.text.trim() !== ""
            onClicked: root.add(nameField.text, urlField.text)
          }
        }

        Caption {
          visible: root.status !== ""
          text: root.status
          color: root.failed ? Theme.danger : Theme.fgMuted
          elide: Text.ElideRight
          Layout.fillWidth: true
        }

        // A few to add with a click.
        Caption {
          visible: root.suggested.length > 0
          text: {{ tq "suggested" }}
        }
        Flow {
          visible: root.suggested.length > 0
          Layout.fillWidth: true
          spacing: 6
          Repeater {
            model: root.suggested
            Button {
              required property var modelData
              text: modelData[0]
              enabled: !adder.running
              onClicked: root.add(modelData[0], modelData[1])
            }
          }
        }
      }
    }
  }
}
