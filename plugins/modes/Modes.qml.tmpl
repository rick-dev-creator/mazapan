// Generated by mazapan (plugin {{ plugin }}).
//
// The Modes panel: your modes on the left (a click on one's switch turns
// it on or off), what the selected one does on the right. Changes are
// kept as you make them.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/modes"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  property string selected: ""

  readonly property var sel: ModesService.modes.find(m => m.id === selected) || null

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    ModesService.refresh()
    if (!sel) selected = ModesService.active ? ModesService.active.id : ModesService.modes.length > 0 ? ModesService.modes[0].id : ""
    open = true
  }

  function close() { open = false }

  // qs ipc -c mazapan call modes …
  IpcHandler {
    target: "modes"
    function on(id: string): void { ModesService.turnOn(id, "hand") }
    function off(): void { ModesService.turnOff(true) }
    function toggle(id: string): void { ModesService.toggle(id) }
    // The one on ("" when none).
    function active(): string { return ModesService.active ? ModesService.active.id : "" }
    // Every mode: id <tab> name, one per line.
    function list(): string { return ModesService.modes.map(m => m.id + "\t" + ModesService.title(m)).join("\n") }
  }

  // The glyphs a mode can have.
  readonly property var glyphs: [0xF00D6, 0xF0428, 0xF0594, 0xF0297, 0xF00BE, 0xF02CB, 0xF0387, 0xF0176, 0xF0474, 0xF02D5, 0xF0A93, 0xF02DC]

  // The bar's widgets by what they show.
  readonly property var widgetNames: ({
    palette: {{ tq "widget.palette" }},
    markets: {{ tq "widget.markets" }},
    awake: {{ tq "widget.awake" }},
    weather: {{ tq "widget.weather" }},
    clock: {{ tq "widget.clock" }},
    title: {{ tq "widget.title" }},
    workspaces: {{ tq "widget.workspaces" }},
    notifications: {{ tq "widget.notifications" }},
    network: {{ tq "widget.network" }},
    bluetooth: {{ tq "widget.bluetooth" }},
    volume: {{ tq "widget.volume" }},
    battery: {{ tq "widget.battery" }},
    power: {{ tq "widget.power" }},
    monitors: {{ tq "widget.monitors" }},
    recording: {{ tq "widget.recording" }},
  })

  // Days as people write them: "Mon–Fri", "Mon Wed Fri", "Every day".
  function dayRuns(days) {
    const d = days.slice().sort((a, b) => a - b)
    if (d.length === 7) return {{ tq "every_day" }}
    if (d.length === 0) return {{ tq "no_days" }}
    const name = n => Qt.locale("{{ lang }}").dayName(n % 7, Locale.ShortFormat)
    const runs = []
    for (const n of d) {
      const last = runs[runs.length - 1]
      if (last && n === last[1] + 1) last[1] = n
      else runs.push([n, n])
    }
    return runs.map(r => r[1] - r[0] >= 2 ? name(r[0]) + "–" + name(r[1]) : r[0] === r[1] ? name(r[0]) : name(r[0]) + " " + name(r[1])).join(" ")
  }

  function whenText(m) {
    const w = m.when || {}
    if (w.kind === "schedule") return {{ tq "when.schedule_text" }}.arg(dayRuns(w.days || [])).arg(w.from).arg(w.to)
    if (w.kind === "screens") return {{ tq "when.screens_text" }}
    return {{ tq "when.hand_text" }}
  }

  // A row of choices, one of them picked.
  component Choices: Flow {
    id: choices
    property var options: []  // [[value, label]]
    property var value
    signal picked(var value)
    Layout.fillWidth: true
    spacing: 6
    Repeater {
      model: choices.options
      Button {
        required property var modelData
        text: modelData[1]
        primary: choices.value === modelData[0]
        onClicked: choices.picked(modelData[0])
      }
    }
  }

  component Section: Caption {
    Layout.topMargin: 6
    text: ""
  }

  // Text kept a moment after typing stops, each field on its own (the
  // name, a schedule's from or to), merged into the mode as it is then.
  // Only what makes sense: a name, a whole time.
  Timer {
    id: typing
    interval: 400
    property var edits: ({}) // "id/field" -> value
    onTriggered: {
      const e = edits
      edits = {}
      for (const k in e) {
        const [id, field] = k.split("/")
        const m = ModesService.modes.find(x => x.id === id)
        if (!m) continue
        if (field === "name") {
          if (e[k].trim() !== "") ModesService.change(id, "name", e[k].trim())
        } else if (field === "allow") ModesService.change(id, "allow", e[k])
        else if (ModesService.minutes(e[k]) >= 0) ModesService.change(id, "when", Object.assign({}, m.when, { [field]: e[k].trim() }))
      }
    }
  }
  function typed(field, value) {
    const e = Object.assign({}, typing.edits)
    e[root.selected + "/" + field] = value
    typing.edits = e
    typing.restart()
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: Math.min(820, (screen ? screen.width : 1280) * 0.9)
    implicitHeight: Math.min(640, (screen ? screen.height : 900) * 0.85)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-modes"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      anchors.fill: parent
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: root.close()

      RowLayout {
        anchors.fill: parent
        anchors.margins: 16
        spacing: 16

        // --- the modes ---------------------------------------------------------
        ColumnLayout {
          Layout.preferredWidth: 250
          Layout.maximumWidth: 250
          Layout.fillWidth: false
          Layout.fillHeight: true
          spacing: 8

          RowLayout {
            Layout.fillWidth: true
            Caption { text: {{ tq "title" }}.toUpperCase(); Layout.fillWidth: true }
            Button {
              visible: !!ModesService.active
              text: {{ tq "turn_off" }}
              onClicked: ModesService.turnOff(true)
            }
          }

          Label {
            visible: ModesService.fileError !== ""
            text: ModesService.fileError
            color: Theme.danger
            wrapMode: Text.Wrap
            Layout.fillWidth: true
            Layout.preferredWidth: 0
          }

          ListView {
            Layout.fillWidth: true
            Layout.fillHeight: true
            clip: true
            spacing: 2
            model: ModesService.modes
            boundsBehavior: Flickable.StopAtBounds

            delegate: Rectangle {
              id: row
              required property var modelData
              readonly property bool on: !!ModesService.active && ModesService.active.id === modelData.id
              width: ListView.view.width
              height: 52
              radius: Theme.radius
              color: root.selected === modelData.id ? Theme.selection : area.containsMouse ? Theme.surface : "transparent"

              MouseArea {
                id: area
                anchors.fill: parent
                hoverEnabled: true
                cursorShape: Qt.PointingHandCursor
                onClicked: root.selected = row.modelData.id
              }

              RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 10
                anchors.rightMargin: 10
                spacing: 10
                Glyph {
                  text: String.fromCodePoint(row.modelData.glyph || 0xF00BE)
                  color: row.on ? Theme.accentText : Theme.fgMuted
                  font.pointSize: 14
                  Layout.preferredWidth: 20
                }
                ColumnLayout {
                  spacing: 0
                  Layout.fillWidth: true
                  Label {
                    text: ModesService.title(row.modelData)
                    font.bold: row.on
                    elide: Text.ElideRight
                    Layout.fillWidth: true
                  }
                  Caption {
                    text: row.on ? (ModesService.active.how === "auto" ? {{ tq "on_auto" }} : {{ tq "on" }}) : root.whenText(row.modelData)
                    color: row.on ? Theme.accentText : Theme.fgSubtle
                    elide: Text.ElideRight
                    Layout.fillWidth: true
                  }
                }
                Toggle {
                  checked: row.on
                  onToggled: ModesService.toggle(row.modelData.id)
                }
              }
            }
          }

          Button {
            text: {{ tq "new" }}
            onClicked: root.selected = ModesService.add()
          }
        }

        Rectangle {
          Layout.fillHeight: true
          implicitWidth: 1
          color: Theme.border
        }

        // --- what the selected one does ------------------------------------------
        Flickable {
          id: editor
          Layout.fillWidth: true
          Layout.fillHeight: true
          clip: true
          contentHeight: form.implicitHeight
          boundsBehavior: Flickable.StopAtBounds
          visible: !!root.sel

          ColumnLayout {
            id: form
            width: editor.width
            spacing: 8

            // Its glyph and name.
            RowLayout {
              Layout.fillWidth: true
              spacing: 10
              Glyph {
                text: root.sel ? String.fromCodePoint(root.sel.glyph || 0xF00BE) : ""
                color: Theme.accentText
                font.pointSize: 20
              }
              TextField {
                id: nameField
                Layout.fillWidth: true
                text: root.sel ? ModesService.title(root.sel) : ""
                placeholder: {{ tq "name" }}
                onTextChanged: if (root.sel && text !== ModesService.title(root.sel)) root.typed("name", text)
              }
            }
            Flow {
              Layout.fillWidth: true
              spacing: 2
              Repeater {
                model: root.glyphs
                Rectangle {
                  required property var modelData
                  width: 30
                  height: 26
                  radius: Theme.radius
                  color: root.sel && root.sel.glyph === modelData ? Theme.selection : ga.containsMouse ? Theme.surface : "transparent"
                  Glyph {
                    anchors.centerIn: parent
                    text: String.fromCodePoint(parent.modelData)
                    color: Theme.fgMuted
                  }
                  MouseArea {
                    id: ga
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: ModesService.change(root.selected, "glyph", parent.modelData)
                  }
                }
              }
            }

            // Notifications.
            Section { text: {{ tq "notifications" }}.toUpperCase() }
            RowLayout {
              Layout.fillWidth: true
              Label { text: {{ tq "quiet" }}; Layout.fillWidth: true }
              Toggle {
                checked: !!root.sel && root.sel.quiet
                onToggled: on => ModesService.change(root.selected, "quiet", on)
              }
            }
            TextField {
              id: allowField
              visible: !!root.sel && root.sel.quiet
              Layout.fillWidth: true
              text: root.sel ? root.sel.allow || "" : ""
              placeholder: {{ tq "allow" }}
              onTextChanged: if (root.sel && text !== (root.sel.allow || "")) root.typed("allow", text)
            }
            Caption {
              visible: allowField.visible
              text: {{ tq "allow_help" }}
              wrapMode: Text.Wrap
              Layout.fillWidth: true
              Layout.preferredWidth: 0
            }

            // The theme.
            Section { text: {{ tq "theme" }}.toUpperCase() }
            Choices {
              options: [["", {{ tq "unchanged" }}]].concat(ModesService.themes.map(t => [t.id, t.name]))
              value: root.sel ? root.sel.theme || "" : ""
              onPicked: v => ModesService.change(root.selected, "theme", v)
            }

            // Night light and power.
            Section { text: {{ tq "night" }}.toUpperCase() }
            Choices {
              options: [["", {{ tq "unchanged" }}], ["on", {{ tq "night.on" }}], ["off", {{ tq "night.off" }}]]
              value: root.sel ? root.sel.night || "" : ""
              onPicked: v => ModesService.change(root.selected, "night", v)
            }
            Section {
              visible: ModesService.power !== ""
              text: {{ tq "power" }}.toUpperCase()
            }
            Choices {
              visible: ModesService.power !== ""
              options: [["", {{ tq "unchanged" }}]].concat([["power-saver", {{ tq "power.saver" }}], ["balanced", {{ tq "power.balanced" }}],
                ["performance", {{ tq "power.performance" }}]].filter(o => ModesService.profiles.includes(o[0]) || (root.sel && root.sel.power === o[0])))
              value: root.sel ? root.sel.power || "" : ""
              onPicked: v => ModesService.change(root.selected, "power", v)
            }
            Caption {
              visible: ModesService.power !== "" && !!root.sel && !!root.sel.power && !ModesService.profiles.includes(root.sel.power)
              text: {{ tq "power.missing" }}
              color: Theme.warning
              wrapMode: Text.Wrap
              Layout.fillWidth: true
              Layout.preferredWidth: 0
            }
            RowLayout {
              Layout.fillWidth: true
              Layout.topMargin: 6
              ColumnLayout {
                spacing: 0
                Layout.fillWidth: true
                Label { text: {{ tq "awake" }} }
                Caption {
                  text: {{ tq "awake_help" }}
                  wrapMode: Text.Wrap
                  Layout.fillWidth: true
                  Layout.preferredWidth: 0
                }
              }
              Toggle {
                checked: !!root.sel && root.sel.awake
                onToggled: on => ModesService.change(root.selected, "awake", on)
              }
            }

            // The bar.
            Section {
              visible: ModesService.widgets.length > 0
              text: {{ tq "hide" }}.toUpperCase()
            }
            Flow {
              visible: ModesService.widgets.length > 0
              Layout.fillWidth: true
              spacing: 6
              Repeater {
                // The bar's, and any this one hides that isn't there now
                // (so it can be let go).
                model: ModesService.widgets.concat(root.sel ? root.sel.hide.filter(w => !ModesService.widgets.includes(w)) : [])
                Button {
                  required property string modelData
                  readonly property bool hidden: !!root.sel && (root.sel.hide || []).includes(modelData)
                  text: (hidden ? "✕ " : "") + (root.widgetNames[modelData] || modelData)
                  primary: hidden
                  onClicked: {
                    const now = (root.sel.hide || []).filter(w => w !== modelData)
                    ModesService.change(root.selected, "hide", hidden ? now : now.concat([modelData]))
                  }
                }
              }
            }

            // When.
            Section { text: {{ tq "when" }}.toUpperCase() }
            Choices {
              options: [["hand", {{ tq "when.hand" }}], ["schedule", {{ tq "when.schedule" }}], ["screens", {{ tq "when.screens" }}]]
              value: root.sel && root.sel.when ? root.sel.when.kind : "hand"
              onPicked: v => ModesService.change(root.selected, "when", Object.assign({}, root.sel.when, { kind: v }))
            }
            ColumnLayout {
              visible: !!root.sel && !!root.sel.when && root.sel.when.kind === "schedule"
              Layout.fillWidth: true
              spacing: 8
              Flow {
                Layout.fillWidth: true
                spacing: 4
                Repeater {
                  model: [1, 2, 3, 4, 5, 6, 7]
                  Button {
                    required property int modelData
                    readonly property bool on: !!root.sel && !!root.sel.when && (root.sel.when.days || []).includes(modelData)
                    text: Qt.locale("{{ lang }}").dayName(modelData % 7, Locale.ShortFormat)
                    primary: on
                    onClicked: {
                      const d = (root.sel.when.days || []).filter(x => x !== modelData)
                      ModesService.change(root.selected, "when", Object.assign({}, root.sel.when, { days: on ? d : d.concat([modelData]) }))
                    }
                  }
                }
              }
              RowLayout {
                spacing: 8
                Label { text: {{ tq "from" }} }
                TextField {
                  implicitWidth: 80
                  text: root.sel && root.sel.when ? root.sel.when.from || "" : ""
                  placeholder: "09:00"
                  onTextChanged: if (root.sel && text !== root.sel.when.from) root.typed("from", text)
                }
                Label { text: {{ tq "to" }} }
                TextField {
                  implicitWidth: 80
                  text: root.sel && root.sel.when ? root.sel.when.to || "" : ""
                  placeholder: "18:00"
                  onTextChanged: if (root.sel && text !== root.sel.when.to) root.typed("to", text)
                }
              }
              Caption {
                visible: !!root.sel && !!root.sel.when && (ModesService.minutes(root.sel.when.from) < 0 || ModesService.minutes(root.sel.when.to) < 0)
                text: {{ tq "bad_time" }}
                color: Theme.danger
              }
            }
            Caption {
              visible: !!root.sel && !!root.sel.when && root.sel.when.kind !== "hand"
              text: {{ tq "auto_help" }}
              wrapMode: Text.Wrap
              Layout.fillWidth: true
              Layout.preferredWidth: 0
            }

            RowLayout {
              Layout.fillWidth: true
              Layout.topMargin: 12
              Button {
                text: !!ModesService.active && root.sel && ModesService.active.id === root.sel.id ? {{ tq "turn_off" }} : {{ tq "turn_on" }}
                primary: true
                onClicked: ModesService.toggle(root.selected)
              }
              Item { Layout.fillWidth: true }
              Button {
                text: {{ tq "delete" }}
                onClicked: {
                  const id = root.selected
                  const i = ModesService.modes.findIndex(m => m.id === id)
                  ModesService.remove(id)
                  const left = ModesService.modes
                  root.selected = left.length > 0 ? left[Math.min(i, left.length - 1)].id : ""
                }
              }
            }
          }
        }

        Label {
          visible: !root.sel
          Layout.fillWidth: true
          horizontalAlignment: Text.AlignHCenter
          text: {{ tq "none" }}
          color: Theme.fgSubtle
        }
      }
    }
  }
}
