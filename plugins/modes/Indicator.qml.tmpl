// Generated by myarch (plugin {{ plugin }}).
//
// The mode that's on, in the bar (nothing when none): its glyph, as
// macOS shows a Focus; its name a click away, with the modes to switch
// to, off, and the Modes panel.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/modes"

BarItem {
  id: root

  readonly property var mode: ModesService.current

  shown: !!mode
  open: popup.visible
  onClicked: popup.toggle()

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: root.mode ? String.fromCodePoint(root.mode.glyph || 0xF00BE) : ""
    color: Theme.accentText
  }

  BarPopup {
    id: popup
    owner: root
    cardWidth: 280

    Caption { text: {{ tq "title" }}.toUpperCase() }
    Label {
      text: {{ tq "on_now" }}.arg(ModesService.title(root.mode))
      font.bold: true
    }
    Repeater {
      model: ModesService.modes
      ListRow {
        required property var modelData
        Layout.fillWidth: true
        glyph: String.fromCodePoint(modelData.glyph || 0xF00BE)
        title: ModesService.title(modelData)
        active: !!ModesService.active && ModesService.active.id === modelData.id
        onClicked: {
          // Turned off, this goes from the bar: the card with it.
          if (active) popup.visible = false
          ModesService.toggle(modelData.id)
        }
      }
    }
    Rule {}
    RowLayout {
      Layout.fillWidth: true
      Button {
        text: {{ tq "turn_off" }}
        onClicked: {
          popup.visible = false
          ModesService.turnOff(true)
        }
      }
      Item { Layout.fillWidth: true }
      Button {
        text: {{ tq "edit" }}
        onClicked: {
          popup.visible = false
          Quickshell.execDetached(["qs", "ipc", "-c", "myarch", "call", "myarch", "panel", "modes"])
        }
      }
    }
  }
}
