// Generated by mazapan (plugin {{ plugin }}).
//
// Modes: the whole desktop changed at once, as macOS's Focus does for
// notifications. A mode can be quiet (and still let some apps through),
// switch the theme, the power profile and night light, keep the computer
// awake, and take widgets out of the bar. On by hand, on a schedule, or
// while a second screen is connected; off, what it changed goes back
// (unless you changed it yourself meanwhile). One at a time.
//
// The modes are yours, in ~/.local/state/mazapan-modes/modes.json (edited
// in the Modes panel). The other plugins are told through their IPC, so
// a mode only does what the plugins you have can do.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland

Singleton {
  id: root

  readonly property string home: Quickshell.env("HOME")
  readonly property string dir: home + "/.local/state/mazapan-modes"
  readonly property string idle: home + "/.local/share/mazapan/bin/idle"

  // [{id, preset, name, glyph, quiet, allow, theme, power, night, awake,
  //   hide, when: {kind: "hand" | "schedule" | "screens" | "game", days, from, to}}]
  property var modes: []
  // The one on: {id, how: "hand" | "auto", since}; null when none.
  property var active: null
  // What the modes changed and how it was: for each of theme, power and
  // awake a mode set, {set: its value, was: the value before}.
  property var touched: ({})
  // Values just put back (a theme being applied still reads as the old
  // one for a moment): {theme: {from, to}, …, at}.
  property var restored: ({})
  // Automatic ones turned off by hand: not again until their time is over.
  property var dismissed: []

  property bool loaded: false
  property string fileError: ""

  readonly property var current: active ? modes.find(m => m.id === active.id) || null : null

  // How things are (the probe): the themes there are, the theme in use,
  // the power profile and the ones this computer has (none: no
  // power-profiles-daemon), keep awake, the bar's widgets, the screens.
  property bool probed: false
  property var themes: []
  property string theme: ""
  property string power: ""
  property var profiles: []
  property bool awake: false
  property var widgets: []
  property int screens: 1

  // --- names ---------------------------------------------------------------------

  readonly property var presets: ({
    work: {{ tq "preset.work" }},
    presentation: {{ tq "preset.presentation" }},
    night: {{ tq "preset.night" }},
    game: {{ tq "preset.game" }},
  })
  function title(m) {
    if (!m) return ""
    return m.name ? m.name : presets[m.preset] || m.id
  }

  // The four to start with (yours to change or remove): by hand only.
  readonly property var defaults: [
    { id: "work", preset: "work", name: "", glyph: 0xF00D6, quiet: true,
      allow: "slack, teams, zoom, thunderbird, calendar", theme: "", power: "", night: "", awake: false, hide: [],
      when: { kind: "hand", days: [1, 2, 3, 4, 5], from: "09:00", to: "18:00" } },
    { id: "presentation", preset: "presentation", name: "", glyph: 0xF0428, quiet: true,
      allow: "", theme: "", power: "", night: "off", awake: true, hide: ["markets"],
      when: { kind: "hand", days: [1, 2, 3, 4, 5, 6, 7], from: "09:00", to: "18:00" } },
    { id: "night", preset: "night", name: "", glyph: 0xF0594, quiet: true,
      allow: "", theme: "", power: "power-saver", night: "on", awake: false, hide: [],
      when: { kind: "hand", days: [1, 2, 3, 4, 5, 6, 7], from: "22:00", to: "07:00" } },
    // On by itself while a game is open (Steam's, gamescope, one that says so).
    { id: "game", preset: "game", name: "", glyph: 0xF0297, quiet: true,
      allow: "", theme: "", power: "performance", night: "", awake: false, hide: [],
      when: { kind: "game", days: [1, 2, 3, 4, 5, 6, 7], from: "20:00", to: "23:00" } },
  ]

  // Every mode in its full shape (a hand edit may leave things out).
  function normal(m) {
    const w = m.when && typeof m.when === "object" ? m.when : {}
    return {
      id: String(m.id), preset: String(m.preset || ""), name: String(m.name || ""),
      glyph: Number(m.glyph) || 0xF00BE, quiet: m.quiet === true, allow: String(m.allow || ""),
      theme: String(m.theme || ""), power: String(m.power || ""), night: m.night === "on" || m.night === "off" ? m.night : "",
      awake: m.awake === true, hide: Array.isArray(m.hide) ? m.hide.map(String) : [],
      when: { kind: ["schedule", "screens", "game"].includes(w.kind) ? w.kind : "hand",
        days: Array.isArray(w.days) ? w.days.map(Number).filter(d => d >= 1 && d <= 7) : [],
        from: String(w.from || ""), to: String(w.to || "") },
    }
  }

  // --- on and off ----------------------------------------------------------------

  // Every change goes the same way: first how things are now (the probe),
  // then from there to the mode wanted (or none). Asked again meanwhile,
  // the last wish wins.
  property var wish: null     // {id: "" for none, how}
  function go(id, how) {
    wish = { id: id, how: how }
    probe.start()
  }

  function turnOn(id, how) {
    if (!modes.some(m => m.id === id)) return
    go(id, how)
  }

  // Off: what the mode changed goes back. By hand, an automatic one stays
  // off until its time is over.
  function turnOff(byHand) {
    const on = wish ? wish.id : active ? active.id : ""
    const how = wish ? wish.how : active ? active.how : ""
    if (byHand && how === "auto" && on !== "" && !dismissed.includes(on)) dismissed = dismissed.concat([on])
    go("", "")
  }

  function toggle(id) {
    const on = wish ? wish.id : active ? active.id : ""
    if (on === id) turnOff(true)
    else turnOn(id, "hand")
  }

  // From how things are to the mode wished for.
  function arrive() {
    const w = wish
    wish = null
    if (!w) return
    const m = w.id === "" ? null : modes.find(x => x.id === w.id) || null
    if (w.id !== "" && !m) return

    // Theme, power, keep awake: set what the mode sets (what was there
    // kept, the first time), put back what it no longer sets (only if it's
    // still as the mode left it: yours to change meanwhile).
    const now = { theme: theme, power: power, awake: awake }
    const want = {
      theme: m && m.theme && themes.some(t => t.id === m.theme) ? m.theme : undefined,
      power: m && m.power && profiles.includes(m.power) ? m.power : undefined,
      awake: m && m.awake ? true : undefined,
    }
    const t = Object.assign({}, touched)
    const back = {}
    for (const f of ["theme", "power", "awake"]) {
      if (want[f] !== undefined) {
        if (!t[f]) t[f] = { set: want[f], was: recent(f, now[f]) }
        else t[f] = { set: want[f], was: t[f].was }
        if (now[f] !== want[f]) setField(f, want[f])
      } else if (t[f]) {
        if (now[f] === t[f].set && t[f].was !== undefined && t[f].was !== "") {
          setField(f, t[f].was)
          back[f] = { from: t[f].set, to: t[f].was }
        }
        delete t[f]
      }
    }
    touched = t
    if (Object.keys(back).length > 0) restored = Object.assign({}, back, { at: Date.now() })

    active = m ? { id: m.id, how: w.how, since: active && active.id === m.id ? active.since : Date.now() } : null
    if (m) dismissed = dismissed.filter(x => x !== m.id)
    save()
    tell(m)
  }

  // A theme just put back is what was there, even if it doesn't read so
  // yet (it's applied in the background): only while it still reads as
  // what it was put back from. Keep awake and power are put back at once:
  // what they read is what they are.
  function recent(f, value) {
    if (f !== "theme") return value
    const r = restored[f]
    return restored.at && Date.now() - restored.at < 120000 && r && typeof r === "object" && value === r.from ? r.to : value
  }

  function setField(f, v) {
    if (f === "awake") {
      Quickshell.execDetached(["sh", idle, "awake", v ? "on" : "off"])
      awake = v
    } else if (f === "power") {
      Quickshell.execDetached(["powerprofilesctl", "set", v])
      power = v
    } else if (f === "theme") {
      theme = v
      // Detached: the shell reloads on the way, this with it. Failed:
      // everything back as it was, and said.
      Quickshell.execDetached(["sh", "-c",
        'mkdir -p ~/.local/state/mazapan; sleep 0.3; mazapan apply --theme "$0" > ~/.local/state/mazapan/theme.log 2>&1 '
        + '|| { hyprctl reload >/dev/null; qs ipc -c mazapan call mazapan reload >/dev/null; sleep 2; '
        + 'notify-send -a "$2" -u critical -i dialog-warning "$1" 2>/dev/null; }',
        v, {{ tq "theme_failed" }}, {{ tq "title" }}])
    }
  }

  // What lives in the shell, told each time (a reload too): quiet and
  // the apps it lets through, the bar, night light.
  function tell(m) {
    ipc(["notifications", "setMode", m ? title(m) : "", m && m.quiet ? "true" : "false", m && m.quiet ? m.allow : ""])
    ipc(["mazapan", "hide", m ? m.hide.join(",") : ""])
    ipc(["nightlight", "hold", m && m.night ? m.night : "none"])
  }

  // "--": a value starting with "-" is still a value.
  function ipc(args) {
    Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", args[0], args[1], "--"].concat(args.slice(2)))
  }

  // How things are now: the power profile, keep awake, the bar's widgets,
  // the power profiles there are, the screens (not virtual ones), the
  // themes and the one in use.
  Process {
    id: probe
    function start() {
      if (running) rerun = true
      else running = true
    }
    property bool rerun: false
    command: ["sh", "-c", 'printf "%s\\n" "$(powerprofilesctl get 2>/dev/null)" "$(sh "$0" "awake?" 2>/dev/null)" '
      + '"$(qs ipc -c mazapan call mazapan widgets 2>/dev/null | tr "\\n" ,)" '
      + '"$(powerprofilesctl list 2>/dev/null | sed -n "s/^[* ] *\\([a-z-]*\\):$/\\1/p" | tr "\\n" ,)" '
      + '"$(hyprctl monitors all -j 2>/dev/null | tr -d "\\n")"; '
      + 'mazapan themes --json 2>/dev/null', root.idle]
    stdout: StdioCollector {
      onStreamFinished: {
        const lines = text.split("\n")
        root.power = (lines[0] || "").trim()
        root.awake = (lines[1] || "").trim() === "true"
        root.widgets = (lines[2] || "").split(",").map(w => w.trim()).filter(w => w !== "" && w !== "mode")
        root.profiles = (lines[3] || "").split(",").filter(p => p !== "")
        try {
          const mons = JSON.parse(lines[4] || "[]")
          root.screens = mons.filter(x => !String(x.name).startsWith("HEADLESS")).length
        } catch (e) {
          root.screens = Quickshell.screens.length
        }
        try {
          const o = JSON.parse(lines.slice(5).join("\n"))
          root.theme = o.current || ""
          root.themes = (o.themes || []).map(t => ({ id: t.id, name: t.name || t.id }))
        } catch (e) {}
      }
    }
    onExited: {
      if (rerun) {
        rerun = false
        running = true
        return
      }
      const first = !root.probed
      root.probed = true
      if (root.wish) root.arrive()
      else if (first) resumeLater.start()
      root.check()
    }
  }
  function refresh() { probe.start() }

  // Back from a reload or a restart: the shell told again, and keep
  // awake again if the mode set it (it doesn't outlive a restart).
  function resume() {
    if (!current) return
    tell(current)
    if (touched.awake && !awake) setField("awake", true)
  }

  // Once the other plugins are there to listen.
  Timer {
    id: resumeLater
    interval: 1000
    onTriggered: root.resume()
  }

  // --- by their time --------------------------------------------------------------

  function minutes(s) {
    const m = /^(\d{1,2}):(\d{2})$/.exec(String(s || "").trim())
    return m && Number(m[1]) < 24 && Number(m[2]) < 60 ? Number(m[1]) * 60 + Number(m[2]) : -1
  }

  // Its time now? A schedule's days are the days it starts (1 Monday … 7
  // Sunday); past midnight it goes on into the next day. A second screen:
  // any connected (disabled or mirrored too), not a virtual one.
  function due(m) {
    const w = m.when
    if (w.kind === "screens") return screens > 1
    if (w.kind === "game") return games.length > 0
    if (w.kind !== "schedule") return false
    const from = minutes(w.from), to = minutes(w.to)
    if (from < 0 || to < 0 || from === to) return false
    const now = new Date()
    const t = now.getHours() * 60 + now.getMinutes()
    const today = now.getDay() === 0 ? 7 : now.getDay()
    const yesterday = today === 1 ? 7 : today - 1
    if (from < to) return w.days.includes(today) && t >= from && t < to
    return (w.days.includes(today) && t >= from) || (w.days.includes(yesterday) && t < to)
  }

  // Which one should be on by its time, and switch to it directly (one
  // change: what the first changed is known to the second).
  function check() {
    if (!loaded || !probed || wish || probe.running) return
    const still = dismissed.filter(id => { const m = modes.find(x => x.id === id); return m && due(m) })
    if (still.length !== dismissed.length) {
      dismissed = still
      save()
    }
    if (active && !current) { go("", ""); return }
    if (active && active.how === "hand") return
    const next = modes.find(m => due(m) && !dismissed.includes(m.id))
    if (active && active.how === "auto") {
      if (due(current)) return
      go(next ? next.id : "", next ? "auto" : "")
      return
    }
    if (next) go(next.id, "auto")
  }

  Timer {
    interval: 30000
    running: root.loaded
    repeat: true
    onTriggered: root.check()
  }
  // Screens come and go in bursts: looked at once they've settled.
  Timer {
    id: screensSettle
    interval: 2000
    onTriggered: root.refresh()
  }
  Connections {
    target: Quickshell
    function onScreensChanged() { screensSettle.restart() }
  }
  Connections {
    target: Hyprland
    function onRawEvent(event) {
      if (["monitoradded", "monitorremoved", "monitoraddedv2", "monitorremovedv2"].includes(event.name)) screensSettle.restart()
      // A game opened or closed ("ADDRESS,WORKSPACE,CLASS,TITLE" / "ADDRESS").
      if (event.name === "openwindow") {
        const f = event.data.split(",")
        if (f.length >= 3 && root.isGame(f[2]) && !root.games.includes(f[0])) { root.games = root.games.concat([f[0]]); root.check() }
      } else if (event.name === "closewindow" && root.games.includes(event.data)) {
        root.games = root.games.filter(a => a !== event.data)
        gameSettle.restart()
      }
    }
  }
  // The windows that are games, by address. Closing one and opening the
  // next (a launcher, then the game) doesn't turn the mode off between.
  property var games: []
  function isGame(cls) { return /^steam_app_\d+$|^gamescope$/.test(cls) }
  Timer { id: gameSettle; interval: 5000; onTriggered: root.check() }
  Timer {
    id: gamesAtStart
    interval: 1500
    onTriggered: {
      root.games = Hyprland.toplevels.values
        .filter(t => t.lastIpcObject && (root.isGame(t.lastIpcObject.class || "") || t.lastIpcObject.contentType === "game"))
        .map(t => String(t.address).replace(/^0x/, ""))
      root.check()
    }
  }
  // Edits settle before their times are looked at (a time half typed
  // isn't the end of a mode).
  Timer {
    id: editSettle
    interval: 3000
    onTriggered: {
      if (root.current) root.go(root.active.id, root.active.how)
      else root.check()
    }
  }

  // --- editing ------------------------------------------------------------------

  function change(id, field, value) {
    modes = modes.map(m => m.id === id ? normal(Object.assign({}, m, { [field]: value })) : m)
    save()
    // The one on changed: what's in the shell at once, the rest (and its
    // time) once the edits settle.
    if (active && active.id === id) tell(current)
    editSettle.restart()
  }

  function add() {
    let n = 1
    while (modes.some(m => m.id === "mode-" + n)) n++
    const m = normal({ id: "mode-" + n, name: {{ tq "new_name" }}.arg(n), glyph: 0xF00BE, quiet: true,
      when: { kind: "hand", days: [1, 2, 3, 4, 5], from: "09:00", to: "17:00" } })
    modes = modes.concat([m])
    save()
    return m.id
  }

  function remove(id) {
    if (active && active.id === id) go("", "")
    modes = modes.filter(m => m.id !== id)
    dismissed = dismissed.filter(x => x !== id)
    save()
  }

  // --- kept ---------------------------------------------------------------------

  // Saved once per turn, however many changes it had; what we wrote isn't
  // read back as news.
  property bool dirty: false
  property var ours: []
  function save() {
    if (fileError !== "") return
    if (!dirty) {
      dirty = true
      Qt.callLater(flush)
    }
  }
  function flush() {
    dirty = false
    const text = JSON.stringify({ version: 2, modes: modes, active: active, touched: touched, restored: restored, dismissed: dismissed }, null, 2) + "\n"
    ours = ours.concat([text]).slice(-4)
    store.setText(text)
  }

  function use(o) {
    const first = !loaded
    const was = JSON.stringify(current)
    modes = Array.isArray(o.modes) ? o.modes.filter(m => m && typeof m.id === "string").map(normal) : defaults.map(normal)
    active = o.active && typeof o.active.id === "string" ? o.active : null
    touched = o.touched && typeof o.touched === "object" ? o.touched : {}
    restored = o.restored && typeof o.restored === "object" ? o.restored : {}
    dismissed = Array.isArray(o.dismissed) ? o.dismissed.map(String) : []
    loaded = true
    if (first) {
      refresh() // then resume() and check()
      return
    }
    // Edited by hand: the one on applied again if it changed.
    if (current && JSON.stringify(current) !== was) editSettle.restart()
    else Qt.callLater(check)
  }

  FileView {
    id: store
    path: root.dir + "/modes.json"
    watchChanges: true
    atomicWrites: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: {
      const t = text()
      if (root.loaded && root.ours.includes(t)) return // our own save
      let o
      try {
        o = JSON.parse(t)
      } catch (e) {
        o = null
      }
      if (!o || typeof o !== "object") {
        // Caught halfway through being written (an editor saving in
        // place): read again in a moment; still broken, it's said, and
        // nothing is saved over it.
        if (!again.done) {
          again.done = true
          again.restart()
          return
        }
        root.fileError = {{ tq "file_error" }}.arg(path)
        root.loaded = true
        return
      }
      again.done = false
      root.fileError = ""
      root.use(o)
    }
    // Not there yet: the four to start with, written on the first change.
    onLoadFailed: root.use({ modes: root.defaults })
  }

  Timer {
    id: again
    interval: 600
    property bool done: false
    onTriggered: store.reload()
  }

  Component.onCompleted: {
    Quickshell.execDetached(["mkdir", "-p", root.dir])
    // The games already open (a shell restarted mid-game).
    Hyprland.refreshToplevels()
    gamesAtStart.start()
  }
}
