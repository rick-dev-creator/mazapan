// Generated by mazapan (plugin {{ plugin }}).
//
// The desktop's history: what changed, in words, newest first (a theme,
// a setting, a plugin on or off, an update), and each one's own undo. An
// older change is undone on its own: only what it changed and is still
// as it left it goes back, and the undo shows up here too
// (mazapan timeline undo). An update is rolled back in a terminal (it
// asks for your password).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null

  property var entries: []
  property var themes: ({})   // id -> {name, colors}
  property string selected: ""
  property bool loading: false
  property string message: ""
  property bool failed: false

  readonly property var sel: entries.find(e => e.id === selected) || null

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    message = ""
    refresh()
    open = true
  }

  function close() { open = false }

  function refresh() {
    loading = true
    reader.running = true
  }

  Process {
    id: reader
    command: ["sh", "-c", "mazapan timeline --json; echo; mazapan themes --json"]
    stdout: StdioCollector {
      onStreamFinished: {
        const parts = text.split("\n").filter(l => l.trim() !== "")
        try {
          root.entries = JSON.parse(parts[0]).entries || []
        } catch (e) {
          root.entries = []
        }
        try {
          const t = {}
          for (const x of JSON.parse(parts[1]).themes || []) t[x.id] = { name: x.name, colors: x.colors || {} }
          root.themes = t
        } catch (e) {}
        root.loading = false
        if (!root.sel && root.entries.length > 0) root.selected = root.entries[0].id
      }
    }
  }

  // --- words ------------------------------------------------------------------------

  function glyph(e) {
    if (e.kind === "update") return 0xF03D7 // package
    if (e.kind === "snapshot") return 0xF06B0 // restore
    if (e.kind === "apps") return 0xF003B     // apps
    const c = e.changes[0]
    if (!c) return 0xF0214                  // file
    if (c.kind === "theme" || c.kind === "accent") return 0xF03D8 // palette
    if (c.kind === "on" || c.kind === "off") return 0xF0431       // puzzle
    return 0xF062E                                                // tune
  }

  function value(v, def) {
    if (v === null || v === undefined) return def === null || def === undefined ? {{ tq "default" }} : {{ tq "default_is" }}.arg(show_(def))
    return show_(v)
  }
  function show_(v) {
    if (typeof v === "boolean") return v ? {{ tq "yes" }} : {{ tq "no" }}
    if (Array.isArray(v)) return v.map(show_).join(", ")
    if (v !== null && typeof v === "object") return JSON.stringify(v)
    return String(v)
  }

  // One change in words.
  function says(c) {
    switch (c.kind) {
    case "theme": return {{ tq "c.theme" }}.arg(c.from_name || c.from || "—").arg(c.to_name || c.to)
    case "accent": return {{ tq "c.accent" }}.arg(c.from || {{ tq "theme_own" }}).arg(c.to || {{ tq "theme_own" }})
    case "language": return {{ tq "c.language" }}.arg(c.from || {{ tq "system" }}).arg(c.to || {{ tq "system" }})
    case "on": return {{ tq "c.on" }}.arg(c.plugin_name)
    case "off": return {{ tq "c.off" }}.arg(c.plugin_name)
    case "setting": return {{ tq "c.setting" }}.arg(c.plugin_name).arg(c.label).arg(value(c.from, c.default)).arg(value(c.to, c.default))
    case "catalog": return {{ tq "c.catalog" }}.arg(c.to)
    case "catalog-removed": return {{ tq "c.catalog_removed" }}.arg(c.from)
    }
    return c.kind
  }

  // An entry in words: its changes, or whose files, or the update; an agent's, marked.
  function title(e) { return (e.by ? "󰚩 " : "") + title_(e) }
  function title_(e) {
    if (e.kind === "update") return {{ tq "update" }}.arg(e.packages_changed)
    if (e.kind === "snapshot") return {{ tq "snapshot" }}.arg(e.what)
    if (e.kind === "apps") return (e.action === "install" ? {{ tq "apps_installed" }} : {{ tq "apps_removed" }}).arg(e.names.join(", "))
    if (e.changes.length > 0) return says(e.changes[0]) + (e.changes.length > 1 ? " " + {{ tq "and_more" }}.arg(e.changes.length - 1) : "")
    if (e.known === false) return {{ tq "unknown" }}
    const names = (e.by_plugin || []).map(g => g.plugin_name || {{ tq "others" }})
    return {{ tq "files_of" }}.arg(names.slice(0, 3).join(", ") + (names.length > 3 ? "…" : ""))
  }

  function outcome(o) {
    return o === "ok" ? {{ tq "o.ok" }} : o === "rolled-back" ? {{ tq "o.rolled_back" }} : o === "failed" ? {{ tq "o.failed" }}
      : o === "in-progress" ? {{ tq "o.in_progress" }} : o
  }

  function day(iso) {
    const d = new Date(iso)
    const today = new Date()
    const y = new Date(today.getTime() - 86400000)
    if (d.toDateString() === today.toDateString()) return {{ tq "today" }}
    if (d.toDateString() === y.toDateString()) return {{ tq "yesterday" }}
    return d.toLocaleDateString(Qt.locale("{{ lang }}"), "dddd d MMMM")
  }
  function time(iso) {
    return new Date(iso).toLocaleTimeString(Qt.locale("{{ lang }}"), Locale.ShortFormat)
  }

  // --- undo --------------------------------------------------------------------------


  function undo(e) {
    if (!e) return
    // Apps: removed again (or installed again), the password through polkit.
    if (e.undo === "apps") {
      Quickshell.execDetached(["sh", "-c", 'mkdir -p ~/.local/state/mazapan; '
        + 'if mazapan apps undo "$0" --gui > ~/.local/state/mazapan/undo.log 2>&1; then notify-send -a "$3" -i edit-undo "$1"; '
        + 'else notify-send -a "$3" -u critical -i dialog-warning "$2" "$(grep "^mazapan:" ~/.local/state/mazapan/undo.log | tail -n 1 | sed "s/^mazapan: //")"; fi',
        e.id.replace(/^apps-/, ""), {{ tq "undone" }}.arg(title(e)), {{ tq "undo_failed_title" }}, {{ tq "title" }}])
      message = {{ tq "undoing" }}
      failed = false
      return
    }
    if (e.undo === "rollback" || e.undo === "root") {
      // As root (packages, system files): in a terminal, for the password.
      const run = e.undo === "rollback" ? 'mazapan rollback "$0"' : 'mazapan undo --id="$0"'
      Quickshell.execDetached(["sh", "-c",
        'set -- sh -c \'' + run + '; echo; printf "%s" "$1"; read -r _\' "$0" "$1"; '
        + 'if command -v xdg-terminal-exec >/dev/null; then exec xdg-terminal-exec "$@"; else exec foot "$@"; fi',
        e.id, {{ tq "press_enter" }}])
      close()
      return
    }
    // Detached: the apply reloads the shell on the way, this panel with
    // it (a child of the shell would go with it, half done). Said once
    // it's over, in a notification.
    Quickshell.execDetached(["sh", "-c", 'mkdir -p ~/.local/state/mazapan; '
      + 'if mazapan timeline undo "$0" -y > ~/.local/state/mazapan/undo.log 2>&1; then notify-send -a "$3" -i edit-undo "$1"; '
      + 'else hyprctl reload >/dev/null; qs ipc -c mazapan call mazapan reload >/dev/null; sleep 2; '
      + 'notify-send -a "$3" -u critical -i dialog-warning "$2" "$(grep "^mazapan:" ~/.local/state/mazapan/undo.log | tail -n 1 | sed "s/^mazapan: //")"; fi',
      e.id, {{ tq "undone" }}.arg(title(e)), {{ tq "undo_failed_title" }}, {{ tq "title" }}])
    message = {{ tq "undoing" }}
    failed = false
  }

  // An agent's changes the same day, newest first: undone together.
  function agentDay(e) {
    if (!e || !e.by) return []
    // Each undone newest first, so one a later change of its own covered comes back to be undone.
    const all = entries.filter(x => x.kind === "apply" && x.by === e.by && x.known !== false && day(x.time) === day(e.time))
    return all.some(x => x.undo !== "none") ? all : []
  }
  function undoAll(list) {
    if (list.length === 0) return
    // $0 the app's name, $1 what's said when done, $2 when not; then the ids.
    Quickshell.execDetached(["sh", "-c", 'mkdir -p ~/.local/state/mazapan; ok=$1; bad=$2; shift 2; '
      + 'if mazapan timeline undo "$@" -y > ~/.local/state/mazapan/undo.log 2>&1; then notify-send -a "$0" -i edit-undo "$ok"; '
      + 'else hyprctl reload >/dev/null; qs ipc -c mazapan call mazapan reload >/dev/null; sleep 2; '
      + 'notify-send -a "$0" -u critical -i dialog-warning "$bad" "$(grep "^mazapan:" ~/.local/state/mazapan/undo.log | tail -n 1 | sed "s/^mazapan: //")"; fi',
      {{ tq "title" }}, {{ tq "undone_agent" }}.arg(list[0].by).arg(list.length), {{ tq "undo_failed_title" }}].concat(list.map(x => x.id)))
    message = {{ tq "undoing" }}
    failed = false
  }

  // --- the panel -----------------------------------------------------------------------

  component Swatch: Row {
    property var colors: ({})
    spacing: 0
    Repeater {
      model: ["bg", "surface", "fg", "accent", "success", "warning", "danger"]
      Rectangle {
        required property string modelData
        width: 22
        height: 16
        color: parent.colors[modelData] || "transparent"
      }
    }
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: Math.min(900, (screen ? screen.width : 1280) * 0.9)
    implicitHeight: Math.min(640, (screen ? screen.height : 900) * 0.85)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-history"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      anchors.fill: parent
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: root.close()
      Keys.onPressed: event => {
        const i = root.entries.findIndex(e => e.id === root.selected)
        if (event.key === Qt.Key_Down && i < root.entries.length - 1) root.selected = root.entries[i + 1].id
        else if (event.key === Qt.Key_Up && i > 0) root.selected = root.entries[i - 1].id
        else return
        list.positionViewAtIndex(Math.max(0, root.entries.findIndex(e => e.id === root.selected)), ListView.Contain)
        event.accepted = true
      }

      RowLayout {
        anchors.fill: parent
        anchors.margins: 16
        spacing: 16

        // --- what changed, newest first -------------------------------------------
        ColumnLayout {
          Layout.preferredWidth: 400
          Layout.maximumWidth: 400
          Layout.fillWidth: false
          Layout.fillHeight: true
          spacing: 8

          Caption { text: {{ tq "title" }}.toUpperCase() }

          ListView {
            id: list
            Layout.fillWidth: true
            Layout.fillHeight: true
            clip: true
            spacing: 2
            model: root.entries
            boundsBehavior: Flickable.StopAtBounds

            delegate: ColumnLayout {
              id: item
              required property var modelData
              required property int index
              width: ListView.view.width
              spacing: 2

              // The day, over its first entry.
              Caption {
                visible: item.index === 0 || root.day(root.entries[item.index - 1].time) !== root.day(item.modelData.time)
                Layout.topMargin: item.index === 0 ? 0 : 8
                text: root.day(item.modelData.time)
              }

              Rectangle {
                Layout.fillWidth: true
                implicitHeight: 44
                radius: Theme.radius
                color: root.selected === item.modelData.id ? Theme.selection : area.containsMouse ? Theme.surface : "transparent"

                MouseArea {
                  id: area
                  anchors.fill: parent
                  hoverEnabled: true
                  cursorShape: Qt.PointingHandCursor
                  onClicked: root.selected = item.modelData.id
                }

                RowLayout {
                  anchors.fill: parent
                  anchors.leftMargin: 10
                  anchors.rightMargin: 10
                  spacing: 10
                  Glyph {
                    text: String.fromCodePoint(root.glyph(item.modelData))
                    color: item.modelData.kind === "update" && item.modelData.outcome !== "ok" ? Theme.warning : Theme.fgMuted
                    Layout.preferredWidth: 18
                  }
                  Label {
                    text: root.title(item.modelData)
                    elide: Text.ElideRight
                    Layout.fillWidth: true
                  }
                  Caption { text: root.time(item.modelData.time) }
                }
              }
            }

            Label {
              anchors.centerIn: parent
              visible: !root.loading && root.entries.length === 0
              text: {{ tq "empty" }}
              color: Theme.fgSubtle
            }
          }
        }

        Rectangle {
          Layout.fillHeight: true
          implicitWidth: 1
          color: Theme.border
        }

        // --- the selected one ---------------------------------------------------------
        ColumnLayout {
          Layout.fillWidth: true
          Layout.fillHeight: true
          spacing: 10
          visible: !!root.sel

          Label {
            text: root.sel ? root.title(root.sel) : ""
            font.bold: true
            wrapMode: Text.Wrap
            Layout.fillWidth: true
            Layout.preferredWidth: 0
          }
          Caption {
            text: root.sel ? root.day(root.sel.time) + " · " + root.time(root.sel.time) : ""
          }

          Flickable {
            Layout.fillWidth: true
            Layout.fillHeight: true
            clip: true
            contentHeight: details.implicitHeight
            boundsBehavior: Flickable.StopAtBounds

            ColumnLayout {
              id: details
              width: parent.width
              spacing: 10

              // Whose: an agent's, through mazapan's MCP server.
              Caption {
                visible: !!root.sel && !!root.sel.by
                text: root.sel && root.sel.by ? "󰚩 " + {{ tq "by_agent" }}.arg(root.sel.by) : ""
                color: Theme.fgMuted
              }

              // Each change, and a theme's colors before and after.
              Repeater {
                model: root.sel ? root.sel.changes : []
                ColumnLayout {
                  required property var modelData
                  Layout.fillWidth: true
                  spacing: 4
                  RowLayout {
                    Layout.fillWidth: true
                    spacing: 8
                    Glyph {
                      text: modelData.current ? "•" : "◦"
                      color: modelData.current ? Theme.accentText : Theme.fgSubtle
                    }
                    Label {
                      text: root.says(modelData)
                      wrapMode: Text.Wrap
                      Layout.fillWidth: true
                      Layout.preferredWidth: 0
                    }
                  }
                  RowLayout {
                    visible: modelData.kind === "theme" && !!root.themes[modelData.to]
                    Layout.leftMargin: 20
                    spacing: 8
                    Swatch { colors: root.themes[modelData.from] ? root.themes[modelData.from].colors : ({}) }
                    Caption { text: "→" }
                    Swatch { colors: root.themes[modelData.to] ? root.themes[modelData.to].colors : ({}) }
                  }
                  Caption {
                    visible: !modelData.current
                    Layout.leftMargin: 20
                    text: {{ tq "changed_since" }}
                  }
                }
              }

              // Files only: whose.
              Repeater {
                model: root.sel && root.sel.changes.length === 0 ? root.sel.by_plugin || [] : []
                Label {
                  required property var modelData
                  text: (modelData.plugin_name || {{ tq "others" }}) + ": " + [
                    modelData.added ? {{ tq "n_added" }}.arg(modelData.added) : "",
                    modelData.changed ? {{ tq "n_changed" }}.arg(modelData.changed) : "",
                    modelData.removed ? {{ tq "n_removed" }}.arg(modelData.removed) : "",
                  ].filter(x => x !== "").join(", ")
                  wrapMode: Text.Wrap
                  Layout.fillWidth: true
                  Layout.preferredWidth: 0
                }
              }
              Caption {
                visible: !!root.sel && root.sel.kind === "apply" && root.sel.changes.length === 0
                text: {{ tq "files_help" }}
                wrapMode: Text.Wrap
                Layout.fillWidth: true
                Layout.preferredWidth: 0
              }

              // A system snapshot: which, and how to go back to it.
              Label {
                visible: !!root.sel && root.sel.kind === "snapshot"
                text: !root.sel || root.sel.kind !== "snapshot" ? ""
                  : root.sel.post > 0 ? {{ tq "snapshot_pair" }}.arg(root.sel.pre).arg(root.sel.post) : {{ tq "snapshot_one" }}.arg(root.sel.pre)
                wrapMode: Text.Wrap
                Layout.fillWidth: true
                Layout.preferredWidth: 0
              }
              Caption {
                visible: !!root.sel && root.sel.kind === "snapshot" && text !== ""
                text: !root.sel ? "" : root.sel.bootable ? {{ tq "snapshot_boot" }} : root.sel.boot_possible ? {{ tq "snapshot_noboot" }} : ""
                wrapMode: Text.Wrap
                Layout.fillWidth: true
                Layout.preferredWidth: 0
              }
              Caption {
                // Only where the snapshots have the kernel too (else its
                // files and today's kernel wouldn't match).
                visible: !!root.sel && root.sel.kind === "snapshot" && root.sel.post > 0 && root.sel.boot_on_root
                text: root.sel && root.sel.post > 0 ? {{ tq "snapshot_undo" }}.arg(root.sel.pre + ".." + root.sel.post) : ""
                font.family: Theme.fontMono
                wrapMode: Text.WrapAnywhere
                Layout.fillWidth: true
                Layout.preferredWidth: 0
              }

              // An update: how it went.
              Label {
                visible: !!root.sel && root.sel.kind === "update"
                text: root.sel && root.sel.kind === "update" ? root.outcome(root.sel.outcome) : ""
                color: root.sel && root.sel.outcome === "ok" ? Theme.fg : Theme.warning
              }
              Caption {
                visible: !!root.sel && !!root.sel.note
                text: root.sel ? root.sel.note || "" : ""
                wrapMode: Text.Wrap
                Layout.fillWidth: true
                Layout.preferredWidth: 0
              }
            }
          }

          Caption {
            visible: root.message !== ""
            text: root.message
            color: root.failed ? Theme.danger : Theme.fgMuted
            wrapMode: Text.Wrap
            Layout.fillWidth: true
            Layout.preferredWidth: 0
          }

          RowLayout {
            Layout.fillWidth: true
            Button {
              visible: !!root.sel && root.sel.undo !== "none"
              primary: true
              text: root.sel && root.sel.undo === "rollback" ? {{ tq "rollback" }} : {{ tq "undo" }}
              onClicked: root.undo(root.sel)
            }
            Button {
              readonly property var all: root.agentDay(root.sel)
              visible: all.length > 1
              text: {{ tq "undo_agent" }}.arg(root.sel ? root.sel.by : "").arg(all.length)
              onClicked: root.undoAll(all)
            }
            Caption {
              visible: !!root.sel && root.sel.undo === "none" && root.sel.kind !== "snapshot"
              text: root.sel && root.sel.kind === "apply" && root.sel.changes.length === 0 ? {{ tq "no_undo_files" }} : {{ tq "no_undo" }}
              wrapMode: Text.Wrap
              Layout.fillWidth: true
              Layout.preferredWidth: 0
            }
            Item { Layout.fillWidth: true }
          }
        }
      }
    }
  }
}
