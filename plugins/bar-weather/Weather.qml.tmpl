// Generated by mazapan (plugin {{ plugin }}).
//
// Glyph and temperature in the bar; a click opens the details: now, the next
// hours and the next days. A click outside, Escape or the widget again
// closes them.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/weather"

BarItem {
  id: root

  readonly property var now: WeatherService.current

  open: popup.visible
  onClicked: popup.toggle()

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: root.now ? WeatherService.glyph(root.now.code, root.now.isDay) : ""
    color: root.now ? Theme.accentText : Theme.fgSubtle
  }

  Label {
    anchors.verticalCenter: parent.verticalCenter
    text: root.now ? `${root.now.temp}°` : WeatherService.error !== "" ? "--" : "…"
    color: root.now ? Theme.fg : Theme.fgSubtle
  }

  BarPopup {
    id: popup
    owner: root
    cardWidth: 400

    RowLayout {
      Layout.fillWidth: true
      Caption { text: (WeatherService.place || {{ tq "title" }}).toUpperCase() }
      Item { Layout.fillWidth: true }
      Caption {
        text: WeatherService.error !== "" ? WeatherService.error
            : WeatherService.updated !== "" ? {{ tq "updated" }}.arg(WeatherService.updated) : {{ tq "loading" }}
        color: WeatherService.error !== "" ? Theme.danger : Theme.fgSubtle
      }
    }

    // Now.
    RowLayout {
      visible: root.now !== null
      spacing: 16

      Text {
        text: root.now ? WeatherService.glyph(root.now.code, root.now.isDay) : ""
        color: Theme.accentText
        font.family: Theme.fontMono
        font.pointSize: 30
      }

      ColumnLayout {
        spacing: 2
        Text {
          text: root.now ? `${root.now.temp}°` : ""
          color: Theme.fg
          font.family: Theme.fontMono
          font.pointSize: 26
          font.bold: true
        }
        Text {
          text: root.now ? WeatherService.describe(root.now.code) : ""
          color: Theme.fg
          font.family: Theme.fontMono
          font.pointSize: 10
        }
        Text {
          text: root.now ? {{ tq "feels" }}.arg(root.now.feels).arg(root.now.max).arg(root.now.min) : ""
          color: Theme.fgMuted
          font.family: Theme.fontMono
          font.pointSize: 9
        }
      }
    }

    Rule { visible: root.now !== null }

    GridLayout {
      visible: root.now !== null
      Layout.fillWidth: true
      columns: 3
      rowSpacing: 6
      columnSpacing: 12

      Repeater {
        model: root.now ? [
          [{{ tq "humidity" }}, `${root.now.humidity}%`],
          [{{ tq "wind" }}, `${root.now.wind} ${WeatherService.windUnit}`],
          [{{ tq "rain" }}, `${root.now.precip}%`],
          [{{ tq "sunrise" }}, root.now.sunrise],
          [{{ tq "sunset" }}, root.now.sunset],
        ] : []

        ColumnLayout {
          required property var modelData
          Layout.fillWidth: true
          spacing: 1
          Caption { text: modelData[0].toUpperCase() }
          Text {
            text: modelData[1]
            color: Theme.fg
            font.family: Theme.fontMono
            font.pointSize: 10
          }
        }
      }
    }

    Rule { visible: WeatherService.hours.length > 0 }
    Caption { visible: WeatherService.hours.length > 0; text: {{ tq "next_hours" }}.toUpperCase() }

    RowLayout {
      visible: WeatherService.hours.length > 0
      Layout.fillWidth: true
      spacing: 0

      Repeater {
        model: WeatherService.hours

        ColumnLayout {
          required property var modelData
          // Equal preferred widths + fill: the hours share the row evenly.
          Layout.fillWidth: true
          Layout.preferredWidth: 1
          spacing: 4
          Text {
            Layout.fillWidth: true
            horizontalAlignment: Text.AlignHCenter
            text: modelData.label
            color: Theme.fgMuted
            font.family: Theme.fontMono
            font.pointSize: 8.5
          }
          Text {
            Layout.fillWidth: true
            horizontalAlignment: Text.AlignHCenter
            text: WeatherService.glyph(modelData.code, modelData.isDay)
            color: Theme.accentText
            font.family: Theme.fontMono
            font.pointSize: 13
          }
          Text {
            Layout.fillWidth: true
            horizontalAlignment: Text.AlignHCenter
            text: `${modelData.temp}°`
            color: Theme.fg
            font.family: Theme.fontMono
            font.pointSize: 9.5
          }
        }
      }
    }

    Rule { visible: WeatherService.days.length > 0 }
    Caption { visible: WeatherService.days.length > 0; text: {{ tq "next_days" }}.toUpperCase() }

    ColumnLayout {
      id: week
      visible: WeatherService.days.length > 0
      Layout.fillWidth: true
      spacing: 6

      // The range bars share one scale: the week's coldest to hottest.
      readonly property real low: Math.min(...WeatherService.days.map(d => d.min))
      readonly property real high: Math.max(...WeatherService.days.map(d => d.max))

      Repeater {
        model: WeatherService.days

        RowLayout {
          required property var modelData
          Layout.fillWidth: true
          spacing: 10

          Text {
            Layout.preferredWidth: 48
            elide: Text.ElideRight
            text: modelData.label
            color: modelData.today ? Theme.fg : Theme.fgMuted
            font.family: Theme.fontMono
            font.pointSize: 9.5
          }
          Text {
            Layout.preferredWidth: 20
            text: WeatherService.glyph(modelData.code, true)
            color: Theme.accentText
            font.family: Theme.fontMono
            font.pointSize: 12
          }
          Text {
            Layout.preferredWidth: 30
            horizontalAlignment: Text.AlignRight
            text: `${modelData.min}°`
            color: Theme.fgMuted
            font.family: Theme.fontMono
            font.pointSize: 9.5
          }
          Rectangle {
            id: track
            Layout.fillWidth: true
            implicitHeight: 4
            color: Theme.surface

            readonly property real span: Math.max(1, week.high - week.low)

            Rectangle {
              x: track.width * (modelData.min - week.low) / track.span
              width: Math.max(4, track.width * (modelData.max - modelData.min) / track.span)
              height: parent.height
              color: Theme.accent
            }
          }
          Text {
            Layout.preferredWidth: 30
            text: `${modelData.max}°`
            color: Theme.fg
            font.family: Theme.fontMono
            font.pointSize: 9.5
          }
          Text {
            Layout.preferredWidth: 36
            horizontalAlignment: Text.AlignRight
            text: `${modelData.precip}%`
            color: modelData.precip >= 50 ? Theme.info : Theme.fgSubtle
            font.family: Theme.fontMono
            font.pointSize: 8.5
          }
        }
      }
    }

    Caption {
      Layout.alignment: Qt.AlignRight
      text: "open-meteo.com"
    }
  }
}
