// Generated by myarch (plugin {{.Plugin}}).
//
// Finds the location once, then fetches the forecast every
// {{.Settings.refresh_minutes}} minutes. One instance for the whole shell, however many bars.
pragma Singleton

import QtQuick
import Quickshell

Singleton {
  id: root

  readonly property string location: "{{.Settings.location}}"
  readonly property bool imperial: "{{.Settings.units}}" === "imperial"
  readonly property string windUnit: imperial ? "mph" : "km/h"
  // Day names and times in the system's language.
  readonly property var locale: Qt.locale("{{.Lang}}")

  property bool ready: false
  property string error: ""
  property string place: ""
  property real lat: NaN
  property real lon: NaN
  property var current: null // temp feels humidity wind precip code isDay max min sunrise sunset
  property var hours: []     // next 8: label temp code isDay precip
  property var days: []      // next 5: today label code min max precip
  property string updated: ""

  function get(url, done) {
    const xhr = new XMLHttpRequest()
    xhr.onreadystatechange = () => {
      if (xhr.readyState !== XMLHttpRequest.DONE) return
      if (xhr.status !== 200) {
        root.error = {{tq "offline"}}.arg(xhr.status || "-")
        return
      }
      try {
        done(JSON.parse(xhr.responseText))
      } catch (e) {
        root.error = {{tq "bad_response"}}
      }
    }
    xhr.open("GET", url)
    xhr.send()
  }

  // Resolve lat/lon once; later refreshes reuse them.
  function locate(then) {
    if (!isNaN(lat)) return then()
    const coords = location.match(/^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$/)
    if (coords) {
      lat = Number(coords[1])
      lon = Number(coords[2])
      place = location
      return then()
    }
    if (location === "auto") {
      get("https://ipinfo.io/json", o => {
        const [a, b] = String(o.loc).split(",")
        lat = Number(a)
        lon = Number(b)
        place = o.city || o.region || ""
        then()
      })
      return
    }
    get(`https://geocoding-api.open-meteo.com/v1/search?count=1&language={{.LangCode}}&name=${encodeURIComponent(location)}`, o => {
      const r = o.results && o.results[0]
      if (!r) {
        root.error = {{tq "not_found"}}.arg(location)
        return
      }
      lat = r.latitude
      lon = r.longitude
      place = r.name
      then()
    })
  }

  function refresh() {
    locate(() => {
      const units = imperial ? "&temperature_unit=fahrenheit&wind_speed_unit=mph&precipitation_unit=inch" : ""
      get("https://api.open-meteo.com/v1/forecast"
          + `?latitude=${lat}&longitude=${lon}&timezone=auto&forecast_days=6${units}`
          + "&current=temperature_2m,apparent_temperature,relative_humidity_2m,weather_code,wind_speed_10m,is_day,precipitation"
          + "&hourly=temperature_2m,weather_code,precipitation_probability,is_day"
          + "&daily=weather_code,temperature_2m_max,temperature_2m_min,sunrise,sunset,precipitation_probability_max",
          apply)
    })
  }

  // "2026-09-28T05:32" (local to the place) -> "05:32" / "5:32 AM"
  function clock(iso) {
    const [date, time] = iso.split("T")
    const [y, m, d] = date.split("-").map(Number)
    const [hh, mm] = time.split(":").map(Number)
    return new Date(y, m - 1, d, hh, mm).toLocaleTimeString(locale, Locale.ShortFormat)
  }

  function apply(o) {
    const c = o.current, h = o.hourly, d = o.daily
    current = {
      temp: Math.round(c.temperature_2m),
      feels: Math.round(c.apparent_temperature),
      humidity: c.relative_humidity_2m,
      wind: Math.round(c.wind_speed_10m),
      code: c.weather_code,
      isDay: c.is_day === 1,
      max: Math.round(d.temperature_2m_max[0]),
      min: Math.round(d.temperature_2m_min[0]),
      precip: d.precipitation_probability_max[0],
      sunrise: clock(d.sunrise[0]),
      sunset: clock(d.sunset[0]),
    }

    // Hourly times are local ("2026-09-28T10:00"): start at the current hour.
    const start = Math.max(0, h.time.findIndex(t => t.slice(0, 13) === c.time.slice(0, 13)))
    const next = []
    for (let i = start + 1; i < Math.min(h.time.length, start + 9); i++)
      next.push({
        label: h.time[i].slice(11, 13),
        temp: Math.round(h.temperature_2m[i]),
        code: h.weather_code[i],
        isDay: h.is_day[i] === 1,
        precip: h.precipitation_probability[i],
      })
    hours = next

    const list = []
    for (let i = 0; i < Math.min(5, d.time.length); i++) {
      const [y, m, day] = d.time[i].split("-").map(Number)
      list.push({
        today: i === 0,
        label: i === 0 ? {{tq "today"}} : locale.dayName(new Date(y, m - 1, day).getDay(), Locale.ShortFormat),
        code: d.weather_code[i],
        min: Math.round(d.temperature_2m_min[i]),
        max: Math.round(d.temperature_2m_max[i]),
        precip: d.precipitation_probability_max[i],
      })
    }
    days = list

    updated = new Date().toLocaleTimeString(locale, Locale.ShortFormat)
    error = ""
    ready = true
  }

  // WMO weather codes (what Open-Meteo reports) to words and Nerd Font
  // weather glyphs.
  function describe(code) {
    if (code === 0) return {{tq "sky.clear"}}
    if (code === 1) return {{tq "sky.mostly_clear"}}
    if (code === 2) return {{tq "sky.partly_cloudy"}}
    if (code === 3) return {{tq "sky.overcast"}}
    if (code === 45 || code === 48) return {{tq "sky.fog"}}
    if (code >= 51 && code <= 57) return {{tq "sky.drizzle"}}
    if (code >= 61 && code <= 67) return code === 65 ? {{tq "sky.heavy_rain"}} : {{tq "sky.rain"}}
    if (code >= 71 && code <= 77) return {{tq "sky.snow"}}
    if (code >= 80 && code <= 82) return {{tq "sky.showers"}}
    if (code === 85 || code === 86) return {{tq "sky.snow_showers"}}
    if (code >= 95) return {{tq "sky.thunderstorm"}}
    return "—"
  }

  function glyph(code, isDay) {
    if (code === 0 || code === 1) return isDay ? "" : ""   // sunny / clear night
    if (code === 2) return isDay ? "" : ""                 // partly cloudy
    if (code === 3) return ""                                    // cloudy
    if (code === 45 || code === 48) return ""                    // fog
    if (code >= 51 && code <= 57) return ""                      // sprinkle
    if (code >= 61 && code <= 67) return ""                      // rain
    if (code >= 71 && code <= 77) return ""                      // snow
    if (code >= 80 && code <= 82) return ""                      // showers
    if (code === 85 || code === 86) return ""                    // snow showers
    if (code >= 95) return ""                                    // thunderstorm
    return ""
  }

  Timer {
    interval: {{.Settings.refresh_minutes}} * 60 * 1000
    running: true
    repeat: true
    triggeredOnStart: true
    onTriggered: root.refresh()
  }
}
