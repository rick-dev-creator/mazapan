# Generated by mazapan (plugin {{ plugin }}): the keyboard and touchpad
# (applespi) and their SPI controller, loaded early, so they work at the
# disk password prompt.
{{- if machine.product == "MacBook8,1" }}
# The MacBook8,1's SPI controller is a PCI device of its own.
MODULES+=(applespi spi_pxa2xx_platform spi_pxa2xx_pci)
{{- else }}
# Later models reach it through Intel's LPSS.
MODULES+=(applespi intel_lpss_pci spi_pxa2xx_platform)
{{- end }}
