// Generated by mazapan (plugin {{ plugin }}).
//
// The reminders: kept in ~/.local/state/mazapan/reminders.json, looked at
// every few seconds, and each said as a notification when its time comes.
// One missed while the computer was off is said at the next start, with
// the time it was for. One instance for the whole shell, however many bars.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
  id: root

  // {id, text, at}: at in milliseconds since the epoch. Soonest first.
  property var items: []
  property bool loaded: false
  // Asked for from the palette: the bar on the focused screen opens its card.
  property int asked: 0
  readonly property var locale: Qt.locale("{{ lang }}")
  readonly property string dir: (Quickshell.env("XDG_STATE_HOME") || Quickshell.env("HOME") + "/.local/state") + "/mazapan"
  property string saved: ""

  // Added before the file is read (a script at login): held, then put
  // with the saved ones, never saved over them.
  property var early: []
  function add(text, at) {
    const t = String(text).trim()
    if (t === "" || !(at > 0)) return
    const r = { id: Date.now() + "-" + Math.floor(Math.random() * 1e6), text: t, at: at }
    if (!loaded) {
      early = [...early, r]
      return
    }
    items = [...items, r].sort((a, b) => a.at - b.at)
    save()
    due()
  }

  function remove(id) {
    items = items.filter(i => i.id !== id)
    save()
  }

  function save() {
    saved = JSON.stringify({ reminders: items }, null, 2)
    store.setText(saved)
  }

  // "17:30", "tomorrow 9:00 AM", "Fri 3 Oct 17:30": the language's own clock.
  function when(at) {
    const d = new Date(at)
    const day = new Date(d.getFullYear(), d.getMonth(), d.getDate())
    const now = new Date()
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate())
    const days = Math.round((day - today) / 86400000)
    const time = d.toLocaleTimeString(locale, Locale.ShortFormat)
    if (days === 0) return time
    if (days === 1) return {{ tq "tomorrow" }}.arg(time)
    if (days === -1) return {{ tq "yesterday" }}.arg(time)
    return d.toLocaleDateString(locale, "ddd d MMM") + " " + time
  }

  // The ones whose time has come, said and gone.
  function due() {
    if (!loaded) return
    const now = Date.now()
    const now_ = items.filter(i => i.at <= now)
    if (now_.length === 0) return
    for (const i of now_) {
      // Late by more than a couple of minutes: the computer was off or asleep.
      const late = now - i.at > 120000 ? {{ tq "missed" }}.arg(when(i.at)) : ""
      Quickshell.execDetached(["notify-send", "-a", {{ tq "title" }}, "-i", "appointment-soon", "--", i.text, late])
    }
    items = items.filter(i => i.at > now)
    save()
  }

  function joinEarly() {
    loaded = true
    if (early.length > 0) {
      items = [...items, ...early].sort((a, b) => a.at - b.at)
      early = []
      save()
    }
    due()
  }

  Timer {
    interval: 10000
    repeat: true
    running: root.loaded
    triggeredOnStart: true
    onTriggered: root.due()
  }

  FileView {
    id: store
    path: root.dir + "/reminders.json"
    watchChanges: true
    atomicWrites: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: {
      const t = text()
      if (root.loaded && t === root.saved) return // our own save
      let o = null
      try {
        o = JSON.parse(t)
      } catch (e) {}
      // Unreadable (being written, or edited badly): what's in memory stays.
      if (o && Array.isArray(o.reminders))
        root.items = o.reminders.filter(i => i && typeof i.text === "string" && typeof i.at === "number")
          .map(i => ({ id: String(i.id ?? i.at), text: i.text, at: i.at })).sort((a, b) => a.at - b.at)
      root.joinEarly()
    }
    // Not there yet: none; written on the first one.
    onLoadFailed: root.joinEarly()
  }

  IpcHandler {
    target: "reminders"
    // The card, on the focused screen's bar.
    function open(): void { root.asked++ }
    // From a script: qs ipc -c mazapan call reminders add "Call Ana" 30
    function add(text: string, minutes: int): string {
      if (String(text).trim() === "" || minutes < 0) return "no"
      root.add(text, Date.now() + minutes * 60000)
      return "ok"
    }
  }

  Component.onCompleted: Quickshell.execDetached(["mkdir", "-p", root.dir])
}
