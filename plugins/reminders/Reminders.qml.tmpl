// Generated by mazapan (plugin {{ plugin }}).
//
// A bell in the bar, with how many are waiting; a click opens the card:
// what to remember, then when (in ten minutes, in an hour, tonight,
// tomorrow morning, or at a time), and the ones waiting, a click on one
// taking it away.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Hyprland
import qs
import "../../components/kit"
import "../../components/reminders"

BarItem {
  id: root

  readonly property int waiting: RemindersService.items.length

  open: popup.visible
  onClicked: popup.toggle()

  // From the palette: on the focused screen only.
  Connections {
    target: RemindersService
    function onAskedChanged() {
      const f = Hyprland.focusedMonitor
      if (root.barScreen && f && f.name === root.barScreen.name && !popup.visible) popup.toggle()
    }
  }

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: root.waiting > 0 ? "󰂞" : "󰂚"
    color: root.waiting > 0 ? Theme.accentText : Theme.fgMuted
  }

  Label {
    visible: root.waiting > 0
    anchors.verticalCenter: parent.verticalCenter
    text: root.waiting
  }

  // At a time (17:30, 17h30, 5pm, 5:30 p.m.): today, or tomorrow when
  // that's gone by.
  function at(text) {
    const m = /^\s*(\d{1,2})(?:[:.h](\d{2}))?\s*(?:([ap])\.?\s*m\.?)?\s*$/i.exec(text)
    if (!m) return 0
    let h = Number(m[1])
    const min = Number(m[2] || 0)
    if (m[3]) {
      if (h < 1 || h > 12) return 0
      h = h % 12 + (m[3].toLowerCase() === "p" ? 12 : 0)
    }
    if (h > 23 || min > 59) return 0
    const d = new Date()
    d.setHours(h, min, 0, 0)
    if (d.getTime() <= Date.now()) d.setDate(d.getDate() + 1)
    return d.getTime()
  }

  function hourToday(h) {
    const d = new Date()
    d.setHours(h, 0, 0, 0)
    return d.getTime()
  }

  function tomorrowAt(h) {
    const d = new Date()
    d.setDate(d.getDate() + 1)
    d.setHours(h, 0, 0, 0)
    return d.getTime()
  }

  function add(at) {
    if (what.text.trim() === "" || !(at > 0)) return
    RemindersService.add(what.text, at)
    what.text = ""
    time.text = ""
    what.focusInput() // the next one
  }

  BarPopup {
    id: popup
    owner: root
    cardWidth: 380
    onOpening: {
      what.text = ""
      time.text = ""
      what.focusInput()
    }

    Caption { text: {{ tq "title" }}.toUpperCase() }

    TextField {
      id: what
      Layout.fillWidth: true
      placeholder: {{ tq "what" }}
      onAccepted: if (root.at(time.text) > 0) root.add(root.at(time.text)); else time.focusInput()
    }

    // When: a click adds it.
    Flow {
      Layout.fillWidth: true
      spacing: 6
      Repeater {
        model: [
          [{{ tq "in_min" }}.arg(10), () => Date.now() + 10 * 60000],
          [{{ tq "in_min" }}.arg(30), () => Date.now() + 30 * 60000],
          [{{ tq "in_hour" }}, () => Date.now() + 60 * 60000],
          [{{ tq "tonight" }}, () => root.hourToday(20)],
          [{{ tq "tomorrow_morning" }}, () => root.tomorrowAt(9)],
        ]
        Button {
          required property var modelData
          // Tonight once it's night: not there.
          visible: popup.visible && modelData[1]() > Date.now()
          enabled: what.text.trim() !== ""
          text: modelData[0]
          onClicked: root.add(modelData[1]())
        }
      }
    }

    RowLayout {
      Layout.fillWidth: true
      spacing: 8
      TextField {
        id: time
        Layout.fillWidth: true
        placeholder: {{ tq "at_time" }}
        onAccepted: root.add(root.at(text))
      }
      Button {
        primary: true
        text: {{ tq "add" }}
        enabled: what.text.trim() !== "" && root.at(time.text) > 0
        onClicked: root.add(root.at(time.text))
      }
    }

    Rule { Layout.fillWidth: true }

    Caption {
      text: root.waiting === 0 ? {{ tq "none" }} : {{ tq "waiting" }}
      color: Theme.fgSubtle
      wrapMode: Text.Wrap
      Layout.fillWidth: true
    }

    ColumnLayout {
      Layout.fillWidth: true
      spacing: 0
      Repeater {
        model: RemindersService.items
        ListRow {
          required property var modelData
          glyph: "󰂚"
          title: modelData.text
          detail: RemindersService.when(modelData.at)
          trailing: "󰅖"
          onClicked: RemindersService.remove(modelData.id)
        }
      }
    }
  }
}
