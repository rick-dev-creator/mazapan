# Generated by mazapan (plugin {{ plugin }}): the lock screen, in the theme.
# A terminal waiting for you: the time, the date, and a prompt; below it,
# the account locked by too many wrong passwords and for how long, and at
# the bottom suspend, reboot and shut down (the cursor shows to click them).

general {
    hide_cursor = false
}
{{- if (under "/etc/pam.d/polkit-1").size > 0 }}

# A fingerprint reader (hw-fingerprint): a finger unlocks too, beside the
# password (hyprlock asks fprintd itself).
auth {
    fingerprint {
        enabled = true
    }
}
{{- end }}

animations {
    enabled = {{ if theme.motion.enabled }}true{{ else }}false{{ end }}
    bezier = out, 0.22, 1, 0.36, 1
    animation = fadeIn, 1, {{ speed 1.2 }}, out
    animation = fadeOut, 1, {{ speed 1.2 }}, out
    animation = inputFieldDots, 1, 2, out
}

background {
    monitor =
    color = {{ rgb (c "bg") }}
}

label {
    monitor =
    # 12 or 24 hours, like the bar's clock in this language.
    text = cmd[update:1000] date +"{{ if lang_code == "en" }}%-I:%M %p{{ else }}%H:%M{{ end }}"
    color = {{ rgb (c "fg") }}
    font_size = 72
    font_family = {{ theme.font.mono }} Bold
    position = 0, 140
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"%A %-d %B"
    color = {{ rgb (c "fg_muted") }}
    font_size = 16
    font_family = {{ theme.font.mono }}
    position = 0, 60
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:0] echo "❯ $USER@$(uname -n) · "{{ shq (t "locked") }}
    color = {{ rgb (c "accent_text") }}
    font_size = 11
    font_family = {{ theme.font.mono }}
    position = 0, -10
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 340, 44
    outline_thickness = {{ theme.shape.border }}
    rounding = {{ theme.shape.radius }}
    outer_color = {{ rgb (c "accent") }}
    inner_color = {{ rgb (c "surface") }}
    font_color = {{ rgb (c "fg") }}
    check_color = {{ rgb (c "info") }}
    fail_color = {{ rgb (c "danger") }}
    capslock_color = {{ rgb (c "warning") }}
    font_family = {{ theme.font.mono }}
    placeholder_text = <span foreground="##{{ hex (c "fg_subtle") }}">{{ t "password" }}</span>
    fail_text = {{ t "wrong" }}
    fade_on_empty = false
    dots_size = 0.25
    dots_spacing = 0.4
    position = 0, -70
    halign = center
    valign = center
}

# The account locked (faillock): the password won't do until it's over, so
# this says so and for how long, instead of only "wrong".
label {
    monitor =
    text = cmd[update:1000] sh ~/.local/share/mazapan/bin/lock-screen status
    color = {{ rgb (c "danger") }}
    font_size = 11
    font_family = {{ theme.font.mono }}
    position = 0, -125
    halign = center
    valign = center
}
{{- for b in [["suspend", -200], ["reboot", 0], ["poweroff", 200]] }}

label {
    monitor =
    text = cmd[update:500] sh ~/.local/share/mazapan/bin/lock-screen label {{ b[0] }}
    onclick = sh ~/.local/share/mazapan/bin/lock-screen press {{ b[0] }}
    color = {{ rgb (c "fg_muted") }}
    font_size = 11
    font_family = {{ theme.font.mono }}
    position = {{ b[1] }}, 40
    halign = center
    valign = bottom
}
{{- end }}
