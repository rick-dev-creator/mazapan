# Generated by myarch (plugin {{ plugin }}): the lock screen, in the theme.
# A terminal waiting for you: the time, the date, and a prompt.

general {
    hide_cursor = true
}

animations {
    enabled = {{ if theme.motion.enabled }}true{{ else }}false{{ end }}
    bezier = out, 0.22, 1, 0.36, 1
    animation = fadeIn, 1, {{ speed 1.2 }}, out
    animation = fadeOut, 1, {{ speed 1.2 }}, out
    animation = inputFieldDots, 1, 2, out
}

background {
    monitor =
    color = {{ rgb (c "bg") }}
}

label {
    monitor =
    # 12 or 24 hours, like the bar's clock in this language.
    text = cmd[update:1000] date +"{{ if lang_code == "en" }}%-I:%M %p{{ else }}%H:%M{{ end }}"
    color = {{ rgb (c "fg") }}
    font_size = 72
    font_family = {{ theme.font.mono }} Bold
    position = 0, 140
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:60000] date +"%A %-d %B"
    color = {{ rgb (c "fg_muted") }}
    font_size = 16
    font_family = {{ theme.font.mono }}
    position = 0, 60
    halign = center
    valign = center
}

label {
    monitor =
    text = cmd[update:0] echo "❯ $USER@$(uname -n) · {{ t "locked" }}"
    color = {{ rgb (c "accent_text") }}
    font_size = 11
    font_family = {{ theme.font.mono }}
    position = 0, -10
    halign = center
    valign = center
}

input-field {
    monitor =
    size = 340, 44
    outline_thickness = {{ theme.shape.border }}
    rounding = {{ theme.shape.radius }}
    outer_color = {{ rgb (c "accent") }}
    inner_color = {{ rgb (c "surface") }}
    font_color = {{ rgb (c "fg") }}
    check_color = {{ rgb (c "info") }}
    fail_color = {{ rgb (c "danger") }}
    capslock_color = {{ rgb (c "warning") }}
    font_family = {{ theme.font.mono }}
    placeholder_text = <span foreground="##{{ hex (c "fg_subtle") }}">{{ t "password" }}</span>
    fail_text = {{ t "wrong" }}
    fade_on_empty = false
    dots_size = 0.25
    dots_spacing = 0.4
    position = 0, -70
    halign = center
    valign = center
}
