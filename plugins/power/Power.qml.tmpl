// Generated by myarch (plugin {{ plugin }}).
//
// The power button, next to the clock. Its card: who and how long it's
// been up, then lock, suspend, log out, reboot and shut down, each with
// the command it runs. The last three ask for a second click (or ↵), so a
// stray one can't end your session. ↑↓ and ↵ work too.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import qs
import "../../components/kit"

BarItem {
  id: root

  // The same commands as this plugin's palette actions.
  readonly property var options: [
    { glyph: "󰌾", title: {{ tq "lock" }}, run: "pidof hyprlock || hyprlock", confirm: false },
    { glyph: "󰒲", title: {{ tq "suspend" }}, run: "(pidof hyprlock || hyprlock &); sleep 1; systemctl suspend", confirm: false },
    { glyph: "󰍃", title: {{ tq "logout" }}, run: "hyprctl dispatch 'hl.dsp.exit()'", confirm: true },
    { glyph: "󰜉", title: {{ tq "reboot" }}, run: "systemctl reboot", confirm: true },
    { glyph: "󰐥", title: {{ tq "poweroff" }}, run: "systemctl poweroff", confirm: true },
  ]
  property int selected: 0
  property int armed: -1 // waiting for the second click
  property string who: ""
  property string uptime: ""

  shown: {{ settings.bar }}
  open: popup.visible
  onClicked: popup.toggle()

  function choose(i) {
    const o = options[i]
    if (o.confirm && armed !== i) {
      armed = i
      selected = i
      disarm.restart()
      return
    }
    armed = -1
    popup.toggle()
    Quickshell.execDetached(["sh", "-c", o.run])
  }

  Timer {
    id: disarm
    interval: 4000
    onTriggered: root.armed = -1
  }

  // "rick@box", then seconds since boot.
  Process {
    id: info
    command: ["sh", "-c", "printf '%s@%s\\n' \"$(id -un)\" \"$(uname -n)\"; cut -d. -f1 /proc/uptime"]
    stdout: StdioCollector {
      onStreamFinished: {
        const [who, secs] = text.trim().split("\n")
        const m = Math.floor(Number(secs) / 60)
        root.who = who
        root.uptime = {{ tq "uptime" }}.arg(m >= 1440 ? `${Math.floor(m / 1440)}d ${Math.floor(m % 1440 / 60)}h`
          : m >= 60 ? `${Math.floor(m / 60)}h ${String(m % 60).padStart(2, "0")}m` : `${m}m`)
      }
    }
  }

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: "󰐥"
    color: root.open ? Theme.accentText : Theme.fgMuted
  }

  BarPopup {
    id: popup
    owner: root
    cardWidth: 300
    onOpening: {
      root.armed = -1
      root.selected = 0
      info.running = true
    }
    onKey: event => {
      if (event.key === Qt.Key_Down || event.key === Qt.Key_Tab) root.selected = Math.min(root.options.length - 1, root.selected + 1)
      else if (event.key === Qt.Key_Up || event.key === Qt.Key_Backtab) root.selected = Math.max(0, root.selected - 1)
      else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) root.choose(root.selected)
    }

    RowLayout {
      Layout.fillWidth: true
      Caption { text: root.who }
      Item { Layout.fillWidth: true }
      Caption { text: root.uptime }
    }

    Rule {}

    Repeater {
      model: root.options

      ListRow {
        required property var modelData
        required property int index
        readonly property bool armed: root.armed === index
        glyph: modelData.glyph
        title: armed ? {{ tq "confirm" }}.arg(modelData.title) : modelData.title
        detail: "$ " + modelData.run
        active: root.selected === index || armed
        onClicked: root.choose(index)
      }
    }
  }
}
