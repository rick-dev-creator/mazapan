# Generated by mazapan (plugin {{ plugin }}): the lock screen's lines and
# buttons (hyprlock runs it, hyprlock.conf).
#   lock-screen status         the account locked by faillock (too many wrong
#                              passwords) and the minutes left; nothing if not
#   lock-screen label ACTION   a button's text (suspend, reboot, poweroff)
#   lock-screen press ACTION   its click: reboot and shut down ask for a
#                              second one, as the bar's button does
mark=${XDG_RUNTIME_DIR:-/tmp}/mazapan-lock-$2

# %1 in a translation, given its value.
arg() { printf '%s\n' "${1%%"%1"*}$2${1#*"%1"}"; }
# Clicked once in the last 4 seconds.
fresh() { [ -f "$mark" ] && [ $(($(date +%s) - $(cat "$mark"))) -lt 4 ]; }
name() {
  case $1 in
    suspend) printf '󰒲  %s' {{ shq (t "short.suspend") }} ;;
    reboot) printf '󰜉  %s' {{ shq (t "short.reboot") }} ;;
    poweroff) printf '󰐥  %s' {{ shq (t "short.poweroff") }} ;;
  esac
}

case $1 in
  status)
    # faillock.conf's values, or pam_faillock's own: 3 tries in 15 minutes
    # lock it for 10.
    conf() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*/\1/p" /etc/security/faillock.conf 2>/dev/null | tail -n 1; }
    deny=$(conf deny); deny=${deny:-3}
    unlock=$(conf unlock_time); unlock=${unlock:-600}
    interval=$(conf fail_interval); interval=${interval:-900}
    [ "$deny" -gt 0 ] 2>/dev/null || exit 0
    # The valid failures (V) it counts, oldest first.
    times=$(faillock --user "$USER" 2>/dev/null | awk '$NF == "V" { print $1 " " $2 }' |
      while read -r d; do date -d "$d" +%s; done | sort -n)
    [ -n "$times" ] || exit 0
    last=$(printf '%s\n' "$times" | tail -n 1)
    count=$(printf '%s\n' "$times" | awk -v from=$((last - interval)) '$1 > from' | wc -l)
    [ "$count" -ge "$deny" ] || exit 0
    if [ "$unlock" = never ] || [ "$unlock" -eq 0 ] 2>/dev/null; then
      printf '%s\n' {{ shq (t "account_locked") }}
      exit 0
    fi
    left=$((last + unlock - $(date +%s)))
    [ "$left" -gt 0 ] || exit 0
    arg {{ shq (t "account_locked_for") }} $(((left + 59) / 60))
    ;;
  label)
    if [ "$2" != suspend ] && fresh; then arg {{ shq (t "confirm") }} "$(name "$2")"; else name "$2"; echo; fi
    ;;
  press)
    case $2 in
      suspend) exec systemctl suspend ;;
      reboot | poweroff)
        if fresh; then rm -f "$mark"; exec systemctl "$2"; fi
        date +%s >"$mark"
        ;;
    esac
    ;;
esac
