// Generated by mazapan (plugin {{ plugin }}): the power buttons, at the
// bottom of the Control Center: lock, suspend, log out, reboot, shut down.
// The last three ask for a second click, as the power menu does.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/control"

RowLayout {
  id: root

  spacing: 6
  property int armed: -1

  // The same commands as this plugin's palette actions.
  readonly property var options: [
    { glyph: "󰌾", short: {{ tq "short.lock" }}, title: {{ tq "lock" }}, run: "pidof hyprlock || hyprlock", confirm: false },
    { glyph: "󰒲", short: {{ tq "short.suspend" }}, title: {{ tq "suspend" }}, run: "(pidof hyprlock || hyprlock &); sleep 1; systemctl suspend", confirm: false },
    { glyph: "󰍃", short: {{ tq "short.logout" }}, title: {{ tq "logout" }}, run: "hyprctl dispatch 'hl.dsp.exit()'", confirm: true },
    { glyph: "󰜉", short: {{ tq "short.reboot" }}, title: {{ tq "reboot" }}, run: "systemctl reboot", confirm: true },
    { glyph: "󰐥", short: {{ tq "short.poweroff" }}, title: {{ tq "poweroff" }}, run: "systemctl poweroff", confirm: true },
  ]

  Timer { id: disarm; interval: 3000; onTriggered: root.armed = -1 }

  Repeater {
    model: root.options
    Rectangle {
      required property var modelData
      required property int index
      readonly property bool isArmed: root.armed === index
      Layout.fillWidth: true
      implicitHeight: 48
      radius: Theme.radius
      color: isArmed ? Theme.danger : area.containsMouse ? Theme.surfaceRaised : Theme.surface
      border.width: 1
      border.color: isArmed ? Theme.danger : Theme.border
      ColumnLayout {
        anchors.centerIn: parent
        spacing: 2
        Text {
          Layout.alignment: Qt.AlignHCenter
          text: modelData.glyph
          color: isArmed ? Theme.bg : index === 4 ? Theme.danger : Theme.fg
          font.family: Theme.fontMono
          font.pointSize: 12
        }
        Text {
          Layout.alignment: Qt.AlignHCenter
          text: isArmed ? {{ tq "again" }} : modelData.short
          color: isArmed ? Theme.bg : Theme.fgMuted
          font.family: Theme.fontMono
          font.pointSize: 7.5
        }
      }
      MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        cursorShape: Qt.PointingHandCursor
        onClicked: {
          if (modelData.confirm && root.armed !== index) {
            root.armed = index
            disarm.restart()
            return
          }
          root.armed = -1
          ControlService.close()
          Quickshell.execDetached(["sh", "-c", modelData.run])
        }
      }
    }
  }
}
