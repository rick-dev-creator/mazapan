# Generated by myarch (plugin {{ plugin }}) from theme "{{ theme.id }}".
# Background: the terminal's (theme_background = false in btop.conf).
theme[main_bg]="{{ solid (c "bg") }}"
theme[main_fg]="{{ solid (c "fg") }}"
theme[title]="{{ solid (c "fg") }}"
theme[hi_fg]="{{ solid (c "accent_text") }}"
theme[selected_bg]="{{ solid (c "accent") }}"
theme[selected_fg]="{{ solid (c "accent_fg") }}"
theme[inactive_fg]="{{ solid (c "fg_subtle") }}"
theme[graph_text]="{{ solid (c "fg_muted") }}"
theme[meter_bg]="{{ solid (c "surface_raised") }}"
theme[proc_misc]="{{ solid (c "accent_text") }}"
theme[cpu_box]="{{ solid (c "border") }}"
theme[mem_box]="{{ solid (c "border") }}"
theme[net_box]="{{ solid (c "border") }}"
theme[proc_box]="{{ solid (c "border") }}"
theme[div_line]="{{ solid (c "border") }}"
# Gradients: calm to hot.
theme[temp_start]="{{ solid (c "info") }}"
theme[temp_mid]="{{ solid (c "warning") }}"
theme[temp_end]="{{ solid (c "danger") }}"
theme[cpu_start]="{{ solid (c "accent") }}"
theme[cpu_mid]="{{ solid (c "accent_text") }}"
theme[cpu_end]="{{ solid (c "danger") }}"
theme[free_start]="{{ mix (c "bg") (c "success") 0.5 }}"
theme[free_mid]="{{ solid (c "success") }}"
theme[free_end]="{{ solid (c "success") }}"
theme[cached_start]="{{ mix (c "bg") (c "info") 0.5 }}"
theme[cached_mid]="{{ solid (c "info") }}"
theme[cached_end]="{{ solid (c "info") }}"
theme[available_start]="{{ mix (c "bg") (c "cyan") 0.5 }}"
theme[available_mid]="{{ solid (c "cyan") }}"
theme[available_end]="{{ solid (c "cyan") }}"
theme[used_start]="{{ mix (c "bg") (c "warning") 0.5 }}"
theme[used_mid]="{{ solid (c "warning") }}"
theme[used_end]="{{ solid (c "danger") }}"
theme[download_start]="{{ mix (c "bg") (c "accent") 0.5 }}"
theme[download_mid]="{{ solid (c "accent") }}"
theme[download_end]="{{ solid (c "accent_text") }}"
theme[upload_start]="{{ mix (c "bg") (c "magenta") 0.5 }}"
theme[upload_mid]="{{ solid (c "magenta") }}"
theme[upload_end]="{{ solid (c "magenta") }}"
theme[process_start]="{{ solid (c "accent") }}"
theme[process_mid]="{{ solid (c "accent_text") }}"
theme[process_end]="{{ solid (c "danger") }}"
