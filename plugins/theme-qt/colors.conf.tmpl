# Generated by myarch (plugin {{ plugin }}) from theme "{{ theme.id }}".
# QPalette roles, in order: WindowText, Button, Light, Midlight, Dark, Mid,
# Text, BrightText, ButtonText, Base, Window, Shadow, Highlight,
# HighlightedText, Link, LinkVisited, AlternateBase, NoRole, ToolTipBase,
# ToolTipText, PlaceholderText, Accent (Qt 6.6+). BrightText sits on Dark
# (bg_alt): fg.
{{- func roles(role) }}#ff{{ hex (c role) }}, #ff{{ hex (c "surface") }}, #ff{{ hex (c "surface_raised") }}, #ff{{ hex (c "surface_raised") }}, #ff{{ hex (c "bg_alt") }}, #ff{{ hex (c "border") }}, #ff{{ hex (c role) }}, #ff{{ hex (c "fg") }}, #ff{{ hex (c role) }}, #ff{{ hex (c "bg_alt") }}, #ff{{ hex (c "bg") }}, #ff000000, #ff{{ hex (c "accent") }}, #ff{{ hex (c "accent_fg") }}, #ff{{ hex (c "accent_text") }}, #ff{{ hex (c "magenta") }}, #ff{{ hex (c "surface") }}, #ff{{ hex (c "bg") }}, #ff{{ hex (c "surface_raised") }}, #ff{{ hex (c "fg") }}, #ff{{ hex (c "fg_subtle") }}, #ff{{ hex (c "accent") }}{{ end }}
[ColorScheme]
active_colors={{ roles "fg" }}
inactive_colors={{ roles "fg" }}
disabled_colors={{ roles "fg_subtle" }}
