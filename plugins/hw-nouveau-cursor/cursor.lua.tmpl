-- Generated by mazapan (plugin {{ plugin }}).
{{- nouveau = false }}
{{- for g in machine.gpus }}{{ if g.driver == "nouveau" }}{{ nouveau = true }}{{ end }}{{ end }}
{{- if nouveau && (under "/etc/modprobe.d/mazapan-nvidia.conf").size == 0 }}
-- nouveau drives a GPU here, and on many older NVIDIA GPUs it doesn't show
-- the hardware cursor plane: the pointer is invisible on the screen. Drawn
-- in software, the cursor is part of the frame instead.
hl.config({ cursor = { no_hardware_cursors = true } })
{{- else }}
-- Nothing to do: no GPU runs on nouveau, or NVIDIA's own driver is set up
-- (hw-nvidia), which shows the hardware cursor.
{{- end }}
