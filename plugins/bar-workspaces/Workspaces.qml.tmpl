// Generated by mazapan (plugin {{ plugin }}).
//
// Numbers: 1..{{ inline settings.persistent }} always, others while they exist, 10 shown
// as 0 (its key). The focused workspace is a solid accent block, like
// reverse video on a terminal; the block slides from number to number.
//   focused                  accent block, accent_fg text
//   visible on another monitor  accent_text, underlined
//   has windows              fg
//   empty                    fg_subtle
// Click a number to go there; scroll to step through them.
{{- if settings.preview }}
{{- if settings.trigger == "hover" }}
// Hover a number for a live preview of that workspace ({{ inline settings.open_delay_ms }}ms);
{{- else }}
// Right-click a number for a live preview of that workspace (again to close);
{{- end }}
// it grows {{ inline settings.grow_delay_ms }}ms later. While it's open, hovering another number shows
// that one, like a menu bar. Windows in it can be dragged out: see
// components/workspaces/Preview.qml.
{{- end }}

import QtQuick
import Quickshell
import Quickshell.Hyprland
import qs
{{- if settings.preview }}
import "../../components/workspaces"
{{- end }}
{{- agents = (under "~/.config/quickshell/mazapan/components/agents/AgentsService.qml").size > 0 }}
{{- if agents }}
import "../../components/agents"
{{- end }}

Item {
  id: root

  property var barScreen
  property int barHeight: {{ settings.cell }}

  readonly property int persistent: {{ settings.persistent }}
  readonly property int cell: {{ settings.cell }}

  readonly property var ids: {
    const ids = []
    for (let i = 1; i <= persistent; i++) ids.push(i)
    for (const ws of Hyprland.workspaces.values)
      if (ws.id > 0 && !ids.includes(ws.id)) ids.push(ws.id)
    return ids.sort((a, b) => a - b)
  }

  function workspace(id) {
    return Hyprland.workspaces.values.find(ws => ws.id === id) ?? null
  }

  function go(target) {
    Hyprland.dispatch(`hl.dsp.focus({ workspace = ${JSON.stringify(String(target))} })`)
  }

  // Screen x of a workspace's cell center, and the workspace under a
  // screen x: the bar spans its screen from x = 0, so bar coordinates are
  // screen coordinates.
  function cellCenter(id) {
    const i = ids.indexOf(id)
    return root.mapToItem(null, 0, 0).x + (i + 0.5) * cell
  }

  function idAtScreenX(x) {
    const i = Math.floor((x - root.mapToItem(null, 0, 0).x) / cell)
    return i >= 0 && i < ids.length ? ids[i] : -1
  }
{{- if settings.preview }}

  // --- preview -----------------------------------------------------------
  property int hovered: -1

  // No point previewing what this monitor is already showing.
  function previewable(id) {
    const here = Hyprland.monitorFor(barScreen)
    return !(here && here.activeWorkspace && here.activeWorkspace.id === id)
  }

  function open(id) {
    preview.shownId = id
    growTimer.restart()
  }

  function toggle(id) {
    if (preview.shownId === id) preview.close()
    else if (previewable(id)) open(id)
  }

  function hoverIn(id) {
    hovered = id
    closeTimer.stop()
    if (preview.shownId !== -1) {
      // Already open: follow the pointer, like a menu bar.
      if (previewable(id)) preview.shownId = id
      else preview.close()
    }
{{- if settings.trigger == "hover" }}
    else {
      openTimer.restart()
    }
{{- end }}
  }

  function hoverOut(id) {
    if (hovered === id) hovered = -1
    closeTimer.restart()
  }

{{- if settings.trigger == "hover" }}
  Timer {
    id: openTimer
    interval: {{ settings.open_delay_ms }}
    onTriggered: if (root.hovered !== -1 && root.previewable(root.hovered)) root.open(root.hovered)
  }
{{- end }}

  Timer {
    id: growTimer
    interval: {{ settings.grow_delay_ms }}
    onTriggered: if (preview.shownId !== -1 && (root.hovered !== -1 || preview.pinned)) preview.large = true
  }

  Timer {
    id: closeTimer
    interval: 300
    onTriggered: if (root.hovered === -1 && !preview.pinned) preview.close()
  }

  Connections {
    target: preview
    function onPinnedChanged() {
      if (!preview.pinned) closeTimer.restart()
    }
  }

  Preview {
    id: preview
    widget: root
    screen: root.barScreen
  }
{{- end }}

  implicitWidth: ids.length * cell
  implicitHeight: barHeight

  Rectangle {
    id: block
    readonly property int index: root.ids.indexOf(Hyprland.focusedWorkspace ? Hyprland.focusedWorkspace.id : -1)
    visible: index >= 0
    x: index * root.cell
    width: root.cell
    height: root.height - 1 // leave the bar's hairline visible
    color: Theme.accent

    Behavior on x {
      enabled: Theme.motion
      NumberAnimation { duration: Theme.response * 0.6; easing.type: Easing.OutQuint }
    }
  }

  Row {
    Repeater {
      model: root.ids

      Item {
        id: cell
        required property int modelData

        readonly property var ws: root.workspace(modelData)
        readonly property bool focused: Hyprland.focusedWorkspace !== null && Hyprland.focusedWorkspace.id === modelData
        readonly property bool shown: ws !== null && ws.active && !focused
        readonly property bool occupied: ws !== null && ws.toplevels.values.length > 0

        width: root.cell
        height: root.height

        Text {
          anchors.centerIn: parent
          text: cell.modelData === 10 ? "0" : String(cell.modelData)
          font.family: Theme.fontMono
          font.pointSize: {{ settings.font_size }}
          font.bold: cell.focused
          color: cell.focused ? Theme.accentFg
               : cell.shown ? Theme.accentText
               : cell.occupied ? Theme.fg
               : Theme.fgSubtle

          Behavior on color {
            enabled: Theme.motion
            ColorAnimation { duration: Theme.duration }
          }
        }

{{- if agents }}

        // A coding agent's session here: waiting for you (the warning
        // color), working (the text's), done (success's).
        Rectangle {
          readonly property string agentState: AgentsService.byWorkspace[cell.modelData] || ""
          visible: agentState !== ""
          anchors { top: parent.top; right: parent.right; topMargin: 4; rightMargin: 5 }
          width: 5
          height: 5
          radius: 2.5
          color: agentState === "waiting" ? Theme.warning : agentState === "working" ? (cell.focused ? Theme.accentFg : Theme.fgMuted) : Theme.success
          border.width: cell.focused && agentState !== "working" ? 1 : 0
          border.color: Theme.accentFg
        }
{{- end }}

        Rectangle {
          visible: cell.shown
          anchors {
            left: parent.left
            right: parent.right
            bottom: parent.bottom
            leftMargin: 6
            rightMargin: 6
            bottomMargin: 3
          }
          height: 2
          color: Theme.accentText
        }

        MouseArea {
          anchors.fill: parent
          cursorShape: Qt.PointingHandCursor
          acceptedButtons: Qt.LeftButton{{ if settings.preview }} | Qt.RightButton{{ end }}
          onClicked: mouse => {
{{- if settings.preview }}
            if (mouse.button === Qt.RightButton) {
              root.toggle(cell.modelData)
              return
            }
            preview.close()
{{- end }}
            root.go(cell.modelData)
          }
        }
{{- if settings.preview }}

        HoverHandler {
          onHoveredChanged: hovered ? root.hoverIn(cell.modelData) : root.hoverOut(cell.modelData)
        }
{{- end }}
      }
    }
  }

  WheelHandler {
    onWheel: event => root.go(event.angleDelta.y > 0 ? "e-1" : "e+1")
  }
}
