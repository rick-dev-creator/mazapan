// Generated by mazapan (plugin {{ plugin }}).
//
// Every workspace of this screen at once, as Niri's overview: each with its
// windows live, the whole strip of columns (the part on the screen marked),
// and an empty one after the last. A click on a window goes to it; on a
// workspace, there; a window dragged onto another workspace goes there.
// Esc, or the key again, closes it; 1…9 go to that workspace.
//   qs ipc -c mazapan call mazapan panel overview

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  property bool dragging: false
  property var held: null            // the window being dragged
  property point pointer: Qt.point(0, 0)

  readonly property var mon: screenAtOpen ? Hyprland.monitorFor(screenAtOpen) : null
  readonly property real monX: mon ? mon.x : 0
  readonly property real monY: mon ? mon.y : 0
  readonly property bool rotated: mon && mon.lastIpcObject && mon.lastIpcObject.transform % 2 === 1
  readonly property real monW: mon ? (rotated ? mon.height : mon.width) / mon.scale : 1920
  readonly property real monH: mon ? (rotated ? mon.width : mon.height) / mon.scale : 1080

  // This screen's workspaces with windows, and one empty after the last.
  readonly property var ids: {
    const own = Hyprland.workspaces.values
      .filter(w => w.id > 0 && w.monitor && mon && w.monitor.name === mon.name && (w.toplevels.values.length > 0 || w.focused))
      .map(w => w.id)
    const all = Hyprland.workspaces.values.filter(w => w.id > 0).map(w => w.id)
    let next = (own.length ? Math.max(...own) : 0) + 1
    while (all.includes(next)) next++
    return own.sort((a, b) => a - b).concat([next])
  }

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    Hyprland.refreshToplevels()
    open = true
  }
  function close() {
    open = false
    dragging = false
    held = null
  }

  function address(t) {
    const a = String(t.address)
    return a.startsWith("0x") ? a : "0x" + a
  }
  function go(id) {
    Hyprland.dispatch(`hl.dsp.focus({ workspace = ${id} })`)
    close()
  }
  function goWindow(t) {
    Hyprland.dispatch(`hl.dsp.focus({ window = "address:${address(t)}" })`)
    close()
  }
  // The workspace card under the pointer (-1: none).
  function cardAt(p) {
    for (let i = 0; i < cards.count; i++) {
      const c = cards.itemAt(i)
      const q = c.mapFromItem(win.contentItem, p.x, p.y)
      if (q.x >= 0 && q.y >= 0 && q.x <= c.width && q.y <= c.height) return c.wsId
    }
    return -1
  }
  function drop() {
    const t = held
    const to = cardAt(pointer)
    dragging = false
    held = null
    if (!t || to === -1 || !t.workspace || t.workspace.id === to) return
    Hyprland.dispatch(`hl.dsp.window.move({ workspace = ${to}, window = "address:${address(t)}", follow = false })`)
    Hyprland.refreshToplevels()
  }

  Timer { interval: 400; repeat: true; running: root.open; onTriggered: Hyprland.refreshToplevels() }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    anchors { top: true; bottom: true; left: true; right: true }
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-overview"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      anchors.fill: parent
      color: Theme.bg
      opacity: 0.92
    }
    MouseArea {
      anchors.fill: parent
      onClicked: root.close()
    }

    Item {
      anchors.fill: parent
      focus: true
      Keys.onEscapePressed: root.close()
      Keys.onPressed: e => {
        if (e.key >= Qt.Key_1 && e.key <= Qt.Key_9) { root.go(e.key - Qt.Key_0); e.accepted = true }
      }

      ColumnLayout {
        anchors.fill: parent
        anchors.margins: Math.max(24, root.monH * 0.05)
        spacing: 14

        RowLayout {
          Layout.fillWidth: true
          Caption { text: {{ tq "overview.title" }}.toUpperCase() }
          Item { Layout.fillWidth: true }
          Caption { text: {{ tq "overview.hint" }}; color: Theme.fgSubtle }
        }

        Flow {
          id: flow
          Layout.fillWidth: true
          Layout.fillHeight: true
          spacing: 16
          // Up to three a row, never taller than a third of the screen.
          readonly property int perRow: Math.min(3, root.ids.length)
          readonly property real cardW: Math.min((width - spacing * (perRow - 1)) / Math.max(1, perRow), (height / Math.ceil(root.ids.length / Math.max(1, perRow)) - spacing - 24) * root.monW / root.monH)

          Repeater {
            id: cards
            model: root.ids

            Rectangle {
              id: card
              required property int modelData
              readonly property int wsId: modelData
              readonly property var ws: Hyprland.workspaces.values.find(w => w.id === wsId) ?? null
              readonly property bool focused: Hyprland.focusedWorkspace !== null && Hyprland.focusedWorkspace.id === wsId
              // By workspace only: a window's title changing mustn't rebuild
              // the thumbnails (and drop a drag); geometry is looked at below.
              readonly property var windows: Hyprland.toplevels.values.filter(t => t.workspace && t.workspace.id === wsId)
              readonly property var placed: windows.filter(t => t.lastIpcObject && t.lastIpcObject.at && t.lastIpcObject.size)
              readonly property bool target: root.dragging && root.cardAt(root.pointer) === wsId
              // The whole strip: the screen, and the columns off it either side.
              readonly property real minX: Math.min(root.monX, ...placed.map(t => t.lastIpcObject.at[0]))
              readonly property real maxX: Math.max(root.monX + root.monW, ...placed.map(t => t.lastIpcObject.at[0] + t.lastIpcObject.size[0]))
              readonly property real k: Math.min(stage.width / (maxX - minX), stage.height / root.monH)
              // Centered in the card, whichever way it's narrower.
              readonly property real ox: (stage.width - (maxX - minX) * k) / 2
              readonly property real oy: (stage.height - root.monH * k) / 2

              width: flow.cardW
              height: 24 + flow.cardW * root.monH / root.monW
              color: Theme.surfaceRaised
              border.width: focused || target ? 2 : 1
              border.color: target ? Theme.accent : focused ? Theme.accent : Theme.border
              radius: Theme.radius

              Label {
                x: 8
                height: 24
                verticalAlignment: Text.AlignVCenter
                text: card.windows.length === 0 ? {{ tq "overview.empty" }}.arg(card.wsId) : String(card.wsId)
                color: card.focused ? Theme.accentText : Theme.fgMuted
              }

              MouseArea {
                anchors.fill: parent
                onClicked: root.go(card.wsId)
              }

              Item {
                id: stage
                x: 4
                y: 24
                width: card.width - 8
                height: card.height - 28
                clip: true

                // The part of the strip that's on the screen.
                Rectangle {
                  x: card.ox + (root.monX - card.minX) * card.k
                  y: card.oy
                  width: root.monW * card.k
                  height: root.monH * card.k
                  color: Theme.bgAlt
                  border.width: card.maxX - card.minX > root.monW + 1 ? 1 : 0
                  border.color: Theme.fgSubtle
                }

                Repeater {
                  model: card.windows
                  Item {
                    id: thumb
                    required property var modelData
                    readonly property var ipc: modelData.lastIpcObject
                    readonly property bool hasGeometry: !!(ipc && ipc.at && ipc.size)
                    visible: hasGeometry
                    x: hasGeometry ? card.ox + (ipc.at[0] - card.minX) * card.k : 0
                    y: hasGeometry ? card.oy + (ipc.at[1] - root.monY) * card.k : 0
                    width: hasGeometry ? ipc.size[0] * card.k : 0
                    height: hasGeometry ? ipc.size[1] * card.k : 0
                    opacity: root.held === modelData ? 0.35 : 1

                    ScreencopyView {
                      anchors.fill: parent
                      anchors.margins: 1
                      captureSource: thumb.modelData.wayland
                      live: root.open
                      constraintSize: Qt.size(width, height)
                    }
                    Rectangle {
                      anchors.fill: parent
                      color: "transparent"
                      border.width: 1
                      border.color: area.containsMouse ? Theme.accent : Theme.border
                    }
                    MouseArea {
                      id: area
                      anchors.fill: parent
                      hoverEnabled: true
                      preventStealing: true
                      cursorShape: root.dragging ? Qt.ClosedHandCursor : Qt.PointingHandCursor
                      property point pressedAt
                      onPressed: mouse => {
                        pressedAt = mapToItem(win.contentItem, mouse.x, mouse.y)
                        root.pointer = pressedAt
                        root.held = thumb.modelData
                      }
                      onPositionChanged: mouse => {
                        if (!pressed) return
                        root.pointer = mapToItem(win.contentItem, mouse.x, mouse.y)
                        if (!root.dragging && Math.hypot(root.pointer.x - pressedAt.x, root.pointer.y - pressedAt.y) > 6) root.dragging = true
                      }
                      onCanceled: { root.dragging = false; root.held = null }
                      onReleased: {
                        if (root.dragging) root.drop()
                        else { root.held = null; root.goWindow(thumb.modelData) }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }

      // The window being dragged, under the pointer.
      Rectangle {
        visible: root.dragging && root.held !== null
        width: 200
        height: 125
        x: root.pointer.x - width / 2
        y: root.pointer.y + 12
        color: Theme.bg
        border.width: 2
        border.color: Theme.accent
        ScreencopyView {
          anchors.fill: parent
          anchors.margins: 2
          captureSource: root.held ? root.held.wayland : null
          live: parent.visible
          constraintSize: Qt.size(width, height)
        }
      }
    }
  }
}
