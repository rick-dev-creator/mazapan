// Generated by myarch (plugin {{.Plugin}}).
//
// Live preview of a workspace, shown under its number in the bar. It is a
// transparent full-screen overlay that takes input only on the card (the
// mask), and on the whole screen while a window is being dragged, so the
// dragged window can travel anywhere without leaving this one surface.
//
// Drop a window
//   outside the card        -> it comes to the workspace on this monitor
//   on a number in the bar  -> it moves to that workspace
//   back on the card        -> nothing happens
// A click on a window goes to it.

import QtQuick
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs

PanelWindow {
  id: overlay

  required property var widget // the Workspaces widget that owns this preview

  property int shownId: -1 // workspace on display, -1 = closed
  property bool large: false
  property bool dragging: false
  readonly property bool pinned: cardHover.hovered || dragging

  readonly property int smallWidth: {{.Settings.preview_width}}
  readonly property int largeWidth: {{.Settings.preview_width_large}}

  readonly property var ws: Hyprland.workspaces.values.find(w => w.id === shownId) ?? null
  readonly property var mon: ws && ws.monitor ? ws.monitor : Hyprland.monitorFor(screen)
  readonly property bool rotated: mon && mon.lastIpcObject && mon.lastIpcObject.transform % 2 === 1
  readonly property real monW: mon ? (rotated ? mon.height : mon.width) / mon.scale : 1920
  readonly property real monH: mon ? (rotated ? mon.width : mon.height) / mon.scale : 1080

  readonly property var windows: Hyprland.toplevels.values.filter(t => t.workspace && t.workspace.id === shownId)

  anchors {
    top: true
    bottom: true
    left: true
    right: true
  }
  exclusionMode: ExclusionMode.Ignore
  WlrLayershell.layer: WlrLayer.Overlay
  WlrLayershell.namespace: "myarch-workspace-preview"
  WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
  color: "transparent"
  visible: shownId !== -1
  // Input only on the card, so the rest of the screen keeps working. While
  // a window is held, the whole screen: the pointer never leaves this
  // surface, so nothing can take the drag away from us.
  mask: Region { item: overlay.dragging ? everywhere : card }

  Item {
    id: everywhere
    anchors.fill: parent
  }

  function close() {
    shownId = -1
    large = false
  }

  function address(t) {
    const a = String(t.address)
    return a.startsWith("0x") ? a : "0x" + a
  }

  // Pointer position in screen coordinates while a window is held.
  property point pointer: Qt.point(0, 0)

  // Where would the window land if dropped now? The pointer decides: a
  // workspace id, or -1 for "nowhere".
  function dropTarget() {
    const px = pointer.x
    const py = pointer.y
    if (py <= widget.barHeight) return widget.idAtScreenX(px)
    const inCard = px >= card.x && px <= card.x + card.width && py >= card.y && py <= card.y + card.height
    if (inCard) return -1
    const here = Hyprland.monitorFor(screen)
    return here && here.activeWorkspace ? here.activeWorkspace.id : -1
  }

  // Brought to this monitor's workspace, the window also gets the focus;
  // sent to another workspace, it goes there without taking you along.
  function drop(t) {
    const target = dropTarget()
    const here = Hyprland.monitorFor(screen)
    dragging = false
    ghost.source = null
    if (target === -1 || !t.workspace || target === t.workspace.id) return
    Hyprland.dispatch(`hl.dsp.window.move({ workspace = ${target}, window = "address:${address(t)}", follow = false })`)
    if (here && here.activeWorkspace && here.activeWorkspace.id === target)
      Hyprland.dispatch(`hl.dsp.focus({ window = "address:${address(t)}" })`)
    close()
  }

  // Window geometry comes from IPC snapshots; keep them fresh while open.
  onShownIdChanged: if (shownId !== -1) Hyprland.refreshToplevels()
  Timer {
    interval: 400
    repeat: true
    running: overlay.visible
    onTriggered: Hyprland.refreshToplevels()
  }

  Rectangle {
    id: card

    readonly property real pad: 8
    readonly property real header: 22
    readonly property real anchorX: overlay.widget.cellCenter(overlay.shownId)

    // Always landscape: at least preview_aspect wide, or the monitor's own
    // shape when it's wider than that (an ultrawide stays an ultrawide).
    readonly property real aspect: Math.max({{.Settings.preview_aspect}}, overlay.monW / overlay.monH)

    width: overlay.large ? overlay.largeWidth : overlay.smallWidth
    height: header + pad * 2 + (width - pad * 2) / aspect
    x: Math.max(Theme.gapOut, Math.min(anchorX - width / 2, overlay.width - width - Theme.gapOut))
    y: overlay.widget.barHeight + Theme.gapOut
    color: Theme.surfaceRaised
    border.color: Theme.border
    border.width: 1
    radius: Theme.radius

    Behavior on width {
      enabled: Theme.motion
      NumberAnimation { duration: Theme.response; easing.type: Easing.OutQuint }
    }
    Behavior on x {
      enabled: Theme.motion
      NumberAnimation { duration: Theme.response * 0.6; easing.type: Easing.OutQuint }
    }

    HoverHandler { id: cardHover }

    Text {
      x: card.pad
      height: card.header
      verticalAlignment: Text.AlignVCenter
      text: overlay.windows.length === 0 ? {{tq "preview.empty"}}.arg(overlay.shownId)
          : overlay.windows.length === 1 ? {{tq "preview.one"}}.arg(overlay.shownId)
          : {{tq "preview.many"}}.arg(overlay.shownId).arg(overlay.windows.length)
      color: Theme.fgMuted
      font.family: Theme.fontMono
      font.pointSize: Theme.fontSize - 1
    }

    // The workspace, scaled down: every window at its real place and size,
    // the monitor centered in the landscape frame.
    Rectangle {
      id: frame
      x: card.pad
      y: card.header + card.pad
      width: card.width - card.pad * 2
      height: card.height - card.header - card.pad * 2
      color: Theme.bg
    }

    Rectangle {
      id: stage
      readonly property real k: Math.min(frame.width / overlay.monW, frame.height / overlay.monH)

      width: overlay.monW * k
      height: overlay.monH * k
      x: frame.x + (frame.width - width) / 2
      y: frame.y + (frame.height - height) / 2
      color: Theme.bgAlt
      clip: true

      Repeater {
        model: overlay.windows

        Item {
          id: thumb
          required property var modelData
          readonly property var ipc: modelData.lastIpcObject
          readonly property bool hasGeometry: !!(ipc && ipc.at && ipc.size)
          readonly property bool lifted: overlay.dragging && ghost.source === modelData

          visible: hasGeometry
          x: hasGeometry ? (ipc.at[0] - overlay.mon.x) * stage.k : 0
          y: hasGeometry ? (ipc.at[1] - overlay.mon.y) * stage.k : 0
          width: hasGeometry ? ipc.size[0] * stage.k : 0
          height: hasGeometry ? ipc.size[1] * stage.k : 0
          opacity: lifted ? 0.35 : 1

          ScreencopyView {
            anchors.fill: parent
            anchors.margins: 1
            captureSource: thumb.modelData.wayland
            live: overlay.visible
            constraintSize: Qt.size(width, height)
          }

          Rectangle {
            anchors.fill: parent
            color: "transparent"
            border.width: 1
            border.color: area.containsMouse ? Theme.accent : Theme.border
          }

          Rectangle {
            visible: overlay.large
            anchors {
              left: parent.left
              right: parent.right
              bottom: parent.bottom
            }
            height: 18
            color: Theme.accentDeep

            Text {
              anchors.fill: parent
              anchors.leftMargin: 4
              anchors.rightMargin: 4
              verticalAlignment: Text.AlignVCenter
              elide: Text.ElideRight
              text: thumb.modelData.title
              color: Theme.accentText
              font.family: Theme.fontMono
              font.pointSize: Theme.fontSize - 2
            }
          }

          MouseArea {
            id: area
            anchors.fill: parent
            hoverEnabled: true
            preventStealing: true
            cursorShape: overlay.dragging ? Qt.ClosedHandCursor : Qt.OpenHandCursor

            property point pressedAt

            function screenPoint(mouse) {
              return mapToItem(overlay.contentItem, mouse.x, mouse.y)
            }

            onPressed: mouse => {
              pressedAt = screenPoint(mouse)
              overlay.pointer = pressedAt
              ghost.aspect = thumb.width / Math.max(1, thumb.height)
              ghost.source = thumb.modelData
            }
            onPositionChanged: mouse => {
              if (!pressed) return
              overlay.pointer = screenPoint(mouse)
              if (!overlay.dragging && Math.hypot(overlay.pointer.x - pressedAt.x, overlay.pointer.y - pressedAt.y) > 6)
                overlay.dragging = true
            }
            // If the compositor takes the pointer anyway, let the window go
            // back rather than leave the ghost hanging.
            onCanceled: {
              overlay.dragging = false
              ghost.source = null
            }
            onReleased: {
              if (overlay.dragging) {
                overlay.drop(thumb.modelData)
              } else {
                ghost.source = null
                Hyprland.dispatch(`hl.dsp.focus({ window = "address:${overlay.address(thumb.modelData)}" })`)
                overlay.close()
              }
            }
          }
        }
      }
    }
  }

  // The window being dragged: follows the pointer anywhere on the screen.
  // Picked up, it shrinks to a compact card (at most 240px) hanging from
  // the pointer, like dragging an app on a tablet.
  Rectangle {
    id: ghost
    property var source: null
    property real aspect: 1
    readonly property int target: overlay.dragging ? overlay.dropTarget() : -1
    readonly property real box: 240

    visible: overlay.dragging && source !== null
    width: aspect >= 1 ? box : box * aspect
    height: width / aspect
    // Hangs below the pointer, so what you aim at (a number in the bar)
    // stays visible; never off the screen.
    x: Math.max(4, Math.min(overlay.pointer.x - width / 2, overlay.width - width - 4))
    y: Math.min(overlay.pointer.y + 16, overlay.height - height - 4)
    color: Theme.bg
    border.width: 2
    border.color: target === -1 ? Theme.border : Theme.accent
    scale: overlay.dragging ? 1 : 0.85

    Behavior on scale {
      enabled: Theme.motion
      NumberAnimation { duration: Theme.duration; easing.type: Easing.OutQuint }
    }

    ScreencopyView {
      anchors.fill: parent
      anchors.margins: 2
      captureSource: ghost.source ? ghost.source.wayland : null
      live: ghost.visible
      constraintSize: Qt.size(width, height)
    }

    // Where it will go. Inside the ghost, so it never ends up off-screen.
    Rectangle {
      visible: ghost.target !== -1
      anchors.top: parent.top
      anchors.topMargin: 8
      anchors.horizontalCenter: parent.horizontalCenter
      width: hint.implicitWidth + 12
      height: hint.implicitHeight + 6
      color: Theme.accent

      Text {
        id: hint
        anchors.centerIn: parent
        text: {{tq "preview.drop_to"}}.arg(ghost.target)
        color: Theme.accentFg
        font.family: Theme.fontMono
        font.pointSize: Theme.fontSize - 1
      }
    }
  }
}
