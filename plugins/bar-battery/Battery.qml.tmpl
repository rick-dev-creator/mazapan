// Generated by myarch (plugin {{ plugin }}).
//
// The battery, where there is one (never on a desktop): its level in the
// bar, and a click for what it's doing (charging, time left, health), the
// power profile, and the screen's brightness. (Saying it's getting low is
// panels/battery.qml's: one for the whole shell.)

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Services.UPower
import qs
import "../../components/kit"

BarItem {
  id: root

  readonly property var dev: UPower.displayDevice
  readonly property bool has: !!dev && dev.isLaptopBattery && dev.isPresent
  readonly property real level: has ? dev.percentage : 0 // 0..1
  readonly property int percent: Math.round(level * 100)
  readonly property bool charging: has && dev.state === UPowerDeviceState.Charging
  readonly property bool full: has && (dev.state === UPowerDeviceState.FullyCharged
    || (dev.state === UPowerDeviceState.PendingCharge && percent >= 95))
  readonly property bool plugged: has && !UPower.onBattery
  readonly property int low: {{ settings.low }}
  readonly property int critical: Math.min({{ settings.critical }}, low)

  shown: has
  open: popup.visible
  onClicked: popup.toggle()

  // nf-md battery glyphs, in tens; charging, a bolt.
  function glyph() {
    if (charging) return String.fromCodePoint(0xF0084)
    if (full || percent >= 95) return String.fromCodePoint(0xF0079)
    if (percent < 5) return String.fromCodePoint(0xF008E)
    return String.fromCodePoint(0xF007A + Math.max(0, Math.min(8, Math.floor(percent / 10) - 1)))
  }

  function duration(seconds) {
    const t = Math.round(seconds / 60), h = Math.floor(t / 60), m = t % 60
    return h > 0 ? {{ tq "hours" }}.arg(h).arg(m) : {{ tq "minutes" }}.arg(m)
  }

  function status() {
    if (!has) return ""
    if (full) return {{ tq "full" }}
    if (charging) return dev.timeToFull > 0 ? {{ tq "charging_until" }}.arg(duration(dev.timeToFull)) : {{ tq "charging" }}
    if (plugged) return {{ tq "plugged" }}
    return dev.timeToEmpty > 0 ? {{ tq "left" }}.arg(duration(dev.timeToEmpty)) : {{ tq "on_battery" }}
  }

  readonly property color tone: !has || charging || plugged ? Theme.fgMuted
    : percent <= critical ? Theme.danger : percent <= low ? Theme.warning : Theme.fgMuted

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: root.glyph()
    color: root.charging ? Theme.accentText : root.tone
  }

{{- if settings.show_percent }}
  Label {
    anchors.verticalCenter: parent.verticalCenter
    text: root.percent + "%"
    color: root.tone === Theme.fgMuted ? Theme.fg : root.tone
  }
{{- end }}

  // --- power profiles and brightness, if there are ------------------------------------

  // power-profiles-daemon there (PowerProfiles says nothing when it isn't).
  property bool profiles: false
  Process {
    running: true
    command: ["sh", "-c", "busctl --system --list 2>/dev/null | grep -qE 'net.hadess.PowerProfiles|org.freedesktop.UPower.PowerProfiles' && echo yes"]
    stdout: StdioCollector { onStreamFinished: root.profiles = text.trim() === "yes" }
  }

  // The screen's backlight, as brightnessctl has it (on its -e4 curve, as
  // the brightness keys): -1 when there's none.
  property int brightness: -1
  Process {
    id: readLight
    command: ["sh", "-c", "brightnessctl -c backlight -m -e4 2>/dev/null | cut -d, -f4 | tr -d %"]
    stdout: StdioCollector {
      onStreamFinished: {
        const v = text.trim()
        if (!dragging.running) root.brightness = v === "" ? -1 : Number(v)
      }
    }
  }
  // While open, it follows the keys too.
  Timer {
    interval: 1000
    repeat: true
    running: popup.visible
    onTriggered: if (!dragging.running) readLight.running = true
  }
  // Set as it's dragged, at most every 80 ms (the last one always).
  function setLight(v) {
    brightness = Math.max(1, Math.round(v))
    dragging.restart()
    if (throttle.running) throttle.pending = true
    else {
      Quickshell.execDetached(["brightnessctl", "-q", "-c", "backlight", "-e4", "set", brightness + "%"])
      throttle.start()
    }
  }
  Timer {
    id: throttle
    interval: 80
    property bool pending: false
    onTriggered: if (pending) {
      pending = false
      root.setLight(root.brightness)
    }
  }
  // Just dragged: what it reads back could be a step behind.
  Timer { id: dragging; interval: 1200 }

  BarPopup {
    id: popup
    owner: root
    cardWidth: 320
    onOpening: readLight.running = true

    RowLayout {
      Layout.fillWidth: true
      spacing: 12
      Glyph {
        text: root.glyph()
        color: root.charging ? Theme.accentText : root.tone === Theme.fgMuted ? Theme.fg : root.tone
        font.pointSize: 26
      }
      ColumnLayout {
        spacing: 2
        Label {
          text: root.percent + "%"
          font.bold: true
          font.pointSize: 16
        }
        Label {
          text: root.status()
          color: Theme.fgMuted
        }
      }
    }

    Caption {
      visible: root.has && root.dev.healthSupported
      text: root.has ? {{ tq "health" }}.arg(Math.round(root.dev.healthPercentage)) : ""
    }

    Rule { visible: root.profiles || root.brightness >= 0 }

    // The power profile: longer on battery, or faster.
    ColumnLayout {
      visible: root.profiles
      Layout.fillWidth: true
      spacing: 6
      Caption { text: {{ tq "profile" }}.toUpperCase() }
      Row {
        spacing: 6
        Repeater {
          model: [[PowerProfile.PowerSaver, {{ tq "profile.saver" }}], [PowerProfile.Balanced, {{ tq "profile.balanced" }}]]
            .concat(PowerProfiles.hasPerformanceProfile ? [[PowerProfile.Performance, {{ tq "profile.performance" }}]] : [])
          Button {
            required property var modelData
            text: modelData[1]
            primary: PowerProfiles.profile === modelData[0]
            onClicked: PowerProfiles.profile = modelData[0]
          }
        }
      }
    }

    // The screen's brightness.
    ColumnLayout {
      visible: root.brightness >= 0
      Layout.fillWidth: true
      spacing: 6
      RowLayout {
        Layout.fillWidth: true
        Caption { text: {{ tq "brightness" }}.toUpperCase(); Layout.fillWidth: true }
        Caption { text: root.brightness + "%" }
      }
      Slider {
        Layout.fillWidth: true
        value: root.brightness
        to: 100
        step: 5
        onMoved: v => root.setLight(v)
      }
    }
  }
}
