// Generated by mazapan (plugin {{ plugin }}): the battery in the Control Center.
//
// In the pill: its glyph and level. Getting low on battery: a card under
// Now that says so, with power saving one click away (and the pill says
// it, in the warning's color; almost empty, in danger's).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Services.UPower
import qs
import "../../components/kit"

Group {
  id: root

  readonly property var dev: UPower.displayDevice
  readonly property bool has: !!dev && dev.isLaptopBattery && dev.isPresent
  readonly property int percent: has ? Math.round(dev.percentage * 100) : 100
  readonly property bool draining: has && UPower.onBattery
  readonly property int low: {{ settings.low }}
  readonly property int critical: Math.min({{ settings.critical }}, low)

  property bool shown: has
  readonly property bool live: draining && percent <= low
  readonly property int level: percent <= critical ? 2 : 1
  readonly property string pill: {{ tq "pill" }}.arg(percent)
  readonly property string pillGlyph: !has ? ""
    : (dev.state === UPowerDeviceState.Charging ? String.fromCodePoint(0xF0084)
      : percent >= 95 ? String.fromCodePoint(0xF0079)
      : percent < 5 ? String.fromCodePoint(0xF008E)
      : String.fromCodePoint(0xF007A + Math.max(0, Math.min(8, Math.floor(percent / 10) - 1)))) + " " + percent + "%"

  readonly property color tone: level === 2 ? Theme.danger : Theme.warning
  color: Qt.rgba(tone.r, tone.g, tone.b, 0.12)
  border.color: level === 2 ? Theme.danger : Theme.warning

  RowLayout {
    Layout.fillWidth: true
    spacing: 10
    Glyph {
      text: String.fromCodePoint(0xF008E)
      color: root.level === 2 ? Theme.danger : Theme.warning
      font.pointSize: 15
    }
    ColumnLayout {
      Layout.fillWidth: true
      spacing: 2
      Label {
        text: root.level === 2 ? {{ tq "critical_title" }} : {{ tq "low_title" }}
        font.bold: true
      }
      Caption {
        text: (root.level === 2 ? {{ tq "critical_body" }} : {{ tq "low_body" }}).arg(root.percent)
        font.letterSpacing: 0
        wrapMode: Text.Wrap
        Layout.fillWidth: true
      }
    }
    Button {
      visible: PowerProfiles.profile !== PowerProfile.PowerSaver
      primary: true
      text: {{ tq "save" }}
      onClicked: PowerProfiles.profile = PowerProfile.PowerSaver
    }
  }
}
