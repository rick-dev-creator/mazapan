// Generated by mazapan (plugin {{ plugin }}): the screen's brightness, in the
// Control Center (where there's a backlight: a laptop's screen).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import qs
import "../../components/kit"

Group {
  id: root

  // As brightnessctl has it, on its -e4 curve (as the brightness keys): -1, none.
  property int brightness: -1
  property bool shown: brightness >= 0

  Process {
    id: readLight
    running: true
    command: ["sh", "-c", "brightnessctl -c backlight -m -e4 2>/dev/null | cut -d, -f4 | tr -d %"]
    stdout: StdioCollector {
      onStreamFinished: {
        const v = text.trim()
        if (!dragging.running) root.brightness = v === "" ? -1 : Number(v)
      }
    }
  }
  // It follows the keys too, while it can be seen.
  Timer {
    interval: 1000
    repeat: true
    running: root.visible
    onTriggered: if (!dragging.running) readLight.running = true
  }
  function setLight(v) {
    brightness = Math.max(1, Math.round(v))
    dragging.restart()
  }
  // Set as it's dragged, at most every 80 ms (the last one always).
  Timer {
    id: dragging
    interval: 80
    onTriggered: Quickshell.execDetached(["brightnessctl", "-q", "-c", "backlight", "-e4", "set", root.brightness + "%"])
  }

  RowLayout {
    Layout.fillWidth: true
    spacing: 10
    Glyph {
      text: "󰃟"
      color: Theme.accentText
      font.pointSize: 13
      Layout.preferredWidth: 20
    }
    Slider {
      Layout.fillWidth: true
      value: root.brightness
      to: 100
      step: 5
      onMoved: v => root.setLight(v)
    }
    Caption {
      text: root.brightness + "%"
      font.letterSpacing: 0
      Layout.preferredWidth: 44
      horizontalAlignment: Text.AlignRight
    }
  }
}
