// Generated by myarch (plugin {{ plugin }}).
//
// Says when the battery is getting low, and again when it's very low:
// once per discharge each, from here (one for the whole shell, not one per
// bar), and it remembers what it said across the shell's reloads.

import QtQuick
import Quickshell
import Quickshell.Services.UPower

Item {
  id: root

  // A panel by contract (see shell.qml): nothing to open.
  readonly property bool open: false
  function toggle() {}
  function close() {}

  readonly property var dev: UPower.displayDevice
  readonly property bool has: !!dev && dev.isLaptopBattery && dev.isPresent
  readonly property int percent: has ? Math.round(dev.percentage * 100) : 100
  readonly property bool discharging: has && UPower.onBattery
  readonly property bool plugged: has && !UPower.onBattery
  readonly property int low: {{ settings.low }}
  // Never above "getting low".
  readonly property int critical: Math.min({{ settings.critical }}, low)

  // What it last said (100: nothing yet), kept across reloads.
  PersistentProperties {
    id: told
    reloadableId: "myarch-battery-told"
    property int at: 100
    // Its values are back (or it's the first start): now it can check.
    onLoaded: root.check()
  }

  function check() {
    // Plugged in: the next discharge starts afresh. Not known yet (UPower
    // still starting): nothing forgotten.
    if (plugged) told.at = 100
    if (!discharging) return
    if (percent <= critical && told.at > critical) {
      told.at = critical
      Quickshell.execDetached(["notify-send", "-a", {{ tq "title" }}, "-u", "critical", "-i", "battery-caution",
        {{ tq "critical_title" }}, {{ tq "critical_body" }}.arg(percent)])
    } else if (percent <= low && told.at > low) {
      told.at = low
      Quickshell.execDetached(["notify-send", "-a", {{ tq "title" }}, "-i", "battery-low",
        {{ tq "low_title" }}, {{ tq "low_body" }}.arg(percent)])
    }
  }

  onPercentChanged: check()
  onDischargingChanged: check()
  onPluggedChanged: check()
}
