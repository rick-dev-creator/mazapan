// Generated by mazapan (plugin {{ plugin }}): power saving in the Control Center.
//
// A big switch: the power saver profile on, or back to what it was
// (balanced, or performance). Only where power-profiles-daemon runs.

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Services.UPower
import qs
import "../../components/kit"

Tile {
  id: root

  property bool shown: false
  Process {
    running: true
    // Running (asking starts it when it can): an installed one that can't
    // start would show a switch that does nothing.
    command: ["sh", "-c", "powerprofilesctl get >/dev/null 2>&1 && echo yes"]
    stdout: StdioCollector { onStreamFinished: root.shown = text.trim() === "yes" }
  }

  readonly property bool saving: PowerProfiles.profile === PowerProfile.PowerSaver
  property int before: PowerProfile.Balanced

  glyph: saving ? "󰌪" : "󰾅"
  title: {{ tq "saver" }}
  detail: saving ? {{ tq "saver.on" }}
    : PowerProfiles.profile === PowerProfile.Performance ? {{ tq "profile.performance" }} : {{ tq "profile.balanced" }}
  checked: saving
  onToggled: {
    if (saving) PowerProfiles.profile = before
    else { before = PowerProfiles.profile; PowerProfiles.profile = PowerProfile.PowerSaver }
  }
}
