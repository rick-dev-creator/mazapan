// Generated by myarch (plugin {{.Plugin}}).
//
// The focused window's title. Empty when nothing has the focus, so the bar
// doesn't keep showing a window that's gone.

import QtQuick
import Quickshell.Hyprland
import qs

Item {
  id: root

  property int barHeight: 28

  readonly property string title: Hyprland.activeToplevel ? Hyprland.activeToplevel.title : ""

  implicitWidth: title === "" ? 0 : label.width
  implicitHeight: barHeight

  Text {
    id: label
    anchors.verticalCenter: parent.verticalCenter
    width: Math.min(implicitWidth, {{.Settings.max_width}})
    text: root.title
    elide: Text.ElideRight
    color: Theme.fgMuted
    font.family: Theme.fontMono
    font.pointSize: {{.Settings.font_size}}
  }
}
