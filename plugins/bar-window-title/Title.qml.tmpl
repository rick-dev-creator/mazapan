// Generated by mazapan (plugin {{ plugin }}).
//
// The focused window's title. Empty when nothing has the focus, so the bar
// doesn't keep showing a window that's gone.

import QtQuick
import Quickshell.Hyprland
import qs

Item {
  id: root

  property int barHeight: 28

  readonly property string title: Hyprland.activeToplevel ? Hyprland.activeToplevel.title : ""
  // Shortened first when the bar is short of room.
  readonly property bool elastic: true

  implicitWidth: title === "" ? 0 : Math.min(label.implicitWidth, {{ settings.max_width }})
  implicitHeight: barHeight

  Text {
    id: label
    anchors.verticalCenter: parent.verticalCenter
    width: root.width
    text: root.title
    // A window's title is anyone's (a web page, a terminal): never markup.
    textFormat: Text.PlainText
    elide: Text.ElideRight
    color: Theme.fgMuted
    font.family: Theme.fontMono
    font.pointSize: {{ settings.font_size }}
  }
}
