// Generated by mazapan (plugin {{ plugin }}): the Plugins panel.
//
// Every plugin mazapan knows about (its own, the community's: shipped or in
// the catalogs, from git, yours), searchable (a search looks everywhere,
// whatever the tab), each marked by who made it, each with its page: the README, what it can do
// (its capabilities, the risky ones marked), its settings to change in
// place. Everything goes through mazapan: turning on and off and settings
// are apply --enable/--disable/--set (mazapan undo takes them back);
// installing is plugins add of the commit whose capabilities were shown,
// removing plugins remove. What asks for a password or an approval
// (hardware plugins' root parts, an update with new capabilities) opens
// in a terminal.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var rows: []          // mazapan plugins catalog --json
  property string tab: "installed"
  property string source: "all"  // all, mazapan, community: who made it
  property var problems: []      // catalogs that couldn't be read (offline…)
  property string query: ""
  property string selectedId: ""
  property var detail: null      // mazapan plugins show/preview --json
  property string section: "details"
  property string message: ""   // what the last action did, or what went wrong
  property bool failed: false   // the last action failed
  property string loading: ""   // what's being read
  property bool busy: false
  property var screenAtOpen: null

  readonly property string home: Quickshell.env("HOME")
  readonly property string state: home + "/.local/state/mazapan"
  // A search looks in every tab: what's not installed yet is found too.
  readonly property var shown: rows.filter(r => (query.trim() !== "" || inTab(r)) && fromSource(r) && matches(r))
  function count(t) { return rows.filter(r => fromSource(r) && (t === "all" || (t === "installed" ? r.state !== "available" : t === "available" ? r.state === "available" : !!r.for_this_machine))).length }
  readonly property var row: rows.find(r => r.id === selectedId) ?? null

  // Another tab or search: the page follows the list.
  function follow() {
    if (shown.length > 0 && !shown.some(r => r.id === selectedId)) select(shown[0].id)
  }
  onTabChanged: Qt.callLater(follow)
  onSourceChanged: Qt.callLater(follow)
  onQueryChanged: Qt.callLater(follow)

  function inTab(r) {
    if (tab === "installed") return r.state !== "available"
    if (tab === "available") return r.state === "available"
    if (tab === "machine") return !!r.for_this_machine
    return true
  }

  function fromSource(r) {
    return source === "all" || (source === "community" ? r.origin !== "mazapan" : r.origin === "mazapan")
  }

  function matches(r) {
    const text = [r.id, r.name, r.description, r.author, (r.categories || []).join(" "), originText(r.origin), stateText(r)].join(" ").toLowerCase()
    return query.toLowerCase().split(/\s+/).every(w => w === "" || text.includes(w))
  }

  function toggle() {
    if (open) close()
    else show()
  }

  // Opened on one plugin (qs ipc -c mazapan call plugins open ID): its page,
  // where installing it shows what it can do first.
  property string wanted: ""
  IpcHandler {
    target: "plugins"
    function open(id: string): void {
      root.wanted = id
      search.text = ""
      root.query = ""
      if (!root.open) root.show()
      else if (root.rows.some(r => r.id === id)) {
        root.wanted = ""
        root.tab = root.rows.find(r => r.id === id).state === "available" ? "available" : "installed"
        root.select(id, false)
      }
    }
  }

  function show() {
    settled = false
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    open = true
    loading = {{ tq "loading" }}
    catalog.running = true
    Qt.callLater(() => list.forceActiveFocus())
  }

  function close() {
    open = false
  }

  function select(id, keepSection) {
    if (id === selectedId && detail) return
    selectedId = id
    detail = null
    confirming = false
    if (!keepSection) section = "details"
    if (!page.running) fetch()
  }

  // The selected plugin's page: one fetch at a time, the latest selection
  // fetched once the one running ends.
  function fetch() {
    const r = rows.find(x => x.id === selectedId)
    page.fetching = selectedId
    if (!r || r.state === "broken") return
    // Only listed (a catalog's): fetched to look at. One shipped with
    // mazapan (a community plugin) is here already.
    if (r.state === "available" && !r.bundled) {
      loading = {{ tq "fetching" }}.arg(r.name)
      page.command = ["mazapan", "plugins", "preview", r.id, "--json"]
    } else page.command = ["mazapan", "plugins", "show", r.id, "--json"]
    page.running = true
  }

  // Runs a mazapan command, detached: applying can reload the shell, this
  // panel with it, and the command must outlive it. The command leaves its
  // result in a file the panel polls; a panel started while one runs (the
  // reloaded shell's) picks it up where this one was. What asks (sudo, new
  // capabilities to approve) runs in a terminal, where it can ask: the
  // panel steps aside and comes back when it's done.
  property string pending: ""
  property string pendingLabel: ""
  property bool pendingTerminal: false

  function run(label, script, terminal) {
    busy = true
    failed = false
    pending = String(Date.now())
    pendingLabel = label
    pendingTerminal = !!terminal
    message = {{ tq "working" }}.arg(label)
    // The result is written however it ends (a terminal closed while sudo
    // asks, too); if even that can't happen, the panel sees the process gone.
    const wrap = 'S=$1; T=$2; c=1; mkdir -p "$S"; ' +
      'printf "%s\\n%s\\n%s\\n%s\\n%s\\n%s\\n" "$2" "$3" "$4" "$6" "$7" "$$" > "$S/plugins-panel.running"; ' +
      'fin() { printf "%s\\n%s\\n" "$T" "$c" > "$S/plugins-panel.result"; }; trap fin EXIT; trap "exit 1" HUP INT TERM; ' +
      (terminal ? '(eval "$5"); c=$?' : '(eval "$5") > "$S/plugins-panel.log" 2>&1; c=$?')
    const args = [state, pending, selectedId, label, script, terminal ? "terminal" : "", section]
    if (!terminal) {
      Quickshell.execDetached(["sh", "-c", wrap, "sh"].concat(args))
      return
    }
    Quickshell.execDetached(["sh", "-c", 'T=$1; shift; exec $T sh -c "$@"', "sh", {{ quote settings.terminal }},
      wrap, "sh"].concat(args))
    close()
  }

  function finished(out) {
    const [result, log, runningToken, alive] = out.split("\x1e").concat(["", "", "", ""])
    let [token, code] = result.trim().split("\n")
    // Killed before it could say how it went.
    if (token !== pending && runningToken.trim() === pending && alive.trim() === "") {
      token = pending
      code = "interrupted"
    }
    if (token !== pending) return
    busy = false
    pending = ""
    Quickshell.execDetached(["rm", "-f", state + "/plugins-panel.running"])
    const last = code === "interrupted" ? {{ tq "interrupted" }}
      : pendingTerminal ? pendingLabel : (log || "").trim().split("\n").filter(l => l !== "").join("\n") || pendingLabel
    failed = code !== "0"
    message = failed ? {{ tq "failed" }}.arg(last) : {{ tq "done" }}.arg(pendingLabel)
    if (pendingTerminal && !open) show()
    else catalog.running = true
  }

  function q(s) { return "'" + String(s).replace(/'/g, "'\\''") + "'" }

  // Installing asks first: its capabilities shown, then "allow and
  // install" installs that commit, the one looked at, or nothing (it may
  // have moved since).
  property bool confirming: false

  function install() {
    if (!confirming) {
      confirming = true
      section = "can"
      return
    }
    confirming = false
    // Shipped with mazapan: installing it is turning it on.
    if (detail.origin === "community") turn(true, {{ tq "install" }})
    else run({{ tq "install" }}, "mazapan plugins add " + q(selectedId) + " -y --commit " + q(detail.commit) + " && mazapan apply")
  }
  function remove() { run({{ tq "remove" }}, "mazapan plugins remove " + q(selectedId) + " && mazapan apply") }
  function update() { run({{ tq "update" }}, "mazapan plugins update " + q(selectedId) + " && mazapan apply", true) }

  // A hardware plugin writes system files: with sudo, so in a terminal.
  function applying(args) {
    // So does one whose packages come when it's turned on (optional ones).
    const hw = detail && (detail.hardware !== "" || (detail.packages_missing || []).length > 0)
    run(args.label, "mazapan apply " + args.flags + (hw ? " --system" : ""), hw)
  }

  // Through apply, so undo takes it back (config.toml is in its snapshot).
  function turn(on, label) {
    applying({ label: label || (on ? {{ tq "enable" }} : {{ tq "disable" }}), flags: (on ? "--enable " : "--disable ") + q(selectedId) })
  }

  // A TOML value from what the page holds.
  function toml(s, v) {
    if (s.kind === "switch") return v ? "true" : "false"
    if (s.kind === "integer" || s.kind === "number") return String(Number(v))
    if (typeof s.default === "number") return String(Number(v))
    if (s.kind === "list") return String(v) // typed as TOML: ["a", "b"]
    return JSON.stringify(String(v))
  }

  // Where the list and the page were scrolled to, kept across the reload an
  // apply causes (a setting changed reloads the shell, this panel with it):
  // back where they were, not jumping to the selected row's place.
  PersistentProperties {
    id: kept
    reloadableId: "mazapan-plugins"
    property real listY: -1
    property real pageY: -1
    property string pageOf: "" // the plugin and section pageY is for
    property string selected: ""
    property string section: ""
  }
  // Kept only once the panel is back as it was: the view going to the top
  // as its rows come in isn't where the person left it.
  property bool settled: false
  function restoreList() {
    if (kept.listY >= 0) list.contentY = Math.max(0, Math.min(kept.listY, list.contentHeight - list.height))
    settled = true
  }
  onSelectedIdChanged: if (selectedId !== "") kept.selected = selectedId
  onSectionChanged: kept.section = section

  // Settings changed one after another (a number stepped, switches
  // flipped) go in one apply, a moment after the last: each apply that
  // writes the shell's files reloads it, so one each would make the screen
  // blink as fast as they're changed. While one runs, the next waits.
  property var queued: ({}) // "plugin.key" → TOML value, or null to reset
  property var queuedLabels: []
  function queue(key, value, label) {
    const next = Object.assign({}, queued)
    next[key] = value
    queued = next
    if (!queuedLabels.includes(label)) queuedLabels = queuedLabels.concat([label])
    settle.restart()
  }
  Timer {
    id: settle
    interval: 700
    onTriggered: {
      if (root.busy) { restart(); return }
      const keys = Object.keys(root.queued)
      if (keys.length === 0) return
      const flags = keys.map(k => root.queued[k] === null ? "--reset " + root.q(k) : "--set " + root.q(k + "=" + root.queued[k])).join(" ")
      const label = root.queuedLabels.length === 1 ? root.queuedLabels[0] : {{ tq "settings_n" }}.arg(root.queuedLabels.length)
      root.queued = ({})
      root.queuedLabels = []
      root.applying({ label: label, flags: flags })
    }
  }

  function set(s, v) {
    queue(selectedId + "." + s.key, toml(s, v), s.label)
  }

  function reset(s) {
    queue(selectedId + "." + s.key, null, s.label)
  }

  // A README from anyone, shown: no images (fetched from anywhere, before
  // anything is approved) and no HTML.
  function safeMarkdown(md) {
    return md.replace(/!\[/g, "[").replace(/<[^>]*>/g, "")
  }

  // What a number setting takes: "10 – 3600", "≥ 1".
  function range(s) {
    if (s.min !== undefined && s.max !== undefined) return s.min + " – " + s.max
    if (s.min !== undefined) return "≥ " + s.min
    if (s.max !== undefined) return "≤ " + s.max
    return ""
  }

  // A Nerd Font icon for the plugin's first category.
  function glyph(r) {
    const c = (r.categories || [])[0] || "tools"
    const cp = ({ bar: 0xF056E, panel: 0xF05B2, theme: 0xF03D8, window: 0xF05AF, hardware: 0xF061A,
                  tools: 0xF0431, agent: 0xF06A9 })[c] || 0xF0431
    return String.fromCodePoint(cp)
  }

  // A capability in the panel's language: its kind's text, %1 what it's
  // about (a path, a command: as they are).
  readonly property var capTexts: ({
    root_file: {{ tq "cap.root_file" }}, root_file_reboot: {{ tq "cap.root_file_reboot" }},
    shell_code: {{ tq "cap.shell_code" }}, hypr_code: {{ tq "cap.hypr_code" }}, code: {{ tq "cap.code" }},
    config: {{ tq "cap.config" }}, settings_in: {{ tq "cap.settings_in" }}, writes: {{ tq "cap.writes" }},
    root_run: {{ tq "cap.root_run" }}, reload: {{ tq "cap.reload" }}, check: {{ tq "cap.check" }},
    action: {{ tq "cap.action" }}, package: {{ tq "cap.package" }}, hardware: {{ tq "cap.hardware" }}
  })

  function capText(c) {
    const t = capTexts[c.kind]
    return t ? t.arg(c.subject) : c.text
  }

  // Who made it: a row's origin (mazapan, community, local) or a page's
  // (built-in, community, local, git, available).
  function originText(o) {
    return ({ "built-in": {{ tq "origin.mazapan" }}, mazapan: {{ tq "origin.mazapan" }}, community: {{ tq "origin.community" }},
              local: {{ tq "state.local" }}, git: {{ tq "origin.community" }}, available: {{ tq "origin.community" }} })[o] || o
  }
  function badgeColor(o) {
    return o === "mazapan" || o === "built-in" ? Theme.accentText : o === "local" ? Theme.info : Theme.success
  }

  function stateText(r) {
    if (r.state === "available") return {{ tq "state.available" }}
    if (r.state === "broken") return {{ tq "state.broken" }}
    return (r.enabled ? {{ tq "enabled" }} : {{ tq "disabled" }})
  }

  Component.onCompleted: reopen.running = true

  // A command still running from before the shell reloaded (not an old one
  // left by a crash: those aren't waited for).
  Process {
    id: reopen
    command: ["sh", "-c", 'f="$0/plugins-panel.running"; [ -n "$(find "$f" -mmin -30 2>/dev/null)" ] && cat "$f"', root.state]
    stdout: StdioCollector {
      onStreamFinished: {
        const [token, id, label, where, section] = text.split("\n")
        if (!token || !id) return
        root.pending = token
        root.pendingLabel = label || ""
        root.pendingTerminal = where === "terminal"
        root.busy = true
        root.selectedId = id
        root.section = section || "details"
        // Not over a terminal still asking for a password.
        if (!root.pendingTerminal) root.show()
        root.message = {{ tq "working" }}.arg(root.pendingLabel)
      }
    }
  }

  Timer {
    interval: 400
    repeat: true
    running: root.busy
    onTriggered: if (!poll.running) poll.running = true
  }

  Process {
    id: poll
    command: ["sh", "-c", 'cat "$0/plugins-panel.result" 2>/dev/null; printf "\\036"; tail -n 4 "$0/plugins-panel.log" 2>/dev/null; printf "\\036"; ' +
      'r="$0/plugins-panel.running"; sed -n 1p "$r" 2>/dev/null; printf "\\036"; p=$(sed -n 6p "$r" 2>/dev/null); [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo alive', root.state]
    stdout: StdioCollector { onStreamFinished: root.finished(text) }
  }

  Process {
    id: catalog
    command: ["mazapan", "plugins", "catalog", "--json"]
    stdout: StdioCollector {
      onStreamFinished: {
        let data
        try {
          data = JSON.parse(text)
        } catch (e) {
          root.loading = ""
          root.failed = true; root.message = {{ tq "unreadable" }}
          return
        }
        root.rows = (data.plugins || []).sort((a, b) => a.name.localeCompare(b.name))
        root.problems = data.problems || []
        root.loading = ""
        // Asked for one (the Apps menu's plugins): that one.
        const wanted = root.wanted !== "" && root.rows.some(r => r.id === root.wanted) ? root.wanted : ""
        root.wanted = ""
        // On the tab it's in (one to add is on Available).
        if (wanted !== "") root.tab = root.rows.find(r => r.id === wanted).state === "available" ? "available" : "installed"
        const had = root.selectedId !== "" ? root.selectedId : kept.selected
        const id = wanted !== "" ? wanted : had !== "" && root.rows.some(r => r.id === had) ? had
          : (root.shown[0] ? root.shown[0].id : "")
        // The section it was on, when it's the same plugin as before.
        if (wanted === "" && id === kept.selected && kept.section !== "") root.section = kept.section
        root.selectedId = ""
        if (id !== "") root.select(id, true)
        // After the rows are laid out (and the view has followed the selected one).
        Qt.callLater(() => Qt.callLater(root.restoreList))
      }
    }
    onExited: code => {
      if (code === 0) return
      root.loading = ""
      if (root.rows.length === 0) { root.failed = true; root.message = {{ tq "unreadable" }} }
    }
  }

  Process {
    id: page
    property string fetching: ""
    stdout: StdioCollector {
      onStreamFinished: {
        try {
          const d = JSON.parse(text)
          if (d.id === root.selectedId) {
            root.detail = d
            root.loading = ""
            // The same page as before the reload: where it was read to.
            if (kept.pageOf === root.selectedId + "/" + root.section && kept.pageY > 0)
              Qt.callLater(() => scroller.contentY = Math.max(0, Math.min(kept.pageY, scroller.contentHeight - scroller.height)))
          }
        } catch (e) {}
      }
    }
    stderr: StdioCollector {
      onStreamFinished: {
        if (page.fetching !== root.selectedId) return
        root.loading = ""
        if (text.trim() !== "") { root.failed = true; root.message = text.trim().split("\n").pop() }
      }
    }
    onExited: if (page.fetching !== root.selectedId) root.fetch()
  }

  // --- the panel ---------------------------------------------------------------

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: Math.min(1100, (screen ? screen.width : 1280) * 0.86)
    implicitHeight: Math.min(680, (screen ? screen.height : 900) * 0.8)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-plugins"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      anchors.fill: parent
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius

      Keys.onEscapePressed: root.close()

      RowLayout {
        anchors.fill: parent
        anchors.margins: 16
        spacing: 16

        // --- the list ---------------------------------------------------------
        ColumnLayout {
          Layout.preferredWidth: 380
          Layout.minimumWidth: 380
          Layout.maximumWidth: 380
          Layout.fillHeight: true
          spacing: 10

          RowLayout {
            Caption { text: {{ tq "title" }}.toUpperCase() }
            Item { Layout.fillWidth: true }
            Caption { text: root.busy ? "…" : "" }
          }

          TextField {
            id: search
            Layout.fillWidth: true
            placeholder: {{ tq "search" }}
            onTextChanged: root.query = text
            onAccepted: list.forceActiveFocus()
            Keys.onEscapePressed: root.close()
            Keys.onDownPressed: list.forceActiveFocus()
          }

          // What state (installed or to install), then who made it.
          Flow {
            Layout.fillWidth: true
            spacing: 6
            opacity: root.query.trim() === "" ? 1 : 0.5
            Repeater {
              model: [["installed", {{ tq "tab.installed" }}], ["available", {{ tq "tab.available" }}],
                      ["machine", {{ tq "tab.machine" }}], ["all", {{ tq "tab.all" }}]]
              Button {
                required property var modelData
                text: modelData[1] + " " + root.count(modelData[0])
                primary: root.tab === modelData[0] && root.query.trim() === ""
                onClicked: { root.tab = modelData[0]; search.text = "" }
              }
            }
          }
          Flow {
            Layout.fillWidth: true
            spacing: 4
            Repeater {
              model: [["all", {{ tq "source.all" }}], ["mazapan", {{ tq "origin.mazapan" }}], ["community", {{ tq "origin.community" }}]]
              Rectangle {
                id: chip
                required property var modelData
                readonly property bool on: root.source === modelData[0]
                implicitWidth: chipText.implicitWidth + 16
                implicitHeight: 22
                radius: Theme.radius
                color: on ? Theme.accentDeep : "transparent"
                border.width: 1
                border.color: on ? Theme.accent : Theme.border
                Text {
                  id: chipText
                  anchors.centerIn: parent
                  textFormat: Text.PlainText
                  text: chip.modelData[1]
                  color: chip.on ? Theme.fg : Theme.fgMuted
                  font.family: Theme.fontMono
                  font.pointSize: 8.5
                }
                MouseArea {
                  anchors.fill: parent
                  cursorShape: Qt.PointingHandCursor
                  onClicked: root.source = chip.modelData[0]
                }
              }
            }
          }
          // Searching: everywhere, not only in the tab.
          Caption {
            visible: root.query.trim() !== ""
            text: {{ tq "searching_all" }}.arg(root.shown.length)
            font.letterSpacing: 0
          }

          ListView {
            id: list
            Layout.fillWidth: true
            Layout.fillHeight: true
            clip: true
            spacing: 2
            model: root.shown
            currentIndex: Math.max(0, root.shown.findIndex(r => r.id === root.selectedId))
            boundsBehavior: Flickable.StopAtBounds
            focus: true
            onContentYChanged: if (root.open && root.settled) kept.listY = contentY

            Keys.onPressed: event => {
              const n = root.shown.length
              if (event.key === Qt.Key_Down || event.key === Qt.Key_J) {
                if (n) root.select(root.shown[Math.min(n - 1, currentIndex + 1)].id)
              } else if (event.key === Qt.Key_Up || event.key === Qt.Key_K) {
                if (n) root.select(root.shown[Math.max(0, currentIndex - 1)].id)
              } else if (event.key === Qt.Key_Slash) search.focusInput()
              else if (event.key === Qt.Key_Escape) root.close()
              else return
              event.accepted = true
            }

            delegate: Rectangle {
              id: item
              required property var modelData
              readonly property bool chosen: modelData.id === root.selectedId
              width: ListView.view.width
              height: 54
              radius: Theme.radius
              color: chosen ? Theme.selection : area.containsMouse ? Theme.surface : "transparent"

              RowLayout {
                anchors.fill: parent
                anchors.margins: 8
                spacing: 10
                Glyph {
                  text: root.glyph(item.modelData)
                  color: item.modelData.state === "available" ? Theme.fgMuted : Theme.accentText
                  font.pointSize: 16
                  horizontalAlignment: Text.AlignHCenter
                  Layout.preferredWidth: 26
                  Layout.alignment: Qt.AlignVCenter
                }
                ColumnLayout {
                  Layout.fillWidth: true
                  spacing: 2
                  RowLayout {
                    Layout.fillWidth: true
                    Label {
                      text: item.modelData.name
                      font.bold: true
                      elide: Text.ElideRight
                      Layout.fillWidth: true
                    }
                    // Who made it, on every row.
                    Rectangle {
                      visible: item.modelData.state !== "broken"
                      implicitWidth: badge.implicitWidth + 10
                      implicitHeight: badge.implicitHeight + 2
                      radius: Theme.radius
                      color: "transparent"
                      border.width: 1
                      border.color: root.badgeColor(item.modelData.origin)
                      Text {
                        id: badge
                        anchors.centerIn: parent
                        textFormat: Text.PlainText
                        text: root.originText(item.modelData.origin).toUpperCase()
                        color: root.badgeColor(item.modelData.origin)
                        font.family: Theme.fontMono
                        font.pointSize: 7
                        font.letterSpacing: 0.5
                      }
                    }
                    Caption {
                      text: root.stateText(item.modelData)
                      color: item.modelData.state === "broken" ? Theme.danger
                        : item.modelData.enabled ? Theme.accentText : Theme.fgSubtle
                    }
                  }
                  Label {
                    text: item.modelData.description
                    color: Theme.fgMuted
                    elide: Text.ElideRight
                    Layout.fillWidth: true
                  }
                }
              }
              MouseArea {
                id: area
                anchors.fill: parent
                hoverEnabled: true
                onClicked: {
                  root.select(item.modelData.id)
                  list.forceActiveFocus()
                }
              }
            }

            // Nothing here: why, and where more come from.
            ColumnLayout {
              anchors.centerIn: parent
              width: parent.width - 24
              visible: root.shown.length === 0 && root.loading === ""
              spacing: 6
              Label {
                Layout.fillWidth: true
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.Wrap
                text: root.query.trim() !== "" ? {{ tq "none_search" }}.arg(root.query.trim())
                  : root.tab === "available" ? {{ tq "none_available" }} : {{ tq "none" }}
                color: Theme.fgMuted
              }
              Label {
                Layout.fillWidth: true
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.Wrap
                visible: root.query.trim() !== "" || root.tab === "available"
                text: {{ tq "more_where" }}
                color: Theme.fgSubtle
              }
            }
          }

          // A catalog that couldn't be read (offline): said, not hidden.
          Label {
            visible: root.problems.length > 0
            Layout.fillWidth: true
            wrapMode: Text.Wrap
            text: {{ tq "catalog_offline" }}
            color: Theme.warning
          }

          Caption { text: {{ tq "hints" }} }
        }

        Rule { Layout.fillWidth: false; Layout.fillHeight: true; implicitWidth: 1 }

        // --- the page ---------------------------------------------------------
        ColumnLayout {
          Layout.fillWidth: true
          Layout.fillHeight: true
          spacing: 12

          Label {
            visible: root.loading !== "" || root.message !== ""
            text: root.busy || root.loading === "" ? root.message : root.loading
            color: root.failed && !root.busy ? Theme.danger : Theme.fgMuted
            wrapMode: Text.Wrap
            Layout.fillWidth: true
          }

          Item {
            visible: root.detail !== null
            Layout.fillWidth: true
            Layout.fillHeight: true

            ColumnLayout {
              anchors.fill: parent
              spacing: 12

              // Header: what it is, and what can be done with it.
              RowLayout {
                Layout.fillWidth: true
                spacing: 12
                Glyph {
                  text: root.detail ? root.glyph(root.detail) : ""
                  color: Theme.accentText
                  font.pointSize: 28
                  Layout.alignment: Qt.AlignTop
                }
                ColumnLayout {
                  Layout.fillWidth: true
                  spacing: 2
                  Label {
                    text: root.detail ? root.detail.name : ""
                    font.bold: true
                    font.pointSize: 14
                  }
                  Caption {
                    text: root.detail ? [root.originText(root.detail.origin).toUpperCase(), root.detail.id, root.detail.version,
                      root.row && root.row.author ? {{ tq "by" }}.arg(root.row.author) : "",
                      root.detail.source].filter(x => x).join("  ·  ") : ""
                    elide: Text.ElideRight
                    Layout.fillWidth: true
                  }
                  Label {
                    text: root.detail ? root.detail.description : ""
                    color: Theme.fgMuted
                    wrapMode: Text.Wrap
                    Layout.fillWidth: true
                  }
                }
              }

              Row {
                spacing: 8
                enabled: !root.busy
                readonly property var d: root.detail
                // A community plugin not installed yet (from a catalog, or
                // shipped with mazapan): what it can do first, then installed.
                readonly property bool toInstall: !!d && (d.origin === "available" || (d.origin === "community" && !d.enabled))
                Button {
                  visible: parent.toInstall
                  text: root.confirming ? {{ tq "allow_install" }} : {{ tq "install" }}
                  primary: true
                  onClicked: root.install()
                }
                Button {
                  visible: !!parent.d && !parent.toInstall && !parent.d.enabled
                  text: {{ tq "enable" }}
                  primary: true
                  onClicked: root.turn(true)
                }
                Button {
                  visible: !!parent.d && parent.d.origin !== "available" && parent.d.enabled
                  text: parent.d && parent.d.origin === "community" ? {{ tq "remove" }} : {{ tq "disable" }}
                  onClicked: root.turn(false, parent.d.origin === "community" ? {{ tq "remove" }} : "")
                }
                Button {
                  visible: parent.d && parent.d.origin === "git"
                  text: {{ tq "update" }}
                  onClicked: root.update()
                }
                Button {
                  visible: parent.d && parent.d.origin === "git"
                  text: {{ tq "remove" }}
                  onClicked: root.remove()
                }
              }

              Row {
                spacing: 6
                Repeater {
                  model: [["details", {{ tq "details" }}], ["can", {{ tq "can" }}], ["settings", {{ tq "settings" }}]]
                  Button {
                    required property var modelData
                    text: modelData[1]
                    primary: root.section === modelData[0]
                    onClicked: root.section = modelData[0]
                  }
                }
              }

              Rule { Layout.fillWidth: true; implicitHeight: 1 }

              Flickable {
                id: scroller
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                contentWidth: width
                contentHeight: pageBody.implicitHeight
                boundsBehavior: Flickable.StopAtBounds
                onContentYChanged: if (root.open && root.detail) { kept.pageY = contentY; kept.pageOf = root.selectedId + "/" + root.section }

                ColumnLayout {
                  id: pageBody
                  width: scroller.width
                  spacing: 10

                  // Details: the README, and how it fits with the rest.
                  Text {
                    visible: root.section === "details"
                    Layout.fillWidth: true
                    text: root.detail && root.detail.readme !== "" ? root.safeMarkdown(root.detail.readme) : {{ tq "no_readme" }}
                    textFormat: root.detail && root.detail.readme !== "" ? Text.MarkdownText : Text.PlainText
                    wrapMode: Text.Wrap
                    color: Theme.fg
                    linkColor: Theme.accentText
                    font.family: Theme.fontUi
                    font.pointSize: 10
                    // Web pages only: a README is someone else's (steam://, file:// … would reach other apps).
                    onLinkActivated: link => { if (/^https:\/\//i.test(link)) Qt.openUrlExternally(link) }
                  }
                  Label {
                    visible: root.section === "details" && root.detail && root.detail.requires.length > 0
                    text: root.detail ? {{ tq "requires" }}.arg(root.detail.requires.join(", ")) : ""
                    color: Theme.fgMuted
                    wrapMode: Text.Wrap
                    Layout.fillWidth: true
                  }
                  Label {
                    visible: root.section === "details" && root.detail && root.detail.required_by.length > 0
                    text: root.detail ? {{ tq "required_by" }}.arg(root.detail.required_by.join(", ")) : ""
                    color: Theme.fgMuted
                    wrapMode: Text.Wrap
                    Layout.fillWidth: true
                  }
                  Label {
                    visible: root.section === "details" && root.detail && root.detail.hardware !== ""
                    text: root.detail ? {{ tq "for" }}.arg(root.detail.hardware) + (root.detail.applies ? "" : "  —  " + {{ tq "not_here" }}) : ""
                    color: root.detail && !root.detail.applies ? Theme.warning : Theme.fgMuted
                    wrapMode: Text.Wrap
                    Layout.fillWidth: true
                  }

                  // What it can do: the capabilities, the risky ones marked.
                  Label {
                    visible: root.section === "can" && root.detail && (root.detail.origin === "available" || (root.detail.origin === "community" && !root.detail.enabled))
                    text: {{ tq "install_note" }}
                    color: Theme.warning
                  }
                  Label {
                    visible: root.section === "can" && root.detail && root.detail.capabilities.some(c => c.risk === "root")
                    text: {{ tq "root_note" }}
                    color: Theme.danger
                    wrapMode: Text.Wrap
                    Layout.fillWidth: true
                  }
                  Repeater {
                    model: root.section === "can" && root.detail ? root.detail.capabilities : []
                    RowLayout {
                      required property var modelData
                      Layout.fillWidth: true
                      spacing: 8
                      Rectangle {
                        width: 8; height: 8; radius: 4
                        Layout.alignment: Qt.AlignTop
                        Layout.topMargin: 5
                        color: parent.modelData.risk === "root" ? Theme.danger
                          : parent.modelData.risk === "high" ? Theme.warning : Theme.fgSubtle
                      }
                      Label {
                        text: root.capText(parent.modelData)
                        wrapMode: Text.WrapAnywhere
                        Layout.fillWidth: true
                      }
                    }
                  }

                  // Settings, changed in place (mazapan apply --set).
                  Label {
                    visible: root.section === "settings" && root.detail && root.detail.settings_error !== ""
                    text: root.detail ? root.detail.settings_error : ""
                    color: Theme.danger
                    wrapMode: Text.Wrap
                    Layout.fillWidth: true
                  }
                  Label {
                    visible: root.section === "settings" && root.detail && root.detail.settings.length === 0
                    text: {{ tq "no_settings" }}
                    color: Theme.fgSubtle
                  }
                  Repeater {
                    model: root.section === "settings" && root.detail ? root.detail.settings : []
                    ColumnLayout {
                      id: setting
                      required property var modelData
                      readonly property var s: modelData
                      readonly property bool editable: root.detail && root.detail.origin !== "available" && !root.busy
                      readonly property bool numeric: s.kind === "number" || s.kind === "integer"
                      // A number between two ends: a slider, applied once it rests.
                      readonly property bool ranged: numeric && s.min !== undefined && s.max !== undefined
                      property var dragged: undefined
                      Layout.fillWidth: true
                      spacing: 4

                      RowLayout {
                        Layout.fillWidth: true
                        Label { text: setting.s.label; font.bold: true }
                        Caption { text: setting.s.set ? "" : {{ tq "default" }}.arg(JSON.stringify(setting.s.default)) }
                        Item { Layout.fillWidth: true }
                        Button {
                          visible: setting.s.set && setting.editable
                          text: {{ tq "reset" }}
                          onClicked: root.reset(setting.s)
                        }
                      }
                      Label {
                        visible: setting.s.description !== ""
                        text: setting.s.description
                        color: Theme.fgMuted
                        wrapMode: Text.Wrap
                        Layout.fillWidth: true
                      }
                      Toggle {
                        visible: setting.s.kind === "switch"
                        enabled: setting.editable
                        checked: setting.s.value === true
                        onToggled: checked => root.set(setting.s, checked)
                      }
                      Row {
                        visible: setting.s.kind === "choice"
                        spacing: 6
                        Repeater {
                          model: setting.s.choices || []
                          Button {
                            required property var modelData
                            enabled: setting.editable
                            text: modelData === "" ? "—" : String(modelData)
                            primary: modelData === setting.s.value
                            onClicked: root.set(setting.s, modelData)
                          }
                        }
                      }
                      RowLayout {
                        visible: setting.ranged
                        Layout.fillWidth: true
                        spacing: 10
                        Slider {
                          Layout.fillWidth: true
                          enabled: setting.editable
                          readonly property real lo: setting.s.min ?? 0
                          to: (setting.s.max ?? 1) - lo
                          step: setting.s.step ?? (setting.s.kind === "integer" ? 1 : to / 100)
                          value: (setting.dragged ?? setting.s.value) - lo
                          onMoved: v => {
                            const n = lo + Math.round(v / step) * step
                            setting.dragged = setting.s.kind === "integer" ? Math.round(n) : Number(n.toFixed(6))
                            rest.restart()
                          }
                        }
                        Label { text: String(setting.dragged ?? setting.s.value) }
                        Timer {
                          id: rest
                          interval: 700
                          onTriggered: if (setting.dragged !== undefined && setting.dragged !== setting.s.value) root.set(setting.s, setting.dragged)
                        }
                      }
                      TextField {
                        visible: !setting.ranged && setting.s.kind !== "switch" && setting.s.kind !== "choice" && setting.s.kind !== "table"
                        enabled: setting.editable
                        Layout.fillWidth: true
                        text: typeof setting.s.value === "object" ? JSON.stringify(setting.s.value) : String(setting.s.value)
                        placeholder: root.range(setting.s)
                        onAccepted: root.set(setting.s, text)
                      }
                      // A table: edited in config.toml, shown here.
                      Label {
                        visible: setting.s.kind === "table"
                        text: JSON.stringify(setting.s.value) + "   " + {{ tq "in_config" }}
                        color: Theme.fgMuted
                        wrapMode: Text.WrapAnywhere
                        Layout.fillWidth: true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
