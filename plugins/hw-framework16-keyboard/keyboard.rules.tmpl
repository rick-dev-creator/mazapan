# Generated by mazapan (plugin {{ plugin }}): the Framework 16 keyboard's
# raw HID (32ac:0012) given to whoever is logged in at the machine, for its
# RGB lighting (qmk_hid, VIA in a browser). mazapan* files come after
# systemd's 73-seat-late.rules, which hands uaccess devices to the session:
# so this does it too.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="32ac", ATTRS{idProduct}=="0012", MODE="0660", TAG+="uaccess", TAG+="seat", RUN{builtin}+="uaccess"
