#!/bin/sh
# Generated by myarch (plugin {{ plugin }}): the default apps. For each
# kind of file or link: the one set in the plugin's settings when it's
# installed; else, only where there's no default or it's an app that's
# gone, the first installed of the usual ones. A default chosen in an app
# ("make Firefox my browser") stays.

dirs="${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share"

# An app is there: its desktop file is, anywhere applications are.
has() {
  [ -n "$1" ] || return 1
  old=$IFS; IFS=:
  for d in $dirs; do
    if [ -f "$d/applications/$1" ]; then IFS=$old; return 0; fi
  done
  IFS=$old
  return 1
}

# The default someone chose for a type: in mimeapps.list's
# [Default Applications] (what xdg-mime default and apps write), never
# the guess from what's installed.
list="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"
chosen_for() {
  [ -f "$list" ] || return 0
  sed -n '/^\[Default Applications\]/,/^\[/p' "$list" | grep -m1 "^$1=" | cut -d= -f2 | cut -d';' -f1
}

# kind CHOSEN "CANDIDATES…" MIME…
kind() {
  chosen=$1 candidates=$2
  shift 2
  if [ -n "$chosen" ]; then
    has "$chosen" || return 0
    app=$chosen force=1
  else
    app=
    for c in $candidates; do
      if has "$c"; then app=$c; break; fi
    done
    [ -n "$app" ] || return 0
    force=0
  fi
  for m in "$@"; do
    now=$(chosen_for "$m")
    if [ "$force" = 1 ] || ! has "$now"; then
      [ "$now" = "$app" ] || xdg-mime default "$app" "$m"
    fi
  done
}

kind {{ shq settings.browser }} "chromium.desktop firefox.desktop org.mozilla.firefox.desktop brave-browser.desktop google-chrome.desktop" \
  x-scheme-handler/http x-scheme-handler/https text/html application/xhtml+xml
kind {{ shq settings.files }} "org.gnome.Nautilus.desktop thunar.desktop org.kde.dolphin.desktop pcmanfm.desktop" \
  inode/directory
kind {{ shq settings.pdf }} "org.gnome.Papers.desktop org.gnome.Evince.desktop okularApplication_pdf.desktop org.pwmt.zathura.desktop chromium.desktop firefox.desktop" \
  application/pdf
kind {{ shq settings.images }} "org.gnome.Loupe.desktop org.gnome.eog.desktop imv.desktop gimp.desktop" \
  image/png image/jpeg image/gif image/webp image/avif image/bmp image/tiff image/svg+xml image/heif
kind {{ shq settings.video }} "io.github.celluloid_player.Celluloid.desktop mpv.desktop vlc.desktop org.gnome.Totem.desktop" \
  video/mp4 video/x-matroska video/webm video/quicktime video/x-msvideo video/mpeg video/ogg
kind {{ shq settings.audio }} "io.github.celluloid_player.Celluloid.desktop mpv.desktop vlc.desktop" \
  audio/mpeg audio/ogg audio/flac audio/x-wav audio/mp4 audio/aac audio/opus
kind {{ shq settings.text }} "org.gnome.TextEditor.desktop code-oss.desktop dev.zed.Zed.desktop nvim.desktop" \
  text/plain
kind {{ shq settings.email }} "org.mozilla.Thunderbird.desktop thunderbird.desktop" \
  x-scheme-handler/mailto
# Documents, spreadsheets, presentations: LibreOffice's, when it's there.
kind "" "libreoffice-writer.desktop" application/vnd.oasis.opendocument.text application/msword \
  application/vnd.openxmlformats-officedocument.wordprocessingml.document application/rtf
kind "" "libreoffice-calc.desktop" application/vnd.oasis.opendocument.spreadsheet application/vnd.ms-excel \
  application/vnd.openxmlformats-officedocument.spreadsheetml.sheet text/csv
kind "" "libreoffice-impress.desktop" application/vnd.oasis.opendocument.presentation application/vnd.ms-powerpoint \
  application/vnd.openxmlformats-officedocument.presentationml.presentation
kind "" "org.gnome.FileRoller.desktop" application/zip application/x-tar application/x-7z-compressed \
  application/gzip application/x-xz application/x-bzip2 application/vnd.rar application/zstd
true
