-- Generated by mazapan (plugin {{ plugin }}): the browser and the files,
-- one key each: their window when it's open, else opened.
{{- if settings.browser_key != "" }}
hl.bind({{ lq settings.browser_key }}, hl.dsp.exec_cmd("sh ~/.local/share/mazapan/bin/launch-or-focus browser"))
{{- end }}
{{- if settings.files_key != "" }}
hl.bind({{ lq settings.files_key }}, hl.dsp.exec_cmd("sh ~/.local/share/mazapan/bin/launch-or-focus files"))
{{- end }}
