// Generated by mazapan (plugin {{ plugin }}).
//
// The polkit agent: when an app needs rights it doesn't have (mount a
// disk, change the time, install something), polkit asks here for the
// password. What's asked for and by what, said plainly; a wrong password
// shakes and lets you try again; Esc or Cancel refuses. Without an agent
// those requests fail without a word.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import Quickshell.Services.Polkit
import qs
import "../components/kit"

Item {
  id: root

  // A panel by contract (see shell.qml): polkit opens it, not a key;
  // SUPER + Q (or the shell's close) refuses it, like Esc.
  readonly property bool open: win.visible
  function toggle() {}
  function close() {
    if (agent.flow) agent.flow.cancelAuthenticationRequest()
  }

  readonly property var flow: agent.flow
  property bool wrong: false

  PolkitAgent {
    id: agent
    // A path of our own on the bus; polkit takes one agent per session.
    path: "/org/mazapan/PolkitAgent"
  }

  // A new request: a clean field; a failed attempt: said, and the field
  // ready again.
  Connections {
    target: root.flow
    ignoreUnknownSignals: true
    function onAuthenticationFailed() {
      root.wrong = true
      field.text = ""
      shake.restart()
    }
    function onIsResponseRequiredChanged() { root.refocus() }
  }
  onFlowChanged: {
    wrong = false
    field.text = ""
    // Where it shows is decided once: it doesn't follow the pointer.
    if (flow) screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    refocus()
  }

  // The keys go to the field when it wants an answer, else to the card
  // (while PAM checks, or a fingerprint reader waits): Esc always refuses.
  function refocus() {
    Qt.callLater(() => {
      if (!flow) return
      if (flow.isResponseRequired) field.focusInput()
      else card.forceActiveFocus()
    })
  }

  function submit() {
    if (!flow || !flow.isResponseRequired) return
    wrong = false
    flow.submit(field.text)
    field.text = "" // never kept
  }

  // Asked of the shell (a health check): is this the session's agent?
  IpcHandler {
    target: "polkit"
    function registered(): bool { return agent.isRegistered }
  }

  property var screenAtOpen: Quickshell.screens[0]

  PanelWindow {
    id: win
    visible: !!root.flow && !root.flow.isCompleted
    screen: root.screenAtOpen
    anchors { top: true; bottom: true; left: true; right: true }
    color: Qt.alpha(Theme.bg, 0.55)
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q refuses it rather than closing the app
    // behind it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-polkit"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    // A click outside the card does nothing: this needs an answer.
    MouseArea { anchors.fill: parent }

    Rectangle {
      id: card
      anchors.centerIn: parent
      width: 440
      implicitHeight: body.implicitHeight + 40
      color: Theme.surfaceRaised
      border.color: root.wrong ? Theme.danger : Theme.border
      border.width: 1
      radius: Theme.radius

      transform: Translate { id: nudge; x: 0 }
      SequentialAnimation {
        id: shake
        NumberAnimation { target: nudge; property: "x"; to: -10; duration: 50 }
        NumberAnimation { target: nudge; property: "x"; to: 10; duration: 70 }
        NumberAnimation { target: nudge; property: "x"; to: -6; duration: 60 }
        NumberAnimation { target: nudge; property: "x"; to: 0; duration: 50 }
      }

      Keys.onEscapePressed: root.close()

      ColumnLayout {
        id: body
        x: 20
        y: 20
        width: parent.width - 40
        spacing: 12

        RowLayout {
          spacing: 12
          Glyph {
            text: String.fromCodePoint(0xF033E) // lock
            color: Theme.accentText
            font.pointSize: 22
            Layout.alignment: Qt.AlignTop
          }
          ColumnLayout {
            Layout.fillWidth: true
            spacing: 4
            Label {
              text: {{ tq "title" }}
              font.bold: true
              font.pointSize: 12
            }
            // What polkit says the app wants (in the app's words).
            Label {
              text: root.flow ? root.flow.message : ""
              color: Theme.fgMuted
              wrapMode: Text.Wrap
              Layout.fillWidth: true
              Layout.preferredWidth: 0
            }
            Caption {
              text: root.flow ? root.flow.actionId : ""
              elide: Text.ElideMiddle
              Layout.fillWidth: true
            }
          }
        }

        // Whose password: the only one, or pick among several.
        Flow {
          visible: !!root.flow && root.flow.identities.length > 1
          Layout.fillWidth: true
          spacing: 6
          Repeater {
            model: root.flow ? root.flow.identities : []
            Button {
              required property var modelData
              text: String(modelData.displayName || modelData.name || modelData)
              primary: root.flow && root.flow.selectedIdentity === modelData
              onClicked: root.flow.selectedIdentity = modelData
            }
          }
        }
        Caption {
          visible: !!root.flow && root.flow.identities.length === 1
          text: root.flow && root.flow.identities.length === 1
            ? {{ tq "as" }}.arg(String(root.flow.identities[0].displayName || root.flow.identities[0].name || ""))
            : ""
        }

        Label {
          visible: text !== ""
          // PAM's plain "Password:" says nothing the field doesn't (in the
          // person's language); anything else (a PIN, a token) is shown.
          text: root.flow && root.flow.inputPrompt && !/^\s*password:?\s*$/i.test(root.flow.inputPrompt) ? root.flow.inputPrompt : ""
          color: Theme.fgMuted
        }
        TextField {
          id: field
          Layout.fillWidth: true
          enabled: !!root.flow && root.flow.isResponseRequired
          echoMode: root.flow && root.flow.responseVisible ? TextInput.Normal : TextInput.Password
          placeholder: {{ tq "password" }}
          onAccepted: root.submit()
          Keys.onEscapePressed: root.close()
        }

        // A fingerprint reader's "place your finger", or what went wrong.
        Label {
          visible: text !== ""
          text: root.wrong ? {{ tq "wrong" }}
            : root.flow && root.flow.supplementaryMessage ? root.flow.supplementaryMessage : ""
          color: root.wrong || (root.flow && root.flow.supplementaryIsError) ? Theme.danger : Theme.fgMuted
          wrapMode: Text.Wrap
          Layout.fillWidth: true
          Layout.preferredWidth: 0
        }

        RowLayout {
          Layout.fillWidth: true
          spacing: 8
          Item { Layout.fillWidth: true }
          Button {
            text: {{ tq "cancel" }}
            onClicked: root.close()
          }
          Button {
            text: {{ tq "authenticate" }}
            primary: true
            enabled: !!root.flow && root.flow.isResponseRequired
            onClicked: root.submit()
          }
        }
      }
    }
  }
}
