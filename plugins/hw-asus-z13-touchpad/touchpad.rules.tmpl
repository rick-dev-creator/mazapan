# (0b05:1a30) has its touchpad marked external, so libinput's
# disable-while-typing doesn't pair it with the keyboard and keyboard flex
# taps it, jumping the cursor. Marked internal; after systemd's
# 70-touchpad.rules, which mazapan* files come after.
ACTION=="add|change", KERNEL=="event*", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1a30", ENV{ID_INPUT_TOUCHPAD}=="1", ENV{ID_INPUT_TOUCHPAD_INTEGRATION}="internal"
