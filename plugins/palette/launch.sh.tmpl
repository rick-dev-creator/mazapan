# Generated by mazapan (plugin {{ plugin }}): launch NAME [--in TERMINAL] -- COMMAND…
# starts an app for the palette, and says so when it didn't: its program
# (or the terminal it opens in) isn't there, or it quit with an error at
# once. --in: a terminal app (Neovim, btop), opened in that terminal (a
# shell command, as the palette's setting has it).
name=$1
shift
term=
if [ "$1" = --in ]; then term=$2; shift 2; fi
[ "$1" = -- ] && shift
[ $# -gt 0 ] || exit 2

say() { notify-send -a Mazapan -u critical -i dialog-error -- "$1" "$2" >/dev/null 2>&1; }
failed=$(printf {{ shq (t "launch.failed") }} "$name")

# What's missing is said by its name: the terminal, or the app's program.
if [ -n "$term" ] && ! command -v "${term%% *}" >/dev/null 2>&1; then
  say "$failed" "$(printf {{ shq (t "launch.no_terminal") }} "${term%% *}")"
  exit 127
fi
if ! command -v "$1" >/dev/null 2>&1; then
  say "$failed" "$(printf {{ shq (t "launch.missing") }} "$1")"
  exit 127
fi

# Its own session, so it outlives the palette; what it prints goes nowhere
# (an app left running can print for days).
if [ -n "$term" ]; then
  setsid sh -c "$term \"\$@\"" sh "$@" </dev/null >/dev/null 2>&1 &
else
  setsid "$@" </dev/null >/dev/null 2>&1 &
fi
pid=$!

# Gone with an error within two seconds: it didn't start. Gone without
# one is fine (an app already open takes the request and leaves).
n=0
while [ "$n" -lt 20 ] && kill -0 "$pid" 2>/dev/null; do
  sleep 0.1
  n=$((n + 1))
done
kill -0 "$pid" 2>/dev/null && exit 0
wait "$pid"
code=$?
[ "$code" -eq 0 ] && exit 0
say "$failed" "$(printf {{ shq (t "launch.quit") }} "$code" "$*")"
exit "$code"
