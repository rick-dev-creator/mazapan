// Generated by mazapan (plugin {{ plugin }}): the command palette (panel).
//
// One place for everything: installed apps, open windows, every plugin's
// actions and settings, and the catalog's apps not installed yet. Opened
// with nothing typed: your apps first (the ones you open most), the open
// windows, a tile for each place (Apps, Updates, Settings…) and the
// computer's power. Typing finds everything, in sections (the best match,
// Apps, Windows, Actions, Settings, Not installed); the filters above
// narrow it (ctrl ←→). Every row says what ↵ does to it ("Open",
// "Switch to", "Install…"), the panel beside it says what it is, and what
// ↵ starts answers: an app that doesn't open says why.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property string query: ""
  property int current: 0
  property string message: ""
  // all, app, window, action, setting, install: what the list shows.
  property string filter: "all"
  // An action that asks twice: which one is waiting for its second ↵.
  property string armed: ""
  property double armedAt: 0

  readonly property bool showCommands: {{ settings.show_commands }}
  // Shell commands, the user's own quoting kept; never empty.
  readonly property string terminal: {{ json settings.terminal }}.trim() || "xdg-terminal-exec"
  readonly property string terminalHold: {{ json settings.terminal_hold }}.trim() || "xdg-terminal-exec --hold"
  readonly property string launcher: Quickshell.env("HOME") + "/.local/share/mazapan/bin/palette-launch"
  // Every plugin's actions, rendered by the core.
  readonly property var actions: {{ json actions }}
  // Read at start: the list of apps fills in in the background.
  readonly property var apps: DesktopEntries.applications.values

  // What there is, taken when the palette opens: window titles change all
  // the time (spinners, tickers), and a list that moves under your cursor
  // makes ↵ run something you didn't pick.
  property var snapshot: []
  // Where it opens: it stays there while you type.
  property var screenAtOpen: null

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    // The catalog's apps: which are installed, and the rest to install.
    if (actions.some(a => a.plugin === "apps")) catalogProbe.running = true
    if (canProjects && !projectsProbe.running) projectsProbe.running = true
    updatesSeen.reload()
    recentFile.reload()
    // Windows opened since the bar started may lack their class until
    // Quickshell asks Hyprland again.
    Hyprland.refreshToplevels()
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    snapshot = candidates()
    query = ""
    filter = "all"
    current = 0
    message = ""
    field.text = ""
    open = true
    Qt.callLater(() => field.forceActiveFocus())
  }

  // The apps finish loading in the background: take them in, the first
  // time only (a query typed meanwhile keeps its results).
  onAppsChanged: if (open && query === "") snapshot = candidates()

  function close() {
    open = false
  }

  // --- what there is ---------------------------------------------------------

  // A shell word, quoted only when it has to be.
  function word(s) {
    return /^[\w@%+=:,./-]+$/.test(s) ? s : "'" + s.replace(/'/g, "'\\''") + "'"
  }

  // "SUPER + ALT + left" -> "SUPER + ALT + ←": keys as they look.
  readonly property var keyNames: ({ left: "←", right: "→", up: "↑", down: "↓", Return: "↵", space: "Space", equal: "=", minus: "-", Tab: "⇥" })
  function pretty(key) {
    return key.split(" + ").map(k => keyNames[k] ?? k).join(" + ")
  }

  function address(t) {
    const a = String(t.address)
    return a.startsWith("0x") ? a : "0x" + a
  }

  function iconFor(name) {
    return name ? Quickshell.iconPath(name, true) : ""
  }

  function actionItem(a) {
    const kind = a.setting ? "setting" : a.run ? "action" : "key"
    return {
      kind: kind, glyph: a.glyph || (kind === "setting" ? "󰒓" : kind === "key" ? "󰌌" : "󰘳"), icon: "",
      title: a.name, label: a.label || a.name, detail: a.label ? a.name : "", plugin: a.plugin, setting: a.key_setting || "",
      place: a.home > 0 && !!a.label,
      command: a.run || "", searchable: true, key: a.key || "", words: a.keywords || "", confirm: !!a.confirm,
      argv: !a.run ? null : a.terminal ? ["sh", "-c", `${terminalHold} sh -c ${word(a.run)}`] : ["sh", "-c", a.run],
    }
  }

  // Plain data, no live objects: every candidate knows the command it
  // shows and runs it exactly.
  function candidates() {
    const out = []
    for (const t of Hyprland.toplevels.values) {
      const cls = (t.lastIpcObject && t.lastIpcObject.class) || (t.wayland && t.wayland.appId) || ""
      // Through hypr-base's mazapan_go_to_window: a minimized window comes
      // to the workspace you're on rather than showing the one it waits on.
      const cmd = `hyprctl eval 'mazapan_go_to_window("${address(t)}")'`
      const e = cls ? DesktopEntries.heuristicLookup(cls) : null
      const where = !t.workspace ? "" : t.workspace.name === "special:minimized" ? {{ tq "minimized" }}
        : {{ tq "workspace" }}.arg(t.workspace.name)
      out.push({
        kind: "window", glyph: "󰖯", icon: e ? iconFor(e.icon) : "", title: t.title || cls,
        detail: [e ? e.name : cls, where].filter(x => x).join(" · "),
        // Found by title, class and workspace; not by its command, which
        // is the same for every window but the address.
        command: cmd, searchable: false, key: "", words: cls,
        argv: ["sh", "-c", cmd],
      })
    }
    for (const a of actions) out.push(actionItem(a))
    for (const e of apps) {
      if (e.noDisplay) continue
      const args = Array.from(e.command || [])
      if (args.length === 0) continue
      const shown = (e.runInTerminal ? terminal + " " : "") + args.map(word).join(" ")
      out.push({
        kind: "app", glyph: "󰀻", icon: iconFor(e.icon), id: e.id, title: e.name,
        detail: e.genericName || e.comment || "", terminalApp: e.runInTerminal, categories: Array.from(e.categories || []),
        command: e.workingDirectory ? `cd ${word(e.workingDirectory)} && ${shown}` : shown, searchable: true, key: "",
        words: [e.genericName, e.comment].concat(Array.from(e.keywords || []), Array.from(e.categories || [])).join(" "),
        // Through the launcher: it says so when the app doesn't open.
        argv: ["sh", launcher, e.name].concat(e.runInTerminal ? ["--in", terminal] : [], ["--"], args),
        cwd: e.workingDirectory || "",
      })
    }
    return out
  }

  // --- what you open most ----------------------------------------------------

  // Apps by desktop id: how many times, and when last (ms).
  property var recent: ({})
  FileView {
    id: recentFile
    path: Quickshell.env("HOME") + "/.local/state/mazapan/palette/recent.json"
    printErrors: false
    atomicWrites: true
    onLoaded: { try { root.recent = JSON.parse(text()) || {} } catch (e) { root.recent = {} } }
    onLoadFailed: root.recent = {}
  }
  function opened(id) {
    const r = Object.assign({}, recent)
    const was = r[id] || { n: 0, t: 0 }
    r[id] = { n: was.n + 1, t: Date.now() }
    recent = r
    recentFile.setText(JSON.stringify(r))
  }
  // Often, and lately: a week ago counts half.
  function frecency(id) {
    const r = recent[id]
    return r ? r.n / (1 + (Date.now() - r.t) / (7 * 86400000)) : 0
  }

  // --- the first screen ------------------------------------------------------

  readonly property bool home: open && query.trim() === "" && filter === "all"
  readonly property int appColumns: 6
  readonly property int tileColumns: 4
  readonly property var snapshotApps: snapshot.filter(c => c.kind === "app").concat(cliItems)
  // Your apps: the ones opened most; before there are any, the ones you
  // chose (the catalog's), then the everyday kinds (a browser, a terminal,
  // files, an editor…) over the system's own tools and demos.
  readonly property var everyday: ({ WebBrowser: 6, TerminalEmulator: 5, FileManager: 5, TextEditor: 4, IDE: 4, Office: 4,
                                     Email: 4, Chat: 3, InstantMessaging: 3, Graphics: 2, AudioVideo: 2, Game: 2 })
  function usual(c) {
    let best = catalogByDesktop[c.id] ? 3 : 0
    for (const k of c.categories || []) best = Math.max(best, (everyday[k] || 0) + (catalogByDesktop[c.id] ? 3 : 0))
    return best
  }
  readonly property var homeApps: snapshotApps.slice().sort((a, b) =>
    (frecency(b.id) - frecency(a.id)) || (usual(b) - usual(a)) || a.title.localeCompare(b.title)).slice(0, appColumns)
  readonly property var homeWindows: snapshot.filter(c => c.kind === "window").slice(0, 4)
  // A plugin's way in, in the order they ask for; then the computer's power.
  readonly property var tiles: actions.filter(a => a.home > 0 && a.run).sort((x, y) => x.home - y.home).map(a => actionItem(a))
  readonly property var systemItems: actions.filter(a => a.plugin === "power" && a.run).map(a => actionItem(a))

  // How many updates there are, as the updates panel last saw (on a tile).
  property int updatesCount: 0
  FileView {
    id: updatesSeen
    path: Quickshell.env("HOME") + "/.local/state/mazapan/updates/last.json"
    printErrors: false
    onLoaded: {
      try {
        const d = JSON.parse(text())
        root.updatesCount = (d.packages || []).length + (d.flatpaks || []).length
      } catch (e) { root.updatesCount = 0 }
    }
    onLoadFailed: root.updatesCount = 0
  }

  // The catalog (mazapan apps list): what's installed and what isn't.
  property var catalog: []
  Process {
    id: catalogProbe
    command: ["mazapan", "apps", "list", "--json"]
    stdout: StdioCollector {
      onStreamFinished: {
        try { root.catalog = JSON.parse(text).apps || [] } catch (e) {}
      }
    }
  }
  // An installed app's catalog entry, by its desktop id: "See it in Apps".
  readonly property var catalogByDesktop: {
    const m = {}
    for (const a of catalog) if (a.installed && a.desktop) m[a.desktop.replace(/\.desktop$/, "")] = a.id
    return m
  }
  // Installed programs without a launcher (lazygit, gh): opened in a
  // terminal that stays, so they're found as installed, not missing.
  readonly property var cliItems: catalog.filter(a => a.installed && a.command).map(a => ({
    kind: "app", glyph: "󰆍", icon: "", id: "catalog:" + a.id, title: a.name, detail: a.description,
    terminalApp: true, categories: [], catalogId: a.id,
    command: terminalHold + " " + a.command, searchable: true, key: "", words: a.name + " " + a.category,
    argv: ["sh", launcher, a.name, "--in", terminalHold, "--", a.command], cwd: "",
  }))
  readonly property var installItems: catalog.filter(a => !a.installed).map(a => ({
    kind: "install", glyph: "󰏔", icon: "", title: a.name, detail: a.description, from: a.kind || "",
    command: `qs ipc -c mazapan call mazapan open apps ${a.id}`, searchable: false, key: "", catalogId: a.id,
    words: a.name + " " + a.category, argv: ["qs", "ipc", "-c", "mazapan", "call", "mazapan", "open", "apps", a.id],
  }))

  // The Learn plugin's lessons (learn/lessons.json): found as lessons, and
  // beside the actions they teach (their recording in the panel).
  property var learn: null
  FileView {
    id: lessonsFile
    path: Quickshell.env("HOME") + "/.config/quickshell/mazapan/learn/lessons.json"
    printErrors: false
    watchChanges: true
    onFileChanged: reload()
    onLoaded: { try { root.learn = JSON.parse(text()) } catch (e) { root.learn = null } }
    onLoadFailed: root.learn = null
  }
  readonly property var lessons: learn ? learn.lessons || [] : []
  function mediaOf(l) {
    return l && learn ? "file://" + learn.media + "/" + l.id + ".webp" : ""
  }
  readonly property var lessonItems: lessons.map(l => ({
    kind: "lesson", glyph: "󰑴", icon: "", title: l.title, detail: l.topic + " · " + {{ tq "lesson_seconds" }}.arg(Math.round(l.length)),
    command: `qs ipc -c mazapan call mazapan open learn ${l.id}`, searchable: false, key: "", lesson: l.id,
    words: l.why + " " + l.steps.map(s => s.what + " " + s.keys).join(" "),
    argv: ["qs", "ipc", "-c", "mazapan", "call", "mazapan", "open", "learn", l.id],
  }))
  // The lesson that teaches an action (by the setting its key comes from).
  function lessonFor(c) {
    if (!c) return null
    if (c.kind === "lesson") return lessons.find(l => l.id === c.lesson) ?? null
    if (!c.setting) return null
    return lessons.find(l => (l.links || []).some(k => k.plugin === c.plugin && k.setting === c.setting)) ?? null
  }
  readonly property var selectedLesson: lessonFor(selected)
  function openLesson(l) {
    if (!l) return
    close()
    Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "open", "learn", l.id])
  }

  // Projects agents worked in lately (the agent plugin's): its editor and
  // the agent's last conversation there, again.
  readonly property bool canProjects: {{ if (under "~/.local/share/mazapan/bin/agent-open").size > 0 }}true{{ else }}false{{ end }}
  property var projects: []
  Process {
    id: projectsProbe
    command: ["mazapan", "agents", "projects", "--json", "--days", "60"]
    stdout: StdioCollector {
      onStreamFinished: { try { root.projects = JSON.parse(text).projects || [] } catch (e) {} }
    }
  }
  readonly property var projectItems: projects.map(p => ({
    kind: "project", glyph: "󰉋", icon: "", title: p.name,
    detail: p.path.replace(Quickshell.env("HOME"), "~") + " · " + p.agent + " · " + new Date(p.last).toLocaleDateString(Qt.locale("{{ lang }}"), "d MMM"),
    command: "", searchable: false, key: "", words: p.path + " " + p.agent,
    argv: ["sh", Quickshell.env("HOME") + "/.local/share/mazapan/bin/agent-open", p.path, p.agent],
  }))

  // --- finding ---------------------------------------------------------------

  // How well q (lowercase) fits text: its letters in order, better when
  // together, at the start of words, or at the very start; letters far
  // apart count less. -1: it doesn't.
  function fit(q, text) {
    text = text.toLowerCase()
    let at = 0, prev = -1, score = 0
    for (const ch of q) {
      const i = text.indexOf(ch, at)
      if (i < 0) return -1
      const atWord = i === 0 || /[\s\-_:·./]/.test(text[i - 1])
      score += 1
      if (prev >= 0 && i === prev + 1) score += 5
      // A gap costs, less when it lands on a word's start ("vsc": Visual
      // Studio Code).
      else if (prev >= 0) score -= (atWord ? 0.1 : 0.3) * (i - prev - 1)
      if (atWord) score += 3
      prev = i
      at = i + 1
    }
    if (text.startsWith(q)) score += 12
    else if (text.includes(q)) score += 8
    // The letters are picked up greedily, so a whole word further on can
    // lose to scattered letters before it: score every exact occurrence as
    // the block it is, and keep the best.
    for (let i = text.indexOf(q); i >= 0; i = text.indexOf(q, i + 1)) {
      const atWord = i === 0 || /[\s\-_:·./]/.test(text[i - 1])
      score = Math.max(score, q.length + 5 * (q.length - 1) + (atWord ? 3 : 0) + (i === 0 ? 12 : 8))
    }
    return score - text.length * 0.01
  }

  // Every word of the query has to fit somewhere: the title counts most.
  // Installed things come before the ones to install, at the same fit.
  function rank(q, list) {
    const terms = q.toLowerCase().split(/\s+/).filter(t => t !== "")
    const scored = []
    for (const c of list) {
      let total = 0
      for (const term of terms) {
        // A place's own short name ("Wallpaper" for the wallpaper picker)
        // counts as its title: typed, the place comes before the actions
        // that merely start with the same word.
        const best = Math.max(fit(term, c.title), (c.place ? fit(term, c.label) : -1), fit(term, c.detail + " " + c.words) * 0.6, (c.searchable ? fit(term, c.command) * 0.5 : -1), fit(term, c.key) * 0.5)
        // Letters strewn across a description aren't a match at all.
        if (best < 1.75 * term.length) { total = -1; break }
        total += best
      }
      if (total >= 0) {
        if (c.kind === "install") total *= 0.8
        else if (c.kind === "app") total += frecency(c.id)
        scored.push([total, c])
      }
    }
    scored.sort((a, b) => b[0] - a[0])
    // Letters scattered across unrelated words aren't a match worth
    // showing next to a real one.
    const floor = scored.length > 0 ? scored[0][0] * 0.5 : 0
    return scored.filter(s => s[0] >= floor).map(s => s[1])
  }

  // "? question": asked to a coding agent, answered in a card (the agent plugin's).
  readonly property bool canAsk: {{ if (under "~/.config/quickshell/mazapan/panels/ask.qml").size > 0 }}true{{ else }}false{{ end }}
  function askItem(q) {
    return {
      kind: "ask", glyph: "󰚩", icon: "", title: q === "" ? {{ tq "ask.empty" }} : {{ tq "ask" }}.arg(q), detail: "", command: "", searchable: false, key: "", words: "",
      // To the Ask card, through the agent plugin's script (a request file: an argument's brackets are qs ipc's).
      argv: q === "" ? null : ["sh", "-c", 'MAZAPAN_ASK="$1" exec sh "$HOME/.local/share/mazapan/bin/agent-ask"', "ask", q],
    }
  }

  // The filters, and the section each kind is shown in (in this order).
  readonly property var filters: ["all", "app", "window", "action", "setting", "install"].concat(lessons.length > 0 ? ["learn"] : [])
  function filterName(f) {
    return ({ all: {{ tq "f.all" }}, app: {{ tq "f.app" }}, window: {{ tq "f.window" }}, action: {{ tq "f.action" }},
              setting: {{ tq "f.setting" }}, install: {{ tq "f.install" }}, learn: {{ tq "f.learn" }} })[f]
  }
  function filterOf(kind) {
    return kind === "key" || kind === "project" ? "action" : kind === "lesson" ? "learn" : kind
  }
  readonly property var sectionOrder: ["app", "window", "action", "key", "project", "setting", "lesson", "install"]
  function sectionName(kind) {
    return ({ best: {{ tq "sec.best" }}, app: {{ tq "sec.app" }}, window: {{ tq "sec.window" }}, action: {{ tq "sec.action" }},
              key: {{ tq "sec.key" }}, project: {{ tq "sec.project" }}, setting: {{ tq "sec.setting" }}, lesson: {{ tq "sec.lesson" }},
              install: {{ tq "sec.install" }} })[kind]
  }

  // What ↵ does to it, said on its row, in the footer and on the panel's button.
  function verb(c) {
    if (!c) return ""
    switch (c.kind) {
    case "app": case "project": return {{ tq "verb.open" }}
    case "window": return {{ tq "verb.switch" }}
    case "setting": return {{ tq "verb.change" }}
    case "install": return {{ tq "verb.install" }}
    case "ask": return {{ tq "verb.ask" }}
    case "lesson": return {{ tq "verb.watch" }}
    case "key": return {{ tq "verb.press" }}.arg(pretty(c.key))
    }
    return {{ tq "verb.run" }}
  }

  // Everything the query finds, best first, before a filter narrows it.
  readonly property string typed: query.startsWith(">") ? query.slice(1).trim() : query.trim()
  readonly property var found: {
    if (!open || typed === "") return []
    return rank(typed, snapshot.concat(cliItems, projectItems, lessonItems, installItems))
  }
  readonly property var counts: {
    const n = { all: found.length, app: 0, window: 0, action: 0, setting: 0, install: 0, learn: 0 }
    for (const c of found) n[filterOf(c.kind)]++
    return n
  }
  // "> " is the Actions filter, as it always was.
  readonly property string shownFilter: query.startsWith(">") ? "action" : filter
  // The Apps filter with nothing typed: every app, as a grid.
  readonly property bool appGrid: open && typed === "" && shownFilter === "app"

  // What ↑↓ and ↵ go through, in the order shown.
  readonly property var results: {
    if (!open) return []
    if (canAsk && query.startsWith("?")) return [askItem(query.slice(1).trim())]
    if (home) return homeApps.concat(homeWindows, tiles, systemItems)
    if (typed === "") {
      // A filter with nothing typed: all of that kind, by name.
      const pool = shownFilter === "install" ? installItems : shownFilter === "learn" ? lessonItems
        : snapshot.concat(shownFilter === "app" ? cliItems : []).filter(c => filterOf(c.kind) === shownFilter)
      return shownFilter === "learn" ? pool : pool.slice().sort((a, b) => a.title.localeCompare(b.title))
    }
    const list = shownFilter === "all" ? found : found.filter(c => filterOf(c.kind) === shownFilter)
    if (list.length === 0) return []
    // The best match on its own, then each kind in its section.
    const rest = list.slice(1)
    const out = [list[0]]
    for (const k of sectionOrder) for (const c of rest) if (c.kind === k) out.push(c)
    return out
  }
  // The list as drawn: each section's title before its first row.
  readonly property var rows: {
    if (home || appGrid) return []
    const out = []
    let last = ""
    results.forEach((c, i) => {
      const sec = typed === "" || c.kind === "ask" ? "" : i === 0 ? "best" : c.kind
      if (sec !== "" && sec !== last) out.push({ header: true, title: sectionName(sec) })
      last = sec
      out.push({ header: false, item: c, at: i })
    })
    return out
  }
  // An app not installed found, and no installed one: said, so it's clear
  // which is which.
  readonly property bool noAppFound: typed.length > 1 && shownFilter === "all"
    && found.some(c => c.kind === "install") && !found.some(c => c.kind === "app")

  onResultsChanged: current = Math.min(current, Math.max(0, results.length - 1))
  readonly property var selected: results[current] ?? null

  // --- doing -----------------------------------------------------------------

  function run(i) {
    const c = results[i]
    if (!c) return
    if (!c.argv) {
      if (c.kind === "ask") return
      message = {{ tq "key_only" }}.arg(root.pretty(c.key))
      return
    }
    // Power off, reboot…: ↵ once more on the same one, a moment later.
    if (c.confirm && (armed !== c.command || Date.now() - armedAt > 4000)) {
      armed = c.command
      armedAt = Date.now()
      message = {{ tq "confirm" }}.arg(c.title)
      return
    }
    armed = ""
    if (c.kind === "app") opened(c.id)
    close()
    Quickshell.execDetached(c.cwd ? { command: c.argv, workingDirectory: c.cwd } : c.argv)
  }

  function inApps(c) {
    const id = c.catalogId || catalogByDesktop[c.id]
    if (!id) return
    close()
    Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "open", "apps", id])
  }

  function copy(i) {
    const c = results[i]
    if (!c || c.command === "") return
    Quickshell.execDetached(["wl-copy", "--", c.command])
    message = {{ tq "copied" }}.arg(c.command)
  }

  function setFilter(f) {
    if (query.startsWith(">")) field.text = query.slice(1).trimStart()
    filter = f
    current = 0
    message = ""
    list.positionViewAtBeginning()
    grid.positionViewAtBeginning()
  }
  function cycleFilter(by) {
    const at = filters.indexOf(shownFilter)
    setFilter(filters[(at + by + filters.length) % filters.length])
  }

  function reveal() {
    if (appGrid) grid.positionViewAtIndex(current, GridView.Contain)
    else if (!home) {
      const r = rows.findIndex(x => !x.header && x.at === current)
      // A section's first row brings its title into view too.
      if (r < 0) return
      if (r > 0 && rows[r - 1].header) list.positionViewAtIndex(r - 1, ListView.Contain)
      list.positionViewAtIndex(r, ListView.Contain)
    }
  }
  function move(by) {
    if (results.length === 0) return
    current = Math.max(0, Math.min(results.length - 1, current + by))
    reveal()
  }

  // The first screen and the apps grid in rows: up and down go to the row
  // above or below, to the column nearest.
  readonly property var gridRows: {
    const out = []
    const chunk = (from, n, cols) => { for (let i = 0; i < n; i += cols) out.push(Array.from({ length: Math.min(cols, n - i) }, (_, k) => from + i + k)) }
    if (appGrid) chunk(0, results.length, appColumns)
    else if (home) {
      chunk(0, homeApps.length, appColumns)
      chunk(homeApps.length, homeWindows.length, 1)
      chunk(homeApps.length + homeWindows.length, tiles.length, tileColumns)
      chunk(homeApps.length + homeWindows.length + tiles.length, systemItems.length, systemItems.length || 1)
    }
    return out
  }
  function vertical(dir) {
    if (!home && !appGrid) return move(dir)
    const r = gridRows.findIndex(row => row.includes(current))
    if (r < 0) return
    const next = gridRows[r + dir]
    if (!next) return
    const col = gridRows[r].indexOf(current) / Math.max(1, gridRows[r].length - 1)
    current = next[Math.round(col * (next.length - 1))]
    reveal()
  }
  // Tab: the next section's first row (on the first screen and the grid: one on).
  function nextSection(dir) {
    if (home || appGrid || rows.length === 0) return move(dir)
    const starts = rows.filter((x, r) => !x.header && (r === 0 || rows[r - 1].header)).map(x => x.at)
    if (starts.length < 2) return move(dir)
    const at = dir > 0 ? starts.find(s => s > current) : starts.slice().reverse().find(s => s < current)
    current = at ?? (dir > 0 ? starts[0] : starts[starts.length - 1])
    reveal()
  }

  // --- pieces ----------------------------------------------------------------

  // A thing's picture: its icon when it has one, else its kind's glyph.
  component Pic: Item {
    property var item: null
    property real size: 28
    property bool chosen: false
    implicitWidth: size
    implicitHeight: size
    Image {
      id: img
      anchors.fill: parent
      source: parent.item && parent.item.icon ? parent.item.icon : ""
      sourceSize: Qt.size(parent.size * 2, parent.size * 2)
      asynchronous: true
      visible: status === Image.Ready
      // Not installed: its picture dimmed, as its row.
      opacity: parent.item && parent.item.kind === "install" ? 0.5 : 1
    }
    Text {
      textFormat: Text.PlainText
      anchors.centerIn: parent
      visible: img.status !== Image.Ready
      text: parent.item ? parent.item.glyph : ""
      color: parent.chosen ? Theme.accentText : Theme.fgMuted
      font.family: Theme.fontMono
      font.pointSize: parent.size * 0.45
    }
  }

  // What ↵ does, at a row's right: filled on the chosen one.
  component Verb: Rectangle {
    property string text: ""
    property bool chosen: false
    implicitWidth: verbLabel.implicitWidth + 14
    implicitHeight: verbLabel.implicitHeight + 6
    radius: Theme.radius
    color: chosen ? Theme.accent : "transparent"
    border.width: 1
    border.color: chosen ? Theme.accent : Theme.border
    Text {
      id: verbLabel
      textFormat: Text.PlainText
      anchors.centerIn: parent
      text: parent.text + (parent.chosen ? "  ↵" : "")
      color: parent.chosen ? Theme.accentFg : Theme.fgMuted
      font.family: Theme.fontMono
      font.pointSize: 8.5
    }
  }

  component KeyChip: Rectangle {
    property string key: ""
    visible: key !== ""
    implicitWidth: keyText.implicitWidth + 12
    implicitHeight: keyText.implicitHeight + 6
    color: Theme.bg
    border.width: 1
    border.color: Theme.border
    radius: Theme.radius
    Text {
      id: keyText
      textFormat: Text.PlainText
      anchors.centerIn: parent
      text: root.pretty(parent.key)
      color: Theme.fgMuted
      font.family: Theme.fontMono
      font.pointSize: 8.5
    }
  }

  // An app as a tile: its icon over its name (the first screen, the grid).
  component AppTile: Rectangle {
    id: appTile
    property var item: null
    property int at: -1
    readonly property bool chosen: at === root.current
    implicitHeight: 78
    radius: Theme.radius
    color: chosen ? Theme.accentDeep : appArea.containsMouse ? Theme.surface : "transparent"
    border.width: 1
    border.color: chosen ? Theme.accent : "transparent"
    ColumnLayout {
      anchors.centerIn: parent
      width: parent.width - 8
      spacing: 6
      Pic { item: appTile.item; size: 36; chosen: appTile.chosen; Layout.alignment: Qt.AlignHCenter }
      Text {
        textFormat: Text.PlainText
        Layout.fillWidth: true
        horizontalAlignment: Text.AlignHCenter
        text: appTile.item ? appTile.item.title : ""
        elide: Text.ElideRight
        color: Theme.fg
        font.family: Theme.fontMono
        font.pointSize: 8.5
      }
    }
    // Opens in a terminal: said, so a terminal opening isn't a surprise.
    Text {
      visible: appTile.item && appTile.item.terminalApp
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.margins: 4
      text: ""
      color: Theme.fgSubtle
      font.family: Theme.fontMono
      font.pointSize: 8
    }
    MouseArea {
      id: appArea
      anchors.fill: parent
      hoverEnabled: true
      cursorShape: Qt.PointingHandCursor
      onClicked: { root.current = appTile.at; root.run(appTile.at) }
    }
  }

  component Section: Text {
    textFormat: Text.PlainText
    color: Theme.fgMuted
    font.family: Theme.fontMono
    font.pointSize: 8
    font.letterSpacing: 1
    font.capitalization: Font.AllUppercase
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    readonly property real screenHeight: screen ? screen.height : 1080
    implicitWidth: Math.max(560, Math.min(920, (screen ? screen.width : 1280) * 0.62))
    implicitHeight: card.implicitHeight
    anchors.top: true
    margins.top: Math.round(screenHeight * 0.12)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-palette"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    // The list's height: the same while typing, so the card doesn't jump.
    readonly property real bodyHeight: Math.min(440, screenHeight * 0.55)
    // Room for the panel beside the list.
    readonly property bool sidePanel: width >= 760

    Rectangle {
      id: card
      width: parent.width
      implicitHeight: body.implicitHeight
      color: Theme.surfaceRaised
      border.color: Theme.accent
      border.width: 1
      radius: Theme.radius

      ColumnLayout {
        id: body
        width: parent.width
        spacing: 0

        // The prompt.
        RowLayout {
          Layout.fillWidth: true
          Layout.margins: 14
          spacing: 10

          Text {
            textFormat: Text.PlainText
            text: "❯"
            color: Theme.accentText
            font.family: Theme.fontMono
            font.pointSize: 13
          }

          TextInput {
            id: field
            Layout.fillWidth: true
            color: Theme.fg
            selectionColor: Theme.selection
            font.family: Theme.fontMono
            font.pointSize: 13
            clip: true
            onTextChanged: {
              root.query = text
              root.current = 0
              root.message = ""
              list.positionViewAtBeginning()
              grid.positionViewAtBeginning()
            }

            Keys.onPressed: event => {
              const ctrl = event.modifiers & Qt.ControlModifier
              const grids = root.home || root.appGrid
              if (event.key === Qt.Key_Escape) root.close()
              else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) root.run(root.current)
              else if (ctrl && event.key === Qt.Key_Right) root.cycleFilter(1)
              else if (ctrl && event.key === Qt.Key_Left) root.cycleFilter(-1)
              else if (event.key === Qt.Key_Down || (ctrl && (event.key === Qt.Key_J || event.key === Qt.Key_N))) root.vertical(1)
              else if (event.key === Qt.Key_Up || (ctrl && (event.key === Qt.Key_K || event.key === Qt.Key_P))) root.vertical(-1)
              else if (event.key === Qt.Key_Tab) root.nextSection(1)
              else if (event.key === Qt.Key_Backtab) root.nextSection(-1)
              // Nothing typed: left and right go across the tiles.
              else if (grids && event.key === Qt.Key_Right) root.move(1)
              else if (grids && event.key === Qt.Key_Left) root.move(-1)
              else if (event.key === Qt.Key_PageDown) root.move(8)
              else if (event.key === Qt.Key_PageUp) root.move(-8)
              else if (ctrl && event.key === Qt.Key_C && field.selectedText === "") root.copy(root.current)
              else return
              event.accepted = true
            }

            Text {
              textFormat: Text.PlainText
              visible: field.text === ""
              anchors.fill: parent
              verticalAlignment: Text.AlignVCenter
              text: {{ tq "placeholder" }}
              color: Theme.fgSubtle
              font: field.font
            }
          }
          KeyChip { key: "esc" }
        }

        Rule { Layout.fillWidth: true }

        // The filters: what the list shows, with how many each finds.
        Flow {
          Layout.fillWidth: true
          Layout.margins: 10
          Layout.leftMargin: 14
          Layout.rightMargin: 14
          spacing: 6
          Repeater {
            model: root.filters
            Rectangle {
              id: chip
              required property string modelData
              readonly property bool on: root.shownFilter === modelData
              implicitWidth: chipText.implicitWidth + 20
              implicitHeight: chipText.implicitHeight + 8
              radius: Theme.radius
              color: on ? Theme.accentDeep : chipArea.containsMouse ? Theme.surface : "transparent"
              border.width: 1
              border.color: on ? Theme.accent : Theme.border
              Text {
                id: chipText
                textFormat: Text.PlainText
                anchors.centerIn: parent
                text: root.filterName(chip.modelData) + (root.typed !== "" ? "  " + root.counts[chip.modelData] : "")
                color: chip.on ? Theme.fg : Theme.fgMuted
                font.family: Theme.fontMono
                font.pointSize: 9
              }
              MouseArea {
                id: chipArea
                anchors.fill: parent
                hoverEnabled: true
                cursorShape: Qt.PointingHandCursor
                onClicked: { root.setFilter(chip.modelData); field.forceActiveFocus() }
              }
            }
          }
        }

        Rule { Layout.fillWidth: true }

        // Nothing typed: your apps, the open windows, the places, the power.
        ColumnLayout {
          visible: root.home
          Layout.fillWidth: true
          Layout.margins: 14
          spacing: 8

          Section { text: {{ tq "home.apps" }}; visible: root.homeApps.length > 0 }
          GridLayout {
            visible: root.homeApps.length > 0
            Layout.fillWidth: true
            columns: root.appColumns
            columnSpacing: 4
            rowSpacing: 4
            Repeater {
              model: root.home ? root.homeApps : []
              AppTile {
                required property var modelData
                required property int index
                Layout.fillWidth: true
                Layout.preferredWidth: 1
                item: modelData
                at: index
              }
            }
          }

          Section { text: {{ tq "windows" }}; visible: root.homeWindows.length > 0; Layout.topMargin: 6 }
          Repeater {
            model: root.home ? root.homeWindows : []
            Rectangle {
              id: winRow
              required property var modelData
              required property int index
              readonly property int at: root.homeApps.length + index
              readonly property bool chosen: at === root.current
              Layout.fillWidth: true
              implicitHeight: 36
              radius: Theme.radius
              color: chosen ? Theme.accentDeep : winArea.containsMouse ? Theme.surface : "transparent"
              border.width: 1
              border.color: chosen ? Theme.accent : "transparent"
              RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 10
                anchors.rightMargin: 10
                spacing: 10
                Pic { item: winRow.modelData; size: 20; chosen: winRow.chosen }
                Text {
                  textFormat: Text.PlainText
                  Layout.fillWidth: true
                  text: winRow.modelData.title
                  elide: Text.ElideRight
                  color: Theme.fg
                  font.family: Theme.fontMono
                  font.pointSize: 9.5
                }
                Text {
                  textFormat: Text.PlainText
                  text: winRow.modelData.detail
                  color: Theme.fgMuted
                  font.family: Theme.fontMono
                  font.pointSize: 8.5
                }
              }
              MouseArea {
                id: winArea
                anchors.fill: parent
                hoverEnabled: true
                onClicked: { root.current = winRow.at; root.run(winRow.at) }
              }
            }
          }

          Section { text: {{ tq "home.places" }}; visible: root.tiles.length > 0; Layout.topMargin: 6 }
          GridLayout {
            visible: root.tiles.length > 0
            Layout.fillWidth: true
            columns: root.tileColumns
            rowSpacing: 6
            columnSpacing: 6
            Repeater {
              model: root.home ? root.tiles : []
              Rectangle {
                id: tile
                required property var modelData
                required property int index
                readonly property int at: root.homeApps.length + root.homeWindows.length + index
                readonly property bool chosen: at === root.current
                Layout.fillWidth: true
                Layout.preferredWidth: 1
                implicitHeight: 34
                radius: Theme.radius
                color: chosen ? Theme.accentDeep : tileArea.containsMouse ? Theme.surface : Theme.bg
                border.width: 1
                border.color: chosen ? Theme.accent : Theme.border
                RowLayout {
                  anchors.fill: parent
                  anchors.leftMargin: 10
                  anchors.rightMargin: 8
                  spacing: 8
                  Text { textFormat: Text.PlainText; text: tile.modelData.glyph; color: tile.chosen ? Theme.accentText : Theme.fgMuted; font.family: Theme.fontMono; font.pointSize: 11 }
                  Text {
                    textFormat: Text.PlainText
                    Layout.fillWidth: true
                    text: tile.modelData.label
                    elide: Text.ElideRight
                    color: Theme.fg
                    font.family: Theme.fontMono
                    font.pointSize: 9
                  }
                  // How many updates there are, on the Updates tile.
                  Rectangle {
                    visible: tile.modelData.plugin === "updates" && root.updatesCount > 0
                    implicitWidth: Math.max(18, badge.implicitWidth + 10)
                    implicitHeight: 16
                    radius: 8
                    color: Theme.accent
                    Text {
                      id: badge
                      textFormat: Text.PlainText
                      anchors.centerIn: parent
                      text: root.updatesCount
                      color: Theme.accentFg
                      font.family: Theme.fontMono
                      font.pointSize: 7.5
                      font.bold: true
                    }
                  }
                }
                MouseArea {
                  id: tileArea
                  anchors.fill: parent
                  hoverEnabled: true
                  onClicked: { root.current = tile.at; root.run(tile.at) }
                }
              }
            }
          }

          RowLayout {
            visible: root.systemItems.length > 0
            Layout.fillWidth: true
            Layout.topMargin: 4
            spacing: 6
            Repeater {
              model: root.home ? root.systemItems : []
              Rectangle {
                id: power
                required property var modelData
                required property int index
                readonly property int at: root.homeApps.length + root.homeWindows.length + root.tiles.length + index
                readonly property bool chosen: at === root.current
                Layout.fillWidth: true
                Layout.preferredWidth: 1
                implicitHeight: 30
                radius: Theme.radius
                color: chosen ? Theme.accentDeep : powerArea.containsMouse ? Theme.surface : "transparent"
                border.width: 1
                border.color: chosen ? Theme.accent : Theme.border
                RowLayout {
                  anchors.centerIn: parent
                  spacing: 6
                  Text { textFormat: Text.PlainText; text: power.modelData.glyph; color: power.chosen ? Theme.accentText : Theme.fgMuted; font.family: Theme.fontMono; font.pointSize: 10 }
                  Text { textFormat: Text.PlainText; text: power.modelData.label; color: Theme.fg; font.family: Theme.fontMono; font.pointSize: 8.5 }
                }
                MouseArea {
                  id: powerArea
                  anchors.fill: parent
                  hoverEnabled: true
                  onClicked: { root.current = power.at; root.run(power.at) }
                }
              }
            }
          }
        }

        // The Apps filter with nothing typed: every app, as a grid.
        GridView {
          id: grid
          visible: root.appGrid
          Layout.fillWidth: true
          Layout.margins: 10
          Layout.preferredHeight: win.bodyHeight
          clip: true
          cellWidth: Math.floor(width / root.appColumns)
          cellHeight: 84
          boundsBehavior: Flickable.StopAtBounds
          model: root.appGrid ? root.results : []
          delegate: Item {
            required property var modelData
            required property int index
            width: grid.cellWidth
            height: grid.cellHeight
            AppTile {
              anchors.fill: parent
              anchors.margins: 2
              item: parent.modelData
              at: parent.index
            }
          }
        }

        // Typed, or a filter: the list in sections, the chosen one beside it.
        RowLayout {
          visible: !root.home && !root.appGrid
          Layout.fillWidth: true
          Layout.preferredHeight: win.bodyHeight
          Layout.minimumHeight: win.bodyHeight
          spacing: 0

          Item {
            Layout.fillWidth: true
            Layout.fillHeight: true

            ListView {
              id: list
              anchors.fill: parent
              anchors.margins: 6
              clip: true
              model: root.rows
              boundsBehavior: Flickable.StopAtBounds
              header: Item {
                width: list.width
                height: root.noAppFound ? noApp.implicitHeight + 16 : 0
                visible: root.noAppFound
                Rectangle {
                  id: noApp
                  x: 4
                  y: 8
                  width: parent.width - 8
                  implicitHeight: noAppText.implicitHeight + 16
                  color: "transparent"
                  border.width: 1
                  border.color: Theme.border
                  radius: Theme.radius
                  Text {
                    id: noAppText
                    textFormat: Text.PlainText
                    anchors.centerIn: parent
                    width: parent.width - 20
                    wrapMode: Text.Wrap
                    text: {{ tq "none.app" }}.arg(root.typed)
                    color: Theme.fgMuted
                    font.family: Theme.fontMono
                    font.pointSize: 9
                  }
                }
              }

              delegate: Item {
                id: row
                required property var modelData
                readonly property var item: modelData.header ? null : modelData.item
                readonly property bool chosen: !modelData.header && modelData.at === root.current
                width: list.width
                height: modelData.header ? 30 : 48

                Section {
                  visible: row.modelData.header
                  anchors.left: parent.left
                  anchors.leftMargin: 10
                  anchors.bottom: parent.bottom
                  anchors.bottomMargin: 6
                  text: row.modelData.header ? row.modelData.title : ""
                }

                Rectangle {
                  visible: !row.modelData.header
                  anchors.fill: parent
                  radius: Theme.radius
                  color: row.chosen ? Theme.accentDeep : area.containsMouse ? Theme.surface : "transparent"
                  border.width: 1
                  border.color: row.chosen ? Theme.accent : "transparent"

                  RowLayout {
                    anchors.fill: parent
                    anchors.leftMargin: 10
                    anchors.rightMargin: 10
                    spacing: 12

                    Pic { item: row.item; size: 28; chosen: row.chosen }

                    ColumnLayout {
                      Layout.fillWidth: true
                      spacing: 2
                      Text {
                        textFormat: Text.PlainText
                        Layout.fillWidth: true
                        text: row.item ? row.item.title : ""
                        color: row.item && row.item.kind === "install" ? Theme.fgMuted : Theme.fg
                        font.family: Theme.fontMono
                        font.pointSize: 10
                        elide: Text.ElideRight
                      }
                      Text {
                        textFormat: Text.PlainText
                        Layout.fillWidth: true
                        visible: text !== ""
                        text: !row.item ? ""
                          : row.item.kind === "app" && row.item.terminalApp ? [row.item.detail, {{ tq "in_terminal" }}].filter(x => x).join(" · ")
                          : row.item.detail
                        color: Theme.fgMuted
                        font.family: Theme.fontMono
                        font.pointSize: 8.5
                        elide: Text.ElideRight
                      }
                    }

                    KeyChip { key: row.item && row.item.kind !== "key" ? row.item.key : "" }
                    Verb { text: root.verb(row.item); chosen: row.chosen }
                  }

                  MouseArea {
                    id: area
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onClicked: { root.current = row.modelData.at; root.run(row.modelData.at) }
                  }
                }
              }
            }

            Text {
              textFormat: Text.PlainText
              visible: root.results.length === 0
              anchors.centerIn: parent
              width: parent.width - 40
              horizontalAlignment: Text.AlignHCenter
              wrapMode: Text.Wrap
              text: root.typed !== "" ? {{ tq "nothing" }}.arg(root.typed) : {{ tq "nothing.here" }}
              color: Theme.fgMuted
              font.family: Theme.fontMono
              font.pointSize: 10
            }
          }

          // The chosen one: what it is, where it opens, what it runs.
          Rectangle {
            visible: win.sidePanel && root.selected !== null && root.selected.kind !== "ask"
            Layout.fillHeight: true
            Layout.preferredWidth: 280
            color: "transparent"
            Rectangle { width: 1; height: parent.height; color: Theme.border }

            ColumnLayout {
              anchors.fill: parent
              anchors.margins: 16
              spacing: 12

              // The move it makes, recorded (its lesson's), looping.
              Rectangle {
                visible: root.selectedLesson !== null
                Layout.fillWidth: true
                Layout.preferredHeight: width * 9 / 16
                color: Theme.bg
                border.width: 1
                border.color: Theme.border
                AnimatedImage {
                  anchors.fill: parent
                  anchors.margins: 1
                  fillMode: Image.PreserveAspectFit
                  source: root.mediaOf(root.selectedLesson)
                  playing: root.open && root.selectedLesson !== null
                  cache: false
                }
              }

              RowLayout {
                spacing: 12
                Pic { item: root.selected; size: 44 }
                ColumnLayout {
                  Layout.fillWidth: true
                  spacing: 2
                  Text {
                    textFormat: Text.PlainText
                    Layout.fillWidth: true
                    text: root.selected ? root.selected.title : ""
                    wrapMode: Text.Wrap
                    maximumLineCount: 2
                    elide: Text.ElideRight
                    color: Theme.fg
                    font.family: Theme.fontMono
                    font.pointSize: 11
                    font.bold: true
                  }
                  Text {
                    textFormat: Text.PlainText
                    Layout.fillWidth: true
                    visible: text !== ""
                    text: root.selected ? root.selected.detail : ""
                    wrapMode: Text.Wrap
                    maximumLineCount: 3
                    elide: Text.ElideRight
                    color: Theme.fgMuted
                    font.family: Theme.fontMono
                    font.pointSize: 8.5
                  }
                }
              }

              // Facts, label and value: only the ones that apply.
              Repeater {
                model: {
                  const c = root.selected
                  if (!c) return []
                  const out = []
                  if (c.kind === "app") {
                    out.push([{{ tq "meta.state" }}, {{ tq "meta.installed" }}, Theme.success])
                    out.push([{{ tq "meta.opens" }}, c.terminalApp ? {{ tq "meta.terminal" }}.arg(root.terminal.split(" ")[0]) : {{ tq "meta.window" }}, Theme.fg])
                  } else if (c.kind === "install") {
                    out.push([{{ tq "meta.state" }}, {{ tq "meta.not_installed" }}, Theme.warning])
                    const from = ({ pacman: {{ tq "from.pacman" }}, flatpak: {{ tq "from.flatpak" }}, webapp: {{ tq "from.webapp" }}, vendor: {{ tq "from.vendor" }}, plugin: {{ tq "from.plugin" }} })[c.from]
                    if (from) out.push([{{ tq "meta.from" }}, from, Theme.fg])
                  } else if (c.kind === "window") {
                    out.push([{{ tq "meta.state" }}, {{ tq "meta.open_window" }}, Theme.success])
                  }
                  if (c.key) out.push([{{ tq "meta.key" }}, root.pretty(c.key), Theme.fg])
                  return out
                }
                RowLayout {
                  required property var modelData
                  Layout.fillWidth: true
                  Text { textFormat: Text.PlainText; text: modelData[0]; color: Theme.fgMuted; font.family: Theme.fontMono; font.pointSize: 8.5 }
                  Item { Layout.fillWidth: true }
                  Text { textFormat: Text.PlainText; text: modelData[1]; color: modelData[2]; font.family: Theme.fontMono; font.pointSize: 8.5 }
                }
              }

              // The command: what you'd type to do it yourself.
              Text {
                textFormat: Text.PlainText
                visible: root.showCommands && root.selected !== null && root.selected.command !== "" && root.selected.kind !== "install"
                Layout.fillWidth: true
                text: root.selected ? "$ " + root.selected.command : ""
                wrapMode: Text.WrapAnywhere
                maximumLineCount: 3
                elide: Text.ElideRight
                color: Theme.fgSubtle
                font.family: Theme.fontMono
                font.pointSize: 8
              }

              Item { Layout.fillHeight: true }

              Button {
                Layout.fillWidth: true
                visible: root.selected !== null && root.selected.argv !== null
                primary: true
                text: root.verb(root.selected) + "  ↵"
                onClicked: root.run(root.current)
              }
              Button {
                Layout.fillWidth: true
                visible: root.selected !== null && (!!root.selected.catalogId || (root.selected.kind === "app" && !!root.catalogByDesktop[root.selected.id]))
                text: root.selected && root.selected.kind === "install" ? {{ tq "btn.details" }} : {{ tq "btn.in_apps" }}
                onClicked: root.inApps(root.selected)
              }
              Button {
                Layout.fillWidth: true
                visible: root.selectedLesson !== null && root.selected.kind !== "lesson"
                text: {{ tq "btn.lesson" }}
                onClicked: root.openLesson(root.selectedLesson)
              }
              Button {
                Layout.fillWidth: true
                visible: root.selected !== null && root.selected.command !== "" && root.selected.kind !== "install" && root.selected.kind !== "lesson"
                text: {{ tq "btn.copy" }}
                onClicked: root.copy(root.current)
              }
            }
          }
        }

        Rule { Layout.fillWidth: true }

        // What ↵ does now, or what just happened; the keys.
        RowLayout {
          Layout.fillWidth: true
          Layout.margins: 10
          Layout.leftMargin: 14
          Layout.rightMargin: 14
          spacing: 16
          Caption {
            Layout.fillWidth: true
            elide: Text.ElideRight
            font.letterSpacing: 0
            text: root.message !== "" ? root.message
              // An action's name already says what it does ("Turn Wi-Fi on or off").
              : root.selected ? "↵ " + (["action", "setting"].includes(root.selected.kind) ? root.selected.title
                  : root.selected.kind === "key" ? root.verb(root.selected)
                  : root.verb(root.selected) + " " + (root.selected.label || root.selected.title))
              : {{ tq "hint.type" }}
            color: root.message !== "" ? Theme.accentText : Theme.fgMuted
          }
          Caption { font.letterSpacing: 0; text: {{ tq "hint.move" }} }
          Caption { font.letterSpacing: 0; text: {{ tq "hint.filter" }} }
          Caption { font.letterSpacing: 0; visible: root.canAsk; text: {{ tq "hints.ask" }} }
        }
      }
    }
  }
}
