// Generated by mazapan (plugin {{ plugin }}): the command palette (panel).
//
// One place for everything: open windows, installed apps, and every
// plugin's actions and keybindings (declared in their plugin.toml, so the
// list is always right). Each result shows the command it runs: you start
// by clicking, and end up knowing the command. ↑↓ to pick, ↵ to run,
// ctrl+c to copy the command; "> " searches only actions and keys.
// Opened with nothing typed it's the desktop's menu: a tile for each place
// (the actions plugins mark home: Apps, Updates, Settings…), the computer's
// power, and the open windows. What isn't installed is found too: the
// catalog's apps, as "Install …" (the Apps panel on that app).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property string query: ""
  property int current: 0
  property string message: ""
  // An action that asks twice: which one is waiting for its second ↵.
  property string armed: ""
  property double armedAt: 0

  readonly property bool showCommands: {{ settings.show_commands }}
  // Shell commands, the user's own quoting kept; never empty.
  readonly property string terminal: {{ json settings.terminal }}.trim() || "foot"
  readonly property string terminalHold: {{ json settings.terminal_hold }}.trim() || "foot --hold"
  // Every plugin's actions, rendered by the core.
  readonly property var actions: {{ json actions }}
  // Read at start: the list of apps fills in in the background.
  readonly property var apps: DesktopEntries.applications.values

  // What there is, taken when the palette opens: window titles change all
  // the time (spinners, tickers), and a list that moves under your cursor
  // makes ↵ run something you didn't pick.
  property var snapshot: []
  // Where it opens: it stays there while you type.
  property var screenAtOpen: null

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    // The catalog's apps not installed yet: found by typing, as "Install …".
    if (actions.some(a => a.plugin === "apps")) catalogProbe.running = true
    updatesSeen.reload()
    // Windows opened since the bar started may lack their class until
    // Quickshell asks Hyprland again.
    Hyprland.refreshToplevels()
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    snapshot = candidates()
    query = ""
    current = 0
    message = ""
    field.text = ""
    open = true
    Qt.callLater(() => field.forceActiveFocus())
  }

  // The apps finish loading in the background: take them in, the first
  // time only (a query typed meanwhile keeps its results).
  onAppsChanged: if (open && query === "") snapshot = candidates()

  function close() {
    open = false
  }

  // --- what there is ---------------------------------------------------------

  // A shell word, quoted only when it has to be.
  function word(s) {
    return /^[\w@%+=:,./-]+$/.test(s) ? s : "'" + s.replace(/'/g, "'\\''") + "'"
  }

  // "SUPER + ALT + left" -> "SUPER + ALT + ←": keys as they look.
  readonly property var keyNames: ({ left: "←", right: "→", up: "↑", down: "↓", Return: "↵", space: "Space", equal: "=", minus: "-", Tab: "⇥" })
  function pretty(key) {
    return key.split(" + ").map(k => keyNames[k] ?? k).join(" + ")
  }

  function address(t) {
    const a = String(t.address)
    return a.startsWith("0x") ? a : "0x" + a
  }

  // Plain data, no live objects: every candidate knows the command it
  // shows and runs it exactly (argv; cwd for apps with a Path=).
  function candidates() {
    const out = []
    for (const t of Hyprland.toplevels.values) {
      const cls = (t.lastIpcObject && t.lastIpcObject.class) || (t.wayland && t.wayland.appId) || ""
      const cmd = `hyprctl dispatch 'hl.dsp.focus({ window = "address:${address(t)}" })'`
      out.push({
        kind: "window", glyph: "󰖯", title: t.title || cls,
        detail: [cls, t.workspace ? {{ tq "workspace" }}.arg(t.workspace.name) : ""].filter(x => x).join(" · "),
        // Found by title, class and workspace; not by its command, which
        // is the same for every window but the address.
        command: cmd, searchable: false, key: "", words: cls,
        argv: ["sh", "-c", cmd],
      })
    }
    for (const a of actions) {
      out.push({
        kind: a.run ? "action" : "key", glyph: a.run ? (a.glyph || "󰘳") : "󰌌", title: a.name, confirm: !!a.confirm,
        detail: a.plugin, command: a.run || "", searchable: true, key: a.key || "", words: a.keywords || "",
        argv: !a.run ? null : a.terminal ? ["sh", "-c", `${terminalHold} sh -c ${word(a.run)}`] : ["sh", "-c", a.run],
      })
    }
    for (const e of apps) {
      if (e.noDisplay) continue
      const args = Array.from(e.command || [])
      // A terminal app (btop, htop…) needs a terminal to show up in.
      const cmd = (e.runInTerminal ? terminal + " " : "") + args.map(word).join(" ")
      out.push({
        kind: "app", glyph: "󰀻", title: e.name, detail: e.genericName || e.comment || "",
        command: e.workingDirectory ? `cd ${word(e.workingDirectory)} && ${cmd}` : cmd, searchable: true, key: "",
        words: [e.genericName, e.comment].concat(Array.from(e.keywords || []), Array.from(e.categories || [])).join(" "),
        argv: ["sh", "-c", cmd], cwd: e.workingDirectory || "",
      })
    }
    return out
  }

  // --- the first screen ------------------------------------------------------

  readonly property bool home: open && query.trim() === ""
  function actionItem(a, kind) {
    return {
      kind: kind, glyph: a.glyph || "󰘳", title: a.label || a.name, detail: a.label ? a.name : a.plugin,
      command: a.run || "", searchable: true, key: a.key || "", words: a.keywords || "", plugin: a.plugin, confirm: !!a.confirm,
      argv: !a.run ? null : a.terminal ? ["sh", "-c", `${terminalHold} sh -c ${word(a.run)}`] : ["sh", "-c", a.run],
    }
  }
  // A plugin's way in, in the order they ask for; then the computer's power.
  readonly property var tiles: actions.filter(a => a.home > 0 && a.run).sort((x, y) => x.home - y.home).map(a => actionItem(a, "home"))
  readonly property var systemItems: actions.filter(a => a.plugin === "power" && a.run).map(a => actionItem(a, "system"))
  readonly property var homeWindows: snapshot.filter(c => c.kind === "window")
  readonly property int homeOffset: tiles.length + systemItems.length
  readonly property int columns: 4

  // How many updates there are, as the updates panel last saw (on a tile).
  property int updatesCount: 0
  FileView {
    id: updatesSeen
    path: Quickshell.env("HOME") + "/.local/state/mazapan/updates/last.json"
    printErrors: false
    onLoaded: {
      try {
        const d = JSON.parse(text())
        root.updatesCount = (d.packages || []).length + (d.flatpaks || []).length
      } catch (e) { root.updatesCount = 0 }
    }
    onLoadFailed: root.updatesCount = 0
  }

  // The catalog's apps not installed (mazapan apps list), to install.
  property var catalog: []
  Process {
    id: catalogProbe
    command: ["mazapan", "apps", "list", "--json"]
    stdout: StdioCollector {
      onStreamFinished: {
        try { root.catalog = (JSON.parse(text).apps || []).filter(a => !a.installed) } catch (e) {}
      }
    }
  }
  readonly property var installItems: catalog.map(a => ({
    kind: "install", glyph: "󰏔", title: {{ tq "install" }}.arg(a.name), detail: a.description,
    command: `qs ipc -c mazapan call mazapan open apps ${a.id}`, searchable: false, key: "",
    words: a.name + " " + a.category, argv: ["qs", "ipc", "-c", "mazapan", "call", "mazapan", "open", "apps", a.id],
  }))

  // --- finding ---------------------------------------------------------------

  // How well q (lowercase) fits text: its letters in order, better when
  // together, at the start of words, or at the very start; letters far
  // apart count less. -1: it doesn't.
  function fit(q, text) {
    text = text.toLowerCase()
    let at = 0, prev = -1, score = 0
    for (const ch of q) {
      const i = text.indexOf(ch, at)
      if (i < 0) return -1
      const atWord = i === 0 || /[\s\-_:·./]/.test(text[i - 1])
      score += 1
      if (prev >= 0 && i === prev + 1) score += 5
      // A gap costs, less when it lands on a word's start ("vsc": Visual
      // Studio Code).
      else if (prev >= 0) score -= (atWord ? 0.1 : 0.3) * (i - prev - 1)
      if (atWord) score += 3
      prev = i
      at = i + 1
    }
    if (text.startsWith(q)) score += 12
    else if (text.includes(q)) score += 8
    // The letters are picked up greedily, so a whole word further on can
    // lose to scattered letters before it: score every exact occurrence as
    // the block it is, and keep the best.
    for (let i = text.indexOf(q); i >= 0; i = text.indexOf(q, i + 1)) {
      const atWord = i === 0 || /[\s\-_:·./]/.test(text[i - 1])
      score = Math.max(score, q.length + 5 * (q.length - 1) + (atWord ? 3 : 0) + (i === 0 ? 12 : 8))
    }
    return score - text.length * 0.01
  }

  // Every word of the query has to fit somewhere: the title counts most.
  function rank(q, list) {
    const terms = q.toLowerCase().split(/\s+/).filter(t => t !== "")
    const scored = []
    for (const c of list) {
      let total = 0
      for (const term of terms) {
        const best = Math.max(fit(term, c.title), fit(term, c.detail + " " + c.words) * 0.6, (c.searchable ? fit(term, c.command) * 0.5 : -1), fit(term, c.key) * 0.5)
        // Letters strewn across a description aren't a match at all.
        if (best < 1.75 * term.length) { total = -1; break }
        total += best
      }
      if (total >= 0) scored.push([total, c])
    }
    scored.sort((a, b) => b[0] - a[0])
    // Letters scattered across unrelated words aren't a match worth
    // showing next to a real one.
    const floor = scored.length > 0 ? scored[0][0] * 0.5 : 0
    return scored.filter(s => s[0] >= floor).map(s => s[1])
  }

  // "? question": asked to a coding agent, answered in a card (the agent plugin's).
  readonly property bool canAsk: {{ if (under "~/.config/quickshell/mazapan/panels/ask.qml").size > 0 }}true{{ else }}false{{ end }}
  function askItem(q) {
    return {
      kind: "ask", glyph: "󰚩", title: q === "" ? {{ tq "ask.empty" }} : {{ tq "ask" }}.arg(q), detail: "", command: "", searchable: false, key: "", words: "",
      // To the Ask card, through the agent plugin's script (a request file: an argument's brackets are qs ipc's).
      argv: q === "" ? null : ["sh", "-c", 'MAZAPAN_ASK="$1" exec sh "$HOME/.local/share/mazapan/bin/agent-ask"', "ask", q],
    }
  }

  readonly property var results: {
    if (!open) return []
    if (canAsk && query.startsWith("?")) return [askItem(query.slice(1).trim())]
    const onlyActions = query.startsWith(">")
    // Nothing typed: the first screen, in the order it's shown.
    if (home) return tiles.concat(systemItems, homeWindows)
    let list = snapshot.concat(installItems)
    if (onlyActions) list = list.filter(c => c.kind === "action" || c.kind === "key")
    const q = onlyActions ? query.slice(1).trim() : query.trim()
    if (q === "") {
      const order = { window: 0, action: 1, key: 2, app: 3 }
      return list.sort((a, b) => order[a.kind] - order[b.kind] || a.title.localeCompare(b.title))
    }
    return rank(q, list)
  }

  onResultsChanged: current = Math.min(current, Math.max(0, results.length - 1))

  // --- doing -----------------------------------------------------------------

  function run(i) {
    const c = results[i]
    if (!c) return
    if (!c.argv) {
      if (c.kind === "ask") return
      message = {{ tq "key_only" }}.arg(root.pretty(c.key))
      return
    }
    // Power off, reboot…: ↵ once more on the same one, a moment later.
    if (c.confirm && (armed !== c.command || Date.now() - armedAt > 4000)) {
      armed = c.command
      armedAt = Date.now()
      message = {{ tq "confirm" }}.arg(c.title)
      return
    }
    armed = ""
    close()
    Quickshell.execDetached(c.cwd ? { command: c.argv, workingDirectory: c.cwd } : c.argv)
  }

  function copy(i) {
    const c = results[i]
    if (!c || c.command === "") return
    Quickshell.execDetached(["wl-copy", "--", c.command])
    message = {{ tq "copied" }}.arg(c.command)
  }

  function move(by) {
    if (results.length === 0) return
    current = Math.max(0, Math.min(results.length - 1, current + by))
    if (!home) list.positionViewAtIndex(current, ListView.Contain)
    else if (current >= homeOffset) list.positionViewAtIndex(current - homeOffset, ListView.Contain)
  }

  // On the first screen up and down go by rows of tiles; the power row is
  // one row; the windows below it, one by one.
  function vertical(dir) {
    if (!home || current >= homeOffset) return move(dir)
    if (current < tiles.length) {
      const next = current + dir * columns
      if (next < 0) return
      current = next < tiles.length ? next : Math.min(tiles.length, results.length - 1)
    } else {
      // Up: the start of the tiles' last row; down: the first window.
      if (dir < 0) current = tiles.length > 0 ? Math.floor((tiles.length - 1) / columns) * columns : current
      else current = Math.min(homeOffset, results.length - 1)
    }
    if (current >= homeOffset) list.positionViewAtIndex(current - homeOffset, ListView.Contain)
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    readonly property real screenHeight: screen ? screen.height : 1080
    implicitWidth: Math.max(480, Math.min(780, (screen ? screen.width : 1280) * 0.6))
    implicitHeight: card.implicitHeight
    anchors.top: true
    margins.top: Math.round(screenHeight * 0.16)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-palette"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      width: parent.width
      implicitHeight: body.implicitHeight
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius

      ColumnLayout {
        id: body
        width: parent.width
        spacing: 0

        // The prompt.
        RowLayout {
          Layout.fillWidth: true
          Layout.margins: 14
          spacing: 10

          Text {
            textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
            text: "❯"
            color: Theme.accentText
            font.family: Theme.fontMono
            font.pointSize: 13
          }

          TextInput {
            id: field
            Layout.fillWidth: true
            color: Theme.fg
            selectionColor: Theme.selection
            font.family: Theme.fontMono
            font.pointSize: 13
            clip: true
            onTextChanged: {
              root.query = text
              root.current = 0
              root.message = ""
              list.positionViewAtBeginning()
            }

            Keys.onPressed: event => {
              const ctrl = event.modifiers & Qt.ControlModifier
              if (event.key === Qt.Key_Escape) root.close()
              else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) root.run(root.current)
              else if (event.key === Qt.Key_Down || (ctrl && (event.key === Qt.Key_J || event.key === Qt.Key_N))) root.vertical(1)
              else if (event.key === Qt.Key_Up || (ctrl && (event.key === Qt.Key_K || event.key === Qt.Key_P))) root.vertical(-1)
              else if (event.key === Qt.Key_Tab) root.move(1)
              else if (event.key === Qt.Key_Backtab) root.move(-1)
              // Nothing typed: left and right go across the tiles.
              else if (root.home && event.key === Qt.Key_Right) root.move(1)
              else if (root.home && event.key === Qt.Key_Left) root.move(-1)
              else if (event.key === Qt.Key_PageDown) root.move(8)
              else if (event.key === Qt.Key_PageUp) root.move(-8)
              else if (ctrl && event.key === Qt.Key_C && field.selectedText === "") root.copy(root.current)
              else return
              event.accepted = true
            }

            Text {
              textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
              visible: field.text === ""
              anchors.fill: parent
              verticalAlignment: Text.AlignVCenter
              text: {{ tq "placeholder" }}
              color: Theme.fgSubtle
              font: field.font
            }
          }
        }

        Rule { Layout.fillWidth: true }

        // Nothing typed: a tile for each place, the computer's power, then
        // the open windows (the list below).
        GridLayout {
          visible: root.home && root.tiles.length > 0
          Layout.fillWidth: true
          Layout.margins: 12
          columns: root.columns
          rowSpacing: 8
          columnSpacing: 8
          Repeater {
            model: root.home ? root.tiles : []
            Rectangle {
              id: tile
              required property var modelData
              required property int index
              readonly property bool chosen: index === root.current
              Layout.fillWidth: true
              Layout.preferredWidth: 1
              implicitHeight: 66
              radius: Theme.radius
              color: chosen ? Theme.surface : tileArea.containsMouse ? Qt.darker(Theme.surfaceRaised, 1.08) : Theme.bg
              border.width: 1
              border.color: chosen ? Theme.accent : Theme.border
              ColumnLayout {
                anchors.centerIn: parent
                width: parent.width - 12
                spacing: 4
                Text {
                  textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
                  text: tile.modelData.glyph
                  Layout.alignment: Qt.AlignHCenter
                  color: tile.chosen ? Theme.accentText : Theme.fgMuted
                  font.family: Theme.fontMono
                  font.pointSize: 16
                }
                Text {
                  textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
                  text: tile.modelData.title
                  Layout.fillWidth: true
                  horizontalAlignment: Text.AlignHCenter
                  elide: Text.ElideRight
                  color: Theme.fg
                  font.family: Theme.fontMono
                  font.pointSize: 9
                }
              }
              // How many updates there are, on the Updates tile.
              Rectangle {
                visible: tile.modelData.plugin === "updates" && root.updatesCount > 0
                anchors.top: parent.top
                anchors.right: parent.right
                anchors.margins: 6
                implicitWidth: Math.max(18, badge.implicitWidth + 10)
                implicitHeight: 18
                radius: 9
                color: Theme.accent
                Text {
                  textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
                  id: badge
                  anchors.centerIn: parent
                  text: root.updatesCount
                  color: Theme.accentFg
                  font.family: Theme.fontMono
                  font.pointSize: 8
                  font.bold: true
                }
              }
              MouseArea {
                id: tileArea
                anchors.fill: parent
                hoverEnabled: true
                onClicked: { root.current = tile.index; root.run(tile.index) }
              }
            }
          }
        }

        RowLayout {
          visible: root.home && root.systemItems.length > 0
          Layout.fillWidth: true
          Layout.leftMargin: 12
          Layout.rightMargin: 12
          Layout.bottomMargin: 10
          spacing: 8
          Repeater {
            model: root.home ? root.systemItems : []
            Rectangle {
              id: power
              required property var modelData
              required property int index
              readonly property int at: root.tiles.length + index
              readonly property bool chosen: at === root.current
              Layout.fillWidth: true
              Layout.preferredWidth: 1
              implicitHeight: 34
              radius: Theme.radius
              color: chosen ? Theme.surface : powerArea.containsMouse ? Qt.darker(Theme.surfaceRaised, 1.08) : "transparent"
              border.width: 1
              border.color: chosen ? Theme.accent : Theme.border
              RowLayout {
                anchors.centerIn: parent
                spacing: 6
                Text { textFormat: Text.PlainText; text: power.modelData.glyph; color: power.chosen ? Theme.accentText : Theme.fgMuted; font.family: Theme.fontMono; font.pointSize: 10 }
                Text { textFormat: Text.PlainText; text: power.modelData.title; color: Theme.fg; font.family: Theme.fontMono; font.pointSize: 9 }
              }
              MouseArea {
                id: powerArea
                anchors.fill: parent
                hoverEnabled: true
                onClicked: { root.current = power.at; root.run(power.at) }
              }
            }
          }
        }

        Caption {
          visible: root.home && root.homeWindows.length > 0
          Layout.leftMargin: 14
          Layout.bottomMargin: 4
          text: {{ tq "windows" }}
        }

        ListView {
          id: list
          Layout.fillWidth: true
          implicitHeight: Math.min(contentHeight, Math.min((root.home ? 5 : 9) * 46, win.screenHeight * 0.5))
          clip: true
          model: root.home ? root.homeWindows : root.results
          boundsBehavior: Flickable.StopAtBounds

          delegate: Rectangle {
            id: row
            required property var modelData
            required property int index
            // On the first screen the windows come after the tiles and the power row.
            readonly property int at: index + (root.home ? root.homeOffset : 0)
            readonly property bool chosen: at === root.current

            width: list.width
            height: 46
            color: chosen ? Theme.surface : area.containsMouse ? Qt.darker(Theme.surfaceRaised, 1.08) : "transparent"

            Rectangle {
              visible: row.chosen
              width: 2
              height: parent.height
              color: Theme.accent
            }

            RowLayout {
              anchors.fill: parent
              anchors.leftMargin: 14
              anchors.rightMargin: 14
              spacing: 12

              Text {
                textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
                text: row.modelData.glyph
                Layout.preferredWidth: 20
                horizontalAlignment: Text.AlignHCenter
                color: row.chosen ? Theme.accentText : Theme.fgMuted
                font.family: Theme.fontMono
                font.pointSize: 13
              }

              ColumnLayout {
                Layout.fillWidth: true
                Layout.preferredWidth: 1 // what's left after the key and kind
                spacing: 2

                RowLayout {
                  Layout.fillWidth: true
                  spacing: 8
                  // The title keeps its width; what's beside it gives way.
                  Text {
                    textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
                    id: titleText
                    text: row.modelData.title
                    color: Theme.fg
                    font.family: Theme.fontMono
                    font.pointSize: 10
                    elide: Text.ElideRight
                    Layout.minimumWidth: 0
                  }
                  Text {
                    textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
                    text: row.modelData.detail
                    color: Theme.fgSubtle
                    font.family: Theme.fontMono
                    font.pointSize: 8.5
                    elide: Text.ElideRight
                    // Only the room the title leaves.
                    Layout.fillWidth: true
                    Layout.preferredWidth: 0
                  }
                }

                // The command: what you'd type to do it yourself.
                Text {
                  textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
                  visible: root.showCommands && row.modelData.command !== ""
                  Layout.fillWidth: true
                  text: "$ " + row.modelData.command
                  color: row.chosen ? Theme.accentText : Theme.fgSubtle
                  font.family: Theme.fontMono
                  font.pointSize: 8.5
                  elide: Text.ElideMiddle
                }
              }

              // Its keybinding, when it has one.
              Rectangle {
                visible: row.modelData.key !== ""
                implicitWidth: keyText.implicitWidth + 12
                implicitHeight: keyText.implicitHeight + 6
                color: Theme.bg
                border.width: 1
                border.color: Theme.border
                radius: Theme.radius
                Text {
                  textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
                  id: keyText
                  anchors.centerIn: parent
                  text: root.pretty(row.modelData.key)
                  color: Theme.fgMuted
                  font.family: Theme.fontMono
                  font.pointSize: 8.5
                }
              }

              Text {
                textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
                text: {
                  switch (row.modelData.kind) {
                  case "window": return {{ tq "kind.window" }}
                  case "app": return {{ tq "kind.app" }}
                  case "key": return {{ tq "kind.key" }}
                  case "install": return {{ tq "kind.install" }}
                  case "ask": return {{ tq "kind.ask" }}
                  }
                  return {{ tq "kind.action" }}
                }
                color: Theme.fgSubtle
                font.family: Theme.fontMono
                font.pointSize: 8
                Layout.preferredWidth: 56
                horizontalAlignment: Text.AlignRight
              }
            }

            MouseArea {
              id: area
              anchors.fill: parent
              hoverEnabled: true
              onClicked: {
                root.current = row.at
                root.run(row.at)
              }
            }
          }
        }

        Text {
          textFormat: Text.PlainText // titles, names: from apps, windows, catalogs
          visible: root.results.length === 0 && root.query.trim() !== ""
          Layout.fillWidth: true
          Layout.margins: 14
          text: {{ tq "nothing" }}.arg(root.query.trim())
          color: Theme.fgMuted
          font.family: Theme.fontMono
          font.pointSize: 10
        }

        Rule { Layout.fillWidth: true }

        // What the keys do, or what just happened.
        RowLayout {
          Layout.fillWidth: true
          Layout.margins: 10
          Layout.leftMargin: 14
          Layout.rightMargin: 14
          Caption {
            Layout.fillWidth: true
            elide: Text.ElideRight
            // On a tile, its command: learned as it's picked.
            text: root.message !== "" ? root.message
              : root.home && root.showCommands && root.current < root.homeOffset && root.results[root.current] ? "$ " + root.results[root.current].command
              : root.canAsk ? {{ tq "hints" }} + "   " + {{ tq "hints.ask" }} : {{ tq "hints" }}
            color: root.message !== "" ? Theme.accentText : Theme.fgSubtle
          }
          Caption { text: root.results.length }
        }
      }
    }
  }
}
