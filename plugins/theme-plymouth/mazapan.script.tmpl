# Generated by mazapan (plugin {{ plugin }}): the boot screen in the theme
# ({{ theme.id }}), drawn from its colors: the name, brighter as the start
# goes on, and the disk's password, asked in the person's language.
#
# ASCII only: the initramfs's text renderer (label-freetype) draws nothing
# past it (an accent, a bullet), whatever the font.
Window.SetBackgroundTopColor({{ rgbf (c "bg") }});
Window.SetBackgroundBottomColor({{ rgbf (c "bg") }});

w = Window.GetWidth();
h = Window.GetHeight();

title.image = Image.Text("Mazapan", {{ rgbf (c "accent_text") }}, 1, "Sans Bold 26");
title.sprite = Sprite(title.image);
title.sprite.SetPosition(w / 2 - title.image.GetWidth() / 2, h / 2 - title.image.GetHeight() / 2 - 40, 1);

# The sprites, made once here: a variable first set inside a function is
# that function's own, and its sprite would be gone when the function ends.
ask = Sprite();
field = Sprite();
msg = Sprite();

# How far the start is: the name from dim to full (Plymouth's scripts draw
# no shapes, and a glyph for one isn't there).
title.sprite.SetOpacity(0.5);
fun progress_cb(duration, progress) {
  title.sprite.SetOpacity(0.5 + 0.5 * Math.Clamp(progress, 0, 1));
}
Plymouth.SetBootProgressFunction(progress_cb);

# The disk's password: what's asked in the person's words, a star per letter.
fun password_cb(prompt, bullets) {
  question = Image.Text({{ quote (t "password") }}, {{ rgbf (c "fg") }}, 1, "Sans 13");
  ask.SetImage(question);
  ask.SetPosition(w / 2 - question.GetWidth() / 2, h / 2 + 40, 3);
  ask.SetOpacity(1);
  dots = "";
  for (i = 0; i < bullets; i++) dots += "*";
  if (dots == "") dots = " ";
  typed = Image.Text(dots, {{ rgbf (c "accent_text") }}, 1, "Sans 16");
  field.SetImage(typed);
  field.SetPosition(w / 2 - typed.GetWidth() / 2, h / 2 + 75, 3);
  field.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(password_cb);

fun normal_cb() {
  ask.SetOpacity(0);
  field.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(normal_cb);

# Messages (a wrong password...), small, under the rest.
fun message_cb(text) {
  said = Image.Text(text, {{ rgbf (c "fg_muted") }}, 1, "Sans 11");
  msg.SetImage(said);
  msg.SetPosition(w / 2 - said.GetWidth() / 2, h / 2 + 115, 3);
}
Plymouth.SetMessageFunction(message_cb);
