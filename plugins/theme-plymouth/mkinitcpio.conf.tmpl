# Generated by mazapan (plugin {{ plugin }}): Plymouth in the initramfs,
# right after systemd (or udev), whatever else the hooks are. The old
# string form (HOOKS="base udev …") is made a list first, and plymouth
# isn't added twice.
[[ ${HOOKS@a} == *a* ]] || read -ra HOOKS <<<"$HOOKS"
_mazapan_hooks=()
for _h in "${HOOKS[@]}"; do
  [[ $_h == plymouth ]] && continue
  _mazapan_hooks+=("$_h")
  case $_h in systemd|udev) _mazapan_hooks+=(plymouth) ;; esac
done
HOOKS=("${_mazapan_hooks[@]}")
unset _mazapan_hooks _h
