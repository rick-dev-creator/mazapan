# Generated by mazapan (plugin {{ plugin }}): picks a color on screen.
# hyprpicker freezes every screen and waits for a click (Esc: none); the
# color is copied as CSS writes it ({{ settings.format }}) and said in a
# notification, with a swatch of it.
# One at a time: pressed again while picking, nothing more.
pgrep -u "$(id -u)" -x hyprpicker >/dev/null && exit 0
# -b: the color only, without its terminal colors; -r: every screen
# frozen. Its last line: the color (anything else it says comes before).
h=$(hyprpicker -b -r -f hex 2>/dev/null | tail -n 1)
h=$(printf %s "$h" | tr -d '#\r ' | tr A-F a-f)
case "$h" in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
  *) exit 0 ;;
esac

c=$(awk -v h="$h" -v f={{ shq settings.format }} '
  function hx(s) { return (index("0123456789abcdef", substr(s, 1, 1)) - 1) * 16 + index("0123456789abcdef", substr(s, 2, 1)) - 1 }
  BEGIN {
    r = hx(substr(h, 1, 2)); g = hx(substr(h, 3, 2)); b = hx(substr(h, 5, 2))
    if (f == "rgb") { printf "rgb(%d, %d, %d)", r, g, b; exit }
    if (f != "hsl") { printf "#%s", h; exit }
    r /= 255; g /= 255; b /= 255
    mx = r; if (g > mx) mx = g; if (b > mx) mx = b
    mn = r; if (g < mn) mn = g; if (b < mn) mn = b
    l = (mx + mn) / 2; d = mx - mn; hue = 0; s = 0
    if (d > 0) {
      s = l > 0.5 ? d / (2 - mx - mn) : d / (mx + mn)
      if (mx == r) hue = (g - b) / d + (g < b ? 6 : 0)
      else if (mx == g) hue = (b - r) / d + 2
      else hue = (r - g) / d + 4
      hue *= 60
    }
    printf "hsl(%d, %d%%, %d%%)", int(hue + 0.5) % 360, int(s * 100 + 0.5), int(l * 100 + 0.5)
  }')

printf %s "$c" | wl-copy

# The swatch: a small picture of the color, for the notification (in the
# session's own runtime folder; none without one).
icon=color-select
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -O "$XDG_RUNTIME_DIR" ]; then
  dir="$XDG_RUNTIME_DIR/mazapan-colors"
  if mkdir -p -m 700 "$dir" && printf '<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64"><rect x="2" y="2" width="60" height="60" rx="14" fill="#%s" stroke="#808080" stroke-opacity="0.6" stroke-width="2"/></svg>\n' "$h" > "$dir/$h.svg"; then
    icon="$dir/$h.svg"
  fi
fi

notify-send -a {{ shq (t "title") }} -i "$icon" "$c" {{ shq (t "copied") }}
