// Generated by mazapan (plugin {{ plugin }}): the sound, in the Control Center.
//
// The volume and, right under it, where the sound goes (speakers,
// headphones, a monitor's HDMI) as one tap each; the microphone below. In
// the pill: the speaker and the volume.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Services.Pipewire
import qs
import "../../components/kit"

Group {
  id: root

  readonly property real maxVolume: {{ settings.max_volume }}
  readonly property real step: {{ settings.step }}
  readonly property var sink: Pipewire.defaultAudioSink
  readonly property var source: Pipewire.defaultAudioSource
  readonly property var sinks: Pipewire.nodes.values.filter(n => n.type === PwNodeType.AudioSink)
  readonly property real volume: sink && sink.audio ? sink.audio.volume : 0
  readonly property bool muted: !sink || !sink.audio || sink.audio.muted

  property bool shown: sink !== null
  readonly property string pillGlyph: !sink ? "" : glyphFor(volume, muted) + " " + Math.round(volume * 100) + "%"

  PwObjectTracker { objects: [root.sink, root.source] }

  function glyphFor(v, mute) {
    if (mute || v <= 0) return "󰝟"
    if (v < 0.34) return "󰕿"
    if (v < 0.67) return "󰖀"
    return "󰕾"
  }
  function setVolume(node, v) {
    if (!node || !node.audio) return
    node.audio.muted = false
    node.audio.volume = Math.max(0, Math.min(root.maxVolume, v))
  }
  function nodeName(n) { return n.description || n.nickname || n.name }

  component Line: RowLayout {
    id: line
    required property var node
    required property string onGlyph
    required property string offGlyph
    readonly property bool off: !node || !node.audio || node.audio.muted
    readonly property real level: node && node.audio ? node.audio.volume : 0
    Layout.fillWidth: true
    spacing: 10
    Glyph {
      text: line.off ? line.offGlyph : line.onGlyph
      color: line.off ? Theme.fgSubtle : Theme.accentText
      font.pointSize: 13
      Layout.preferredWidth: 20
      MouseArea {
        anchors.fill: parent
        anchors.margins: -4
        cursorShape: Qt.PointingHandCursor
        onClicked: if (line.node && line.node.audio) line.node.audio.muted = !line.node.audio.muted
      }
    }
    Slider {
      Layout.fillWidth: true
      value: line.level
      to: root.maxVolume
      step: root.step
      dimmed: line.off
      onMoved: v => root.setVolume(line.node, v)
    }
    Caption {
      text: line.off ? {{ tq "muted" }} : Math.round(line.level * 100) + "%"
      font.letterSpacing: 0
      Layout.preferredWidth: 44
      horizontalAlignment: Text.AlignRight
    }
  }

  Line { node: root.sink; onGlyph: root.glyphFor(root.volume, false); offGlyph: "󰝟" }

  // Where it goes: a tap each.
  Flow {
    visible: root.sinks.length > 1
    Layout.fillWidth: true
    spacing: 6
    Repeater {
      model: root.sinks
      Rectangle {
        required property var modelData
        readonly property bool on: modelData === root.sink
        implicitWidth: chip.implicitWidth + 20
        implicitHeight: 28
        radius: Theme.radius
        color: on ? Theme.accent : area.containsMouse ? Theme.surfaceRaised : Theme.bgAlt
        border.width: 1
        border.color: on ? Theme.accent : Theme.border
        Text {
          id: chip
          anchors.centerIn: parent
          text: (/head(phone|set)/i.test(root.nodeName(modelData)) ? "󰋋  " : "󰓃  ") + root.nodeName(modelData).slice(0, 28)
          color: on ? Theme.accentFg : Theme.fg
          font.family: Theme.fontMono
          font.pointSize: 8.5
        }
        MouseArea {
          id: area
          anchors.fill: parent
          hoverEnabled: true
          cursorShape: Qt.PointingHandCursor
          onClicked: Pipewire.preferredDefaultAudioSink = modelData
        }
      }
    }
  }

  Line { visible: root.source !== null; node: root.source; onGlyph: "󰍬"; offGlyph: "󰍭" }
}
