// Generated by mazapan (plugin {{ plugin }}).
//
// The default output's volume in the bar. Scroll to change it, middle-click
// to mute, click for the card: output and input, each with mute, a slider
// and, when there's more than one, the devices to pick from.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Services.Pipewire
import qs
import "../../components/kit"

BarItem {
  id: root

  readonly property real step: {{ settings.step }}
  readonly property real maxVolume: {{ settings.max_volume }}

  readonly property var sink: Pipewire.defaultAudioSink
  readonly property var source: Pipewire.defaultAudioSource
  readonly property real volume: sink && sink.audio ? sink.audio.volume : 0
  readonly property bool muted: !sink || !sink.audio || sink.audio.muted

  // PipeWire only reports a node's volume while something tracks it.
  PwObjectTracker {
    objects: [root.sink, root.source]
  }

  function outputGlyph(v, mute) {
    if (mute || v <= 0) return "󰝟"
    if (v < 0.34) return "󰕿"
    if (v < 0.67) return "󰖀"
    return "󰕾"
  }

  function setVolume(node, v) {
    if (!node || !node.audio) return
    node.audio.muted = false
    node.audio.volume = Math.max(0, Math.min(root.maxVolume, v))
  }

  function toggleMute(node) {
    if (node && node.audio) node.audio.muted = !node.audio.muted
  }

  function nodeName(n) {
    return n.description || n.nickname || n.name
  }

  open: popup.visible
  acceptedButtons: Qt.LeftButton | Qt.MiddleButton
  onClicked: mouse => mouse.button === Qt.MiddleButton ? root.toggleMute(root.sink) : popup.toggle()
  onWheel: event => root.setVolume(root.sink, root.volume + (event.angleDelta.y > 0 ? root.step : -root.step))

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: root.outputGlyph(root.volume, root.muted)
    color: root.muted ? Theme.fgSubtle : Theme.accentText
  }
{{- if settings.show_percent }}

  Label {
    anchors.verticalCenter: parent.verticalCenter
    visible: root.sink !== null
    text: `${Math.round(root.volume * 100)}%`
    color: root.muted ? Theme.fgSubtle : Theme.fg
  }
{{- end }}

  BarPopup {
    id: popup
    owner: root
    cardWidth: 340

    readonly property var sinks: Pipewire.nodes.values.filter(n => n.type === PwNodeType.AudioSink)
    readonly property var sources: Pipewire.nodes.values.filter(n => n.type === PwNodeType.AudioSource)

    Label {
      visible: root.sink === null
      text: {{ tq "no_device" }}
      color: Theme.fgMuted
    }

    // One block per direction: header, mute + slider, devices.
    component Channel: ColumnLayout {
      id: channel
      required property string caption
      required property var node
      required property var nodes
      required property string onGlyph
      required property string offGlyph
      signal pick(var node)

      readonly property bool muted: !node || !node.audio || node.audio.muted
      readonly property real volume: node && node.audio ? node.audio.volume : 0

      visible: node !== null
      Layout.fillWidth: true
      spacing: 8

      RowLayout {
        Layout.fillWidth: true
        Caption { text: channel.caption.toUpperCase() }
        Item { Layout.fillWidth: true }
        Caption {
          text: channel.muted ? {{ tq "muted" }} : `${Math.round(channel.volume * 100)}%`
          color: channel.muted ? Theme.fgSubtle : Theme.fgMuted
        }
      }

      RowLayout {
        Layout.fillWidth: true
        spacing: 10

        Glyph {
          text: channel.muted ? channel.offGlyph : channel.onGlyph
          color: channel.muted ? Theme.fgSubtle : Theme.accentText
          font.pointSize: 13
          MouseArea {
            anchors.fill: parent
            anchors.margins: -4
            cursorShape: Qt.PointingHandCursor
            onClicked: root.toggleMute(channel.node)
          }
        }

        Slider {
          Layout.fillWidth: true
          value: channel.volume
          to: root.maxVolume
          step: root.step
          dimmed: channel.muted
          onMoved: v => root.setVolume(channel.node, v)
        }
      }

      // Devices, only when there is a choice to make.
      ColumnLayout {
        visible: channel.nodes.length > 1
        Layout.fillWidth: true
        spacing: 0

        Repeater {
          model: channel.nodes
          ListRow {
            required property var modelData
            glyph: /head(phone|set)/i.test(root.nodeName(modelData)) ? "󰋋" : channel.onGlyph
            title: root.nodeName(modelData)
            active: modelData === channel.node
            onClicked: channel.pick(modelData)
          }
        }
      }
    }

    Channel {
      caption: {{ tq "output" }}
      node: root.sink
      nodes: popup.sinks
      onGlyph: "󰓃"
      offGlyph: "󰝟"
      onPick: n => Pipewire.preferredDefaultAudioSink = n
    }

    Rule {
      visible: root.sink !== null && root.source !== null
    }

    Channel {
      caption: {{ tq "input" }}
      node: root.source
      nodes: popup.sources
      onGlyph: "󰍬"
      offGlyph: "󰍭"
      onPick: n => Pipewire.preferredDefaultAudioSource = n
    }
  }
}
