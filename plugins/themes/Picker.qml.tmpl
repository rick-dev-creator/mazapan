// Generated by myarch (plugin {{ plugin }}): the theme picker (panel).
//
// Every theme as a small desktop drawn from its own tokens (so any theme,
// yours too, has an exact preview), its contrast checked. Moving through
// them previews each one live on the real desktop: the bar, panels and
// window borders morph to it. ↵ applies it everywhere (terminals, GTK…);
// esc goes back to yours. Tab picks the accent: its other tokens are
// derived with contrast kept (myarch themes --json).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var themes: []
  property string current: ""       // in config.toml
  property string currentAccent: "" // in config.toml, "" = the theme's
  property int ti: 0 // theme
  property int ai: 0 // accent
  property string message: ""
  property var screenAtOpen: null
  // Installed apps, and whether the theme reaches them (myarch coverage).
  property var apps: []
  property bool coverageFailed: false

  readonly property var theme: themes[ti] ?? null
  readonly property var accent: theme ? theme.accents[ai] ?? theme.accents[0] : null
  // The selected theme with the selected accent.
  readonly property var colors: theme ? Object.assign({}, theme.colors, accent.tokens) : ({})

  function toggle() {
    if (open) cancel()
    else show()
  }

  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    themes = []
    message = {{ tq "loading" }}
    open = true
    Qt.callLater(() => list.forceActiveFocus())
    reader.running = true
    coverage.running = true
  }

  function load(json) {
    let data
    try {
      data = JSON.parse(json)
    } catch (e) {
      message = {{ tq "unreadable" }}
      return
    }
    themes = data.themes || []
    current = data.current
    currentAccent = (data.accent || "").toLowerCase()
    ti = Math.max(0, themes.findIndex(t => t.id === current))
    ai = accentFor(themes[ti])
    message = ""
    list.positionViewAtIndex(ti, ListView.Center)
  }

  // Your accent carries to every theme (every one offers it, re-derived
  // for its colors), as with `myarch apply --theme`; else the theme's own.
  function accentFor(t) {
    if (!t || currentAccent === "") return 0
    return Math.max(0, t.accents.findIndex(a => a.color === currentAccent))
  }

  function select(t, a) {
    if (!themes.length) return
    ti = (t + themes.length) % themes.length
    ai = a === undefined ? accentFor(themes[ti]) : (a + theme.accents.length) % theme.accents.length
    list.currentIndex = ti
    preview()
  }

  // The desktop, live: the shell and the wallpaper morph, windows get the
  // borders and blur, open terminals the colors.
  function preview() {
    Theme.preview(colors, { radius: theme.radius, borderWidth: theme.border, mode: theme.mode,
      wallpaper: theme.wallpaper, terminalOpacity: theme.terminal_opacity, blur: theme.blur })
    windows(colors, theme.border, theme.radius, theme.blur)
    // term-colors: opacity%, bg, fg, cursor, selection, color0 … color15.
    const h = x => x.slice(1, 7)
    const names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    const ansi = names.map(n => h(theme.ansi[n])).concat(names.map(n => h(theme.ansi["bright_" + n])))
    Quickshell.execDetached(["sh", "-c", 'sh ~/.local/share/myarch/bin/term-colors "$@"', "term-colors",
      String(Math.round(theme.terminal_opacity * 100)), h(colors.bg), h(colors.fg), h(colors.accent), h(colors.selection)].concat(ansi))
  }

  function windows(c, border, radius, blur) {
    const rgb = hex => `rgb(${hex.slice(1, 7)})`
    Quickshell.execDetached(["hyprctl", "eval", `myarch_theme({ accent = "${rgb(c.accent)}", inactive = "${rgb(c.border)}", `
      + `background = "${rgb(c.bg_alt)}", border = ${border}, radius = ${radius}, blur = ${blur} })`])
  }

  // SUPER + Q (the shell's close()) and esc: nothing previewed stays.
  function close() {
    cancel()
  }

  function cancel() {
    if (open && themes.length) {
      Theme.restore()
      windows(Theme.saved, Theme.savedShape.borderWidth, Theme.savedShape.radius, Theme.savedShape.blur)
      Quickshell.execDetached(["sh", "-c", "sh ~/.local/share/myarch/bin/term-colors"]) // yours
    }
    open = false
  }

  // Everywhere, for good: the files are written and everything reloads.
  // Detached: the shell reloads itself on the way, this panel with it.
  function apply() {
    if (!theme) return
    const acc = ai === 0 ? "theme" : accent.color
    message = {{ tq "applying" }}.arg(theme.name)
    Quickshell.execDetached(["sh", "-c",
      'mkdir -p ~/.local/state/myarch; myarch apply --theme "$0" --accent "$1" > ~/.local/state/myarch/theme.log 2>&1 '
      + '|| { hyprctl notify 3 10000 0 "$2"; hyprctl reload >/dev/null; qs ipc -c myarch call myarch reload >/dev/null; }',
      theme.id, acc, {{ tq "failed" }}])
    open = false
  }

  Process {
    id: coverage
    command: ["myarch", "coverage", "--json"]
    stdout: StdioCollector {
      onStreamFinished: {
        try {
          root.apps = JSON.parse(text)
          root.coverageFailed = false
        } catch (e) {
          root.apps = []
          root.coverageFailed = true
        }
      }
    }
    onExited: code => { if (code !== 0) root.coverageFailed = true }
  }

  Process {
    id: reader
    command: ["myarch", "themes", "--json"]
    stdout: StdioCollector { onStreamFinished: if (text.trim() !== "") root.load(text) }
    // Not on the PATH, or it failed: say so instead of "Reading…" forever.
    onExited: code => { if (code !== 0) root.message = {{ tq "unreadable" }} }
  }

  // --- a small desktop, drawn from a theme's tokens ---------------------------

  component Line: Rectangle {
    height: 3
    radius: 1.5
  }

  component Mini: Rectangle {
    id: mini
    property var t          // the theme
    property var c: t.colors // its colors (with an accent)
    readonly property real r: Math.min(t.radius, 3)

    color: c.bg_alt
    clip: true

    // The bar.
    Rectangle {
      width: parent.width
      height: 11
      color: mini.c.bg
      Row {
        x: 5
        anchors.verticalCenter: parent.verticalCenter
        spacing: 3
        Rectangle { width: 8; height: 7; color: mini.c.accent }
        Repeater {
          model: 3
          Rectangle { width: 3; height: 3; radius: 1.5; anchors.verticalCenter: parent.verticalCenter; color: mini.c.fg_subtle }
        }
      }
      Line { anchors.centerIn: parent; width: 26; color: mini.c.fg_muted }
      Row {
        anchors.right: parent.right
        anchors.rightMargin: 5
        anchors.verticalCenter: parent.verticalCenter
        spacing: 3
        Repeater {
          model: 3
          Rectangle { width: 4; height: 4; radius: 2; color: mini.c.accent_text }
        }
      }
    }

    // A terminal, focused: its border is the accent.
    Rectangle {
      x: 5; y: 16
      width: parent.width * 0.56 - 7
      height: parent.height - 21
      radius: mini.r
      color: mini.c.bg
      border.width: Math.max(1, mini.t.border / 2 + 0.5)
      border.color: mini.c.accent

      Column {
        x: 6; y: 7
        spacing: 4
        Row { spacing: 3; Line { width: 5; color: mini.t.ansi.green } Line { width: 22; color: mini.c.fg } }
        Row { spacing: 3; Line { width: 14; color: mini.t.ansi.blue } Line { width: 12; color: mini.t.ansi.blue } Line { width: 18; color: mini.c.fg_muted } }
        Row { spacing: 3; Line { width: 10; color: mini.t.ansi.magenta } Line { width: 16; color: mini.t.ansi.yellow } Line { width: 6; color: mini.c.fg } }
        Row { spacing: 3; Line { x: 6; width: 6; color: mini.c.fg } Line { width: 12; color: mini.t.ansi.green } Line { width: 9; color: mini.t.ansi.red } }
        Row { spacing: 3; Line { width: 30; color: mini.c.fg_subtle } }
        Row { spacing: 3; Line { width: 5; color: mini.t.ansi.green } Rectangle { width: 5; height: 7; color: mini.c.accent } }
      }
    }

    // Another window: a list with the selection, a card with a button.
    Rectangle {
      x: parent.width * 0.56 + 2; y: 16
      width: parent.width * 0.44 - 7
      height: parent.height - 21
      radius: mini.r
      color: mini.c.surface
      border.width: Math.max(1, mini.t.border / 2 + 0.5)
      border.color: mini.c.border

      Column {
        x: 5; y: 7
        width: parent.width - 10
        spacing: 3
        Repeater {
          model: 4
          Rectangle {
            required property int index
            width: parent.width
            height: 9
            color: index === 1 ? mini.c.selection : "transparent"
            Line { x: 3; anchors.verticalCenter: parent.verticalCenter; width: 14 + (index * 7) % 13; color: index === 1 ? mini.c.fg : mini.c.fg_muted }
          }
        }
      }
      Rectangle {
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        anchors.margins: 6
        width: 26; height: 11
        radius: mini.r
        color: mini.c.accent
        Line { anchors.centerIn: parent; width: 14; color: mini.c.accent_fg }
      }
      Rectangle {
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.margins: 6
        width: 18; height: 11
        radius: mini.r
        color: mini.c.accent_deep
        Line { anchors.centerIn: parent; width: 9; color: mini.c.accent_text }
      }
    }
  }

  // --- the panel ---------------------------------------------------------------

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: Math.max(560, Math.min(1180, (screen ? screen.width : 1280) * 0.86))
    implicitHeight: card.implicitHeight
    // At the bottom: the desktop above is the preview.
    anchors.bottom: true
    margins.bottom: Math.round((screen ? screen.height : 1080) * 0.05)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "myarch-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "myarch-panel-themes"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      width: parent.width
      implicitHeight: body.implicitHeight + 32
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius

      ColumnLayout {
        id: body
        x: 16; y: 16
        width: parent.width - 32
        spacing: 12

        RowLayout {
          Layout.fillWidth: true
          Caption { text: {{ tq "title" }}.toUpperCase() }
          Item { Layout.fillWidth: true }
          Caption { text: {{ tq "hints" }} }
        }

        ListView {
          id: list
          Layout.fillWidth: true
          // All of them side by side when they fit; else a carousel.
          readonly property real cardWidth: Math.max(180, Math.min(250, (width - spacing * (count - 1)) / Math.max(1, count)))
          implicitHeight: Math.round(cardWidth * 0.62) + 56
          orientation: ListView.Horizontal
          spacing: 14
          clip: true
          model: root.themes
          currentIndex: root.ti
          highlightMoveDuration: Theme.motion ? 250 : 0
          preferredHighlightBegin: width / 2 - cardWidth / 2
          preferredHighlightEnd: width / 2 + cardWidth / 2
          highlightRangeMode: ListView.ApplyRange
          boundsBehavior: Flickable.StopAtBounds
          focus: true

          Keys.onPressed: event => {
            if (event.key === Qt.Key_Right || event.key === Qt.Key_L) root.select(root.ti + 1)
            else if (event.key === Qt.Key_Left || event.key === Qt.Key_H) root.select(root.ti - 1)
            else if (event.key === Qt.Key_Tab || event.key === Qt.Key_Down) root.select(root.ti, root.ai + 1)
            else if (event.key === Qt.Key_Backtab || event.key === Qt.Key_Up) root.select(root.ti, root.ai - 1)
            else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) root.apply()
            else if (event.key === Qt.Key_Escape) root.cancel()
            else return
            event.accepted = true
          }

          delegate: Item {
            id: cell
            required property var modelData
            required property int index
            readonly property bool chosen: index === root.ti
            // The chosen one shows the chosen accent.
            readonly property var shown: chosen ? root.colors
              : Object.assign({}, modelData.colors, (modelData.accents[root.accentFor(modelData)] ?? { tokens: {} }).tokens)

            width: list.cardWidth
            height: list.height

            ColumnLayout {
              anchors.fill: parent
              spacing: 6

              Rectangle {
                Layout.preferredWidth: list.cardWidth
                Layout.preferredHeight: Math.round(list.cardWidth * 0.62)
                color: "transparent"
                border.width: 2
                border.color: cell.chosen ? Theme.accent : "transparent"
                scale: cell.chosen ? 1 : 0.95
                Behavior on scale { NumberAnimation { duration: Theme.motion ? 200 : 0; easing.type: Easing.OutCubic } }

                Mini {
                  anchors.fill: parent
                  anchors.margins: 3
                  t: cell.modelData
                  c: cell.shown
                }

                MouseArea {
                  anchors.fill: parent
                  onClicked: cell.chosen ? root.apply() : root.select(cell.index)
                }
              }

              RowLayout {
                Layout.fillWidth: true
                spacing: 6
                // ● the one in use
                Text {
                  visible: cell.modelData.id === root.current
                  text: "●"
                  color: Theme.accentText
                  font.pointSize: 7
                }
                Label {
                  text: cell.modelData.name
                  font.bold: true
                  color: cell.chosen ? Theme.fg : Theme.fgMuted
                }
                Caption { text: cell.modelData.mode === "light" ? {{ tq "light" }} : {{ tq "dark" }} }
                Item { Layout.fillWidth: true }
                Caption {
                  // The accent this card shows (null for a moment while the themes load).
                  readonly property var problems: ((cell.chosen ? root.accent : cell.modelData.accents[root.accentFor(cell.modelData)]) ?? cell.modelData).problems ?? []
                  text: problems.length === 0 ? "✓" : "⚠ " + problems.length
                  color: problems.length === 0 ? Theme.success : Theme.warning
                }
              }

              Caption {
                Layout.fillWidth: true
                text: cell.modelData.description
                elide: Text.ElideRight
                maximumLineCount: 1
              }
            }
          }
        }

        Rule {}

        // The accent: the theme's own, then the ones it suggests.
        RowLayout {
          Layout.fillWidth: true
          spacing: 10
          visible: root.theme !== null

          Caption { text: {{ tq "accent" }}.toUpperCase() }

          Repeater {
            model: root.theme ? root.theme.accents : []
            Rectangle {
              required property var modelData
              required property int index
              readonly property bool chosen: index === root.ai
              width: 22; height: 22
              radius: 11
              color: "transparent"
              border.width: chosen ? 2 : 0
              border.color: Theme.fg
              Rectangle {
                anchors.centerIn: parent
                width: 16; height: 16
                radius: 8
                color: parent.modelData.tokens.accent
              }
              MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: root.select(root.ti, parent.index)
              }
            }
          }

          Caption {
            text: root.ai === 0 ? {{ tq "theirs" }} : root.accent ? root.accent.color : ""
          }

          Item { Layout.fillWidth: true }

          // What fails in this theme, if anything.
          Caption {
            Layout.maximumWidth: body.width * 0.55
            elide: Text.ElideRight
            visible: root.message !== "" || root.theme !== null
            text: root.message !== "" ? root.message : !root.accent ? ""
              : root.accent.problems.length === 0 ? "✓ " + {{ tq "contrast_ok" }}
              : "⚠ " + root.accent.problems.map(p => {{ tq "problem" }}.arg(p.fg).arg(p.bg).arg(p.ratio).arg(p.min)).join(" · ")
            color: root.message !== "" ? Theme.fgMuted : root.accent && root.accent.problems.length ? Theme.warning : Theme.success
          }
        }

        // How much of the desktop a theme reaches (the same for all of
        // them: it's the plugins that theme apps), and what it doesn't.
        Caption {
          readonly property var missing: root.apps.filter(a => !a.plugin)
          Layout.fillWidth: true
          visible: root.apps.length > 0 || root.coverageFailed
          elide: Text.ElideRight
          text: root.coverageFailed ? {{ tq "coverage_failed" }} : {{ tq "coverage" }}.arg(root.apps.length - missing.length).arg(root.apps.length)
            + (missing.length ? "  ·  " + {{ tq "missing" }}.arg(missing.map(a => a.name).join(", ")) : "")
          color: missing.length ? Theme.fgMuted : Theme.success
        }
      }
    }
  }
}
