// Generated by mazapan (plugin {{ plugin }}).
//
// While the system runs from a checkpoint: a mark in the middle of the
// bar, so it's never forgotten. Click: what it is, and what can be done.

import QtQuick
import Quickshell
import Quickshell.Io
import qs
import "../../components/kit"

BarItem {
  id: root

  property bool on: false
  shown: on
  onClicked: Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "checkpoint"])

  // The kernel's line says it, and it doesn't change until the next start.
  Process {
    running: true
    command: ["grep", "-qE", "mazapan\\.checkpoint=|subvol=[^ ]*\\.snapshots/[0-9]+/snapshot", "/proc/cmdline"]
    onExited: code => root.on = code === 0
  }

  Glyph { anchors.verticalCenter: parent.verticalCenter; text: "󰁯"; color: Theme.warning }
  Label {
    anchors.verticalCenter: parent.verticalCenter
    text: {{ tq "mark" }}
    color: Theme.warning
    font.bold: true
  }
}
