# Generated by mazapan (plugin {{ plugin }}): what the initramfs needs to
# start a checkpoint (read-only) from the boot menu, on an overlay in memory.
MODULES+=(overlay)
if [[ " ${HOOKS[*]} " == *" systemd "* ]]; then
  # systemd's initramfs: systemd.volatile=overlay (on each checkpoint's
  # kernel line) is done by this service.
  FILES+=(/usr/lib/systemd/system/systemd-volatile-root.service /usr/lib/systemd/systemd-volatile-root)
elif [[ -e /usr/lib/initcpio/install/grub-btrfs-overlayfs ]]; then
  # busybox's (a system Mazapán didn't install): grub-btrfs's hook.
  HOOKS+=(grub-btrfs-overlayfs)
fi
