// Generated by mazapan (plugin {{ plugin }}).
//
// Started from a checkpoint: said at once, in words. The system is as it
// was before a change; what's done here is lost at the next start. Keep it
// (it becomes the system, the one it replaces kept {{ settings.keep_days }} days), go back to
// the main system (a restart), or ask an agent what broke (what changed,
// read only). On the main system, after a checkpoint was kept: said once.
//   qs ipc -c mazapan call mazapan panel checkpoint

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  property var status: null        // mazapan checkpoint status --json
  property string phase: ""        // "", "keeping", "kept", "failed"
  property string message: ""
  readonly property var booted: status ? status.booted : null
  readonly property var restored: status ? status.restored : null
  readonly property bool canAsk: {{ if (under "~/.config/quickshell/mazapan/panels/ask.qml").size > 0 }}true{{ else }}false{{ end }}

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    reader.running = true
    open = true
  }
  function close() { open = false }

  Process {
    id: reader
    command: ["mazapan", "checkpoint", "status", "--json"]
    stdout: StdioCollector { onStreamFinished: { try { root.status = JSON.parse(text) } catch (e) {} } }
  }

  function when(iso) {
    const d = new Date(iso)
    return isNaN(d) ? "" : d.toLocaleString(Qt.locale(), "d MMM, HH:mm")
  }
  // What it was before, in the person's language (the core says it in English).
  function what(b) {
    if (!b) return ""
    const n = (b.title.match(/\((\d+) package/) || [])[1]
    switch (b.kind) {
    case "update": return n ? {{ tq "kind.update_n" }}.arg(n) : {{ tq "kind.update" }}
    case "install": return {{ tq "kind.install" }}.arg(b.title.replace(/^before installing /, ""))
    case "remove": return {{ tq "kind.remove" }}.arg(b.title.replace(/^before removing /, ""))
    case "installed": return {{ tq "kind.installed" }}
    case "previous": return {{ tq "kind.previous" }}
    }
    return b.title
  }

  function keep() {
    phase = "keeping"
    message = {{ tq "keeping" }}
    keeper.running = true
  }
  Process {
    id: keeper
    command: ["pkexec", "mazapan", "checkpoint", "keep", "-y"]
    stderr: StdioCollector { id: keepErr }
    onExited: code => {
      root.phase = code === 0 ? "kept" : "failed"
      root.message = code === 0 ? {{ tq "kept" }} : (code === 126 || code === 127 ? {{ tq "not_allowed" }} : (keepErr.text.trim().split("\n").pop().replace(/^mazapan: /, "") || {{ tq "failed" }}))
    }
  }

  function restart() { Quickshell.execDetached(["systemctl", "reboot"]) }

  // What changed, written down for the agent (read only), and asked.
  function ask() {
    close()
    Quickshell.execDetached(["sh", "-c", 'd="${XDG_RUNTIME_DIR:-/tmp}/mazapan-ask"; mkdir -p "$d" && chmod 700 "$d" && f="$d/checkpoint.md" && '
      + 'mazapan checkpoint diagnose > "$f" 2>&1; MAZAPAN_ASK="$0" exec sh "$HOME/.local/share/mazapan/bin/agent-ask" "$f"', {{ tq "ask_question" }}])
  }

  // As the desktop starts: on a checkpoint (or right after keeping one), shown by itself.
  Process {
    id: first
    running: true
    command: ["mazapan", "checkpoint", "status", "--json"]
    stdout: StdioCollector {
      onStreamFinished: {
        let s = null
        try { s = JSON.parse(text) } catch (e) { return }
        root.status = s
        if (s.booted) Qt.callLater(root.show)
        else if (s.restored) seen.running = true
      }
    }
  }
  // Kept: said once (a file in the runtime folder: until the next start).
  Process {
    id: seen
    command: ["sh", "-c", 'f="${XDG_RUNTIME_DIR:-/tmp}/mazapan-checkpoint-restored"; [ -e "$f" ] && exit 1; : > "$f"']
    onExited: code => { if (code === 0) Qt.callLater(root.show) }
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: 600
    implicitHeight: card.implicitHeight
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-checkpoint"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      anchors.fill: parent
      implicitHeight: col.implicitHeight + 32
      color: Theme.surfaceRaised
      border.color: root.booted ? Theme.warning : Theme.border
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: root.close()

      ColumnLayout {
        id: col
        anchors { left: parent.left; right: parent.right; top: parent.top; margins: 16 }
        spacing: 10

        RowLayout {
          spacing: 8
          Glyph { text: "󰁯"; color: root.booted ? Theme.warning : Theme.accent }
          Label {
            text: root.booted ? {{ tq "title" }} : root.restored ? {{ tq "title_kept" }} : {{ tq "title_main" }}
            font.bold: true
            Layout.fillWidth: true
          }
        }

        // On a checkpoint.
        Label {
          visible: !!root.booted
          text: root.booted ? {{ tq "from" }}.arg(root.when(root.booted.when)).arg(root.what(root.booted)) : ""
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
        Caption {
          visible: !!root.booted
          text: {{ tq "lost" }}
          color: Theme.fgMuted
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
        Caption {
          visible: !!root.booted && root.phase === ""
          text: {{ tq "choices" }}.arg({{ settings.keep_days }})
          color: Theme.fgSubtle
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }

        // On the main system.
        Label {
          visible: !root.booted
          text: root.restored ? {{ tq "kept_note" }}.arg(root.when(root.restored.until)) : (root.status && root.status.in_menu > 0 ? {{ tq "main_note" }}.arg(root.status.in_menu) : {{ tq "main_none" }})
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }

        Caption {
          visible: root.message !== ""
          text: root.message
          color: root.phase === "failed" ? Theme.danger : Theme.fgMuted
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }

        RowLayout {
          Layout.fillWidth: true
          spacing: 8
          Button {
            visible: !!root.booted && root.canAsk && root.phase !== "kept"
            text: "󰚩 " + {{ tq "ask" }}
            onClicked: root.ask()
          }
          Item { Layout.fillWidth: true }
          Button {
            visible: !root.booted || root.phase === "kept"
            text: {{ tq "close" }}
            onClicked: root.close()
          }
          Button {
            visible: !!root.booted && root.phase !== "kept"
            // Never in the middle of making this one the main system.
            enabled: root.phase !== "keeping"
            text: {{ tq "back" }}
            onClicked: root.restart()
          }
          Button {
            visible: !!root.booted && root.phase !== "kept"
            enabled: root.phase !== "keeping"
            text: {{ tq "keep" }}
            primary: true
            onClicked: root.keep()
          }
          Button {
            visible: root.phase === "kept"
            text: {{ tq "restart" }}
            primary: true
            onClicked: root.restart()
          }
        }
      }
    }
  }
}
