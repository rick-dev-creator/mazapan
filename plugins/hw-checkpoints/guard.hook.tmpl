# Generated by mazapan (plugin {{ plugin }}): no package changes on a
# checkpoint (its kernels would land on the main system's /boot, its
# modules in memory), nor after making one the main system until the
# restart. `sudo mazapan checkpoint keep` first, then restart.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Checking this isn't a checkpoint...
When = PreTransaction
Exec = /usr/bin/env mazapan checkpoint guard
AbortOnFail
