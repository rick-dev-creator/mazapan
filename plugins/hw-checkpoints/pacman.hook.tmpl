# Generated by mazapan (plugin {{ plugin }}): after every package change,
# after mkinitcpio's hook, the checkpoints in the boot menu.
[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Writing the checkpoints in the boot menu...
When = PostTransaction
Exec = /usr/bin/mazapan checkpoint after-pacman --entries {{ settings.entries }} --keep-days {{ settings.keep_days }}
