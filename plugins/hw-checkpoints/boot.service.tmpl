# Generated by mazapan (plugin {{ plugin }}): at every start. On a
# checkpoint: which one, for the desktop, and the main system mounted read
# only (/run/mazapan/main) to compare. On the main system: a checkpoint just
# kept said once, the boot menu written, old previous systems deleted.
[Unit]
Description=Mazapán's checkpoints
After=local-fs.target
ConditionPathExists=/etc/grub.d/mazapan_checkpoints

[Service]
Type=oneshot
ExecStart=/usr/bin/mazapan checkpoint boot --entries {{ settings.entries }} --keep-days {{ settings.keep_days }}

[Install]
WantedBy=multi-user.target
