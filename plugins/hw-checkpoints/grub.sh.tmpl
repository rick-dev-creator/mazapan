#!/bin/sh
# Generated by mazapan (plugin {{ plugin }}): run by grub-mkconfig. The
# checkpoints' entries live in a file of their own next to grub.cfg,
# written by `mazapan checkpoint menu` after every change (no grub-mkconfig
# needed); grub.cfg reads it when it's there.
cat <<'GRUB'
if [ -f "${config_directory}/mazapan-checkpoints.cfg" ]; then
  source "${config_directory}/mazapan-checkpoints.cfg"
fi
GRUB
