// Generated by mazapan (plugin {{ plugin }}).
//
// Apps: what the catalog knows how to install, by use first (profiles:
// Development, Gaming…), then every app by kind, and what's installed.
// One button: what it will do said in a line (the detail a click away),
// the password through polkit, progress here, no terminal. Every install
// and removal is on the timeline, with its undo (mazapan apps).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null

  property var profiles: []
  property var apps: []
  property bool loading: false
  property string view: "profiles" // profiles, all, installed
  property string query: ""
  property string profile: ""      // a profile's page (its apps, each with a box)

  // Asking: what's about to happen (the plan), for which ids.
  property var plan: null
  property var planIds: []
  property bool planRemove: false
  property bool details: false
  property var picked: ({})        // a profile's page: app id -> wanted
  property var chosen: ({})        // profiles chosen together: id -> true
  readonly property var chosenIds: profiles.filter(p => chosen[p.id]).map(p => p.id)

  // Doing it (detached: installing plugins reloads the shell).
  property bool running: false
  property string runId: ""
  property string step: ""
  property string line: ""
  property string result: ""
  property bool failed: false

  readonly property string state: Quickshell.env("HOME") + "/.local/state/mazapan/apps"

  readonly property var categories: [
    ["internet", {{ tq "cat.internet" }}, 0xF059F], ["communication", {{ tq "cat.communication" }}, 0xF0369],
    ["office", {{ tq "cat.office" }}, 0xF0219], ["development", {{ tq "cat.development" }}, 0xF0169],
    ["graphics", {{ tq "cat.graphics" }}, 0xF03D8], ["video", {{ tq "cat.video" }}, 0xF0567],
    ["audio", {{ tq "cat.audio" }}, 0xF075A], ["games", {{ tq "cat.games" }}, 0xF0297],
    ["utilities", {{ tq "cat.utilities" }}, 0xF0493], ["finance", {{ tq "cat.finance" }}, 0xF0128],
  ]
  function catGlyph(c) { const x = categories.find(k => k[0] === c); return x ? x[2] : 0xF003B }
  function app(id) { return apps.find(a => a.id === id) }

  readonly property var shownApps: {
    const words = query.toLowerCase().split(/\s+/).filter(w => w !== "")
    const order = c => categories.findIndex(k => k[0] === c)
    return apps.filter(a => (view !== "installed" || a.installed)
      && words.every(w => (a.name + " " + a.description + " " + a.category).toLowerCase().includes(w)))
      .sort((a, b) => order(a.category) - order(b.category) || a.name.localeCompare(b.name))
  }

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    if (!running) {
      plan = null
      result = ""
      resume.running = true
    }
    refresh()
    open = true
  }

  function close() { open = false }

  function refresh() {
    loading = true
    lister.running = true
  }

  Process {
    id: lister
    command: ["mazapan", "apps", "list", "--json"]
    stdout: StdioCollector {
      onStreamFinished: {
        try {
          const o = JSON.parse(text)
          root.profiles = o.profiles || []
          root.apps = o.apps || []
        } catch (e) {}
        root.loading = false
      }
    }
  }

  // --- asking -------------------------------------------------------------------

  // One plan at a time: asked again while one is being worked out, the
  // last question is the one answered.
  property var asking: null
  function ask(ids, remove) {
    asking = { ids: ids, remove: remove }
    details = false
    plan = { loading: true }
    if (!planner.running) plan_()
  }
  function plan_() {
    const q = asking
    asking = null
    planIds = q.ids
    planRemove = q.remove
    planner.command = ["mazapan", "apps", q.remove ? "plan-remove" : "plan", "--json"].concat(q.ids)
    planner.running = true
  }

  Process {
    id: planner
    stdout: StdioCollector { id: planOut }
    stderr: StdioCollector { id: planErr }
    onExited: code => {
      if (root.asking) {
        root.plan_()
        return
      }
      if (code !== 0) {
        root.plan = { error: true, why: planErr.text.replace(/^mazapan: /, "").trim() }
        return
      }
      try {
        root.plan = JSON.parse(planOut.text)
      } catch (e) {
        root.plan = { error: true, why: "" }
      }
    }
  }

  // A few names, then how many more.
  function names(ids) {
    const n = ids.map(id => app(id) ? app(id).name : id)
    return n.length <= 4 ? n.join(", ") : {{ tq "and_more" }}.arg(n.slice(0, 4).join(", ")).arg(n.length - 4)
  }

  function size(b) {
    return b >= 1073741824 ? (b / 1073741824).toFixed(1) + " GB" : Math.round(b / 1048576) + " MB"
  }

  // The plan in one line.
  function summary(p) {
    if (!p || p.loading) return {{ tq "planning" }}
    if (p.error) return {{ tq "plan_failed" }}.arg(p.why || "")
    if (planRemove) return {{ tq "remove_line" }}.arg((p.apps || []).length).arg((p.packages || []).length)
    const n = (p.apps || []).length
    if (n === 0) return {{ tq "nothing" }}
    const parts = [n === 1 ? {{ tq "apps_1" }} : {{ tq "apps_n" }}.arg(n)]
    if ((p.packages || []).length > 0) parts.push({{ tq "download_disk" }}.arg(size(p.download)).arg(size(p.installed)))
    if ((p.flatpaks || []).length > 0) parts.push({{ tq "from_flathub" }}.arg(p.flatpaks.length))
    return parts.join(" · ")
  }

  // --- doing it -------------------------------------------------------------------

  // Detached: turning plugins on reloads the shell, this panel with it; it
  // says when it's over itself (a notification), and the panel picks the
  // run up again after a reload (resume).
  function go() {
    if (!plan || plan.loading || plan.error || running) return
    // What the plan shown is about, not what was clicked since.
    const ids = plan.apps
    if (!ids || ids.length === 0) return
    running = true
    failed = false
    step = ""
    line = ""
    result = ""
    runId = String(Date.now())
    Quickshell.execDetached(["sh", "-c", 'dir=$0; id=$1; act=$2; ok=$3; bad=$4; title=$5; shift 5; mkdir -p "$dir"; '
      + 'echo "START $id" > "$dir/run.log"; mazapan apps "$act" --gui "$@" >> "$dir/run.log" 2>&1; code=$?; '
      + 'echo "DONE $code" >> "$dir/run.log"; '
      + 'if [ "$code" = 0 ]; then notify-send -a "$title" -i system-software-install "$ok"; '
      + 'elif ! grep -q "^fail cancelled" "$dir/run.log"; then notify-send -a "$title" -u critical -i dialog-warning "$bad"; fi',
      state, runId, planRemove ? "remove" : "install", planRemove ? {{ tq "removed" }} : {{ tq "done" }}, {{ tq "failed_short" }}, {{ tq "title" }}].concat(ids))
    plan = null
    watch.start()
  }

  // A run left going by an older shell (a reload): watched again.
  Process {
    id: resume
    command: ["sh", "-c", 'f="$0/run.log"; [ -f "$f" ] || exit 0; head -n 1 "$f"; grep -q "^DONE " "$f" && echo finished; '
      + 'pgrep -f "mazapan apps (install|remove|undo)" >/dev/null && echo alive', root.state]
    stdout: StdioCollector {
      onStreamFinished: {
        const l = text.split("\n")
        if (l[0] && l[0].startsWith("START ") && !text.includes("finished") && text.includes("alive")) {
          root.runId = l[0].slice(6)
          root.running = true
          root.failed = false
          watch.start()
        }
      }
    }
  }
  Component.onCompleted: resume.running = true

  // What it's doing: its log, read while it runs.
  Timer {
    id: watch
    interval: 700
    repeat: true
    onTriggered: if (!tail.running) tail.running = true
  }
  Process {
    id: tail
    command: ["sh", "-c", 'head -n 1 "$0"; tail -n 30 "$0"', root.state + "/run.log"]
    stdout: StdioCollector {
      onStreamFinished: {
        const lines = text.split("\n").filter(l => l.trim() !== "")
        // Only this run's (the file may still be the one before for a moment).
        if (lines[0] !== "START " + root.runId) return
        const said = l => l.startsWith("step ") || l.startsWith("DONE ") || l.startsWith("fail ") || l.startsWith("note ") || l.startsWith("START ")
        for (const l of lines) if (l.startsWith("step ")) root.step = l.slice(5)
        const last = lines.filter(l => !said(l)).pop() || ""
        root.line = last.replace(/\x1b\[[0-9;]*m/g, "").replace(/^mazapan: /, "").slice(0, 140)
        const done = lines.find(l => l.startsWith("DONE "))
        if (done) {
          watch.stop()
          root.running = false
          const fails = lines.filter(l => l.startsWith("fail ")).map(l => l.slice(5))
          const cancelled = fails.some(f => f === "cancelled")
          root.failed = done !== "DONE 0" && !cancelled
          root.result = cancelled ? {{ tq "cancelled" }}
            : root.failed ? {{ tq "failed" }}.arg(fails.map(root.why).join("; ") || root.line)
            : {{ tq "done" }}
          root.refresh()
          if (done === "DONE 0") {
            root.chosen = {}
            root.picked = {}
          }
        }
      }
    }
  }

  // What didn't go through, in words.
  function why(f) {
    const [kind, ...rest] = f.split(" ")
    const detail = rest.join(" ")
    return kind === "pacman" ? {{ tq "why.pacman" }}
      : kind === "flatpak" ? {{ tq "why.flatpak" }}.arg(detail)
      : kind === "webapp" ? {{ tq "why.webapp" }}.arg(detail)
      : kind === "plugins" ? {{ tq "why.plugins" }}.arg(detail)
      : kind === "busy" ? {{ tq "why.busy" }} : f
  }

  function keptWhy(k) {
    return k.why === "protected" ? {{ tq "kept.protected" }}.arg(k.name)
      : k.why === "yours" ? {{ tq "kept.yours" }}.arg(k.name)
      : {{ tq "kept.needed" }}.arg(k.name).arg(k.why.replace(/^needed by /, ""))
  }

  function stepText(s) {
    return s === "packages" ? {{ tq "step.packages" }} : s === "flatpaks" ? {{ tq "step.flatpaks" }}
      : s === "plugins" ? {{ tq "step.plugins" }} : s === "webapps" ? {{ tq "step.webapps" }} : {{ tq "step.start" }}
  }

  function launch(a) {
    const e = a.desktop ? DesktopEntries.byId(a.desktop.replace(/\.desktop$/, "")) : null
    if (e) {
      close()
      e.execute()
    }
  }

  function review(pluginId) {
    close()
    Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "plugins", "open", pluginId])
  }

  // --- the panel ---------------------------------------------------------------------

  // An app's picture: its icon when it's there, else its kind's glyph.
  component AppIcon: Item {
    property var app
    implicitWidth: 32
    implicitHeight: 32
    readonly property var entry: app && app.desktop ? DesktopEntries.byId(app.desktop.replace(/\.desktop$/, "")) : null
    Image {
      id: pic
      anchors.fill: parent
      source: parent.entry && parent.entry.icon ? Quickshell.iconPath(parent.entry.icon, true) : ""
      sourceSize: Qt.size(64, 64)
      visible: status === Image.Ready
      asynchronous: true
    }
    Glyph {
      anchors.centerIn: parent
      visible: pic.status !== Image.Ready
      text: String.fromCodePoint(root.catGlyph(parent.app ? parent.app.category : ""))
      color: Theme.fgMuted
      font.pointSize: 15
    }
  }

  // One app: what it is, and what can be done with it.
  component AppRow: Rectangle {
    id: rowItem
    property var app
    implicitHeight: 54
    radius: Theme.radius
    color: ra.containsMouse ? Theme.surface : "transparent"
    MouseArea { id: ra; anchors.fill: parent; hoverEnabled: true }
    RowLayout {
      anchors.fill: parent
      anchors.leftMargin: 10
      anchors.rightMargin: 10
      spacing: 12
      AppIcon { app: rowItem.app }
      ColumnLayout {
        spacing: 0
        Layout.fillWidth: true
        Label { text: rowItem.app.name; elide: Text.ElideRight; Layout.fillWidth: true }
        Caption { text: rowItem.app.description; elide: Text.ElideRight; Layout.fillWidth: true }
      }
      Button {
        visible: rowItem.app.installed && !!rowItem.app.desktop
        text: {{ tq "open" }}
        onClicked: root.launch(rowItem.app)
      }
      Button {
        visible: rowItem.app.removable
        text: {{ tq "remove" }}
        enabled: !root.running
        onClicked: root.ask([rowItem.app.id], true)
      }
      Button {
        visible: !rowItem.app.installed
        text: {{ tq "install" }}
        primary: true
        enabled: !root.running
        onClicked: root.ask([rowItem.app.id], false)
      }
    }
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: Math.min(940, (screen ? screen.width : 1280) * 0.92)
    implicitHeight: Math.min(680, (screen ? screen.height : 900) * 0.88)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-apps"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      anchors.fill: parent
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: {
        if (root.plan) root.plan = null
        else if (root.profile !== "") root.profile = ""
        else root.close()
      }

      ColumnLayout {
        anchors.fill: parent
        anchors.margins: 18
        spacing: 12

        // Where: profiles, every app, what's installed; and a search.
        RowLayout {
          Layout.fillWidth: true
          spacing: 8
          Caption { text: {{ tq "title" }}.toUpperCase() }
          Item { implicitWidth: 12 }
          Repeater {
            model: [["profiles", {{ tq "view.profiles" }}], ["all", {{ tq "view.all" }}], ["installed", {{ tq "view.installed" }}]]
            Button {
              required property var modelData
              text: modelData[1]
              primary: root.view === modelData[0] && root.profile === ""
              onClicked: {
                root.view = modelData[0]
                root.profile = ""
              }
            }
          }
          Item { Layout.fillWidth: true }
          TextField {
            id: search
            Layout.preferredWidth: 240
            placeholder: {{ tq "search" }}
            onTextChanged: {
              root.query = text
              if (text !== "") {
                root.profile = ""
                if (root.view === "profiles") root.view = "all"
              }
            }
          }
        }

        // --- profiles ---------------------------------------------------------------
        Flickable {
          id: cards
          visible: root.view === "profiles" && root.profile === ""
          Layout.fillWidth: true
          Layout.fillHeight: true
          clip: true
          contentHeight: grid.implicitHeight
          boundsBehavior: Flickable.StopAtBounds
        GridLayout {
          id: grid
          width: cards.width
          columns: 2
          rowSpacing: 10
          columnSpacing: 10

          Repeater {
            model: root.profiles
            Rectangle {
              id: card
              required property var modelData
              readonly property var members: modelData.apps.map(id => root.app(id)).filter(a => a)
              readonly property int missing: members.filter(a => !a.installed).length
              Layout.fillWidth: true
              Layout.preferredHeight: 128
              readonly property bool isChosen: !!root.chosen[modelData.id]
              radius: Theme.radius
              color: ca.containsMouse ? Theme.surface : Theme.bg
              border.color: isChosen ? Theme.accent : Theme.border
              border.width: isChosen ? 2 : 1
              MouseArea {
                id: ca
                anchors.fill: parent
                hoverEnabled: true
                cursorShape: Qt.PointingHandCursor
                onClicked: {
                  const p = {}
                  for (const a of card.members) p[a.id] = !a.installed
                  root.picked = p
                  root.profile = card.modelData.id
                }
              }
              ColumnLayout {
                anchors.fill: parent
                anchors.margins: 14
                spacing: 6
                RowLayout {
                  spacing: 10
                  Glyph {
                    text: String.fromCodePoint(card.modelData.glyph || 0xF003B)
                    color: Theme.accentText
                    font.pointSize: 18
                  }
                  Label { text: card.modelData.name; font.bold: true; font.pointSize: 12; Layout.fillWidth: true }
                  // Chosen with others: several profiles installed together.
                  Glyph {
                    visible: card.missing > 0
                    text: String.fromCodePoint(card.isChosen ? 0xF0133 : 0xF0130) // check circle, empty circle
                    color: card.isChosen ? Theme.accentText : Theme.fgSubtle
                    font.pointSize: 16
                    MouseArea {
                      anchors.fill: parent
                      anchors.margins: -6
                      cursorShape: Qt.PointingHandCursor
                      onClicked: {
                        const c = Object.assign({}, root.chosen)
                        c[card.modelData.id] = !c[card.modelData.id]
                        root.chosen = c
                      }
                    }
                  }
                }
                Caption {
                  text: card.modelData.description
                  wrapMode: Text.Wrap
                  maximumLineCount: 2
                  elide: Text.ElideRight
                  Layout.fillWidth: true
                  Layout.preferredWidth: 0
                }
                Item { Layout.fillHeight: true }
                RowLayout {
                  Layout.fillWidth: true
                  spacing: 6
                  // What it brings, by name.
                  Label {
                    text: card.members.map(a => a.name).join(", ")
                    color: Theme.fgMuted
                    elide: Text.ElideRight
                    Layout.fillWidth: true
                  }
                  Caption {
                    visible: card.missing === 0
                    text: {{ tq "all_installed" }}
                    color: Theme.accentText
                  }
                  Button {
                    visible: card.missing > 0
                    text: {{ tq "install" }}
                    primary: true
                    enabled: !root.running
                    onClicked: root.ask([card.modelData.id], false)
                  }
                }
              }
            }
          }
        }

        }

        // --- a profile's apps, each with a box -------------------------------------------
        ColumnLayout {
          visible: root.profile !== ""
          Layout.fillWidth: true
          Layout.fillHeight: true
          spacing: 8
          readonly property var prof: root.profiles.find(p => p.id === root.profile) || null
          RowLayout {
            Layout.fillWidth: true
            Button { text: "←"; onClicked: root.profile = "" }
            Label { text: parent.parent.prof ? parent.parent.prof.name : ""; font.bold: true; font.pointSize: 12 }
            Item { Layout.fillWidth: true }
            Button {
              text: {{ tq "install_picked" }}
              primary: true
              enabled: !root.running && Object.keys(root.picked).some(k => root.picked[k])
              onClicked: root.ask(Object.keys(root.picked).filter(k => root.picked[k]), false)
            }
          }
          ListView {
            Layout.fillWidth: true
            Layout.fillHeight: true
            clip: true
            spacing: 2
            model: parent.prof ? parent.prof.apps.map(id => root.app(id)).filter(a => a) : []
            delegate: RowLayout {
              required property var modelData
              width: ListView.view.width
              spacing: 10
              Toggle {
                checked: modelData.installed || !!root.picked[modelData.id]
                enabled: !modelData.installed
                opacity: modelData.installed ? 0.5 : 1
                onToggled: on => {
                  const p = Object.assign({}, root.picked)
                  p[modelData.id] = on
                  root.picked = p
                }
              }
              AppRow { app: modelData; Layout.fillWidth: true }
            }
          }
        }

        // --- every app, or what's installed ----------------------------------------------
        ListView {
          id: all
          visible: root.view !== "profiles" && root.profile === ""
          Layout.fillWidth: true
          Layout.fillHeight: true
          clip: true
          spacing: 2
          model: root.shownApps
          delegate: ColumnLayout {
            required property var modelData
            required property int index
            width: ListView.view.width
            spacing: 2
            // Its kind, over the first of each.
            Caption {
              visible: index === 0 || root.shownApps[index - 1].category !== modelData.category
              Layout.topMargin: index === 0 ? 0 : 10
              text: (root.categories.find(c => c[0] === modelData.category) || [modelData.category, modelData.category])[1].toUpperCase()
            }
            AppRow { app: modelData; Layout.fillWidth: true }
          }
          Label {
            anchors.centerIn: parent
            visible: !root.loading && root.shownApps.length === 0
            text: root.view === "installed" ? {{ tq "none_installed" }} : {{ tq "none_found" }}
            color: Theme.fgSubtle
          }
        }

        // --- several profiles chosen: all at once --------------------------------------------
        RowLayout {
          visible: root.view === "profiles" && root.profile === "" && root.chosenIds.length > 0 && !root.plan && !root.running
          Layout.fillWidth: true
          spacing: 10
          Label {
            text: {{ tq "chosen" }}.arg(root.chosenIds.map(id => root.profiles.find(p => p.id === id).name).join(" + "))
            elide: Text.ElideRight
            Layout.fillWidth: true
          }
          Button { text: {{ tq "clear" }}; onClicked: root.chosen = {} }
          Button {
            text: {{ tq "install_chosen" }}
            primary: true
            onClicked: root.ask(root.chosenIds, false)
          }
        }

        // --- what's about to happen, or happening -----------------------------------------
        Rectangle {
          visible: !!root.plan || root.running || root.result !== ""
          Layout.fillWidth: true
          implicitHeight: sheet.implicitHeight + 24
          radius: Theme.radius
          color: Theme.bg
          border.color: root.failed ? Theme.danger : Theme.accent
          border.width: 1

          ColumnLayout {
            id: sheet
            x: 12
            y: 12
            width: parent.width - 24
            spacing: 8

            // Asking.
            RowLayout {
              visible: !!root.plan
              Layout.fillWidth: true
              spacing: 10
              ColumnLayout {
                spacing: 2
                Layout.fillWidth: true
                Label {
                  text: root.plan && !root.plan.loading && !root.plan.error
                    ? (root.planRemove ? {{ tq "remove_title" }} : {{ tq "install_title" }}).arg(root.names(root.plan.apps || []))
                    : ""
                  font.bold: true
                  wrapMode: Text.Wrap
                  Layout.fillWidth: true
                  Layout.preferredWidth: 0
                }
                Caption { text: root.summary(root.plan) }
              }
              Button {
                visible: !!root.plan && !root.plan.loading && !root.plan.error && (root.plan.packages || []).length > 0
                text: root.details ? {{ tq "hide_details" }} : {{ tq "see_details" }}
                onClicked: root.details = !root.details
              }
              Button { text: {{ tq "cancel" }}; onClicked: root.plan = null }
              Button {
                text: root.planRemove ? {{ tq "remove" }} : {{ tq "install" }}
                primary: true
                enabled: !!root.plan && !root.plan.loading && !root.plan.error && (root.plan.apps || []).length > 0
                onClicked: root.go()
              }
            }
            // The detail: every package, and what stays.
            Flickable {
              visible: !!root.plan && root.details
              Layout.fillWidth: true
              Layout.preferredHeight: Math.min(150, detailText.implicitHeight)
              clip: true
              contentHeight: detailText.implicitHeight
              Caption {
                id: detailText
                width: parent.width
                font.family: Theme.fontMono
                wrapMode: Text.Wrap
                text: !root.plan || root.plan.loading || root.plan.error ? ""
                  : (root.plan.packages || []).map(p => typeof p === "string" ? p : p.name + " " + p.version).join("\n")
                    + ((root.plan.kept || []).length ? "\n" + root.plan.kept.map(root.keptWhy).join("\n") : "")
                    + ((root.plan.flatpaks || []).length ? "\nFlathub: " + root.plan.flatpaks.join(", ") : "")
              }
            }
            // Plugins that show what they can do first.
            Repeater {
              model: root.plan && root.plan.review ? root.plan.review : []
              RowLayout {
                required property string modelData
                Caption { text: {{ tq "review" }}.arg(modelData); Layout.fillWidth: true }
                Button { text: {{ tq "open_plugins" }}; onClicked: root.review(modelData) }
              }
            }

            // Doing it, and done.
            RowLayout {
              visible: root.running || root.result !== ""
              Layout.fillWidth: true
              spacing: 10
              ColumnLayout {
                spacing: 2
                Layout.fillWidth: true
                Label {
                  text: root.running ? root.stepText(root.step) : root.result
                  color: root.failed ? Theme.danger : Theme.fg
                  font.bold: true
                  wrapMode: Text.Wrap
                  Layout.fillWidth: true
                  Layout.preferredWidth: 0
                }
                Caption {
                  visible: root.running
                  text: root.line
                  font.family: Theme.fontMono
                  elide: Text.ElideRight
                  Layout.fillWidth: true
                }
              }
              Button {
                visible: !root.running
                text: {{ tq "ok" }}
                onClicked: root.result = ""
              }
            }
          }
        }
      }
    }
  }
}
