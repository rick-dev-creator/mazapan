#%PAM-1.0
# Generated by mazapan (plugin {{ plugin }}): polkit's own (/usr/lib/pam.d/polkit-1)
# with a finger first: allowing a system change takes a finger or the
# password. With the lid closed (the reader under it) the finger is skipped.
auth       [success=1 default=ignore]  pam_exec.so quiet /usr/bin/sh -c "grep -qs closed /proc/acpi/button/lid/*/state"
auth       sufficient   pam_fprintd.so
auth       include      system-auth
account    include      system-auth
password   include      system-auth
session    include      system-auth
