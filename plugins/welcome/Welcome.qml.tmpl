// Generated by myarch (plugin {{ plugin }}).
//
// The welcome, on the first login (and from the palette, any time): the
// language, the keyboard (tried right there), the time zone, Wi-Fi if
// there's no connection, the look, and the apps by profile, one screen
// each, what the machine can tell already filled in. The machine's first
// apply leaves the marker (~/.local/state/myarch/welcome.json); where it
// was is kept there, so the shell reloading on the way (a new language, a
// new theme) picks up at the same step. Esc closes it for this session;
// "Skip" for good (the palette opens it again).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import Quickshell.Networking
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null

  readonly property string stateFile: Quickshell.env("HOME") + "/.local/state/myarch/welcome.json"
  readonly property string logFile: Quickshell.env("HOME") + "/.local/state/myarch/welcome.log"
  readonly property var steps: ["language", "keyboard", "region", "network", "look", "apps", "ready"]
  property string step: "language"
  property bool done: true
  property string problem: ""

  // Across reloads (not logins): closed for this session; open again once
  // the reload an apply asked for is over.
  PersistentProperties {
    id: session
    reloadableId: "myarch-welcome"
    property bool dismissed: false
    property bool reopen: false
    onLoaded: if (store.loaded_) root.maybeOpen()
  }

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    session.reopen = false
    probe.running = true
    kbNow.running = true
    lastError.running = true
    stepAt = Date.now() + 800 // opening: a longer while
    open = true
    Qt.callLater(() => card.forceActiveFocus())
  }

  function close() {
    open = false
    session.dismissed = true
  }

  // Clicks right after it opens, or a step changes, aren't taken: after a
  // reload it opens under the pointer, and a double click would land on
  // the next step's buttons.
  property double stepAt: 0
  function settled() { return Date.now() - stepAt > 400 }

  FileView {
    id: store
    property bool loaded_: false
    path: root.stateFile
    printErrors: false
    atomicWrites: true
    onLoaded: {
      try {
        const o = JSON.parse(text())
        if (root.steps.includes(o.step)) root.step = o.step
        root.done = o.done === true
      } catch (e) {}
      loaded_ = true
      root.maybeOpen()
    }
    // No marker: not a first boot (the palette opens it).
    onLoadFailed: {
      loaded_ = true
      root.maybeOpen()
    }
  }

  function maybeOpen() {
    if (session.reopen || (!done && !session.dismissed)) firstRun.start()
  }
  // Once the desktop is up.
  Timer {
    id: firstRun
    interval: 1500
    onTriggered: if (!root.open) root.show()
  }
  function save() {
    store.setText(JSON.stringify({ step: step, done: done }))
  }

  function go(s) {
    step = s
    stepAt = Date.now()
    problem = ""
    save()
  }
  // Wi-Fi only when there's no connection; the apps not when the installer
  // asked already.
  function shown(s) { return (s !== "network" || !online) && (s !== "apps" || !fromInstaller) }
  function next() {
    let i = steps.indexOf(step) + 1
    while (i < steps.length - 1 && !shown(steps[i])) i++
    go(steps[Math.min(i, steps.length - 1)])
  }
  function back() {
    let i = steps.indexOf(step) - 1
    while (i > 0 && !shown(steps[i])) i--
    go(steps[Math.max(i, 0)])
  }
  function finish() {
    done = true
    step = "language"
    save()
    open = false
  }

  // --- what's there ----------------------------------------------------------------

  property string language: {{ quote lang_code }}
  property string layout: ""
  property string variant: ""
  property string timezone: ""
  property string suggested: ""
  property bool detecting: false
  property var zones: []
  property var themes: []
  property string theme: ""
  property string themeNow: ""
  property var profiles: []
  property var apps: []
  property var chosen: ({})
  property bool installing: false

  Process {
    id: probe
    command: ["sh", "-c", 'echo "tz:$(timedatectl show -p Timezone --value 2>/dev/null)"; '
      + 'echo "zones:$(timedatectl list-timezones 2>/dev/null | tr "\\n" " ")"; '
      + 'echo "themes:$(myarch themes --json 2>/dev/null | tr -d "\\n")"; '
      + 'echo "apps:$(myarch apps list --json 2>/dev/null | tr -d "\\n")"']
    stdout: StdioCollector {
      onStreamFinished: {
        const get = k => (text.split("\n").find(l => l.startsWith(k + ":")) || "").slice(k.length + 1)
        root.timezone = get("tz").trim()
        root.zones = get("zones").trim().split(" ").filter(z => z !== "")
        try {
          const t = JSON.parse(get("themes"))
          root.themes = t.themes || []
          root.theme = t.current || ""
          root.themeNow = root.theme
        } catch (e) {}
        try {
          const a = JSON.parse(get("apps"))
          root.profiles = a.profiles || []
          root.apps = a.apps || []
          // The basic one, preselected where something of it is missing.
          if (!root.installing) {
            const c = {}
            for (const p of root.profiles) if (p.basic && p.apps.some(id => !(root.apps.find(x => x.id === id) || {}).installed)) c[p.id] = true
            root.chosen = c
          }
        } catch (e) {}
      }
    }
  }

  // The keyboard as Hyprland has it now (hypr-base's settings).
  Process {
    id: kbNow
    command: ["sh", "-c", "grep -E '^ *kb_(layout|variant) *=' ~/.config/hypr/hyprland.lua | sed -E 's/.*\"(.*)\".*/\\1/'"]
    stdout: StdioCollector {
      onStreamFinished: {
        const l = text.split("\n")
        root.layout = l[0] || "us"
        root.variant = l[1] || ""
      }
    }
  }

  // What the last apply said went wrong (a language, a theme: the shell
  // reloaded in between).
  Process {
    id: lastError
    command: ["sh", "-c", 'grep "^myarch:" "$0" 2>/dev/null | tail -n 1 | sed "s/^myarch: //"', root.logFile]
    stdout: StdioCollector { onStreamFinished: if (text.trim() !== "") root.problem = {{ tq "apply_failed" }}.arg(text.trim()) }
  }

  // Every layout and variant xkb knows, for the search.
  property var allLayouts: []
  FileView {
    path: "/usr/share/X11/xkb/rules/base.lst"
    printErrors: false
    onLoaded: {
      const out = []
      let section = ""
      for (const line of text().split("\n")) {
        if (line.startsWith("! ")) { section = line.slice(2).trim(); continue }
        const m = /^\s+(\S+)\s+(.*)$/.exec(line)
        if (!m) continue
        if (section === "layout") out.push({ layout: m[1], variant: "", name: m[2] })
        else if (section === "variant") {
          const v = /^(\S+):\s*(.*)$/.exec(m[2])
          if (v) out.push({ layout: v[1], variant: m[1], name: v[2] })
        }
      }
      root.allLayouts = out
    }
  }

  // The common ones, in the desktop's language (searched too).
  readonly property var commonLayouts: [
    ["us", "", {{ tq "kb.us" }}], ["us", "intl", {{ tq "kb.us_intl" }}], ["latam", "", {{ tq "kb.latam" }}],
    ["es", "", {{ tq "kb.es" }}], ["gb", "", {{ tq "kb.gb" }}], ["de", "", {{ tq "kb.de" }}], ["fr", "", {{ tq "kb.fr" }}],
    ["it", "", {{ tq "kb.it" }}], ["pt", "", {{ tq "kb.pt" }}], ["br", "", {{ tq "kb.br" }}],
  ].map(c => ({ layout: c[0], variant: c[1], name: c[2] }))

  readonly property var kbShown: {
    const q = kbSearch.text.toLowerCase().trim()
    if (q === "") return commonLayouts
    const match = k => (k.name + " " + k.layout + " " + k.variant).toLowerCase().includes(q)
    const mine = commonLayouts.filter(match)
    return mine.concat(allLayouts.filter(k => match(k) && !mine.some(c => c.layout === k.layout && c.variant === k.variant))).slice(0, 80)
  }
  readonly property var zonesShown: {
    const q = tzSearch.text.toLowerCase().trim().replace(/ /g, "_")
    return q === "" ? [] : zones.filter(z => z.toLowerCase().includes(q)).slice(0, 60)
  }

  readonly property bool online: Networking.devices.values.some(d => d.connected)
  readonly property var wifi: Networking.devices.values.find(d => d.type === DeviceType.Wifi) ?? null

  // Only what's for this machine, and with the keys as they are: from
  // every plugin's palette actions.
  readonly property var actions: {{ json actions }}
  readonly property var keys: [
    ["panel palette", {{ tq "k.palette" }}], ["foot", {{ tq "k.terminal" }}], ["panel apps", {{ tq "k.apps" }}],
    ["panel themes", {{ tq "k.themes" }}], ["panel modes", {{ tq "k.modes" }}], ["panel history", {{ tq "k.history" }}],
    ["panel notifications", {{ tq "k.notifications" }}], ["window.close", {{ tq "k.close" }}],
  ].map(k => {
    // The palette's is a key only (no command): by its plugin.
    const a = k[0] === "panel palette" ? actions.find(x => x.plugin === "palette" && x.key && !x.run)
      : actions.find(x => x.key && x.run && (x.run === k[0] || x.run.includes(k[0])))
    return a ? [a.key, k[1]] : null
  }).filter(k => k)

  // --- taking effect ----------------------------------------------------------------

  // An apply that reloads the shell (language, theme): detached, the step
  // kept, and this opened again once it's back.
  function applyReloading(args) {
    session.reopen = true
    Quickshell.execDetached(["sh", "-c", 'mkdir -p ~/.local/state/myarch; myarch apply "$@" > "$0" 2>&1', root.logFile].concat(args))
  }

  function setLanguage(code) {
    if (code === language) return
    language = code
    go("keyboard")
    applyReloading(["--language=" + code])
  }

  // The keyboard: one apply at a time (the last pick wins), its result
  // read back.
  property var kbWanted: null
  function setKeyboard(l, v) {
    layout = l
    variant = v
    kbWanted = [l, v]
    if (!kbApply.running) kbNext()
  }
  function kbNext() {
    if (!kbWanted) return
    const [l, v] = kbWanted
    kbWanted = null
    // TOML strings (JSON's are): xkb's names are plain, but never trusted to be.
    kbApply.command = ["myarch", "apply", "--set=hypr-base.kb_layout=" + JSON.stringify(l), "--set=hypr-base.kb_variant=" + JSON.stringify(v)]
    kbApply.running = true
  }
  Process {
    id: kbApply
    stderr: StdioCollector { id: kbErr }
    onExited: code => {
      if (code !== 0) root.problem = {{ tq "apply_failed" }}.arg(kbErr.text.replace(/^myarch: /, "").trim())
      if (root.kbWanted) root.kbNext()
      else kbNow.running = true
    }
  }

  // The time zone: timedatectl asks polkit (the password dialog); shown as
  // it is afterwards, not as asked.
  function setZone(z) {
    if (zoneSet.running) return
    zoneSet.command = ["timedatectl", "set-timezone", z]
    zoneSet.running = true
  }
  Process {
    id: zoneSet
    onExited: code => {
      if (code !== 0) root.problem = {{ tq "tz_failed" }}
      zoneNow.running = true
    }
  }
  Process {
    id: zoneNow
    command: ["timedatectl", "show", "-p", "Timezone", "--value"]
    stdout: StdioCollector { onStreamFinished: root.timezone = text.trim() }
  }

  // The time zone from where the connection is (a question to ipinfo.io,
  // only when asked).
  function detectZone() {
    detecting = true
    detect.running = true
  }
  Process {
    id: detect
    command: ["curl", "-fsS", "--max-time", "6", "https://ipinfo.io/timezone"]
    stdout: StdioCollector {
      onStreamFinished: {
        const z = text.trim()
        root.suggested = root.zones.includes(z) ? z : ""
      }
    }
    onExited: code => {
      root.detecting = false
      if (code !== 0 || root.suggested === "") root.problem = {{ tq "tz_undetected" }}
      else if (root.suggested === root.timezone) root.problem = {{ tq "tz_already" }}
    }
  }

  // The apps chosen in the installer (myarch install leaves them in
  // first-apps): installed as soon as there's a connection, once (the file
  // is then marked "#started", and still says the installer asked).
  readonly property string firstAppsFile: Quickshell.env("HOME") + "/.local/state/myarch/first-apps"
  property var firstApps: []
  property bool fromInstaller: false
  FileView {
    path: root.firstAppsFile
    printErrors: false
    onLoaded: {
      const lines = text().split("\n")
      const ids = lines.filter(x => /^[a-z0-9][a-z0-9-]*$/.test(x))
      root.fromInstaller = ids.length > 0
      root.firstApps = lines[0] === "#started" ? [] : ids
      root.installFirst()
    }
  }
  onOnlineChanged: installFirst()
  function installFirst() {
    if (firstApps.length === 0 || !online || installing) return
    const ids = firstApps
    firstApps = []
    Quickshell.execDetached(["sh", "-c", '{ echo "#started"; cat "$0"; } > "$0.new" && mv "$0.new" "$0"', firstAppsFile])
    installIds(ids)
  }

  // While it's open, whether pkexec is waiting for a password (the apps it
  // started installing, even before a reload): the polkit agent's dialog is
  // up, and this steps aside.
  property bool asking: false
  Timer {
    interval: 700
    repeat: true
    running: root.open
    onTriggered: if (!askProbe.running) askProbe.running = true
    onRunningChanged: if (!running) root.asking = false
  }
  Process {
    id: askProbe
    // -U: the real user (pkexec runs setuid, as root).
    command: ["pgrep", "-U", Quickshell.env("USER") || "", "-x", "pkexec"]
    onExited: code => {
      const was = root.asking
      root.asking = code === 0
      if (was && !root.asking) Qt.callLater(() => card.forceActiveFocus())
    }
  }

  function installChosen() {
    const ids = Object.keys(chosen).filter(k => chosen[k])
    chosen = {}
    installIds(ids)
  }
  function installIds(ids) {
    if (ids.length === 0 || installing) return
    installing = true
    // As the Apps menu does it (it shows the progress, and picks it up).
    Quickshell.execDetached(["sh", "-c", 'dir=$0; ok=$1; bad=$2; title=$3; shift 3; mkdir -p "$dir"; '
      + 'echo "START welcome" > "$dir/run.log"; myarch apps install --gui "$@" >> "$dir/run.log" 2>&1; code=$?; '
      + 'echo "DONE $code" >> "$dir/run.log"; '
      + 'if [ "$code" = 0 ]; then notify-send -a "$title" -i system-software-install "$ok"; '
      + 'elif ! grep -q "^fail cancelled" "$dir/run.log"; then notify-send -a "$title" -u critical -i dialog-warning "$bad"; fi',
      Quickshell.env("HOME") + "/.local/state/myarch/apps", {{ tq "apps_done" }}, {{ tq "apps_failed" }}, {{ tq "title" }}].concat(ids))
  }

  function primary() {
    if (!settled()) return
    if (step === "apps" && online) installChosen()
    // The theme chosen, applied once on the way out (the shell reloads).
    if (step === "look" && theme !== themeNow) {
      next()
      applyReloading(["--theme=" + theme])
      return
    }
    if (step === "ready") finish()
    else next()
  }

  // --- the screen -------------------------------------------------------------------

  component Choice: Rectangle {
    id: choice
    property string text: ""
    property string detail: ""
    property bool selected: false
    signal picked()
    Layout.fillWidth: true
    implicitHeight: detail !== "" ? 52 : 40
    radius: Theme.radius
    color: selected ? Theme.selection : ch.containsMouse ? Theme.surface : "transparent"
    border.color: selected ? Theme.accent : "transparent"
    border.width: 1
    MouseArea {
      id: ch
      anchors.fill: parent
      hoverEnabled: true
      cursorShape: Qt.PointingHandCursor
      onClicked: if (root.settled()) choice.picked()
    }
    ColumnLayout {
      anchors.fill: parent
      anchors.leftMargin: 14
      anchors.rightMargin: 14
      spacing: 0
      Item { Layout.fillHeight: true }
      Label { text: choice.text; font.bold: choice.selected; elide: Text.ElideRight; Layout.fillWidth: true }
      Caption { visible: choice.detail !== ""; text: choice.detail; elide: Text.ElideRight; Layout.fillWidth: true }
      Item { Layout.fillHeight: true }
    }
  }

  onStepChanged: if (open) Qt.callLater(() => card.forceActiveFocus())

  PanelWindow {
    id: win
    // Out of the way while the password is asked for: the dialog gets the
    // keys (a layer that has them keeps them), and it's back right after.
    visible: root.open && !root.asking
    screen: root.screenAtOpen
    anchors { top: true; bottom: true; left: true; right: true }
    color: Qt.alpha(Theme.bg, 0.8)
    exclusionMode: ExclusionMode.Ignore
    // Top, not Overlay: what asks for a password on the way (the apps it
    // installs, pkexec through the polkit agent) stays above it.
    WlrLayershell.layer: WlrLayer.Top
    // "myarch-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "myarch-panel-welcome"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      anchors.centerIn: parent
      width: Math.min(760, parent.width - 40)
      height: Math.min(560, parent.height - 40)
      radius: Theme.radius
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      focus: true
      Keys.onEscapePressed: root.close()
      Keys.onReturnPressed: root.primary()
      Keys.onEnterPressed: root.primary()

      ColumnLayout {
        anchors.fill: parent
        anchors.margins: 28
        spacing: 16

        // Where in it: a dot a step.
        Row {
          Layout.alignment: Qt.AlignHCenter
          spacing: 8
          Repeater {
            model: root.steps.filter(s => root.shown(s))
            Rectangle {
              required property string modelData
              width: root.step === modelData ? 22 : 8
              height: 8
              radius: 4
              color: root.step === modelData ? Theme.accent : Theme.border
              Behavior on width { NumberAnimation { duration: Theme.motion ? 150 : 0 } }
            }
          }
        }

        Label {
          text: root.step === "language" ? {{ tq "t.language" }} : root.step === "keyboard" ? {{ tq "t.keyboard" }}
            : root.step === "region" ? {{ tq "t.region" }} : root.step === "network" ? {{ tq "t.network" }}
            : root.step === "look" ? {{ tq "t.look" }} : root.step === "apps" ? {{ tq "t.apps" }} : {{ tq "t.ready" }}
          font.pointSize: 18
          font.bold: true
          Layout.alignment: Qt.AlignHCenter
        }
        Caption {
          text: root.step === "language" ? {{ tq "d.language" }} : root.step === "keyboard" ? {{ tq "d.keyboard" }}
            : root.step === "region" ? {{ tq "d.region" }} : root.step === "network" ? {{ tq "d.network" }}
            : root.step === "look" ? {{ tq "d.look" }} : root.step === "apps" ? (root.online ? {{ tq "d.apps" }} : {{ tq "d.apps_offline" }}) : {{ tq "d.ready" }}
          horizontalAlignment: Text.AlignHCenter
          wrapMode: Text.Wrap
          Layout.fillWidth: true
          Layout.preferredWidth: 0
        }

        // --- the step -------------------------------------------------------------
        Item {
          Layout.fillWidth: true
          Layout.fillHeight: true

          // Language: in its own name.
          ColumnLayout {
            visible: root.step === "language"
            anchors.horizontalCenter: parent.horizontalCenter
            width: 320
            spacing: 6
            Repeater {
              model: [["en", "English"], ["es", "Español"]]
              Choice {
                required property var modelData
                text: modelData[1]
                selected: root.language === modelData[0]
                onPicked: root.setLanguage(modelData[0])
              }
            }
          }

          // Keyboard: the common ones, then all of them; tried in a field.
          ColumnLayout {
            visible: root.step === "keyboard"
            anchors.fill: parent
            spacing: 8
            TextField {
              id: kbSearch
              Layout.fillWidth: true
              placeholder: {{ tq "kb.search" }}
              onAccepted: if (root.kbShown.length > 0) root.setKeyboard(root.kbShown[0].layout, root.kbShown[0].variant)
            }
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.kbShown
              delegate: Choice {
                required property var modelData
                width: ListView.view.width
                text: modelData.name
                detail: modelData.layout + (modelData.variant ? " · " + modelData.variant : "")
                selected: root.layout === modelData.layout && root.variant === modelData.variant
                onPicked: root.setKeyboard(modelData.layout, modelData.variant)
              }
            }
            Caption {
              visible: root.layout.includes(",")
              text: {{ tq "kb.several" }}.arg(root.layout)
              Layout.fillWidth: true
            }
            TextField {
              Layout.fillWidth: true
              placeholder: {{ tq "kb.try" }}
            }
          }

          // Region: the time zone, suggested from where the connection is.
          ColumnLayout {
            visible: root.step === "region"
            anchors.fill: parent
            spacing: 8
            RowLayout {
              Layout.fillWidth: true
              Label { text: {{ tq "tz.now" }}.arg(root.timezone || "UTC"); Layout.fillWidth: true }
              Button {
                visible: root.online && root.suggested === ""
                enabled: !root.detecting
                text: root.detecting ? {{ tq "tz.detecting" }} : {{ tq "tz.detect" }}
                onClicked: if (root.settled()) root.detectZone()
              }
              Button {
                visible: root.suggested !== "" && root.suggested !== root.timezone
                text: {{ tq "tz.use" }}.arg(root.suggested)
                primary: true
                onClicked: if (root.settled()) root.setZone(root.suggested)
              }
            }
            TextField {
              id: tzSearch
              Layout.fillWidth: true
              placeholder: {{ tq "tz.search" }}
              onAccepted: if (root.zonesShown.length > 0) root.setZone(root.zonesShown[0])
            }
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.zonesShown
              delegate: Choice {
                required property string modelData
                width: ListView.view.width
                text: modelData.replace(/_/g, " ")
                selected: root.timezone === modelData
                onPicked: root.setZone(modelData)
              }
            }
          }

          // Wi-Fi: the networks in range; a password where one's needed.
          ColumnLayout {
            id: netStep
            visible: root.step === "network"
            anchors.fill: parent
            spacing: 8
            property var asking: null
            property string failed: ""
            onAskingChanged: if (asking) Qt.callLater(() => pass.focusInput())

            // Looking for networks while this is shown.
            Binding {
              target: root.wifi
              when: !!root.wifi
              property: "scannerEnabled"
              value: root.open && root.step === "network"
            }
            Connections {
              target: root.wifi
              ignoreUnknownSignals: true
              function onConnectionFailed() { netStep.failed = {{ tq "net.failed" }} }
            }

            RowLayout {
              visible: !!root.wifi
              Layout.fillWidth: true
              Label { text: {{ tq "net.wifi" }}; Layout.fillWidth: true }
              Toggle {
                checked: Networking.wifiEnabled
                onToggled: on => Networking.wifiEnabled = on
              }
            }
            ListView {
              id: nets
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.wifi && Networking.wifiEnabled ? root.wifi.networks.values.slice().sort((a, b) => b.signalStrength - a.signalStrength) : []
              delegate: Choice {
                required property var modelData
                width: ListView.view.width
                text: modelData.name
                detail: modelData.connected ? {{ tq "net.connected" }} : ""
                selected: modelData.connected
                onPicked: {
                  netStep.failed = ""
                  if (modelData.connected) return
                  if (modelData.known || modelData.security === WifiSecurityType.Open || modelData.security === WifiSecurityType.Unknown) modelData.connect()
                  else netStep.asking = modelData
                }
              }
            }
            Label {
              visible: !root.wifi || !Networking.wifiEnabled
              Layout.alignment: Qt.AlignHCenter
              text: !root.wifi ? {{ tq "net.none" }} : {{ tq "net.off" }}
              color: Theme.fgSubtle
            }
            Caption {
              visible: netStep.failed !== ""
              text: netStep.failed
              color: Theme.danger
            }
            TextField {
              id: pass
              visible: !!netStep.asking
              Layout.fillWidth: true
              echoMode: TextInput.Password
              placeholder: netStep.asking ? {{ tq "net.password" }}.arg(netStep.asking.name) : ""
              onAccepted: {
                if (netStep.asking && text !== "") netStep.asking.connectWithPsk(text)
                netStep.asking = null
                text = ""
              }
            }
          }

          // Look: the themes, by their colors.
          GridLayout {
            visible: root.step === "look"
            anchors.fill: parent
            columns: 3
            rowSpacing: 8
            columnSpacing: 8
            Repeater {
              model: root.themes.slice(0, 12)
              Rectangle {
                id: tcard
                required property var modelData
                Layout.fillWidth: true
                Layout.fillHeight: true
                radius: Theme.radius
                color: modelData.colors ? modelData.colors.bg : Theme.bg
                border.color: root.theme === modelData.id ? Theme.accent : Theme.border
                border.width: root.theme === modelData.id ? 3 : 1
                MouseArea {
                  anchors.fill: parent
                  cursorShape: Qt.PointingHandCursor
                  onClicked: if (root.settled()) root.theme = tcard.modelData.id
                }
                ColumnLayout {
                  anchors.fill: parent
                  anchors.margins: 10
                  Text {
                    text: tcard.modelData.name
                    color: tcard.modelData.colors ? tcard.modelData.colors.fg : Theme.fg
                    font.family: Theme.fontMono
                    font.bold: true
                  }
                  Item { Layout.fillHeight: true }
                  Row {
                    spacing: 4
                    Repeater {
                      model: ["accent", "success", "warning", "danger", "info"]
                      Rectangle {
                        required property string modelData
                        width: 14
                        height: 14
                        radius: 7
                        color: tcard.modelData.colors ? tcard.modelData.colors[modelData] || "transparent" : "transparent"
                      }
                    }
                  }
                }
              }
            }
          }

          // Apps: the profiles, several at once (online: they're downloaded).
          GridLayout {
            visible: root.step === "apps"
            enabled: root.online && !root.installing
            opacity: enabled ? 1 : 0.5
            anchors.fill: parent
            columns: 2
            rowSpacing: 8
            columnSpacing: 8
            Repeater {
              model: root.profiles
              Choice {
                required property var modelData
                text: modelData.name
                detail: modelData.apps.map(id => (root.apps.find(a => a.id === id) || { name: id }).name).join(", ")
                selected: !!root.chosen[modelData.id]
                onPicked: {
                  const c = Object.assign({}, root.chosen)
                  c[modelData.id] = !c[modelData.id]
                  root.chosen = c
                }
              }
            }
          }

          // Ready: the few keys that matter (as they are here).
          GridLayout {
            visible: root.step === "ready"
            anchors.horizontalCenter: parent.horizontalCenter
            columns: 2
            rowSpacing: 10
            columnSpacing: 24
            Repeater {
              model: root.keys
              RowLayout {
                required property var modelData
                spacing: 12
                Rectangle {
                  implicitWidth: keyText.implicitWidth + 16
                  implicitHeight: 26
                  radius: Theme.radius
                  color: Theme.surface
                  border.color: Theme.border
                  Label { id: keyText; anchors.centerIn: parent; text: modelData[0]; font.family: Theme.fontMono }
                }
                Label { text: modelData[1] }
              }
            }
          }
        }

        Caption {
          visible: root.problem !== ""
          text: root.problem
          color: Theme.danger
          wrapMode: Text.Wrap
          Layout.fillWidth: true
          Layout.preferredWidth: 0
        }

        // --- moving on ----------------------------------------------------------------
        RowLayout {
          Layout.fillWidth: true
          Button {
            visible: root.step !== "language"
            text: {{ tq "back" }}
            onClicked: if (root.settled()) root.back()
          }
          Item { Layout.fillWidth: true }
          Button {
            visible: root.step !== "ready"
            text: {{ tq "skip" }}
            onClicked: if (root.settled()) root.finish()
          }
          Button {
            primary: true
            text: root.step === "ready" ? {{ tq "start" }}
              : root.step === "apps" && root.online && Object.keys(root.chosen).some(k => root.chosen[k]) ? {{ tq "install_continue" }} : {{ tq "continue" }}
            onClicked: root.primary()
          }
        }
      }
    }
  }
}
