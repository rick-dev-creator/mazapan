// Generated by mazapan (plugin {{ plugin }}): Bluetooth in the Control Center.
//
// A big switch (on, off, what's connected); its arrow opens the devices
// below the switches: one click connects or disconnects a paired one,
// pairs a new one (looking for new ones while they're shown). The switch
// never moves. No adapter: left out.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Bluetooth
import Quickshell.Io
import qs
import "../../components/kit"
import "../../components/control"

Tile {
  id: root

  readonly property var adapter: Bluetooth.defaultAdapter
  readonly property bool on: adapter !== null && adapter.enabled
  readonly property var devices: adapter ? adapter.devices.values : []
  readonly property var connected: devices.filter(d => d.connected)
  readonly property bool listing: ControlService.detail === list

  property bool shown: adapter !== null
  readonly property string pillGlyph: connected.length > 0 ? "󰂱" : ""

  // Files to a phone or computer, through Share (when it's on): a file
  // chooser, then sent to it.
  readonly property string shareBin: Quickshell.env("HOME") + "/.local/share/mazapan/bin/share"
  property bool canShare: false
  Process {
    running: true
    command: ["test", "-f", root.shareBin]
    onExited: code => root.canShare = code === 0
  }
  function takesFiles(d) { return d.paired && /phone|computer|tablet|pda/.test(d.icon || "") }
  function sendTo(d) {
    ControlService.close()
    Quickshell.execDetached(["sh", root.shareBin, "--to", d.address, "--choose"])
  }

  function deviceGlyph(d) {
    const icon = d.icon || ""
    if (/head(set|phones)|audio-card/.test(icon)) return "󰋋"
    if (/keyboard/.test(icon)) return "󰌌"
    if (/mouse|tablet/.test(icon)) return "󰍽"
    if (/phone/.test(icon)) return "󰄜"
    if (/gaming/.test(icon)) return "󰊴"
    if (/speaker|audio/.test(icon)) return "󰓃"
    return "󰂯"
  }
  function describe(d) {
    switch (d.state) {
    case BluetoothDeviceState.Connecting: return {{ tq "connecting" }}
    case BluetoothDeviceState.Disconnecting: return {{ tq "disconnecting" }}
    }
    if (d.pairing) return {{ tq "pairing" }}
    if (d.connected) return {{ tq "connected" }}
    if (d.paired) return {{ tq "paired" }}
    return {{ tq "new" }}
  }
  function choose(d) {
    if (d.connected) d.disconnect()
    else if (d.paired) d.connect()
    else { pairing.target = d; d.pair() }
  }
  // A new device once paired: trusted (it comes back on its own) and connected.
  Connections {
    id: pairing
    target: null
    function onPairedChanged() {
      if (!target || !target.paired) return
      target.trusted = true
      target.connect()
      pairing.target = null
    }
  }
  onListingChanged: if (adapter) adapter.discovering = listing && on

  glyph: !on ? "󰂲" : connected.length > 0 ? "󰂱" : "󰂯"
  title: "Bluetooth"
  detail: !on ? {{ tq "off_short" }}
    : connected.length > 0 ? connected.map(d => d.name).join(", ")
    : {{ tq "on_short" }}
  checked: on
  more: on
  expanded: listing
  onToggled: {
    if (!adapter) return
    if (adapter.enabled && listing) ControlService.detail = null
    adapter.enabled = !adapter.enabled
  }
  onOpened: ControlService.detail = listing ? null : list

  // The devices, below the switches.
  Component {
    id: list
    Group {
      title: "Bluetooth"
      Repeater {
        model: root.devices.filter(d => d.paired || d.connected || (root.adapter && root.adapter.discovering)).slice(0, 8)
        ListRow {
          required property var modelData
          Layout.fillWidth: true
          glyph: root.deviceGlyph(modelData)
          title: modelData.name || modelData.address
          detail: root.describe(modelData)
          active: modelData.connected
          onClicked: root.choose(modelData)
          // Send files to it (a phone, a computer): through Share.
          Rectangle {
            visible: root.canShare && root.takesFiles(modelData)
            anchors { right: parent.right; rightMargin: 4; verticalCenter: parent.verticalCenter }
            width: 28; height: 28; radius: Theme.radius
            color: sendArea.containsMouse ? Theme.surfaceRaised : "transparent"
            Glyph { anchors.centerIn: parent; text: "󰒖"; color: sendArea.containsMouse ? Theme.accentText : Theme.fgMuted }
            MouseArea {
              id: sendArea
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: root.sendTo(modelData)
            }
          }
        }
      }
      Caption {
        visible: root.devices.length === 0
        text: {{ tq "no_devices" }}
        font.letterSpacing: 0
      }
    }
  }
}
