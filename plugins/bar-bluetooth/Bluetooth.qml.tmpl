// Generated by mazapan (plugin {{ plugin }}).
//
// Bluetooth in the bar; click for the card: the adapter switch, devices
// (connected first, then paired, then new ones while looking for them) and
// a switch to look for new devices. Click a device to connect or disconnect
// it; a new one gets paired, trusted and connected. Right-click a paired
// device to forget it.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Bluetooth
import qs
import "../../components/kit"

BarItem {
  id: root

  readonly property var adapter: Bluetooth.defaultAdapter
  readonly property bool on: adapter !== null && adapter.enabled
  readonly property var devices: adapter ? adapter.devices.values : []
  readonly property var connected: devices.filter(d => d.connected)

  function deviceGlyph(d) {
    const icon = d.icon || ""
    if (/head(set|phones)|audio-card/.test(icon)) return "󰋋"
    if (/keyboard/.test(icon)) return "󰌌"
    if (/mouse|tablet/.test(icon)) return "󰍽"
    if (/phone/.test(icon)) return "󰄜"
    if (/gaming/.test(icon)) return "󰊴"
    if (/speaker|audio/.test(icon)) return "󰓃"
    return "󰂯"
  }

  function detail(d) {
    switch (d.state) {
    case BluetoothDeviceState.Connecting: return {{ tq "connecting" }}
    case BluetoothDeviceState.Disconnecting: return {{ tq "disconnecting" }}
    }
    if (d.pairing) return {{ tq "pairing" }}
    if (d.connected) return {{ tq "connected" }}
    if (d.paired) return {{ tq "paired" }}
    return {{ tq "new" }}
  }

  function choose(d) {
    if (d.connected) {
      d.disconnect()
    } else if (d.paired) {
      d.connect()
    } else {
      pairing.target = d
      d.pair()
    }
  }

  // Once a new device is paired: trust it (so it reconnects on its own) and
  // connect to it.
  Connections {
    id: pairing
    target: null
    function onPairedChanged() {
      if (!target || !target.paired) return
      target.trusted = true
      target.connect()
      pairing.target = null
    }
  }

  shown: adapter !== null || !{{ settings.hide_without_adapter }}
  open: popup.visible
  onClicked: popup.toggle()

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: !root.on ? "󰂲" : root.connected.length > 0 ? "󰂱" : "󰂯"
    color: root.connected.length > 0 ? Theme.accentText : root.on ? Theme.fgMuted : Theme.fgSubtle
  }

  Label {
    anchors.verticalCenter: parent.verticalCenter
    visible: root.connected.length > 1
    text: root.connected.length
  }

  BarPopup {
    id: popup
    owner: root
    cardWidth: 340
    // Stop looking for devices when the card closes.
    onVisibleChanged: if (!visible && root.adapter && root.adapter.discovering) root.adapter.discovering = false

    RowLayout {
      Layout.fillWidth: true
      Caption { text: {{ tq "bluetooth" }}.toUpperCase() }
      Item { Layout.fillWidth: true }
      Toggle {
        visible: root.adapter !== null
        checked: root.on
        onToggled: on => root.adapter.enabled = on
      }
    }

    Label {
      visible: root.adapter === null || !root.on
      text: root.adapter === null ? {{ tq "no_adapter" }} : {{ tq "off" }}
      color: Theme.fgMuted
    }

    ColumnLayout {
      visible: root.on
      Layout.fillWidth: true
      spacing: 0

      Label {
        visible: root.devices.length === 0
        text: {{ tq "no_devices" }}
        color: Theme.fgMuted
      }

      Repeater {
        // Connected, then paired, then new; new ones only while looking.
        model: root.devices
          .filter(d => d.paired || d.connected || root.adapter.discovering)
          .sort((a, b) => (b.connected - a.connected) || (b.paired - a.paired) || a.name.localeCompare(b.name))

        ListRow {
          required property var modelData
          glyph: root.deviceGlyph(modelData)
          title: modelData.name || modelData.address
          detail: root.detail(modelData)
          trailing: modelData.batteryAvailable ? `${Math.round(modelData.battery * 100)}%` : ""
          active: modelData.connected
          onClicked: mouse => {
            if (mouse.button === Qt.RightButton) {
              if (modelData.paired) modelData.forget()
            } else {
              root.choose(modelData)
            }
          }
        }
      }
    }

    Rule { visible: root.on }

    RowLayout {
      visible: root.on
      Layout.fillWidth: true
      Label {
        Layout.fillWidth: true
        text: {{ tq "scan" }}
        color: Theme.fgMuted
      }
      Toggle {
        checked: root.adapter !== null && root.adapter.discovering
        onToggled: on => root.adapter.discovering = on
      }
    }

    Caption {
      visible: root.on && root.devices.some(d => d.paired)
      text: {{ tq "hint" }}
    }
  }
}
