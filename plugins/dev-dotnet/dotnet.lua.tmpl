-- Generated by mazapan (plugin {{ plugin }}): .NET for everything started from the desktop.
local home = os.getenv("HOME") or ""
hl.env("DOTNET_ROOT", "/usr/share/dotnet")
-- dotnet's global tools (dotnet tool install -g).
-- Once (Hyprland's own PATH is this one again on every reload).
local path = os.getenv("PATH") or "/usr/bin"
if not (":" .. path .. ":"):find(":" .. home .. "/.dotnet/tools:", 1, true) then path = path .. ":" .. home .. "/.dotnet/tools" end
hl.env("PATH", path)
-- The development certificate, trusted by OpenSSL beside the system's own.
hl.env("SSL_CERT_DIR", home .. "/.aspnet/dev-certs/trust:/etc/ssl/certs")
{{- if settings.telemetry_off }}
hl.env("DOTNET_CLI_TELEMETRY_OPTOUT", "1")
{{- end }}
hl.env("ASPIRE_CONTAINER_RUNTIME", {{ lq settings.containers }})

-- Set up (the certificate, Aspire's templates) until it has worked once.
hl.on("hyprland.start", function()
  hl.dispatch(hl.dsp.exec_cmd("sh ~/.local/share/mazapan/bin/dotnet-setup --if-needed"))
end)
