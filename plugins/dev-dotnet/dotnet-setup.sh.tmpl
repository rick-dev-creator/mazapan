# Generated by mazapan (plugin {{ plugin }}): .NET set up for ASP.NET Core and
# Aspire, once (and again when asked: it's safe to run twice). Its log:
# ~/.cache/mazapan/dotnet-setup.log. --if-needed (at every login): only until
# it has worked once, so an SDK installed later, or a first try without a
# connection, still gets set up.
log="${XDG_CACHE_HOME:-$HOME/.cache}/mazapan/dotnet-setup.log"
done="${XDG_STATE_HOME:-$HOME/.local/state}/mazapan/dotnet-setup.done"
[ "$1" = --if-needed ] && [ -f "$done" ] && exit 0
mkdir -p "$(dirname "$log")" "$(dirname "$done")"
[ "$1" = --verbose ] || exec >"$log" 2>&1
ok=1
export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
# As the desktop sets it (dotnet.lua): OpenSSL trusts the certificate there.
export SSL_CERT_DIR="$HOME/.aspnet/dev-certs/trust:/etc/ssl/certs"
command -v dotnet >/dev/null || { echo "dotnet isn't installed yet"; exit 0; }
echo "== the HTTPS development certificate"
# Made, and trusted by .NET, by OpenSSL (SSL_CERT_DIR) and by Chromium's and
# Firefox's certificate stores (nss's certutil).
dotnet dev-certs https --trust || { ok=0; echo "(not trusted: run this again from the palette)"; }
echo "== Aspire's templates"
dotnet new install Aspire.ProjectTemplates || { ok=0; echo "(not installed: no connection?)"; }
{{- if settings.containers == "podman" }}
echo "== Podman for Aspire's containers"
command -v podman >/dev/null && podman info --format '{{"{{"}}.Host.Security.Rootless{{"}}"}}' 2>/dev/null
{{- end }}
[ "$ok" = 1 ] && : > "$done"
echo "== done"
