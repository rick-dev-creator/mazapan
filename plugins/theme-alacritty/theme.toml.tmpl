# Generated by mazapan (plugin {{ plugin }}) from theme "{{ theme.id }}": imported
# by alacritty.toml (general.import), which comes after and wins.
[font]
normal = { family = "{{ theme.font.mono }}" }
size = {{ num theme.font.size }}

[window]
opacity = {{ num theme.effects.terminal_opacity }}
padding = { x = 10, y = 10 }

[cursor]
style = { shape = "Block", blinking = "On" }

[colors.primary]
background = "#{{ hex (c "bg") }}"
foreground = "#{{ hex (c "fg") }}"

[colors.cursor]
cursor = "#{{ hex (c "accent") }}"
text = "#{{ hex (c "accent_fg") }}"

[colors.selection]
background = "#{{ hex (c "selection") }}"
text = "#{{ hex (c "fg") }}"

[colors.normal]
black = "#{{ hex (c "black") }}"
red = "#{{ hex (c "red") }}"
green = "#{{ hex (c "green") }}"
yellow = "#{{ hex (c "yellow") }}"
blue = "#{{ hex (c "blue") }}"
magenta = "#{{ hex (c "magenta") }}"
cyan = "#{{ hex (c "cyan") }}"
white = "#{{ hex (c "white") }}"

[colors.bright]
black = "#{{ hex (c "bright_black") }}"
red = "#{{ hex (c "bright_red") }}"
green = "#{{ hex (c "bright_green") }}"
yellow = "#{{ hex (c "bright_yellow") }}"
blue = "#{{ hex (c "bright_blue") }}"
magenta = "#{{ hex (c "bright_magenta") }}"
cyan = "#{{ hex (c "bright_cyan") }}"
white = "#{{ hex (c "bright_white") }}"
