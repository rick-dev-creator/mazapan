# Generated by myarch (plugin {{.Plugin}}) from theme "{{.Theme.ID}}".
#
# Recolors every terminal already open (foot.ini only reaches new ones),
# with the escape sequences terminals understand: OSC 10/11/12/17 for the
# foreground, background (with its opacity), cursor and selection, OSC 4
# for the 16 colors. The theme picker runs it with another theme's colors
# to preview it; with no arguments it puts this theme back.
#
#   term-colors [opacity% bg fg cursor selection color0 … color15]
if [ $# -eq 0 ]; then
  set -- {{pct .Theme.Effects.TerminalOpacity}} {{hex (c "bg")}} {{hex (c "fg")}} {{hex (c "accent")}} {{hex (c "selection")}} \
    {{hex (c "black")}} {{hex (c "red")}} {{hex (c "green")}} {{hex (c "yellow")}} {{hex (c "blue")}} {{hex (c "magenta")}} {{hex (c "cyan")}} {{hex (c "white")}} \
    {{hex (c "bright_black")}} {{hex (c "bright_red")}} {{hex (c "bright_green")}} {{hex (c "bright_yellow")}} {{hex (c "bright_blue")}} {{hex (c "bright_magenta")}} {{hex (c "bright_cyan")}} {{hex (c "bright_white")}}
fi
[ $# -eq 21 ] || { echo "term-colors: needs 21 values, got $#" >&2; exit 2; }
seq="\033]11;[$1]#$2\007\033]10;#$3\007\033]12;#$4\007\033]17;#$5\007"
shift 5
i=0
for c in "$@"; do
  seq="$seq\033]4;$i;#$c\007"
  i=$((i + 1))
done
# Every terminal of yours: what's written to a terminal's tty is shown by
# it, and these sequences are read, not shown.
for tty in /dev/pts/[0-9]*; do
  [ -O "$tty" ] && [ -w "$tty" ] && printf '%b' "$seq" > "$tty" 2>/dev/null
done
exit 0
