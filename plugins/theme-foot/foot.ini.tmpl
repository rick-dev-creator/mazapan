# Generated by mazapan (plugin {{ plugin }}) from theme "{{ theme.id }}".

[main]
font={{ theme.font.mono }}:size={{ num theme.font.size }}
pad=14x14
initial-color-theme={{ theme.meta.mode }}

[cursor]
style=block
blink=yes

[colors-{{ theme.meta.mode }}]
alpha={{ num theme.effects.terminal_opacity }}
background={{ hex (c "bg") }}
foreground={{ hex (c "fg") }}
cursor={{ hex (c "accent_fg") }} {{ hex (c "accent") }}
selection-foreground={{ hex (c "fg") }}
selection-background={{ hex (c "selection") }}
urls={{ hex (c "accent_text") }}
scrollback-indicator={{ hex (c "accent_fg") }} {{ hex (c "accent") }}

regular0={{ hex (c "black") }}
regular1={{ hex (c "red") }}
regular2={{ hex (c "green") }}
regular3={{ hex (c "yellow") }}
regular4={{ hex (c "blue") }}
regular5={{ hex (c "magenta") }}
regular6={{ hex (c "cyan") }}
regular7={{ hex (c "white") }}

bright0={{ hex (c "bright_black") }}
bright1={{ hex (c "bright_red") }}
bright2={{ hex (c "bright_green") }}
bright3={{ hex (c "bright_yellow") }}
bright4={{ hex (c "bright_blue") }}
bright5={{ hex (c "bright_magenta") }}
bright6={{ hex (c "bright_cyan") }}
bright7={{ hex (c "bright_white") }}
