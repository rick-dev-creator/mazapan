// Generated by myarch (plugin {{ plugin }}).
//
// There are updates (or one is running): an arrow and how many; a click
// opens the panel.

import QtQuick
import Quickshell
import qs
import "../../components/kit"
import "../../components/updates"

BarItem {
  id: root

  shown: UpdatesService.count > 0 || UpdatesService.running
  onClicked: Quickshell.execDetached(["qs", "ipc", "-c", "myarch", "call", "myarch", "panel", "updates"])

  Row {
    anchors.verticalCenter: parent.verticalCenter
    spacing: 4
    Glyph {
      anchors.verticalCenter: parent.verticalCenter
      text: String.fromCodePoint(UpdatesService.running ? 0xF06B0 : 0xF01DA) // update / arrow-down-circle
      color: UpdatesService.restart || (UpdatesService.data && (UpdatesService.data.news || []).some(n => n.action)) ? Theme.warning : Theme.accentText
    }
    Label {
      visible: !UpdatesService.running
      anchors.verticalCenter: parent.verticalCenter
      text: String(UpdatesService.count)
    }
  }
}
