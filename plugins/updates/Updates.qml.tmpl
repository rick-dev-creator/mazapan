// Generated by mazapan (plugin {{ plugin }}).
//
// The updates panel: what an update brings (packages, the desktop's own
// marked; the Flatpak apps), Arch's news to read first (what asks for
// something marked), whether it needs a restart; updated with a click,
// followed as it goes. The work is UpdatesService's.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/updates"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null

  function toggle() {
    if (open) close()
    else show()
  }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    if (!UpdatesService.data && !UpdatesService.running) UpdatesService.check()
    open = true
    Qt.callLater(() => card.forceActiveFocus())
  }
  function close() { open = false }

  readonly property var d: UpdatesService.data
  readonly property var packages: d ? d.packages || [] : []
  readonly property var flatpaks: d ? d.flatpaks || [] : []
  // Apps from their makers (Rider, VS Code): updated with the rest.
  readonly property var vendor: d ? d.vendor || [] : []
  // Arch's news matters before an update: with nothing to update, none.
  readonly property var news: d && UpdatesService.count > 0 ? d.news || [] : []
  readonly property string problem: UpdatesService.checkError !== "" ? UpdatesService.checkError : d && d.error ? d.error : ""
  readonly property var whatsNew: d ? d.whats_new || [] : []
  readonly property var firmware: d ? d.firmware || [] : []
  readonly property var pluginUpdates: d ? d.plugins || [] : []
  readonly property var stepNames: ({
    ready: {{ tq "step.ready" }}, keys: {{ tq "step.keys" }}, packages: {{ tq "step.packages" }},
    plugins: {{ tq "step.plugins" }}, config: {{ tq "step.config" }}, checks: {{ tq "step.checks" }}, rollback: {{ tq "step.rollback" }}
  })

  PanelWindow {
    visible: root.open
    screen: root.screenAtOpen
    anchors { top: true; bottom: true; left: true; right: true }
    color: Qt.alpha(Theme.bg, 0.6)
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "mazapan-panel-updates"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    MouseArea { anchors.fill: parent; onClicked: root.close() }

    Rectangle {
      id: card
      anchors.centerIn: parent
      width: Math.min(720, parent.width - 40)
      height: Math.min(600, parent.height - 40)
      radius: Theme.radius
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      focus: true
      Keys.onEscapePressed: root.close()
      MouseArea { anchors.fill: parent }

      ColumnLayout {
        anchors.fill: parent
        anchors.margins: 22
        spacing: 10

        RowLayout {
          Layout.fillWidth: true
          Label { text: {{ tq "title" }}; font.pointSize: 15; font.bold: true; Layout.fillWidth: true }
          Caption {
            text: UpdatesService.checking ? {{ tq "checking" }}
              : UpdatesService.running ? {{ tq "running" }}
              : root.problem !== "" ? {{ tq "check_failed_short" }}
              : UpdatesService.count === 0 ? {{ tq "up_to_date" }} : {{ tq "count" }}.arg(UpdatesService.count)
          }
        }
        // Why it couldn't look: in full, wrapped, under the title (never
        // running off the card).
        Label {
          visible: root.problem !== "" && !UpdatesService.checking && !UpdatesService.running
          text: root.problem
          color: Theme.warning
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }

        // What the update is doing, or how it went.
        Rectangle {
          visible: UpdatesService.running || UpdatesService.exit >= 0
          Layout.fillWidth: true
          implicitHeight: runCol.implicitHeight + 16
          radius: Theme.radius
          color: UpdatesService.running ? Theme.surface : UpdatesService.exit === 0 ? Qt.alpha(Theme.success, 0.15) : Qt.alpha(Theme.danger, 0.15)
          ColumnLayout {
            id: runCol
            anchors.fill: parent
            anchors.margins: 8
            spacing: 2
            Label {
              text: UpdatesService.running ? {{ tq "running" }} : UpdatesService.exit === 0 ? {{ tq "done" }} : {{ tq "failed" }}
              font.bold: true
            }
            // Its steps, a ✓ each; what went wrong said where it did.
            Repeater {
              model: UpdatesService.steps
              RowLayout {
                required property var modelData
                Layout.fillWidth: true
                spacing: 8
                // A step still "running" once the update is over never finished: ✗.
                readonly property string st: modelData.state === "run" && !UpdatesService.running ? "fail" : modelData.state
                Label {
                  text: parent.st === "ok" ? "✓" : parent.st === "fail" ? "✗" : parent.st === "skip" ? "–" : "…"
                  color: parent.st === "ok" ? Theme.success : parent.st === "fail" ? Theme.danger : Theme.fgMuted
                  Layout.preferredWidth: 14
                }
                Label { text: root.stepNames[modelData.id] || modelData.id; Layout.preferredWidth: 160 }
                Caption {
                  visible: parent.st === "fail" || parent.st === "skip"
                  text: modelData.detail
                  elide: Text.ElideRight
                  Layout.fillWidth: true
                }
              }
            }
            Caption {
              visible: text !== "" && (UpdatesService.steps.length === 0 || UpdatesService.running)
              text: UpdatesService.last
              elide: Text.ElideRight
              Layout.fillWidth: true
            }
          }
        }

        // What's new in Mazapan, when the update brings it (its changelog).
        ColumnLayout {
          visible: root.whatsNew.length > 0 && !UpdatesService.running
          Layout.fillWidth: true
          spacing: 2
          Caption { text: {{ tq "whats_new" }} }
          Repeater {
            model: root.whatsNew.reduce((a, r) => a.concat(r.items), []).slice(0, 8)
            Label {
              required property var modelData
              // The changelog's Markdown, as plain text.
              text: "• " + modelData.replace(/`/g, "")
              wrapMode: Text.Wrap
              Layout.fillWidth: true
            }
          }
        }

        // Arch's news since the last update, before updating. One that asks
        // for a step by hand says so in a sentence; each opens to read.
        ColumnLayout {
          visible: root.news.length > 0 && !UpdatesService.running
          Layout.fillWidth: true
          spacing: 4
          Caption { text: {{ tq "news" }} }
          Repeater {
            model: root.news
            Rectangle {
              id: item
              required property var modelData
              Layout.fillWidth: true
              implicitHeight: itemCol.implicitHeight + 12
              radius: Theme.radius
              color: modelData.action ? Qt.alpha(Theme.warning, 0.12) : "transparent"
              border.width: modelData.action ? 1 : 0
              border.color: Theme.warning
              ColumnLayout {
                id: itemCol
                anchors.fill: parent
                anchors.margins: 6
                spacing: 2
                Label {
                  text: item.modelData.title
                  color: item.modelData.action ? Theme.warning : Theme.fg
                  wrapMode: Text.Wrap
                  Layout.fillWidth: true
                }
                Caption {
                  text: item.modelData.date + (item.modelData.action ? "  ·  " + {{ tq "news_action" }} : "")
                  wrapMode: Text.Wrap
                  Layout.fillWidth: true
                }
              }
              MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                // Only the web: a link from the network opens nothing else.
                onClicked: if (/^https:\/\//.test(item.modelData.link)) Quickshell.execDetached(["xdg-open", item.modelData.link])
              }
            }
          }
        }

        Label {
          visible: !!root.d && !!root.d.news_error && UpdatesService.count > 0 && !UpdatesService.running
          text: {{ tq "news_error" }}
          color: Theme.fgMuted
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }

        // Plugins from git with a new version: their own update, in a terminal,
        // which asks again for anything new they'd be able to do.
        ColumnLayout {
          visible: root.pluginUpdates.length > 0 && !UpdatesService.running
          Layout.fillWidth: true
          spacing: 2
          RowLayout {
            Layout.fillWidth: true
            Caption { text: {{ tq "plugins" }}; Layout.fillWidth: true }
            Button {
              text: {{ tq "plugins.update" }}
              onClicked: { root.close(); Quickshell.execDetached(["xdg-terminal-exec", "--hold", "sh", "-c", "mazapan plugins update && mazapan apply"]) }
            }
          }
          Label {
            text: root.pluginUpdates.map(p => p.id).join(", ")
            elide: Text.ElideRight
            Layout.fillWidth: true
          }
        }

        // Firmware (fwupd): its own update, in a terminal (some finish at the next start).
        ColumnLayout {
          visible: root.firmware.length > 0 && !UpdatesService.running
          Layout.fillWidth: true
          spacing: 2
          RowLayout {
            Layout.fillWidth: true
            Caption { text: {{ tq "firmware" }}; Layout.fillWidth: true }
            Button {
              text: {{ tq "firmware.update" }}
              onClicked: { root.close(); Quickshell.execDetached(["xdg-terminal-exec", "--hold", "fwupdmgr", "update"]) }
            }
          }
          Repeater {
            model: root.firmware
            Label {
              required property var modelData
              text: modelData.device + "   " + modelData.from + " → " + modelData.to
              elide: Text.ElideRight
              Layout.fillWidth: true
            }
          }
        }

        // Nothing to do: said plainly, and that it keeps looking by itself.
        ColumnLayout {
          visible: UpdatesService.count === 0 && !UpdatesService.checking && !UpdatesService.running
            && root.problem === "" && UpdatesService.exit < 0
          Layout.fillWidth: true
          Layout.fillHeight: true
          spacing: 6
          Item { Layout.fillHeight: true }
          Label {
            text: "✓  " + {{ tq "up_to_date" }}
            color: Theme.success
            font.pointSize: 13
            Layout.alignment: Qt.AlignHCenter
          }
          Caption {
            text: {{ tq "up_to_date_note" }}
            wrapMode: Text.Wrap
            horizontalAlignment: Text.AlignHCenter
            Layout.fillWidth: true
          }
          Item { Layout.fillHeight: true }
        }

        // The packages and apps.
        ListView {
          visible: UpdatesService.count > 0
          Layout.fillWidth: true
          Layout.fillHeight: true
          clip: true
          spacing: 2
          model: root.packages.map(p => ({ name: p.name, detail: p.from + " → " + p.to, mark: p.desktop || p.kernel }))
            .concat(root.flatpaks.map(f => ({ name: f.name, detail: "Flatpak · " + f.id, mark: false })))
            .concat(root.vendor.map(v => ({ name: v.name, detail: v.from + " → " + v.to + " · " + {{ tq "from_maker" }}, mark: false })))
          delegate: RowLayout {
            required property var modelData
            width: ListView.view.width
            spacing: 8
            Label { text: modelData.mark ? "★" : " "; color: Theme.accentText; Layout.preferredWidth: 14 }
            Label { text: modelData.name; Layout.preferredWidth: 240; elide: Text.ElideRight }
            Caption { text: modelData.detail; elide: Text.ElideRight; Layout.fillWidth: true }
          }
        }
        Caption {
          visible: root.packages.some(p => p.desktop || p.kernel)
          text: {{ tq "star" }}
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
        Label {
          visible: UpdatesService.restart
          text: {{ tq "restart_needed" }}
          color: Theme.warning
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }

        RowLayout {
          Layout.fillWidth: true
          Button {
            text: {{ tq "check" }}
            enabled: !UpdatesService.checking && !UpdatesService.running
            onClicked: UpdatesService.check()
          }
          Item { Layout.fillWidth: true }
          Button {
            visible: UpdatesService.exit === 0 && !UpdatesService.running && UpdatesService.restartAfter
            text: {{ tq "restart" }}
            onClicked: Quickshell.execDetached(["systemctl", "reboot"])
          }
          Button {
            primary: true
            // Only when there's something to update.
            visible: UpdatesService.count > 0
            text: {{ tq "update" }}
            enabled: !UpdatesService.running && !UpdatesService.checking
            opacity: enabled ? 1 : 0.5
            // Out of the way: the password dialog comes next, and the bar
            // (and a notification at the end) says how it goes.
            onClicked: { UpdatesService.update(); root.close() }
          }
        }
      }
    }
  }
}
