// Generated by myarch (plugin {{ plugin }}).
//
// What updates there are (myarch update --check --json, every
// {{ settings.every }} h, and kept in a file across reloads), and an
// update when asked: `myarch update -y --gui` detached (a snapshot first,
// rolled back if the desktop's checks fail afterwards), followed through
// its log, so it outlives a shell reload.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
  id: root

  readonly property string dir: Quickshell.env("HOME") + "/.local/state/myarch/updates"
  property var data: null
  property bool checking: false
  // The last look failed (checkupdates missing, the config broken…): said, not "up to date".
  property string checkError: ""
  readonly property int count: data ? (data.packages || []).length + (data.flatpaks || []).length : 0
  readonly property bool restart: !!data && data.restart === true

  // The update: its log's first line says which run it is.
  property bool running: false
  property int exit: -1
  property string last: ""
  property string runId: ""
  // The one running (or last run) brought a new kernel: restart after it.
  property bool restartAfter: false

  function check() {
    if (checking || running) return
    checking = true
    probe.running = true
  }
  Process {
    id: probe
    command: ["myarch", "update", "--check", "--json"]
    stdout: StdioCollector {
      onStreamFinished: {
        try {
          const d = JSON.parse(text)
          root.data = d
          saved.setText(text)
        } catch (e) {}
      }
    }
    stderr: StdioCollector { id: probeErr }
    onExited: code => {
      root.checking = false
      root.checkError = code === 0 ? "" : (probeErr.text.trim().replace(/^myarch: /, "") || "exit " + code)
    }
  }
  FileView {
    id: saved
    path: root.dir + "/last.json"
    printErrors: false
    atomicWrites: true
    onLoaded: { try { if (!root.data) root.data = JSON.parse(text()) } catch (e) {} }
  }

  // A little after the desktop is up, then every so often.
  Timer { interval: 90000; running: true; onTriggered: root.check() }
  Timer { interval: {{ settings.every }} * 3600000; repeat: true; running: true; onTriggered: root.check() }

  function update() {
    if (running) return
    runId = String(Date.now())
    restartAfter = restart
    running = true
    exit = -1
    last = ""
    Quickshell.execDetached(["sh", "-c", 'd=$0; id=$1; ok=$2; bad=$3; title=$4; mkdir -p "$d"; echo "START $id $$" > "$d/run.log"; '
      + 'myarch update -y --gui >> "$d/run.log" 2>&1; c=$?; echo "DONE $c" >> "$d/run.log"; '
      + 'if [ "$c" = 0 ]; then notify-send -a "$title" -i system-software-update "$ok"; else notify-send -a "$title" -u critical -i dialog-warning "$bad"; fi',
      root.dir, root.runId, {{ tq "done" }}, {{ tq "failed" }}, {{ tq "title" }}])
    log.reload()
  }
  FileView {
    id: log
    path: root.dir + "/run.log"
    printErrors: false
    watchChanges: true
    onFileChanged: reload()
    onLoaded: {
      // Without the terminal's colors (myarch update prints them).
      const lines = text().split("\n").map(l => l.replace(/\x1b\[[0-9;]*m/g, "").trim()).filter(l => l !== "")
      if (lines.length === 0) return
      const start = /^START (\d+)(?: (\d+))?$/.exec(lines[0])
      if (!start) return
      // Started just now: the log may still be the last run's.
      if (root.running && root.runId !== "" && start[1] !== root.runId) return
      if (root.runId === "") root.runId = start[1]
      const done = lines.find(l => l.startsWith("DONE "))
      root.last = lines.filter(l => !l.startsWith("START ") && !l.startsWith("DONE ")).slice(-1)[0] || ""
      if (done) {
        const was = root.running
        root.running = false
        root.exit = Number(done.slice(5))
        if (was) { root.data = null; root.check() }
      } else {
        root.running = true
        // Unfinished, from before this shell: still running, or it died (a
        // reboot half way)? Its process says.
        if (start[2] && !alive.running) { alive.pid = start[2]; alive.running = true }
      }
    }
  }
  Process {
    id: alive
    property string pid: ""
    command: ["kill", "-0", pid]
    onExited: code => {
      if (code !== 0 && root.running) {
        root.running = false
        root.exit = 1
        root.last = {{ tq "interrupted" }}
      }
    }
  }
  // The log may not be there yet when it starts: looked at while it runs.
  Timer { interval: 1500; repeat: true; running: root.running; onTriggered: log.reload() }
}
