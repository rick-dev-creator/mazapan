// Generated by mazapan (plugin {{ plugin }}): updates, in the Control Center.
//
// Updates ready: a card under Now that says how many and what, with Update
// now right there (the same as the Updates panel's: the password asked,
// each step in the panel, a notification when it's done). While it runs:
// that it does. After one that wants a restart: Restart.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/updates"
import "../../components/control"

Group {
  id: root

  readonly property var names: UpdatesService.data
    ? (UpdatesService.data.packages || []).map(p => p.name).concat((UpdatesService.data.flatpaks || []).map(f => f.name)).slice(0, 4)
    : []
  readonly property bool restartWanted: UpdatesService.exit === 0 && !UpdatesService.running && UpdatesService.restartAfter
  readonly property bool live: UpdatesService.running || restartWanted || UpdatesService.count > 0
  readonly property int level: 0
  readonly property string pill: UpdatesService.running ? {{ tq "running" }}
    : restartWanted ? {{ tq "restart" }} : {{ tq "pill" }}.arg(UpdatesService.count)

  color: Qt.rgba(Theme.accent.r, Theme.accent.g, Theme.accent.b, 0.12)
  border.color: Theme.accent

  RowLayout {
    Layout.fillWidth: true
    spacing: 10
    Glyph {
      text: "󰚰"
      color: Theme.accentText
      font.pointSize: 15
    }
    ColumnLayout {
      Layout.fillWidth: true
      spacing: 2
      Label {
        text: UpdatesService.running ? {{ tq "running" }}
          : root.restartWanted ? {{ tq "done" }}
          : {{ tq "count" }}.arg(UpdatesService.count)
        font.bold: true
      }
      Caption {
        visible: text !== ""
        text: root.restartWanted ? {{ tq "restart_needed" }} : root.names.join(", ")
        font.letterSpacing: 0
        elide: Text.ElideRight
        Layout.fillWidth: true
      }
    }
    Button {
      visible: !UpdatesService.running
      primary: true
      text: root.restartWanted ? {{ tq "restart" }} : {{ tq "update" }}
      onClicked: {
        ControlService.close()
        if (root.restartWanted) Quickshell.execDetached(["systemctl", "reboot"])
        else UpdatesService.update()
      }
    }
    Button {
      text: "󰅂"
      onClicked: {
        ControlService.close()
        Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "updates"])
      }
    }
  }
}
