// Generated by mazapan (plugin {{ plugin }}).
//
// The screensaver: after {{ settings.after }} minutes without use, every screen
// shows the time on the theme's background, with its colors drifting
// behind; the time moves a little every minute so nothing stays burnt in.
// A key or the mouse and it's gone (the key isn't passed on: it was for
// this). What keeps the computer awake (a video, a call, the bar's
// "keep awake") keeps it away too: the compositor's idle inhibitors.

import QtQuick
import QtQuick.Effects
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import qs

Item {
  id: root

  // A panel by contract (see shell.qml): idle opens it, not a key.
  readonly property bool open: shown
  function toggle() { shown = !shown }
  function close() { shown = false }

  property bool shown: false
  property date now: new Date()
  readonly property var locale: Qt.locale("{{ lang }}")

  IdleMonitor {
    id: idle
    timeout: {{ settings.after }} * 60
    respectInhibitors: true
    onIsIdleChanged: root.shown = isIdle
  }

  IpcHandler {
    target: "screensaver"
    function start(): void { root.shown = true }
    function stop(): void { root.shown = false }
  }

  Timer {
    interval: 1000
    repeat: true
    running: root.shown
    triggeredOnStart: true
    onTriggered: root.now = new Date()
  }

  Variants {
    model: Quickshell.screens

    PanelWindow {
      id: win
      required property var modelData
      screen: modelData
      visible: root.shown || veil.opacity > 0
      anchors { top: true; bottom: true; left: true; right: true }
      color: "transparent"
      exclusionMode: ExclusionMode.Ignore
      WlrLayershell.layer: WlrLayer.Overlay
      WlrLayershell.namespace: "mazapan-screensaver"
      // Keys come here while it shows: the first one only ends it.
      WlrLayershell.keyboardFocus: root.shown ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None

      Item {
        id: veil
        anchors.fill: parent
        opacity: root.shown ? 1 : 0
        Behavior on opacity { NumberAnimation { duration: root.shown ? 1500 : 200; easing.type: Easing.InOutQuad } }
        focus: true
        Keys.onPressed: event => {
          root.shown = false
          event.accepted = true
        }

        Rectangle {
          anchors.fill: parent
          color: Theme.bg
        }

        // The theme's colors, soft and slow.
        Item {
          id: glow
          anchors.fill: parent
          visible: false
          layer.enabled: true
          Repeater {
            model: [Theme.accent, Theme.info, Theme.success]
            Rectangle {
              id: blob
              required property var modelData
              required property int index
              width: Math.min(win.width, win.height) * 0.55
              height: width
              radius: width / 2
              color: modelData
              opacity: 0.35
              x: win.width * (0.15 + 0.3 * index) - width / 2
              y: win.height * (0.3 + 0.2 * (index % 2)) - height / 2
              SequentialAnimation on x {
                running: root.shown && Theme.motion
                loops: Animation.Infinite
                NumberAnimation { to: win.width * (0.75 - 0.25 * blob.index) - blob.width / 2; duration: 47000 + 9000 * blob.index; easing.type: Easing.InOutSine }
                NumberAnimation { to: win.width * (0.15 + 0.3 * blob.index) - blob.width / 2; duration: 53000 + 7000 * blob.index; easing.type: Easing.InOutSine }
              }
              SequentialAnimation on y {
                running: root.shown && Theme.motion
                loops: Animation.Infinite
                NumberAnimation { to: win.height * (0.7 - 0.15 * blob.index) - blob.height / 2; duration: 39000 + 11000 * blob.index; easing.type: Easing.InOutSine }
                NumberAnimation { to: win.height * (0.3 + 0.2 * (blob.index % 2)) - blob.height / 2; duration: 43000 + 5000 * blob.index; easing.type: Easing.InOutSine }
              }
            }
          }
        }
        MultiEffect {
          anchors.fill: parent
          source: glow
          blurEnabled: true
          blurMax: 64
          blur: 1
          autoPaddingEnabled: false
        }

        // The time, somewhere new each minute.
        Column {
          id: clock
          spacing: 4
          property int minute: root.now.getHours() * 60 + root.now.getMinutes()
          // A different place each minute, the same on every screen.
          x: (win.width - width) * (0.2 + 0.6 * ((minute * 37) % 100) / 100)
          y: (win.height - height) * (0.25 + 0.5 * ((minute * 61) % 100) / 100)
          Behavior on x { enabled: Theme.motion; NumberAnimation { duration: 4000; easing.type: Easing.InOutSine } }
          Behavior on y { enabled: Theme.motion; NumberAnimation { duration: 4000; easing.type: Easing.InOutSine } }

          Text {
            anchors.horizontalCenter: parent.horizontalCenter
            text: root.now.toLocaleTimeString(root.locale, Locale.ShortFormat)
            color: Theme.fg
            font.family: Theme.fontMono
            font.pixelSize: Math.min(win.width, win.height) * 0.16
            font.weight: Font.Light
          }
          Text {
            visible: {{ settings.date }}
            anchors.horizontalCenter: parent.horizontalCenter
            text: root.now.toLocaleDateString(root.locale, "dddd d MMMM")
            color: Theme.fgMuted
            font.family: Theme.fontUi
            font.pixelSize: Math.min(win.width, win.height) * 0.03
          }
        }

        // The mouse: a move or a click ends it, and goes no further.
        MouseArea {
          id: pointer
          anchors.fill: parent
          hoverEnabled: true
          cursorShape: root.shown ? Qt.BlankCursor : Qt.ArrowCursor
          property point first: Qt.point(-1, -1)
          onPositionChanged: mouse => {
            // The first position is where the pointer already was.
            if (first.x < 0) { first = Qt.point(mouse.x, mouse.y); return }
            if (Math.abs(mouse.x - first.x) + Math.abs(mouse.y - first.y) > 8) root.shown = false
          }
          onPressed: root.shown = false
          Connections {
            target: root
            function onShownChanged() { if (root.shown) pointer.first = Qt.point(-1, -1) }
          }
        }
      }
    }
  }
}
