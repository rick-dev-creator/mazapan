// Generated by mazapan (plugin {{ plugin }}).
//
// The screensaver: after {{ settings.after }} minutes without use, every screen
// shows one of these, in the theme's colors ({{ settings.style }}):
//   glow     the time, the theme's colors drifting behind
//   mazapan  the bitten mazapán bouncing about, crumbs falling, a new color
//            at every wall (a corner, and it celebrates)
//   crt      an 80s phosphor terminal: it boots, then shows the time
//   rain     code falling in the accent
//   stars    flying through the stars
//   life     Conway's Game of Life, seeded again when it settles
//   pipes    pipes growing across the screen
//   random   a different one each time
// The time moves a little every minute so nothing stays burnt in. A key or
// the mouse and it's gone (the key isn't passed on: it was for this). What
// keeps the computer awake (a video, a call, the bar's "keep awake") keeps
// it away too: the compositor's idle inhibitors.
//   qs ipc -c mazapan call screensaver preview STYLE   (to try one)

import QtQuick
import QtQuick.Effects
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import qs

Item {
  id: root

  // A panel by contract (see shell.qml): idle opens it, not a key.
  readonly property bool open: shown
  function toggle() { shown = !shown }
  function close() { shown = false }

  property bool shown: false
  property date now: new Date()
  readonly property var locale: Qt.locale("{{ lang }}")
  readonly property var styles: ["glow", "mazapan", "crt", "rain", "stars", "life", "pipes"]
  readonly property string setting: {{ json settings.style }}
  property string style: "glow"
  readonly property string icon: Quickshell.env("HOME") + "/.config/quickshell/mazapan/assets/mazapan.svg"

  // Each time it shows: the one set, or one picked at random.
  function pick(s) {
    style = styles.includes(s) ? s : styles[Math.floor(Math.random() * styles.length)]
  }
  onShownChanged: if (shown && !trying) pick(setting)
  property bool trying: false

  IdleMonitor {
    id: idle
    timeout: {{ settings.after }} * 60
    respectInhibitors: true
    onIsIdleChanged: root.shown = isIdle
  }

  IpcHandler {
    target: "screensaver"
    function start(): void { root.shown = true }
    function stop(): void { root.shown = false }
    // One style now, to see it.
    function preview(style: string): void {
      root.trying = true
      root.pick(style)
      root.shown = true
      root.trying = false
    }
  }

  Timer {
    interval: 1000
    repeat: true
    running: root.shown
    triggeredOnStart: true
    onTriggered: root.now = new Date()
  }

  // "rgba(r,g,b,a)" for a canvas, from a theme color.
  function rgba(c, a) {
    return `rgba(${Math.round(c.r * 255)},${Math.round(c.g * 255)},${Math.round(c.b * 255)},${a})`
  }
  readonly property var palette: [Theme.accent, Theme.info, Theme.success, Theme.warning, Theme.danger]

  // --- the styles ------------------------------------------------------------

  Component {
    id: glowStyle
    Item {
      id: glow
      Item {
        id: blobs
        anchors.fill: parent
        visible: false
        layer.enabled: true
        Repeater {
          model: [Theme.accent, Theme.info, Theme.success]
          Rectangle {
            id: blob
            required property var modelData
            required property int index
            width: Math.min(glow.width, glow.height) * 0.55
            height: width
            radius: width / 2
            color: modelData
            opacity: 0.35
            x: glow.width * (0.15 + 0.3 * index) - width / 2
            y: glow.height * (0.3 + 0.2 * (index % 2)) - height / 2
            SequentialAnimation on x {
              running: root.shown && Theme.motion
              loops: Animation.Infinite
              NumberAnimation { to: glow.width * (0.75 - 0.25 * blob.index) - blob.width / 2; duration: 47000 + 9000 * blob.index; easing.type: Easing.InOutSine }
              NumberAnimation { to: glow.width * (0.15 + 0.3 * blob.index) - blob.width / 2; duration: 53000 + 7000 * blob.index; easing.type: Easing.InOutSine }
            }
            SequentialAnimation on y {
              running: root.shown && Theme.motion
              loops: Animation.Infinite
              NumberAnimation { to: glow.height * (0.7 - 0.15 * blob.index) - blob.height / 2; duration: 39000 + 11000 * blob.index; easing.type: Easing.InOutSine }
              NumberAnimation { to: glow.height * (0.3 + 0.2 * (blob.index % 2)) - blob.height / 2; duration: 43000 + 5000 * blob.index; easing.type: Easing.InOutSine }
            }
          }
        }
      }
      MultiEffect {
        anchors.fill: parent
        source: blobs
        blurEnabled: true
        blurMax: 64
        blur: 1
        autoPaddingEnabled: false
      }
    }
  }

  // The bitten mazapán, bouncing as the old DVD logo did.
  Component {
    id: mazapanStyle
    Item {
      id: field
      property real size: Math.min(width, height) * 0.16
      property real px: width * 0.3
      property real py: height * 0.4
      property real vx: size * 0.045
      property real vy: size * 0.032
      property int tint: 0
      property var crumbs: []   // [{x, y, vx, vy, life, c}]

      function crumble(n, x, y) {
        const out = crumbs.filter(c => c.life > 0)
        for (let i = 0; i < n; i++)
          out.push({ x: x, y: y, vx: (Math.random() - 0.5) * size * 0.06, vy: -Math.random() * size * 0.05,
                     life: 1, c: Math.floor(Math.random() * root.palette.length) })
        crumbs = out.slice(-80)
      }

      Timer {
        interval: 33
        repeat: true
        running: root.shown
        onTriggered: {
          let x = field.px + field.vx, y = field.py + field.vy, hits = 0
          if (x < 0 || x + field.size > field.width) { field.vx = -field.vx; x = Math.max(0, Math.min(x, field.width - field.size)); hits++ }
          if (y < 0 || y + field.size > field.height) { field.vy = -field.vy; y = Math.max(0, Math.min(y, field.height - field.size)); hits++ }
          field.px = x
          field.py = y
          if (hits > 0) {
            field.tint = (field.tint + 1) % root.palette.length
            field.crumble(hits > 1 ? 40 : 6, x + field.size / 2, y + field.size / 2)
          } else if (Math.random() < 0.04) field.crumble(1, x + field.size * 0.7, y + field.size * 0.35)
          field.crumbs = field.crumbs.map(c => ({ x: c.x + c.vx, y: c.y + c.vy, vx: c.vx * 0.99, vy: c.vy + field.size * 0.002, life: c.life - 0.012, c: c.c }))
            .filter(c => c.life > 0 && c.y < field.height)
          crumbCanvas.requestPaint()
        }
      }
      Canvas {
        id: crumbCanvas
        anchors.fill: parent
        onPaint: {
          const g = getContext("2d")
          g.clearRect(0, 0, width, height)
          const s = Math.max(3, field.size * 0.04)
          for (const c of field.crumbs) {
            g.fillStyle = root.rgba(root.palette[c.c], Math.max(0, c.life))
            g.fillRect(Math.round(c.x / s) * s, Math.round(c.y / s) * s, s, s)
          }
        }
      }
      Image {
        id: logo
        x: field.px
        y: field.py
        width: field.size
        height: field.size
        source: "file://" + root.icon
        sourceSize: Qt.size(width, height)
        smooth: false
        visible: false
      }
      MultiEffect {
        source: logo
        x: logo.x
        y: logo.y
        width: logo.width
        height: logo.height
        colorization: 0.35
        colorizationColor: root.palette[field.tint]
        Behavior on colorizationColor { ColorAnimation { duration: 300 } }
      }
    }
  }

  // An 80s phosphor terminal: it boots, then the time in big letters.
  Component {
    id: crtStyle
    Item {
      id: crt
      readonly property color ink: Theme.accent
      property int shownLines: 0
      readonly property var boot: [
        "MAZAPAN BIOS v1.0  (C) 1984-" + root.now.getFullYear(),
        "",
        "CPU ............................ OK",
        "MEMORY TEST .................... 65536K OK",
        "DISK ........................... OK",
        "",
        "LOADING DESKTOP" + ".".repeat(8),
        "READY.",
      ]
      Timer {
        interval: 260
        repeat: true
        running: root.shown && crt.shownLines < crt.boot.length + 1
        onTriggered: crt.shownLines++
      }
      Column {
        x: crt.width * 0.08
        y: crt.height * 0.1
        spacing: 2
        Repeater {
          model: crt.boot.slice(0, crt.shownLines)
          Text {
            required property string modelData
            text: modelData === "" ? " " : modelData
            color: crt.ink
            font.family: Theme.fontMono
            font.pixelSize: Math.max(14, crt.height * 0.022)
          }
        }
      }
      Text {
        visible: crt.shownLines > crt.boot.length
        anchors.centerIn: parent
        anchors.verticalCenterOffset: crt.height * 0.08
        text: root.now.toLocaleTimeString(root.locale, Locale.ShortFormat) + (root.now.getSeconds() % 2 ? "_" : " ")
        color: crt.ink
        font.family: Theme.fontMono
        font.pixelSize: Math.min(crt.width, crt.height) * 0.14
        font.bold: true
        style: Text.Outline
        styleColor: Qt.rgba(crt.ink.r, crt.ink.g, crt.ink.b, 0.25)
      }
      // Scanlines, and the faint flicker of an old tube.
      Canvas {
        anchors.fill: parent
        onPaint: {
          const g = getContext("2d")
          g.fillStyle = "rgba(0,0,0,0.28)"
          for (let y = 0; y < height; y += 3) g.fillRect(0, y, width, 1)
        }
      }
      Rectangle {
        anchors.fill: parent
        color: "black"
        SequentialAnimation on opacity {
          running: root.shown && Theme.motion
          loops: Animation.Infinite
          NumberAnimation { to: 0.06; duration: 90 }
          NumberAnimation { to: 0.0; duration: 140 }
          PauseAnimation { duration: 2200 }
        }
      }
    }
  }

  // Code falling in the accent (drawn at half size: chunkier, and cheap).
  Component {
    id: rainStyle
    Item {
    Canvas {
      id: c
      readonly property int cell: 16
      property var drops: []
      readonly property var glyphs: "0123456789ABCDEFmazapan{}[]<>/*=+-#$&λ".split("")
      width: parent.width / 2
      height: parent.height / 2
      scale: 2
      transformOrigin: Item.TopLeft
      smooth: false
      onWidthChanged: drops = Array.from({ length: Math.ceil(width / cell) }, () => -Math.random() * 60)
      Timer { interval: 60; repeat: true; running: root.shown; onTriggered: c.requestPaint() }
      onPaint: {
        const g = getContext("2d")
        g.fillStyle = root.rgba(Theme.bg, 0.2)
        g.fillRect(0, 0, width, height)
        g.font = `${cell}px "${Theme.fontMono}"`
        for (let i = 0; i < drops.length; i++) {
          const y = drops[i] * cell
          g.fillStyle = Math.random() < 0.05 ? String(Theme.fg) : String(Theme.accent)
          g.fillText(glyphs[Math.floor(Math.random() * glyphs.length)], i * cell, y)
          drops[i] = y > height && Math.random() > 0.97 ? 0 : drops[i] + 1
        }
      }
    }
    }
  }

  // Through the stars.
  Component {
    id: starsStyle
    Canvas {
      id: c
      property var stars: []
      Component.onCompleted: stars = Array.from({ length: 520 }, () => ({ x: Math.random() * 2 - 1, y: Math.random() * 2 - 1, z: Math.random(), c: Math.floor(Math.random() * 3) }))
      Timer { interval: 33; repeat: true; running: root.shown; onTriggered: c.requestPaint() }
      onPaint: {
        const g = getContext("2d")
        g.fillStyle = String(Theme.bg)
        g.fillRect(0, 0, width, height)
        const cx = width / 2, cy = height / 2, f = Math.min(width, height) * 0.5
        const cols = [Theme.fg, Theme.accent, Theme.info]
        g.lineCap = "round"
        for (const s of stars) {
          const z0 = s.z
          s.z -= 0.009
          if (s.z <= 0.02) { s.x = Math.random() * 2 - 1; s.y = Math.random() * 2 - 1; s.z = 1; continue }
          // From where it was to where it is: a streak, longer as it nears.
          const x0 = cx + s.x / z0 * f, y0 = cy + s.y / z0 * f
          const x = cx + s.x / s.z * f, y = cy + s.y / s.z * f
          if (x < 0 || y < 0 || x > width || y > height) { s.z = 1; continue }
          g.strokeStyle = root.rgba(cols[s.c], Math.min(1, (1 - s.z) * 1.6))
          g.lineWidth = Math.max(1, (1 - s.z) * 3.5)
          g.beginPath()
          g.moveTo(x0, y0)
          g.lineTo(x, y)
          g.stroke()
        }
      }
    }
  }

  // Conway's Game of Life, on a grid of pixels.
  Component {
    id: lifeStyle
    Canvas {
      id: c
      readonly property int cell: Math.max(6, Math.round(Math.min(parent.width, parent.height) / 120))
      readonly property int cols: Math.ceil(width / cell)
      readonly property int rows: Math.ceil(height / cell)
      property var grid: []
      property var seen: []
      property int still: 0
      function seed() {
        grid = Array.from({ length: cols * rows }, () => Math.random() < 0.22 ? 1 : 0)
        seen = []
        still = 0
      }
      onColsChanged: seed()
      onRowsChanged: seed()
      function step() {
        const n = new Array(cols * rows).fill(0)
        let alive = 0
        for (let y = 0; y < rows; y++)
          for (let x = 0; x < cols; x++) {
            let k = 0
            for (let dy = -1; dy <= 1; dy++)
              for (let dx = -1; dx <= 1; dx++)
                if (dx || dy) k += grid[((y + dy + rows) % rows) * cols + (x + dx + cols) % cols]
            const v = grid[y * cols + x] ? (k === 2 || k === 3 ? 1 : 0) : (k === 3 ? 1 : 0)
            n[y * cols + x] = v
            alive += v
          }
        // Settled (or nearly empty, or repeating): seeded again.
        const sig = alive
        seen = seen.concat([sig]).slice(-24)
        still = seen.length === 24 && new Set(seen).size <= 3 ? still + 1 : 0
        grid = still > 20 || alive < cols * rows * 0.01 ? (seed(), grid) : n
      }
      Timer { interval: 110; repeat: true; running: root.shown; onTriggered: { c.step(); c.requestPaint() } }
      onPaint: {
        const g = getContext("2d")
        g.fillStyle = String(Theme.bg)
        g.fillRect(0, 0, width, height)
        g.fillStyle = String(Theme.accent)
        for (let i = 0; i < grid.length; i++)
          if (grid[i]) g.fillRect((i % cols) * cell, Math.floor(i / cols) * cell, cell - 1, cell - 1)
      }
    }
  }

  // Pipes growing across the screen, a few at a time; full, and it starts over.
  Component {
    id: pipesStyle
    Canvas {
      id: c
      readonly property int cell: Math.max(14, Math.round(Math.min(parent.width, parent.height) / 40))
      property var heads: []
      property int drawn: 0
      property bool clear: true
      function head() {
        return { x: Math.floor(Math.random() * (width / cell)), y: Math.floor(Math.random() * (height / cell)),
                 d: Math.floor(Math.random() * 4), c: Math.floor(Math.random() * root.palette.length) }
      }
      Component.onCompleted: heads = [head(), head(), head()]
      Timer { interval: 45; repeat: true; running: root.shown; onTriggered: c.requestPaint() }
      onPaint: {
        const g = getContext("2d")
        if (clear || drawn > (width / cell) * (height / cell) * 1.3) {
          g.fillStyle = String(Theme.bg)
          g.fillRect(0, 0, width, height)
          clear = false
          drawn = 0
          heads = [head(), head(), head()]
        }
        g.lineCap = "round"
        g.lineWidth = cell * 0.42
        for (const h of heads) {
          if (Math.random() < 0.18) h.d = (h.d + (Math.random() < 0.5 ? 1 : 3)) % 4
          const nx = h.x + [1, 0, -1, 0][h.d], ny = h.y + [0, 1, 0, -1][h.d]
          if (nx < 0 || ny < 0 || nx * cell > width || ny * cell > height) { Object.assign(h, head()); continue }
          g.strokeStyle = String(root.palette[h.c])
          g.beginPath()
          g.moveTo(h.x * cell + cell / 2, h.y * cell + cell / 2)
          g.lineTo(nx * cell + cell / 2, ny * cell + cell / 2)
          g.stroke()
          h.x = nx
          h.y = ny
          drawn++
        }
      }
    }
  }

  // --- the screens -----------------------------------------------------------

  Variants {
    model: Quickshell.screens

    PanelWindow {
      id: win
      required property var modelData
      screen: modelData
      visible: root.shown || veil.opacity > 0
      anchors { top: true; bottom: true; left: true; right: true }
      color: "transparent"
      exclusionMode: ExclusionMode.Ignore
      WlrLayershell.layer: WlrLayer.Overlay
      WlrLayershell.namespace: "mazapan-screensaver"
      // Keys come here while it shows: the first one only ends it.
      WlrLayershell.keyboardFocus: root.shown ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None

      Item {
        id: veil
        anchors.fill: parent
        opacity: root.shown ? 1 : 0
        Behavior on opacity { NumberAnimation { duration: root.shown ? 1500 : 200; easing.type: Easing.InOutQuad } }
        focus: true
        Keys.onPressed: event => {
          root.shown = false
          event.accepted = true
        }

        Rectangle {
          anchors.fill: parent
          color: root.style === "crt" ? Qt.darker(Theme.bg, 1.6) : Theme.bg
        }

        Loader {
          anchors.fill: parent
          // Only while it shows: nothing runs behind the desktop.
          active: root.shown || veil.opacity > 0
          sourceComponent: ({ glow: glowStyle, mazapan: mazapanStyle, crt: crtStyle, rain: rainStyle,
                              stars: starsStyle, life: lifeStyle, pipes: pipesStyle })[root.style] ?? glowStyle
        }

        // The time, somewhere new each minute (the CRT shows its own).
        Rectangle {
          visible: root.style !== "crt"
          x: clock.x - 24
          y: clock.y - 12
          width: clock.width + 48
          height: clock.height + 24
          radius: Theme.radius
          color: root.style === "glow" ? "transparent" : Qt.rgba(Theme.bg.r, Theme.bg.g, Theme.bg.b, 0.72)
        }
        Column {
          id: clock
          visible: root.style !== "crt"
          spacing: 4
          property int minute: root.now.getHours() * 60 + root.now.getMinutes()
          // A different place each minute, the same on every screen.
          x: (win.width - width) * (0.2 + 0.6 * ((minute * 37) % 100) / 100)
          y: (win.height - height) * (0.25 + 0.5 * ((minute * 61) % 100) / 100)
          Behavior on x { enabled: Theme.motion; NumberAnimation { duration: 4000; easing.type: Easing.InOutSine } }
          Behavior on y { enabled: Theme.motion; NumberAnimation { duration: 4000; easing.type: Easing.InOutSine } }

          Text {
            anchors.horizontalCenter: parent.horizontalCenter
            text: root.now.toLocaleTimeString(root.locale, Locale.ShortFormat)
            color: Theme.fg
            font.family: Theme.fontMono
            font.pixelSize: Math.min(win.width, win.height) * (root.style === "glow" ? 0.16 : 0.09)
            font.weight: Font.Light
          }
          Text {
            visible: {{ settings.date }}
            anchors.horizontalCenter: parent.horizontalCenter
            text: root.now.toLocaleDateString(root.locale, "dddd d MMMM")
            color: Theme.fgMuted
            font.family: Theme.fontUi
            font.pixelSize: Math.min(win.width, win.height) * (root.style === "glow" ? 0.03 : 0.02)
          }
        }

        // The mouse: a move or a click ends it, and goes no further.
        MouseArea {
          id: pointer
          anchors.fill: parent
          hoverEnabled: true
          cursorShape: root.shown ? Qt.BlankCursor : Qt.ArrowCursor
          property point first: Qt.point(-1, -1)
          onPositionChanged: mouse => {
            // The first position is where the pointer already was.
            if (first.x < 0) { first = Qt.point(mouse.x, mouse.y); return }
            if (Math.abs(mouse.x - first.x) + Math.abs(mouse.y - first.y) > 8) root.shown = false
          }
          onPressed: root.shown = false
          Connections {
            target: root
            function onShownChanged() { if (root.shown) pointer.first = Qt.point(-1, -1) }
          }
        }
      }
    }
  }
}
