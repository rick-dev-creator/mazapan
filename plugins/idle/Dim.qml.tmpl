// Generated by mazapan (plugin {{ plugin }}).
//
// The warning before the lock: every screen dims, slowly; a move of the
// mouse or a key and it's gone (hypridle tells: qs ipc -c mazapan call
// idle dim / undim). Clicks go through: it's never in the way.

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import qs
import "../components/idle"

Item {
  id: root

  // A panel by contract (see shell.qml): hypridle opens it, not a key.
  readonly property bool open: false
  function toggle() {}
  function close() { dimmed = false }

  property bool dimmed: false

  IpcHandler {
    target: "idle"
    function dim(): void { root.dimmed = true }
    function undim(): void { root.dimmed = false }
    // The helper says keep-awake changed.
    function refresh(): void { IdleService.refresh() }
  }

  Variants {
    model: Quickshell.screens

    PanelWindow {
      id: win
      required property var modelData
      screen: modelData
      visible: root.dimmed || shade.opacity > 0
      anchors { top: true; bottom: true; left: true; right: true }
      color: "transparent"
      exclusionMode: ExclusionMode.Ignore
      mask: Region {}
      WlrLayershell.layer: WlrLayer.Overlay
      WlrLayershell.namespace: "mazapan-idle-dim"
      WlrLayershell.keyboardFocus: WlrKeyboardFocus.None

      Rectangle {
        id: shade
        anchors.fill: parent
        color: "black"
        opacity: 0
      }

      // In slowly (the time before the lock), out at once.
      NumberAnimation { id: fadeIn; target: shade; property: "opacity"; to: 0.7; duration: 12000; easing.type: Easing.InOutQuad }
      NumberAnimation { id: fadeOut; target: shade; property: "opacity"; to: 0; duration: 150 }
      Connections {
        target: root
        function onDimmedChanged() {
          fadeIn.stop()
          fadeOut.stop()
          if (root.dimmed) fadeIn.start()
          else fadeOut.start()
        }
      }
    }
  }
}
