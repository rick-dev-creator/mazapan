-- Generated by mazapan (plugin {{ plugin }}): hypridle starts with Hyprland,
-- and screens it turned off come back with a key or the mouse (even if
-- hypridle is gone meanwhile: restarted with new settings).
hl.config({
  misc = {
    key_press_enables_dpms = true,
    mouse_move_enables_dpms = true,
  },
})

hl.on("hyprland.start", function()
  hl.dispatch(hl.dsp.exec_cmd("sh ~/.local/share/mazapan/bin/idle start"))
end)
