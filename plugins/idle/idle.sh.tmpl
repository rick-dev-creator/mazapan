# Generated by mazapan (plugin {{ plugin }}): hypridle, which dims, locks,
# turns the screens off and suspends after a while without use.
#
#   idle start      starts it (in the desktop's session)
#   idle restart    again, with its new settings
#   idle awake [on|off|toggle]
#                   keep awake: nothing dims, locks, turns off or
#                   suspends by itself until it's off again (or the next
#                   boot); it still locks before any sleep
#   idle awake?     "true" or "false"
#   idle battery    succeeds on battery (a battery, and no power plugged in)
#   idle screens on|off
run="${XDG_RUNTIME_DIR:-/tmp}"
# Keep awake: an idle inhibitor (systemd's, which hypridle heeds) held by
# a process whose pid is here. hypridle keeps running, so it still locks
# before sleeping.
flag="$run/mazapan-awake"

# The desktop's Hyprland, found if this runs outside it (over ssh, a TTY).
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "$run/hypr" ]; then
  HYPRLAND_INSTANCE_SIGNATURE=$(ls -t "$run/hypr" 2>/dev/null | head -n 1)
  export HYPRLAND_INSTANCE_SIGNATURE
fi
[ -n "${WAYLAND_DISPLAY:-}" ] || { WAYLAND_DISPLAY=$(ls "$run" 2>/dev/null | grep -m 1 '^wayland-[0-9]*$'); export WAYLAND_DISPLAY; }

running() { pgrep -u "$(id -u)" -x hypridle >/dev/null; }
reachable() { [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && hyprctl -j version >/dev/null 2>&1; }

start() {
  [ -e "$HOME/.config/hypr/hypridle.conf" ] || return 0
  reachable || return 0
  # One at a time (Hyprland's start and a reload can come together).
  exec 9>"$run/mazapan-idle.lock"
  flock 9
  running && return 0
  # Through Hyprland: it's then of the desktop's session (whose lock it
  # listens for), wherever this runs.
  [ "$(hyprctl dispatch 'hl.dsp.exec_cmd("hypridle")' 2>/dev/null)" = ok ] \
    || setsid -f hypridle >/dev/null 2>&1 </dev/null
  i=0
  while ! running && [ $i -lt 20 ]; do sleep 0.1; i=$((i + 1)); done
}

stop() {
  pkill -u "$(id -u)" -x hypridle
  i=0
  while running && [ $i -lt 20 ]; do sleep 0.1; i=$((i + 1)); done
  running && pkill -KILL -u "$(id -u)" -x hypridle
  i=0
  while running && [ $i -lt 10 ]; do sleep 0.1; i=$((i + 1)); done
}

awake() { [ -s "$flag" ] && kill -0 "$(cat "$flag")" 2>/dev/null; }

# The bar's indicator follows.
tell() { qs ipc -c mazapan call idle refresh >/dev/null 2>&1 || true; }

case "${1:-}" in
  start) start ;;
  # Only stopped if it can be started again (the desktop is reachable).
  restart) reachable || exit 0; stop; start ;;
  awake)
    want="${2:-toggle}"
    if [ "$want" = toggle ]; then
      if awake; then want=off; else want=on; fi
    fi
    if [ "$want" = on ]; then
      if ! awake; then
        setsid -f sh -c 'echo $$ > "$0"; exec systemd-inhibit --what=idle --who=mazapan --why="Keep awake" --mode=block sleep infinity' "$flag" \
          >/dev/null 2>&1 </dev/null
        i=0
        while ! awake && [ $i -lt 20 ]; do sleep 0.1; i=$((i + 1)); done
      fi
      qs ipc -c mazapan call idle undim >/dev/null 2>&1
    else
      # Its whole group: systemd-inhibit and the sleep it holds.
      awake && kill -- "-$(cat "$flag")" 2>/dev/null
      rm -f "$flag"
    fi
    tell
    ;;
  awake\?) if awake; then echo true; else echo false; fi ;;
  battery)
    bat=no
    for s in /sys/class/power_supply/*; do
      [ -r "$s/type" ] || continue
      case "$(cat "$s/type")" in
        Mains|USB) [ "$(cat "$s/online" 2>/dev/null)" = 1 ] && exit 1 ;;
        Battery) [ "$(cat "$s/scope" 2>/dev/null)" = Device ] || bat=yes ;;
      esac
    done
    [ "$bat" = yes ]
    ;;
  screens) hyprctl dispatch "hl.dsp.dpms({ action = \"${2:-on}\" })" >/dev/null ;;
  *) echo "usage: idle start|restart|awake [on|off|toggle]|awake?|battery|screens on|off" >&2; exit 2 ;;
esac
