# Generated by mazapan (plugin {{ plugin }}): what happens after a while
# without use. Apps that ask to keep the screen on (a video playing, a
# call) are listened to, and so is "keep awake" (idle awake, or the
# palette: an idle inhibitor, so it still locks before any sleep).
{{- idle = "sh ~/.local/share/mazapan/bin/idle" }}

general {
    lock_cmd = pidof hyprlock || hyprlock
{{- if settings.lock_on_sleep }}
    # Locked before sleeping (the lid, the power key, a suspend), and the
    # sleep held back until the lock screen is really up (logind's delay
    # inhibitor, as xss-lock did): nothing on screen when the lid opens.
    before_sleep_cmd = loginctl lock-session
    inhibit_sleep = 3
{{- else }}
    # Nothing to wait for before sleeping.
    inhibit_sleep = 0
{{- end }}
    after_sleep_cmd = {{ idle }} screens on
    ignore_dbus_inhibit = false
    ignore_systemd_inhibit = false
}
{{- if settings.lock > 0 && settings.dim }}

# A warning first: the screens dim; a move and they're back.
listener {
    timeout = {{ settings.lock * 60 - 15 }}
    on-timeout = qs ipc -c mazapan call idle dim
    on-resume = qs ipc -c mazapan call idle undim
}
{{- end }}
{{- if settings.lock > 0 }}

listener {
    timeout = {{ settings.lock * 60 }}
    on-timeout = loginctl lock-session
}
{{- end }}
{{- if settings.screens_off > 0 }}

listener {
    timeout = {{ settings.screens_off * 60 }}
    on-timeout = {{ idle }} screens off
    on-resume = {{ idle }} screens on
}
{{- end }}
{{- if settings.suspend_on_battery > 0 }}

listener {
    timeout = {{ settings.suspend_on_battery * 60 }}
    on-timeout = {{ idle }} battery && systemctl suspend
}
{{- end }}
{{- if settings.suspend > 0 }}

listener {
    timeout = {{ settings.suspend * 60 }}
    # Plugged in (on battery it's the one above's).
    on-timeout = {{ idle }} battery || systemctl suspend
}
{{- end }}
