// Generated by myarch (plugin {{ plugin }}).
//
// Whether you asked to keep awake (the idle helper keeps it: hypridle
// stopped until it's off again), for the bar's indicator and the palette.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
  id: root

  readonly property string helper: Quickshell.env("HOME") + "/.local/share/myarch/bin/idle"
  property bool awake: false

  function refresh() { ask.running = true }
  function toggle() {
    Quickshell.execDetached(["sh", root.helper, "awake", "toggle"])
  }

  Process {
    id: ask
    running: true
    command: ["sh", root.helper, "awake?"]
    stdout: StdioCollector { onStreamFinished: root.awake = text.trim() === "true" }
  }
}
