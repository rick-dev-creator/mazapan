// Generated by mazapan (plugin {{ plugin }}): keep awake, in the Control Center.
//
// A big switch: while it's on, nothing dims, locks or suspends by itself.
// A cup in the pill while it is.

import QtQuick
import qs
import "../../components/kit"
import "../../components/idle"

Tile {
  readonly property string pillGlyph: IdleService.awake ? String.fromCodePoint(0xF0176) : ""

  glyph: String.fromCodePoint(0xF0176) // coffee
  title: {{ tq "tile" }}
  detail: IdleService.awake ? {{ tq "tile.on" }} : {{ tq "tile.off" }}
  checked: IdleService.awake
  onToggled: {
    IdleService.awake = !IdleService.awake
    IdleService.toggle()
    again.restart()
  }
  // What the helper says once it's done.
  Timer { id: again; interval: 600; onTriggered: IdleService.refresh() }
}
