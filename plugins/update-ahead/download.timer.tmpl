# Generated by mazapan (plugin {{ plugin }}): when to look for updates to
# download ahead (every {{ settings.every }} h, and a while after starting).
[Unit]
Description=Mazapan: updates downloaded ahead, every {{ settings.every }} h

[Timer]
OnBootSec=15min
OnUnitActiveSec={{ settings.every }}h
RandomizedDelaySec=20min
Persistent=true

[Install]
WantedBy=timers.target
