// Generated by mazapan (plugin {{ plugin }}).
//
// Crashes, as systemd-coredump records them: each new one said as a
// notification, which app and how, with "Ask an agent" (the agent plugin's
// action: it gets mazapan's report, the crashes of the last day in it).
// Read since the last one said, kept in ~/.local/state/mazapan, so one that
// took the desktop down is said at the next login. The same app crashing
// over and over is said once every ten minutes.

import QtQuick
import Quickshell
import Quickshell.Io

Item {
  id: root

  // A panel by contract (see shell.qml): nothing to open.
  readonly property bool open: false
  function toggle() {}
  function close() {}

  // The agent plugin's "Ask an agent", run as the palette runs it.
  readonly property var ask: ({{ json actions }}).find(a => a.plugin === "agent" && a.terminal && a.run) ?? null
  readonly property string dir: (Quickshell.env("XDG_STATE_HOME") || Quickshell.env("HOME") + "/.local/state") + "/mazapan"
  // Microseconds since the epoch, as coredumpctl gives them.
  property double since: 0
  property bool loaded: false
  property var lastSaid: ({}) // app -> when it was last said (ms)

  readonly property var signalNames: ({ 4: "SIGILL", 5: "SIGTRAP", 6: "SIGABRT", 7: "SIGBUS", 8: "SIGFPE", 11: "SIGSEGV", 31: "SIGSYS" })

  function word(s) {
    return /^[\w@%+=:,./-]+$/.test(s) ? s : "'" + s.replace(/'/g, "'\\''") + "'"
  }

  function found(text) {
    let list = []
    try {
      list = JSON.parse(text)
    } catch (e) {
      return // none ("No coredumps found"), or not readable: next time
    }
    if (!Array.isArray(list)) return
    let newest = since
    const now = Date.now()
    for (const c of list) {
      const t = Number(c.time)
      if (!(t > since)) continue
      newest = Math.max(newest, t)
      const app = String(c.exe || "").split("/").pop() || "?"
      if (now - (lastSaid[app] || 0) < 600000) continue
      lastSaid[app] = now
      say({ app: app, sig: signalNames[c.sig] || ("signal " + c.sig), at: new Date(t / 1000) })
    }
    if (newest > since) {
      since = newest
      save()
    }
  }

  function save() {
    store.setText(JSON.stringify({ since: since }))
  }

  // One notification each, side by side: one left open doesn't hold back
  // the next.
  function say(c) {
    const argv = ["notify-send", "-a", {{ tq "title" }}, "-i", "dialog-warning", "-w"]
    if (ask) argv.push("-A", "ask=" + {{ tq "ask" }})
    argv.push("--", {{ tq "crashed" }}.arg(c.app), {{ tq "how" }}.arg(c.sig).arg(c.at.toLocaleTimeString(Qt.locale("{{ lang }}"), Locale.ShortFormat)))
    const n = notice.createObject(root, { command: argv })
    n.running = true // once it has its command
  }

  // -w: it waits for the notification to go, and says the action chosen.
  Component {
    id: notice
    Process {
      id: p
      stdout: StdioCollector {
        onStreamFinished: {
          if (text.trim() === "ask" && root.ask)
            Quickshell.execDetached(["sh", "-c", "xdg-terminal-exec --hold sh -c " + root.word(root.ask.run)])
        }
      }
      onExited: Qt.callLater(p.destroy)
    }
  }

  Process {
    id: list
    command: ["coredumpctl", "list", "--no-pager", "--json=short", "--since=@" + Math.floor(root.since / 1e6)]
    stdout: StdioCollector { onStreamFinished: root.found(text) }
  }

  Timer {
    interval: {{ settings.every }} * 1000
    repeat: true
    running: root.loaded
    triggeredOnStart: true
    onTriggered: if (!list.running) list.running = true
  }

  FileView {
    id: store
    path: root.dir + "/crash-watch.json"
    atomicWrites: true
    printErrors: false
    onLoaded: {
      let o = null
      try {
        o = JSON.parse(text())
      } catch (e) {}
      root.since = o && o.since > 0 ? o.since : Date.now() * 1000
      root.loaded = true
    }
    // The first time: from now on, not every crash there ever was.
    onLoadFailed: {
      root.since = Date.now() * 1000
      root.save()
      root.loaded = true
    }
  }

  Component.onCompleted: Quickshell.execDetached(["mkdir", "-p", root.dir])
}
