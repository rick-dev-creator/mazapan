-- Generated by myarch (plugin {{.Plugin}}) from theme "{{.Theme.ID}}".
--
-- Hyprland draws no title bars, but it does draw a bar with the title over
-- grouped windows, and every layout makes room for it. So {{.Settings.key}}
-- turns every window into a group of one (titles on) or dissolves those
-- groups again (titles off). Groups you made yourself are left alone.

hl.config({
  group = {
    -- Groups here are only a vehicle for the title: nothing should end up
    -- in one by accident.
    auto_group = false,
    drag_into_group = 0,
    merge_groups_on_drag = false,
    merge_groups_on_groupbar = false,
    ["col.border_active"] = "{{rgb (c "accent")}}",
    ["col.border_inactive"] = "{{rgb (c "border")}}",
    ["col.border_locked_active"] = "{{rgb (c "accent")}}",
    ["col.border_locked_inactive"] = "{{rgb (c "border")}}",
    groupbar = {
      enabled = true,
      render_titles = true,
      height = {{.Settings.height}},
      font_family = "{{.Theme.Font.UI}}",
      font_size = {{num .Theme.Font.Size}},
      text_color = "{{rgb (c "accent_text")}}",
      text_color_inactive = "{{rgb (c "fg_muted")}}",
      text_color_locked_active = "{{rgb (c "accent_text")}}",
      text_color_locked_inactive = "{{rgb (c "fg_muted")}}",
      ["col.active"] = "{{rgb (c "accent_deep")}}",
      ["col.inactive"] = "{{rgb (c "surface_raised")}}",
      ["col.locked_active"] = "{{rgb (c "accent_deep")}}",
      ["col.locked_inactive"] = "{{rgb (c "surface_raised")}}",
      gradients = true,
      rounding = {{.Theme.Shape.Radius}},
      gradient_rounding = {{.Theme.Shape.Radius}},
      indicator_height = 0,
    },
  },
})

local on = false
local ours = {} -- window address -> true for the groups this plugin made

-- A config reload forgets the state above but not the groups. Groups of a
-- single window are what titles-on leaves behind, so pick them back up.
for _, w in ipairs(hl.get_windows() or {}) do
  if w.group and w.group.size == 1 then
    ours[w.address] = true
    on = true
  end
end

local function add(w)
  if w.group then return end -- already grouped, possibly by hand
  hl.dispatch(hl.dsp.group.toggle({ window = w }))
  ours[w.address] = true
end

local function remove_all()
  for _, w in ipairs(hl.get_windows() or {}) do
    -- Only still-single groups: if something joined one, it's a real group.
    if ours[w.address] and w.group and w.group.size == 1 then
      hl.dispatch(hl.dsp.group.toggle({ window = w }))
    end
  end
  ours = {}
end

hl.bind("{{.Settings.key}}", function()
  on = not on
  if on then
    for _, w in ipairs(hl.get_windows() or {}) do add(w) end
  else
    remove_all()
  end
end)

hl.on("window.open", function(w)
  if on and w then add(w) end
end)
