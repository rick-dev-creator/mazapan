# Generated by mazapan (plugin {{ plugin }}).
[general]
# Its own PAM service (mazapan-greetd): the login, and the keyring unlocked.
service = "mazapan-greetd"

[terminal]
vt = 1

# The login screen: a Hyprland of its own running the greeter, as the
# greeter user (it can't read anyone's files).
[default_session]
command = "start-hyprland -- --config /etc/greetd/mazapan-hyprland.lua"
user = "greeter"
# The greeter itself logs in as greetd's own service (no keyring for it).
service = "greetd"
{{- who = username user }}
{{- if settings.autologin && who != "" }}

# Straight in, once each start: the disk's password, typed as it started,
# was the login (an encrypted disk), and it opens the keyring too
# (pam_fde_boot_pw, in mazapan-greetd). After logging out, the login screen.
[initial_session]
command = "sh /etc/greetd/mazapan-session.sh"
user = "{{ who }}"
{{- end }}
