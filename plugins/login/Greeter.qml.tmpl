// Generated by myarch (plugin {{ plugin }}): the login screen.
//
// Run by greetd, as its greeter user, in a Hyprland of its own
// (myarch-hyprland.lua): the clock, whoever uses this computer, their
// password. On its own (no myarch shell here): the theme's colors are
// written in when myarch apply --system renders it.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Services.Greetd

ShellRoot {
  id: root

  readonly property color bg: "{{ theme.colors.bg }}"
  readonly property color bgAlt: "{{ theme.colors.bg_alt }}"
  readonly property color surface: "{{ theme.colors.surface }}"
  readonly property color raised: "{{ theme.colors.surface_raised }}"
  readonly property color border: "{{ theme.colors.border }}"
  readonly property color fg: "{{ theme.colors.fg }}"
  readonly property color fgMuted: "{{ theme.colors.fg_muted }}"
  readonly property color fgSubtle: "{{ theme.colors.fg_subtle }}"
  readonly property color accent: "{{ theme.colors.accent }}"
  readonly property color accentFg: "{{ theme.colors.accent_fg }}"
  readonly property color accentDeep: "{{ theme.colors.accent_deep }}"
  readonly property color danger: "{{ theme.colors.danger }}"
  readonly property string font: {{ quote theme.font.ui }}
  readonly property string mono: {{ quote theme.font.mono }}
  readonly property int radius: {{ theme.shape.radius }}
  readonly property var locale: Qt.locale({{ quote lang_code }})

  // Whoever uses this computer: the accounts people log in with.
  property var users: []
  property int index: 0
  property string message: ""
  property bool busy: false
  property date now: new Date()

  FileView {
    path: "/etc/passwd"
    onLoaded: {
      const out = []
      for (const line of text().split("\n")) {
        const f = line.split(":")
        const uid = Number(f[2])
        if (f.length < 7 || uid < 1000 || uid >= 60000 || /(nologin|false)$/.test(f[6])) continue
        out.push({ name: f[0], full: (f[4] || "").split(",")[0] || f[0] })
      }
      root.users = out
    }
  }

  Timer {
    interval: 1000
    running: true
    repeat: true
    onTriggered: root.now = new Date()
  }

  readonly property var user: users[index] ?? null
  property string password: ""

  function login() {
    if (busy || !user || password === "") return
    busy = true
    message = ""
    Greetd.createSession(user.name)
  }


  Connections {
    target: Greetd
    function onAuthMessage(message, error, responseRequired, echoResponse) {
      if (responseRequired) Greetd.respond(root.password)
      else if (error) root.message = message
    }
    function onAuthFailure(message) {
      root.message = {{ tq "wrong" }}
      root.password = ""
      root.busy = false
    }
    function onReadyToLaunch() {
      root.message = ""
      // Their session (myarch-session.sh): greetd joins the words with
      // spaces, so it's one script, not a command line.
      Greetd.launch(["sh", "/etc/greetd/myarch-session.sh"], [], true)
    }
    function onError(error) {
      root.message = error
      root.busy = false
    }
  }

  Variants {
    model: Quickshell.screens

    PanelWindow {
      id: win
      required property var modelData
      readonly property bool main: modelData === Quickshell.screens[0]
      screen: modelData
      anchors { top: true; bottom: true; left: true; right: true }
      exclusionMode: ExclusionMode.Ignore
      WlrLayershell.layer: WlrLayer.Overlay
      WlrLayershell.keyboardFocus: main ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None
      color: root.bg

      // The theme's glow from below.
      Rectangle {
        anchors.fill: parent
        gradient: Gradient {
          GradientStop { position: 0.0; color: root.bg }
          GradientStop { position: 0.7; color: root.bg }
          GradientStop { position: 1.0; color: root.accentDeep }
        }
      }

      ColumnLayout {
        visible: win.main
        anchors.centerIn: parent
        width: 360
        spacing: 14

        Text {
          // As the language writes it: 24 h in Spanish, 12 h in US English.
          text: root.now.toLocaleTimeString(root.locale, root.locale.timeFormat(Locale.ShortFormat))
          color: root.fg
          font.family: root.mono
          font.pointSize: 64
          font.bold: true
          Layout.alignment: Qt.AlignHCenter
        }
        Text {
          text: root.now.toLocaleDateString(root.locale, "dddd, d MMMM")
          color: root.fgMuted
          font.family: root.font
          font.pointSize: 13
          Layout.alignment: Qt.AlignHCenter
          Layout.bottomMargin: 36
        }

        // Who: their initial, their name; the arrows go through the others.
        Rectangle {
          Layout.alignment: Qt.AlignHCenter
          implicitWidth: 76
          implicitHeight: 76
          radius: 38
          color: root.accent
          Text {
            anchors.centerIn: parent
            text: root.user ? root.user.full.charAt(0).toUpperCase() : ""
            color: root.accentFg
            font.family: root.font
            font.pointSize: 28
            font.bold: true
          }
        }
        RowLayout {
          Layout.alignment: Qt.AlignHCenter
          spacing: 12
          Text {
            visible: root.users.length > 1
            text: "‹"
            color: root.fgSubtle
            font.pointSize: 18
            MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.index = (root.index + root.users.length - 1) % root.users.length }
          }
          Text {
            text: root.user ? root.user.full : ""
            color: root.fg
            font.family: root.font
            font.pointSize: 16
            font.bold: true
          }
          Text {
            visible: root.users.length > 1
            text: "›"
            color: root.fgSubtle
            font.pointSize: 18
            MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.index = (root.index + 1) % root.users.length }
          }
        }

        Rectangle {
          Layout.fillWidth: true
          Layout.topMargin: 6
          implicitHeight: 42
          radius: root.radius
          color: root.surface
          border.width: 1
          border.color: input.activeFocus ? root.accent : root.border

          TextInput {
            id: input
            anchors.fill: parent
            anchors.leftMargin: 14
            anchors.rightMargin: 14
            verticalAlignment: TextInput.AlignVCenter
            echoMode: TextInput.Password
            passwordCharacter: "•"
            color: root.fg
            font.family: root.mono
            font.pointSize: 13
            focus: win.main
            enabled: !root.busy
            text: root.password
            onTextChanged: root.password = text
            onAccepted: root.login()
            Keys.onLeftPressed: event => { if (text === "" && root.users.length > 1) root.index = (root.index + root.users.length - 1) % root.users.length; else event.accepted = false }
            Keys.onRightPressed: event => { if (text === "" && root.users.length > 1) root.index = (root.index + 1) % root.users.length; else event.accepted = false }
          }
          Text {
            visible: input.text === ""
            anchors.fill: input
            verticalAlignment: Text.AlignVCenter
            text: root.busy ? {{ tq "starting" }} : {{ tq "password" }}
            color: root.fgSubtle
            font.family: root.mono
            font.pointSize: 13
          }
        }
        Text {
          text: root.message
          visible: root.message !== ""
          color: root.danger
          font.family: root.font
          font.pointSize: 11
          wrapMode: Text.Wrap
          horizontalAlignment: Text.AlignHCenter
          Layout.fillWidth: true
        }
      }

      // Turning it off without logging in.
      Row {
        visible: win.main
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        anchors.margins: 24
        spacing: 18
        Repeater {
          model: [[{{ tq "restart" }}, "reboot"], [{{ tq "power_off" }}, "poweroff"]]
          Text {
            required property var modelData
            text: modelData[0]
            color: pa.containsMouse ? root.fg : root.fgMuted
            font.family: root.font
            font.pointSize: 11
            MouseArea {
              id: pa
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: Quickshell.execDetached(["systemctl", parent.modelData[1]])
            }
          }
        }
      }
    }
  }
}
