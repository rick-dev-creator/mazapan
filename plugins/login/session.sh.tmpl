# Generated by mazapan (plugin {{ plugin }}): a session, once the login
# screen let someone in (greetd runs it as them). Their desktop: written by
# mazapan the first time (if the install didn't) and whenever Mazapán
# changed since (an update by hand), then Hyprland.
mkdir -p "$HOME/.cache"
mazapan apply --if-updated > "$HOME/.cache/mazapan-login-apply.log" 2>&1
exec start-hyprland > "$HOME/.cache/start-hyprland.log" 2>&1
