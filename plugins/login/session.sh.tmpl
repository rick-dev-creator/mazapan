# Generated by myarch (plugin {{ plugin }}): a session, once the login
# screen let someone in (greetd runs it as them). Their desktop: written by
# myarch the first time (if the install didn't), then Hyprland.
mkdir -p "$HOME/.cache"
[ -e "$HOME/.config/hypr/hyprland.lua" ] || myarch apply > "$HOME/.cache/myarch-first-apply.log" 2>&1
exec start-hyprland > "$HOME/.cache/start-hyprland.log" 2>&1
