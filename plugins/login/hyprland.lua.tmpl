-- Generated by myarch (plugin {{ plugin }}): the login screen's Hyprland.
-- Nothing but the greeter; when it's done (someone logged in), this ends
-- and greetd starts their session.

hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })

-- The keyboard: the system's (localectl set-x11-keymap, the installer),
-- so the password is typed as it'll be typed everywhere else.
local layout, variant = "us", ""
local ok, f = pcall(function() return io.open("/etc/X11/xorg.conf.d/00-keyboard.conf", "r") end)
if ok and f then
  local text = f:read("*a")
  f:close()
  layout = text:match('Option%s+"XkbLayout"%s+"([^"]*)"') or layout
  variant = text:match('Option%s+"XkbVariant"%s+"([^"]*)"') or variant
end

hl.config({
  input = { kb_layout = layout, kb_variant = variant },
  -- Hyprland's own "updated" and donation windows: the desktop says what's new itself.
  ecosystem = {
    no_update_news = true,
    no_donation_nag = true,
  },
  misc = {
    force_default_wallpaper = 0,
    disable_hyprland_logo = true,
    disable_splash_rendering = true,
  },
  animations = { enabled = false },
})

hl.on("hyprland.start", function()
  hl.dispatch(hl.dsp.exec_cmd("sh -c 'qs -p /etc/greetd/myarch-greeter.qml; hyprctl dispatch \"hl.dsp.exit()\"'"))
end)
