# Generated by mazapan (plugin {{ plugin }}): the Framework Laptop 13's
# analog card (AMD's "Family 17h/19h" HD Audio) starts on the profile with
# its built-in microphones, when WirePlumber has none stored for it.
device.profile.priority.rules = [
  {
    matches = [
      {
        device.product.name = "~Family 17h/19h.*"
      }
      {
        device.description = "~Family 17h/19h.*"
      }
    ]
    actions = {
      update-props = {
        priorities = [ "HiFi (Mic1, Mic2, Speaker)" ]
      }
    }
  }
]
