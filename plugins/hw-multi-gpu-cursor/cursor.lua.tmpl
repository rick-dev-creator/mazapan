-- Generated by myarch (plugin {{ plugin }}): this machine has several GPUs.
-- A frame rendered on one and shown by another is copied between them, and
-- every move of a hardware cursor is a commit on the other GPU's cursor
-- plane: its screens flicker as the mouse moves and while typing. Drawn in
-- software, the cursor is part of the frame instead.
hl.config({ cursor = { no_hardware_cursors = true } })
