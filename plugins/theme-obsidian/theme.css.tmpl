/* Generated by mazapan (plugin {{ plugin }}) from theme "{{ theme.id }}". */
.theme-dark, .theme-light {
  --background-primary: #{{ hex (c "bg") }};
  --background-primary-alt: #{{ hex (c "bg_alt") }};
  --background-secondary: #{{ hex (c "surface") }};
  --background-secondary-alt: #{{ hex (c "surface_raised") }};
  --background-modifier-border: #{{ hex (c "border") }};
  --background-modifier-hover: #{{ hex (c "surface_raised") }};
  --text-normal: #{{ hex (c "fg") }};
  --text-muted: #{{ hex (c "fg_muted") }};
  --text-faint: #{{ hex (c "fg_subtle") }};
  --text-accent: #{{ hex (c "accent_text") }};
  --text-accent-hover: #{{ hex (c "accent") }};
  --text-on-accent: #{{ hex (c "accent_fg") }};
  --text-selection: #{{ hex (c "selection") }};
  --interactive-accent: #{{ hex (c "accent") }};
  --interactive-accent-hover: #{{ hex (c "accent_text") }};
  --color-accent: #{{ hex (c "accent") }};
  --link-color: #{{ hex (c "accent_text") }};
  --text-error: #{{ hex (c "danger") }};
  --text-success: #{{ hex (c "success") }};
  --text-warning: #{{ hex (c "warning") }};
  --font-text-theme: "{{ theme.font.ui }}";
  --font-monospace-theme: "{{ theme.font.mono }}";
  --radius-s: {{ theme.shape.radius }}px;
  --radius-m: {{ theme.shape.radius }}px;
}
