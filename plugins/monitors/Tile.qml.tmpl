// Generated by mazapan (plugin {{ plugin }}): the screens, in the Control Center.
//
// A tile that says how many screens and opens the monitor manager.

import QtQuick
import Quickshell
import qs
import "../../components/kit"
import "../../components/control"

Tile {
  readonly property int count: Quickshell.screens.length
  readonly property var first: Quickshell.screens[0]

  glyph: count > 1 ? "󰍺" : "󰍹"
  title: {{ tq "tile" }}
  detail: count > 1 ? {{ tq "tile.many" }}.arg(count) : (first ? first.width + "×" + first.height : "")
  checked: false
  onToggled: {
    ControlService.close()
    Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "monitors"])
  }
}
