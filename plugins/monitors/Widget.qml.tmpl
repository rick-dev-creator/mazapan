// Generated by myarch (plugin {{.Plugin}}).
//
// The screens in the bar: how many are on, when there's more than one.
// Click to open the monitor manager ({{.Settings.key}}).

import QtQuick
import Quickshell
import qs
import "../../components/kit"

BarItem {
  id: root

  readonly property int count: Quickshell.screens.length

  shown: {{.Settings.bar}}
  onClicked: Quickshell.execDetached(["qs", "ipc", "-c", "myarch", "call", "myarch", "panel", "monitors"])

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: root.count > 1 ? "󰍺" : "󰍹"
    color: Theme.accentText
  }
  Label {
    visible: root.count > 1
    anchors.verticalCenter: parent.verticalCenter
    text: root.count
    color: Theme.fgMuted
  }
}
