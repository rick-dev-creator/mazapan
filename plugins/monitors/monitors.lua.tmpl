-- Generated by myarch (plugin {{ plugin }}).
--
-- Monitor profiles. ~/.config/myarch/monitors.json holds them (the manager,
-- {{ settings.key }}, writes it; you can edit it too):
--
--   { "profiles": [ { "name": "Desk", "monitors": [
--       { "id": "JNX JNQOL49G144DQ", "enabled": true, "mode": "5120x1440@144",
--         "position": [0, 0], "scale": 1.25, "transform": 0,
--         "vrr": 1, "bitdepth": 10, "mirror": null,
--         "workspaces": [1, 2, 3, 4, 5, 6] } ] } ] }
--
-- A monitor's id is its EDID description ("make model serial"), which
-- stays put while connector names (DP-2, DP-3…) move around. A monitor
-- without one, or one of two identical monitors, is "output:<connector>".
-- The profile whose monitors are exactly the connected ones is applied at
-- startup and every time a screen comes or goes.

local FILE = os.getenv("HOME") .. "/.config/myarch/monitors.json"
local STATE = os.getenv("HOME") .. "/.local/state/myarch/monitors-hidden.json"

-- A small JSON decoder: Hyprland's Lua has none.
local function decode(str)
  local pos = 1
  local function ws() pos = str:find("[^ \t\r\n]", pos) or #str + 1 end
  local value
  local function err(what) error(("%s at character %d"):format(what, pos)) end
  local function string_()
    local out, i = {}, pos + 1
    while true do
      local c = str:sub(i, i)
      if c == "" then err("unterminated string") end
      if c == '"' then pos = i + 1; return table.concat(out) end
      if c == "\\" then
        local e = str:sub(i + 1, i + 1)
        local map = { b = "\b", f = "\f", n = "\n", r = "\r", t = "\t" }
        if e == "u" then
          out[#out + 1] = utf8.char(tonumber(str:sub(i + 2, i + 5), 16)); i = i + 6
        else
          out[#out + 1] = map[e] or e; i = i + 2
        end
      else
        out[#out + 1] = c; i = i + 1
      end
    end
  end
  function value()
    ws()
    local c = str:sub(pos, pos)
    if c == "{" then
      local obj = {}; pos = pos + 1; ws()
      if str:sub(pos, pos) == "}" then pos = pos + 1; return obj end
      while true do
        ws(); if str:sub(pos, pos) ~= '"' then err("expected a key") end
        local k = string_(); ws()
        if str:sub(pos, pos) ~= ":" then err("expected ':'") end
        pos = pos + 1; obj[k] = value(); ws()
        local d = str:sub(pos, pos); pos = pos + 1
        if d == "}" then return obj elseif d ~= "," then err("expected ',' or '}'") end
      end
    elseif c == "[" then
      local arr, n = {}, 0; pos = pos + 1; ws()
      if str:sub(pos, pos) == "]" then pos = pos + 1; return arr end
      while true do
        -- counted, not #arr + 1: a null must keep its slot
        n = n + 1; arr[n] = value(); ws()
        local d = str:sub(pos, pos); pos = pos + 1
        if d == "]" then return arr elseif d ~= "," then err("expected ',' or ']'") end
      end
    elseif c == '"' then return string_()
    elseif str:sub(pos, pos + 3) == "true" then pos = pos + 4; return true
    elseif str:sub(pos, pos + 4) == "false" then pos = pos + 5; return false
    elseif str:sub(pos, pos + 3) == "null" then pos = pos + 4; return nil
    else
      local num = str:match("^-?%d+%.?%d*[eE]?[-+]?%d*", pos)
      if not num or num == "" then err("unexpected '" .. c .. "'") end
      pos = pos + #num; return tonumber(num)
    end
  end
  local v = value(); ws()
  return v
end

local function read_profiles()
  local f = io.open(FILE, "r")
  if not f then return {} end
  local ok, data = pcall(decode, f:read("a"))
  f:close()
  if not ok then
    hl.notification.create({ text = "monitors.json: " .. tostring(data), duration = 8000 })
    return {}
  end
  return (type(data) == "table" and data.profiles) or {}
end

-- Screens that are plugged in but that Hyprland doesn't list: turned off
-- or mirroring another, by a profile, the manager or anything else.
-- Connector name -> EDID description. Kept on disk: a config reload
-- starts this file over, and those screens would look unplugged.
local hidden = {}

local function save_hidden()
  local parts = {}
  for name, description in pairs(hidden) do
    local function q(v) return '"' .. v:gsub('[%c"\\]', function(c) return ("\\u%04x"):format(c:byte()) end) .. '"' end
    parts[#parts + 1] = q(name) .. ": " .. q(description)
  end
  os.execute("mkdir -p '" .. STATE:match("(.*)/") .. "'")
  local f = io.open(STATE, "w")
  if f then
    f:write("{" .. table.concat(parts, ", ") .. "}\n")
    f:close()
  end
end

do
  local f = io.open(STATE, "r")
  if f then
    local ok, data = pcall(decode, f:read("a"))
    f:close()
    if ok and type(data) == "table" then hidden = data end
  end
end

-- The kernel knows whether a connector has a screen plugged in, even when
-- it's turned off: true or false. Screens without a connector (virtual
-- ones) say nothing: nil.
local function unplugged(name)
  for card = 0, 9 do
    local f = io.open(("/sys/class/drm/card%d-%s/status"):format(card, name), "r")
    if f then
      local status = f:read("l")
      f:close()
      return status == "disconnected"
    end
  end
  return nil
end

local function connected()
  local list, seen, changed = {}, {}, false
  for _, m in ipairs(hl.get_monitors()) do
    list[#list + 1] = { name = m.name, description = m.description or "" }
    seen[m.name] = true
  end
  for name, description in pairs(hidden) do
    -- Listed again (turned back on), or unplugged since: not hidden.
    if seen[name] or unplugged(name) then
      hidden[name] = nil
      changed = true
    else
      list[#list + 1] = { name = name, description = description }
    end
  end
  if changed then save_hidden() end
  -- ids: the description when it's there and unique, else the connector
  local count = {}
  for _, m in ipairs(list) do count[m.description] = (count[m.description] or 0) + 1 end
  for _, m in ipairs(list) do
    m.id = (m.description ~= "" and count[m.description] == 1) and m.description or ("output:" .. m.name)
  end
  return list
end

-- A screen that stays visible: on, and not mirroring another.
local function placed(pm) return pm.enabled ~= false and not pm.mirror end

local function matches(profile, list)
  local want, any = {}, false
  for _, pm in ipairs(profile.monitors or {}) do
    want[pm.id] = true
    any = any or placed(pm)
  end
  -- A profile that leaves no screen visible is never applied.
  if not any then return false end
  local n = 0
  for _ in pairs(want) do n = n + 1 end
  if n ~= #list then return false end
  for _, m in ipairs(list) do
    if not want[m.id] then return false end
  end
  return true
end

local function apply(profile, list)
  local by_id, pms = {}, {}
  for _, m in ipairs(list) do by_id[m.id] = m end
  for _, pm in ipairs(profile.monitors or {}) do pms[pm.id] = pm end
  for _, pm in ipairs(profile.monitors or {}) do
    local m = by_id[pm.id]
    local output = m.name
    if pm.enabled == false then
      hl.monitor({ output = output, disabled = true })
      hidden[output] = m.description
    else
      local rule = { output = output, disabled = false, mode = pm.mode or "preferred",
                     scale = pm.scale or "auto", transform = pm.transform or 0,
                     vrr = pm.vrr or 0, bitdepth = pm.bitdepth or 8 }
      rule.position = pm.position and ((pm.position[1] or 0) .. "x" .. (pm.position[2] or 0)) or "auto"
      -- Mirroring another screen of the profile, by its id, as long as
      -- that one is visible itself. Always set: a rule without it leaves
      -- an earlier mirror in place, "" ends it.
      local src = pm.mirror and pms[pm.mirror]
      rule.mirror = (src and placed(src) and by_id[pm.mirror].name) or ""
      hl.monitor(rule)
      hidden[output] = rule.mirror ~= "" and m.description or nil
      for i, ws in ipairs(pm.workspaces or {}) do
        hl.workspace_rule({ workspace = tostring(ws), monitor = output, default = (i == 1) })
      end
    end
  end
  save_hidden()
end

local last = nil -- the profile applied last, so repeats don't re-apply

-- While the manager tries a layout it's in charge: no profile gets in the
-- way. Bounded, in case the manager goes away mid-try.
local held_until = 0

local function refresh(force)
  if os.time() < held_until then return end
  if force then last = nil end
  local list = connected()
  for _, profile in ipairs(read_profiles()) do
    if matches(profile, list) then
      if last ~= profile.name then apply(profile, list) end
      last = profile.name
      return
    end
  end
  -- No profile for these screens: whatever was turned off comes back on,
  -- and mirrors show their own desktop again. Undocking a laptop whose
  -- desk setup turned its own screen off must not leave you with no
  -- screen at all.
  for name in pairs(hidden) do
    hl.monitor({ output = name, disabled = false, mode = "preferred", position = "auto", scale = "auto", mirror = "" })
  end
  hidden = {}
  save_hidden()
  last = nil
{{- if settings.notify_unknown }}
  if #list > 1 then
    hl.notification.create({ text = ({{ tq "unknown" }}):gsub("%%1", "{{ settings.key }}"), duration = 6000 })
  end
{{- end }}
end

-- Hyprland reports a screen before it's fully set up: look a moment later.
local function soon() hl.timer(function() refresh() end, { timeout = 300, type = "oneshot" }) end

-- The manager calls these: after saving a profile, apply it even if a
-- profile with that name was already in use (its contents changed); and
-- around trying a layout.
myarch_monitors_refresh = function() refresh(true) end
myarch_monitors_hold = function(on) held_until = on and os.time() + 30 or 0 end

refresh()
hl.on("monitor.added", soon)
hl.on("monitor.removed", function(m)
  if not m then return soon() end
  local gone = unplugged(m.name)
  if gone == false then
    -- Still plugged in: turned off or mirroring. It's still part of the
    -- set of screens, whoever did it.
    if hidden[m.name] == nil then
      hidden[m.name] = m.description or ""
      save_hidden()
    end
    return
  end
  -- Unplugged (or a virtual screen, which can't tell): unless this file
  -- just hid it itself, the set of screens changed.
  if gone == nil and hidden[m.name] ~= nil then return end
  hidden[m.name] = nil
  save_hidden()
  soon()
end)

hl.bind("{{ settings.key }}", hl.dsp.exec_cmd("qs ipc -c myarch call myarch panel monitors"))
