// Generated by mazapan (plugin {{ plugin }}): the monitor manager (panel).
//
// Screens as live thumbnails you drag into place (they snap to each other
// and never overlap); click one to set its mode, scale, rotation, whether
// it's on, adaptive sync, 10-bit color, mirroring and which workspaces live
// on it. While it's open every physical screen shows its name, so you know
// which rectangle is which. "Try" applies the layout and goes back on its
// own after 15 s unless you keep it, so a mode that leaves you with a black
// screen can't strand you. "Save profile" writes ~/.config/mazapan/
// monitors.json, which the engine (hypr/mazapan/monitors.lua) applies
// whenever these screens are connected.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var monitors: []  // the working copy
  property var original: []  // as it was when the manager opened
  property var profiles: []
  property int selected: 0
  property string profileName: ""
  property bool testing: false
  property int countdown: 15
  property string message: ""
  // canvas mapping, fixed while open so screens don't jump while dragged
  property real k: 0.1
  property real ox: 0
  property real oy: 0
  property var screenAtOpen: null

  readonly property string file: Quickshell.env("HOME") + "/.config/mazapan/monitors.json"
  readonly property var current: monitors[selected] ?? null

  function toggle() {
    if (open) close()
    else query.running = true // loads the monitors and profiles, then opens
  }

  function close() {
    if (testing) revert()
    open = false
    message = ""
  }

  // --- model -------------------------------------------------------------

  function copy(v) { return JSON.parse(JSON.stringify(v)) }

  // "1920x1080@60.00Hz" -> [1920, 1080, "1920x1080@60.00"]
  function parseMode(s) {
    const m = String(s).replace(/Hz$/, "").match(/^(\d+)x(\d+)@([\d.]+)/)
    return m ? [Number(m[1]), Number(m[2]), `${m[1]}x${m[2]}@${m[3]}`] : [1920, 1080, "preferred"]
  }

  // Logical size: what the screen covers in the layout.
  function size(m) {
    const [w, h] = parseMode(m.mode)
    const turned = m.transform % 2 === 1
    return { w: (turned ? h : w) / m.scale, h: (turned ? w : h) / m.scale }
  }

  // Mirrors and screens that are off take no room in the layout.
  function placed(m) { return m.enabled && !m.mirror }

  function screenOf(name) {
    return Quickshell.screens.find(s => s.name === name) ?? null
  }

  function load(json, stored) {
    const raw = JSON.parse(json)
    const count = {}
    for (const m of raw) count[m.description] = (count[m.description] || 0) + 1
    const idOf = m => m.description && count[m.description] === 1 ? m.description : "output:" + m.name
    monitors = raw.map(m => ({
      name: m.name,
      description: m.description,
      label: [m.make, m.model].filter(x => x).join(" ") || m.name,
      id: idOf(m),
      hid: m.id,
      enabled: !m.disabled,
      modes: m.availableModes,
      mode: m.width > 0 ? `${m.width}x${m.height}@${m.refreshRate.toFixed(2)}` : parseMode(m.availableModes[0])[2],
      x: m.x, y: m.y, scale: m.scale, transform: m.transform,
      vrr: m.vrr ? 1 : 0,
      bitdepth: String(m.currentFormat).includes("2101010") ? 10 : 8,
      mirror: null,
      workspaces: [],
    }))
    // Mirrors point at another screen by id.
    for (const m of raw) {
      const src = raw.find(o => String(o.id) === String(m.mirrorOf))
      if (src) monitors.find(x => x.name === m.name).mirror = idOf(src)
    }
    // Screens that are off report wherever they were last: line them up
    // to the right of the others instead of on top of them.
    let right = Math.max(0, ...monitors.filter(m => m.enabled).map(m => m.x + size(m).w))
    for (const m of monitors) if (!m.enabled) {
      m.x = right + 100
      m.y = 0
      right = m.x + size(m).w
    }
    profiles = parseProfiles(stored) ?? []
    // The profile for these screens, if any: take its name, workspaces,
    // and VRR as set (Hyprland only says whether it's active right now,
    // which "only in fullscreen" isn't most of the time).
    const ids = monitors.map(m => m.id).sort().join("|")
    const p = profiles.find(p => idsOf(p) === ids)
    profileName = p ? p.name : ""
    if (p) for (const m of monitors) {
      const pm = p.monitors.find(pm => pm.id === m.id)
      if (!pm) continue
      m.workspaces = pm.workspaces || []
      if (typeof pm.vrr === "number") m.vrr = pm.vrr
    }
    original = copy(monitors)
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    selected = Math.max(0, monitors.findIndex(m => Hyprland.focusedMonitor && m.name === Hyprland.focusedMonitor.name))
    open = true
    Qt.callLater(fit)
  }

  // The profiles file as `cat` printed it, read fresh every time: it may
  // have been edited, or deleted, by hand. (A FileView's reload() isn't
  // synchronous: text() right after it is the previous read.) null when
  // the file is there but can't be read or parsed: saving over it would
  // lose every other profile.
  function parseProfiles(out) {
    if (out.endsWith("\x1emissing")) return []
    if (!out.endsWith("\x1eok")) {
      message = {{ tq "unreadable" }}.arg("read error")
      return null
    }
    try {
      const list = JSON.parse(out.slice(0, -3) || "{}").profiles || []
      return list.filter(p => p && typeof p.name === "string" && Array.isArray(p.monitors))
    } catch (e) {
      message = {{ tq "unreadable" }}.arg(e.message)
      return null
    }
  }

  function idsOf(p) {
    return p.monitors.map(pm => pm.id).sort().join("|")
  }

  // Scale the layout into the canvas, with room around it to drag into.
  function fit() {
    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity
    for (const m of monitors) {
      const s = size(m)
      x0 = Math.min(x0, m.x); y0 = Math.min(y0, m.y)
      x1 = Math.max(x1, m.x + s.w); y1 = Math.max(y1, m.y + s.h)
    }
    // Room to drag into, less when the canvas is short.
    const room = canvas.height < 200 ? 1.2 : 1.5
    const w = (x1 - x0) * room, h = (y1 - y0) * room
    k = Math.min(canvas.width / w, canvas.height / h)
    ox = (canvas.width - (x1 - x0) * k) / 2 - x0 * k
    oy = (canvas.height - (y1 - y0) * k) / 2 - y0 * k
  }

  function update(i, change) {
    const ms = monitors.slice()
    ms[i] = Object.assign({}, ms[i], change)
    monitors = ms
  }

  // Dropped at (x, y), logical: stick to the edges of the other screens
  // when close, and never overlap one.
  function place(i, x, y) {
    const me = size(monitors[i])
    const snap = 40 / k // 40px on the canvas
    let bx = x, by = y, dx = snap, dy = snap
    for (let j = 0; j < monitors.length; j++) {
      if (j === i || !placed(monitors[j])) continue
      const o = monitors[j], s = size(o)
      for (const c of [o.x, o.x + s.w, o.x - me.w, o.x + s.w - me.w])
        if (Math.abs(c - x) < dx) { dx = Math.abs(c - x); bx = c }
      for (const c of [o.y, o.y + s.h, o.y - me.h, o.y + s.h - me.h])
        if (Math.abs(c - y) < dy) { dy = Math.abs(c - y); by = c }
    }
    // Overlapping one: put it to the right of that one, until it overlaps
    // none (moving right can land on another).
    for (let pass = 0, moved = true; moved && pass <= monitors.length; pass++) {
      moved = false
      for (let j = 0; j < monitors.length; j++) {
        if (j === i || !placed(monitors[j])) continue
        const o = monitors[j], s = size(o)
        if (bx < o.x + s.w && bx + me.w > o.x && by < o.y + s.h && by + me.h > o.y) {
          bx = o.x + s.w
          moved = true
        }
      }
    }
    update(i, { x: Math.round(bx), y: Math.round(by) })
  }

  // A change to the selected screen. What changes its size (mode, scale,
  // rotation) or brings it back into the layout (on, no longer a mirror)
  // can make it overlap: it's placed again where it is. A screen that
  // leaves the layout takes its mirrors with it: they show their own
  // desktop again, placed.
  function change(i, props) {
    update(i, props)
    const m = monitors[i]
    if (!placed(m)) {
      for (let j = 0; j < monitors.length; j++)
        if (monitors[j].mirror === m.id) {
          update(j, { mirror: null })
          place(j, monitors[j].x, monitors[j].y)
        }
    } else if (["mode", "scale", "transform", "enabled", "mirror"].some(k => k in props)) {
      place(i, m.x, m.y)
    }
  }

  // Top-left of the whole layout at 0,0.
  function normalized() {
    const on = monitors.filter(placed)
    if (on.length === 0) return monitors
    const x0 = Math.min(...on.map(m => m.x)), y0 = Math.min(...on.map(m => m.y))
    return monitors.map(m => Object.assign({}, m, placed(m) ? { x: m.x - x0, y: m.y - y0 } : {}))
  }

  // "1-5" / "7,8" -> [1,2,3,4,5] / [7,8]
  function parseWorkspaces(text) {
    const out = []
    for (const part of text.split(",")) {
      const r = part.trim().match(/^(\d+)(?:-(\d+))?$/)
      if (!r) continue
      for (let n = Number(r[1]); n <= Number(r[2] || r[1]); n++) out.push(n)
    }
    return out
  }

  function formatWorkspaces(list) {
    return (list || []).join(",")
  }

  // --- applying ------------------------------------------------------------

  function lua(ms) {
    return ms.map(m => {
      if (!m.enabled) return `hl.monitor({ output = ${JSON.stringify(m.name)}, disabled = true })`
      const src = m.mirror ? ms.find(o => o.id === m.mirror) : null
      return `hl.monitor({ output = ${JSON.stringify(m.name)}, disabled = false, mode = ${JSON.stringify(parseMode(m.mode)[2])}, `
        + `position = "${m.x}x${m.y}", scale = ${m.scale}, transform = ${m.transform}, vrr = ${m.vrr}, bitdepth = ${m.bitdepth}`
        + `, mirror = ${JSON.stringify(src ? src.name : "")} })` // "" ends an earlier mirror
    }).join("; ")
  }

  // While trying, the engine stays out of the way (see monitors.lua): held
  // before a try, released after going back. One call, so they can't
  // arrive out of order.
  function applyNow(ms, trying) {
    Quickshell.execDetached(["hyprctl", "eval", trying ? "mazapan_monitors_hold(true); " + lua(ms) : lua(ms) + "; mazapan_monitors_hold(false)"])
  }

  // Off, or all mirrors: nothing left to see, and no way to fix it.
  function showsSomething() {
    if (monitors.some(placed)) return true
    message = {{ tq "nothing_visible" }}
    return false
  }

  property int attempt: 0  // which try a read-back belongs to
  property int checking: 0

  function tryLayout() {
    if (!showsSomething()) return
    monitors = normalized()
    attempt++
    applyNow(monitors, true)
    testing = true
    countdown = 15
    message = ""
    tick.restart()
    settle.restart()
  }

  // A screen that can't do adaptive sync or 10-bit color quietly stays
  // without it: read back what it took, and say so instead of pretending.
  function verify(json) {
    if (checking !== attempt) return // reverted since, or tried again
    const off = []
    for (const r of JSON.parse(json)) {
      const i = monitors.findIndex(m => m.name === r.name)
      if (i < 0 || !monitors[i].enabled || r.disabled) continue
      const m = monitors[i], change = {}
      if (m.vrr > 0 && !r.vrr) { change.vrr = 0; off.push(`${m.name} ${ {{ tq "vrr" }} }`) }
      if (m.bitdepth === 10 && !String(r.currentFormat).includes("2101010")) { change.bitdepth = 8; off.push(`${m.name} ${ {{ tq "bitdepth" }} }`) }
      if (Object.keys(change).length > 0) update(i, change)
    }
    if (off.length > 0) message = {{ tq "unsupported" }}.arg(off.join(", "))
    if (!testing) original = copy(monitors) // kept before the read-back came
  }

  function release() {
    Quickshell.execDetached(["hyprctl", "eval", "mazapan_monitors_hold(false)"])
  }

  function keep() {
    testing = false
    tick.stop()
    original = copy(monitors)
    message = {{ tq "kept" }}
    release()
  }

  function revert() {
    testing = false
    tick.stop()
    settle.stop()
    attempt++
    monitors = copy(original)
    applyNow(monitors, false)
    message = {{ tq "reverted" }}
  }

  function save(name) {
    if (!showsSomething()) return
    saving = name
    reader.running = true // then finishSave()
  }

  property string saving: ""

  function finishSave(name, stored) {
    const current = parseProfiles(stored)
    if (current === null) return // unreadable: said so, and left alone
    if (testing) keep()
    monitors = normalized()
    const entry = {
      name: name,
      monitors: monitors.map(m => ({
        id: m.id, enabled: m.enabled, mode: parseMode(m.mode)[2],
        position: [m.x, m.y], scale: m.scale, transform: m.transform,
        vrr: m.vrr, bitdepth: m.bitdepth, mirror: m.mirror,
        workspaces: m.workspaces,
      })),
    }
    const ids = entry.monitors.map(pm => pm.id).sort().join("|")
    // One profile per set of screens, and one per name.
    profiles = current.filter(p => p.name !== name && idsOf(p) !== ids).concat([entry])
    store.setText(JSON.stringify({ profiles: profiles }, null, 2) + "\n")
    profileName = name
    original = copy(monitors)
    message = {{ tq "saved" }}.arg(name)
  }

  Timer {
    id: tick
    interval: 1000
    repeat: true
    onTriggered: if (--root.countdown <= 0) root.revert()
  }

  Timer {
    id: settle
    interval: 1500
    onTriggered: if (root.open) {
      root.checking = root.attempt
      check.running = true
    }
  }

  Process {
    id: check
    command: ["hyprctl", "monitors", "all", "-j"]
    stdout: StdioCollector { onStreamFinished: root.verify(text) }
  }

  // The screens, then the profiles file (marked: there, or missing).
  readonly property var readCmd: ["sh", "-c", 'if [ -e "$0" ]; then cat "$0" && printf "\\036ok"; else printf "\\036missing"; fi', root.file]

  Process {
    id: query
    command: ["hyprctl", "monitors", "all", "-j"]
    stdout: StdioCollector {
      onStreamFinished: {
        root.screensJson = text
        loader.running = true
      }
    }
  }
  property string screensJson: ""

  Process {
    id: loader
    command: root.readCmd
    stdout: StdioCollector { onStreamFinished: root.load(root.screensJson, text) }
  }

  Process {
    id: reader
    command: root.readCmd
    stdout: StdioCollector { onStreamFinished: root.finishSave(root.saving, text) }
  }

  FileView {
    id: store
    path: root.file
    preload: false // only for writing: reads go through `cat` (see readCmd)
    atomicWrites: true
    // The write finishes in the background: only then can the engine read it.
    onSaved: Quickshell.execDetached(["hyprctl", "eval", "mazapan_monitors_refresh()"])
  }

  // --- which screen is which -------------------------------------------------

  Variants {
    model: Quickshell.screens

    PanelWindow {
      id: badge
      required property var modelData
      readonly property var m: root.monitors.find(m => m.name === modelData.name) ?? null
      screen: modelData
      visible: root.open && m !== null
      anchors {
        bottom: true
        left: true
      }
      margins {
        bottom: 32
        left: 32
      }
      implicitWidth: tag.implicitWidth
      implicitHeight: tag.implicitHeight
      color: "transparent"
      exclusionMode: ExclusionMode.Ignore
      WlrLayershell.layer: WlrLayer.Top // under the manager, over windows
      WlrLayershell.namespace: "mazapan-monitors-badge"
      mask: Region {}

      Rectangle {
        id: tag
        implicitWidth: tagText.implicitWidth + 48
        implicitHeight: tagText.implicitHeight + 32
        color: badge.m && root.monitors.indexOf(badge.m) === root.selected ? Theme.accent : Theme.accentDeep
        border.width: 1
        border.color: Theme.accent

        Column {
          id: tagText
          anchors.centerIn: parent
          Text {
            text: badge.modelData.name
            color: Theme.accentFg
            font.family: Theme.fontMono
            font.pointSize: 40
            font.bold: true
          }
          Text {
            text: badge.m ? badge.m.label : ""
            textFormat: Text.PlainText
            color: Theme.accentFg
            opacity: 0.8
            font.family: Theme.fontMono
            font.pointSize: 11
          }
        }
      }
    }
  }

  // --- the manager -----------------------------------------------------------

  PanelWindow {
    id: win
    visible: root.open
    // Where it opened: it stays there while you work in it.
    screen: root.screenAtOpen
    // Adapts to the screen it opens on: most of its width, within reason.
    implicitWidth: Math.max(760, Math.min(1320, (screen ? screen.width : 1280) * 0.8))
    implicitHeight: card.implicitHeight
    // Pinned from the top, so it doesn't jump when its height changes.
    anchors.top: true
    margins.top: Math.round(screenHeight * (screenHeight < 800 ? 0.03 : 0.1))
    readonly property real screenHeight: screen ? screen.height : 1080
    // The most it can be, on this screen: the layout gets what's left.
    readonly property real room: screenHeight - margins.top - 16
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-monitors"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive
    onWidthChanged: if (root.open) Qt.callLater(root.fit)

    Rectangle {
      id: card
      width: parent.width
      implicitHeight: body.implicitHeight + 40
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: root.close()

      ColumnLayout {
        id: body
        x: 20
        y: 20
        width: parent.width - 40
        spacing: 14

        RowLayout {
          id: head
          Layout.fillWidth: true
          spacing: 12
          Caption { text: {{ tq "title" }}.toUpperCase() }
          Caption {
            text: root.profileName !== "" ? {{ tq "profile" }}.arg(root.profileName) : {{ tq "no_profile" }}
            color: root.profileName !== "" ? Theme.accentText : Theme.fgSubtle
          }
          Item { Layout.fillWidth: true }
          Caption { text: {{ tq "hint" }} }
        }

        // The layout: live thumbnails of every screen.
        Rectangle {
          id: canvas
          Layout.fillWidth: true
          // What the controls leave, up to a landscape strip.
          implicitHeight: Math.max(96, Math.min(Math.round(width * 0.38), win.room - 40 - 5 * body.spacing
            - head.implicitHeight - details.implicitHeight - rule.implicitHeight
            - Math.max(tryRow.implicitHeight, actions.implicitHeight) - note.Layout.preferredHeight))
          onHeightChanged: if (root.open) Qt.callLater(root.fit)
          color: Theme.bgAlt
          clip: true

          Repeater {
            model: root.monitors

            Rectangle {
              id: screenRect
              required property var modelData
              required property int index
              readonly property var s: root.size(modelData)
              readonly property bool chosen: index === root.selected

              x: root.ox + modelData.x * root.k
              y: root.oy + modelData.y * root.k
              width: s.w * root.k
              height: s.h * root.k
              color: Theme.bg
              opacity: root.placed(modelData) ? 1 : 0.4
              border.width: chosen ? 2 : 1
              clip: true // small layouts: labels stay inside their screen
              border.color: chosen ? Theme.accent : Theme.border
              z: drag.drag.active ? 10 : chosen ? 2 : 1

              // Glide into place after a drop, a new scale or a rotation.
              Behavior on x { enabled: Theme.motion && !drag.drag.active; NumberAnimation { duration: Theme.response; easing.type: Easing.OutQuint } }
              Behavior on y { enabled: Theme.motion && !drag.drag.active; NumberAnimation { duration: Theme.response; easing.type: Easing.OutQuint } }
              Behavior on width { enabled: Theme.motion; NumberAnimation { duration: Theme.response; easing.type: Easing.OutQuint } }
              Behavior on height { enabled: Theme.motion; NumberAnimation { duration: Theme.response; easing.type: Easing.OutQuint } }

              ScreencopyView {
                anchors.fill: parent
                anchors.margins: parent.border.width
                captureSource: root.open && screenRect.modelData.enabled ? root.screenOf(screenRect.modelData.name) : null
                live: root.open
                opacity: 0.55
              }

              Rectangle {
                anchors.centerIn: parent
                width: info.implicitWidth + 16
                height: info.implicitHeight + 10
                color: screenRect.chosen ? Theme.accentDeep : Theme.surfaceRaised
                opacity: 0.92

                Column {
                  id: info
                  anchors.centerIn: parent
                  spacing: 1
                  Label {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: screenRect.modelData.name
                    font.bold: true
                    color: screenRect.chosen ? Theme.accentText : Theme.fg
                  }
                  Caption {
                    anchors.horizontalCenter: parent.horizontalCenter
                    text: `${root.parseMode(screenRect.modelData.mode)[0]}×${root.parseMode(screenRect.modelData.mode)[1]} · ${screenRect.modelData.scale}×`
                  }
                  Caption {
                    anchors.horizontalCenter: parent.horizontalCenter
                    visible: screenRect.modelData.mirror !== null
                    text: "= " + (root.monitors.find(o => o.id === screenRect.modelData.mirror) ?? { name: "?" }).name
                    color: Theme.accentText
                  }
                  Caption {
                    anchors.horizontalCenter: parent.horizontalCenter
                    visible: (screenRect.modelData.workspaces || []).length > 0
                    text: "ws " + root.formatWorkspaces(screenRect.modelData.workspaces)
                    color: Theme.accentText
                  }
                }
              }

              MouseArea {
                id: drag
                anchors.fill: parent
                cursorShape: drag.drag.active ? Qt.ClosedHandCursor : Qt.OpenHandCursor
                drag.target: root.placed(screenRect.modelData) ? screenRect : null
                onPressed: root.selected = screenRect.index
                onReleased: if (drag.drag.active || screenRect.x !== root.ox + screenRect.modelData.x * root.k)
                  root.place(screenRect.index, (screenRect.x - root.ox) / root.k, (screenRect.y - root.oy) / root.k)
              }
            }
          }
        }

        // The selected screen.
        RowLayout {
          id: details
          visible: root.current !== null
          Layout.fillWidth: true
          spacing: 24

          ColumnLayout {
            Layout.alignment: Qt.AlignTop
            Layout.preferredWidth: 1
            Layout.fillWidth: true
            spacing: 8

            Label {
              Layout.fillWidth: true
              elide: Text.ElideRight
              text: root.current ? `${root.current.name} · ${root.current.label}` : ""
              font.bold: true
            }
            Caption { Layout.fillWidth: true; elide: Text.ElideRight; text: root.current ? root.current.id : "" }

            component Switch: RowLayout {
              id: sw
              property alias checked: toggle.checked
              property string text
              signal toggled(bool on)
              spacing: 8
              Toggle { id: toggle; onToggled: on => sw.toggled(on) }
              Label { text: sw.text; color: Theme.fgMuted }
            }

            Switch {
              text: {{ tq "on" }}
              checked: root.current ? root.current.enabled : false
              onToggled: on => root.change(root.selected, { enabled: on })
            }
            Switch {
              text: {{ tq "vrr" }}
              checked: root.current ? root.current.vrr > 0 : false
              onToggled: on => root.change(root.selected, { vrr: on ? 1 : 0 })
            }
            Switch {
              text: {{ tq "bitdepth" }}
              checked: root.current ? root.current.bitdepth === 10 : false
              onToggled: on => root.change(root.selected, { bitdepth: on ? 10 : 8 })
            }

            Caption { text: {{ tq "workspaces" }}.toUpperCase(); Layout.topMargin: 6 }
            TextField {
              id: workspacesField
              Layout.fillWidth: true
              placeholder: {{ tq "workspaces_hint" }}
              // Not bound to the model: rewriting it as you type would eat
              // the "," of "2,3". Filled in when another screen is picked.
              onTextChanged: if (root.current) root.update(root.selected, { workspaces: root.parseWorkspaces(text) })
              Connections {
                target: root
                function onSelectedChanged() { workspacesField.text = root.current ? root.formatWorkspaces(root.current.workspaces) : "" }
                function onOpenChanged() { workspacesField.text = root.current ? root.formatWorkspaces(root.current.workspaces) : "" }
              }
            }
          }

          ColumnLayout {
            Layout.alignment: Qt.AlignTop
            Layout.preferredWidth: 1
            Layout.fillWidth: true
            spacing: 4
            Caption { text: {{ tq "mode" }}.toUpperCase() }
            ListView {
              id: modes
              Layout.fillWidth: true
              implicitHeight: win.screenHeight < 800 ? 110 : 176
              clip: true
              model: root.current ? root.current.modes : []
              delegate: Rectangle {
                required property string modelData
                readonly property bool active: root.current && root.parseMode(modelData)[2] === root.parseMode(root.current.mode)[2]
                width: modes.width
                height: 22
                color: active ? Theme.accentDeep : area.containsMouse ? Theme.surface : "transparent"
                Label {
                  anchors.verticalCenter: parent.verticalCenter
                  x: 8
                  text: modelData
                  color: parent.active ? Theme.accentText : Theme.fg
                }
                MouseArea {
                  id: area
                  anchors.fill: parent
                  hoverEnabled: true
                  onClicked: root.change(root.selected, { mode: root.parseMode(modelData)[2] })
                }
              }
            }
          }

          ColumnLayout {
            Layout.alignment: Qt.AlignTop
            Layout.preferredWidth: 1
            Layout.fillWidth: true
            spacing: 4

            component Choices: Flow {
              id: choices
              property var options: []   // [value, label]
              property var value
              signal chosen(var value)
              Layout.fillWidth: true
              spacing: 4
              Repeater {
                model: choices.options
                Button {
                  required property var modelData
                  text: modelData[1]
                  primary: choices.value === modelData[0]
                  onClicked: choices.chosen(modelData[0])
                }
              }
            }

            Caption { text: {{ tq "scale" }}.toUpperCase() }
            Choices {
              options: [1, 1.25, 1.5, 1.6, 2].map(v => [v, `${v}×`])
              value: root.current ? [1, 1.25, 1.5, 1.6, 2].find(v => Math.abs(v - root.current.scale) < 0.01) : null
              onChosen: v => root.change(root.selected, { scale: v })
            }
            Caption { text: {{ tq "rotation" }}.toUpperCase(); Layout.topMargin: 6 }
            Choices {
              options: [0, 1, 2, 3].map(v => [v, `${v * 90}°`])
              value: root.current ? root.current.transform : null
              onChosen: v => root.change(root.selected, { transform: v })
            }
            Caption { text: {{ tq "mirror" }}.toUpperCase(); Layout.topMargin: 6 }
            Choices {
              // Only a screen that's on, of one in the layout, and never a
              // chain: one that others mirror can't become a mirror itself.
              options: [[null, {{ tq "mirror_none" }}]].concat(!root.current || !root.current.enabled || root.monitors.some(m => m.mirror === root.current.id) ? []
                : root.monitors.filter(m => m.id !== root.current.id && root.placed(m)).map(m => [m.id, m.name]))
              value: root.current ? root.current.mirror : null
              onChosen: v => root.change(root.selected, { mirror: v })
            }
          }
        }

        Rule { id: rule }

        // Keep or go back, while trying a layout.
        RowLayout {
          id: tryRow
          visible: root.testing
          Layout.fillWidth: true
          Label {
            Layout.fillWidth: true
            text: {{ tq "keep_question" }}.arg(root.countdown)
            color: Theme.warning
          }
          Button { text: {{ tq "revert" }}; onClicked: root.revert() }
          Button { text: {{ tq "keep" }}; primary: true; onClicked: root.keep() }
        }

        RowLayout {
          id: actions
          visible: !root.testing
          Layout.fillWidth: true
          spacing: 8
          Button { text: {{ tq "try" }}; onClicked: root.tryLayout() }
          Item { Layout.fillWidth: true }
          TextField {
            id: nameField
            placeholder: {{ tq "profile_name" }}
            text: root.profileName
            onAccepted: if (text.trim() !== "") root.save(text.trim())
          }
          Button {
            text: {{ tq "save" }}
            primary: true
            enabled: nameField.text.trim() !== ""
            onClicked: root.save(nameField.text.trim())
          }
          Button { text: {{ tq "close" }}; onClicked: root.close() }
        }

        // Room for two lines, always: the panel doesn't jump when a
        // message comes or goes.
        Caption {
          id: note
          Layout.fillWidth: true
          Layout.preferredHeight: Math.ceil(2 * metrics.lineSpacing) + 2
          wrapMode: Text.Wrap
          maximumLineCount: 2
          elide: Text.ElideRight
          text: root.message
          color: Theme.fgMuted
          FontMetrics { id: metrics; font: note.font }
        }
      }
    }
  }
}
