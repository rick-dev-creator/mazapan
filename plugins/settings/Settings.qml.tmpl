// Generated by mazapan (plugin {{ plugin }}).
//
// Settings: what everyone needs, a page each. Each change is a
// `mazapan apply` (undoable, on the timeline), run detached: one that
// reloads the shell (a language) opens this again on the same page. The
// rest of every plugin's settings are in the Plugins panel.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  readonly property string logFile: Quickshell.env("HOME") + "/.local/state/mazapan/settings.log"
  readonly property var pages: ["keyboard", "pointer", "text", "keys", "apps", "region", "display", "security"]

  // Keys: every plugin's keybinding; the ones from a setting can be changed,
  // by pressing the new keys (the desktop's own rest meanwhile: a submap).
  readonly property var keyActions: {{ json actions }}.filter(a => a.key)
  property var capturing: null      // the action whose key is being changed
  property string keyMessage: ""
  function startCapture(a) {
    capturing = a
    keyMessage = ""
    Quickshell.execDetached(["hyprctl", "dispatch", 'hl.dsp.submap("mazapan-keys")'])
    keysFocus.forceActiveFocus()
  }
  function endCapture() {
    capturing = null
    Quickshell.execDetached(["hyprctl", "dispatch", 'hl.dsp.submap("reset")'])
  }
  // A key as Hyprland names it ("" for one that isn't a key on its own: a modifier).
  function keyName(e) {
    const k = e.key
    if (k >= Qt.Key_A && k <= Qt.Key_Z) return String.fromCharCode(k)
    if (k >= Qt.Key_0 && k <= Qt.Key_9) return String.fromCharCode(k)
    if (k >= Qt.Key_F1 && k <= Qt.Key_F24) return "F" + (k - Qt.Key_F1 + 1)
    // With SHIFT a digit comes as its sign (US layout's): the digit it is.
    const shifted = { [Qt.Key_Exclam]: "1", [Qt.Key_At]: "2", [Qt.Key_NumberSign]: "3", [Qt.Key_Dollar]: "4", [Qt.Key_Percent]: "5",
                      [Qt.Key_AsciiCircum]: "6", [Qt.Key_Ampersand]: "7", [Qt.Key_Asterisk]: "8", [Qt.Key_ParenLeft]: "9", [Qt.Key_ParenRight]: "0" }
    const named = { [Qt.Key_Space]: "space", [Qt.Key_Return]: "Return", [Qt.Key_Enter]: "Return", [Qt.Key_Tab]: "Tab",
                    [Qt.Key_Left]: "left", [Qt.Key_Right]: "right", [Qt.Key_Up]: "up", [Qt.Key_Down]: "down",
                    [Qt.Key_Comma]: "comma", [Qt.Key_Period]: "period", [Qt.Key_Slash]: "slash", [Qt.Key_Minus]: "minus",
                    [Qt.Key_Equal]: "equal", [Qt.Key_BracketLeft]: "bracketleft", [Qt.Key_BracketRight]: "bracketright",
                    [Qt.Key_Semicolon]: "semicolon", [Qt.Key_Apostrophe]: "apostrophe", [Qt.Key_QuoteLeft]: "grave",
                    [Qt.Key_Backslash]: "backslash", [Qt.Key_Print]: "Print", [Qt.Key_Delete]: "Delete",
                    [Qt.Key_Backspace]: "BackSpace", [Qt.Key_Home]: "Home", [Qt.Key_End]: "End",
                    [Qt.Key_PageUp]: "Prior", [Qt.Key_PageDown]: "Next", [Qt.Key_Insert]: "Insert" }
    return shifted[k] || named[k] || ""
  }
  function combo(e) {
    const mods = []
    if (e.modifiers & Qt.MetaModifier) mods.push("SUPER")
    if (e.modifiers & Qt.ShiftModifier) mods.push("SHIFT")
    if (e.modifiers & Qt.ControlModifier) mods.push("CTRL")
    if (e.modifiers & Qt.AltModifier) mods.push("ALT")
    const k = keyName(e)
    return k === "" ? "" : mods.concat([k]).join(" + ")
  }
  // The same keys, however they're written ("SUPER + space" is "super + Space").
  function sameKeys(a, b) {
    const n = s => s.split("+").map(x => x.trim().toLowerCase()).filter(x => x !== "").sort().join("+")
    return n(a) === n(b)
  }
  function took(e) {
    const c = combo(e)
    if (c === "") return      // a modifier on its own: keep listening
    const other = keyActions.find(a => a !== capturing && sameKeys(a.key, c))
    if (other) { keyMessage = {{ tq "keys.taken" }}.arg(c).arg(other.name); return }
    if (!c.startsWith("SUPER")) { keyMessage = {{ tq "keys.super" }}; return }
    const a = capturing
    endCapture()
    set(a.plugin, a.key_setting, JSON.stringify(c))
  }

  // Text: the fonts installed (fc-list), the monospace ones apart.
  property var uiFonts: []
  property var monoFonts: []
  Process {
    id: fontsProbe
    command: ["sh", "-c", "fc-list -f '%{family[0]}\\n' :scalable=true | sort -u; echo --; fc-list -f '%{family[0]}\\n' :spacing=mono:scalable=true | sort -u"]
    stdout: StdioCollector {
      onStreamFinished: {
        const [ui, mono] = text.split("--\n")
        // Names apply takes (it checks them again): no quotes, backslashes or controls.
        const ok = f => f !== "" && f.length <= 64 && !/["'`\\\x00-\x1f]/.test(f) && !/Emoji|SignWriting|Symbol/i.test(f)
        root.uiFonts = (ui || "").split("\n").filter(ok)
        root.monoFonts = (mono || "").split("\n").filter(ok)
      }
    }
  }

  // The password, changed by `mazapan password --gui` (both on stdin, never
  // on a command line; polkit asks for the password for root): "", running,
  // done, or what went wrong.
  property string pwState: ""
  function changePassword(old, new_) {
    pwState = "running"
    pwProc.payload = JSON.stringify({ old: old, new: new_ })
    pwProc.running = true
  }
  Process {
    id: pwProc
    property string payload: ""
    command: ["mazapan", "password", "--gui"]
    stdinEnabled: true
    onStarted: { write(payload); payload = ""; stdinEnabled = false }
    stdout: StdioCollector { id: pwOut }
    stderr: StdioCollector { id: pwErr }
    onExited: code => {
      stdinEnabled = true
      const keyringFailed = pwOut.text.split("\n").some(l => l.startsWith("step keyring fail"))
      root.pwState = code !== 0 ? (pwErr.text.trim().replace(/^mazapan: /, "") || {{ tq "pw.failed" }})
        : keyringFailed ? {{ tq "pw.keyring" }} : "done"
      if (code === 0) { pwOld.text = ""; pwNew.text = ""; pwAgain.text = "" }
    }
  }
  property string problem: ""

  PersistentProperties {
    id: session
    reloadableId: "mazapan-settings"
    property string page: "keyboard"
    property bool reopen: false
    // A keyboard being tried: the one before ({layout, variant}) and when
    // it comes back unless kept (ms since the epoch; 0: none).
    property string kbBefore: ""
    property double kbUntil: 0
    // Back after a reload an apply caused: open again, and wait for its end.
    onLoaded: if (reopen) Qt.callLater(() => { root.show(); waiting.restart() })
  }

  // A keyboard one can't type with (one's password included) mustn't stay:
  // picked, it's tried, and the one before comes back after a while unless
  // it's kept, as a monitor's mode.
  property int kbLeft: 0
  function setKeyboard(layout, variant) {
    return ["--set=hypr-base.kb_layout=" + JSON.stringify(layout), "--set=hypr-base.kb_variant=" + JSON.stringify(variant)]
  }
  function tryKeyboard(layout, variant) {
    if (layout === root.layout && variant === root.variant) return
    if (session.kbUntil === 0) session.kbBefore = JSON.stringify({ layout: root.layout, variant: root.variant })
    session.kbUntil = Date.now() + 20000
    kbLeft = 20
    apply(setKeyboard(layout, variant))
  }
  function keepKeyboard() {
    session.kbUntil = 0
    session.kbBefore = ""
  }
  function keyboardBack() {
    let before = null
    try {
      before = JSON.parse(session.kbBefore)
    } catch (e) {}
    keepKeyboard()
    if (before && before.layout) apply(setKeyboard(before.layout, before.variant || ""))
  }
  Timer {
    interval: 500
    repeat: true
    running: session.kbUntil > 0
    onTriggered: {
      root.kbLeft = Math.max(0, Math.ceil((session.kbUntil - Date.now()) / 1000))
      if (root.kbLeft === 0) root.keyboardBack()
    }
  }

  function toggle() {
    if (open) close()
    else show()
  }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    session.reopen = false
    refresh()
    open = true
    Qt.callLater(() => card.forceActiveFocus())
  }
  function close() {
    // Listening for keys: the desktop's own come back.
    if (capturing) endCapture()
    open = false
  }
  function refresh() {
    probe.running = true
    defaults.running = true
    lastError.running = true
  }

  // Every change: an apply, detached (it may reload the shell), its log
  // ending "DONE" when it's over: then this looks again (and stops
  // reopening), with what went wrong read from it.
  function apply(args) {
    problem = ""
    session.reopen = true
    Quickshell.execDetached(["sh", "-c", 'mkdir -p ~/.local/state/mazapan; mazapan apply "$@" > "$0" 2>&1; echo DONE >> "$0"', root.logFile].concat(args))
    waiting.restart()
  }
  Timer {
    id: waiting
    interval: 500
    repeat: true
    onTriggered: if (!doneProbe.running) doneProbe.running = true
  }
  Process {
    id: doneProbe
    command: ["sh", "-c", 'tail -n 1 "$0" 2>/dev/null', root.logFile]
    stdout: StdioCollector {
      onStreamFinished: if (text.trim() === "DONE") { waiting.stop(); session.reopen = false; root.refresh() }
    }
  }
  Process {
    id: lastError
    command: ["sh", "-c", 'grep "^mazapan:" "$0" 2>/dev/null | tail -n 1 | sed "s/^mazapan: //"', root.logFile]
    stdout: StdioCollector { onStreamFinished: root.problem = text.trim() !== "" ? {{ tq "failed" }}.arg(text.trim()) : "" }
  }
  function set(plugin, key, toml) { apply(["--set=" + plugin + "." + key + "=" + toml]) }

  // --- what's there ------------------------------------------------------------------

  property var hypr: ({})
  property var languages: []
  property string language: {{ quote lang_code }}
  property string timezone: ""
  property var zones: []
  property var current: ({})

  Process {
    id: probe
    command: ["sh", "-c", 'echo "hypr:$(mazapan plugins show hypr-base --json 2>/dev/null | tr -d "\\n")"; '
      + 'echo "tz:$(timedatectl show -p Timezone --value 2>/dev/null)"; '
      + 'echo "zones:$(awk -F"\\t" "!/^#/ {print \\$3}" /usr/share/zoneinfo/zone1970.tab 2>/dev/null | sort | tr "\\n" " ") UTC"; '
      + 'r=$(dirname "$(dirname "$(readlink -f "$(command -v mazapan)")")"); '
      + "for f in \"$r\"/plugins/installer/locales/*.toml; do c=${f##*/}; echo \"lang:${c%.toml}=$(sed -n 's/^self *= *\"\\(.*\\)\"$/\\1/p' \"$f\")\"; done"]
    stdout: StdioCollector {
      onStreamFinished: {
        const get = k => (text.split("\n").find(l => l.startsWith(k + ":")) || "").slice(k.length + 1)
        try {
          const h = {}
          for (const s of JSON.parse(get("hypr")).settings || []) h[s.key] = s
          root.hypr = h
        } catch (e) {}
        root.timezone = get("tz").trim()
        root.zones = get("zones").trim().split(" ").filter(z => z !== "")
        const langs = []
        for (const l of text.split("\n")) {
          const m = /^lang:([a-z]{2,3}(?:_[A-Z]{2})?)=(.+)$/.exec(l)
          if (m) langs.push([m[1], m[2]])
        }
        root.languages = langs.sort((a, b) => a[1].localeCompare(b[1]))
      }
    }
  }

  // The default apps: each kind's candidates (as default-apps knows them),
  // those installed offered, the one in use marked.
  readonly property var kinds: [
    ["browser", {{ tq "k.browser" }}, "x-scheme-handler/https", ["chromium", "firefox", "org.mozilla.firefox", "brave-browser", "google-chrome"]],
    ["files", {{ tq "k.files" }}, "inode/directory", ["org.gnome.Nautilus", "thunar", "org.kde.dolphin", "pcmanfm"]],
    ["pdf", {{ tq "k.pdf" }}, "application/pdf", ["org.gnome.Papers", "org.gnome.Evince", "okularApplication_pdf", "org.pwmt.zathura", "chromium", "firefox"]],
    ["images", {{ tq "k.images" }}, "image/png", ["org.gnome.Loupe", "org.gnome.eog", "imv", "gimp"]],
    ["video", {{ tq "k.video" }}, "video/mp4", ["io.github.celluloid_player.Celluloid", "mpv", "vlc", "org.gnome.Totem"]],
    ["audio", {{ tq "k.audio" }}, "audio/mpeg", ["io.github.celluloid_player.Celluloid", "mpv", "vlc"]],
    ["text", {{ tq "k.text" }}, "text/plain", ["org.gnome.TextEditor", "code-oss", "dev.zed.Zed", "nvim"]],
    ["email", {{ tq "k.email" }}, "x-scheme-handler/mailto", ["org.mozilla.Thunderbird", "thunderbird"]],
  ]
  Process {
    id: defaults
    // The one chosen (mimeapps.list's [Default Applications], as default-apps reads it).
    command: ["sh", "-c", 'f="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"; for m in "$@"; do '
      + 'echo "$m=$(sed -n "/^\\[Default Applications\\]/,/^\\[/p" "$f" 2>/dev/null | grep -m1 "^$m=" | cut -d= -f2 | cut -d";" -f1)"; done', "sh"]
      .concat(root.kinds.map(k => k[2]))
    stdout: StdioCollector {
      onStreamFinished: {
        const c = {}
        for (const l of text.split("\n")) {
          const i = l.indexOf("=")
          if (i > 0) c[l.slice(0, i)] = l.slice(i + 1).replace(/\.desktop$/, "")
        }
        root.current = c
      }
    }
  }
  function appName(id) {
    const e = DesktopEntries.byId(id)
    return e ? e.name : id
  }

  // The keyboard: as the installer and the welcome offer it.
  property var allLayouts: []
  FileView {
    path: "/usr/share/X11/xkb/rules/base.lst"
    printErrors: false
    onLoaded: {
      const out = []
      let section = ""
      for (const line of text().split("\n")) {
        if (line.startsWith("! ")) { section = line.slice(2).trim(); continue }
        const m = /^\s+(\S+)\s+(.*)$/.exec(line)
        if (!m) continue
        if (section === "layout") out.push({ layout: m[1], variant: "", name: m[2] })
        else if (section === "variant") {
          const v = /^(\S+):\s*(.*)$/.exec(m[2])
          if (v) out.push({ layout: v[1], variant: m[1], name: v[2] })
        }
      }
      root.allLayouts = out
    }
  }
  readonly property string layout: hypr.kb_layout ? String(hypr.kb_layout.value) : ""
  readonly property string variant: hypr.kb_variant ? String(hypr.kb_variant.value) : ""
  readonly property var kbShown: {
    const q = kbSearch.text.toLowerCase().trim()
    const mine = allLayouts.filter(k => k.layout === layout && k.variant === variant)
    if (q === "") return mine
    return mine.concat(allLayouts.filter(k => (k.name + " " + k.layout + " " + k.variant).toLowerCase().includes(q)
      && !(k.layout === layout && k.variant === variant))).slice(0, 80)
  }
  readonly property var zonesShown: {
    const q = tzSearch.text.toLowerCase().trim().replace(/ /g, "_")
    return q === "" ? [] : zones.filter(z => z.toLowerCase().includes(q)).slice(0, 60)
  }
  Process {
    id: zoneSet
    onExited: code => {
      if (code !== 0) root.problem = {{ tq "tz_failed" }}
      root.refresh()
    }
  }

  // --- the screen -------------------------------------------------------------------

  component Choice: Rectangle {
    id: choice
    property string text: ""
    property string detail: ""
    property bool selected: false
    // Shown in this font (a font's own row); "": the theme's.
    property string fontFamily: ""
    signal picked()
    Layout.fillWidth: true
    implicitHeight: detail !== "" ? 50 : 36
    radius: Theme.radius
    color: selected ? Theme.selection : ch.containsMouse ? Theme.surface : "transparent"
    border.color: selected ? Theme.accent : "transparent"
    border.width: 1
    MouseArea {
      id: ch
      anchors.fill: parent
      hoverEnabled: true
      cursorShape: Qt.PointingHandCursor
      onClicked: choice.picked()
    }
    ColumnLayout {
      anchors.fill: parent
      anchors.leftMargin: 12
      anchors.rightMargin: 12
      spacing: 0
      Item { Layout.fillHeight: true }
      Label { text: choice.text; font.bold: choice.selected; font.family: choice.fontFamily !== "" ? choice.fontFamily : font.family; elide: Text.ElideRight; Layout.fillWidth: true }
      Caption { visible: choice.detail !== ""; text: choice.detail; elide: Text.ElideRight; Layout.fillWidth: true }
      Item { Layout.fillHeight: true }
    }
  }

  // A switch or a slider for one of hypr-base's settings.
  component HyprSetting: ColumnLayout {
    id: hs
    property string key: ""
    readonly property var s: root.hypr[key] ?? null
    property var dragged: undefined
    visible: !!s
    Layout.fillWidth: true
    spacing: 2
    RowLayout {
      Layout.fillWidth: true
      Label { text: hs.s ? hs.s.label : ""; Layout.fillWidth: true }
      Toggle {
        visible: !!hs.s && typeof hs.s.value === "boolean"
        checked: !!hs.s && hs.s.value === true
        onToggled: on => root.set("hypr-base", hs.key, on ? "true" : "false")
      }
    }
    Caption { text: hs.s ? hs.s.description : ""; wrapMode: Text.Wrap; Layout.fillWidth: true }
    Slider {
      visible: !!hs.s && typeof hs.s.value === "number"
      Layout.fillWidth: true
      readonly property real lo: hs.s && hs.s.min !== undefined ? hs.s.min : 0
      to: (hs.s && hs.s.max !== undefined ? hs.s.max : 1) - lo
      step: to / 40
      value: (hs.dragged ?? (hs.s ? hs.s.value : 0)) - lo
      onMoved: v => { hs.dragged = Number((lo + v).toFixed(2)); rest.restart() }
      Timer {
        id: rest
        interval: 700
        onTriggered: if (hs.dragged !== undefined) root.set("hypr-base", hs.key, String(hs.dragged))
      }
    }
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    anchors { top: true; bottom: true; left: true; right: true }
    color: Qt.alpha(Theme.bg, 0.6)
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "mazapan-panel-settings"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    MouseArea { anchors.fill: parent; onClicked: root.close() }

    Rectangle {
      id: card
      anchors.centerIn: parent
      width: Math.min(900, parent.width - 40)
      height: Math.min(620, parent.height - 40)
      radius: Theme.radius
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      focus: true
      Keys.onEscapePressed: root.close()
      MouseArea { anchors.fill: parent }

      RowLayout {
        anchors.fill: parent
        anchors.margins: 20
        spacing: 20

        // The pages.
        ColumnLayout {
          Layout.preferredWidth: 210
          Layout.maximumWidth: 210
          Layout.fillWidth: false
          Layout.fillHeight: true
          spacing: 4
          Label { text: {{ tq "title" }}; font.pointSize: 14; font.bold: true; Layout.bottomMargin: 8 }
          Repeater {
            model: root.pages
            Choice {
              required property string modelData
              text: ({ keyboard: {{ tq "p.keyboard" }}, pointer: {{ tq "p.pointer" }}, text: {{ tq "p.text" }}, keys: {{ tq "p.keys" }}, apps: {{ tq "p.apps" }},
                       region: {{ tq "p.region" }}, display: {{ tq "p.display" }}, security: {{ tq "p.security" }} })[modelData]
              selected: session.page === modelData
              onPicked: { session.page = modelData; root.problem = ""; if (modelData === "text" && root.uiFonts.length === 0) fontsProbe.running = true }
            }
          }
          Item { Layout.fillHeight: true }
          Button {
            text: {{ tq "all" }}
            onClicked: { root.close(); Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "plugins"]) }
          }
        }

        Rectangle { Layout.fillHeight: true; implicitWidth: 1; color: Theme.border }

        ColumnLayout {
          Layout.fillWidth: true
          Layout.fillHeight: true
          spacing: 10

          // Keyboard: the one in use, any other by search, tried in a field.
          ColumnLayout {
            visible: session.page === "keyboard"
            Layout.fillWidth: true
            Layout.fillHeight: true
            spacing: 8
            Label { text: {{ tq "p.keyboard" }}; font.pointSize: 13; font.bold: true }
            TextField {
              id: kbSearch
              Layout.fillWidth: true
              placeholder: {{ tq "kb.search" }}
            }
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.kbShown
              delegate: Choice {
                required property var modelData
                width: ListView.view.width
                text: modelData.name
                detail: modelData.layout + (modelData.variant ? " · " + modelData.variant : "")
                selected: root.layout === modelData.layout && root.variant === modelData.variant
                onPicked: root.tryKeyboard(modelData.layout, modelData.variant)
              }
            }
            TextField { Layout.fillWidth: true; placeholder: {{ tq "kb.try" }} }
            // Being tried: kept, or the one before back.
            RowLayout {
              visible: session.kbUntil > 0
              Layout.fillWidth: true
              spacing: 10
              Label {
                text: {{ tq "kb.keep" }}.arg(root.kbLeft)
                wrapMode: Text.Wrap
                Layout.fillWidth: true
              }
              Button { text: {{ tq "kb.back" }}; onClicked: root.keyboardBack() }
              Button { text: {{ tq "kb.keep_it" }}; primary: true; onClicked: root.keepKeyboard() }
            }
          }

          // Touchpad and mouse.
          ColumnLayout {
            visible: session.page === "pointer"
            Layout.fillWidth: true
            spacing: 14
            Label { text: {{ tq "p.pointer" }}; font.pointSize: 13; font.bold: true }
            HyprSetting { key: "tap_to_click" }
            HyprSetting { key: "natural_scroll" }
            HyprSetting { key: "disable_while_typing" }
            HyprSetting { key: "pointer_speed" }
          }

          // Default apps: each kind's installed ones.
          Flickable {
            visible: session.page === "apps"
            Layout.fillWidth: true
            Layout.fillHeight: true
            clip: true
            contentHeight: appsCol.implicitHeight
            ColumnLayout {
              id: appsCol
              width: parent.width
              spacing: 12
              Label { text: {{ tq "p.apps" }}; font.pointSize: 13; font.bold: true }
              Repeater {
                model: root.kinds
                ColumnLayout {
                  id: kindRow
                  required property var modelData
                  readonly property var installed: modelData[3].filter(id => DesktopEntries.byId(id) !== null)
                  Layout.fillWidth: true
                  spacing: 4
                  Caption { text: kindRow.modelData[1] }
                  Flow {
                    Layout.fillWidth: true
                    spacing: 6
                    Repeater {
                      model: kindRow.installed
                      Button {
                        required property string modelData
                        text: root.appName(modelData)
                        primary: root.current[kindRow.modelData[2]] === modelData
                        onClicked: root.set("default-apps", kindRow.modelData[0], JSON.stringify(modelData + ".desktop"))
                      }
                    }
                    Label {
                      visible: kindRow.installed.length === 0
                      text: {{ tq "none_installed" }}
                      color: Theme.fgSubtle
                    }
                  }
                }
              }
            }
          }

          // Language and time zone.
          ColumnLayout {
            visible: session.page === "region"
            Layout.fillWidth: true
            Layout.fillHeight: true
            spacing: 8
            Label { text: {{ tq "p.region" }}; font.pointSize: 13; font.bold: true }
            Caption { text: {{ tq "language" }} }
            Flow {
              Layout.fillWidth: true
              spacing: 6
              Repeater {
                model: root.languages
                Button {
                  required property var modelData
                  text: modelData[1]
                  primary: root.language === modelData[0] || root.language.split("_")[0] === modelData[0]
                  onClicked: if (!primary) root.apply(["--language=" + modelData[0]])
                }
              }
            }
            Caption { text: {{ tq "tz.now" }}.arg((root.timezone || "UTC").replace(/_/g, " ")); Layout.topMargin: 10 }
            TextField {
              id: tzSearch
              Layout.fillWidth: true
              placeholder: {{ tq "tz.search" }}
            }
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.zonesShown
              delegate: Choice {
                required property string modelData
                width: ListView.view.width
                text: modelData.replace(/_/g, " ")
                selected: root.timezone === modelData
                onPicked: if (!zoneSet.running) { zoneSet.command = ["timedatectl", "set-timezone", modelData]; zoneSet.running = true }
              }
            }
          }

          // Screens and the look: their own panels.
          ColumnLayout {
            visible: session.page === "display"
            Layout.fillWidth: true
            spacing: 12
            Label { text: {{ tq "p.display" }}; font.pointSize: 13; font.bold: true }
            Repeater {
              model: [[{{ tq "d.monitors" }}, {{ tq "d.monitors_d" }}, "monitors"], [{{ tq "d.themes" }}, {{ tq "d.themes_d" }}, "themes"],
                      [{{ tq "d.wallpaper" }}, {{ tq "d.wallpaper_d" }}, "wallpapers"]]
              Choice {
                required property var modelData
                text: modelData[0]
                detail: modelData[1]
                onPicked: { root.close(); Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", modelData[2]]) }
              }
            }
          }

          // Text: the fonts and their size, each font shown in itself.
          ColumnLayout {
            visible: session.page === "text"
            Layout.fillWidth: true
            Layout.fillHeight: true
            spacing: 8
            RowLayout {
              Layout.fillWidth: true
              Label { text: {{ tq "p.text" }}; font.pointSize: 13; font.bold: true; Layout.fillWidth: true }
              Button { text: {{ tq "font.theme" }}; onClicked: root.apply(["--font-ui=theme", "--font-mono=theme", "--font-size=theme"]) }
            }
            RowLayout {
              Layout.fillWidth: true
              // 8 to 16 points, by halves; applied once the slider rests.
              property real pending: 0
              Caption { text: {{ tq "font.size" }}.arg(parent.pending > 0 ? parent.pending : Math.round(Theme.fontSize * 10) / 10) }
              Slider {
                Layout.fillWidth: true
                to: 1
                step: 1 / 16
                value: (Theme.fontSize - 8) / 8
                onMoved: v => { parent.pending = 8 + Math.round(v * 16) / 2; sizeApply.restart() }
              }
              Timer { id: sizeApply; interval: 600; onTriggered: root.apply(["--font-size=" + parent.pending]) }
            }
            TextField { id: fontSearch; Layout.fillWidth: true; placeholder: {{ tq "font.search" }} }
            RowLayout {
              Layout.fillWidth: true
              Layout.fillHeight: true
              spacing: 12
              Repeater {
                // The desktop's text, and the monospace one (terminals, code).
                model: [[{{ tq "font.ui" }}, root.uiFonts, Theme.fontUi, "--font-ui="], [{{ tq "font.mono" }}, root.monoFonts, Theme.fontMono, "--font-mono="]]
                ColumnLayout {
                  id: fontCol
                  required property var modelData
                  Layout.fillWidth: true
                  Layout.fillHeight: true
                  Layout.preferredWidth: 1
                  spacing: 4
                  Caption { text: fontCol.modelData[0] }
                  ListView {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    clip: true
                    spacing: 2
                    model: fontCol.modelData[1].filter(f => f.toLowerCase().includes(fontSearch.text.toLowerCase()))
                    delegate: Choice {
                      required property string modelData
                      width: ListView.view.width
                      text: modelData
                      fontFamily: modelData
                      selected: fontCol.modelData[2] === modelData
                      onPicked: if (!selected) root.apply([fontCol.modelData[3] + modelData])
                    }
                  }
                }
              }
            }
          }

          // Keys: each keybinding, changed by pressing the new one.
          ColumnLayout {
            visible: session.page === "keys"
            Layout.fillWidth: true
            Layout.fillHeight: true
            spacing: 8
            Label { text: {{ tq "p.keys" }}; font.pointSize: 13; font.bold: true }
            Caption {
              text: root.capturing ? (root.keyMessage !== "" ? root.keyMessage : {{ tq "keys.press" }}.arg(root.capturing.name)) : {{ tq "keys.d" }}
              color: root.keyMessage !== "" ? Theme.warning : root.capturing ? Theme.accentText : Theme.fgMuted
              wrapMode: Text.Wrap
              Layout.fillWidth: true
            }
            // Where the new keys land while listening.
            Item {
              id: keysFocus
              implicitHeight: 0
              Keys.onPressed: e => {
                if (!root.capturing) return
                e.accepted = true
                if (e.key === Qt.Key_Escape) { root.endCapture(); return }
                root.took(e)
              }
            }
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.keyActions
              delegate: RowLayout {
                id: keyRow
                required property var modelData
                width: ListView.view.width
                spacing: 8
                Label { text: keyRow.modelData.name; elide: Text.ElideRight; Layout.fillWidth: true }
                Rectangle {
                  implicitWidth: keyText.implicitWidth + 12
                  implicitHeight: keyText.implicitHeight + 6
                  radius: Theme.radius
                  color: Theme.bg
                  border.width: 1
                  border.color: root.capturing === keyRow.modelData ? Theme.accent : Theme.border
                  Caption { id: keyText; anchors.centerIn: parent; text: keyRow.modelData.key }
                }
                Button {
                  visible: !!keyRow.modelData.key_setting
                  text: root.capturing === keyRow.modelData ? {{ tq "keys.cancel" }} : {{ tq "keys.change" }}
                  onClicked: root.capturing === keyRow.modelData ? root.endCapture() : root.startCapture(keyRow.modelData)
                }
              }
            }
          }

          // Security: the password, one for the disk, the account and the keyring.
          ColumnLayout {
            visible: session.page === "security"
            Layout.fillWidth: true
            spacing: 8
            Label { text: {{ tq "p.security" }}; font.pointSize: 13; font.bold: true }
            Label { text: {{ tq "pw.title" }}; font.bold: true; Layout.topMargin: 6 }
            Caption { text: {{ tq "pw.d" }}; wrapMode: Text.Wrap; Layout.fillWidth: true }
            TextField { id: pwOld; Layout.fillWidth: true; echoMode: TextInput.Password; placeholder: {{ tq "pw.old" }} }
            TextField { id: pwNew; Layout.fillWidth: true; echoMode: TextInput.Password; placeholder: {{ tq "pw.new" }} }
            TextField { id: pwAgain; Layout.fillWidth: true; echoMode: TextInput.Password; placeholder: {{ tq "pw.again" }} }
            RowLayout {
              Layout.fillWidth: true
              Caption {
                Layout.fillWidth: true
                wrapMode: Text.Wrap
                text: root.pwState === "running" ? {{ tq "pw.running" }}
                  : root.pwState === "done" ? {{ tq "pw.done" }}
                  : pwNew.text !== "" && pwAgain.text !== "" && pwNew.text !== pwAgain.text ? {{ tq "pw.mismatch" }}
                  : root.pwState
                color: root.pwState === "done" ? Theme.success : root.pwState === "running" || root.pwState === "" ? Theme.fgMuted : Theme.danger
              }
              Button {
                primary: true
                text: {{ tq "pw.change" }}
                enabled: root.pwState !== "running" && pwOld.text !== "" && pwNew.text !== "" && pwNew.text === pwAgain.text
                opacity: enabled ? 1 : 0.5
                onClicked: root.changePassword(pwOld.text, pwNew.text)
              }
            }
          }

          Item { Layout.fillHeight: session.page === "pointer" || session.page === "display" || session.page === "security" }
          Caption {
            visible: root.problem !== ""
            text: root.problem
            color: Theme.danger
            wrapMode: Text.Wrap
            Layout.fillWidth: true
          }
        }
      }
    }
  }
}
