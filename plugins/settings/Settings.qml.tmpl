// Generated by myarch (plugin {{ plugin }}).
//
// Settings: what everyone needs, a page each. Each change is a
// `myarch apply` (undoable, on the timeline), run detached: one that
// reloads the shell (a language) opens this again on the same page. The
// rest of every plugin's settings are in the Plugins panel.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  readonly property string logFile: Quickshell.env("HOME") + "/.local/state/myarch/settings.log"
  readonly property var pages: ["keyboard", "pointer", "apps", "region", "display"]
  property string problem: ""

  PersistentProperties {
    id: session
    reloadableId: "myarch-settings"
    property string page: "keyboard"
    property bool reopen: false
    // Back after a reload an apply caused: open again, and wait for its end.
    onLoaded: if (reopen) Qt.callLater(() => { root.show(); waiting.restart() })
  }

  function toggle() {
    if (open) close()
    else show()
  }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    session.reopen = false
    refresh()
    open = true
    Qt.callLater(() => card.forceActiveFocus())
  }
  function close() { open = false }
  function refresh() {
    probe.running = true
    defaults.running = true
    lastError.running = true
  }

  // Every change: an apply, detached (it may reload the shell), its log
  // ending "DONE" when it's over: then this looks again (and stops
  // reopening), with what went wrong read from it.
  function apply(args) {
    problem = ""
    session.reopen = true
    Quickshell.execDetached(["sh", "-c", 'mkdir -p ~/.local/state/myarch; myarch apply "$@" > "$0" 2>&1; echo DONE >> "$0"', root.logFile].concat(args))
    waiting.restart()
  }
  Timer {
    id: waiting
    interval: 500
    repeat: true
    onTriggered: if (!doneProbe.running) doneProbe.running = true
  }
  Process {
    id: doneProbe
    command: ["sh", "-c", 'tail -n 1 "$0" 2>/dev/null', root.logFile]
    stdout: StdioCollector {
      onStreamFinished: if (text.trim() === "DONE") { waiting.stop(); session.reopen = false; root.refresh() }
    }
  }
  Process {
    id: lastError
    command: ["sh", "-c", 'grep "^myarch:" "$0" 2>/dev/null | tail -n 1 | sed "s/^myarch: //"', root.logFile]
    stdout: StdioCollector { onStreamFinished: root.problem = text.trim() !== "" ? {{ tq "failed" }}.arg(text.trim()) : "" }
  }
  function set(plugin, key, toml) { apply(["--set=" + plugin + "." + key + "=" + toml]) }

  // --- what's there ------------------------------------------------------------------

  property var hypr: ({})
  property var languages: []
  property string language: {{ quote lang_code }}
  property string timezone: ""
  property var zones: []
  property var current: ({})

  Process {
    id: probe
    command: ["sh", "-c", 'echo "hypr:$(myarch plugins show hypr-base --json 2>/dev/null | tr -d "\\n")"; '
      + 'echo "tz:$(timedatectl show -p Timezone --value 2>/dev/null)"; '
      + 'echo "zones:$(awk -F"\\t" "!/^#/ {print \\$3}" /usr/share/zoneinfo/zone1970.tab 2>/dev/null | sort | tr "\\n" " ") UTC"; '
      + 'r=$(dirname "$(dirname "$(readlink -f "$(command -v myarch)")")"); '
      + "for f in \"$r\"/plugins/installer/locales/*.toml; do c=${f##*/}; echo \"lang:${c%.toml}=$(sed -n 's/^self *= *\"\\(.*\\)\"$/\\1/p' \"$f\")\"; done"]
    stdout: StdioCollector {
      onStreamFinished: {
        const get = k => (text.split("\n").find(l => l.startsWith(k + ":")) || "").slice(k.length + 1)
        try {
          const h = {}
          for (const s of JSON.parse(get("hypr")).settings || []) h[s.key] = s
          root.hypr = h
        } catch (e) {}
        root.timezone = get("tz").trim()
        root.zones = get("zones").trim().split(" ").filter(z => z !== "")
        const langs = []
        for (const l of text.split("\n")) {
          const m = /^lang:([a-z]{2,3}(?:_[A-Z]{2})?)=(.+)$/.exec(l)
          if (m) langs.push([m[1], m[2]])
        }
        root.languages = langs.sort((a, b) => a[1].localeCompare(b[1]))
      }
    }
  }

  // The default apps: each kind's candidates (as default-apps knows them),
  // those installed offered, the one in use marked.
  readonly property var kinds: [
    ["browser", {{ tq "k.browser" }}, "x-scheme-handler/https", ["chromium", "firefox", "org.mozilla.firefox", "brave-browser", "google-chrome"]],
    ["files", {{ tq "k.files" }}, "inode/directory", ["org.gnome.Nautilus", "thunar", "org.kde.dolphin", "pcmanfm"]],
    ["pdf", {{ tq "k.pdf" }}, "application/pdf", ["org.gnome.Papers", "org.gnome.Evince", "okularApplication_pdf", "org.pwmt.zathura", "chromium", "firefox"]],
    ["images", {{ tq "k.images" }}, "image/png", ["org.gnome.Loupe", "org.gnome.eog", "imv", "gimp"]],
    ["video", {{ tq "k.video" }}, "video/mp4", ["io.github.celluloid_player.Celluloid", "mpv", "vlc", "org.gnome.Totem"]],
    ["audio", {{ tq "k.audio" }}, "audio/mpeg", ["io.github.celluloid_player.Celluloid", "mpv", "vlc"]],
    ["text", {{ tq "k.text" }}, "text/plain", ["org.gnome.TextEditor", "code-oss", "dev.zed.Zed", "nvim"]],
    ["email", {{ tq "k.email" }}, "x-scheme-handler/mailto", ["org.mozilla.Thunderbird", "thunderbird"]],
  ]
  Process {
    id: defaults
    // The one chosen (mimeapps.list's [Default Applications], as default-apps reads it).
    command: ["sh", "-c", 'f="${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"; for m in "$@"; do '
      + 'echo "$m=$(sed -n "/^\\[Default Applications\\]/,/^\\[/p" "$f" 2>/dev/null | grep -m1 "^$m=" | cut -d= -f2 | cut -d";" -f1)"; done', "sh"]
      .concat(root.kinds.map(k => k[2]))
    stdout: StdioCollector {
      onStreamFinished: {
        const c = {}
        for (const l of text.split("\n")) {
          const i = l.indexOf("=")
          if (i > 0) c[l.slice(0, i)] = l.slice(i + 1).replace(/\.desktop$/, "")
        }
        root.current = c
      }
    }
  }
  function appName(id) {
    const e = DesktopEntries.byId(id)
    return e ? e.name : id
  }

  // The keyboard: as the installer and the welcome offer it.
  property var allLayouts: []
  FileView {
    path: "/usr/share/X11/xkb/rules/base.lst"
    printErrors: false
    onLoaded: {
      const out = []
      let section = ""
      for (const line of text().split("\n")) {
        if (line.startsWith("! ")) { section = line.slice(2).trim(); continue }
        const m = /^\s+(\S+)\s+(.*)$/.exec(line)
        if (!m) continue
        if (section === "layout") out.push({ layout: m[1], variant: "", name: m[2] })
        else if (section === "variant") {
          const v = /^(\S+):\s*(.*)$/.exec(m[2])
          if (v) out.push({ layout: v[1], variant: m[1], name: v[2] })
        }
      }
      root.allLayouts = out
    }
  }
  readonly property string layout: hypr.kb_layout ? String(hypr.kb_layout.value) : ""
  readonly property string variant: hypr.kb_variant ? String(hypr.kb_variant.value) : ""
  readonly property var kbShown: {
    const q = kbSearch.text.toLowerCase().trim()
    const mine = allLayouts.filter(k => k.layout === layout && k.variant === variant)
    if (q === "") return mine
    return mine.concat(allLayouts.filter(k => (k.name + " " + k.layout + " " + k.variant).toLowerCase().includes(q)
      && !(k.layout === layout && k.variant === variant))).slice(0, 80)
  }
  readonly property var zonesShown: {
    const q = tzSearch.text.toLowerCase().trim().replace(/ /g, "_")
    return q === "" ? [] : zones.filter(z => z.toLowerCase().includes(q)).slice(0, 60)
  }
  Process {
    id: zoneSet
    onExited: code => {
      if (code !== 0) root.problem = {{ tq "tz_failed" }}
      root.refresh()
    }
  }

  // --- the screen -------------------------------------------------------------------

  component Choice: Rectangle {
    id: choice
    property string text: ""
    property string detail: ""
    property bool selected: false
    signal picked()
    Layout.fillWidth: true
    implicitHeight: detail !== "" ? 50 : 36
    radius: Theme.radius
    color: selected ? Theme.selection : ch.containsMouse ? Theme.surface : "transparent"
    border.color: selected ? Theme.accent : "transparent"
    border.width: 1
    MouseArea {
      id: ch
      anchors.fill: parent
      hoverEnabled: true
      cursorShape: Qt.PointingHandCursor
      onClicked: choice.picked()
    }
    ColumnLayout {
      anchors.fill: parent
      anchors.leftMargin: 12
      anchors.rightMargin: 12
      spacing: 0
      Item { Layout.fillHeight: true }
      Label { text: choice.text; font.bold: choice.selected; elide: Text.ElideRight; Layout.fillWidth: true }
      Caption { visible: choice.detail !== ""; text: choice.detail; elide: Text.ElideRight; Layout.fillWidth: true }
      Item { Layout.fillHeight: true }
    }
  }

  // A switch or a slider for one of hypr-base's settings.
  component HyprSetting: ColumnLayout {
    id: hs
    property string key: ""
    readonly property var s: root.hypr[key] ?? null
    property var dragged: undefined
    visible: !!s
    Layout.fillWidth: true
    spacing: 2
    RowLayout {
      Layout.fillWidth: true
      Label { text: hs.s ? hs.s.label : ""; Layout.fillWidth: true }
      Toggle {
        visible: !!hs.s && typeof hs.s.value === "boolean"
        checked: !!hs.s && hs.s.value === true
        onToggled: on => root.set("hypr-base", hs.key, on ? "true" : "false")
      }
    }
    Caption { text: hs.s ? hs.s.description : ""; wrapMode: Text.Wrap; Layout.fillWidth: true }
    Slider {
      visible: !!hs.s && typeof hs.s.value === "number"
      Layout.fillWidth: true
      readonly property real lo: hs.s && hs.s.min !== undefined ? hs.s.min : 0
      to: (hs.s && hs.s.max !== undefined ? hs.s.max : 1) - lo
      step: to / 40
      value: (hs.dragged ?? (hs.s ? hs.s.value : 0)) - lo
      onMoved: v => { hs.dragged = Number((lo + v).toFixed(2)); rest.restart() }
      Timer {
        id: rest
        interval: 700
        onTriggered: if (hs.dragged !== undefined) root.set("hypr-base", hs.key, String(hs.dragged))
      }
    }
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    anchors { top: true; bottom: true; left: true; right: true }
    color: Qt.alpha(Theme.bg, 0.6)
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "myarch-panel-settings"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    MouseArea { anchors.fill: parent; onClicked: root.close() }

    Rectangle {
      id: card
      anchors.centerIn: parent
      width: Math.min(900, parent.width - 40)
      height: Math.min(620, parent.height - 40)
      radius: Theme.radius
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      focus: true
      Keys.onEscapePressed: root.close()
      MouseArea { anchors.fill: parent }

      RowLayout {
        anchors.fill: parent
        anchors.margins: 20
        spacing: 20

        // The pages.
        ColumnLayout {
          Layout.preferredWidth: 210
          Layout.maximumWidth: 210
          Layout.fillWidth: false
          Layout.fillHeight: true
          spacing: 4
          Label { text: {{ tq "title" }}; font.pointSize: 14; font.bold: true; Layout.bottomMargin: 8 }
          Repeater {
            model: root.pages
            Choice {
              required property string modelData
              text: ({ keyboard: {{ tq "p.keyboard" }}, pointer: {{ tq "p.pointer" }}, apps: {{ tq "p.apps" }},
                       region: {{ tq "p.region" }}, display: {{ tq "p.display" }} })[modelData]
              selected: session.page === modelData
              onPicked: { session.page = modelData; root.problem = "" }
            }
          }
          Item { Layout.fillHeight: true }
          Button {
            text: {{ tq "all" }}
            onClicked: { root.close(); Quickshell.execDetached(["qs", "ipc", "-c", "myarch", "call", "myarch", "panel", "plugins"]) }
          }
        }

        Rectangle { Layout.fillHeight: true; implicitWidth: 1; color: Theme.border }

        ColumnLayout {
          Layout.fillWidth: true
          Layout.fillHeight: true
          spacing: 10

          // Keyboard: the one in use, any other by search, tried in a field.
          ColumnLayout {
            visible: session.page === "keyboard"
            Layout.fillWidth: true
            Layout.fillHeight: true
            spacing: 8
            Label { text: {{ tq "p.keyboard" }}; font.pointSize: 13; font.bold: true }
            TextField {
              id: kbSearch
              Layout.fillWidth: true
              placeholder: {{ tq "kb.search" }}
            }
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.kbShown
              delegate: Choice {
                required property var modelData
                width: ListView.view.width
                text: modelData.name
                detail: modelData.layout + (modelData.variant ? " · " + modelData.variant : "")
                selected: root.layout === modelData.layout && root.variant === modelData.variant
                onPicked: root.apply(["--set=hypr-base.kb_layout=" + JSON.stringify(modelData.layout), "--set=hypr-base.kb_variant=" + JSON.stringify(modelData.variant)])
              }
            }
            TextField { Layout.fillWidth: true; placeholder: {{ tq "kb.try" }} }
          }

          // Touchpad and mouse.
          ColumnLayout {
            visible: session.page === "pointer"
            Layout.fillWidth: true
            spacing: 14
            Label { text: {{ tq "p.pointer" }}; font.pointSize: 13; font.bold: true }
            HyprSetting { key: "tap_to_click" }
            HyprSetting { key: "natural_scroll" }
            HyprSetting { key: "disable_while_typing" }
            HyprSetting { key: "pointer_speed" }
          }

          // Default apps: each kind's installed ones.
          Flickable {
            visible: session.page === "apps"
            Layout.fillWidth: true
            Layout.fillHeight: true
            clip: true
            contentHeight: appsCol.implicitHeight
            ColumnLayout {
              id: appsCol
              width: parent.width
              spacing: 12
              Label { text: {{ tq "p.apps" }}; font.pointSize: 13; font.bold: true }
              Repeater {
                model: root.kinds
                ColumnLayout {
                  id: kindRow
                  required property var modelData
                  readonly property var installed: modelData[3].filter(id => DesktopEntries.byId(id) !== null)
                  Layout.fillWidth: true
                  spacing: 4
                  Caption { text: kindRow.modelData[1] }
                  Flow {
                    Layout.fillWidth: true
                    spacing: 6
                    Repeater {
                      model: kindRow.installed
                      Button {
                        required property string modelData
                        text: root.appName(modelData)
                        primary: root.current[kindRow.modelData[2]] === modelData
                        onClicked: root.set("default-apps", kindRow.modelData[0], JSON.stringify(modelData + ".desktop"))
                      }
                    }
                    Label {
                      visible: kindRow.installed.length === 0
                      text: {{ tq "none_installed" }}
                      color: Theme.fgSubtle
                    }
                  }
                }
              }
            }
          }

          // Language and time zone.
          ColumnLayout {
            visible: session.page === "region"
            Layout.fillWidth: true
            Layout.fillHeight: true
            spacing: 8
            Label { text: {{ tq "p.region" }}; font.pointSize: 13; font.bold: true }
            Caption { text: {{ tq "language" }} }
            Flow {
              Layout.fillWidth: true
              spacing: 6
              Repeater {
                model: root.languages
                Button {
                  required property var modelData
                  text: modelData[1]
                  primary: root.language === modelData[0] || root.language.split("_")[0] === modelData[0]
                  onClicked: if (!primary) root.apply(["--language=" + modelData[0]])
                }
              }
            }
            Caption { text: {{ tq "tz.now" }}.arg((root.timezone || "UTC").replace(/_/g, " ")); Layout.topMargin: 10 }
            TextField {
              id: tzSearch
              Layout.fillWidth: true
              placeholder: {{ tq "tz.search" }}
            }
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.zonesShown
              delegate: Choice {
                required property string modelData
                width: ListView.view.width
                text: modelData.replace(/_/g, " ")
                selected: root.timezone === modelData
                onPicked: if (!zoneSet.running) { zoneSet.command = ["timedatectl", "set-timezone", modelData]; zoneSet.running = true }
              }
            }
          }

          // Screens and the look: their own panels.
          ColumnLayout {
            visible: session.page === "display"
            Layout.fillWidth: true
            spacing: 12
            Label { text: {{ tq "p.display" }}; font.pointSize: 13; font.bold: true }
            Repeater {
              model: [[{{ tq "d.monitors" }}, {{ tq "d.monitors_d" }}, "monitors"], [{{ tq "d.themes" }}, {{ tq "d.themes_d" }}, "themes"],
                      [{{ tq "d.wallpaper" }}, {{ tq "d.wallpaper_d" }}, "wallpapers"]]
              Choice {
                required property var modelData
                text: modelData[0]
                detail: modelData[1]
                onPicked: { root.close(); Quickshell.execDetached(["qs", "ipc", "-c", "myarch", "call", "myarch", "panel", modelData[2]]) }
              }
            }
          }

          Item { Layout.fillHeight: session.page === "pointer" || session.page === "display" }
          Caption {
            visible: root.problem !== ""
            text: root.problem
            color: Theme.danger
            wrapMode: Text.Wrap
            Layout.fillWidth: true
          }
        }
      }
    }
  }
}
