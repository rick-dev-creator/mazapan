// Generated by mazapan (plugin {{ plugin }}): the network in the Control Center.
//
// Wi-Fi as a big switch (on, off, and the network it's on); its arrow
// opens the networks below the switches, to join one (a password asked in
// place the first time). The switch never moves: its arrow stays where the
// pointer is. On a computer with a cable and no Wi-Fi: the cable, and
// nothing to switch.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Networking
import qs
import "../../components/kit"
import "../../components/control"

Tile {
  id: root

  readonly property var devices: Networking.devices.values
  readonly property var wifi: devices.find(d => d.type === DeviceType.Wifi) ?? null
  readonly property var wired: devices.filter(d => d.type === DeviceType.Wired)
  readonly property var networks: wifi ? wifi.networks.values : []
  readonly property var current: networks.find(n => n.connected) ?? null
  readonly property bool wiredUp: wired.some(d => d.connected)
  readonly property bool listing: ControlService.detail === list

  property var asking: null     // the network its password is asked for
  property var joining: null    // the one a password was just given to
  property var chosen: null     // the one last picked: only its failures are said
  property string problem: ""
  readonly property string wifiGlyph: !Networking.wifiEnabled ? "󰤮" : current ? glyphFor(strength(current)) : "󰤯"
  readonly property string pillGlyph: wiredUp ? "󰈀" : wifi ? wifiGlyph : "󰲛"

  function strength(n) {
    const s = n ? n.signalStrength : 0
    return s > 1 ? s / 100 : s
  }
  function glyphFor(s) {
    return s >= 0.75 ? "󰤨" : s >= 0.5 ? "󰤥" : s >= 0.25 ? "󰤢" : s > 0 ? "󰤟" : "󰤯"
  }
  function choose(n) {
    problem = ""
    chosen = n
    if (n.connected) n.disconnect()
    else if (n.known || n.security === WifiSecurityType.Open || n.security === WifiSecurityType.Unknown) n.connect()
    else ask(n)
  }
  function ask(n) {
    asking = n
    joining = null
  }
  function cancel() {
    asking = null
    joining = null
    chosen = null
    problem = ""
  }
  onListingChanged: {
    if (wifi) wifi.scannerEnabled = listing
    if (!listing) cancel()
  }

  glyph: wifi ? wifiGlyph : "󰈀"
  title: wifi ? {{ tq "tile.wifi" }} : {{ tq "tile.ethernet" }}
  detail: wifi ? (!Networking.wifiEnabled ? {{ tq "off" }}
      : current ? current.name : {{ tq "disconnected" }})
    : (wiredUp ? {{ tq "connected" }} : {{ tq "disconnected" }})
  checked: wifi ? Networking.wifiEnabled : wiredUp
  more: wifi !== null && Networking.wifiEnabled
  expanded: listing
  onToggled: {
    if (!wifi) return
    if (Networking.wifiEnabled && listing) ControlService.detail = null
    Networking.wifiEnabled = !Networking.wifiEnabled
  }
  onOpened: ControlService.detail = listing ? null : list

  // The networks, below the switches. While a password is asked, only
  // that network and its password: right under the switches, never
  // scrolled away below the others.
  Component {
    id: list
    Group {
      title: {{ tq "tile.wifi" }}
      Repeater {
        model: root.asking ? [root.asking]
          : root.networks.slice().sort((a, b) =>
              (b.connected - a.connected) || (b.known - a.known) || (root.strength(b) - root.strength(a))).slice(0, 8)
        ListRow {
          id: net
          required property var modelData
          readonly property bool secured: modelData.security !== WifiSecurityType.Open
            && modelData.security !== WifiSecurityType.Unknown
          Layout.fillWidth: true
          glyph: root.glyphFor(root.strength(modelData))
          title: modelData.name
          detail: modelData.connected ? {{ tq "connected" }}
            : modelData.stateChanging ? {{ tq "connecting" }}
            : modelData.known ? {{ tq "saved" }}
            : secured ? {{ tq "secured" }} : {{ tq "open" }}
          trailing: secured ? "󰌾" : ""
          active: modelData.connected
          // Right click forgets a saved network (its password asked again).
          onClicked: mouse => {
            if (root.asking) return
            if (mouse.button === Qt.RightButton) {
              if (modelData.known) modelData.forget()
            } else {
              root.choose(modelData)
            }
          }
          Connections {
            target: net.modelData
            function onConnectedChanged() {
              if (!net.modelData.connected) return
              root.problem = ""
              if (root.asking === net.modelData) root.cancel()
            }
            function onConnectionFailed(reason) {
              // One given up on (Cancel, another picked): its late failure isn't news.
              if (root.chosen !== net.modelData) return
              const auth = reason === ConnectionFailReason.NoSecrets || reason === ConnectionFailReason.WifiClientDisconnected
                || reason === ConnectionFailReason.WifiAuthTimeout
              const mine = root.joining === net.modelData
              // A password just typed that was refused: NetworkManager kept
              // it, so it's forgotten. Asked again, the field still open,
              // also after a failure that wasn't the password (to try again).
              if (mine && auth && reason !== ConnectionFailReason.NoSecrets) net.modelData.forget()
              root.problem = (auth ? {{ tq "wrong_password" }} : {{ tq "failed" }}).arg(net.modelData.name)
              if (auth || mine) { root.ask(net.modelData); Qt.callLater(prompt.focusField) }
            }
          }
        }
      }
      PasswordPrompt {
        id: prompt
        visible: root.asking !== null
        Layout.fillWidth: true
        label: root.asking ? {{ tq "password_label" }}.arg(root.asking.name) : ""
        actionText: {{ tq "join" }}
        cancelText: {{ tq "cancel" }}
        busyText: root.asking ? {{ tq "joining" }}.arg(root.asking.name) : ""
        busy: root.joining !== null && root.joining === root.asking
        error: root.problem
        minLength: root.asking && root.asking.security === WifiSecurityType.StaticWep ? 5 : 8
        onVisibleChanged: if (visible) Qt.callLater(start)
        onSubmitted: password => {
          root.problem = ""
          root.joining = root.asking
          root.asking.connectWithPsk(password)
        }
        onCancelled: root.cancel()
        Connections {
          target: root
          function onAskingChanged() { if (root.asking && !root.joining) Qt.callLater(prompt.start) }
        }
      }
      // Nothing found yet: it's looking (the list fills in as it does).
      Caption {
        visible: root.networks.length === 0
        text: {{ tq "scanning" }}
        font.letterSpacing: 0
      }
      Caption {
        visible: root.problem !== "" && root.asking === null
        Layout.fillWidth: true
        text: root.problem
        color: Theme.danger
        wrapMode: Text.Wrap
        font.letterSpacing: 0
      }
    }
  }
}
