// Generated by mazapan (plugin {{ plugin }}): the network in the Control Center.
//
// Wi-Fi as a big switch (on, off, and the network it's on); its arrow
// opens the networks right below it, to join one (a password asked in
// place the first time). On a computer with a cable and no Wi-Fi: the
// cable, and nothing to switch.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Networking
import qs
import "../../components/kit"

ColumnLayout {
  id: root

  readonly property var devices: Networking.devices.values
  readonly property var wifi: devices.find(d => d.type === DeviceType.Wifi) ?? null
  readonly property var wired: devices.filter(d => d.type === DeviceType.Wired)
  readonly property var networks: wifi ? wifi.networks.values : []
  readonly property var current: networks.find(n => n.connected) ?? null
  readonly property bool wiredUp: wired.some(d => d.connected)

  property bool expanded: false
  property var asking: null
  property string problem: ""
  readonly property bool wide: expanded && Networking.wifiEnabled
  readonly property string wifiGlyph: !Networking.wifiEnabled ? "󰤮" : current ? glyphFor(strength(current)) : "󰤯"
  readonly property string pillGlyph: wiredUp ? "󰈀" : wifi ? wifiGlyph : "󰲛"

  spacing: 6

  function strength(n) {
    const s = n ? n.signalStrength : 0
    return s > 1 ? s / 100 : s
  }
  function glyphFor(s) {
    return s >= 0.75 ? "󰤨" : s >= 0.5 ? "󰤥" : s >= 0.25 ? "󰤢" : s > 0 ? "󰤟" : "󰤯"
  }
  function choose(n) {
    problem = ""
    if (n.connected) n.disconnect()
    else if (n.known || n.security === WifiSecurityType.Open || n.security === WifiSecurityType.Unknown) n.connect()
    else asking = n
  }
  onExpandedChanged: {
    if (wifi) wifi.scannerEnabled = expanded
    if (!expanded) { asking = null; problem = "" }
  }

  Tile {
    glyph: root.wifi ? root.wifiGlyph : "󰈀"
    title: root.wifi ? {{ tq "tile.wifi" }} : {{ tq "tile.ethernet" }}
    detail: root.wifi ? (!Networking.wifiEnabled ? {{ tq "off" }}
        : root.current ? root.current.name : {{ tq "disconnected" }})
      : (root.wiredUp ? {{ tq "connected" }} : {{ tq "disconnected" }})
    checked: root.wifi ? Networking.wifiEnabled : root.wiredUp
    more: root.wifi !== null && Networking.wifiEnabled
    expanded: root.expanded
    onToggled: {
      if (!root.wifi) return
      if (Networking.wifiEnabled) root.expanded = false
      Networking.wifiEnabled = !Networking.wifiEnabled
    }
    onOpened: root.expanded = !root.expanded
  }

  // The networks, right here.
  Rectangle {
    visible: root.expanded && Networking.wifiEnabled
    Layout.fillWidth: true
    implicitHeight: list.implicitHeight + 12
    radius: Theme.radius
    color: Theme.surface
    border.width: 1
    border.color: Theme.border

    ColumnLayout {
      id: list
      x: 6
      y: 6
      width: parent.width - 12
      spacing: 2

      Repeater {
        model: root.networks.slice().sort((a, b) =>
          (b.connected - a.connected) || (b.known - a.known) || (root.strength(b) - root.strength(a))).slice(0, 8)
        ListRow {
          id: net
          required property var modelData
          readonly property bool secured: modelData.security !== WifiSecurityType.Open
            && modelData.security !== WifiSecurityType.Unknown
          Layout.fillWidth: true
          glyph: root.glyphFor(root.strength(modelData))
          title: modelData.name
          detail: modelData.connected ? {{ tq "connected" }}
            : modelData.stateChanging ? {{ tq "connecting" }}
            : modelData.known ? {{ tq "saved" }}
            : secured ? {{ tq "secured" }} : {{ tq "open" }}
          trailing: secured ? "󰌾" : ""
          active: modelData.connected
          onClicked: root.choose(modelData)
          Connections {
            target: net.modelData
            function onConnectionFailed(reason) {
              const wrong = reason === ConnectionFailReason.NoSecrets
              root.problem = (wrong ? {{ tq "wrong_password" }} : {{ tq "failed" }}).arg(net.modelData.name)
              if (wrong) root.asking = net.modelData
            }
          }
        }
      }

      TextField {
        id: password
        visible: root.asking !== null
        Layout.fillWidth: true
        placeholder: root.asking ? {{ tq "password_for" }}.arg(root.asking.name) : ""
        echoMode: TextInput.Password
        onVisibleChanged: if (visible) { text = ""; focusInput() }
        onAccepted: {
          if (root.asking && text !== "") root.asking.connectWithPsk(text)
          root.asking = null
        }
      }
      Caption {
        visible: root.problem !== ""
        text: root.problem
        color: Theme.danger
        font.letterSpacing: 0
      }
    }
  }
}
