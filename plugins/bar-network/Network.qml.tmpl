// Generated by mazapan (plugin {{ plugin }}).
//
// Network state in the bar; click for the card: a Wi-Fi switch, wired
// connections and the Wi-Fi networks in range. Click a network to join it
// (or leave it, if connected); secured ones you haven't joined before ask
// for the password in place. Right-click a saved network to forget it. The
// card scans only while it's open.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Networking
import qs
import "../../components/kit"

BarItem {
  id: root

  readonly property var devices: Networking.devices.values
  readonly property var wifi: devices.find(d => d.type === DeviceType.Wifi) ?? null
  readonly property var wired: devices.filter(d => d.type === DeviceType.Wired)
  readonly property var wifiNetworks: wifi ? wifi.networks.values : []
  readonly property var wifiConnected: wifiNetworks.find(n => n.connected) ?? null
  readonly property bool wiredConnected: wired.some(d => d.connected)

  // NetworkManager reports strength as a percentage; accept 0..1 too.
  function strength(n) {
    const s = n ? n.signalStrength : 0
    return s > 1 ? s / 100 : s
  }

  function strengthGlyph(s) {
    if (s >= 0.75) return "󰤨"
    if (s >= 0.5) return "󰤥"
    if (s >= 0.25) return "󰤢"
    if (s > 0) return "󰤟"
    return "󰤯"
  }

  readonly property string glyph: wiredConnected ? "󰈀"
      : wifiConnected ? strengthGlyph(strength(wifiConnected))
      : wifi && !Networking.wifiEnabled ? "󰤮"
      : "󰲛"

  open: popup.visible
  onClicked: popup.toggle()

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: root.glyph
    color: root.wiredConnected || root.wifiConnected ? Theme.accentText : Theme.fgSubtle
  }

  BarPopup {
    id: popup
    owner: root
    cardWidth: 340
    onVisibleChanged: {
      if (root.wifi) root.wifi.scannerEnabled = visible
      if (!visible) {
        cancel()
        hideQr()
      }
    }

    property var asking: null  // secured network waiting for its password
    property var joining: null // the one a password was just given to
    property var chosen: null  // the one last picked: only its failures are said
    property string problem: ""

    function choose(n) {
      problem = ""
      chosen = n
      if (n.connected) {
        n.disconnect()
      } else if (n.known || n.security === WifiSecurityType.Open || n.security === WifiSecurityType.Unknown) {
        n.connect()
      } else {
        ask(n)
      }
    }
    function ask(n) {
      asking = n
      joining = null
    }
    function cancel() {
      asking = null
      joining = null
      chosen = null
      problem = ""
    }

    // --- wired ------------------------------------------------------------
    ColumnLayout {
      visible: root.wired.length > 0
      Layout.fillWidth: true
      spacing: 4

      Caption { text: {{ tq "ethernet" }}.toUpperCase() }

      Repeater {
        model: root.wired
        ListRow {
          required property var modelData
          glyph: modelData.connected ? "󰈀" : "󰲛"
          title: modelData.name
          // Virtual adapters report no speed: then just "connected".
          detail: modelData.connected ? (modelData.linkSpeed > 0 ? {{ tq "speed" }}.arg(modelData.linkSpeed) : {{ tq "connected" }})
                : !modelData.hasLink ? {{ tq "cable_unplugged" }}
                : {{ tq "disconnected" }}
          active: modelData.connected
        }
      }
    }

    Rule { visible: root.wired.length > 0 && root.wifi !== null }

    // --- wi-fi ------------------------------------------------------------
    ColumnLayout {
      visible: root.wifi !== null
      Layout.fillWidth: true
      spacing: 4

      RowLayout {
        Layout.fillWidth: true
        Caption { text: {{ tq "wifi" }}.toUpperCase() }
        Item { Layout.fillWidth: true }
        Toggle {
          checked: Networking.wifiEnabled
          enabled: Networking.wifiHardwareEnabled
          opacity: enabled ? 1 : 0.4
          onToggled: on => Networking.wifiEnabled = on
        }
      }

      Label {
        visible: !Networking.wifiEnabled
        text: {{ tq "wifi_off" }}
        color: Theme.fgMuted
      }

      Label {
        visible: Networking.wifiEnabled && root.wifiNetworks.length === 0
        text: {{ tq "no_networks" }}
        color: Theme.fgMuted
      }

      Repeater {
        // Connected first, then saved ones, then by signal; while a
        // password is asked, only that network, its password right below.
        model: !Networking.wifiEnabled ? [] : popup.asking ? [popup.asking] : root.wifiNetworks.slice().sort((a, b) =>
          (b.connected - a.connected) || (b.known - a.known) || (root.strength(b) - root.strength(a)))

        ListRow {
          id: net
          required property var modelData
          // Once connected, NetworkManager may report the security as
          // Unknown; only a known, non-open type gets the lock.
          readonly property bool secured: modelData.security !== WifiSecurityType.Open
              && modelData.security !== WifiSecurityType.Unknown

          glyph: root.strengthGlyph(root.strength(modelData))
          title: modelData.name
          detail: modelData.connected ? {{ tq "connected" }}
                : modelData.stateChanging ? {{ tq "connecting" }}
                : modelData.known ? {{ tq "saved" }}
                : secured ? {{ tq "secured" }} : {{ tq "open" }}
          trailing: secured ? "󰌾" : ""
          active: modelData.connected
          onClicked: mouse => {
            if (popup.asking) return
            if (mouse.button === Qt.RightButton) {
              if (modelData.known) modelData.forget()
            } else {
              popup.choose(modelData)
            }
          }

          Connections {
            target: net.modelData
            function onConnectedChanged() {
              if (!net.modelData.connected) return
              popup.problem = ""
              if (popup.asking === net.modelData) popup.cancel()
            }
            function onConnectionFailed(reason) {
              // One given up on (Cancel, another picked): its late failure isn't news.
              if (popup.chosen !== net.modelData) return
              const auth = reason === ConnectionFailReason.NoSecrets || reason === ConnectionFailReason.WifiClientDisconnected
                || reason === ConnectionFailReason.WifiAuthTimeout
              const mine = popup.joining === net.modelData
              // A password just typed that was refused: NetworkManager kept
              // it, so it's forgotten. Asked again, the field still open,
              // also after a failure that wasn't the password (to try again).
              if (mine && auth && reason !== ConnectionFailReason.NoSecrets) net.modelData.forget()
              popup.problem = (auth ? {{ tq "wrong_password" }} : {{ tq "failed" }}).arg(net.modelData.name)
              if (auth || mine) { popup.ask(net.modelData); Qt.callLater(prompt.focusField) }
            }
          }
        }
      }

      // Password for a secured network joined for the first time.
      PasswordPrompt {
        id: prompt
        visible: popup.asking !== null
        Layout.fillWidth: true
        Layout.topMargin: 4
        label: popup.asking ? {{ tq "password_label" }}.arg(popup.asking.name) : ""
        actionText: {{ tq "join" }}
        cancelText: {{ tq "cancel" }}
        busyText: popup.asking ? {{ tq "joining" }}.arg(popup.asking.name) : ""
        busy: popup.joining !== null && popup.joining === popup.asking
        error: popup.problem
        minLength: popup.asking && popup.asking.security === WifiSecurityType.StaticWep ? 5 : 8
        onVisibleChanged: if (visible) Qt.callLater(start)
        onSubmitted: password => {
          popup.problem = ""
          popup.joining = popup.asking
          popup.asking.connectWithPsk(password)
        }
        onCancelled: popup.cancel()
        Connections {
          target: popup
          function onAskingChanged() { if (popup.asking && !popup.joining) Qt.callLater(prompt.start) }
        }
      }

      Caption {
        visible: popup.problem !== "" && popup.asking === null
        text: popup.problem
        color: Theme.danger
      }

      Caption {
        visible: Networking.wifiEnabled && root.wifiNetworks.some(n => n.known)
        Layout.topMargin: 2
        text: {{ tq "hint" }}
      }
    }

    // --- share, and how fast ------------------------------------------------
    Rule {}
    RowLayout {
      Layout.fillWidth: true
      spacing: 6
      Button {
        visible: root.wifiConnected !== null
        text: popup.qr !== "" ? {{ tq "share_hide" }} : {{ tq "share" }}
        onClicked: popup.qr !== "" ? popup.hideQr() : wifiShare.running = true
      }
      Item { Layout.fillWidth: true }
      Button {
        text: speed.running ? {{ tq "speed_running" }} : {{ tq "speed_test" }}
        enabled: !speed.running
        onClicked: { popup.speedText = ""; speed.running = true }
      }
    }
    // This Wi-Fi as a code a phone's camera joins (WIFI:…;; the usual form),
    // its password from NetworkManager; drawn only while asked for.
    property string qr: ""
    property string qrSsid: ""
    // The code holds the password: its file goes as soon as it's hidden.
    function hideQr() {
      if (qr !== "") Quickshell.execDetached(["rm", "-f", qrMake.file])
      qr = ""
    }
    Process {
      id: wifiShare
      // By UUID (a name can hold ":"), values as they are (-e no: nmcli
      // escapes ":" and "\\" otherwise, and the code would hold them twice).
      command: ["sh", "-c", 'u=$(nmcli -e no -t -f UUID,TYPE connection show --active | awk -F: \'$2=="802-11-wireless"{print $1; exit}\'); [ -n "$u" ] || exit 1; '
        + 'nmcli -e no -s -g 802-11-wireless.ssid,802-11-wireless-security.key-mgmt,802-11-wireless-security.psk connection show uuid "$u"']
      stdout: StdioCollector {
        onStreamFinished: {
          const [ssid, mgmt, psk] = text.replace(/\n$/, "").split("\n")
          // A network with a password of its own per person (WPA-Enterprise)
          // or none to read: nothing a code can hold.
          const open = !mgmt && !psk
          if (!ssid || (!open && !(psk && ["wpa-psk", "sae", "wpa-none"].includes(mgmt)))) {
            popup.problem = {{ tq "share_cant" }}
            return
          }
          const esc = v => v.replace(/([\\;,:"])/g, "\\$1")
          popup.qrSsid = ssid
          // T:WPA covers WPA2 and WPA3 personal, as phones read it.
          qrMake.payload = open ? `WIFI:T:nopass;S:${esc(ssid)};;` : `WIFI:T:WPA;S:${esc(ssid)};P:${esc(psk)};;`
          qrMake.running = true
        }
      }
      onExited: code => { if (code !== 0) popup.problem = {{ tq "share_cant" }} }
    }
    Process {
      id: qrMake
      property string payload: ""
      readonly property string file: Quickshell.env("XDG_RUNTIME_DIR") + "/mazapan-wifi-qr.svg"
      command: ["sh", "-c", 'umask 077; qrencode -t SVG -m 2 -o "$0"', file]
      stdinEnabled: true
      onStarted: { write(payload); payload = ""; stdinEnabled = false }
      onExited: code => {
        stdinEnabled = true
        popup.qr = ""
        if (code === 0) popup.qr = "file://" + file
        else popup.problem = {{ tq "share_cant" }}
      }
    }
    ColumnLayout {
      visible: popup.qr !== ""
      Layout.alignment: Qt.AlignHCenter
      spacing: 4
      Image {
        source: popup.qr
        Layout.preferredWidth: 180
        Layout.preferredHeight: 180
        Layout.alignment: Qt.AlignHCenter
        sourceSize: Qt.size(360, 360)
        smooth: false
        cache: false
      }
      Caption { text: {{ tq "share_scan" }}.arg(popup.qrSsid); Layout.alignment: Qt.AlignHCenter }
    }

    // How fast: Cloudflare's own speed test endpoints (no account, no token).
    property string speedText: ""
    Process {
      id: speed
      command: ["sh", "-c", 'u=https://speed.cloudflare.com; '
        + 'p=$(curl -s -o /dev/null -w "%{time_connect}" --max-time 5 "$u/__down?bytes=0"); '
        + 'd=$(curl -s -o /dev/null -w "%{speed_download}" --max-time 15 "$u/__down?bytes=25000000"); '
        + 'up=$(head -c 10000000 /dev/zero | curl -s -o /dev/null -w "%{speed_upload}" --max-time 15 --data-binary @- "$u/__up"); '
        + 'echo "$d $up $p"']
      stdout: StdioCollector {
        onStreamFinished: {
          const [d, u, p] = text.trim().split(" ").map(Number)
          const mbps = v => Math.round(v * 8 / 1e5) / 10
          popup.speedText = !(d > 0) ? {{ tq "speed_failed" }}
            : {{ tq "speed_result" }}.arg(mbps(d)).arg(mbps(u || 0)).arg(Math.round((p || 0) * 1000))
        }
      }
    }
    Caption {
      visible: popup.speedText !== ""
      text: popup.speedText
      Layout.fillWidth: true
      horizontalAlignment: Text.AlignHCenter
    }
  }
}
