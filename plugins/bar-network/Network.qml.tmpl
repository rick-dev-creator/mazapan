// Generated by myarch (plugin {{ plugin }}).
//
// Network state in the bar; click for the card: a Wi-Fi switch, wired
// connections and the Wi-Fi networks in range. Click a network to join it
// (or leave it, if connected); secured ones you haven't joined before ask
// for the password in place. Right-click a saved network to forget it. The
// card scans only while it's open.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Networking
import qs
import "../../components/kit"

BarItem {
  id: root

  readonly property var devices: Networking.devices.values
  readonly property var wifi: devices.find(d => d.type === DeviceType.Wifi) ?? null
  readonly property var wired: devices.filter(d => d.type === DeviceType.Wired)
  readonly property var wifiNetworks: wifi ? wifi.networks.values : []
  readonly property var wifiConnected: wifiNetworks.find(n => n.connected) ?? null
  readonly property bool wiredConnected: wired.some(d => d.connected)

  // NetworkManager reports strength as a percentage; accept 0..1 too.
  function strength(n) {
    const s = n ? n.signalStrength : 0
    return s > 1 ? s / 100 : s
  }

  function strengthGlyph(s) {
    if (s >= 0.75) return "󰤨"
    if (s >= 0.5) return "󰤥"
    if (s >= 0.25) return "󰤢"
    if (s > 0) return "󰤟"
    return "󰤯"
  }

  readonly property string glyph: wiredConnected ? "󰈀"
      : wifiConnected ? strengthGlyph(strength(wifiConnected))
      : wifi && !Networking.wifiEnabled ? "󰤮"
      : "󰲛"

  open: popup.visible
  onClicked: popup.toggle()

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: root.glyph
    color: root.wiredConnected || root.wifiConnected ? Theme.accentText : Theme.fgSubtle
  }

  BarPopup {
    id: popup
    owner: root
    cardWidth: 340
    onVisibleChanged: {
      if (root.wifi) root.wifi.scannerEnabled = visible
      if (!visible) {
        asking = null
        problem = ""
      }
    }

    property var asking: null // secured network waiting for its password
    property string problem: ""

    function choose(n) {
      problem = ""
      if (n.connected) {
        n.disconnect()
      } else if (n.known || n.security === WifiSecurityType.Open || n.security === WifiSecurityType.Unknown) {
        n.connect()
      } else {
        asking = n
      }
    }

    // --- wired ------------------------------------------------------------
    ColumnLayout {
      visible: root.wired.length > 0
      Layout.fillWidth: true
      spacing: 4

      Caption { text: {{ tq "ethernet" }}.toUpperCase() }

      Repeater {
        model: root.wired
        ListRow {
          required property var modelData
          glyph: modelData.connected ? "󰈀" : "󰲛"
          title: modelData.name
          // Virtual adapters report no speed: then just "connected".
          detail: modelData.connected ? (modelData.linkSpeed > 0 ? {{ tq "speed" }}.arg(modelData.linkSpeed) : {{ tq "connected" }})
                : !modelData.hasLink ? {{ tq "cable_unplugged" }}
                : {{ tq "disconnected" }}
          active: modelData.connected
        }
      }
    }

    Rule { visible: root.wired.length > 0 && root.wifi !== null }

    // --- wi-fi ------------------------------------------------------------
    ColumnLayout {
      visible: root.wifi !== null
      Layout.fillWidth: true
      spacing: 4

      RowLayout {
        Layout.fillWidth: true
        Caption { text: {{ tq "wifi" }}.toUpperCase() }
        Item { Layout.fillWidth: true }
        Toggle {
          checked: Networking.wifiEnabled
          enabled: Networking.wifiHardwareEnabled
          opacity: enabled ? 1 : 0.4
          onToggled: on => Networking.wifiEnabled = on
        }
      }

      Label {
        visible: !Networking.wifiEnabled
        text: {{ tq "wifi_off" }}
        color: Theme.fgMuted
      }

      Label {
        visible: Networking.wifiEnabled && root.wifiNetworks.length === 0
        text: {{ tq "no_networks" }}
        color: Theme.fgMuted
      }

      Repeater {
        // Connected first, then saved ones, then by signal.
        model: Networking.wifiEnabled ? root.wifiNetworks.slice().sort((a, b) =>
          (b.connected - a.connected) || (b.known - a.known) || (root.strength(b) - root.strength(a))) : []

        ListRow {
          id: net
          required property var modelData
          // Once connected, NetworkManager may report the security as
          // Unknown; only a known, non-open type gets the lock.
          readonly property bool secured: modelData.security !== WifiSecurityType.Open
              && modelData.security !== WifiSecurityType.Unknown

          glyph: root.strengthGlyph(root.strength(modelData))
          title: modelData.name
          detail: modelData.connected ? {{ tq "connected" }}
                : modelData.stateChanging ? {{ tq "connecting" }}
                : modelData.known ? {{ tq "saved" }}
                : secured ? {{ tq "secured" }} : {{ tq "open" }}
          trailing: secured ? "󰌾" : ""
          active: modelData.connected
          onClicked: mouse => {
            if (mouse.button === Qt.RightButton) {
              if (modelData.known) modelData.forget()
            } else {
              popup.choose(modelData)
            }
          }

          Connections {
            target: net.modelData
            function onConnectedChanged() {
              if (net.modelData.connected) popup.problem = ""
            }
            function onConnectionFailed(reason) {
              const wrong = reason === ConnectionFailReason.NoSecrets
              popup.problem = (wrong ? {{ tq "wrong_password" }} : {{ tq "failed" }}).arg(net.modelData.name)
              // NetworkManager kept the profile with the bad password: ask
              // again right away instead of retrying it on the next click.
              if (wrong) popup.asking = net.modelData
            }
          }
        }
      }

      // Password for a secured network joined for the first time.
      ColumnLayout {
        visible: popup.asking !== null
        Layout.fillWidth: true
        Layout.topMargin: 4
        spacing: 4

        Caption { text: popup.asking ? {{ tq "password_for" }}.arg(popup.asking.name).toUpperCase() : "" }

        Rectangle {
          Layout.fillWidth: true
          implicitHeight: 28
          color: Theme.bg
          border.width: 1
          border.color: password.activeFocus ? Theme.accent : Theme.border

          TextInput {
            id: password
            anchors.fill: parent
            anchors.margins: 6
            verticalAlignment: TextInput.AlignVCenter
            echoMode: TextInput.Password
            color: Theme.fg
            selectionColor: Theme.selection
            font.family: Theme.fontMono
            font.pointSize: 9.5
            clip: true
            onVisibleChanged: if (visible) { text = ""; forceActiveFocus() }
            Connections {
              target: popup
              function onAskingChanged() {
                if (popup.asking) { password.text = ""; password.forceActiveFocus() }
              }
            }
            onAccepted: {
              if (popup.asking && text !== "") popup.asking.connectWithPsk(text)
              popup.asking = null
            }
          }
        }
      }

      Caption {
        visible: popup.problem !== ""
        text: popup.problem
        color: Theme.danger
      }

      Caption {
        visible: Networking.wifiEnabled && root.wifiNetworks.some(n => n.known)
        Layout.topMargin: 2
        text: {{ tq "hint" }}
      }
    }
  }
}
