/* Generated by mazapan (plugin {{ plugin }}) from theme "{{ theme.id }}".
   The browser's frame: tabs, toolbar, address bar, menus, sidebar.
   Firefox's own variables, plus Zen's; one fork ignores the other's.
   Not in high contrast mode (forced colors): that one is the person's. */

@media not (forced-colors) {
  /* Declared where Firefox declares them too, or its own win by
     inheritance: the root, the toolbox and its bars, the sidebar, popups. */
  :root, :root:-moz-lwtheme, #navigator-toolbox, #nav-bar, #TabsToolbar,
  #PersonalToolbar, #urlbar, #sidebar-box, #sidebar-main, panel, menupopup {
    /* Tab strip and toolbar */
    --lwt-accent-color: {{ c "bg_alt" }} !important;
    --lwt-accent-color-inactive: {{ c "bg_alt" }} !important;
    --lwt-text-color: {{ c "fg" }} !important;
    --toolbar-bgcolor: {{ c "bg" }} !important;
    --toolbar-color: {{ c "fg" }} !important;
    --toolbarbutton-icon-fill: {{ c "fg" }} !important;
    --toolbarbutton-hover-background: {{ c "surface" }} !important;
    --toolbarbutton-active-background: {{ c "surface_raised" }} !important;
    --tab-selected-bgcolor: {{ c "surface_raised" }} !important;
    --tab-selected-textcolor: {{ c "fg" }} !important;
    --tab-hover-background-color: {{ c "surface" }} !important;
    --tab-loading-fill: {{ c "accent" }} !important;
    --tab-attention-icon-color: {{ c "accent" }} !important;
    --chrome-content-separator-color: {{ c "border" }} !important;

    /* Address bar and its results */
    --toolbar-field-background-color: {{ c "bg_alt" }} !important;
    --toolbar-field-focus-background-color: {{ c "bg_alt" }} !important;
    --toolbar-field-color: {{ c "fg" }} !important;
    --toolbar-field-focus-color: {{ c "fg" }} !important;
    --toolbar-field-border-color: {{ c "border" }} !important;
    --toolbar-field-focus-border-color: {{ c "accent" }} !important;
    --urlbarView-highlight-background: {{ c "accent" }} !important;
    --urlbarView-highlight-color: {{ c "accent_fg" }} !important;
    --urlbarView-hover-background: {{ c "surface" }} !important;
    --urlbar-box-bgcolor: {{ c "surface" }} !important;
    --urlbar-box-hover-bgcolor: {{ c "surface_raised" }} !important;

    /* Menus and panels */
    --arrowpanel-background: {{ c "surface_raised" }} !important;
    --arrowpanel-color: {{ c "fg" }} !important;
    --arrowpanel-border-color: {{ c "border" }} !important;
    --panel-separator-color: {{ c "border" }} !important;
    --panel-item-hover-bgcolor: {{ c "surface" }} !important;
    --sidebar-background-color: {{ c "bg_alt" }} !important;
    --sidebar-text-color: {{ c "fg" }} !important;
    --sidebar-border-color: {{ c "border" }} !important;

    /* Accent, focus, buttons (Firefox's design tokens). A primary button
       keeps its text readable when hovered: the accent throughout, which
       accent_fg is made to read on. Links are the accent as text. */
    --focus-outline-color: {{ c "accent" }} !important;
    --color-accent-primary: {{ c "accent" }} !important;
    --color-accent-primary-hover: {{ c "accent" }} !important;
    --color-accent-primary-active: {{ c "accent" }} !important;
    --button-primary-bgcolor: {{ c "accent" }} !important;
    --button-primary-color: {{ c "accent_fg" }} !important;
    --button-background-color-primary: {{ c "accent" }} !important;
    --button-text-color-primary: {{ c "accent_fg" }} !important;
    --link-color: {{ c "accent_text" }} !important;
    --link-color-hover: {{ c "accent_text" }} !important;
    --background-color-canvas: {{ c "bg" }} !important;
    --text-color: {{ c "fg" }} !important;
    --border-radius-small: {{ theme.shape.radius }}px !important;
    --border-radius-medium: {{ theme.shape.radius }}px !important;
    --tab-border-radius: {{ theme.shape.radius }}px !important;
    --toolbarbutton-border-radius: {{ theme.shape.radius }}px !important;

    /* Zen */
    --zen-primary-color: {{ c "accent" }} !important;
    --zen-colors-primary: {{ c "surface" }} !important;
    --zen-colors-secondary: {{ c "surface_raised" }} !important;
    --zen-colors-tertiary: {{ c "bg_alt" }} !important;
    --zen-colors-border: {{ c "border" }} !important;
    --zen-main-browser-background: {{ c "bg_alt" }} !important;
    --zen-themed-toolbar-bg: {{ c "bg_alt" }} !important;
    --zen-dialog-background: {{ c "surface_raised" }} !important;
  }

  /* And the surfaces themselves, for versions that paint them directly. */
  #navigator-toolbox, #TabsToolbar, #titlebar {
    background-color: {{ c "bg_alt" }} !important;
    color: {{ c "fg" }} !important;
  }
  #nav-bar, #PersonalToolbar {
    background-color: {{ c "bg" }} !important;
    color: {{ c "fg" }} !important;
  }
  .tab-background:is([selected], [multiselected]) {
    background: {{ c "surface_raised" }} !important;
  }
  /* The address bar: an id in some versions, a class in others. */
  #urlbar-background, .urlbar-background, #searchbar {
    background-color: {{ c "bg_alt" }} !important;
    border-color: {{ c "border" }} !important;
  }
  #urlbar:is([focused], [open]) :is(#urlbar-background, .urlbar-background) {
    outline: 2px solid {{ c "accent" }} !important;
    outline-offset: -1px !important;
    border-color: {{ c "accent" }} !important;
  }
  #urlbar-searchmode-switcher, #identity-box, #tracking-protection-icon-container {
    background-color: {{ c "surface" }} !important;
  }
  notification-message, .notificationbox-stack notification-message {
    --message-bar-background-color: {{ c "surface_raised" }} !important;
    --message-bar-text-color: {{ c "fg" }} !important;
    --message-bar-icon-color: {{ c "accent_text" }} !important;
    background-color: {{ c "surface_raised" }} !important;
    color: {{ c "fg" }} !important;
  }

  /* The selection in the address bar and fields: the theme's */
  ::selection {
    background-color: {{ c "selection" }} !important;
    color: {{ c "fg" }} !important;
  }
}
