/* Generated by myarch (plugin {{.Plugin}}) from theme "{{.Theme.ID}}".
   The browser's own pages (new tab, settings, add-ons…): not websites. */

@-moz-document url-prefix("about:"), url-prefix("chrome:") {
  @media not (forced-colors) {
  :root {
    --in-content-page-background: {{c "bg"}} !important;
    --in-content-page-color: {{c "fg"}} !important;
    --in-content-box-background: {{c "surface"}} !important;
    --in-content-box-border-color: {{c "border"}} !important;
    --in-content-item-hover: {{c "surface_raised"}} !important;
    --in-content-item-selected: {{c "accent"}} !important;
    --in-content-item-selected-text: {{c "accent_fg"}} !important;
    --in-content-primary-button-background: {{c "accent"}} !important;
    --in-content-primary-button-text-color: {{c "accent_fg"}} !important;
    --in-content-focus-outline-color: {{c "accent"}} !important;
    --in-content-link-color: {{c "accent_text"}} !important;

    --background-color-canvas: {{c "bg"}} !important;
    --background-color-box: {{c "surface"}} !important;
    --text-color: {{c "fg"}} !important;
    --text-color-deemphasized: {{c "fg_muted"}} !important;
    --border-color: {{c "border"}} !important;
    --border-color-card: {{c "border"}} !important;
    --link-color: {{c "accent_text"}} !important;
    --color-accent-primary: {{c "accent"}} !important;
    --color-accent-primary-hover: {{c "accent"}} !important;
    --color-accent-primary-active: {{c "accent"}} !important;
    --button-background-color-primary: {{c "accent"}} !important;
    --button-text-color-primary: {{c "accent_fg"}} !important;
    --focus-outline-color: {{c "accent"}} !important;

    /* New tab */
    --newtab-background-color: {{c "bg"}} !important;
    --newtab-background-color-secondary: {{c "surface"}} !important;
    --newtab-text-primary-color: {{c "fg"}} !important;
    --newtab-primary-action-background: {{c "accent"}} !important;
  }
  }
}
