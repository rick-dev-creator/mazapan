// Generated by mazapan (plugin {{ plugin }}): what the status pill and the
// Control Center share. The pill says where it is (so the panel grows out
// of it); the panel says what the pill should show (the most urgent thing
// that needs you, else the glyphs its sections offer).

pragma Singleton
import QtQuick
import Quickshell

Singleton {
  id: root

  property bool open: false
  property var screen: null      // the screen whose pill opened it
  property real pillWidth: 140
  property real pillHeight: 28
  property real pillTop: 4       // from the top of the screen
  property real pillRight: 8     // from the right of the screen

  // What a switch shows below the switches (its networks, its devices): a
  // Component of that switch's, or null. One at a time; the switch itself
  // never moves, so its arrow stays under the pointer.
  property var detail: null
  onOpenChanged: if (!open) detail = null

  // The most urgent "now" ({ text, level }), or null; and the quiet glyphs.
  property var live: null
  property var glyphs: []

  // Asked of the pills right before it opens: the one on `screen` says
  // where it is (measured then, not at start: the bar lays out its widgets
  // after the pill is made).
  signal measure()

  function toggle() {
    if (!open) measure()
    open = !open
  }
  function close() { open = false }
}
