// Generated by mazapan (plugin {{ plugin }}): the Control Center's music.
//
// What's playing (any app that says so over MPRIS: Spotify, a browser,
// mpv…): its cover, title and artist, how far along, and play, pause,
// back and next. Nothing playing anywhere: left out.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Services.Mpris
import qs
import "../../components/kit"

Group {
  id: root

  readonly property var players: Mpris.players.values
  readonly property var player: players.find(p => p.isPlaying) ?? players[0] ?? null
  property bool shown: player !== null

  // The position only moves when asked.
  Timer {
    interval: 1000
    running: root.player !== null && root.player.isPlaying && root.visible
    repeat: true
    onTriggered: root.player.positionChanged()
  }

  RowLayout {
    Layout.fillWidth: true
    spacing: 12

    Rectangle {
      implicitWidth: 46
      implicitHeight: 46
      radius: Theme.radius
      color: Theme.bgAlt
      clip: true
      Image {
        anchors.fill: parent
        source: root.player ? root.player.trackArtUrl : ""
        fillMode: Image.PreserveAspectCrop
        asynchronous: true
        visible: status === Image.Ready
      }
      Glyph {
        anchors.centerIn: parent
        visible: !root.player || root.player.trackArtUrl === ""
        text: "󰝚"
      }
    }

    ColumnLayout {
      Layout.fillWidth: true
      spacing: 3
      Label {
        text: root.player ? (root.player.trackTitle || root.player.identity) : ""
        font.bold: true
        elide: Text.ElideRight
        Layout.fillWidth: true
      }
      Caption {
        text: root.player ? [root.player.trackArtist, root.player.identity].filter(s => s).join(" · ") : ""
        font.letterSpacing: 0
        elide: Text.ElideRight
        Layout.fillWidth: true
      }
      Rectangle {
        visible: root.player !== null && root.player.lengthSupported && root.player.length > 0
        Layout.fillWidth: true
        implicitHeight: 3
        radius: 2
        color: Theme.border
        Rectangle {
          width: root.player && root.player.length > 0 ? parent.width * Math.min(1, root.player.position / root.player.length) : 0
          height: parent.height
          radius: 2
          color: Theme.fg
        }
      }
    }

    Glyph {
      text: "󰒮"
      opacity: root.player && root.player.canGoPrevious ? 1 : 0.4
      MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: if (root.player && root.player.canGoPrevious) root.player.previous() }
    }
    Rectangle {
      implicitWidth: 32
      implicitHeight: 32
      radius: Math.max(Theme.radius, 16)
      color: Theme.fg
      Text {
        anchors.centerIn: parent
        text: root.player && root.player.isPlaying ? "󰏤" : "󰐊"
        color: Theme.bg
        font.family: Theme.fontMono
        font.pointSize: 12
      }
      MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: if (root.player && root.player.canTogglePlaying) root.player.togglePlaying() }
    }
    Glyph {
      text: "󰒭"
      opacity: root.player && root.player.canGoNext ? 1 : 0.4
      MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: if (root.player && root.player.canGoNext) root.player.next() }
    }
  }
}
