// Generated by mazapan (plugin {{ plugin }}).
//
// The status pill, at the bar's right end: the glyphs the Control Center's
// sections offer (the network, the volume, the battery, how many
// notifications) while nothing needs you; what does, in words and in its
// color, when something does ("Claude · shop-api waits", "Recording 0:42").
// A click opens the Control Center out of it.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/control"

BarItem {
  id: root

  readonly property var live: ControlService.live
  readonly property color tone: !live ? Theme.fg
    : live.level >= 2 ? Theme.danger
    : live.level === 1 ? Theme.warning
    : Theme.accentText

  open: ControlService.open
  padding: 10
  onClicked: {
    place()
    if (!ControlService.open) ControlService.screen = root.barScreen
    ControlService.toggle()
  }

  // Where it is, for the panel to grow out of it.
  function place() {
    const p = root.mapToItem(null, 0, 0)
    const w = root.barScreen ? root.barScreen.width : 0
    ControlService.pillWidth = root.width
    ControlService.pillHeight = root.height
    ControlService.pillTop = p.y
    ControlService.pillRight = Math.max(0, w - (p.x + root.width))
  }
  onWidthChanged: if (ControlService.open) place()
  Component.onCompleted: Qt.callLater(place)

  // Something needs you: a dot that breathes, and what it is.
  Rectangle {
    visible: root.live !== null
    anchors.verticalCenter: parent.verticalCenter
    width: 7
    height: 7
    radius: 4
    color: root.tone
    SequentialAnimation on opacity {
      running: root.live !== null && Theme.motion
      loops: Animation.Infinite
      NumberAnimation { from: 1; to: 0.35; duration: 900; easing.type: Easing.InOutSine }
      NumberAnimation { from: 0.35; to: 1; duration: 900; easing.type: Easing.InOutSine }
    }
  }
  Label {
    visible: root.live !== null
    anchors.verticalCenter: parent.verticalCenter
    text: root.live ? root.live.text : ""
    color: root.tone
    font.bold: true
  }

  // Nothing does: the glyphs, as the sections give them.
  Repeater {
    model: root.live === null ? ControlService.glyphs : []
    Label {
      required property var modelData
      anchors.verticalCenter: parent.verticalCenter
      text: modelData
      color: Theme.fgMuted
    }
  }
  Glyph {
    visible: root.live === null && ControlService.glyphs.length === 0
    anchors.verticalCenter: parent.verticalCenter
    text: "󰒓"
  }
}
