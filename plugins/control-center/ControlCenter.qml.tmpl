// Generated by mazapan (plugin {{ plugin }}).
//
// The Control Center: one panel for what used to be a row of icons on the
// bar's right, grown out of the status pill. Every plugin puts its own part
// in it, as it puts widgets in the bar:
//
//   control/now/NN-<name>.qml       a card that needs you now (an agent
//                                   waiting, a recording, an update)
//   control/tiles/NN-<name>.qml     a big switch (Wi-Fi, Bluetooth…), two a row;
//                                   what it opens (its networks) goes below
//                                   them: ControlService.detail = a Component
//   control/sections/NN-<name>.qml  a section as wide as the panel (sound,
//                                   music, agents, notifications…)
//
// Contract: a root Item. Optional: `property bool shown` (false: left out),
// `property string pillGlyph` (shown in the pill while nothing needs you);
// a now card has `property bool live`, `property string pill` (what the pill
// says while it's live) and `property int level` (0 news, 1 needs you,
// 2 urgent).
// A bar widget of the same <name> leaves the bar while this is on.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import Quickshell.Services.UPower
import qs
import "../components/kit"
import "../components/control"

Item {
  id: root

  readonly property bool open: ControlService.open
  readonly property var focusedScreen: Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
  // Panel contract (see shell.qml).
  function toggle() {
    if (!ControlService.open) ControlService.screen = focusedScreen
    ControlService.toggle()
  }
  function close() { ControlService.close() }
  onOpenChanged: if (open) Qt.callLater(() => card.forceActiveFocus())

  // A fresh URL each (re)load, or the engine keeps the old component.
  readonly property string generation: String(Date.now())
  // Two parts of one name (NN-<name>.qml): the later one takes the other's
  // place (a plugin's own music over the Control Center's).
  function lastOfEachName(files) {
    const name = f => f.split("/").pop().replace(/^[0-9]+-/, "").replace(/\.qml$/, "")
    return files.filter((f, i) => !files.slice(i + 1).some(g => name(g) === name(f)))
  }
  readonly property var nowFiles: lastOfEachName([
{{- for file in under "~/.config/quickshell/mazapan/control/now/" }}
    {{ quote file }},
{{- end }}
  ])
  readonly property var tileFiles: lastOfEachName([
{{- for file in under "~/.config/quickshell/mazapan/control/tiles/" }}
    {{ quote file }},
{{- end }}
  ])
  readonly property var sectionFiles: lastOfEachName([
{{- for file in under "~/.config/quickshell/mazapan/control/sections/" }}
    {{ quote file }},
{{- end }}
  ])

  // What the pill shows, gathered from what's loaded (the sections live
  // while the panel is closed: they feed the pill).
  function gather() {
    const glyphs = []
    let live = null
    const take = (rep, isNow) => {
      for (let i = 0; i < rep.count; i++) {
        const l = rep.itemAt(i)
        const it = l ? l.item : null
        if (!it || it.shown === false) continue
        if (isNow && it.live && (live === null || (it.level || 0) > live.level))
          live = { text: it.pill || "", level: it.level || 0 }
        if (it.pillGlyph) glyphs.push(it.pillGlyph)
      }
    }
    take(nowRep, true)
    take(tileRep, false)
    take(sectionRep, false)
    if (JSON.stringify(glyphs) !== JSON.stringify(ControlService.glyphs)) ControlService.glyphs = glyphs
    if (JSON.stringify(live) !== JSON.stringify(ControlService.live)) ControlService.live = live
  }
  Timer { interval: 500; running: true; repeat: true; triggeredOnStart: true; onTriggered: root.gather() }

  readonly property bool anyLive: ControlService.live !== null

  // Who's here.
  property string person: Quickshell.env("USER") || ""
  Process {
    running: true
    command: ["sh", "-c", 'n=$(getent passwd "$(id -un)" | cut -d: -f5 | cut -d, -f1); printf %s "${n:-$(id -un)}"']
    stdout: StdioCollector { onStreamFinished: if (text.trim() !== "") root.person = text.trim() }
  }
  readonly property var battery: UPower.displayDevice
  readonly property bool hasBattery: !!battery && battery.isLaptopBattery && battery.isPresent
  function span(s) {
    const m = Math.round(s / 60)
    return m < 60 ? {{ tq "min" }}.arg(m) : {{ tq "hours" }}.arg(Math.floor(m / 60)).arg(m % 60)
  }
  readonly property string batteryText: !hasBattery ? ""
    : battery.state === UPowerDeviceState.Charging ? {{ tq "charging" }}.arg(Math.round(battery.percentage * 100))
    : UPower.onBattery && battery.timeToEmpty > 0 ? {{ tq "battery" }}.arg(Math.round(battery.percentage * 100)).arg(span(battery.timeToEmpty))
    : {{ tq "battery_plain" }}.arg(Math.round(battery.percentage * 100))

  function ipc(panel) {
    ControlService.close()
    Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", panel])
  }

  PanelWindow {
    id: win
    screen: ControlService.screen ?? root.focusedScreen
    visible: root.open || card.width > ControlService.pillWidth + 1
    // The whole screen, clear but for the card: a click anywhere else lands
    // here and closes it. (A layer that holds the keyboard gets the clicks
    // of the whole screen, so it has to be the one to catch them.)
    anchors.top: true
    anchors.bottom: true
    anchors.left: true
    anchors.right: true
    exclusionMode: ExclusionMode.Ignore
    color: "transparent"
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-control-center"
    WlrLayershell.keyboardFocus: root.open ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None


    MouseArea {
      anchors.fill: parent
      enabled: root.open
      acceptedButtons: Qt.AllButtons
      onPressed: root.close()
    }

    Rectangle {
      id: card
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.topMargin: ControlService.pillTop
      anchors.rightMargin: ControlService.pillRight
      // Out of the pill: its size when closed, the panel's when open.
      width: root.open ? root.fullWidth : ControlService.pillWidth
      height: root.open ? root.fullHeight : ControlService.pillHeight
      radius: Theme.radius
      color: Theme.surfaceRaised
      border.width: 1
      border.color: Theme.border
      clip: true
      focus: true
      Keys.onEscapePressed: root.close()
      Behavior on width {
        NumberAnimation { duration: Theme.morph; easing.type: root.open ? Easing.OutBack : Easing.InOutCubic; easing.overshoot: 0.6 }
      }
      Behavior on height {
        NumberAnimation { duration: Theme.morph + 60; easing.type: root.open ? Easing.OutBack : Easing.InOutCubic; easing.overshoot: 0.5 }
      }

      // A click on the card itself (between its parts) isn't one outside it.
      MouseArea {
        anchors.fill: parent
        acceptedButtons: Qt.AllButtons
      }

      // 0 as the pill, 1 as the panel: the content comes in late, goes early.
      readonly property real grown: Math.max(0, Math.min(1, (width - ControlService.pillWidth) / Math.max(1, root.fullWidth - ControlService.pillWidth)))

      Flickable {
        id: flick
        anchors.fill: parent
        anchors.margins: 14
        contentHeight: col.implicitHeight
        boundsBehavior: Flickable.StopAtBounds
        clip: true
        opacity: Math.max(0, card.grown * 1.6 - 0.6)
        transform: Translate { y: (1 - card.grown) * -10 }

        ColumnLayout {
          id: col
          width: flick.width
          spacing: 12

          // --- who, the battery, settings --------------------------------
          RowLayout {
            Layout.fillWidth: true
            spacing: 10
            Rectangle {
              implicitWidth: 34
              implicitHeight: 34
              radius: Math.max(Theme.radius, 17)
              color: Theme.accent
              Text {
                anchors.centerIn: parent
                text: (root.person[0] || "?").toUpperCase()
                color: Theme.accentFg
                font.family: Theme.fontMono
                font.pointSize: 11
                font.bold: true
              }
            }
            ColumnLayout {
              spacing: 1
              Layout.fillWidth: true
              Label { text: root.person; font.bold: true; elide: Text.ElideRight; Layout.fillWidth: true }
              Caption { visible: root.batteryText !== ""; text: root.batteryText; font.letterSpacing: 0 }
            }
{{- has_settings = false }}
{{- for file in under "~/.config/quickshell/mazapan/panels/" }}{{ if file | string.ends_with "/settings.qml" }}{{ has_settings = true }}{{ end }}{{ end }}
{{- if has_settings }}
            Button {
              text: "󰒓"
              onClicked: root.ipc("settings")
            }
{{- end }}
          }

          // --- now: only what needs you ------------------------------------
          Caption {
            visible: root.anyLive
            text: {{ tq "now" }}
          }
          Repeater {
            id: nowRep
            model: root.nowFiles
            Loader {
              required property string modelData
              Layout.fillWidth: true
              visible: status === Loader.Ready && item.shown !== false && item.live === true
              Layout.preferredHeight: visible ? item.implicitHeight : 0
              source: "file://" + modelData + "?generation=" + root.generation
              onStatusChanged: if (status === Loader.Error) console.warn("mazapan: control center: failed to load", modelData)
            }
          }
          Text {
            visible: !root.anyLive && root.nowFiles.length > 0
            text: {{ tq "quiet" }}
            color: Theme.success
            font.family: Theme.fontMono
            font.pointSize: 8.5
          }

          // --- the switches, two a row ---------------------------------------
          GridLayout {
            Layout.fillWidth: true
            columns: 2
            columnSpacing: 8
            rowSpacing: 8
            Repeater {
              id: tileRep
              model: root.tileFiles
              Loader {
                required property string modelData
                Layout.fillWidth: true
                Layout.preferredWidth: 1
                visible: status === Loader.Ready && item.shown !== false
                Layout.preferredHeight: visible ? item.implicitHeight : 0
                source: "file://" + modelData + "?generation=" + root.generation
                onStatusChanged: if (status === Loader.Error) console.warn("mazapan: control center: failed to load", modelData)
              }
            }
          }

          // What a switch opened (its networks, its devices).
          Loader {
            Layout.fillWidth: true
            active: ControlService.detail !== null
            visible: active
            sourceComponent: ControlService.detail
          }

          // --- the sections ---------------------------------------------------
          Repeater {
            id: sectionRep
            model: root.sectionFiles
            Loader {
              required property string modelData
              Layout.fillWidth: true
              visible: status === Loader.Ready && item.shown !== false
              Layout.preferredHeight: visible ? item.implicitHeight : 0
              source: "file://" + modelData + "?generation=" + root.generation
              onStatusChanged: if (status === Loader.Error) console.warn("mazapan: control center: failed to load", modelData)
            }
          }

          Caption {
            Layout.alignment: Qt.AlignRight
            text: {{ quote settings.key }}
            font.letterSpacing: 0
          }
        }
      }
    }
  }

  readonly property int fullWidth: 420
  readonly property int fullHeight: {
    const s = win.screen
    const room = s ? s.height - ControlService.pillTop - Theme.gapOut : 900
    return Math.min(col.implicitHeight + 28, room)
  }
}
