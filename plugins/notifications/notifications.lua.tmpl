-- Generated by myarch (plugin {{ plugin }}): the notification center, Do
-- Not Disturb, and putting the banners away.
hl.bind({{ lq settings.key }}, hl.dsp.exec_cmd("qs ipc -c myarch call myarch panel notifications"))
hl.bind({{ lq settings.quiet_key }}, hl.dsp.exec_cmd("qs ipc -c myarch call notifications toggleQuiet"))
hl.bind({{ lq settings.dismiss_key }}, hl.dsp.exec_cmd("qs ipc -c myarch call notifications dismiss"))
