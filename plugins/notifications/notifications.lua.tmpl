-- Generated by mazapan (plugin {{ plugin }}): the notification center, Do
-- Not Disturb, and putting the banners away.
hl.bind({{ lq settings.key }}, hl.dsp.exec_cmd("qs ipc -c mazapan call mazapan panel notifications"))
hl.bind({{ lq settings.quiet_key }}, hl.dsp.exec_cmd("qs ipc -c mazapan call notifications toggleQuiet"))
