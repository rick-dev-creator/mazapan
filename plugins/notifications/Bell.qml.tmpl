// Generated by myarch (plugin {{ plugin }}).
//
// In the bar only when there's something to say: how many are unread, or
// that Do Not Disturb is on. A click opens the center; a right click turns
// Do Not Disturb on or off.

import QtQuick
import Quickshell
import qs
import "../../components/kit"
import "../../components/notifications"

BarItem {
  id: root

  shown: NotificationService.unread > 0 || NotificationService.quiet
  acceptedButtons: Qt.LeftButton | Qt.RightButton
  onClicked: mouse => {
    if (mouse.button === Qt.RightButton) NotificationService.setQuiet(!NotificationService.manualQuiet)
    else Quickshell.execDetached(["qs", "ipc", "-c", "myarch", "call", "myarch", "panel", "notifications"])
  }

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: String.fromCodePoint(NotificationService.quiet ? 0xF009B : 0xF009A)
    color: NotificationService.unread > 0 ? Theme.accentText : Theme.fgMuted
  }

  Label {
    anchors.verticalCenter: parent.verticalCenter
    visible: NotificationService.unread > 0
    text: NotificationService.unread > 99 ? "99+" : String(NotificationService.unread)
    color: Theme.accentText
  }
}
