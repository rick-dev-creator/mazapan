// Generated by mazapan (plugin {{ plugin }}).
//
// One notification: its icon, app and time, title and text, its progress,
// its actions. The same card in a banner and in the center; in a banner the
// actions show on hover and a thin line counts its time down.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../kit"

Rectangle {
  id: card

  // What it shows (a snapshot from NotificationService), and the live
  // notification when its app is still there (actions, reply, updates).
  property var item: ({})
  property var n: null
  property bool banner: false
  // 1 → 0 as a banner's time runs out; -1 when it doesn't run out.
  property real remaining: -1
  readonly property bool hovered: area.containsMouse || closeArea.containsMouse || actionsHovered
  property bool actionsHovered: false
  // Replying (the center keeps which one, and what's typed so far: cards
  // come and go as notifications do).
  property bool replying: false
  property string draft: ""

  signal activated()
  signal closed()
  signal action(var action)
  signal replied(string text)
  signal wantsReply()
  signal draftEdited(string text)
  signal replyEnded()

  readonly property string summary: n ? NotificationService.plain(n.summary) : item.summary || ""
  readonly property string body: n ? NotificationService.plain(n.body) : item.body || ""
  readonly property string icon: (n ? NotificationService.picture(n.image, true) : "") || item.icon || ""
  readonly property bool critical: item.urgency === 2
  // The progress an app reports (0–100), as volume and downloads do.
  readonly property real progress: n && n.hints && n.hints.value !== undefined ? Number(n.hints.value) : -1
  readonly property var buttons: n ? n.actions.filter(a => a.identifier !== "default" && a.text !== "") : []

  implicitWidth: 360
  implicitHeight: content.implicitHeight + 24
  radius: Theme.radius
  color: banner ? Theme.surfaceRaised : area.containsMouse ? Theme.surfaceRaised : Theme.surface
  border.width: 1
  border.color: critical ? Theme.danger : Theme.border
  clip: true

  MouseArea {
    id: area
    anchors.fill: parent
    hoverEnabled: true
    acceptedButtons: Qt.LeftButton | Qt.RightButton
    cursorShape: Qt.PointingHandCursor
    onClicked: mouse => mouse.button === Qt.RightButton ? card.closed() : card.activated()
  }

  ColumnLayout {
    id: content
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.margins: 12
    spacing: 6

    RowLayout {
      Layout.fillWidth: true
      spacing: 10

      // The app's icon or the notification's image; a bell when neither.
      Item {
        Layout.preferredWidth: 32
        Layout.preferredHeight: 32
        Layout.alignment: Qt.AlignTop
        Image {
          id: pic
          anchors.fill: parent
          source: card.icon
          sourceSize: Qt.size(64, 64)
          fillMode: Image.PreserveAspectFit
          asynchronous: true
          visible: status === Image.Ready
        }
        Glyph {
          anchors.centerIn: parent
          visible: pic.status !== Image.Ready
          text: String.fromCodePoint(0xF009A)
          color: card.critical ? Theme.danger : Theme.accentText
          font.pointSize: 16
        }
      }

      ColumnLayout {
        Layout.fillWidth: true
        spacing: 2

        RowLayout {
          Layout.fillWidth: true
          spacing: 6
          // In the center the app heads its stack: only the time here.
          Caption {
            visible: card.banner
            text: card.item.app || ""
            elide: Text.ElideRight
            Layout.maximumWidth: 180
          }
          Caption {
            text: card.item.time ? (card.banner ? "· " : "") + NotificationService.ago(card.item.time) : ""
          }
          Item { Layout.fillWidth: true }
          // Unread, in the center.
          Rectangle {
            visible: !card.banner && card.item.unread === true
            width: 6
            height: 6
            radius: 3
            color: Theme.accent
          }
          Rectangle {
            visible: card.hovered
            implicitWidth: 18
            implicitHeight: 18
            radius: Theme.radius
            color: closeArea.containsMouse ? Theme.surface : "transparent"
            Glyph {
              anchors.centerIn: parent
              text: String.fromCodePoint(0xF0156)
              color: Theme.fgMuted
              font.pointSize: 9
            }
            MouseArea {
              id: closeArea
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onClicked: card.closed()
            }
          }
        }

        Label {
          visible: text !== ""
          text: card.summary
          font.bold: true
          wrapMode: Text.Wrap
          maximumLineCount: 2
          elide: Text.ElideRight
          Layout.fillWidth: true
        }

        Label {
          visible: text !== ""
          text: card.body
          color: Theme.fgMuted
          wrapMode: Text.Wrap
          maximumLineCount: card.banner ? 3 : 6
          elide: Text.ElideRight
          Layout.fillWidth: true
        }
      }
    }

    // Progress.
    Rectangle {
      visible: card.progress >= 0
      Layout.fillWidth: true
      Layout.leftMargin: 42
      implicitHeight: 4
      radius: 2
      color: Theme.surface
      Rectangle {
        width: parent.width * Math.max(0, Math.min(100, card.progress)) / 100
        height: parent.height
        radius: 2
        color: Theme.accent
      }
    }

    // Its actions: in a banner once the pointer is on it.
    Flow {
      visible: (card.buttons.length > 0 || (card.n && card.n.hasInlineReply)) && (!card.banner || card.hovered) && !card.replying
      Layout.fillWidth: true
      Layout.leftMargin: 42
      spacing: 6
      HoverHandler { onHoveredChanged: card.actionsHovered = hovered }
      Repeater {
        model: card.buttons
        Button {
          required property var modelData
          text: modelData.text
          onClicked: card.action(modelData)
        }
      }
      Button {
        visible: !!card.n && card.n.hasInlineReply
        text: {{ tq "reply" }}
        primary: true
        onClicked: card.wantsReply()
      }
    }

    // An inline reply (in the center, where it can be typed).
    RowLayout {
      visible: card.replying
      Layout.fillWidth: true
      Layout.leftMargin: 42
      spacing: 6
      TextField {
        id: replyField
        Layout.fillWidth: true
        text: card.draft
        placeholder: card.n && card.n.inlineReplyPlaceholder ? card.n.inlineReplyPlaceholder : {{ tq "reply.placeholder" }}
        onTextChanged: if (text !== card.draft) card.draftEdited(text)
        onAccepted: card.replied(text)
        Keys.onEscapePressed: card.replyEnded()
      }
      Button {
        text: {{ tq "send" }}
        primary: true
        onClicked: card.replied(replyField.text)
      }
    }
  }

  onReplyingChanged: if (replying) Qt.callLater(() => replyField.focusInput())
  Component.onCompleted: if (replying) Qt.callLater(() => replyField.focusInput())

  // A banner's time, running out.
  Rectangle {
    visible: card.banner && card.remaining >= 0
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    anchors.leftMargin: 1
    anchors.bottomMargin: 1
    height: 2
    width: (parent.width - 2) * Math.max(0, card.remaining)
    color: card.critical ? Theme.danger : Theme.accent
    opacity: 0.7
  }
}
