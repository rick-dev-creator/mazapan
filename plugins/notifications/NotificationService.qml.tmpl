// Generated by myarch (plugin {{ plugin }}).
//
// The desktop's notification server (org.freedesktop.Notifications): every
// app's notifications arrive here, show as banners, and stay in the center
// until cleared. It honors what apps ask for (how long, how urgent,
// actions, inline replies, progress, replacing one) and what the person
// asks for: Do Not Disturb (by hand, on a schedule, in full screen), and
// per app, banners or not. Apps are known by the name they give.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland
import Quickshell.Services.Notifications

Singleton {
  id: root

  readonly property var locale: Qt.locale("{{ lang }}")
  readonly property string dir: Quickshell.env("HOME") + "/.local/state/myarch-notifications"
  readonly property string sound: {{ quote settings.sound }}
  readonly property int bannerSeconds: {{ settings.banner_seconds }}
  readonly property int keep: {{ settings.keep }}
  readonly property bool quietFullscreen: {{ settings.quiet_fullscreen }}
  readonly property bool quietCritical: {{ settings.quiet_critical }}
  readonly property string quietFrom: {{ quote settings.quiet_from }}
  readonly property string quietTo: {{ quote settings.quiet_to }}
  // A banner queue longer than this drops its oldest: a burst of hundreds
  // mustn't replay for minutes.
  readonly property int maxBanners: 12
  // What's kept of a long body (the center shows six lines of it).
  readonly property int maxBody: 2000

  // The center's notifications, newest first: plain objects (what's shown,
  // and saved): {key, id, app, icon, summary, body, urgency, time, entry,
  // unread}. A live one (its app still there) also has its Notification in
  // live[key]: its actions, its reply, its updates.
  property var items: []
  property var live: ({})
  // The banners, newest first: {key, at}; shown[key] is what each shows.
  readonly property ListModel banners: ListModel {}
  property var shown: ({})
  readonly property int unread: items.filter(i => i.unread).length

  // Do Not Disturb: by hand, on a schedule, or while something is full
  // screen. What arrives meanwhile goes to the center only; missed says how
  // much, told once it's over (and has stayed over for a moment: leaving
  // a full screen video for a second isn't the end of it).
  property bool manualQuiet: false
  property bool scheduled: false
  readonly property bool fullscreen: !!Hyprland.focusedMonitor && !!Hyprland.focusedMonitor.activeWorkspace
    && Hyprland.focusedMonitor.activeWorkspace.hasFullscreen
  readonly property bool quiet: manualQuiet || scheduled || (quietFullscreen && fullscreen)
  readonly property string quietWhy: manualQuiet ? "manual" : scheduled ? "schedule" : quiet ? "fullscreen" : ""
  property int missed: 0

  // Banners held back altogether: a screenshot or a recording is being
  // made (capture says so), and they'd be in it.
  property bool held: false

  // Per app: {banners: false} keeps it in the center only; {quiet: true}
  // lets it through Do Not Disturb.
  property var apps: ({})

  // Now, every half minute: what "5 min ago" is measured from.
  property double clock: Date.now()

  // --- arriving -----------------------------------------------------------------

  NotificationServer {
    id: server
    keepOnReload: true
    persistenceSupported: true
    bodySupported: true
    bodyMarkupSupported: true // taken as plain text: tags out
    bodyHyperlinksSupported: false
    bodyImagesSupported: false
    actionsSupported: true
    actionIconsSupported: false
    imageSupported: true
    inlineReplySupported: true
    onNotification: n => root.arrive(n)
  }

  property int serial: 0
  function newKey(n) { return n.id + "-" + Date.now() + "-" + (serial++) }

  // live changes as a whole (a new object): what reads it follows.
  function setLive(key, n) {
    const next = Object.assign({}, live)
    if (n) next[key] = n
    else delete next[key]
    live = next
  }

  function appOf(n) {
    return n.appName || n.desktopEntry || {{ tq "unknown_app" }}
  }

  // Markup to text: tags out, entities in. Links and images aren't shown,
  // so nothing a notification says is fetched or opened by looking at it.
  function plain(s) {
    return String(s || "")
      .replace(/<br\s*\/?>/gi, "\n")
      .replace(/<[^>]*>/g, "")
      .replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, "\"").replace(/&apos;/g, "'").replace(/&#39;/g, "'")
      .replace(/&amp;/g, "&")
      .trim()
  }

  // What an image or icon a notification names may be: a file, raw image
  // data (image://, while it lives), or an icon name from the icon theme.
  // Never a URL: nothing is fetched.
  function picture(s, allowData) {
    s = String(s || "")
    if (s === "") return ""
    if (s.startsWith("/") || s.startsWith("file:")) return s
    // An icon theme's, by name: only if the theme has it (never Qt's
    // "missing" checkerboard).
    if (s.startsWith("image://icon/")) {
      try {
        return Quickshell.iconPath(decodeURIComponent(s.slice(13).split("?")[0]), true)
      } catch (e) {
        return ""
      }
    }
    if (s.startsWith("image://")) return allowData ? s : ""
    if (/^[a-z][a-z0-9+.-]*:/i.test(s)) return "" // http:, ftp:, …
    return Quickshell.iconPath(s, true)
  }

  // The icon kept for the center: the notification's image when it's a
  // file, else the app's icon, else its desktop entry's.
  function iconOf(n) {
    const img = picture(n.image, false)
    if (img !== "") return img
    const icon = picture(n.appIcon, false)
    if (icon !== "") return icon
    const e = n.desktopEntry ? DesktopEntries.byId(n.desktopEntry) : null
    return e && e.icon ? Quickshell.iconPath(e.icon, true) : ""
  }

  function snapshot(n, key, old) {
    return {
      key: key,
      id: n.id,
      app: appOf(n),
      icon: iconOf(n),
      summary: plain(n.summary).slice(0, 500),
      body: plain(n.body).slice(0, maxBody),
      urgency: n.urgency === NotificationUrgency.Critical ? 2 : n.urgency === NotificationUrgency.Low ? 0 : 1,
      time: old ? old.time : Date.now(),
      entry: n.desktopEntry || "",
      unread: old ? old.unread : true,
      transient: n.transient,
    }
  }

  // The center, kept to its size: what falls off is closed for its app
  // too (it'd be tracked forever otherwise, and come back after a reload).
  function keepItems(next) {
    for (const i of next.slice(keep))
      if (live[i.key]) live[i.key].dismiss()
    items = next.slice(0, keep)
    save()
  }

  // Until state.json is read (Do Not Disturb, the per-app rules), what
  // arrives waits: after a restart it must still be quiet.
  property bool stateRead: false
  property var waiting: []

  function arrive(n) {
    n.tracked = true
    if (n.lastGeneration) {
      if (historyRead) reattach(n)
      else carried.push(n)
      return
    }
    if (!stateRead) {
      waiting.push(n)
      return
    }
    const key = newKey(n)
    setLive(key, n)
    watcher.createObject(root, { target: n, key: key })
    const item = snapshot(n, key, null)
    if (!item.transient) keepItems([item].concat(items))
    decide(key, item, n, true)
  }

  // A banner or not: Do Not Disturb, the app's rules, capture.
  function decide(key, item, n, fresh) {
    const rules = apps[item.app] || {}
    const critical = item.urgency === 2
    const through = !quiet || (critical && quietCritical) || rules.quiet === true
    if ((rules.banners === false && !critical) || !through) {
      if (!through && !item.transient && fresh) missed++
      if (item.transient) n.expire() // nowhere to be: over
      return
    }
    show(key, item, n)
    if (fresh) ring(n, item)
  }

  // Carried over from before the shell reloaded: not new. It goes back to
  // its place in the center (once the center is read from disk); one still
  // unread and recent, or urgent, is a banner again.
  property var carried: []
  property bool historyRead: false

  function reattach(n) {
    const app = appOf(n), summary = plain(n.summary).slice(0, 500)
    // Ids start again with each process: the same id from an older session
    // isn't this one. Same id, app and title is.
    const i = items.find(x => x.id === n.id && x.app === app && x.summary === summary && !live[x.key])
    let key, item
    if (i) {
      key = i.key
      item = i
    } else if (!n.transient) {
      key = newKey(n)
      item = snapshot(n, key, null)
      keepItems([item].concat(items))
    } else {
      n.expire()
      return
    }
    setLive(key, n)
    watcher.createObject(root, { target: n, key: key })
    if (item.unread && (item.urgency === 2 || Date.now() - item.time < 60000)) decide(key, item, n, false)
  }

  // An update from its app (replaces_id). New words: news again, on top,
  // unread, a banner again if it's allowed one. Only its progress or its
  // actions: the same place, a banner still showing lasts longer.
  function touch(key, news) {
    const n = live[key]
    if (!n) return
    const i = items.findIndex(x => x.key === key)
    let item = i >= 0 ? items[i] : shown[key]
    if (!item) return
    item = snapshot(n, key, item)
    if (news) item = Object.assign(item, { time: Date.now(), unread: true })
    if (i >= 0) {
      const rest = items.filter(x => x.key !== key)
      keepItems(news ? [item].concat(rest) : items.map(x => x.key === key ? item : x))
    }
    let showing = false
    for (let b = 0; b < banners.count; b++)
      if (banners.get(b).key === key) {
        showing = true
        setShown(key, Object.assign({}, item, { lasts: lasting(n, item) }))
        banners.setProperty(b, "at", Date.now())
      }
    if (!showing && news) decide(key, item, n, true)
  }

  // Closed: by its app (gone from everywhere), or by us.
  function gone(key, reason) {
    setLive(key, null)
    if (reason === NotificationCloseReason.CloseRequested) {
      retire(key)
      if (items.some(x => x.key === key)) {
        items = items.filter(x => x.key !== key)
        save()
      }
    }
  }

  Component {
    id: watcher
    Connections {
      property string key
      function onSummaryChanged() { root.touch(key, true) }
      function onBodyChanged() { root.touch(key, true) }
      function onImageChanged() { root.touch(key, false) }
      function onUrgencyChanged() { root.touch(key, false) }
      function onHintsChanged() { root.touch(key, false) }
      function onActionsChanged() { root.touch(key, false) }
      function onExpireTimeoutChanged() { root.touch(key, false) }
      function onClosed(reason) {
        root.gone(key, reason)
        destroy()
      }
    }
  }

  // --- banners ------------------------------------------------------------------

  // shown changes as a whole too.
  function setShown(key, item) {
    const next = Object.assign({}, shown)
    if (item) next[key] = item
    else delete next[key]
    shown = next
  }

  function show(key, item, n) {
    if (held) return
    for (let b = 0; b < banners.count; b++)
      if (banners.get(b).key === key) return
    setShown(key, Object.assign({}, item, { lasts: lasting(n, item) }))
    banners.insert(0, { key: key, at: Date.now() })
    while (banners.count > maxBanners) retire(banners.get(banners.count - 1).key)
  }

  // How long a banner stays, decided when it shows (in ms; 0: until it's
  // dismissed): what the app asked for, or by urgency; an urgent one until
  // dismissed.
  function lasting(n, item) {
    if (item.urgency === 2) return 0
    const t = n ? n.expireTimeout : -1
    if (t === 0) return 0
    if (t > 0) return Math.max(1500, Math.min(t, 120000))
    return (item.urgency === 0 ? Math.round(bannerSeconds * 0.6) : bannerSeconds) * 1000
  }

  // A banner done: out of sight (still in the center). A transient one is
  // over altogether.
  function retire(key) {
    for (let b = 0; b < banners.count; b++)
      if (banners.get(b).key === key) {
        banners.remove(b)
        break
      }
    const item = shown[key]
    if (item === undefined) return
    setShown(key, null)
    if (item.transient && live[key]) live[key].expire()
  }

  function dismissBanners() {
    while (banners.count) retire(banners.get(0).key)
  }

  // --- acting on one ------------------------------------------------------------

  // Its click: the app's default action, or else its window; then it's done.
  function activate(key) {
    const n = live[key]
    const def = n ? n.actions.find(a => a.identifier === "default") : null
    const item = items.find(x => x.key === key) || shown[key]
    if (def) def.invoke()
    else if (item) focusApp(item)
    finish(key, n)
  }

  function act(key, action) {
    const n = live[key]
    action.invoke()
    finish(key, n)
  }

  function reply(key, text) {
    const n = live[key]
    if (!n || text.trim() === "") return
    n.sendInlineReply(text)
    finish(key, n)
  }

  // Acted on: out of the banners and the center, unless it stays (resident).
  function finish(key, n) {
    retire(key)
    if (n && n.resident) return
    remove(key)
  }

  // Out of the center (and off the screen): its app is told it's closed.
  function remove(key) {
    const n = live[key]
    retire(key)
    if (items.some(x => x.key === key)) {
      items = items.filter(x => x.key !== key)
      save()
    }
    if (n) n.dismiss()
  }

  function clearApp(app) {
    for (const i of items.filter(x => x.app === app)) remove(i.key)
  }

  function clearAll() {
    for (const i of items.slice()) remove(i.key)
    dismissBanners()
  }

  // The center was seen: nothing unread, nothing missed.
  function markRead() {
    missed = 0
    if (unread === 0) return
    items = items.map(i => i.unread ? Object.assign({}, i, { unread: false }) : i)
    save()
  }

  // The window of the app that sent it: by its desktop entry, else its
  // name, as a window's class (or Wayland app id).
  function focusApp(item) {
    Hyprland.refreshToplevels()
    const want = [item.entry, item.app].filter(x => x).map(x => x.toLowerCase())
    const t = Hyprland.toplevels.values.find(t => {
      const cls = String((t.lastIpcObject && t.lastIpcObject.class) || (t.wayland && t.wayland.appId) || "").toLowerCase()
      return cls !== "" && want.some(w => cls === w || cls.endsWith("." + w) || w.endsWith("." + cls))
    })
    if (!t) return
    const a = String(t.address)
    Hyprland.dispatch(`hl.dsp.focus({ window = "address:${a.startsWith("0x") ? a : "0x" + a}" })`)
  }

  // --- Do Not Disturb -----------------------------------------------------------

  function setQuiet(on) {
    manualQuiet = on
    saveState()
  }

  // "23:00" -> minutes after midnight; anything else -> -1.
  function minutes(s) {
    const m = /^([01]?\d|2[0-3]):([0-5]\d)$/.exec(String(s).trim())
    return m ? Number(m[1]) * 60 + Number(m[2]) : -1
  }

  function inSchedule() {
    const from = minutes(quietFrom), to = minutes(quietTo)
    if (from < 0 || to < 0 || from === to) return false
    const d = new Date()
    const now = d.getHours() * 60 + d.getMinutes()
    return from < to ? now >= from && now < to : now >= from || now < to
  }

  // Quiet again: what's on screen that wouldn't be let through now goes
  // (the "missed" banner too). Over (for a moment): what was missed, in
  // one banner.
  onQuietChanged: {
    if (quiet) {
      over.stop()
      for (let b = banners.count - 1; b >= 0; b--) {
        const key = banners.get(b).key
        const item = shown[key] || {}
        const rules = apps[item.app] || {}
        if (!((item.urgency === 2 && quietCritical) || rules.quiet === true)) retire(key)
      }
    } else if (missed > 0) over.restart()
  }

  Timer {
    id: over
    interval: 3000
    onTriggered: {
      if (root.quiet || root.missed === 0) return
      const key = "missed-" + Date.now()
      root.show(key, {
        key: key, app: {{ tq "title" }}, icon: "", urgency: 1, time: Date.now(), entry: "", transient: false,
        summary: (root.missed === 1 ? {{ tq "missed.one" }} : {{ tq "missed.many" }}).arg(root.missed),
        body: {{ tq "missed.body" }}, missedSummary: true,
      }, null)
      root.missed = 0
    }
  }

  // --- sound --------------------------------------------------------------------

  function ring(n, item) {
    if (sound === "off" || (sound === "critical" && item.urgency !== 2)) return
    if (n.hints && n.hints["suppress-sound"]) return
    const file = "/usr/share/sounds/freedesktop/stereo/" + (item.urgency === 2 ? "dialog-warning.oga" : "message.oga")
    Quickshell.execDetached(["sh", "-c", 'command -v pw-play >/dev/null && exec pw-play "$0" || exec paplay "$0"', file])
  }

  // --- words for times ----------------------------------------------------------

  function ago(t) {
    const s = Math.max(0, (clock - t) / 1000)
    if (s < 60) return {{ tq "time.now" }}
    if (s < 3600) return {{ tq "time.minutes" }}.arg(Math.floor(s / 60))
    const d = new Date(t), today = new Date(clock)
    if (d.toDateString() === today.toDateString()) return {{ tq "time.hours" }}.arg(Math.floor(s / 3600))
    const yesterday = new Date(clock - 864e5)
    if (d.toDateString() === yesterday.toDateString()) return {{ tq "time.yesterday" }}
    return d.toLocaleDateString(locale, Locale.ShortFormat)
  }

  Timer {
    interval: 30000
    running: true
    repeat: true
    triggeredOnStart: true
    onTriggered: {
      root.clock = Date.now()
      root.scheduled = root.inSchedule()
    }
  }

  // --- keeping it ---------------------------------------------------------------

  // What's written, to know our own saves from someone else's.
  property string writtenItems: ""
  property bool savePending: false

  // Saved at most 400 ms after a change, however fast they come (a
  // progress bar); never before the saved ones are read (it'd write over
  // them).
  function save() {
    if (!historyRead) {
      savePending = true
      return
    }
    if (!saveLater.running) saveLater.start()
  }

  function writeNow() {
    saveLater.stop()
    writtenItems = JSON.stringify({ version: 1, items: items.map(i => {
      const o = Object.assign({}, i)
      delete o.transient
      return o
    }) })
    history.setText(writtenItems)
  }

  Timer {
    id: saveLater
    interval: 400
    onTriggered: root.writeNow()
  }

  // The shell reloading: what's not saved yet is, first.
  Component.onDestruction: if (saveLater.running) writeNow()

  function saveState() {
    state.setText(JSON.stringify({ version: 1, quiet: manualQuiet, apps: apps }))
  }

  function setApp(app, fields) {
    const next = Object.assign({}, apps)
    next[app] = Object.assign({}, next[app] || {}, fields)
    apps = next
    saveState()
  }

  function readHistory() {
    if (historyRead) return
    historyRead = true
    for (const n of carried) reattach(n)
    carried = []
    if (savePending) save()
  }

  function readState() {
    if (stateRead) return
    stateRead = true
    for (const n of waiting) arrive(n)
    waiting = []
  }

  FileView {
    id: history
    path: root.dir + "/history.json"
    atomicWrites: true
    blockWrites: true // a save as the shell reloads must land
    printErrors: false
    onLoaded: {
      if (text() !== root.writtenItems) {
        try {
          const o = JSON.parse(text())
          const saved = (o.items || []).filter(i => i && typeof i.key === "string")
          // What arrived before the file was read stays, on top.
          const keys = new Set(saved.map(i => i.key))
          root.items = root.items.filter(i => !keys.has(i.key)).concat(saved).slice(0, root.keep)
        } catch (e) {} // unreadable: an empty center, saved over at the next one
      }
      root.readHistory()
    }
    onLoadFailed: root.readHistory()
  }

  FileView {
    id: state
    path: root.dir + "/state.json"
    atomicWrites: true
    printErrors: false
    onLoaded: {
      try {
        const o = JSON.parse(text())
        root.manualQuiet = o.quiet === true
        root.apps = o.apps && typeof o.apps === "object" ? o.apps : {}
      } catch (e) {}
      root.readState()
    }
    onLoadFailed: root.readState()
  }

  // Only its owner reads it: bodies can hold codes and messages.
  Component.onCompleted: Quickshell.execDetached(["sh", "-c", 'mkdir -p -m 700 "$0" && chmod 700 "$0"', root.dir])

  // Not read in a second (a disk that's slow to wake): go on without it.
  Timer {
    interval: 1000
    running: true
    onTriggered: {
      root.readState()
      root.readHistory()
    }
  }

  // --- from outside -------------------------------------------------------------

  // qs ipc -c myarch call notifications toggleQuiet
  IpcHandler {
    target: "notifications"
    function toggleQuiet(): void { root.setQuiet(!root.manualQuiet) }
    function setQuiet(on: bool): void { root.setQuiet(on) }
    function clear(): void { root.clearAll() }
    function dismiss(): void { root.dismissBanners() }
    // Capture holds the banners while it takes a picture or records.
    function hold(on: bool): void {
      root.held = on
      if (on) root.dismissBanners()
    }
    function unread(): int { return root.unread }
    function quiet(): bool { return root.quiet }
  }
}
