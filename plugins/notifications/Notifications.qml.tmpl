// Generated by myarch (plugin {{ plugin }}).
//
// Banners and the center. Banners come in at the top right of one screen
// (the focused one, or the first), three at most, the rest as "+N"; the
// pointer on them stops their time. The center slides in from the right:
// the notifications, stacked by app, and nothing else but Do Not Disturb
// and Clear all. A click outside closes it.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/notifications"

Item {
  id: root

  // The center.
  property bool open: false
  property var screenAtOpen: null
  // Stacks the person opened, by app.
  property var expanded: ({})
  // The one being answered in the center (from its Reply, there or on a
  // banner), and what's typed so far; the app whose options are open.
  // Here, not in the cards: they're made again whenever a notification
  // comes or goes.
  property string replyKey: ""
  property string replyDraft: ""
  property string optionsApp: ""

  readonly property var focusedScreen: Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
  readonly property var bannerScreen: {{ quote settings.screen }} === "primary" ? Quickshell.screens[0] : focusedScreen

  // The center's notifications stacked by app, the most recent app first.
  readonly property var groups: {
    const order = []
    const by = {}
    for (const i of NotificationService.items) {
      if (!by[i.app]) {
        by[i.app] = { app: i.app, items: [] }
        order.push(by[i.app])
      }
      by[i.app].items.push(i)
    }
    return order
  }

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    screenAtOpen = focusedScreen
    open = true
    Qt.callLater(() => sheet.forceActiveFocus())
  }

  function close() {
    open = false
    NotificationService.markRead()
    expanded = {}
    replyKey = ""
    replyDraft = ""
    optionsApp = ""
  }

  function startReply(key) {
    if (replyKey !== key) replyDraft = ""
    replyKey = key
  }

  function endReply() {
    replyKey = ""
    replyDraft = ""
    sheet.forceActiveFocus()
  }

  function expand(app, on) {
    const next = Object.assign({}, expanded)
    next[app] = on
    expanded = next
  }

  // --- banners ------------------------------------------------------------------

  PanelWindow {
    id: bannerWin
    screen: root.bannerScreen
    visible: NotificationService.banners.count > 0 && !root.open
    anchors.top: true
    anchors.right: true
    margins.top: Theme.gapOut
    margins.right: Theme.gapOut
    // Below the bar, never over it; nothing moves for it.
    exclusionMode: ExclusionMode.Normal
    exclusiveZone: 0
    color: "transparent"
    implicitWidth: 380
    implicitHeight: Math.max(1, stack.implicitHeight)
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "myarch-notifications"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.None

    ColumnLayout {
      id: stack
      width: parent.width
      spacing: 8

      // The pointer on any of them stops them all, as on macOS.
      HoverHandler { id: stackHover }

      Repeater {
        model: NotificationService.banners
        Card {
          id: bannerCard
          required property string key
          required property double at
          required property int index
          readonly property bool inView: index < 3
          visible: inView
          Layout.fillWidth: true
          banner: true
          item: NotificationService.shown[key] || ({})
          n: NotificationService.live[key] || null
          // Decided when it showed (and again when its app updates it).
          property int lasts: (NotificationService.shown[key] || {}).lasts || 0

          // In from the right.
          transform: Translate { id: slide; x: 0 }
          Component.onCompleted: if (Theme.motion) inAnim.start()
          NumberAnimation {
            id: inAnim
            target: slide
            property: "x"
            from: 400
            to: 0
            duration: Theme.duration
            easing.type: Easing.OutCubic
          }

          // Its time, running out (none for one that waits to be dismissed).
          NumberAnimation on remaining {
            id: countdown
            running: bannerCard.lasts > 0
            // The pointer on them; those waiting below the three run too, so
            // a burst doesn't replay for minutes.
            paused: running && stackHover.hovered
            from: 1
            to: 0
            duration: Math.max(1, bannerCard.lasts)
            onFinished: NotificationService.retire(bannerCard.key)
          }
          // Updated by its app: its time starts again.
          onAtChanged: {
            lasts = (NotificationService.shown[key] || {}).lasts || 0
            if (lasts > 0) {
              countdown.restart()
              // restart() forgets it was paused: under the pointer it stays.
              if (stackHover.hovered) countdown.pause()
            }
          }

          onActivated: {
            if (item.missedSummary) {
              NotificationService.retire(key)
              root.show()
            } else NotificationService.activate(key)
          }
          onClosed: NotificationService.retire(key)
          onAction: a => NotificationService.act(key, a)
          onWantsReply: {
            root.startReply(key)
            NotificationService.retire(key)
            root.show()
          }
        }
      }

      // More than three: the rest, one line; the center has them.
      Rectangle {
        visible: NotificationService.banners.count > 3
        Layout.fillWidth: true
        implicitHeight: 30
        radius: Theme.radius
        color: Theme.surfaceRaised
        border.color: Theme.border
        border.width: 1
        Label {
          anchors.centerIn: parent
          text: {{ tq "more" }}.arg(NotificationService.banners.count - 3)
          color: Theme.fgMuted
        }
        MouseArea {
          anchors.fill: parent
          cursorShape: Qt.PointingHandCursor
          onClicked: root.show()
        }
      }
    }
  }

  // --- the center ---------------------------------------------------------------

  PanelWindow {
    id: centerWin
    screen: root.screenAtOpen
    visible: root.open
    anchors.top: true
    anchors.right: true
    anchors.bottom: true
    margins.top: Theme.gapOut
    margins.right: Theme.gapOut
    margins.bottom: Theme.gapOut
    exclusionMode: ExclusionMode.Normal
    exclusiveZone: 0
    color: "transparent"
    implicitWidth: 400
    WlrLayershell.layer: WlrLayer.Overlay
    // "myarch-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "myarch-panel-notifications"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    // A click anywhere else closes it.
    HyprlandFocusGrab {
      active: root.open
      windows: [centerWin]
      onCleared: root.close()
    }

    Rectangle {
      id: sheet
      anchors.fill: parent
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: root.close()

      // In from the right.
      transform: Translate { id: sheetSlide; x: 0 }
      Connections {
        target: root
        function onOpenChanged() { if (root.open && Theme.motion) sheetIn.start() }
      }
      NumberAnimation {
        id: sheetIn
        target: sheetSlide
        property: "x"
        from: 60
        to: 0
        duration: Theme.duration
        easing.type: Easing.OutCubic
      }

      ColumnLayout {
        anchors.fill: parent
        anchors.margins: 16
        spacing: 12

        RowLayout {
          Layout.fillWidth: true
          spacing: 8
          Caption { text: {{ tq "title" }}.toUpperCase() }
          Item { Layout.fillWidth: true }
          Button {
            visible: NotificationService.items.length > 0
            text: {{ tq "clear_all" }}
            onClicked: NotificationService.clearAll()
          }
        }

        // Do Not Disturb, and why it's on when it wasn't asked for.
        RowLayout {
          Layout.fillWidth: true
          spacing: 8
          Glyph {
            text: String.fromCodePoint(NotificationService.quiet ? 0xF009B : 0xF009A)
            color: NotificationService.quiet ? Theme.accentText : Theme.fgMuted
          }
          ColumnLayout {
            Layout.fillWidth: true
            spacing: 0
            Label { text: {{ tq "quiet" }} }
            Caption {
              visible: text !== ""
              text: NotificationService.quietWhy === "schedule" ? {{ tq "quiet.schedule" }}.arg(NotificationService.quietTo)
                : NotificationService.quietWhy === "fullscreen" ? {{ tq "quiet.fullscreen" }}
                : NotificationService.quietWhy === "mode" ? {{ tq "quiet.mode" }}.arg(NotificationService.modeName) : ""
              wrapMode: Text.Wrap
              Layout.fillWidth: true
              Layout.preferredWidth: 0
            }
          }
          Toggle {
            checked: NotificationService.manualQuiet
            onToggled: on => NotificationService.setQuiet(on)
          }
        }

        Rule {}

        Flickable {
          id: scroller
          Layout.fillWidth: true
          Layout.fillHeight: true
          clip: true
          contentWidth: width
          contentHeight: list.implicitHeight
          boundsBehavior: Flickable.StopAtBounds

          ColumnLayout {
            id: list
            width: scroller.width
            spacing: 14

            Repeater {
              model: root.groups
              ColumnLayout {
                id: group
                required property var modelData
                readonly property var g: modelData
                readonly property bool open: root.expanded[g.app] === true || g.items.length === 1
                readonly property var rules: NotificationService.apps[g.app] || ({})
                readonly property bool options: root.optionsApp === g.app
                Layout.fillWidth: true
                spacing: 6

                // The app: how many, and what can be done with all of them.
                RowLayout {
                  Layout.fillWidth: true
                  spacing: 6
                  Label {
                    text: group.g.app
                    font.bold: true
                    elide: Text.ElideRight
                    Layout.fillWidth: true
                  }
                  Caption {
                    visible: group.g.items.length > 1
                    text: group.open ? {{ tq "show_less" }} : {{ tq "count" }}.arg(group.g.items.length)
                    color: Theme.accentText
                    MouseArea {
                      anchors.fill: parent
                      cursorShape: Qt.PointingHandCursor
                      onClicked: root.expand(group.g.app, !group.open)
                    }
                  }
                  Glyph {
                    text: String.fromCodePoint(0xF01D8) // dots
                    color: group.options ? Theme.accentText : Theme.fgSubtle
                    MouseArea {
                      anchors.fill: parent
                      cursorShape: Qt.PointingHandCursor
                      onClicked: root.optionsApp = group.options ? "" : group.g.app
                    }
                  }
                  Glyph {
                    text: String.fromCodePoint(0xF0156) // close
                    color: Theme.fgSubtle
                    MouseArea {
                      anchors.fill: parent
                      cursorShape: Qt.PointingHandCursor
                      onClicked: NotificationService.clearApp(group.g.app)
                    }
                  }
                }

                // Per app: banners or only here; through Do Not Disturb or not.
                ColumnLayout {
                  visible: group.options
                  Layout.fillWidth: true
                  spacing: 6
                  RowLayout {
                    Layout.fillWidth: true
                    Label { text: {{ tq "app.banners" }}; Layout.fillWidth: true }
                    Toggle {
                      checked: group.rules.banners !== false
                      onToggled: on => NotificationService.setApp(group.g.app, { banners: on })
                    }
                  }
                  RowLayout {
                    Layout.fillWidth: true
                    Label { text: {{ tq "app.quiet" }}; Layout.fillWidth: true }
                    Toggle {
                      checked: group.rules.quiet === true
                      onToggled: on => NotificationService.setApp(group.g.app, { quiet: on })
                    }
                  }
                }

                Repeater {
                  model: group.open ? group.g.items : group.g.items.slice(0, 1)
                  Card {
                    required property var modelData
                    Layout.fillWidth: true
                    item: modelData
                    n: NotificationService.live[modelData.key] || null
                    replying: root.replyKey === modelData.key
                    draft: root.replyKey === modelData.key ? root.replyDraft : ""
                    onDraftEdited: text => root.replyDraft = text
                    onWantsReply: root.startReply(modelData.key)
                    onReplyEnded: root.endReply()
                    onActivated: {
                      // A closed stack opens first, as on macOS.
                      if (!group.open) {
                        root.expand(group.g.app, true)
                        return
                      }
                      NotificationService.activate(modelData.key)
                      root.close()
                    }
                    onClosed: NotificationService.remove(modelData.key)
                    onAction: a => {
                      NotificationService.act(modelData.key, a)
                      root.close()
                    }
                    onReplied: text => {
                      NotificationService.reply(modelData.key, text)
                      root.endReply()
                    }
                  }
                }

                // A closed stack: the cards behind, as edges.
                Repeater {
                  model: group.open ? 0 : Math.min(2, group.g.items.length - 1)
                  Rectangle {
                    required property int index
                    Layout.fillWidth: true
                    Layout.leftMargin: 8 * (index + 1)
                    Layout.rightMargin: 8 * (index + 1)
                    Layout.topMargin: -6
                    implicitHeight: 6
                    radius: Theme.radius
                    color: Theme.surface
                    border.color: Theme.border
                    border.width: 1
                    z: -1 - index
                  }
                }
              }
            }
          }
        }

        Label {
          visible: NotificationService.items.length === 0
          Layout.alignment: Qt.AlignHCenter
          Layout.fillHeight: true
          text: {{ tq "empty" }}
          color: Theme.fgSubtle
        }
      }
    }
  }
}
