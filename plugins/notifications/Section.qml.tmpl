// Generated by mazapan (plugin {{ plugin }}): the latest notifications in the
// Control Center: the last few, newest first; a click on one does what a
// click on its banner does. All of them: the notification center.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/notifications"
import "../../components/control"

Group {
  id: root

  property bool shown: NotificationService.items.length > 0
  title: {{ tq "title" }}
  trailing: {{ tq "clear_all" }}
  onTrailingClicked: NotificationService.clearAll()

  Repeater {
    model: NotificationService.items.slice(0, 3)
    Rectangle {
      required property var modelData
      Layout.fillWidth: true
      implicitHeight: row.implicitHeight + 16
      radius: Theme.radius
      color: area.containsMouse ? Theme.surfaceRaised : "transparent"
      RowLayout {
        id: row
        x: 8
        y: 8
        width: parent.width - 16
        spacing: 10
        Rectangle {
          implicitWidth: 8
          implicitHeight: 8
          radius: 4
          Layout.alignment: Qt.AlignTop
          Layout.topMargin: 4
          color: modelData.unread ? Theme.accent : "transparent"
        }
        ColumnLayout {
          spacing: 2
          Layout.fillWidth: true
          Caption {
            text: modelData.app + " · " + NotificationService.ago(modelData.time)
            font.letterSpacing: 0
          }
          Label {
            text: modelData.summary
            font.bold: true
            elide: Text.ElideRight
            Layout.fillWidth: true
          }
          Label {
            visible: modelData.body !== ""
            text: modelData.body
            color: Theme.fgMuted
            elide: Text.ElideRight
            maximumLineCount: 2
            wrapMode: Text.Wrap
            Layout.fillWidth: true
          }
        }
      }
      MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        cursorShape: Qt.PointingHandCursor
        onClicked: {
          ControlService.close()
          NotificationService.activate(modelData.key)
        }
      }
    }
  }

  Text {
    visible: NotificationService.items.length > 3
    text: {{ tq "more" }}.arg(NotificationService.items.length - 3)
    color: Theme.accentText
    font.family: Theme.fontMono
    font.pointSize: 8.5
    MouseArea {
      anchors.fill: parent
      cursorShape: Qt.PointingHandCursor
      onClicked: {
        ControlService.close()
        Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "notifications"])
      }
    }
  }
}
