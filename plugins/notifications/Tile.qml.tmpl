// Generated by mazapan (plugin {{ plugin }}): Do Not Disturb in the Control Center.
//
// A big switch; when it's on by schedule, a full-screen window or a mode,
// it says so. In the pill: the bell and how many are unread.

import QtQuick
import QtQuick.Layouts
import qs
import "../../components/kit"
import "../../components/notifications"

Tile {
  readonly property string pillGlyph: NotificationService.quiet ? "󰂛"
    : NotificationService.unread > 0 ? "󰂚 " + NotificationService.unread : ""

  glyph: NotificationService.quiet ? "󰂛" : "󰂚"
  title: {{ tq "quiet" }}
  detail: !NotificationService.quiet ? {{ tq "off" }}
    : NotificationService.quietWhy === "schedule" ? {{ tq "quiet.schedule" }}.arg(NotificationService.quietTo)
    : NotificationService.quietWhy === "fullscreen" ? {{ tq "quiet.fullscreen" }}
    : NotificationService.quietWhy === "mode" ? {{ tq "quiet.mode" }}.arg(NotificationService.modeName)
    : {{ tq "on" }}
  checked: NotificationService.quiet
  onToggled: NotificationService.setQuiet(!NotificationService.manualQuiet)
}
