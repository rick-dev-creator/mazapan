# Generated by mazapan (plugin {{ plugin }}): what's sent to you with
# Taildrop, into Downloads, with a notification. {{ if settings.receive }}On{{ else }}Off (receive): not enabled{{ end }}.
[Unit]
Description=Mazapan: files sent to you with Taildrop

[Service]
ExecStart=/bin/sh %h/.local/share/mazapan/bin/taildrop
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
