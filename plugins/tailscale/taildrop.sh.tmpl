# Generated by mazapan (plugin {{ plugin }}): files sent to you with
# Taildrop land in your Downloads folder (a name taken: renamed), each with
# a notification to open it or its folder. Tailscale down or signed out:
# tried again in a minute.
dir=$(xdg-user-dir DOWNLOAD 2>/dev/null)
[ -n "$dir" ] && [ "$dir" != "$HOME" ] || dir="$HOME/Downloads"
mkdir -p "$dir"
# Received first into a folder of its own (beside Downloads: the same disk),
# then moved in one by one: only what Taildrop brought is announced.
stage="$dir/.taildrop"
mkdir -p "$stage" && chmod 700 "$stage"
while :; do
  if ! tailscale file get --wait --conflict=rename "$stage" >/dev/null 2>&1; then
    sleep 60
    continue
  fi
  for p in "$stage"/* "$stage"/.[!.]*; do
    [ -f "$p" ] || continue
    f=${p##*/}
    # A name taken in Downloads: "name (2).ext", as browsers do.
    t="$dir/$f"; n=2
    while [ -e "$t" ]; do
      case "$f" in *.*) t="$dir/${f%.*} ($n).${f##*.}" ;; *) t="$dir/$f ($n)" ;; esac
      n=$((n + 1))
    done
    mv -n -- "$p" "$t" || continue
    f=${t##*/}
    # Its buttons wait an hour at most (the notification stays in the center).
    ( a=$(timeout 3600 notify-send -a {{ shq (t "app") }} -i document-save -A open={{ shq (t "open") }} -A folder={{ shq (t "folder") }} -w -- {{ shq (t "received") }} "$f")
      case "$a" in
        open) xdg-open "$t" ;;
        folder) xdg-open "$dir" ;;
      esac ) >/dev/null 2>&1 &
  done
done
