# Generated by mazapan (plugin {{ plugin }}): files sent to you with
# Taildrop land in your Downloads folder (a name taken: renamed), each with
# a notification to open it or its folder. Tailscale down or signed out:
# tried again in a minute.
dir=$(xdg-user-dir DOWNLOAD 2>/dev/null)
[ -n "$dir" ] && [ "$dir" != "$HOME" ] || dir="$HOME/Downloads"
mkdir -p "$dir"
list() { ls -A "$dir" 2>/dev/null; }
while :; do
  before=$(list)
  if ! tailscale file get --wait --conflict=rename "$dir" >/dev/null 2>&1; then
    sleep 60
    continue
  fi
  list | while IFS= read -r f; do
    [ -n "$f" ] || continue
    printf '%s\n' "$before" | grep -qxF -- "$f" && continue
    # Its buttons wait an hour at most (the notification stays in the center).
    ( a=$(timeout 3600 notify-send -a {{ shq (t "app") }} -i document-save -A open={{ shq (t "open") }} -A folder={{ shq (t "folder") }} -w -- {{ shq (t "received") }} "$f")
      case "$a" in
        open) xdg-open "$dir/$f" ;;
        folder) xdg-open "$dir" ;;
      esac ) >/dev/null 2>&1 &
  done
done
