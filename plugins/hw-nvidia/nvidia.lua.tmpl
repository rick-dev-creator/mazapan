-- Generated by myarch (plugin {{ plugin }}).
{{- if machine.gpus.size == 1 }}
-- The NVIDIA GPU is the only one: video decoding and GLX on its driver
-- (NVD_BACKEND: VA-API through NVDEC, as its driver wants).
hl.env("NVD_BACKEND", "direct")
hl.env("LIBVA_DRIVER_NAME", "nvidia")
hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
{{- else }}
-- There are {{ machine.gpus.size }} GPUs: apps stay on the one that drives the screens
-- (setting NVIDIA's variables for everything would keep it awake, and break
-- video decoding for apps on the other). prime-run runs one on it.
{{- end }}
