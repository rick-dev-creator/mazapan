# Generated by mazapan (plugin {{ plugin }}).
{{- if machine.gpus.size == 1 }}
# The NVIDIA modules in the initramfs, loaded early: the screen is on it.
MODULES+=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)
{{- else }}
# {{ machine.gpus.size }} GPUs (a laptop's hybrid graphics): the screen starts on the
# other one, so NVIDIA's modules load later, as needed, and the initramfs
# (on the EFI partition, with the checkpoints' copies) stays small.
{{- end }}
