# Generated by mazapan (plugin {{ plugin }}).
{{- if machine.gpus.size == 1 }}
# Kernel modesetting, and the framebuffer on the NVIDIA driver (the
# console on the same GPU).
options nvidia_drm modeset=1 fbdev=1
{{- else }}
# Kernel modesetting; the console stays on the GPU that drives the screen.
options nvidia_drm modeset=1
{{- end }}
# Sleep and hibernation: the card's memory kept across them (in /var/tmp,
# on the disk, not in memory), with NVIDIA's own services doing it.
options nvidia NVreg_PreserveVideoMemoryAllocations=1 NVreg_TemporaryFilePath=/var/tmp
