/* Generated by mazapan (plugin {{ plugin }}) from theme "{{ theme.id }}". */

/* libadwaita >= 1.6 reads CSS variables; older code paths read the named
   colors below. Both are set so every app agrees. */
:root {
  --accent-color: {{ c "accent_text" }};
  --accent-bg-color: {{ c "accent" }};
  --accent-fg-color: {{ c "accent_fg" }};
  --destructive-color: {{ c "danger" }};
  --destructive-bg-color: {{ c "danger" }};
  --destructive-fg-color: {{ c "bg" }};
  --success-color: {{ c "success" }};
  --success-bg-color: {{ c "success" }};
  --success-fg-color: {{ c "bg" }};
  --warning-color: {{ c "warning" }};
  --warning-bg-color: {{ c "warning" }};
  --warning-fg-color: {{ c "bg" }};
  --error-color: {{ c "danger" }};
  --error-bg-color: {{ c "danger" }};
  --error-fg-color: {{ c "bg" }};

  --window-bg-color: {{ c "bg" }};
  --window-fg-color: {{ c "fg" }};
  --view-bg-color: {{ c "bg" }};
  --view-fg-color: {{ c "fg" }};
  --headerbar-bg-color: {{ c "bg_alt" }};
  --headerbar-fg-color: {{ c "fg" }};
  --headerbar-border-color: {{ c "border" }};
  --headerbar-backdrop-color: {{ c "bg_alt" }};
  --headerbar-shade-color: {{ cssa (c "bg_alt") 0.36 }};
  --sidebar-bg-color: {{ c "bg_alt" }};
  --sidebar-fg-color: {{ c "fg" }};
  --sidebar-backdrop-color: {{ c "bg_alt" }};
  --sidebar-border-color: {{ c "border" }};
  --sidebar-shade-color: {{ cssa (c "bg_alt") 0.36 }};
  --secondary-sidebar-bg-color: {{ c "bg_alt" }};
  --secondary-sidebar-fg-color: {{ c "fg" }};
  --secondary-sidebar-backdrop-color: {{ c "bg_alt" }};
  --secondary-sidebar-border-color: {{ c "border" }};
  --card-bg-color: {{ c "surface" }};
  --card-fg-color: {{ c "fg" }};
  --card-shade-color: {{ cssa (c "bg_alt") 0.36 }};
  --dialog-bg-color: {{ c "surface_raised" }};
  --dialog-fg-color: {{ c "fg" }};
  --popover-bg-color: {{ c "surface_raised" }};
  --popover-fg-color: {{ c "fg" }};
  --popover-shade-color: {{ cssa (c "bg_alt") 0.36 }};
  --thumbnail-bg-color: {{ c "surface" }};
  --thumbnail-fg-color: {{ c "fg" }};
  --shade-color: {{ cssa (c "bg_alt") 0.36 }};
  --scrollbar-outline-color: {{ cssa (c "bg_alt") 0.5 }};
  --border-color: {{ c "border" }};

  --window-radius: {{ theme.shape.radius }}px;
  --document-font-family: "{{ theme.font.ui }}";
  --monospace-font-family: "{{ theme.font.mono }}";
}

{{ named_colors }}

/* Tiled windows are rectangles; keep floating ones square too. */
window, window.csd, window.background {
  border-radius: {{ theme.shape.radius }}px;
}
