{{- ## VS Code's default themes, by version: "Default Dark Modern", then
       "Dark Modern", now "Dark 2026". One scope covers them all. ## -}}
{{- $bases = ["Light 2026", "Light Modern", "Default Light Modern"] }}
{{- if theme.meta.mode == "dark" }}{{ $bases = ["Dark 2026", "Dark Modern", "Default Dark Modern"] }}{{ end }}
{{- $base = "Light 2026][Light Modern][Default Light Modern" }}{{ if theme.meta.mode == "dark" }}{{ $base = "Dark 2026][Dark Modern][Default Dark Modern" }}{{ end -}}
{
  "window.autoDetectColorScheme": true,
  "workbench.colorCustomizations": { "[{{ $base }}]": {
    "foreground": "{{ c "fg" }}",
    "descriptionForeground": "{{ c "fg_muted" }}",
    "disabledForeground": "{{ c "fg_subtle" }}",
    "errorForeground": "{{ c "danger" }}",
    "focusBorder": "{{ c "accent" }}",
    "contrastBorder": "{{ c "border" }}",
    "selection.background": "{{ c "selection" }}",
    "widget.border": "{{ c "border" }}",
    "icon.foreground": "{{ c "fg_muted" }}",
    "textLink.foreground": "{{ c "accent_text" }}",
    "textLink.activeForeground": "{{ c "accent_text" }}",

    "editor.background": "{{ c "bg" }}",
    "editor.foreground": "{{ c "fg" }}",
    "editor.lineHighlightBackground": "{{ c "surface" }}",
    "editor.selectionBackground": "{{ c "selection" }}",
    "editor.inactiveSelectionBackground": "{{ mix (c "bg") (c "selection") 0.6 }}",
    "editor.findMatchBackground": "{{ c "accent_deep" }}",
    "editor.findMatchBorder": "{{ c "accent" }}",
    "editor.findMatchHighlightBackground": "{{ mix (c "bg") (c "accent") 0.25 }}",
    "editor.wordHighlightBackground": "{{ c "surface_raised" }}",
    "editorCursor.foreground": "{{ c "accent" }}",
    "editorLineNumber.foreground": "{{ c "fg_subtle" }}",
    "editorLineNumber.activeForeground": "{{ c "accent_text" }}",
    "editorIndentGuide.background1": "{{ c "border" }}",
    "editorIndentGuide.activeBackground1": "{{ c "fg_subtle" }}",
    "editorWhitespace.foreground": "{{ c "border" }}",
    "editorBracketMatch.background": "{{ c "surface_raised" }}",
    "editorBracketMatch.border": "{{ c "accent" }}",
    "editorGutter.background": "{{ c "bg" }}",
    "editorGutter.addedBackground": "{{ c "success" }}",
    "editorGutter.modifiedBackground": "{{ c "info" }}",
    "editorGutter.deletedBackground": "{{ c "danger" }}",
    "editorError.foreground": "{{ c "danger" }}",
    "editorWarning.foreground": "{{ c "warning" }}",
    "editorInfo.foreground": "{{ c "info" }}",
    "editorHint.foreground": "{{ c "accent_text" }}",
    "editorWidget.background": "{{ c "surface_raised" }}",
    "editorWidget.border": "{{ c "border" }}",
    "editorSuggestWidget.background": "{{ c "surface_raised" }}",
    "editorSuggestWidget.selectedBackground": "{{ c "accent" }}",
    "editorSuggestWidget.selectedForeground": "{{ c "accent_fg" }}",
    "editorSuggestWidget.highlightForeground": "{{ c "accent_text" }}",
    "editorSuggestWidget.focusHighlightForeground": "{{ c "accent_fg" }}",
    "editorHoverWidget.background": "{{ c "surface_raised" }}",
    "editorHoverWidget.border": "{{ c "border" }}",
    "editorGroupHeader.tabsBackground": "{{ c "bg_alt" }}",
    "editorGroup.border": "{{ c "border" }}",
    "diffEditor.insertedTextBackground": "{{ mix (c "bg") (c "success") 0.2 }}",
    "diffEditor.removedTextBackground": "{{ mix (c "bg") (c "danger") 0.2 }}",

    "tab.activeBackground": "{{ c "bg" }}",
    "tab.activeForeground": "{{ c "fg" }}",
    "tab.activeBorderTop": "{{ c "accent" }}",
    "tab.inactiveBackground": "{{ c "bg_alt" }}",
    "tab.inactiveForeground": "{{ c "fg_muted" }}",
    "tab.border": "{{ c "border" }}",
    "tab.hoverBackground": "{{ c "surface" }}",

    "titleBar.activeBackground": "{{ c "bg_alt" }}",
    "titleBar.activeForeground": "{{ c "fg" }}",
    "titleBar.inactiveBackground": "{{ c "bg_alt" }}",
    "titleBar.inactiveForeground": "{{ c "fg_subtle" }}",
    "titleBar.border": "{{ c "border" }}",
    "activityBar.background": "{{ c "bg_alt" }}",
    "activityBar.foreground": "{{ c "fg" }}",
    "activityBar.inactiveForeground": "{{ c "fg_subtle" }}",
    "activityBar.activeBorder": "{{ c "accent" }}",
    "activityBar.border": "{{ c "border" }}",
    "activityBarBadge.background": "{{ c "accent" }}",
    "activityBarBadge.foreground": "{{ c "accent_fg" }}",
    "sideBar.background": "{{ c "bg_alt" }}",
    "sideBar.foreground": "{{ c "fg" }}",
    "sideBar.border": "{{ c "border" }}",
    "sideBarTitle.foreground": "{{ c "fg_muted" }}",
    "sideBarSectionHeader.background": "{{ c "bg_alt" }}",
    "sideBarSectionHeader.foreground": "{{ c "fg_muted" }}",
    "sideBarSectionHeader.border": "{{ c "border" }}",
    "statusBar.background": "{{ c "bg_alt" }}",
    "statusBar.foreground": "{{ c "fg_muted" }}",
    "statusBar.border": "{{ c "border" }}",
    "statusBar.debuggingBackground": "{{ c "warning" }}",
    "statusBar.debuggingForeground": "{{ c "bg" }}",
    "statusBar.noFolderBackground": "{{ c "bg_alt" }}",
    "statusBarItem.remoteBackground": "{{ c "accent" }}",
    "statusBarItem.remoteForeground": "{{ c "accent_fg" }}",
    "panel.background": "{{ c "bg_alt" }}",
    "panel.border": "{{ c "border" }}",
    "panelTitle.activeBorder": "{{ c "accent" }}",
    "panelTitle.activeForeground": "{{ c "fg" }}",
    "panelTitle.inactiveForeground": "{{ c "fg_muted" }}",
    "breadcrumb.foreground": "{{ c "fg_muted" }}",
    "breadcrumb.focusForeground": "{{ c "fg" }}",

    "list.activeSelectionBackground": "{{ c "accent" }}",
    "list.activeSelectionForeground": "{{ c "accent_fg" }}",
    "list.inactiveSelectionBackground": "{{ c "surface_raised" }}",
    "list.hoverBackground": "{{ c "surface" }}",
    "list.focusOutline": "{{ c "accent" }}",
    "list.highlightForeground": "{{ c "accent_text" }}",
    "list.focusHighlightForeground": "{{ c "accent_fg" }}",
    "quickInput.background": "{{ c "surface_raised" }}",
    "quickInputList.focusBackground": "{{ c "accent" }}",
    "quickInputList.focusForeground": "{{ c "accent_fg" }}",
    "menu.background": "{{ c "surface_raised" }}",
    "menu.foreground": "{{ c "fg" }}",
    "menu.selectionBackground": "{{ c "accent" }}",
    "menu.selectionForeground": "{{ c "accent_fg" }}",
    "menu.border": "{{ c "border" }}",
    "dropdown.background": "{{ c "surface" }}",
    "dropdown.border": "{{ c "border" }}",
    "input.background": "{{ c "bg_alt" }}",
    "input.foreground": "{{ c "fg" }}",
    "input.border": "{{ c "border" }}",
    "input.placeholderForeground": "{{ c "fg_subtle" }}",
    "inputOption.activeBorder": "{{ c "accent" }}",
    "button.background": "{{ c "accent" }}",
    "button.foreground": "{{ c "accent_fg" }}",
    "button.hoverBackground": "{{ if (c "accent_fg") == "#ffffff" }}{{ mix (c "accent") "#000000" 0.15 }}{{ else }}{{ mix (c "accent") "#ffffff" 0.15 }}{{ end }}",
    "button.secondaryBackground": "{{ c "surface_raised" }}",
    "button.secondaryForeground": "{{ c "fg" }}",
    "badge.background": "{{ c "accent" }}",
    "badge.foreground": "{{ c "accent_fg" }}",
    "progressBar.background": "{{ c "accent" }}",
    "scrollbarSlider.background": "{{ mix (c "bg") (c "border") 0.8 }}",
    "scrollbarSlider.hoverBackground": "{{ c "border" }}",
    "scrollbarSlider.activeBackground": "{{ c "fg_subtle" }}",
    "notifications.background": "{{ c "surface_raised" }}",
    "notifications.border": "{{ c "border" }}",
    "peekView.border": "{{ c "accent" }}",
    "peekViewEditor.background": "{{ c "bg_alt" }}",
    "peekViewResult.background": "{{ c "surface" }}",
    "peekViewTitle.background": "{{ c "surface_raised" }}",
    "gitDecoration.addedResourceForeground": "{{ c "success" }}",
    "gitDecoration.modifiedResourceForeground": "{{ c "info" }}",
    "gitDecoration.deletedResourceForeground": "{{ c "danger" }}",
    "gitDecoration.untrackedResourceForeground": "{{ c "success" }}",
    "gitDecoration.ignoredResourceForeground": "{{ c "fg_subtle" }}",
    "gitDecoration.conflictingResourceForeground": "{{ c "warning" }}",

    "terminal.background": "{{ c "bg" }}",
    "terminal.foreground": "{{ c "fg" }}",
    "terminalCursor.foreground": "{{ c "accent" }}",
    "terminal.selectionBackground": "{{ c "selection" }}",
    "terminal.ansiBlack": "{{ c "black" }}",
    "terminal.ansiRed": "{{ c "red" }}",
    "terminal.ansiGreen": "{{ c "green" }}",
    "terminal.ansiYellow": "{{ c "yellow" }}",
    "terminal.ansiBlue": "{{ c "blue" }}",
    "terminal.ansiMagenta": "{{ c "magenta" }}",
    "terminal.ansiCyan": "{{ c "cyan" }}",
    "terminal.ansiWhite": "{{ c "white" }}",
    "terminal.ansiBrightBlack": "{{ c "bright_black" }}",
    "terminal.ansiBrightRed": "{{ c "bright_red" }}",
    "terminal.ansiBrightGreen": "{{ c "bright_green" }}",
    "terminal.ansiBrightYellow": "{{ c "bright_yellow" }}",
    "terminal.ansiBrightBlue": "{{ c "bright_blue" }}",
    "terminal.ansiBrightMagenta": "{{ c "bright_magenta" }}",
    "terminal.ansiBrightCyan": "{{ c "bright_cyan" }}",
    "terminal.ansiBrightWhite": "{{ c "bright_white" }}"
  } },
  "editor.tokenColorCustomizations": {
{{- for b in $bases }}{{ if !for.first }},{{ end }}
    "[{{ b }}]": { "textMateRules": {{ textmate }} }
{{- end }}
  },
  "editor.semanticTokenColorCustomizations": {
{{- for b in $bases }}{{ if !for.first }},{{ end }}
    "[{{ b }}]": { "enabled": true, "rules": {{ semantic }} }
{{- end }}
  }
}
