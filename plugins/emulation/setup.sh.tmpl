#!/bin/sh
# Generated by mazapan (plugin {{ plugin }}): your games' folders, and
# RetroArch pointed at them the first time. Games and BIOS are yours: from
# what you own (copies of your cartridges and discs, your consoles' BIOS).
games={{ shq settings.games }}
case $games in "~"*) games="$HOME${games#\~}" ;; esac
for d in nes snes megadrive mastersystem gb gbc gba n64 nds 3ds psx ps2 psp ps3 gamecube wii wiiu dreamcast pcengine arcade xbox dos scummvm; do
  mkdir -p "$games/ROMs/$d"
done
mkdir -p "$games/BIOS"
[ -e "$games/BIOS/README.txt" ] || printf '%s\n' {{ shq (t "bios.readme") }} > "$games/BIOS/README.txt"
# RetroArch: only when it has no settings of its own yet.
ra="$HOME/.config/retroarch/retroarch.cfg"
if command -v retroarch >/dev/null && [ ! -e "$ra" ]; then
  mkdir -p "${ra%/*}"
  cat > "$ra" <<CFG
menu_driver = "ozone"
rgui_browser_directory = "$games/ROMs"
system_directory = "$games/BIOS"
video_fullscreen = "true"
pause_nonactive = "false"
input_autodetect_enable = "true"
menu_swap_ok_cancel_buttons = "false"
savestate_auto_save = "true"
savestate_auto_load = "true"
CFG
fi
true
