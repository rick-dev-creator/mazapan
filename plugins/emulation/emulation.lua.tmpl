-- Generated by mazapan (plugin {{ plugin }}): emulators' windows never let
-- the screen dim or lock while in front, and draw the moment they're ready
-- (tearing allowed for them alone: less delay).
hl.config({ general = { allow_tearing = true } })
for _, cls in ipairs({
  "^com\\.libretro\\.RetroArch$", "^retroarch$", "^dolphin-emu$", "^PCSX2$", "^pcsx2-qt$",
  "^duckstation.*$", "^PPSSPP.*$", "^rpcs3$", "^melonDS$", "^azahar.*$", "^Cemu$", "^xemu$",
  "^scummvm$", "^dosbox.*$",
}) do
  hl.window_rule({ match = { class = cls }, idle_inhibit = "focus", immediate = true })
end
