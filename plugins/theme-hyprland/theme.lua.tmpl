-- Generated by myarch (plugin {{.Plugin}}) from theme "{{.Theme.ID}}".

hl.config({
  general = {
    gaps_in = {{.Theme.Shape.GapIn}},
    gaps_out = {{.Theme.Shape.GapOut}},
    border_size = {{.Theme.Shape.Border}},
    col = {
      active_border = "{{rgb (c "accent")}}",
      inactive_border = "{{rgb (c "border")}}",
    },
  },
  decoration = {
    rounding = {{.Theme.Shape.Radius}},
    shadow = { enabled = false },
    blur = { enabled = false },
  },
  misc = {
    background_color = "{{rgb (c "bg_alt")}}",
  },
  animations = {
    enabled = {{.Theme.Motion.Enabled}},
  },
})

{{with .Theme.Motion.Curve -}}
hl.curve("myarch", { type = "bezier", points = { { {{num (index . 0)}}, {{num (index . 1)}} }, { {{num (index . 2)}}, {{num (index . 3)}} } } })
{{- end}}

-- Speeds are in deciseconds, derived from the theme's base duration.
hl.animation({ leaf = "global",      enabled = true, speed = {{speed 1}},   bezier = "myarch" })
hl.animation({ leaf = "border",      enabled = true, speed = {{speed 1}},   bezier = "myarch" })
hl.animation({ leaf = "windowsIn",   enabled = true, speed = {{speed 1}},   bezier = "myarch", style = "popin 90%" })
hl.animation({ leaf = "windowsOut",  enabled = true, speed = {{speed 0.6}}, bezier = "myarch", style = "popin 90%" })
hl.animation({ leaf = "windowsMove", enabled = true, speed = {{speed 1}},   bezier = "myarch" })
hl.animation({ leaf = "fade",        enabled = true, speed = {{speed 0.8}}, bezier = "myarch" })
hl.animation({ leaf = "layers",      enabled = true, speed = {{speed 0.8}}, bezier = "myarch", style = "fade" })
hl.animation({ leaf = "workspaces",  enabled = true, speed = {{speed 1.5}}, bezier = "myarch", style = "slide" })
