//
// A horizontal slider from 0 to `to`. Drag or click it, or scroll over it;
// `moved` reports what the person chose, the owner decides what to do.

import QtQuick
import qs

Item {
  id: slider

  property real value: 0
  property real to: 1
  property real step: 0.05
  property bool dimmed: false // e.g. muted: still usable, drawn subdued

  signal moved(real value)

  implicitHeight: 16

  function set(v) {
    slider.moved(Math.max(0, Math.min(slider.to, v)))
  }

  Rectangle {
    id: track
    anchors.verticalCenter: parent.verticalCenter
    width: parent.width
    height: 4
    color: Theme.surface

    Rectangle {
      width: track.width * Math.min(1, slider.value / slider.to)
      height: parent.height
      color: slider.dimmed ? Theme.fgSubtle : Theme.accent
    }
  }

  Rectangle {
    width: 10
    height: 14
    anchors.verticalCenter: parent.verticalCenter
    x: (slider.width - width) * Math.min(1, slider.value / slider.to)
    color: slider.dimmed ? Theme.fgSubtle : Theme.accent
    border.width: 1
    border.color: Theme.surfaceRaised
  }

  MouseArea {
    anchors.fill: parent
    anchors.topMargin: -6
    anchors.bottomMargin: -6
    cursorShape: Qt.PointingHandCursor
    onPressed: mouse => slider.set(mouse.x / slider.width * slider.to)
    onPositionChanged: mouse => { if (pressed) slider.set(mouse.x / slider.width * slider.to) }
    onWheel: event => slider.set(slider.value + (event.angleDelta.y > 0 ? slider.step : -slider.step))
  }
}
