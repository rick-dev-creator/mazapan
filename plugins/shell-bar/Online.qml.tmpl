// Generated by mazapan (plugin {{ plugin }}).
// Whether the internet is there, for every widget: Online.online, and a
// Connections on Online with onBack() to fetch again the moment it comes
// back instead of at the next timer. (No curly brace in these comments:
// Quickshell looks for "pragma Singleton" only before the first one, and
// this file would quietly stop being a singleton.)
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Networking

Singleton {
  id: root

  // NetworkManager's own check (it reaches a known page), so a Wi-Fi joined
  // but not yet through (a login portal, no address yet) isn't online. With
  // the check turned off, a connected device is all there is to go by.
  readonly property bool checked: Networking.canCheckConnectivity && Networking.connectivityCheckEnabled
  readonly property bool online: checked
    ? Networking.connectivity === NetworkConnectivity.Full
    : Networking.devices.values.some(d => d.connected)

  // Each time it comes back after being gone. Not as the shell starts:
  // NetworkManager's answer takes a moment to arrive, and services fetch
  // then anyway.
  signal back()
  property bool settled: false
  property bool wasOffline: false
  Timer {
    interval: 5000
    running: true
    onTriggered: { root.settled = true; root.wasOffline = !root.online }
  }
  onOnlineChanged: {
    if (!settled) return
    if (!online) wasOffline = true
    else if (wasOffline) { wasOffline = false; back() }
  }
}
