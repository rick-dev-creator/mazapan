// Generated by myarch (plugin {{ plugin }}): part of the bar's kit for widgets
// (import "../../components/kit").
//
// A card that drops down from a bar widget. It closes on a click anywhere
// else, on Escape, or through toggle() from the widget; a click on the
// widget that dismissed it doesn't reopen it right away. Children go in a
// column with the card's padding.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs

PopupWindow {
  id: popup

  required property Item owner
  property int cardWidth: 320
  default property alias content: body.data

  signal opening()      // right before it shows: refresh what it displays
  signal key(var event) // keys other than Escape

  property double closedAt: 0

  function toggle() {
    if (visible) {
      visible = false
    } else if (Date.now() - closedAt > 250) {
      opening()
      visible = true
    }
  }

  visible: false
  anchor.item: owner
  anchor.edges: Edges.Bottom
  anchor.gravity: Edges.Bottom
  anchor.margins.top: Theme.gapOut
  implicitWidth: cardWidth
  implicitHeight: card.implicitHeight
  color: "transparent"
  // A real popup grab: keyboard focus, and the compositor dismisses it on
  // a click anywhere else.
  grabFocus: true
  onVisibleChanged: if (!visible) closedAt = Date.now()

  Rectangle {
    id: card
    width: parent.width
    implicitHeight: body.implicitHeight + 32
    color: Theme.surfaceRaised
    border.color: Theme.border
    border.width: 1
    radius: Theme.radius
    focus: true
    Keys.onPressed: event => {
      if (event.key === Qt.Key_Escape) {
        popup.visible = false
        event.accepted = true
      } else {
        popup.key(event)
      }
    }

    ColumnLayout {
      id: body
      x: 16
      y: 16
      width: parent.width - 32
      spacing: 12
    }
  }
}
