// Generated by mazapan (plugin {{ plugin }}): part of the bar's kit for widgets
// (import "../../components/kit").
//
// A password asked in place (a Wi-Fi's, the first time): what it's for
// above, the field with an eye to see what's typed, Cancel and the action
// beside it. Enter or the button submits once it's long enough, Esc
// cancels only this; while `busy` it waits, and `error` says what went
// wrong right under it. The words come from the plugin using it.

import QtQuick
import QtQuick.Layouts
import qs

ColumnLayout {
  id: prompt

  property string label: ""
  property string actionText: ""
  property string cancelText: ""
  property string busyText: ""
  property string error: ""
  property bool busy: false
  // WPA's passphrases are 8 to 63 characters (64 is the key in hex).
  property int minLength: 8
  property int maxLength: 64
  readonly property bool valid: field.text.length >= minLength && field.text.length <= maxLength
  signal submitted(string password)
  signal cancelled()

  // Ready for a new password: empty, hidden, focused.
  function start() {
    field.text = ""
    field.revealed = false
    field.focusInput()
  }
  // Back to typing, what's typed kept (to fix after an error).
  function focusField() { field.focusInput() }
  function submit() {
    if (valid && !busy) submitted(field.text)
  }

  spacing: 6

  Text {
    Layout.fillWidth: true
    textFormat: Text.PlainText
    text: prompt.label
    color: Theme.fg
    wrapMode: Text.Wrap
    font.family: Theme.fontMono
    font.pointSize: 9.5
  }

  TextField {
    id: field
    Layout.fillWidth: true
    implicitHeight: 32
    echoMode: TextInput.Password
    revealable: true
    takesEscape: true
    // Waiting: read-only, not disabled, so it keeps the focus and Esc
    // still cancels just this.
    readOnly: prompt.busy
    opacity: prompt.busy ? 0.6 : 1
    onAccepted: prompt.submit()
    onEscaped: prompt.cancelled()
  }

  RowLayout {
    Layout.fillWidth: true
    spacing: 6
    Text {
      Layout.fillWidth: true
      textFormat: Text.PlainText
      text: prompt.busy ? prompt.busyText
        : prompt.error !== "" ? prompt.error
        : field.text.length > 0 && field.text.length < prompt.minLength
          ? field.text.length + " / " + prompt.minLength : ""
      color: prompt.error !== "" && !prompt.busy ? Theme.danger : Theme.fgMuted
      wrapMode: Text.Wrap
      font.family: Theme.fontMono
      font.pointSize: 8.5
    }
    Button {
      text: prompt.cancelText
      onClicked: prompt.cancelled()
    }
    Button {
      text: prompt.actionText
      primary: true
      enabled: prompt.valid && !prompt.busy
      onClicked: prompt.submit()
    }
  }
}
