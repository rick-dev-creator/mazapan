# Generated by myarch (plugin {{.Plugin}}): make the running shell pick up
# its files again, or start it if it isn't running. Every plugin with
# Quickshell files uses this as its reload command, so how the shell is
# reloaded lives in one place.
qs ipc -c myarch call myarch reload >/dev/null 2>&1 && exit 0
qs kill -c myarch >/dev/null 2>&1
hyprctl dispatch 'hl.dsp.exec_cmd("qs -c myarch --no-duplicate")' >/dev/null
