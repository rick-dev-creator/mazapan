# Generated by mazapan (plugin {{ plugin }}): make the running shell pick up
# its files again, or start it if it isn't running. Every plugin with
# Quickshell files uses this as its reload command, so how the shell is
# reloaded lives in one place.
qs ipc -c mazapan call mazapan reload >/dev/null 2>&1 && exit 0
qs kill -c mazapan >/dev/null 2>&1
# A shell being killed still counts for a moment: started now, the new one
# would take it for a running copy (--no-duplicate) and leave no bar.
for _ in $(seq 30); do
  qs list -c mazapan 2>&1 | grep -q "Process ID" || break
  sleep 0.1
done
hyprctl dispatch 'hl.dsp.exec_cmd("qs -c mazapan --no-duplicate")' >/dev/null
