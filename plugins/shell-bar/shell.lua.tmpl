-- Generated by myarch (plugin {{ plugin }}): start the shell with Hyprland.
hl.on("hyprland.start", function()
  -- Flatpak's apps folder there before the shell looks: watched from the
  -- start, an app installed later shows right away.
  hl.dispatch(hl.dsp.exec_cmd("sh -c 'mkdir -p \"$HOME/.local/share/flatpak/exports/share/applications\"; exec qs -c myarch --no-duplicate'"))
end)
