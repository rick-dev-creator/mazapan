//
// A group of controls (a section of the Control Center, or of any panel):
// the theme's surface, its border and radius, a title if it has one, and
// what's put in it stacked below.

import QtQuick
import QtQuick.Layouts
import qs

Rectangle {
  id: group

  property string title: ""
  property string trailing: ""   // a word at the title's right ("Dashboard")
  signal trailingClicked()
  default property alias content: body.data

  Layout.fillWidth: true
  implicitHeight: body.implicitHeight + 24 + (title !== "" ? head.implicitHeight + 8 : 0)
  radius: Theme.radius
  color: Theme.surface
  border.width: 1
  border.color: Theme.border

  RowLayout {
    id: head
    visible: group.title !== ""
    x: 12
    y: 12
    width: parent.width - 24
    Text {
      text: group.title
      color: Theme.fg
      font.family: Theme.fontMono
      font.pointSize: 9.5
      font.bold: true
      Layout.fillWidth: true
    }
    Text {
      visible: group.trailing !== ""
      text: group.trailing
      color: Theme.accentText
      font.family: Theme.fontMono
      font.pointSize: 8.5
      MouseArea {
        anchors.fill: parent
        cursorShape: Qt.PointingHandCursor
        onClicked: group.trailingClicked()
      }
    }
  }

  ColumnLayout {
    id: body
    x: 12
    y: group.title !== "" ? head.y + head.implicitHeight + 8 : 12
    width: parent.width - 24
    spacing: 8
  }
}
