// Generated by myarch (plugin {{ plugin }}): part of the bar's kit for widgets
// (import "../../components/kit").
//
// One row of a list in a card (a network, a device): glyph, title, detail
// under it, something small on the right. `active` marks the current one
// (connected, default) with an accent bar and bold title.

import QtQuick
import QtQuick.Layouts
import qs

Rectangle {
  id: row

  property string glyph: ""
  property string title: ""
  property string detail: ""
  property string trailing: ""
  property bool active: false

  signal clicked(var mouse)

  Layout.fillWidth: true
  implicitHeight: detail === "" ? 30 : 40
  color: area.containsMouse ? Theme.surface : "transparent"

  Rectangle {
    visible: row.active
    width: 2
    height: parent.height
    color: Theme.accent
  }

  RowLayout {
    anchors.fill: parent
    anchors.leftMargin: 10
    anchors.rightMargin: 8
    spacing: 10

    Text {
      // Plain: what it shows can come from a plugin or a catalog, and
      // rich text could hide part of it, or load an image from anywhere.
      textFormat: Text.PlainText
      text: row.glyph
      // One width for every glyph, so titles line up.
      Layout.preferredWidth: 18
      horizontalAlignment: Text.AlignHCenter
      color: row.active ? Theme.accentText : Theme.fgMuted
      font.family: Theme.fontMono
      font.pointSize: 12
    }

    ColumnLayout {
      Layout.fillWidth: true
      spacing: 1

      Text {
        // Plain: what it shows can come from a plugin or a catalog, and
        // rich text could hide part of it, or load an image from anywhere.
        textFormat: Text.PlainText
        Layout.fillWidth: true
        text: row.title
        elide: Text.ElideRight
        color: Theme.fg
        font.family: Theme.fontMono
        font.pointSize: 9.5
        font.bold: row.active
      }

      Text {
        // Plain: what it shows can come from a plugin or a catalog, and
        // rich text could hide part of it, or load an image from anywhere.
        textFormat: Text.PlainText
        Layout.fillWidth: true
        visible: row.detail !== ""
        text: row.detail
        elide: Text.ElideRight
        color: Theme.fgMuted
        font.family: Theme.fontMono
        font.pointSize: 8.5
      }
    }

    Text {
      // Plain: what it shows can come from a plugin or a catalog, and
      // rich text could hide part of it, or load an image from anywhere.
      textFormat: Text.PlainText
      visible: row.trailing !== ""
      text: row.trailing
      color: Theme.fgSubtle
      font.family: Theme.fontMono
      font.pointSize: 8.5
    }
  }

  MouseArea {
    id: area
    anchors.fill: parent
    hoverEnabled: true
    acceptedButtons: Qt.LeftButton | Qt.RightButton
    cursorShape: Qt.PointingHandCursor
    onClicked: mouse => row.clicked(mouse)
  }
}
