// Generated by mazapan (plugin {{ plugin }}): part of the bar's kit for widgets
// (import "../../components/kit").
//
// The clickable part of a widget in the bar: highlight on hover and while
// its card is open. Children go in a row, centered.

import QtQuick
import qs

Item {
  id: item

  property var barScreen
  property int barHeight: 28
  // False takes the widget out of the bar, gap included (see shell.qml).
  property bool shown: true
  property bool open: false
  property int padding: 8
  property alias acceptedButtons: area.acceptedButtons
  default property alias content: row.data

  signal clicked(var mouse)
  signal wheel(var event)

  implicitWidth: row.implicitWidth + padding * 2
  implicitHeight: barHeight

  Rectangle {
    anchors.fill: parent
    anchors.bottomMargin: 1
    color: item.open ? Theme.surfaceRaised : area.containsMouse ? Theme.surface : "transparent"
  }

  Row {
    id: row
    anchors.centerIn: parent
    spacing: 6
  }

  MouseArea {
    id: area
    anchors.fill: parent
    hoverEnabled: true
    cursorShape: Qt.PointingHandCursor
    onClicked: mouse => item.clicked(mouse)
    onWheel: event => item.wheel(event)
  }
}
