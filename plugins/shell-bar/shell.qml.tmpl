// Generated by myarch (plugin {{ plugin }}).
//
// One bar per monitor. The bar has no widgets of its own: every QML file
// another plugin generates under widgets/left, widgets/center or
// widgets/right is loaded into that slot, in file-name order (so a plugin
// picks its place with a prefix like 10-). Each widget loads on its own:
// one that fails shows a warning in its place and the rest keep working.
//
// Panels are the other kind of plugin surface: windows that aren't part of
// the bar (a monitor manager, a launcher). A plugin generates
// panels/<name>.qml; it's loaded once, and opened or closed with
//   qs ipc -c myarch call myarch panel <name>
// Panel contract: a root Item with `function toggle()`; it makes its own
// windows.
//
// Widget contract: a root Item with an implicitWidth; it may declare
// `property var barScreen` (the ShellScreen of its bar) and
// `property int barHeight`, which are set after it loads, and
// `property bool shown`: false takes it out of the bar entirely, with no
// gap left behind, until it turns true again.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import qs

ShellRoot {
  id: root

  // Widgets are loaded by URL, and the QML engine caches components by URL
  // across reloads: without a fresh URL each generation, a reload keeps
  // showing the old widget. Evaluated once per (re)load.
  readonly property string generation: String(Date.now())

  // Quickshell's own file watching loses track of files myarch replaces
  // atomically, so plugins ask for a reload after writing (see the reload
  // command of any Quickshell target).
  IpcHandler {
    target: "myarch"
    function reload(): void {
      Quickshell.reload(false)
    }
    // For health checks: answers as long as the bar is alive.
    function ping(): string {
      return "ok"
    }
    // Open or close a panel by name (panels/<name>.qml).
    function panel(name: string): string {
      for (const p of panels.instances) {
        if (p.name === name && p.item) {
          p.item.toggle()
          return "ok"
        }
      }
      return `no panel ${name}`
    }
    // Close every open panel (SUPER + Q while one is open).
    function close(): void {
      for (const p of panels.instances)
        if (p.item && p.item.open) p.item.close()
    }
  }

  Variants {
    id: panels
    model: [
{{- for file in under "~/.config/quickshell/myarch/panels/" }}
      "{{ file }}",
{{- end }}
    ]

    Loader {
      required property string modelData
      readonly property string name: modelData.split("/").pop().replace(/\.qml$/, "")
      source: "file://" + modelData + "?generation=" + root.generation
      onStatusChanged: if (status === Loader.Error) console.warn("myarch: panel failed to load:", modelData)
    }
  }

  Variants {
    model: Quickshell.screens

    PanelWindow {
      id: bar
      required property var modelData
      screen: modelData

      anchors {
        top: true
        left: true
        right: true
      }
      implicitHeight: {{ settings.height }}
      color: Theme.bgAlt
      WlrLayershell.namespace: "myarch-bar"

      component Slot: Item {
        id: slot
        required property string file

        // Not the widget's `visible`: inside a hidden slot it would read
        // false forever, so the widget could never come back.
        visible: loader.status !== Loader.Ready || loader.item.shown !== false

        implicitWidth: loader.status === Loader.Ready ? loader.implicitWidth : failed.implicitWidth
        implicitHeight: bar.height

        Loader {
          id: loader
          anchors.fill: parent
          source: "file://" + slot.file + "?generation=" + root.generation
          onLoaded: {
            if ("barScreen" in item) item.barScreen = bar.modelData
            if ("barHeight" in item) item.barHeight = bar.height
          }
        }

        Text {
          id: failed
          visible: loader.status === Loader.Error
          anchors.verticalCenter: parent.verticalCenter
          leftPadding: 8
          rightPadding: 8
          text: "⚠ " + slot.file.split("/").pop()
          color: Theme.danger
          font.family: Theme.fontMono
          font.pointSize: Theme.fontSize
        }
      }

      // Hairline between the bar and the windows.
      Rectangle {
        anchors {
          left: parent.left
          right: parent.right
          bottom: parent.bottom
        }
        height: 1
        color: Theme.border
      }

      RowLayout {
        anchors {
          left: parent.left
          top: parent.top
          bottom: parent.bottom
          leftMargin: Theme.gapOut
        }
        spacing: Theme.gapOut
{{- for file in under "~/.config/quickshell/myarch/widgets/left/" }}
        Slot { file: "{{ file }}" }
{{- end }}
      }

      RowLayout {
        anchors {
          horizontalCenter: parent.horizontalCenter
          top: parent.top
          bottom: parent.bottom
        }
        spacing: Theme.gapOut
{{- for file in under "~/.config/quickshell/myarch/widgets/center/" }}
        Slot { file: "{{ file }}" }
{{- end }}
      }

      RowLayout {
        anchors {
          right: parent.right
          top: parent.top
          bottom: parent.bottom
          rightMargin: Theme.gapOut
        }
        spacing: Theme.gapOut
{{- for file in under "~/.config/quickshell/myarch/widgets/right/" }}
        Slot { file: "{{ file }}" }
{{- end }}
      }
    }
  }
}
