// Generated by mazapan (plugin {{ plugin }}).
//
// One bar per monitor. The bar has no widgets of its own: every QML file
// another plugin generates under widgets/left, widgets/center or
// widgets/right is loaded into that slot, in file-name order (so a plugin
// picks its place with a prefix like 10-). Each widget loads on its own:
// one that fails shows a warning in its place and the rest keep working.
//
// Panels are the other kind of plugin surface: windows that aren't part of
// the bar (a monitor manager, a launcher). A plugin generates
// panels/<name>.qml; it's loaded once, and opened or closed with
//   qs ipc -c mazapan call mazapan panel <name>
// Panel contract: a root Item with `function toggle()`; it makes its own
// windows.
//
// Widget contract: a root Item with an implicitWidth; it may declare
// `property var barScreen` (the ShellScreen of its bar) and
// `property int barHeight`, which are set after it loads, and
// `property bool shown`: false takes it out of the bar entirely, with no
// gap left behind, until it turns true again.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import qs

ShellRoot {
  id: root

  // Widgets are loaded by URL, and the QML engine caches components by URL
  // across reloads: without a fresh URL each generation, a reload keeps
  // showing the old widget. Evaluated once per (re)load.
  readonly property string generation: String(Date.now())

  // Quickshell's own file watching loses track of files mazapan replaces
  // atomically, so plugins ask for a reload after writing (see the reload
  // command of any Quickshell target).
  // Widgets taken out of the bar for a while (a mode hides the ticker
  // during a talk): their names, "markets" for widgets/right/45-markets.qml.
  // Kept across reloads (as text: lists aren't kept).
  PersistentProperties {
    id: barState
    reloadableId: "mazapan-bar"
    property string hidden: ""
  }
  readonly property var hiddenWidgets: barState.hidden.split(",").filter(n => n !== "")
  function widgetName(file) {
    return file.split("/").pop().replace(/\.qml$/, "").replace(/^[0-9]+-/, "")
  }

  IpcHandler {
    target: "mazapan"
    function reload(): void {
      Quickshell.reload(false)
    }
    // For health checks: answers as long as the bar is alive.
    function ping(): string {
      return "ok"
    }
    // Open or close a panel by name (panels/<name>.qml).
    function panel(name: string): string {
      for (const p of panels.instances) {
        if (p.name === name && p.item) {
          p.item.toggle()
          return "ok"
        }
      }
      return `no panel ${name}`
    }
    // Take widgets out of the bar ("markets,weather"; "": all back).
    function hide(names: string): void {
      barState.hidden = names.split(",").map(n => n.trim()).filter(n => n !== "").join(",")
    }
    // The bar's widgets by name, one per line (left, center, right).
    function widgets(): string {
      return [
{{- for file in under "~/.config/quickshell/mazapan/widgets/left/" }}
        "{{ file }}",
{{- end }}
{{- for file in under "~/.config/quickshell/mazapan/widgets/center/" }}
        "{{ file }}",
{{- end }}
{{- for file in under "~/.config/quickshell/mazapan/widgets/right/" }}
        "{{ file }}",
{{- end }}
      ].map(f => root.widgetName(f)).join("\n")
    }
    // Close every open panel (SUPER + Q while one is open).
    function close(): void {
      for (const p of panels.instances)
        if (p.item && p.item.open) p.item.close()
    }
  }

  Variants {
    id: panels
    model: [
{{- for file in under "~/.config/quickshell/mazapan/panels/" }}
      "{{ file }}",
{{- end }}
    ]

    Loader {
      required property string modelData
      readonly property string name: modelData.split("/").pop().replace(/\.qml$/, "")
      source: "file://" + modelData + "?generation=" + root.generation
      onStatusChanged: if (status === Loader.Error) console.warn("mazapan: panel failed to load:", modelData)
    }
  }

  Variants {
    model: Quickshell.screens

    PanelWindow {
      id: bar
      required property var modelData
      screen: modelData

      anchors {
        top: true
        left: true
        right: true
      }
      implicitHeight: {{ settings.height }}
      color: Theme.bgAlt
      WlrLayershell.namespace: "mazapan-bar"

      component Slot: Item {
        id: slot
        required property string file

        // Not the widget's `visible`: inside a hidden slot it would read
        // false forever, so the widget could never come back.
        visible: !root.hiddenWidgets.includes(root.widgetName(slot.file))
          && (loader.status !== Loader.Ready || loader.item.shown !== false)

        implicitWidth: loader.status === Loader.Ready ? loader.implicitWidth : failed.implicitWidth
        implicitHeight: bar.height
        // An elastic widget (a window's title) gives up its room first
        // when the bar is short of it; the others keep their width.
        readonly property bool elastic: loader.status === Loader.Ready && loader.item.elastic === true
        Layout.preferredWidth: implicitWidth
        Layout.maximumWidth: implicitWidth
        Layout.minimumWidth: elastic ? 0 : implicitWidth
        Layout.fillWidth: elastic
        clip: elastic

        Loader {
          id: loader
          anchors.fill: parent
          source: "file://" + slot.file + "?generation=" + root.generation
          onLoaded: {
            if ("barScreen" in item) item.barScreen = bar.modelData
            if ("barHeight" in item) item.barHeight = bar.height
          }
        }

        Text {
          id: failed
          visible: loader.status === Loader.Error
          anchors.verticalCenter: parent.verticalCenter
          leftPadding: 8
          rightPadding: 8
          text: "⚠ " + slot.file.split("/").pop()
          color: Theme.danger
          font.family: Theme.fontMono
          font.pointSize: Theme.fontSize
        }
      }

      // Hairline between the bar and the windows.
      Rectangle {
        anchors {
          left: parent.left
          right: parent.right
          bottom: parent.bottom
        }
        height: 1
        color: Theme.border
      }

      // Left, center and right. The center is centered while there's room;
      // on a narrow screen it moves left, clear of the right, and the left
      // gives up room (its elastic widgets first, then it's cut).
      RowLayout {
        id: leftRow
        anchors {
          left: parent.left
          top: parent.top
          bottom: parent.bottom
          leftMargin: Theme.gapOut
        }
        width: Math.max(0, Math.min(implicitWidth, (centerRow.children.length > 0 && centerRow.implicitWidth > 0 ? centerRow.x : rightRow.x) - Theme.gapOut * 2 - x))
        clip: width < implicitWidth
        spacing: Theme.gapOut
{{- for file in under "~/.config/quickshell/mazapan/widgets/left/" }}
        Slot { file: "{{ file }}" }
{{- end }}
      }

      RowLayout {
        id: centerRow
        anchors {
          top: parent.top
          bottom: parent.bottom
        }
        x: Math.max(0, Math.min((bar.width - width) / 2, rightRow.x - Theme.gapOut * 2 - width))
        spacing: Theme.gapOut
{{- for file in under "~/.config/quickshell/mazapan/widgets/center/" }}
        Slot { file: "{{ file }}" }
{{- end }}
      }

      RowLayout {
        id: rightRow
        anchors {
          right: parent.right
          top: parent.top
          bottom: parent.bottom
          rightMargin: Theme.gapOut
        }
        spacing: Theme.gapOut
{{- for file in under "~/.config/quickshell/mazapan/widgets/right/" }}
        Slot { file: "{{ file }}" }
{{- end }}
      }
    }
  }
}
