-- Generated by mazapan (plugin {{ plugin }}): the capture overlay. While a
-- recording runs, the same key stops it (the overlay knows).
hl.bind({{ lq settings.key }}, hl.dsp.exec_cmd("qs ipc -c mazapan call mazapan panel capture"))

-- "Record with camera": the camera's window at the bottom right corner (8:9,
-- a sixth of the screen's height), floating, on every workspace, never taking
-- the focus, never dimmed.
hl.window_rule({
  match = { class = "^mazapan-camera$" },
  float = true,
  pin = true,
  no_initial_focus = true,
  no_dim = true,
  size = { "(monitor_h*4/25)", "(monitor_h*9/50)" },
  move = { "(monitor_w-monitor_h*4/25-40)", "(monitor_h-monitor_h*9/50-40)" },
})
