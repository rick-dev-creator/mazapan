// Generated by mazapan (plugin {{ plugin }}): a recording, in the Control Center.
//
// While the screen records: a card under Now with how long, and Stop; the
// pill says it, in danger's color (one click on it opens this).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import qs
import "../../components/kit"
import "../../components/control"

Group {
  id: root

  // The capture overlay's state file: "<recorder pid> <start>" while one
  // records. A pid that's gone (a crash) doesn't count.
  readonly property string state: (Quickshell.env("XDG_RUNTIME_DIR") || "/tmp/mazapan-" + Quickshell.env("USER")) + "/mazapan-capture/recording"
  property int pid: 0
  property int since: 0
  property int secs: 0

  readonly property bool live: since > 0
  readonly property int level: 2
  readonly property string clock: `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, "0")}`
  readonly property string pill: {{ tq "recording_pill" }}.arg(clock)

  Process {
    id: poller
    command: ["sh", "-c", "set -- $(cat \"$0\" 2>/dev/null); [ -n \"$1\" ] && kill -0 \"$1\" 2>/dev/null && echo \"$1 $2\"", root.state]
    stdout: StdioCollector {
      onStreamFinished: {
        const f = text.trim().split(" ")
        root.pid = f.length === 2 ? Number(f[0]) : 0
        root.since = f.length === 2 ? Number(f[1]) : 0
      }
    }
  }
  Timer {
    interval: 2000
    running: true
    repeat: true
    triggeredOnStart: true
    onTriggered: poller.running = true
  }
  Timer {
    interval: 1000
    running: root.since > 0
    repeat: true
    triggeredOnStart: true
    onTriggered: root.secs = Math.max(0, Math.floor(Date.now() / 1000) - root.since)
  }

  color: Qt.rgba(Theme.danger.r, Theme.danger.g, Theme.danger.b, 0.12)
  border.color: Theme.danger

  RowLayout {
    Layout.fillWidth: true
    spacing: 10
    Rectangle {
      implicitWidth: 10
      implicitHeight: 10
      radius: 5
      color: Theme.danger
    }
    ColumnLayout {
      Layout.fillWidth: true
      spacing: 2
      Label { text: {{ tq "recording_title" }}.arg(root.clock); font.bold: true }
      Caption { text: {{ tq "recording_where" }}; font.letterSpacing: 0 }
    }
    Button {
      primary: true
      text: {{ tq "stop" }}
      onClicked: {
        ControlService.close()
        if (root.pid > 0) Quickshell.execDetached(["kill", "-INT", String(root.pid)])
      }
    }
  }
}
