// Generated by myarch (plugin {{ plugin }}): the capture overlay (panel).
//
// {{ inline settings.key }} freezes every screen (grim) and shows them under a dim
// veil. Drag a region, or click a window (or empty screen) to take it all.
// Then: copy, save, copy its text (OCR), annotate it, or record it; each
// shows the command it runs. ↵ copies and saves; c s t a r for the rest;
// esc leaves. While a recording runs, {{ inline settings.key }} stops it.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property int shotId: 0
  // The selection: on which screen, where (logical pixels, relative to it).
  property string selScreen: ""
  property real selX: 0
  property real selY: 0
  property real selW: 0
  property real selH: 0
  property bool chosen: false      // a region is picked: the actions show
  property bool annotating: false
  property string hint: ""         // the command of the action pointed at
  property string focusName: ""    // the screen that gets the keyboard

  // Annotations: { tool, color, points: [{x, y}] }, in selection coords.
  property var strokes: []
  property string tool: "pen"
  property color ink: Theme.danger

  // Private: frozen screens and the last shot never leave it, and go when
  // done with. (A missing runtime dir falls back to a private one in /tmp.)
  readonly property string dir: (Quickshell.env("XDG_RUNTIME_DIR") || "/tmp/myarch-" + Quickshell.env("USER")) + "/myarch-capture"
  readonly property string home: Quickshell.env("HOME")
  readonly property string pictures: {{ json settings.pictures }}.replace(/^~/, home)
  readonly property string videos: {{ json settings.videos }}.replace(/^~/, home)
  // The system's language first, English after; the ones installed are
  // used (tesseract-data-<lang>), the others skipped.
  readonly property string ocrWant: "{{ if lang_code == "es" }}spa eng{{ else if lang_code == "fr" }}fra eng{{ else if lang_code == "de" }}deu eng{{ else if lang_code == "pt" }}por eng{{ else if lang_code == "it" }}ita eng{{ else }}eng{{ end }}"
  readonly property string ocrLangs: ocrWant.replace(" ", "+")
  readonly property string shot: dir + "/shot.png"
  readonly property string state: dir + "/recording" // "<pid> <start>" while recording
  // The action keys, in the system's language (English ones work too).
  readonly property var keysFor: ({ copy: {{ tq "key.copy" }}, save: {{ tq "key.save" }}, text: {{ tq "key.text" }}, annotate: {{ tq "key.annotate" }}, record: {{ tq "key.record" }} })

  function q(s) { return "'" + String(s).replace(/'/g, "'\\''") + "'" }
  function tilde(p) { return p.startsWith(home) ? "~" + p.slice(home.length) : p }
  function notify(text, icon) {
    Quickshell.execDetached(["hyprctl", "notify", String(icon ?? 5), "5000", "0", text])
  }

  // --- opening, closing ------------------------------------------------------

  function toggle() {
    if (open) close()
    else if (!starter.running && !freezer.running) starter.running = true
  }

  function close() {
    open = false
    chosen = false
    annotating = false
    selW = selH = 0
    strokes = []
    hint = ""
    crop = null
    // The frozen screens: not kept a moment longer than needed.
    Quickshell.execDetached(["sh", "-c", "rm -f \"$0\"/*.frozen.png", dir])
  }

  // A recording that's really running (its process alive) is stopped; a
  // state file left by one that died (a crash, a logout) is dropped.
  Process {
    id: starter
    command: ["sh", "-c", "p=$(cut -d' ' -f1 \"$0\" 2>/dev/null); if [ -n \"$p\" ] && kill -0 \"$p\" 2>/dev/null; then kill -INT \"$p\"; else rm -f \"$0\"; echo capture; fi", root.state]
    stdout: StdioCollector {
      onStreamFinished: if (text.trim() === "capture") {
        Hyprland.refreshToplevels()
        root.focusName = Hyprland.focusedMonitor ? Hyprland.focusedMonitor.name : ""
        freezer.running = true
      }
    }
  }

  // One grim per screen, at its own resolution, fast (no compression).
  // Notifications go first: they're drawn on the screen grim copies.
  Process {
    id: freezer
    command: ["sh", "-c", "command -v grim >/dev/null || exit 3; hyprctl dismissnotify >/dev/null 2>&1; "
      + "mkdir -p -m 700 \"$0\" && for o in \"$@\"; do grim -l 0 -o \"$o\" \"$0/$o.frozen.png\" || exit 1; done",
      root.dir].concat(Quickshell.screens.map(s => s.name))
    onExited: code => {
      if (code === 3) root.notify({{ tq "missing" }}.arg("grim"), 3)
      if (code !== 0) return
      root.shotId++
      root.open = false
      root.chosen = false
      root.annotating = false
      root.selW = root.selH = 0
      root.strokes = []
      root.open = true
    }
  }

  // --- doing -----------------------------------------------------------------

  // The command each action runs, as it runs it: shown, then run.
  function command(action, stamp) {
    switch (action) {
    case "copy": return `wl-copy -t image/png < ${q(shot)}`
    case "save": return `mkdir -p ${q(pictures)} && cp ${q(shot)} ${q(pictures + "/Screenshot " + stamp + ".png")}`
    case "text": return `tesseract ${q(shot)} - -l ${ocrLangs} | wl-copy`
    case "record": {
      const s = Quickshell.screens.find(s => s.name === selScreen)
      const g = `${Math.round(s.x + selX)},${Math.round(s.y + selY)} ${Math.round(selW)}x${Math.round(selH)}`
      return `wf-recorder -g "${g}"{{ if settings.audio }} -a{{ end }} -f ${q(videos + "/Recording " + stamp + ".mp4")}`
    }
    }
    return ""
  }

  // Tesseract's languages: the wanted ones that are installed.
  readonly property string ocrScript: `l=; for x in ${ocrWant}; do tesseract --list-langs 2>/dev/null | grep -qx "$x" && l="$l+$x"; done; l=\${l#+}`

  function showHint(action) {
    const shown = { copy: `wl-copy -t image/png < shot.png`,
      save: `cp shot.png ${tilde(pictures)}/…`,
      text: `tesseract shot.png - -l ${ocrLangs} | wl-copy`,
      record: command("record", "…").replace(q(videos + "/Recording ….mp4"), tilde(videos) + "/…") }
    hint = shown[action] ?? ""
  }

  // Copy, save or read: the picked region (and what's drawn on it) as a
  // PNG first, at the screen's own pixels, then the command.
  function act(actions) {
    const crop = root.crop
    if (!crop || !chosen) return
    // Tesseract reads screen-sized text better twice as big.
    const k = actions.includes("text") ? 2 : 1
    const size = Qt.size(Math.round(selW * crop.scale) * k, Math.round(selH * crop.scale) * k)
    crop.item.grabToImage(result => {
      const ok = result.saveToFile(shot)
      close()
      if (!ok) {
        notify({{ tq "failed" }}, 3)
        return
      }
      const stamp = Qt.formatDateTime(new Date(), "yyyy-MM-dd HH-mm-ss")
      let script
      if (actions.includes("text")) {
        script = `command -v tesseract >/dev/null || { hyprctl notify 3 6000 0 ${q({{ tq "missing" }}.arg("tesseract"))}; exit; }; ${ocrScript}; `
          + `t=$(tesseract ${q(shot)} - -l "\${l:-eng}" 2>/dev/null); if [ -n "$(printf %s "$t" | tr -d '[:space:]')" ]; then printf %s "$t" | wl-copy; `
          + `hyprctl notify 5 5000 0 ${q({{ tq "text_copied" }})}; else hyprctl notify 0 5000 0 ${q({{ tq "no_text" }})}; fi`
      } else {
        const said = []
        script = "set -e"
        for (const a of actions) {
          script += "\n" + command(a, stamp)
          if (a === "copy") said.push({{ tq "copied" }})
          if (a === "save") said.push({{ tq "saved" }}.arg(tilde(pictures)))
        }
        script += `\nhyprctl notify 5 5000 0 ${q(said.join(" · "))}`
      }
      // The shot goes too once used (wl-copy has its own copy).
      Quickshell.execDetached(["sh", "-c", `( ${script} ); rm -f ${q(shot)}`])
    }, size)
  }

  // Recording: the overlay goes first (it mustn't be in the video), and no
  // notice either (it'd be in it): the red dot in the bar says so. The
  // state file holds the recorder's pid, so a dead one never blocks the key.
  function record() {
    if (!chosen) return
    const stamp = Qt.formatDateTime(new Date(), "yyyy-MM-dd HH-mm-ss")
    const file = videos + "/Recording " + stamp + ".mp4"
    const script = `command -v wf-recorder >/dev/null || { hyprctl notify 3 6000 0 ${q({{ tq "missing" }}.arg("wf-recorder"))}; exit; }; `
      + `mkdir -p ${q(videos)}; mkdir -p -m 700 ${q(dir)}; st=${q(state)}; echo "$$ $(date +%s)" > "$st"; `
      + `trap 'rm -f "$st"' EXIT HUP TERM; sleep 0.3; `
      + `${command("record", stamp)} >/dev/null 2>&1 & p=$!; echo "$p $(date +%s)" > "$st"; `
      + `trap 'kill -INT $p' INT; wait $p; wait $p 2>/dev/null; rm -f "$st"; `
      + `if [ -s ${q(file)} ]; then hyprctl notify 5 6000 0 ${q({{ tq "recorded" }}.arg(tilde(file)))}; `
      + `else hyprctl notify 3 6000 0 ${q({{ tq "record_failed" }})}; fi`
    close()
    Quickshell.execDetached(["sh", "-c", script])
  }

  function key(event) {
    const k = event.key
    const letter = event.text.toLowerCase()
    const is = (action, english) => letter === keysFor[action] || k === english
    if (k === Qt.Key_Escape) {
      if (annotating) annotating = false
      else close()
    } else if (!chosen) {
      return
    } else if (annotating && (event.modifiers & Qt.ControlModifier) && k === Qt.Key_Z) {
      strokes = strokes.slice(0, -1)
    } else if (k === Qt.Key_Return || k === Qt.Key_Enter) {
      if (annotating) annotating = false
      else act(["copy", "save"])
    } else if (annotating) {
      return
    } else if (is("copy", Qt.Key_C)) act(["copy"])
    else if (is("save", Qt.Key_S)) act(["save"])
    else if (is("text", Qt.Key_T)) act(["text"])
    else if (is("annotate", Qt.Key_A)) annotating = true
    else if (is("record", Qt.Key_R)) record()
    else return
    event.accepted = true
  }

  // The picked region's item on its screen (set by that screen's window).
  property var crop: null

  // --- the overlay, on every screen -----------------------------------------------

  Variants {
    model: Quickshell.screens

    PanelWindow {
      id: win
      required property var modelData
      readonly property bool mine: root.selScreen === modelData.name && root.selW > 0 && root.selH > 0
      // Physical pixels per logical one on this screen (grim's are physical).
      readonly property real scale: frozen.sourceSize.width > 0 ? frozen.sourceSize.width / width : 1

      screen: modelData
      visible: root.open
      anchors {
        top: true
        bottom: true
        left: true
        right: true
      }
      color: "black"
      exclusionMode: ExclusionMode.Ignore
      WlrLayershell.layer: WlrLayer.Overlay
      // "myarch-panel-…": SUPER + Q closes it (see hypr-base).
      WlrLayershell.namespace: "myarch-panel-capture"
      WlrLayershell.keyboardFocus: modelData.name === root.focusName ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None

      onVisibleChanged: if (visible && modelData.name === root.focusName) Qt.callLater(() => keys.forceActiveFocus())

      Item {
        id: keys
        anchors.fill: parent
        focus: true
        Keys.onPressed: event => root.key(event)
      }

      // The screen as it was.
      Image {
        id: frozen
        anchors.fill: parent
        source: root.open ? "file://" + root.dir + "/" + win.modelData.name + ".frozen.png?" + root.shotId : ""
        cache: false
        smooth: true
      }

      // The veil, around the region.
      Item {
        anchors.fill: parent
        readonly property color veil: Qt.rgba(0, 0, 0, 0.5)
        Rectangle { visible: !win.mine; anchors.fill: parent; color: parent.veil }
        Rectangle { visible: win.mine; width: parent.width; height: root.selY; color: parent.veil }
        Rectangle { visible: win.mine; y: root.selY + root.selH; width: parent.width; height: parent.height - y; color: parent.veil }
        Rectangle { visible: win.mine; y: root.selY; width: root.selX; height: root.selH; color: parent.veil }
        Rectangle { visible: win.mine; x: root.selX + root.selW; y: root.selY; width: parent.width - x; height: root.selH; color: parent.veil }
      }

      // Windows visible on this screen (its workspace, or its special one
      // when open), with what says which is on top: a special workspace's,
      // then fullscreen, then floating, then the most recently focused.
      readonly property var windows: {
        const out = []
        for (const t of Hyprland.toplevels.values) {
          const ipc = t.lastIpcObject
          const ws = t.workspace
          if (!ipc || !ipc.at || !ws || !ws.monitor || ws.monitor.name !== modelData.name) continue
          if (ipc.hidden || ipc.mapped === false) continue
          const special = ws.id < 0
          const monIpc = ws.monitor.lastIpcObject || {}
          if (special && !(monIpc.specialWorkspace && monIpc.specialWorkspace.name === ws.name)) continue
          if (!special && ws.monitor.activeWorkspace && ws.monitor.activeWorkspace.id !== ws.id) continue
          out.push({ x: ipc.at[0] - modelData.x, y: ipc.at[1] - modelData.y, w: ipc.size[0], h: ipc.size[1],
            rank: [special ? 0 : 1, ipc.fullscreen ? 0 : 1, ipc.floating ? 0 : 1, ipc.focusHistoryID ?? 99] })
        }
        return out
      }
      property var hovered: null

      Rectangle {
        visible: !root.chosen && win.hovered !== null && !area.pressed
        x: win.hovered ? win.hovered.x : 0
        y: win.hovered ? win.hovered.y : 0
        width: win.hovered ? win.hovered.w : 0
        height: win.hovered ? win.hovered.h : 0
        color: Qt.rgba(1, 1, 1, 0.06)
        border.width: 2
        border.color: Theme.accentText
      }

      MouseArea {
        id: area
        anchors.fill: parent
        hoverEnabled: true
        enabled: !root.annotating
        cursorShape: Qt.CrossCursor
        property real ox: 0
        property real oy: 0

        // The window on top under (x, y).
        function windowAt(x, y) {
          const above = (a, b) => {
            for (let i = 0; i < a.rank.length; i++) if (a.rank[i] !== b.rank[i]) return a.rank[i] < b.rank[i]
            return false
          }
          let best = null
          for (const w of win.windows)
            if (x >= w.x && x < w.x + w.w && y >= w.y && y < w.y + w.h && (!best || above(w, best)))
              best = w
          return best
        }

        // To the screen's own pixels: a crop at a fraction of one comes out
        // blurred (fractional scaling).
        function snap(v) { return Math.round(v * win.scale) / win.scale }

        onPositionChanged: mouse => {
          if (pressed) {
            root.selX = snap(Math.max(0, Math.min(ox, mouse.x)))
            root.selY = snap(Math.max(0, Math.min(oy, mouse.y)))
            root.selW = snap(Math.min(win.width, Math.max(ox, mouse.x))) - root.selX
            root.selH = snap(Math.min(win.height, Math.max(oy, mouse.y))) - root.selY
          } else if (!root.chosen) {
            win.hovered = windowAt(mouse.x, mouse.y)
          }
        }
        onPressed: mouse => {
          ox = mouse.x
          oy = mouse.y
          root.selScreen = win.modelData.name
          root.focusName = win.modelData.name
          root.chosen = false
          root.strokes = []
          root.selW = root.selH = 0
          keys.forceActiveFocus()
        }
        onReleased: mouse => {
          if (root.selW < 4 || root.selH < 4) {
            // A click: the window under it, or the whole screen.
            // (A window sticking out of the screen: the part on it.)
            const w = windowAt(mouse.x, mouse.y)
            const r = w ? { x: Math.max(0, w.x), y: Math.max(0, w.y),
                            w: Math.min(w.x + w.w, win.width) - Math.max(0, w.x), h: Math.min(w.y + w.h, win.height) - Math.max(0, w.y) }
                        : { x: 0, y: 0, w: win.width, h: win.height }
            root.selX = snap(r.x); root.selY = snap(r.y); root.selW = snap(r.w); root.selH = snap(r.h)
          }
          root.chosen = true
          win.hovered = null
        }
        onExited: win.hovered = null
      }

      // The region itself: what gets copied, saved, read, with its drawings.
      Item {
        id: cropItem
        visible: win.mine
        x: root.selX
        y: root.selY
        width: root.selW
        height: root.selH
        clip: true
        Component.onCompleted: updateCrop()
        onVisibleChanged: updateCrop()
        function updateCrop() { if (visible) root.crop = { item: cropItem, scale: win.scale } }

        Image {
          anchors.fill: parent
          source: frozen.source
          cache: false
          smooth: false
          sourceClipRect: Qt.rect(Math.round(root.selX * win.scale), Math.round(root.selY * win.scale),
                                  Math.round(root.selW * win.scale), Math.round(root.selH * win.scale))
        }

        Canvas {
          id: ink
          anchors.fill: parent
          property var strokes: root.strokes
          onStrokesChanged: requestPaint()
          onPaint: {
            const ctx = getContext("2d")
            ctx.reset()
            ctx.lineCap = "round"
            ctx.lineJoin = "round"
            for (const s of root.strokes) {
              const p = s.points
              if (p.length < 2) continue
              ctx.strokeStyle = s.color
              ctx.fillStyle = s.color
              ctx.globalAlpha = s.tool === "marker" ? 0.35 : 1
              ctx.lineWidth = s.tool === "marker" ? 18 : 3
              const a = p[0], b = p[p.length - 1]
              ctx.beginPath()
              if (s.tool === "box") {
                ctx.rect(a.x, a.y, b.x - a.x, b.y - a.y)
              } else if (s.tool === "arrow") {
                const ang = Math.atan2(b.y - a.y, b.x - a.x), head = 16
                ctx.moveTo(a.x, a.y)
                ctx.lineTo(b.x, b.y)
                ctx.moveTo(b.x - head * Math.cos(ang - 0.45), b.y - head * Math.sin(ang - 0.45))
                ctx.lineTo(b.x, b.y)
                ctx.lineTo(b.x - head * Math.cos(ang + 0.45), b.y - head * Math.sin(ang + 0.45))
              } else {
                ctx.moveTo(a.x, a.y)
                for (let i = 1; i < p.length; i++) ctx.lineTo(p[i].x, p[i].y)
              }
              ctx.stroke()
            }
          }
        }

        MouseArea {
          anchors.fill: parent
          enabled: root.annotating
          cursorShape: Qt.CrossCursor
          property var current: null
          onPressed: mouse => {
            current = { tool: root.tool, color: String(root.ink), points: [{ x: mouse.x, y: mouse.y }] }
            root.strokes = root.strokes.concat([current])
          }
          onPositionChanged: mouse => {
            if (!pressed || !current) return
            if (current.tool === "pen" || current.tool === "marker") current.points.push({ x: mouse.x, y: mouse.y })
            else current.points = [current.points[0], { x: mouse.x, y: mouse.y }]
            root.strokes = root.strokes.slice() // repaint
          }
          onReleased: {
            // A click, not a stroke: nothing drawn, nothing to undo.
            if (current && current.points.length < 2) root.strokes = root.strokes.slice(0, -1)
            current = null
          }
        }
      }

      // Its outline and size.
      Rectangle {
        visible: win.mine
        x: root.selX - 1
        y: root.selY - 1
        width: root.selW + 2
        height: root.selH + 2
        color: "transparent"
        border.width: 1
        border.color: Theme.accent
      }
      Rectangle {
        visible: win.mine && !root.chosen
        x: Math.min(root.selX + root.selW + 6, win.width - width - 4)
        y: Math.min(root.selY + root.selH + 6, win.height - height - 4)
        width: size.implicitWidth + 12
        height: size.implicitHeight + 6
        color: Theme.surfaceRaised
        Caption {
          id: size
          anchors.centerIn: parent
          text: `${Math.round(root.selW * win.scale)}×${Math.round(root.selH * win.scale)}`
          color: Theme.fg
        }
      }

      // What to do, before anything is picked.
      Rectangle {
        visible: !root.chosen && !area.pressed
        anchors.horizontalCenter: parent.horizontalCenter
        y: 40
        width: help.implicitWidth + 24
        height: help.implicitHeight + 12
        color: Theme.surfaceRaised
        border.width: 1
        border.color: Theme.border
        Caption {
          id: help
          anchors.centerIn: parent
          text: {{ tq "hint" }}
          color: Theme.fgMuted
        }
      }

      // The actions (or, annotating, the tools), next to the region.
      Rectangle {
        id: bar
        visible: win.mine && root.chosen
        readonly property real below: root.selY + root.selH + 10
        x: Math.max(8, Math.min(win.width - width - 8, root.selX + root.selW / 2 - width / 2))
        y: below + height < win.height - 8 ? below : Math.max(8, root.selY - height - 10 < 8 ? root.selY + root.selH - height - 10 : root.selY - height - 10)
        width: column.implicitWidth + 16
        height: column.implicitHeight + 16
        color: Theme.surfaceRaised
        border.width: 1
        border.color: Theme.border
        radius: Theme.radius

        // Clicks between its buttons are its own, not a new selection.
        MouseArea { anchors.fill: parent; hoverEnabled: true; onExited: root.hint = "" }

        ColumnLayout {
          id: column
          x: 8
          y: 8
          spacing: 6

          RowLayout {
            visible: !root.annotating
            spacing: 6
            component Action: Button {
              property string action
              HoverHandler { onHoveredChanged: hovered ? root.showHint(parent.action) : root.hint = "" }
            }
            Action { action: "copy"; text: "󰆏 " + {{ tq "copy" }}; primary: true; onClicked: root.act(["copy"]) }
            Action { action: "save"; text: "󰆓 " + {{ tq "save" }}; onClicked: root.act(["save"]) }
            Action { action: "text"; text: "󰈙 " + {{ tq "text" }}; onClicked: root.act(["text"]) }
            Button { text: "󰏫 " + {{ tq "annotate" }}; onClicked: root.annotating = true }
            Action { action: "record"; text: "󰑋 " + {{ tq "record" }}; onClicked: root.record() }
          }

          RowLayout {
            visible: root.annotating
            spacing: 6
            component Tool: Button {
              property string name
              primary: root.tool === name
              onClicked: root.tool = name
            }
            Tool { name: "pen"; text: {{ tq "pen" }} }
            Tool { name: "arrow"; text: {{ tq "arrow" }} }
            Tool { name: "box"; text: {{ tq "box" }} }
            Tool { name: "marker"; text: {{ tq "marker" }} }
            Repeater {
              model: [Theme.danger, Theme.warning, Theme.success, Theme.accent, Theme.fg]
              Rectangle {
                required property color modelData
                width: 18
                height: 18
                radius: 9
                color: modelData
                border.width: Qt.colorEqual(root.ink, modelData) ? 2 : 0
                border.color: Theme.fg
                MouseArea { anchors.fill: parent; onClicked: root.ink = parent.modelData }
              }
            }
            Button { text: {{ tq "undo" }}; onClicked: root.strokes = root.strokes.slice(0, -1) }
            Button { text: {{ tq "done" }}; primary: true; onClicked: root.annotating = false }
          }

          // The command behind the action pointed at.
          Caption {
            visible: !root.annotating
            Layout.fillWidth: true
            Layout.maximumWidth: 520
            elide: Text.ElideMiddle
            text: root.hint !== "" ? "$ " + root.hint
              : "↵ " + {{ tq "copy" }} + " + " + {{ tq "save" }} + "   " + ["copy", "save", "text", "annotate", "record"].map(a => root.keysFor[a]).join(" ") + "   esc"
            color: root.hint !== "" ? Theme.accentText : Theme.fgMuted
          }
        }
      }
    }
  }
}
