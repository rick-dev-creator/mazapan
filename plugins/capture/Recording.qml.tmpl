// Generated by myarch (plugin {{ plugin }}).
//
// While the screen is being recorded: a red dot and the time, in the
// middle of the bar. Click to stop ({{ settings.key }} does the same).

import QtQuick
import Quickshell
import Quickshell.Io
import qs
import "../../components/kit"

BarItem {
  id: root

  // The capture overlay's state file: "<recorder pid> <start>" while one
  // records. A pid that's gone (a crash) doesn't count.
  readonly property string state: (Quickshell.env("XDG_RUNTIME_DIR") || "/tmp/myarch-" + Quickshell.env("USER")) + "/myarch-capture/recording"
  property int pid: 0
  property int since: 0 // seconds since the epoch; 0: not recording
  property int secs: 0

  shown: since > 0
  onClicked: if (pid > 0) Quickshell.execDetached(["kill", "-INT", String(pid)])

  Process {
    id: poller
    command: ["sh", "-c", "set -- $(cat \"$0\" 2>/dev/null); [ -n \"$1\" ] && kill -0 \"$1\" 2>/dev/null && echo \"$1 $2\"", root.state]
    stdout: StdioCollector {
      onStreamFinished: {
        const f = text.trim().split(" ")
        root.pid = f.length === 2 ? Number(f[0]) : 0
        root.since = f.length === 2 ? Number(f[1]) : 0
      }
    }
  }

  // Looked at every 2 s; the clock ticks every second while it records.
  Timer {
    interval: 2000
    running: true
    repeat: true
    triggeredOnStart: true
    onTriggered: poller.running = true
  }
  Timer {
    interval: 1000
    running: root.since > 0
    repeat: true
    triggeredOnStart: true
    onTriggered: root.secs = Math.max(0, Math.floor(Date.now() / 1000) - root.since)
  }

  Rectangle {
    anchors.verticalCenter: parent.verticalCenter
    width: 8
    height: 8
    radius: 4
    color: Theme.danger
    opacity: root.secs % 2 === 0 ? 1 : 0.35
    Behavior on opacity { NumberAnimation { duration: 400 } }
  }

  Label {
    anchors.verticalCenter: parent.verticalCenter
    text: `${Math.floor(root.secs / 60)}:${String(root.secs % 60).padStart(2, "0")}`
    color: Theme.danger
    font.bold: true
  }
}
