// Generated by mazapan (plugin {{ plugin }}): the wallpaper.
//
// Drawn from the theme's tokens, so it always matches the theme and
// morphs with it when the theme picker previews another one:
//   "grid"  dark themes: a gradient into a perspective floor in the
//           accent, faint, with its horizon glowing (an 80s terminal's
//           idea of space); light themes: graph paper.
//   "plain" bg_alt.
//   a path  the theme's image.
// Or a picture of yours (WallpaperService: the picker's choice, per
// screen, filled, tinted, in turn), faded in over the last one.
// Terminals are see-through (the theme's terminal_opacity): this is what
// they let through, blurred.

import QtQuick
import QtQuick.Effects
import Quickshell
import Quickshell.Wayland
import qs
import "../components/wallpaper"

Item {
  id: root

  // A panel by contract (see shell.qml); there's nothing to open.
  property bool open: false
  function toggle() {}
  function close() {}

  readonly property bool image: Theme.wallpaper !== "grid" && Theme.wallpaper !== "plain"

  Variants {
    model: Quickshell.screens

    PanelWindow {
      id: win
      required property var modelData
      screen: modelData
      anchors {
        top: true
        bottom: true
        left: true
        right: true
      }
      color: Theme.bgAlt
      exclusionMode: ExclusionMode.Ignore
      WlrLayershell.layer: WlrLayer.Background
      WlrLayershell.namespace: "mazapan-wallpaper"

      // A picture: yours, or the theme's (also when yours can't be shown:
      // deleted, on a drive that isn't there).
      readonly property string chosen: WallpaperService.sourceFor(modelData.name)
      property string broken: ""
      readonly property string shows: chosen !== "" && chosen !== broken ? chosen : root.image ? Theme.wallpaper : ""

      Item {
        id: pic
        anchors.fill: parent
        visible: win.shows !== ""
        readonly property int mode: ({ crop: Image.PreserveAspectCrop, fit: Image.PreserveAspectFit, center: Image.Pad, tile: Image.Tile })[
          win.chosen !== "" ? WallpaperService.fill : "crop"]
        // Two pictures, the new one faded in over the old once it's loaded.
        property bool frontA: true
        readonly property var front: frontA ? imgA : imgB
        readonly property var back: frontA ? imgB : imgA

        // The one wanted goes behind and comes to the front once loaded;
        // wanted again while in front, anything loading behind is dropped
        // (it would arrive late and take its place).
        property string wanted: ""
        function load(path) {
          wanted = WallpaperService.url(path)
          if (front.source.toString() === wanted) {
            back.source = ""
            return
          }
          if (back.source.toString() === wanted && back.status === Image.Ready) {
            frontA = !frontA
            return
          }
          back.source = wanted
        }
        function arrived(img) {
          if (img.source.toString() !== wanted) return
          if (img === back && img.status === Image.Ready) frontA = !frontA
          if (img.status === Image.Error) win.broken = win.chosen
        }
        Component.onCompleted: {
          wanted = WallpaperService.url(win.shows)
          imgA.source = wanted
        }

        Image {
          id: imgA
          anchors.fill: parent
          fillMode: pic.mode
          asynchronous: true
          cache: false
          opacity: pic.frontA ? 1 : 0
          Behavior on opacity { NumberAnimation { duration: Theme.motion ? 450 : 0 } }
          onStatusChanged: pic.arrived(imgA)
        }
        Image {
          id: imgB
          anchors.fill: parent
          fillMode: pic.mode
          asynchronous: true
          cache: false
          opacity: pic.frontA ? 0 : 1
          Behavior on opacity { NumberAnimation { duration: Theme.motion ? 450 : 0 } }
          onStatusChanged: pic.arrived(imgB)
        }

        // Tinted with the theme: the picture in the accent's hue, a little
        // darker in a dark theme, so it belongs to the rest.
        layer.enabled: win.chosen !== "" && WallpaperService.tint > 0
        layer.effect: MultiEffect {
          colorization: WallpaperService.tint
          colorizationColor: Theme.accent
          brightness: Theme.mode === "dark" ? -0.15 * WallpaperService.tint : 0.05 * WallpaperService.tint
        }
      }
      onShowsChanged: pic.load(shows)
      onChosenChanged: broken = ""

      // Dark: the floor.
      Item {
        id: floor
        anchors.fill: parent
        visible: win.shows === "" && Theme.wallpaper === "grid" && Theme.mode === "dark"
        readonly property real horizon: height * 0.62

        // Sky: bg_alt, deepening into the accent's dark tint at the horizon.
        Rectangle {
          width: parent.width
          height: floor.horizon
          gradient: Gradient {
            GradientStop { position: 0; color: Theme.bgAlt }
            GradientStop { position: 1; color: Qt.tint(Theme.bgAlt, Qt.alpha(Theme.accentDeep, 0.9)) }
          }
        }
        // Ground: from the tint back into bg_alt.
        Rectangle {
          y: floor.horizon
          width: parent.width
          height: parent.height - floor.horizon
          gradient: Gradient {
            GradientStop { position: 0; color: Qt.tint(Theme.bgAlt, Qt.alpha(Theme.accentDeep, 0.7)) }
            GradientStop { position: 1; color: Theme.bgAlt }
          }
        }

        // Lines across, closer together toward the horizon.
        Repeater {
          model: 14
          Rectangle {
            required property int index
            readonly property real t: (index + 1) / 14
            y: floor.horizon + (floor.height - floor.horizon) * t * t
            width: floor.width
            height: 1
            color: Theme.accent
            opacity: 0.06 + 0.16 * t
          }
        }

        // Lines into the distance, from the vanishing point.
        Repeater {
          model: 25
          Rectangle {
            required property int index
            readonly property real dx: (index - 12) * floor.width * 0.16
            readonly property real dy: floor.height - floor.horizon
            x: floor.width / 2
            y: floor.horizon
            width: 1
            height: Math.sqrt(dx * dx + dy * dy)
            transformOrigin: Item.Top
            rotation: -Math.atan2(dx, dy) * 180 / Math.PI
            gradient: Gradient {
              GradientStop { position: 0; color: "transparent" }
              GradientStop { position: 1; color: Qt.alpha(Theme.accent, 0.22) }
            }
          }
        }

        // The horizon, glowing.
        Rectangle {
          y: floor.horizon - 90
          width: parent.width
          height: 90
          gradient: Gradient {
            GradientStop { position: 0; color: "transparent" }
            GradientStop { position: 1; color: Qt.alpha(Theme.accent, 0.08) }
          }
        }
        Rectangle {
          y: floor.horizon
          width: parent.width
          height: 1
          color: Qt.alpha(Theme.accentText, 0.35)
        }
{{- if settings.scanlines }}

        // CRT scanlines.
        Column {
          anchors.fill: parent
          Repeater {
            model: Math.ceil(floor.height / 3)
            Item {
              width: floor.width
              height: 3
              Rectangle { width: parent.width; height: 1; color: Qt.alpha("black", 0.18) }
            }
          }
        }
{{- end }}
      }

      // Light: graph paper.
      Item {
        anchors.fill: parent
        visible: win.shows === "" && Theme.wallpaper === "grid" && Theme.mode === "light"
        readonly property int step: 28

        Repeater {
          model: Math.ceil(win.height / 28)
          Rectangle {
            required property int index
            y: index * 28
            width: win.width
            height: 1
            color: Theme.border
            opacity: index % 5 === 0 ? 0.9 : 0.4
          }
        }
        Repeater {
          model: Math.ceil(win.width / 28)
          Rectangle {
            required property int index
            x: index * 28
            width: 1
            height: win.height
            color: Theme.border
            opacity: index % 5 === 0 ? 0.9 : 0.4
          }
        }
      }
    }
  }
}
