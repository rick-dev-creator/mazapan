// Generated by myarch (plugin {{ plugin }}).
//
// What each screen shows, shared by the wallpaper itself and the picker:
// the theme's own (drawn from its colors, or its picture), or one of your
// pictures, on every screen or one per screen; how it fills the screen;
// tinted with the theme or not; your folder in turn, every so often; and a
// picture with a day and a night version (name-day.jpg, name-night.jpg)
// following the time. Kept in ~/.local/state/myarch-wallpaper/state.json:
// changing it reloads nothing.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
  id: root

  readonly property string home: Quickshell.env("HOME")
  readonly property string folder: {{ quote settings.folder }}.replace(/^~(?=\/|$)/, home)
  readonly property string dir: home + "/.local/state/myarch-wallpaper"
  readonly property string dayFrom: {{ quote settings.day_from }}
  readonly property string nightFrom: {{ quote settings.night_from }}

  // Your pictures (the folder, and one level of folders in it).
  property var images: []
  property bool listed: false

  // As chosen: image for every screen ("" = the theme's), or one per
  // screen ("theme" = the theme's on that one); fill: crop, fit, center or
  // tile; tint 0..1; rotate: minutes between pictures (0: never), counted
  // since the time kept (a reload or a login doesn't start it again).
  property string image: ""
  property var screens: ({})
  property string fill: "crop"
  property real tint: 0
  property int rotate: 0
  property int turn: 0
  property double since: 0
  property bool loaded: false

  // The picker's preview: what the pointer is on ("" none, "theme" the
  // theme's own), on which screen ("" every one).
  property string preview: ""
  property string previewScreen: ""

  // Now: day or night, for pictures that have both.
  property bool night: false

  // --- what a screen shows ------------------------------------------------------

  // The picture a screen shows; "" for the theme's own.
  function sourceFor(screen) {
    if (preview !== "" && (previewScreen === "" || previewScreen === screen))
      return preview === "theme" ? "" : dayOrNight(preview)
    if (screens[screen]) return screens[screen] === "theme" ? "" : dayOrNight(screens[screen])
    const list = order()
    if (rotate > 0 && list.length > 0) return dayOrNight(list[turn % list.length])
    return image !== "" ? dayOrNight(image) : ""
  }

  // A path as a URL: "sunset #2.jpg" is a file, not a fragment.
  function url(path) {
    return path === "" ? "" : "file://" + path.split("/").map(encodeURIComponent).join("/")
  }

  // name-day.jpg and name-night.jpg (or -light/-dark): one picture, two
  // times of day. Either name picks the pair.
  function pairOf(path) {
    const m = /^(.*)[-_](day|light|night|dark)(\.[^./]+)$/i.exec(path)
    if (!m) return null
    // Sea-Day.jpg and sea-night.JPG are a pair too.
    const base = m[1].toLowerCase()
    const find = words => images.find(p => {
      const n = /^(.*)[-_](day|light|night|dark)(\.[^./]+)$/i.exec(p)
      return n && n[1].toLowerCase() === base && words.includes(n[2].toLowerCase())
    }) || ""
    const day = find(["day", "light"]), nightOne = find(["night", "dark"])
    return day !== "" && nightOne !== "" ? { day: day, night: nightOne } : null
  }

  function dayOrNight(path) {
    const p = pairOf(path)
    return p ? (night ? p.night : p.day) : path
  }

  // The folder in turn: each pair once (its day picture stands for it).
  function order() {
    return images.filter(p => {
      const pair = pairOf(p)
      return !pair || pair.day === p
    })
  }

  // --- choosing -----------------------------------------------------------------

  // A picture ("" the theme's) for every screen, or for one (which then
  // keeps it, whatever the others do).
  function choose(path, screen) {
    if (screen) {
      const next = Object.assign({}, screens)
      next[screen] = path === "" ? "theme" : path
      screens = next
    } else {
      image = path
      screens = {}
      rotate = 0 // a choice for all ends the turns
    }
    save()
  }

  function setFill(v) { fill = v; save() }
  function setTint(v) { tint = v; save() }
  function setRotate(minutes) {
    rotate = minutes
    since = Date.now()
    if (minutes > 0) screens = {}
    save()
  }

  function next() {
    const list = order()
    if (list.length === 0) return
    if (rotate > 0) {
      turn = (turn + 1) % list.length
      since = Date.now()
    } else {
      // The chosen one as its pair's day picture, to find it in the list.
      const pair = pairOf(image)
      const i = list.indexOf(pair ? pair.day : image)
      image = list[(i + 1) % list.length]
      screens = {}
    }
    save()
  }

  // Turns due since the time kept: as many as have passed.
  function catchUp() {
    if (rotate <= 0 || images.length < 2) return
    const due = Math.floor((Date.now() - since) / (rotate * 60000))
    if (due < 1) return
    turn = (turn + due) % Math.max(1, order().length)
    since += due * rotate * 60000
    save()
  }

  // --- keeping it ---------------------------------------------------------------

  property string written: ""

  function save() {
    written = JSON.stringify({ version: 1, image: image, screens: screens, fill: fill, tint: tint, rotate: rotate, turn: turn, since: since })
    store.setText(written)
  }

  FileView {
    id: store
    path: root.dir + "/state.json"
    watchChanges: true
    atomicWrites: true
    // Small, and read before the first frame: no flash of the theme's own
    // before yours at every reload.
    blockLoading: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: {
      if (text() === root.written) return
      try {
        const o = JSON.parse(text())
        root.image = typeof o.image === "string" ? o.image : ""
        root.screens = o.screens && typeof o.screens === "object" ? o.screens : {}
        root.fill = ["crop", "fit", "center", "tile"].includes(o.fill) ? o.fill : "crop"
        root.tint = typeof o.tint === "number" ? Math.max(0, Math.min(1, o.tint)) : 0
        root.rotate = typeof o.rotate === "number" ? Math.max(0, o.rotate) : 0
        root.turn = typeof o.turn === "number" ? o.turn : 0
        root.since = typeof o.since === "number" ? o.since : Date.now()
      } catch (e) {} // unreadable: the theme's, until a choice writes it again
      root.loaded = true
      root.catchUp()
    }
    onLoadFailed: root.loaded = true
  }

  Component.onCompleted: {
    Quickshell.execDetached(["mkdir", "-p", root.dir])
    list()
  }

  // Your pictures, found again when the picker opens.
  function list() {
    if (!lister.running) lister.running = true
  }

  Process {
    id: lister
    command: ["sh", "-c", 'find -L "$0" -maxdepth 2 -type f \\( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \\) 2>/dev/null | sort', root.folder]
    stdout: StdioCollector {
      onStreamFinished: {
        const found = text.split("\n").filter(l => l !== "")
        // A new list only when it's another: the picker's grid keeps its place.
        if (JSON.stringify(found) !== JSON.stringify(root.images)) root.images = found
        root.listed = true
        root.catchUp()
      }
    }
  }

  // --- time ---------------------------------------------------------------------

  function minutes(s) {
    const m = /^([01]?\d|2[0-3]):([0-5]\d)$/.exec(String(s).trim())
    return m ? Number(m[1]) * 60 + Number(m[2]) : -1
  }

  function isNight() {
    const d = new Date(), now = d.getHours() * 60 + d.getMinutes()
    const day = minutes(dayFrom), eve = minutes(nightFrom)
    if (day < 0 || eve < 0 || day === eve) return false
    return day < eve ? now < day || now >= eve : now >= eve && now < day
  }

  Timer {
    interval: 60000
    running: true
    repeat: true
    triggeredOnStart: true
    onTriggered: root.night = root.isNight()
  }

  // The folder in turn: looked at every minute, turned when it's due.
  Timer {
    interval: 60000
    running: root.rotate > 0 && root.images.length > 1
    repeat: true
    onTriggered: root.catchUp()
  }

  // qs ipc -c myarch call wallpaper next
  IpcHandler {
    target: "wallpaper"
    function next(): void { root.next() }
    function set(path: string): void { root.choose(path, "") }
    function theme(): void { root.choose("", "") }
  }
}
