// Generated by mazapan (plugin {{ plugin }}).
//
// The wallpaper picker: the theme's own and your pictures, as thumbnails;
// the one under the pointer (or the keys) is on the desktop at once,
// behind the picker; a click keeps it, on every screen or on one. Below:
// how it fills the screen, tinted with the theme or not, a new one every
// so often; and a theme made from the picture.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/wallpaper"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  // Chosen for: "" every screen, or a screen's name.
  property string target: ""
  // Under the pointer ("" when it's off the grid), and where the keys are:
  // "Theme from this picture" takes the first, or else the second.
  property string looked: ""
  property string keyed: ""
  readonly property string target2: looked !== "" ? looked : keyed

  readonly property var tiles: ["theme"].concat(WallpaperService.order())
  // What's chosen now, for the target: a path, "theme", or "rotate".
  readonly property string current: {
    const s = WallpaperService
    if (target !== "" && s.screens[target]) return s.screens[target]
    if (s.rotate > 0) return "rotate"
    return s.image !== "" ? s.image : "theme"
  }

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    WallpaperService.list()
    looked = ""
    open = true
    placeKeys(current)
    Qt.callLater(() => grid.forceActiveFocus())
  }

  function close() {
    open = false
    WallpaperService.preview = ""
  }

  // The keys on a tile, without previewing it (opening, the list found
  // again): only moving them previews.
  property bool placing: false
  function placeKeys(path) {
    placing = true
    grid.currentIndex = Math.max(0, tiles.indexOf(path))
    keyed = tiles[grid.currentIndex] || ""
    placing = false
  }
  onTilesChanged: if (open) Qt.callLater(() => placeKeys(keyed))

  function look(path) {
    WallpaperService.previewScreen = target
    WallpaperService.preview = path
  }

  function pick(path) {
    WallpaperService.choose(path === "theme" ? "" : path, target)
    WallpaperService.preview = ""
  }

  function name(path) {
    if (path === "theme") return {{ tq "from_theme" }}
    const base = path.split("/").pop().replace(/\.[^.]+$/, "")
    return WallpaperService.pairOf(path) ? base.replace(/[-_](day|light)$/i, "") : base
  }

  // The theme mazapan names after a picture: "sunset_over-the lake" is
  // "Sunset over the lake".
  function readable(path) {
    const s = path.split("/").pop().replace(/\.[^.]+$/, "").replace(/[-_]+/g, " ").trim()
    return s === "" ? path : s[0].toUpperCase() + s.slice(1)
  }

  // The picture's colors, a theme of their own, in use: mazapan does it
  // (contrast checked, detached: applying reloads the shell, this panel
  // too). Only when it's done is the wallpaper the theme's (this picture);
  // a failure leaves everything as it was, and says why.
  function themeFrom(path) {
    if (path === "" || path === "theme" || path === "rotate") return
    Quickshell.execDetached(["sh", "-c",
      'log="$HOME/.local/state/mazapan-wallpaper/theme.log"; '
      + 'if mazapan themes from-image "$0" --apply > "$log" 2>&1; then '
      + 'qs ipc -c mazapan call wallpaper theme >/dev/null 2>&1; sleep 2; notify-send -a "$1" -i "$0" "$2" "$4"; '
      + 'else notify-send -a "$1" -u critical "$3" "$(tail -n 2 "$log")"; fi',
      path, {{ tq "title" }}, {{ tq "theme_made" }}, {{ tq "theme_failed" }}, {{ tq "theme_made_body" }}.arg(readable(path))])
    close()
  }

  // A small choice.
  component Chip: Rectangle {
    id: chip
    property string text: ""
    property bool on: false
    signal clicked()
    implicitWidth: chipText.implicitWidth + 14
    implicitHeight: 24
    radius: Theme.radius
    color: on ? Theme.accent : ca.containsMouse ? Theme.surface : "transparent"
    border.color: on ? Theme.accent : Theme.border
    border.width: 1
    Label {
      id: chipText
      anchors.centerIn: parent
      text: chip.text
      color: chip.on ? Theme.accentFg : Theme.fgMuted
    }
    MouseArea {
      id: ca
      anchors.fill: parent
      hoverEnabled: true
      cursorShape: Qt.PointingHandCursor
      onClicked: chip.clicked()
    }
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: Math.min(1060, (screen ? screen.width : 1280) * 0.9)
    implicitHeight: Math.min(660, (screen ? screen.height : 900) * 0.8)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-wallpapers"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      anchors.fill: parent
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius

      ColumnLayout {
        anchors.fill: parent
        anchors.margins: 16
        spacing: 12

        RowLayout {
          Layout.fillWidth: true
          spacing: 6
          Caption { text: {{ tq "title" }}.toUpperCase() }
          Item { Layout.fillWidth: true }
          // One screen or all of them (more than one screen only).
          Repeater {
            model: Quickshell.screens.length > 1 ? [""].concat(Quickshell.screens.map(s => s.name)) : []
            Chip {
              required property string modelData
              text: modelData === "" ? {{ tq "all_screens" }} : modelData
              on: root.target === modelData
              onClicked: root.target = modelData
            }
          }
        }

        GridView {
          id: grid
          Layout.fillWidth: true
          Layout.fillHeight: true
          clip: true
          readonly property int columns: Math.max(2, Math.floor(width / 240))
          cellWidth: Math.floor(width / columns)
          cellHeight: Math.round(cellWidth * 9 / 16) + 30
          model: root.tiles
          boundsBehavior: Flickable.StopAtBounds
          focus: true
          keyNavigationEnabled: true
          // The keys preview as the pointer does.
          onCurrentIndexChanged: {
            if (root.placing || currentIndex < 0) return
            root.keyed = root.tiles[currentIndex] || ""
            if (activeFocus) root.look(root.keyed)
          }

          Keys.onReturnPressed: root.pick(root.tiles[currentIndex])
          Keys.onEnterPressed: root.pick(root.tiles[currentIndex])
          Keys.onEscapePressed: root.close()
          Keys.onPressed: event => {
            if (event.key === Qt.Key_T) {
              root.themeFrom(root.keyed)
              event.accepted = true
            }
          }

          delegate: Item {
            id: tile
            required property string modelData
            required property int index
            readonly property bool chosen: root.current === modelData
            readonly property bool looked: area.containsMouse || (root.looked === "" && root.keyed === modelData)
            width: grid.cellWidth
            height: grid.cellHeight

            Rectangle {
              id: frame
              x: 6
              y: 6
              width: parent.width - 12
              height: parent.height - 36
              radius: Theme.radius
              color: Theme.bgAlt
              border.width: tile.chosen ? 3 : tile.looked ? 2 : 1
              border.color: tile.chosen ? Theme.accent : tile.looked ? Theme.accentText : Theme.border
              clip: true

              Image {
                anchors.fill: parent
                anchors.margins: parent.border.width
                visible: tile.modelData !== "theme" || (Theme.wallpaper !== "grid" && Theme.wallpaper !== "plain")
                source: tile.modelData === "theme"
                  ? (visible ? WallpaperService.url(Theme.wallpaper) : "")
                  : WallpaperService.url(tile.modelData)
                sourceSize.width: 480
                fillMode: Image.PreserveAspectCrop
                asynchronous: true
              }
              // The theme's own, drawn: its colors as a small scene.
              Column {
                anchors.centerIn: parent
                visible: tile.modelData === "theme" && (Theme.wallpaper === "grid" || Theme.wallpaper === "plain")
                spacing: 4
                Glyph {
                  anchors.horizontalCenter: parent.horizontalCenter
                  text: String.fromCodePoint(0xF03D8)
                  color: Theme.accentText
                  font.pointSize: 22
                }
                Caption {
                  anchors.horizontalCenter: parent.horizontalCenter
                  text: Theme.wallpaper === "grid" ? {{ tq "drawn" }} : {{ tq "plain" }}
                }
              }
              // Two times of day.
              Rectangle {
                visible: tile.modelData !== "theme" && WallpaperService.pairOf(tile.modelData) !== null
                anchors.right: parent.right
                anchors.top: parent.top
                anchors.margins: 6
                implicitWidth: pairGlyph.implicitWidth + 8
                implicitHeight: pairGlyph.implicitHeight + 4
                radius: Theme.radius
                color: Qt.alpha(Theme.bg, 0.8)
                Glyph {
                  id: pairGlyph
                  anchors.centerIn: parent
                  text: String.fromCodePoint(0xF0599) + " " + String.fromCodePoint(0xF0594) // sun, moon
                  color: Theme.fg
                  font.pointSize: 9
                }
              }
            }

            Label {
              anchors.top: frame.bottom
              anchors.topMargin: 4
              anchors.left: frame.left
              width: frame.width
              text: root.name(tile.modelData)
              color: tile.chosen ? Theme.accentText : Theme.fgMuted
              elide: Text.ElideRight
            }

            // The pointer previews without moving the keys' place (which
            // would scroll the grid under it).
            MouseArea {
              id: area
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onEntered: {
                root.looked = tile.modelData
                root.look(tile.modelData)
              }
              onClicked: root.pick(tile.modelData)
            }
          }

          // Off the grid: back to what's chosen, and to where the keys are.
          HoverHandler {
            onHoveredChanged: if (!hovered) {
              root.looked = ""
              WallpaperService.preview = ""
            }
          }
        }

        // No pictures yet.
        RowLayout {
          visible: WallpaperService.listed && WallpaperService.images.length === 0
          Layout.fillWidth: true
          Label {
            text: {{ tq "empty" }}.arg(WallpaperService.folder.replace(Quickshell.env("HOME"), "~"))
            color: Theme.fgMuted
            wrapMode: Text.Wrap
            Layout.fillWidth: true
            Layout.preferredWidth: 0
          }
        }

        Rule {}

        // How, and what else.
        Flow {
          Layout.fillWidth: true
          spacing: 6

          Caption { text: {{ tq "fill" }}; height: 24; verticalAlignment: Text.AlignVCenter }
          Repeater {
            model: [["crop", {{ tq "fill.crop" }}], ["fit", {{ tq "fill.fit" }}], ["center", {{ tq "fill.center" }}], ["tile", {{ tq "fill.tile" }}]]
            Chip {
              required property var modelData
              text: modelData[1]
              on: WallpaperService.fill === modelData[0]
              onClicked: WallpaperService.setFill(modelData[0])
            }
          }
          Item { width: 14; height: 1 }
          Caption { text: {{ tq "tint" }}; height: 24; verticalAlignment: Text.AlignVCenter }
          Repeater {
            model: [[0, {{ tq "tint.off" }}], [0.3, {{ tq "tint.subtle" }}], [0.6, {{ tq "tint.strong" }}]]
            Chip {
              required property var modelData
              text: modelData[1]
              on: Math.abs(WallpaperService.tint - modelData[0]) < 0.01
              onClicked: WallpaperService.setTint(modelData[0])
            }
          }
          Item { width: 14; height: 1 }
          Caption { text: {{ tq "rotate" }}; height: 24; verticalAlignment: Text.AlignVCenter }
          Repeater {
            model: [[0, {{ tq "rotate.off" }}], [15, {{ tq "rotate.15m" }}], [60, {{ tq "rotate.1h" }}], [1440, {{ tq "rotate.1d" }}]]
            Chip {
              required property var modelData
              text: modelData[1]
              on: WallpaperService.rotate === modelData[0]
              onClicked: WallpaperService.setRotate(modelData[0])
            }
          }
        }

        RowLayout {
          Layout.fillWidth: true
          spacing: 8
          Caption {
            text: {{ tq "hints" }}
            elide: Text.ElideRight
            Layout.fillWidth: true
          }
          Button {
            text: {{ tq "open_folder" }}
            onClicked: Quickshell.execDetached(["sh", "-c", 'mkdir -p "$0" && xdg-open "$0"', WallpaperService.folder])
          }
          // Which picture, said: the pointer can cross others on its way.
          Button {
            readonly property string at: root.target2
            enabled: at !== "" && at !== "theme"
            opacity: enabled ? 1 : 0.5
            text: enabled ? {{ tq "theme_from_named" }}.arg(root.name(at)) : {{ tq "theme_from" }}
            primary: true
            onClicked: root.themeFrom(at)
          }
        }
      }
    }
  }
}
