// Generated by mazapan (plugin {{ plugin }}).
//
// The emoji picker: every emoji, by category, found by its name in your
// language (and in English; accents or not); the ones you used last
// first. A click or ↵
// types it where you were (and copies it; only copies, with type off).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  property string query: ""
  property string group: "recent"

  // [{e, g, name, words}] from emoji.tsv (Unicode's emoji, CLDR's names).
  property var all: []
  // The ones used, most recent first.
  property var recent: []

  readonly property string home: Quickshell.env("HOME")
  // emoji.tsv: the emoji, its group, then a name and words for each of
  // these languages (CLDR's): English's always searched, and the desktop's.
  readonly property var languages: ["en", "es", "pt", "fr", "de"]
  readonly property int lang: Math.max(0, languages.indexOf("{{ lang_code }}".split("_")[0]))
  readonly property var groups: [
    ["recent", 0xF02DA], ["smileys", 0xF01F5], ["people", 0xF0004], ["nature", 0xF032A], ["food", 0xF025A],
    ["travel", 0xF010B], ["activities", 0xF0806], ["objects", 0xF0335], ["symbols", 0xF02D5], ["flags", 0xF023B],
  ]

  // Lower case, without accents: "corazon" finds "corazón".
  function fold(s) {
    return String(s).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
  }

  readonly property var shown: {
    const words = fold(query).split(/\s+/).filter(w => w !== "")
    if (words.length > 0) {
      const q = words.join(" ")
      return all.filter(x => words.every(w => x.words.includes(w)))
        .map((x, i) => ({ x: x, i: i, s: score(x, q, words) }))
        .sort((a, b) => b.s - a.s || a.i - b.i)
        .slice(0, 400).map(o => o.x)
    }
    if (group === "recent") return recent.map(e => all.find(x => x.e === e)).filter(x => x)
    return all.filter(x => x.g === group)
  }
  // Named that first, then a word of its name, then in its name, then
  // only among its keywords; Unicode's order among equals.
  function score(x, q, words) {
    if (x.names.includes("|" + q + "|")) return 1000
    let s = 0
    for (const w of words) s += x.nameWords.includes(w) ? 10 : x.names.includes(w) ? 3 : 0
    // Among equals, the shorter name: "red heart" before "smiling cat
    // with heart-eyes".
    return s > 0 ? s - x.nameWords.length / 100 : 0
  }

  property int current: 0
  readonly property var hovered: shown[current] || null
  onShownChanged: current = Math.max(0, Math.min(current, shown.length - 1))

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    search.text = ""
    group = recent.length > 0 ? "recent" : "smileys"
    current = 0
    open = true
    Qt.callLater(() => search.focusInput())
  }

  function close() { open = false }

  // Typed where you were (the picker closed first), and copied.
  function pick(x) {
    if (!x) return
    close()
    recent = [x.e].concat(recent.filter(e => e !== x.e)).slice(0, {{ settings.recent }})
    recentFile.setText(JSON.stringify(recent))
{{- if settings.type }}
    Quickshell.execDetached(["sh", "-c", 'printf %s "$0" | wl-copy; sleep 0.15; command -v wtype >/dev/null && wtype -- "$0"', x.e])
{{- else }}
    Quickshell.execDetached(["sh", "-c", 'printf %s "$0" | wl-copy', x.e])
{{- end }}
  }

  FileView {
    path: root.home + "/.local/share/mazapan-emoji/emoji.tsv"
    onLoaded: {
      const list = []
      for (const line of text().split("\n")) {
        const f = line.split("\t")
        if (f.length < 4) continue
        const own = f[2 + 2 * root.lang] || "", ownWords = f[3 + 2 * root.lang] || ""
        const name = own || f[2]
        const names = root.fold("|" + f[2] + "|" + own + "|")
        list.push({ e: f[0], g: f[1], name: name, names: names, nameWords: names.split(/[|\s]+/),
          words: root.fold(f[2] + " " + f[3] + " " + own + " " + ownWords) })
      }
      root.all = list
    }
  }

  FileView {
    id: recentFile
    path: root.home + "/.local/state/mazapan-emoji/recent.json"
    atomicWrites: true
    printErrors: false
    onLoaded: {
      try {
        const r = JSON.parse(text())
        if (Array.isArray(r)) root.recent = r.filter(e => typeof e === "string").slice(0, {{ settings.recent }})
      } catch (e) {}
    }
  }
  Component.onCompleted: Quickshell.execDetached(["mkdir", "-p", root.home + "/.local/state/mazapan-emoji"])

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: 520
    implicitHeight: 470
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-emoji"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      anchors.fill: parent
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius

      ColumnLayout {
        anchors.fill: parent
        anchors.margins: 14
        spacing: 10

        TextField {
          id: search
          Layout.fillWidth: true
          placeholder: {{ tq "search" }}
          onTextChanged: {
            root.query = text
            root.current = 0
          }
          onAccepted: root.pick(root.hovered)
          Keys.onPressed: event => {
            const n = root.shown.length, cols = grid.columns
            const to = i => Math.max(0, Math.min(n - 1, i))
            if (event.key === Qt.Key_Right) root.current = to(root.current + 1)
            else if (event.key === Qt.Key_Left) root.current = to(root.current - 1)
            else if (event.key === Qt.Key_Down) root.current = to(root.current + cols)
            else if (event.key === Qt.Key_Up) root.current = to(root.current - cols)
            // The next category (back with Shift); not while searching.
            else if ((event.key === Qt.Key_Tab || event.key === Qt.Key_Backtab) && root.query === "") {
              const i = root.groups.findIndex(g => g[0] === root.group)
              const step = event.key === Qt.Key_Backtab ? root.groups.length - 1 : 1
              root.group = root.groups[(i + step) % root.groups.length][0]
              root.current = 0
            } else if (event.key === Qt.Key_Tab || event.key === Qt.Key_Backtab) {}
            else if (event.key === Qt.Key_Escape) root.close()
            else return
            event.accepted = true
          }
        }

        // Categories (while not searching).
        Row {
          visible: root.query === ""
          spacing: 2
          Repeater {
            model: root.groups
            Rectangle {
              required property var modelData
              width: 44
              height: 30
              radius: Theme.radius
              color: root.group === modelData[0] ? Theme.selection : ga.containsMouse ? Theme.surface : "transparent"
              Glyph {
                anchors.centerIn: parent
                text: String.fromCodePoint(modelData[1])
                color: root.group === modelData[0] ? Theme.accentText : Theme.fgMuted
                font.pointSize: 12
              }
              MouseArea {
                id: ga
                anchors.fill: parent
                hoverEnabled: true
                cursorShape: Qt.PointingHandCursor
                onClicked: {
                  root.group = modelData[0]
                  root.current = 0
                  search.focusInput()
                }
              }
            }
          }
        }

        GridView {
          id: grid
          Layout.fillWidth: true
          Layout.fillHeight: true
          clip: true
          readonly property int columns: Math.max(1, Math.floor(width / cellWidth))
          cellWidth: 46
          cellHeight: 46
          model: root.shown
          currentIndex: root.current
          boundsBehavior: Flickable.StopAtBounds
          delegate: Rectangle {
            id: cell
            required property var modelData
            required property int index
            width: 44
            height: 44
            radius: Theme.radius
            color: index === root.current ? Theme.selection : "transparent"
            Text {
              anchors.centerIn: parent
              text: cell.modelData.e
              font.family: "Noto Color Emoji"
              font.pointSize: 20
              color: Theme.fg
              textFormat: Text.PlainText
            }
            MouseArea {
              anchors.fill: parent
              hoverEnabled: true
              cursorShape: Qt.PointingHandCursor
              onEntered: root.current = cell.index
              onClicked: root.pick(cell.modelData)
            }
          }

          Label {
            anchors.centerIn: parent
            visible: root.shown.length === 0
            text: root.group === "recent" && root.query === "" ? {{ tq "no_recent" }} : {{ tq "none" }}
            color: Theme.fgSubtle
          }
        }

        // What the one under the pointer (or the keys) is called.
        RowLayout {
          Layout.fillWidth: true
          spacing: 10
          Text {
            text: root.hovered ? root.hovered.e : ""
            font.family: "Noto Color Emoji"
            font.pointSize: 18
            color: Theme.fg
            textFormat: Text.PlainText
          }
          Label {
            text: root.hovered ? root.hovered.name : ""
            elide: Text.ElideRight
            Layout.fillWidth: true
          }
{{- if settings.type }}
          Caption { text: {{ tq "hints" }} }
{{- else }}
          Caption { text: {{ tq "hints.copy" }} }
{{- end }}
        }
      }
    }
  }
}
