# Generated by mazapan (plugin {{ plugin }}): volume in software for every
# ALSA card on this ASUS ROG laptop. The Realtek codec's hardware mixer has
# quirks (muffled speakers); the soft mixer leaves it alone.
monitor.alsa.rules = [
  {
    matches = [
      {
        device.name = "~alsa_card.*"
      }
    ]
    actions = {
      update-props = {
        api.alsa.soft-mixer = true
      }
    }
  }
]
