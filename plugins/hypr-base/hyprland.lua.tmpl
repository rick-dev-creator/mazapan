-- Generated by myarch (plugin {{ plugin }}). Edits are overwritten on the
-- next `myarch apply`; change the plugin or add your own plugin instead.

hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })

-- Flatpak's apps where launchers look, from the start: one installed
-- later shows right away, not after logging in again.
do
  local ok, data, home = pcall(function() return os.getenv("XDG_DATA_DIRS"), os.getenv("HOME") end)
  if ok then
    data = (data and data ~= "") and data or "/usr/local/share:/usr/share"
    for _, d in ipairs({ (home or "") .. "/.local/share/flatpak/exports/share", "/var/lib/flatpak/exports/share" }) do
      if not data:find(d, 1, true) then data = data .. ":" .. d end
    end
    hl.env("XDG_DATA_DIRS", data)
  end
end

hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")

hl.config({
  input = {
    -- The keyboard (xkb): layouts, their variants, options (a key to switch between layouts).
    kb_layout = {{ lq settings.kb_layout }},
    kb_variant = {{ lq settings.kb_variant }},
    kb_options = {{ lq settings.kb_options }},
    follow_mouse = 1,
    sensitivity = {{ num settings.pointer_speed }},
    touchpad = {
      tap_to_click = {{ settings.tap_to_click }},
      natural_scroll = {{ settings.natural_scroll }},
      disable_while_typing = {{ settings.disable_while_typing }},
    },
  },
  -- Hyprland's own "updated" and donation windows: the desktop says what's new itself.
  ecosystem = {
    no_update_news = true,
    no_donation_nag = true,
  },
  misc = {
    force_default_wallpaper = 0,
    disable_hyprland_logo = true,
    disable_splash_rendering = true,
  },
  dwindle = {
    preserve_split = true,
  },
})

local terminal = "foot"
local mod = "SUPER"

hl.bind(mod .. " + Return", hl.dsp.exec_cmd(terminal))
-- Close: the shell's open panel if there is one (the monitor manager…),
-- else the window. A panel isn't a window: without this, SUPER + Q would
-- close whatever window sits behind it.
hl.bind(mod .. " + Q", function()
  for _, l in ipairs(hl.get_layers()) do
    if (l.namespace or ""):match("^myarch%-panel%-") then
      hl.dispatch(hl.dsp.exec_cmd("qs ipc -c myarch call myarch close"))
      return
    end
  end
  hl.dispatch(hl.dsp.window.close())
end)
hl.bind(mod .. " + V", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mod .. " + J", hl.dsp.layout("togglesplit"))
hl.bind(mod .. " + SHIFT + E", hl.dsp.exec_cmd("hyprctl dispatch 'hl.dsp.exit()'"))

hl.bind(mod .. " + left",  hl.dsp.focus({ direction = "left" }))
hl.bind(mod .. " + right", hl.dsp.focus({ direction = "right" }))
hl.bind(mod .. " + up",    hl.dsp.focus({ direction = "up" }))
hl.bind(mod .. " + down",  hl.dsp.focus({ direction = "down" }))

for i = 1, 10 do
  local key = i % 10
  hl.bind(mod .. " + " .. key,         hl.dsp.focus({ workspace = i }))
  hl.bind(mod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }))
end

-- Fragments from the other plugins. Each one is loaded on its own so a
-- broken plugin can't keep the rest from loading; its error is raised at the
-- end, where Hyprland shows it.
local failed = {}
for _, path in ipairs({
{{- for file in under "~/.config/hypr/myarch/" }}
  "{{ file }}",
{{- end }}
}) do
  local ok, err = pcall(dofile, path)
  if not ok then table.insert(failed, tostring(err)) end
end
if #failed > 0 then
  error("myarch: plugin fragments failed:\n" .. table.concat(failed, "\n"))
end
