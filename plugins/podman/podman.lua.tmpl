-- Generated by mazapan (plugin {{ plugin }}): what looks for Docker finds Podman
-- (Testcontainers, devcontainers, Compose, Aspire): its socket, for
-- everything started from the desktop.
{{- if (under "/etc/systemd/system/docker.socket.d/").size > 0 }}
-- Docker itself is on (the docker plugin): its own socket is the one used.
{{- else }}
hl.env("DOCKER_HOST", "unix://" .. (os.getenv("XDG_RUNTIME_DIR") or "/run/user/1000") .. "/podman/podman.sock")
-- Testcontainers' reaper (Ryuk) wants a socket it can't have rootless: off;
-- test containers still go when the test ends.
hl.env("TESTCONTAINERS_RYUK_DISABLED", "true")
{{- end }}
