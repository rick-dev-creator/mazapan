// Generated by myarch (plugin {{ plugin }}).
//
// Updates when the minute changes, not every second. A click opens a card
// with the time (seconds tick only while it's open), the full date and the
// month; ‹ ›, the arrow keys or the wheel change month. Formats, month and
// day names come from the system's language ({{ lang }}).

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"

BarItem {
  id: root

  readonly property var locale: Qt.locale("{{ lang }}")

  open: popup.visible
  onClicked: popup.toggle()

  SystemClock {
    id: clock
    precision: popup.visible ? SystemClock.Seconds : SystemClock.Minutes
  }
{{- if settings.format != "" }}

  Label {
    anchors.verticalCenter: parent.verticalCenter
    text: root.locale.toString(clock.date, {{ quote settings.format }})
    font.pointSize: {{ settings.font_size }}
  }
{{- else }}

  Label {
    anchors.verticalCenter: parent.verticalCenter
    text: root.locale.toString(clock.date, "ddd d MMM")
    color: Theme.fgMuted
    font.pointSize: {{ settings.font_size }}
  }

  Label {
    anchors.verticalCenter: parent.verticalCenter
    text: clock.date.toLocaleTimeString(root.locale, Locale.ShortFormat)
    font.pointSize: {{ settings.font_size }}
    font.bold: true
  }
{{- end }}

  BarPopup {
    id: popup
    owner: root
    cardWidth: 300
    onOpening: month.reset()
    onKey: event => {
      if (event.key === Qt.Key_Left) month.step(-1)
      else if (event.key === Qt.Key_Right) month.step(1)
    }

    WheelHandler {
      onWheel: event => month.step(event.angleDelta.y > 0 ? -1 : 1)
    }

    // Now.
    ColumnLayout {
      spacing: 2
      Text {
        // The language's short time (12h or 24h) with seconds added;
        // the long format would also carry the time zone.
        text: root.locale.toString(clock.date, root.locale.timeFormat(Locale.ShortFormat).replace("mm", "mm:ss"))
        color: Theme.fg
        font.family: Theme.fontMono
        font.pointSize: 22
        font.bold: true
      }
      Text {
        Layout.fillWidth: true
        wrapMode: Text.Wrap
        text: clock.date.toLocaleDateString(root.locale, Locale.LongFormat)
        color: Theme.fgMuted
        font.family: Theme.fontMono
        font.pointSize: 9.5
      }
    }

    Rule {}

    // The month on display and how to move it.
    QtObject {
      id: month
      property int year: 0
      property int index: 0 // 0 = January

      function reset() {
        year = clock.date.getFullYear()
        index = clock.date.getMonth()
      }

      function step(n) {
        const d = new Date(year, index + n, 1)
        year = d.getFullYear()
        index = d.getMonth()
      }

      readonly property bool isCurrent: year === clock.date.getFullYear() && index === clock.date.getMonth()
      // JS counts Sunday as 0, Qt's Locale.Sunday is 7.
      readonly property int firstWeekday: root.locale.firstDayOfWeek % 7
    }

    RowLayout {
      Layout.fillWidth: true
      spacing: 4

      component Nav: Text {
        id: nav
        signal activated
        color: navArea.containsMouse ? Theme.accentText : Theme.fgMuted
        font.family: Theme.fontMono
        font.pointSize: 11
        MouseArea {
          id: navArea
          anchors.fill: parent
          anchors.margins: -6
          hoverEnabled: true
          cursorShape: Qt.PointingHandCursor
          onClicked: nav.activated()
        }
      }

      Nav { text: "‹"; onActivated: month.step(-1) }
      Text {
        Layout.fillWidth: true
        horizontalAlignment: Text.AlignHCenter
        text: `${root.locale.standaloneMonthName(month.index, Locale.LongFormat)} ${month.year}`
        color: Theme.fg
        font.family: Theme.fontMono
        font.pointSize: 10
      }
      Nav { text: "›"; onActivated: month.step(1) }
      Nav {
        visible: !month.isCurrent
        text: {{ tq "today" }}
        font.pointSize: 9
        onActivated: month.reset()
      }
    }

    GridLayout {
      id: grid
      Layout.fillWidth: true
      columns: 7
      rowSpacing: 2
      columnSpacing: 2


      // Weekday initials, starting on the language's first day.
      Repeater {
        model: 7
        Text {
          required property int index
          // Equal preferred widths + fill: seven equal columns.
          Layout.fillWidth: true
          Layout.preferredWidth: 1
          horizontalAlignment: Text.AlignHCenter
          text: root.locale.dayName((month.firstWeekday + index) % 7, Locale.ShortFormat).slice(0, 2)
          color: Theme.fgSubtle
          font.family: Theme.fontMono
          font.pointSize: 8.5
        }
      }

      // Six weeks, so every month fits and the card never changes size.
      Repeater {
        model: 42
        Rectangle {
          required property int index
          readonly property var day: {
            const first = new Date(month.year, month.index, 1)
            const offset = (first.getDay() - month.firstWeekday + 7) % 7
            return new Date(month.year, month.index, 1 - offset + index)
          }
          readonly property bool inMonth: day.getMonth() === month.index
          readonly property bool today: day.toDateString() === clock.date.toDateString()

          Layout.fillWidth: true
          Layout.preferredWidth: 1
          Layout.preferredHeight: 26
          color: today ? Theme.accent : "transparent"

          Text {
            anchors.centerIn: parent
            text: parent.day.getDate()
            color: parent.today ? Theme.accentFg : parent.inMonth ? Theme.fg : Theme.fgSubtle
            font.family: Theme.fontMono
            font.pointSize: 9.5
            font.bold: parent.today
          }
        }
      }
    }
  }
}
