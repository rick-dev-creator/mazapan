-- Generated by mazapan (plugin {{ plugin }}): starts and stops dictation.
hl.bind({{ lq settings.key }}, hl.dsp.exec_cmd("sh ~/.local/share/mazapan/bin/dictate"))
{{- if settings.ask_key != "" }}
-- Asked to a coding agent instead (the Agents plugin's card).
hl.bind({{ lq settings.ask_key }}, hl.dsp.exec_cmd("sh ~/.local/share/mazapan/bin/dictate ask"))
{{- end }}
