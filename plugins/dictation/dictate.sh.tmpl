# Generated by mazapan (plugin {{ plugin }}): dictation. The first press
# listens (pw-record, 16 kHz mono, what whisper.cpp takes); the next one
# stops, writes it down on this computer (whisper-cli) and types it where
# you are (wtype), or copies it. The model is downloaded the first time and
# checked against its known SHA-256.
run="${XDG_RUNTIME_DIR:-/tmp}/mazapan-dictation"
models="${XDG_DATA_HOME:-$HOME/.local/share}/mazapan/whisper"
model={{ shq settings.model }}
lang={{ shq settings.language }}
[ -n "$lang" ] || lang={{ shq lang }}
lang=${lang%%_*} # es_MX: es
title={{ shq (t "title") }}
mkdir -p "$run"

say() { # what [urgency]: one notification, replaced as it goes
  id=$(cat "$run/notice" 2>/dev/null)
  notify-send -a "$title" -i audio-input-microphone -u "${2:-normal}" -p ${id:+-r "$id"} "$1" > "$run/notice.new" 2>/dev/null \
    && mv "$run/notice.new" "$run/notice"
}

# Locked: nothing heard, nothing typed (it would land in the password).
locked() { pgrep -u "$(id -u)" -x hyprlock >/dev/null; }

# Listening: this press stops it and writes it down. Each recording has
# its own file, so one started while the last is being written down
# doesn't lose either. "stop" (the two-minute timer) only ever stops.
pid= heard=
[ -f "$run/pid" ] && read -r pid heard < "$run/pid"
if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
  # TERM, not INT: started in the background by a script, it ignores INT.
  # pw-record finishes the file on either.
  kill -TERM "$pid"
  i=0
  while kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
  kill -KILL "$pid" 2>/dev/null
  rm -f "$run/pid"
  say {{ shq (t "writing") }}
  text=$(whisper-cli -m "$models/ggml-$model.bin" -f "$heard" -l "$lang" -nt -np 2>/dev/null \
    | sed 's/\[[A-Z_ ]*\]//g; s/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' | tr '\n' ' ' | sed 's/[[:space:]]*$//')
  rm -f "$heard"
  if locked; then
    say {{ shq (t "locked") }}
    exit 0
  fi
  if [ -z "$text" ]; then
    say {{ shq (t "nothing") }}
    exit 0
  fi
{{- if settings.type }}
  # Notifications never take the keyboard: it goes to the window you're in.
  wtype -- "$text" || { printf %s "$text" | wl-copy; say {{ shq (t "copied") }}; exit 0; }
  say {{ shq (t "typed") }}
{{- else }}
  printf %s "$text" | wl-copy
  say {{ shq (t "copied") }}
{{- end }}
  exit 0
fi

[ "$1" = stop ] && exit 0
rm -f "$run/pid"
locked && exit 0

# The model, the first time: downloaded, checked, kept.
case "$model" in
  tiny) sum=be07e048e1e599ad46341c8d2a135645097a538221678b7acdd1b1919c6e1b21 ;;
  base) sum=60ed5bc3dd14eea856493d334349b405782ddcaf0028d4b5df4088345fba2efe ;;
  small) sum=1be3a9b2063867b937e64e2ec7483364a79917e157fa98c5d94b5c1fffea987b ;;
  *) exit 1 ;;
esac
if [ ! -f "$models/ggml-$model.bin" ]; then
  # Pressed again meanwhile: nothing more (a mark older than 30 minutes is
  # one left by a download that died).
  [ -n "$(find "$run/downloading" -mmin -30 2>/dev/null)" ] && exit 0
  mkdir -p "$models"
  touch "$run/downloading"
  say {{ shq (t "downloading") }}
  # Given up on when it stalls (under 1 kB/s for a minute).
  if curl -fsSL --proto '=https' --connect-timeout 15 --speed-limit 1024 --speed-time 60 -o "$models/ggml-$model.bin.part" "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-$model.bin" \
    && echo "$sum  $models/ggml-$model.bin.part" | sha256sum -c --status; then
    mv "$models/ggml-$model.bin.part" "$models/ggml-$model.bin"
    rm -f "$run/downloading"
    say {{ shq (t "ready") }}
  else
    rm -f "$models/ggml-$model.bin.part" "$run/downloading"
    say {{ shq (t "download_failed") }} critical
  fi
  exit 0
fi

# Listening, until the key again (or two minutes: then stopped as if
# pressed; the timer only stops, never starts one).
heard="$run/heard.$(date +%s%N).wav"
pw-record --rate 16000 --channels 1 --format s16 "$heard" &
rec=$!
echo "$rec $heard" > "$run/pid"
sleep 0.3
if ! kill -0 "$rec" 2>/dev/null; then
  rm -f "$run/pid" "$heard"
  say {{ shq (t "no_mic") }} critical
  exit 0
fi
say {{ shq (t "listening") }}
( sleep 120; p=; [ -f "$run/pid" ] && read -r p h < "$run/pid"; [ "$p" = "$rec" ] && kill -0 "$rec" 2>/dev/null && sh "$0" stop ) >/dev/null 2>&1 &
