-- Generated by mazapan (plugin {{ plugin }}): asking an agent, and the agents.
-- The same commands as its actions in the palette.
hl.bind({{ lq settings.ask_key }}, hl.dsp.exec_cmd({{ if settings.command == "claude" }}"sh ~/.local/share/mazapan/bin/agent-ask --desktop"{{ else }}{{ lq ("xdg-terminal-exec " + settings.command + " \"$(mazapan report --agent)\"") }}{{ end }}))
hl.bind({{ lq settings.selection_key }}, hl.dsp.exec_cmd("sh ~/.local/share/mazapan/bin/agent-ask --selection"))
hl.bind({{ lq settings.panel_key }}, hl.dsp.exec_cmd("qs ipc -c mazapan call agents open"))
