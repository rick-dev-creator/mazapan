# Generated by mazapan (plugin {{ plugin }}): agent-ask [--listen|--desktop|--selection] [FILE…]
# opens the Ask card about these (this desktop: mazapan's report; the
# selected text, else what was copied; files; a capture), to type the question;
# --listen: listening (dictation started; what's said comes next);
# MAZAPAN_ASK_FOLLOW=1: the question goes on with the card's conversation; MAZAPAN_ASK set: that question,
# asked at once. The request goes as a file in the runtime folder, the
# person's alone.
d="${XDG_RUNTIME_DIR:-/tmp}/mazapan-ask"
mkdir -p "$d" && chmod 700 "$d" || exit 1
# What earlier questions were about (captures, notifications), gone after a day.
find "$d" -maxdepth 1 -type f -mmin +1440 -delete 2>/dev/null
desktop=
listening=false
if [ "$1" = "--listen" ]; then
  shift
  listening=true
elif [ "$1" = "--desktop" ]; then
  shift
  # State, failing checks, crashes, logged errors: what the agent's own
  # tools can't all see. It takes seconds (the checks run), so it's made
  # while the question is typed; the card waits for it before asking.
  desktop="$d/desktop.txt"
  rm -f "$desktop"
  (umask 077; mazapan report --agent > "$desktop.part" 2>/dev/null; mv -f "$desktop.part" "$desktop") &
elif [ "$1" = "--selection" ]; then
  shift
  t=$(wl-paste --primary --no-newline 2>/dev/null)
  [ -n "$t" ] || t=$(wl-paste --no-newline --type text 2>/dev/null)
  if [ -n "$t" ]; then
    (umask 077; printf '%s' "$t" > "$d/selection.txt")
    set -- "$d/selection.txt" "$@"
  fi
fi
n=$#
for f in "$@"; do set -- "$@" "$(realpath -- "$f")"; done
shift "$n"
[ -z "$desktop" ] || set -- "$desktop" "$@"
r="$d/r-$$.json"
follow=false
[ "${MAZAPAN_ASK_FOLLOW:-}" = 1 ] && follow=true
jq -n --arg q "${MAZAPAN_ASK:-}" --argjson follow "$follow" --argjson listening "$listening" \
  '{question: $q, files: $ARGS.positional, follow: $follow, listening: $listening}' --args "$@" > "$r" || exit 1
exec qs ipc -c mazapan call mazapan open ask "$r" >/dev/null
