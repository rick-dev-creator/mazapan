// Generated by mazapan (plugin {{ plugin }}).
//
// The agents in the bar: a robot, a dot while one works (the accent) or
// waits for you (the warning color, with how many), and the fullest limit
// when it's past 70 %. A click opens the card: the sessions (a click goes to
// its window), each account's limits and when they reset, today's use.
// Nothing in the bar where there are no agents.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Hyprland
import qs
import "../../components/kit"
import "../../components/agents"

BarItem {
  id: root

  shown: AgentsService.any
  open: popup.visible
  onClicked: popup.toggle()

  Connections {
    target: AgentsService
    function onAskedChanged() {
      const f = Hyprland.focusedMonitor
      if (root.barScreen && f && f.name === root.barScreen.name && !popup.visible) popup.toggle()
    }
  }

  Glyph {
    anchors.verticalCenter: parent.verticalCenter
    text: "󰚩"
    color: AgentsService.waiting > 0 ? Theme.warning : AgentsService.working > 0 ? Theme.accentText : Theme.fgMuted
  }
  Label {
    visible: AgentsService.waiting > 0
    anchors.verticalCenter: parent.verticalCenter
    text: AgentsService.waiting
    color: Theme.warning
  }
  Label {
    visible: AgentsService.fullest >= 70
    anchors.verticalCenter: parent.verticalCenter
    text: Math.round(AgentsService.fullest) + "%"
    color: AgentsService.fullest >= 90 ? Theme.danger : Theme.fgMuted
  }

  readonly property var stateText: ({ working: {{ tq "s.working" }}, waiting: {{ tq "s.waiting" }}, done: {{ tq "s.done" }}, idle: {{ tq "s.idle" }}, running: {{ tq "s.running" }} })
  readonly property var stateGlyph: ({ working: "󰔟", waiting: "󰋖", done: "󰄬", idle: "󰒲", running: "󰐊" })

  function usd(x) { return "$" + (x >= 100 ? Math.round(x) : x.toFixed(2)) }
  function tokens(n) { return n >= 1e9 ? (n / 1e9).toFixed(1) + "B" : n >= 1e6 ? (n / 1e6).toFixed(1) + "M" : n >= 1e3 ? Math.round(n / 1e3) + "k" : String(n) }

  BarPopup {
    id: popup
    owner: root
    cardWidth: 420
    onOpening: AgentsService.refreshAll()

    // --- the sessions ------------------------------------------------------------
    Caption { text: {{ tq "sessions" }}.toUpperCase() }
    Caption {
      visible: AgentsService.sessions.length === 0
      text: {{ tq "no_sessions" }}
      color: Theme.fgSubtle
    }
    ColumnLayout {
      Layout.fillWidth: true
      spacing: 0
      Repeater {
        model: AgentsService.sessions
        ListRow {
          required property var modelData
          glyph: root.stateGlyph[modelData.state] || "󰚩"
          active: modelData.state === "waiting"
          title: AgentsService.nameOf(modelData.agent) + " · " + AgentsService.base(modelData.project)
          detail: (root.stateText[modelData.state] || modelData.state) + " · " + AgentsService.span(AgentsService.now - modelData.since)
            + (modelData.message ? " · " + modelData.message : "")
          trailing: modelData.account && modelData.agent === "claude" ? modelData.account : ""
          onClicked: { AgentsService.focus(modelData.id); popup.toggle() }
        }
      }
    }

    // --- each account's limits -------------------------------------------------------
    Rule { visible: AgentsService.accounts.length > 0; Layout.fillWidth: true }
    Caption { visible: AgentsService.accounts.length > 0; text: {{ tq "limits" }}.toUpperCase() }
    Repeater {
      model: AgentsService.accounts
      ColumnLayout {
        id: acct
        required property var modelData
        Layout.fillWidth: true
        spacing: 4
        RowLayout {
          Layout.fillWidth: true
          Label { text: acct.modelData.account.label; elide: Text.ElideRight; Layout.fillWidth: true }
          Caption { text: acct.modelData.account.plan; color: Theme.fgSubtle }
        }
        Caption {
          visible: acct.modelData.stale
          text: acct.modelData.problem
          color: Theme.fgSubtle
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
        Repeater {
          model: acct.modelData.windows
          RowLayout {
            required property var modelData
            Layout.fillWidth: true
            spacing: 8
            Caption { text: modelData.name === "session" ? {{ tq "w.session" }} : modelData.name === "week" ? {{ tq "w.week" }} : modelData.name; Layout.preferredWidth: 110; elide: Text.ElideRight }
            Rectangle {
              Layout.fillWidth: true
              implicitHeight: 6
              radius: 3
              color: Theme.surface
              Rectangle {
                width: parent.width * Math.min(1, modelData.percent / 100)
                height: parent.height
                radius: 3
                color: modelData.percent >= 90 ? Theme.danger : modelData.percent >= {{ if settings.limit_alert > 0 }}{{ settings.limit_alert }}{{ else }}80{{ end }} ? Theme.warning : Theme.accent
                opacity: acct.modelData.stale ? 0.4 : 1
              }
            }
            Caption { text: Math.round(modelData.percent) + "%"; Layout.preferredWidth: 36; horizontalAlignment: Text.AlignRight }
            Caption {
              text: modelData.resets_at ? AgentsService.span(new Date(modelData.resets_at).getTime() - AgentsService.now) : ""
              color: Theme.fgSubtle
              Layout.preferredWidth: 70
              horizontalAlignment: Text.AlignRight
            }
          }
        }
      }
    }

    // --- today -----------------------------------------------------------------
    Rule { visible: AgentsService.today.length > 0; Layout.fillWidth: true }
    Caption { visible: AgentsService.today.length > 0; text: {{ tq "today" }}.toUpperCase() }
    Repeater {
      model: AgentsService.today
      RowLayout {
        required property var modelData
        Layout.fillWidth: true
        spacing: 8
        Label { text: AgentsService.nameOf(modelData.agent); Layout.fillWidth: true }
        Caption { text: {{ tq "answers" }}.arg(modelData.answers) }
        Caption { text: root.tokens(modelData.tokens) }
        // What the same tokens cost through the API; and what was paid, where an API was.
        Caption {
          text: root.usd(modelData.api) + (modelData.reported > 0 ? " · " + {{ tq "paid" }}.arg(root.usd(modelData.reported)) : "")
          color: Theme.fgMuted
        }
      }
    }
    Caption {
      visible: AgentsService.today.length > 0
      text: {{ tq "api_note" }}
      color: Theme.fgSubtle
      wrapMode: Text.Wrap
      Layout.fillWidth: true
    }
  }
}
