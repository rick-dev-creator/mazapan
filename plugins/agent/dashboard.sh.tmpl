# Generated by mazapan (plugin {{ plugin }}): opens the agents' dashboard, its
# own Quickshell process; open already, it comes to the front.
f="$HOME/.config/quickshell/mazapan/agents-dashboard.qml"
pid=$(pgrep -u "$(id -u)" -x qs -a 2>/dev/null | awk -v f="$f" 'index($0, f) {print $1; exit}')
[ -n "$pid" ] || pid=$(pgrep -u "$(id -u)" -x quickshell -a 2>/dev/null | awk -v f="$f" 'index($0, f) {print $1; exit}')
if [ -n "$pid" ]; then
  addr=$(hyprctl clients -j | jq -r --argjson p "$pid" '.[] | select(.pid == $p) | .address' | head -n 1)
  [ -n "$addr" ] && exec hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })"
fi
exec setsid qs -p "$f" >/dev/null 2>&1
