// Generated by mazapan (plugin {{ plugin }}).
//
// An agent's change, yours to allow: what it is and the exact diff of every
// file it would write, before anything is written. Allow, or Don't allow
// (Esc); no answer in two minutes is no. The core waits for the answer
// (cli/Approval.cs): the request and the answer are files in
// $XDG_RUNTIME_DIR/mazapan-approve, yours alone.
//   qs ipc -c mazapan call mazapan open approve PATH
{{- if !settings.approve_changes }}
// approve_changes is off: every request is allowed at once, unseen.
{{- end }}

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  property string request: ""     // its file
  property string by: ""
  property string what: ""
  property var lines: []
  property double deadline: 0
  property double now: 0

  function toggle() { if (open) answer("deny") }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    open = true
  }

  function showWith(path) {
    if (!/^\/.*\/mazapan-approve\/r-\d+-\d+\.json$/.test(path)) return
    // One asked before still open: it's a no (the newer one is shown).
    if (open && request !== "") answer("deny")
    request = path
    reader.command = ["cat", "--", path]
    reader.running = true
  }
  Process {
    id: reader
    stdout: StdioCollector {
      onStreamFinished: {
        let r = {}
        try { r = JSON.parse(text) } catch (e) { root.answer("deny"); return }
{{- if settings.approve_changes }}
        root.by = r.by || ""
        root.what = r.what || ""
        root.lines = (r.diff || "").split("\n").slice(0, 4000)
        root.deadline = Date.now() + 115000
        root.now = Date.now()
        root.show()
{{- else }}
        root.answer("allow")
{{- end }}
      }
    }
  }

  // The answer, next to the request (the core waits for it).
  function answer(a) {
    if (request === "") return
    const file = request.replace(/\.json$/, ".answer")
    Quickshell.execDetached(["sh", "-c", 'umask 077; printf "%s" "$1" > "$0"', file, a])
    request = ""
    open = false
  }

  Timer {
    interval: 1000
    repeat: true
    running: root.open
    onTriggered: { root.now = Date.now(); if (root.now >= root.deadline) root.answer("deny") }
  }

  function lineColor(l) {
    if (l.startsWith("+++") || l.startsWith("---")) return Theme.fgMuted
    if (l.startsWith("+")) return Theme.success
    if (l.startsWith("-")) return Theme.danger
    if (l.startsWith("@@")) return Theme.info
    return Theme.fgSubtle
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    readonly property real screenHeight: screen ? screen.height : 1080
    implicitWidth: Math.max(560, Math.min(900, (screen ? screen.width : 1280) * 0.6))
    implicitHeight: Math.min(card.implicitHeight, screenHeight * 0.8)
    anchors.top: true
    margins.top: Math.round(screenHeight * 0.1)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it, which is a no (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-approve"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      anchors.fill: parent
      implicitHeight: col.implicitHeight + 32
      color: Theme.surfaceRaised
      border.color: Theme.warning
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: root.answer("deny")

      ColumnLayout {
        id: col
        anchors.fill: parent
        anchors.margins: 16
        spacing: 10

        RowLayout {
          Layout.fillWidth: true
          spacing: 8
          Glyph { text: "󰚩"; color: Theme.warning }
          Label {
            text: {{ tq "approve.title" }}.arg(root.by)
            font.bold: true
            Layout.fillWidth: true
            elide: Text.ElideRight
          }
          Caption { text: {{ tq "approve.left" }}.arg(Math.max(0, Math.round((root.deadline - root.now) / 1000))); color: Theme.fgSubtle }
        }
        Label {
          text: root.what
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
        Caption { text: {{ tq "approve.diff" }}.toUpperCase() }

        // The diff, line by line, as a terminal shows it.
        Rectangle {
          Layout.fillWidth: true
          Layout.fillHeight: true
          Layout.preferredHeight: Math.min(diffView.contentHeight + 12, win.screenHeight * 0.55)
          color: Theme.bg
          radius: Theme.radius
          ListView {
            id: diffView
            anchors.fill: parent
            anchors.margins: 6
            clip: true
            model: root.lines
            boundsBehavior: Flickable.StopAtBounds
            delegate: Text {
              required property string modelData
              width: ListView.view.width
              text: modelData === "" ? " " : modelData
              textFormat: Text.PlainText
              color: root.lineColor(modelData)
              font.family: Theme.fontMono
              font.pointSize: 8.5
              elide: Text.ElideRight
            }
          }
        }

        RowLayout {
          Layout.fillWidth: true
          spacing: 8
          Caption { text: {{ tq "approve.undo" }}; color: Theme.fgSubtle; Layout.fillWidth: true; wrapMode: Text.Wrap }
          Button { text: {{ tq "approve.deny" }}; onClicked: root.answer("deny") }
          Button { text: {{ tq "approve.allow" }}; primary: true; onClicked: root.answer("allow") }
        }
      }
    }
  }
}
