// Generated by mazapan (plugin {{ plugin }}): opencode's sessions in the bar.
// Each session's state goes to `mazapan agents event` (working, waiting for
// a permission, done); nothing else is sent anywhere.
export const MazapanSessions = async ({ directory }) => {
  const say = (session, state) => {
    if (!session) return
    try {
      Bun.spawn(["/usr/bin/mazapan", "agents", "event", "opencode", state, session, directory || ""], { stdout: "ignore", stderr: "ignore" })
    } catch {}
  }
  return {
    event: async ({ event }) => {
      const p = event.properties || {}
      const id = p.sessionID || (p.info && p.info.id) || ""
      switch (event.type) {
        case "session.created": say(id, "idle"); break
        case "session.status": say(id, p.status && p.status.type === "busy" ? "working" : "done"); break
        case "session.idle": say(id, "done"); break
        case "permission.asked": say(id, "waiting"); break
        case "session.error": say(id, "done"); break
        case "session.deleted": say(id, "end"); break
      }
    },
  }
}
