// Generated by mazapan (plugin {{ plugin }}).
//
// The agents, for every bar: their sessions (every few seconds), each
// account's limits (every few minutes) and today's use, all from
// `mazapan agents … --json`; the notifications when a session waits for you
// or is done, and when an account's limit passes {{ settings.limit_alert }} %.
// One instance for the whole shell, however many bars.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs

Singleton {
  id: root

  property var agents: []      // [{id, name, installed, accounts}]
  property var sessions: []    // [{agent, id, account, project, state, since, message, pids}]
  property var accounts: []    // [{account, read, stale, problem, windows: [{name, percent, resets_at}]}]
  property var today: []       // [{agent, answers, tokens, api, reported}]
  property var spend: []       // what the providers report: [{provider, name, today, period, limit, remaining, problem}]
  property int asked: 0        // the palette asked for the card
  // Each workspace with a session's window: what the most pressing one does
  // (waiting, then working, then done), for a dot on its number.
  property var byWorkspace: ({}) // workspace id -> state
  property double now: Date.now()

  readonly property bool any: agents.length > 0
  readonly property int waiting: sessions.filter(s => s.state === "waiting").length
  readonly property int working: sessions.filter(s => s.state === "working").length
  // The fullest window of any account (fresh values only).
  readonly property real fullest: {
    let m = 0
    for (const a of accounts) if (!a.stale) for (const w of a.windows) m = Math.max(m, w.percent)
    return m
  }

  readonly property var names: ({ claude: "Claude Code", opencode: "OpenCode", pi: "Pi", codex: "Codex", gemini: "Gemini CLI", crush: "Crush", aider: "Aider" })
  function nameOf(id) { return names[id] || id }
  function base(p) { return String(p || "").split("/").filter(x => x !== "").pop() || "~" }

  // "3 min", "2 h 5 min".
  function span(ms) {
    const m = Math.max(0, Math.round(ms / 60000))
    // A day or more (a weekly limit's reset): days and hours, short enough for its column.
    return m < 60 ? {{ tq "min" }}.arg(m) : m < 1440 ? {{ tq "hours" }}.arg(Math.floor(m / 60)).arg(m % 60)
      : {{ tq "days" }}.arg(Math.floor(m / 1440)).arg(Math.floor(m % 1440 / 60))
  }

  function run(proc, args) {
    if (proc.running) return
    proc.command = ["mazapan", "agents"].concat(args)
    proc.running = true
  }
  function refreshAll() {
    run(lister, ["list", "--json"])
    run(limits, ["limits", "--json"])
    run(usage, ["usage", "--json", "--days", "1"])
    run(spendProc, ["spend", "--json", "--days", "30"])
  }

  // --- the notifications -----------------------------------------------------------

  property var lastState: ({})   // session id -> {state, since}
  property var alerted: ({})     // account|window|resets -> true
  property bool limitsRead: false // the first read after a (re)load tells nothing: already said
  function notify(title, body, sessionId) {
    const argv = ["notify-send", "-a", {{ tq "title" }}, "-i", "utilities-terminal"]
    // A session's: its button while the banner shows, then gone (no process left waiting).
    if (sessionId) argv.push("-e", "-A", "go=" + {{ tq "go" }}, "-w")
    argv.push("--", title, body)
    const n = notice.createObject(root, { command: argv, session: sessionId || "" })
    n.running = true
  }
  Component {
    id: notice
    Process {
      id: p
      property string session: ""
      stdout: StdioCollector { onStreamFinished: if (text.trim() === "go") root.focus(p.session) }
      onExited: Qt.callLater(p.destroy)
    }
  }
  function noteSessions(list) {
    const before = lastState
    const next = {}
    for (const s of list) {
      next[s.id] = { state: s.state, since: s.since }
      const was = before[s.id]
      if (!was || was.state === s.state) continue
      const where = root.base(s.project)
      if (s.state === "waiting")
        root.notify({{ tq "n.waiting" }}.arg(root.nameOf(s.agent)).arg(where), s.message || "", s.id)
{{- if settings.notify_after > 0 }}
      else if (s.state === "done" && was.state === "working" && s.since - was.since >= {{ settings.notify_after }} * 1000)
        root.notify({{ tq "n.done" }}.arg(root.nameOf(s.agent)).arg(where), {{ tq "n.after" }}.arg(root.span(s.since - was.since)), s.id)
{{- end }}
    }
    lastState = next
  }
  function noteLimits(list) {
{{- if settings.limit_alert > 0 }}
    for (const a of list) {
      if (a.stale) continue
      for (const w of a.windows) {
        const key = a.account.id + "|" + w.name + "|" + w.resets_at
        if (w.percent >= {{ settings.limit_alert }} && !alerted[key]) {
          alerted[key] = true
          if (!limitsRead) continue
          const when = w.resets_at ? new Date(w.resets_at).toLocaleTimeString(Qt.locale("{{ lang }}"), Locale.ShortFormat) : ""
          root.notify({{ tq "n.limit" }}.arg(a.account.label).arg(Math.round(w.percent)), when ? {{ tq "n.resets" }}.arg(when) : "", "")
        }
      }
    }
    limitsRead = true
{{- end }}
  }

  // --- going to a session's window ---------------------------------------------------

  // Its window: the Hyprland client whose process is the session's or one
  // above it (the terminal it runs in).
  function focus(id) {
    const s = sessions.find(x => x.id === id)
    if (!s) return
    clients.pids = s.pids
    clients.running = true
  }
  Process {
    id: clients
    property var pids: []
    command: ["hyprctl", "clients", "-j"]
    stdout: StdioCollector {
      onStreamFinished: {
        let list = []
        try { list = JSON.parse(text) } catch (e) {}
        for (const pid of clients.pids) {
          const c = list.find(x => x.pid === pid)
          if (c) {
            Quickshell.execDetached(["hyprctl", "dispatch", `hl.dsp.focus({ window = "address:${c.address}" })`])
            return
          }
        }
      }
    }
  }

  // --- where each session is ----------------------------------------------------------

  readonly property var rank: ({ waiting: 3, working: 2, done: 1 })
  function placeSessions() {
    if (!sessions.some(s => rank[s.state] && s.pids && s.pids.length)) {
      if (Object.keys(byWorkspace).length) byWorkspace = ({})
      return
    }
    if (!placer.running) placer.running = true
  }
  Process {
    id: placer
    command: ["hyprctl", "clients", "-j"]
    stdout: StdioCollector {
      onStreamFinished: {
        let list = []
        try { list = JSON.parse(text) } catch (e) { return }
        const out = {}
        for (const s of root.sessions) {
          const r = root.rank[s.state]
          if (!r) continue
          // Its window: the client whose process is the session's or one above it (its terminal).
          const c = (s.pids || []).map(p => list.find(x => x.pid === p)).find(x => x)
          if (!c || !c.workspace || c.workspace.id <= 0) continue
          const id = c.workspace.id
          if (!out[id] || root.rank[out[id]] < r) out[id] = s.state
        }
        if (JSON.stringify(out) !== JSON.stringify(root.byWorkspace)) root.byWorkspace = out
      }
    }
  }

  // --- reading ----------------------------------------------------------------------

  Process {
    id: lister
    stdout: StdioCollector {
      onStreamFinished: { try { root.agents = JSON.parse(text).agents || [] } catch (e) {} }
    }
  }
  Process {
    id: sessionsProc
    command: ["mazapan", "agents", "sessions", "--json"]
    stdout: StdioCollector {
      onStreamFinished: {
        try {
          const list = JSON.parse(text).sessions || []
          root.noteSessions(list)
          root.sessions = list
          root.placeSessions()
        } catch (e) {}
      }
    }
  }
  Process {
    id: spendProc
    stdout: StdioCollector { onStreamFinished: { try { root.spend = JSON.parse(text).providers || [] } catch (e) {} } }
  }
  Process {
    id: limits
    stdout: StdioCollector {
      onStreamFinished: {
        try {
          const list = JSON.parse(text).accounts || []
          root.noteLimits(list)
          root.accounts = list
        } catch (e) {}
      }
    }
  }
  Process {
    id: usage
    stdout: StdioCollector {
      onStreamFinished: {
        let rows = []
        try { rows = JSON.parse(text).rows || [] } catch (e) { return }
        const by = {}
        for (const r of rows) {
          const a = by[r.agent] || (by[r.agent] = { agent: r.agent, answers: 0, tokens: 0, api: 0, reported: 0 })
          a.answers += r.requests
          a.tokens += r.input + r.output + r.cache_read + r.cache_write
          a.api += r.cost_api
          a.reported += r.cost_reported
        }
        root.today = Object.values(by).sort((x, y) => y.tokens - x.tokens)
      }
    }
  }

  Timer {
    interval: 3000
    repeat: true
    running: true
    triggeredOnStart: true
    onTriggered: { root.now = Date.now(); if (!sessionsProc.running) sessionsProc.running = true }
  }
  Timer {
    interval: 5 * 60 * 1000
    repeat: true
    running: true
    triggeredOnStart: true
    onTriggered: root.refreshAll()
  }

  // Back online: the accounts' limits now, not in up to five minutes.
  Connections {
    target: Online
    function onBack() { root.refreshAll() }
  }

  IpcHandler {
    target: "agents"
    function open(): void { root.asked++ }
  }
}
