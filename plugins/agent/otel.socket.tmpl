# Generated by mazapan (plugin {{ plugin }}): where coding agents send their
# OpenTelemetry metrics, on this computer only. The receiver starts with the
# first one and ends when idle. {{ if settings.otel }}On{{ else }}Off (otel): not enabled{{ end }}.
[Unit]
Description=Mazapan: the coding agents' metrics (OpenTelemetry, 127.0.0.1:{{ settings.otel_port }})

[Socket]
ListenStream=127.0.0.1:{{ settings.otel_port }}

[Install]
WantedBy=sockets.target
