// Generated by mazapan (plugin {{ plugin }}): your agents, in the Control Center.
//
// The sessions open now (which agent, where, what it's doing; a click goes
// to its window), and each account's limits with when they reset. The
// dashboard, one click away. A dot in the pill while one works.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/agents"
import "../../components/control"

Group {
  id: root

  property bool shown: AgentsService.any
  readonly property string pillGlyph: AgentsService.working > 0 ? "󱙺 " + AgentsService.working : ""
  readonly property var stateText: ({ working: {{ tq "s.working" }}, waiting: {{ tq "s.waiting" }}, done: {{ tq "s.done" }}, idle: {{ tq "s.idle" }}, running: {{ tq "s.running" }} })

  title: {{ tq "title" }}
  trailing: {{ tq "dashboard" }}
  onTrailingClicked: {
    ControlService.close()
    Quickshell.execDetached(["sh", Quickshell.env("HOME") + "/.local/share/mazapan/bin/agents-dashboard"])
  }

  Flow {
    visible: AgentsService.sessions.length > 0
    Layout.fillWidth: true
    spacing: 6
    Repeater {
      model: AgentsService.sessions
      Rectangle {
        required property var modelData
        readonly property bool waits: modelData.state === "waiting"
        implicitWidth: chip.implicitWidth + 16
        implicitHeight: 24
        radius: Theme.radius
        color: waits ? Qt.rgba(Theme.warning.r, Theme.warning.g, Theme.warning.b, 0.18) : area.containsMouse ? Theme.surfaceRaised : Theme.bgAlt
        border.width: 1
        border.color: waits ? Theme.warning : Theme.border
        Text {
          id: chip
          anchors.centerIn: parent
          text: AgentsService.base(modelData.project) + " · " + (root.stateText[modelData.state] || modelData.state)
          color: waits ? Theme.warning : Theme.fg
          font.family: Theme.fontMono
          font.pointSize: 8
        }
        MouseArea {
          id: area
          anchors.fill: parent
          hoverEnabled: true
          cursorShape: Qt.PointingHandCursor
          onClicked: {
            ControlService.close()
            AgentsService.focus(modelData.id)
          }
        }
      }
    }
  }
  Caption {
    visible: AgentsService.sessions.length === 0
    text: {{ tq "no_sessions" }}
    font.letterSpacing: 0
  }

  Repeater {
    model: AgentsService.accounts.filter(a => a.windows && a.windows.length > 0).slice(0, 3)
    RowLayout {
      required property var modelData
      readonly property var win: modelData.windows.reduce((a, b) => (b.percent > a.percent ? b : a), modelData.windows[0])
      Layout.fillWidth: true
      spacing: 8
      Caption {
        text: modelData.account ? (modelData.account.label || modelData.account.id || "") : ""
        font.letterSpacing: 0
        elide: Text.ElideRight
        Layout.preferredWidth: 130
      }
      Rectangle {
        Layout.fillWidth: true
        implicitHeight: 5
        radius: 3
        color: Theme.border
        Rectangle {
          width: parent.width * Math.min(1, win.percent / 100)
          height: parent.height
          radius: 3
          color: win.percent >= 90 ? Theme.danger : win.percent >= 70 ? Theme.warning : Theme.fgMuted
        }
      }
      Caption {
        text: Math.round(win.percent) + "%"
        font.letterSpacing: 0
        Layout.preferredWidth: 36
        horizontalAlignment: Text.AlignRight
      }
    }
  }
}
