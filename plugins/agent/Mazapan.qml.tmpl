// Generated by mazapan (plugin {{ plugin }}): the agent's face, Mazapan.
//
// Its gestures from one sprite sheet (assets/make-mascot.py: 48×48 frames,
// a row a gesture), drawn pixel for pixel at `zoom` times. `mood` is one of
// idle, listen, think, work, wait, happy, shrug, read, sleep, dizzy. With
// the theme's motion off, it holds still.

import QtQuick
import Quickshell
import Quickshell.Io
import qs

Item {
  id: root

  property string mood: "idle"
  property int zoom: 2
  implicitWidth: 48 * zoom
  implicitHeight: 48 * zoom

  // Each gesture's row, frames and speed, as the sheet's script wrote them.
  property var states: ({})
  readonly property var now: states[mood] || states.idle || ({ row: 0, frames: 1, fps: 1 })
  FileView {
    path: "{{ plugin_dir }}/media/mazapan-agent.json"
    blockLoading: true
    printErrors: false
    onLoaded: { try { root.states = JSON.parse(text()).states || {} } catch (e) {} }
  }

  AnimatedSprite {
    id: sprite
    anchors.fill: parent
    source: "file://{{ plugin_dir }}/media/mazapan-agent.png"
    frameWidth: 48
    frameHeight: 48
    frameX: 0
    frameY: root.now.row * 48
    frameCount: root.now.frames
    frameRate: root.now.fps
    interpolate: false
    smooth: false
    loops: AnimatedSprite.Infinite
    running: root.visible && Theme.motion
  }
  onMoodChanged: { sprite.currentFrame = 0; if (sprite.running) sprite.restart() }
}
