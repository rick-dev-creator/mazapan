// Generated by mazapan (plugin {{ plugin }}).
//
// The Ask card: Mazapan's agent, Mazapan the character. Asked by typing (here, or
// "? question" in the palette) or by voice (dictation's "ask by voice", or
// the microphone here), it answers, and when you ask for a change it makes
// it through Mazapan: Mazapan's own card shows you the diff and asks first
// (`mazapan agents ask --act`: Claude with Mazapan's tools, nothing else).
// The conversation goes on here; undone, copied, or continued in a
// terminal. About something not yours (a capture, the selected text, a
// notification, files) it only answers: what came from elsewhere can hold
// words meant to steer it.
//   qs ipc -c mazapan call mazapan open ask PATH
// PATH: a request in $XDG_RUNTIME_DIR/mazapan-ask, {"question": "…",
// "files": ["/…"], "follow": true, "listening": true} (bin/agent-ask writes
// it; an argument's brackets are qs ipc's own).

import QtQuick
import QtQuick.Layouts
import QtQuick.Effects
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/agents"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null

  readonly property bool mascot: {{ settings.mascot }}
  readonly property bool canDictate: {{ if (under "~/.local/share/mazapan/bin/dictate").size > 0 }}true{{ else }}false{{ end }}
  readonly property string home: Quickshell.env("HOME")

  // The conversation and where it is, kept across the shell's reloads: a
  // change it makes (a theme, an accent) rewrites the shell, this card with
  // it, and the card comes back as it was, following the agent where it is.
  PersistentProperties {
    id: kept
    reloadableId: "mazapan-ask"
    property bool open: false
    // Lists kept as JSON: a reload brings back text and numbers, not JavaScript's lists.
    property string turnsJ: "[]"   // [{ me: bool, text, problem }]
    property string filesJ: "[]"   // what it's about
    property string session: ""    // the agent's, to go on with
    property string resumeJ: "null"
    property string agentName: ""
    property string account: ""
    property string undoId: ""     // the last change made here, to undo
    property string phase: "idle"
    property string step: ""
    property string log: ""        // the running ask's lines (empty: none running)
    property string doneFor: ""    // the log whose answer is already in turns
    property string undoLog: ""    // an undo running (it reloads the shell too)
    property double started: 0
    // Its values are back only now (not yet when the card is made).
    onLoaded: root.restore()
  }
  function parsed(j, d) { try { const v = JSON.parse(j); return v === undefined ? d : v } catch (e) { return d } }
  readonly property var turns: parsed(kept.turnsJ, [])
  readonly property var files: parsed(kept.filesJ, [])
  readonly property var resume: parsed(kept.resumeJ, null)
  property alias session: kept.session
  property alias agentName: kept.agentName
  property alias account: kept.account
  property alias undoId: kept.undoId
  // What it's doing: idle, listening, thinking, working, waiting, done,
  // declined, error, sleeping; and the step, said.
  property alias phase: kept.phase
  property alias step: kept.step
  property alias started: kept.started
  readonly property bool aboutDesktop: files.length === 1 && files[0].endsWith("/mazapan-ask/desktop.txt")
  // Material from elsewhere: it only answers.
  readonly property bool readOnly: files.length > 0 && !aboutDesktop
  readonly property bool busy: kept.log !== ""
  property double now: 0

  readonly property string mood: phase === "listening" ? "listen" : phase === "thinking" ? "think"
    : phase === "working" ? "work" : phase === "waiting" ? "wait" : phase === "done" ? "happy"
    : phase === "declined" ? "shrug" : phase === "error" ? "dizzy" : phase === "sleeping" ? "sleep"
    : readOnly ? "read" : "idle"

  // Back after a reload: open again, following the ask still running.
  function restore() {
    if (kept.open && !open) show()
    if (kept.log !== "" && !follower.running) follower.running = true
  }

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    open = true
    kept.open = true
    Qt.callLater(() => field.focusInput())
  }
  function close() {
    open = false
    kept.open = false
    cancel()
  }
  function reset() {
    cancel()
    kept.turnsJ = JSON.stringify([])
    kept.filesJ = JSON.stringify([])
    kept.session = ""
    kept.resumeJ = JSON.stringify(null)
    kept.agentName = ""
    kept.account = ""
    kept.undoId = ""
    kept.phase = "idle"
    kept.step = ""
  }

  // A request written for this (read, then gone).
  function showWith(path) {
    if (!/^\/.*\/mazapan-ask\/r-\d+\.json$/.test(path)) return
    reader.command = ["sh", "-c", 'cat -- "$0" && rm -f -- "$0"', path]
    reader.running = true
  }
  Process {
    id: reader
    stdout: StdioCollector {
      onStreamFinished: {
        let r = {}
        try { r = JSON.parse(text) } catch (e) { return }
        const q = (r.question || "").trim()
        // Said by voice in this conversation (the microphone here): goes on with it.
        const goOn = r.follow === true && root.open && root.turns.length > 0
        if (!goOn) {
          root.reset()
          kept.filesJ = JSON.stringify((r.files || []).filter(f => typeof f === "string" && f.startsWith("/")))
        }
        root.show()
        if (r.listening === true) kept.phase = "listening"
        else if (q !== "") root.ask(q)
      }
    }
  }

  // The agent runs on its own (a reload doesn't stop it), its lines in a file
  // of the runtime folder that this card follows; its process group's id beside
  // it, to stop it. This desktop's report is still being made when the card
  // opens (it takes seconds): waited for, up to 30 s, else asked without it.
  readonly property string run_: 'log=$1; shift; echo $$ > "$log.pid"; '
    + 'r=; for a in "$@"; do case "$a" in */mazapan-ask/desktop.txt) r=$a ;; esac; done; '
    + 'if [ -n "$r" ]; then n=0; while [ ! -e "$r" ] && [ -e "$r.part" ] && [ $n -lt 300 ]; do sleep 0.1; n=$((n+1)); done; '
    + '[ -e "$r" ] || { p=; for a; do shift; if [ -n "$p" ]; then [ "$a" = "$r" ] || set -- "$@" --file "$a"; p=; '
    + 'elif [ "$a" = "--file" ]; then p=1; else set -- "$@" "$a"; fi; done; }; fi; '
    + 'mazapan "$@" > "$log" 2> "$log.err"; echo $? > "$log.exit"'

  function ask(q) {
    if (q === "" || busy) return
    kept.turnsJ = JSON.stringify(turns.concat([{ me: true, text: q }]))
    kept.phase = "thinking"
    kept.step = {{ tq "ask.step.looking" }}
    const flags = ["--stream", "--agent", {{ quote settings.ask_agent }}, "--model", {{ quote settings.ask_model }},
      "--account", {{ quote settings.ask_account }}, "--key", {{ quote settings.ask_credential }}]
    if (!readOnly) flags.push("--act")
    if (session !== "") flags.push("--resume", session)
    const log = (Quickshell.env("XDG_RUNTIME_DIR") || "/tmp") + "/mazapan-ask/turn-" + Date.now() + ".jsonl"
    kept.log = log
    kept.started = Date.now()
    now = kept.started
    Quickshell.execDetached(["setsid", "sh", "-c", run_, "sh", log, "agents", "ask"].concat(flags)
      // The material goes with the first question only; then it's in the conversation.
      .concat(...(session === "" ? files : []).map(f => ["--file", f])).concat(["--", q]))
    follower.running = false
    follower.running = true
  }

  // Shown as Markdown, without what would load by itself: an image (or HTML)
  // the answer names could carry what the agent read to a server, unclicked.
  // Every "![" made a plain link (nothing loads by itself), reference
  // definitions taken out (they'd make "[x]" a link to anywhere), and "<"
  // written as text (a tag shows as what it says: `--theme <id>`, never runs).
  function safe(md) {
    return md.replace(/!\[/g, "[").replace(/^ {0,3}\[[^\]\n]+\]:.*$/gm, "").replace(/&/g, "&amp;").replace(/</g, "&lt;")
  }
  function cancel() {
    if (kept.log !== "") Quickshell.execDetached(["sh", "-c", 'p=$(cat -- "$0.pid" 2>/dev/null) && kill -TERM -- "-$p" 2>/dev/null; true', kept.log])
    kept.log = ""
    follower.running = false
    if (phase === "thinking" || phase === "working" || phase === "waiting") kept.phase = "idle"
  }

  // Each line the agent says as it goes: a tool (looking, preparing a change,
  // waiting for you), a change made or turned down, and the answer, last. After
  // a reload it's read again from the start: each line says the same again.
  property bool applied: false
  property bool declined: false
  Process {
    id: follower
    command: ["tail", "-n", "+1", "-F", "--", kept.log]
    onRunningChanged: if (running) { root.applied = false; root.declined = false }
    stdout: SplitParser {
      onRead: line => {
        if (kept.log === "") return
        let e = {}
        try { e = JSON.parse(line) } catch (x) { return }
        if (e.event === "tool") {
          if (e.name === "preview_change") { kept.phase = "working"; kept.step = {{ tq "ask.step.preparing" }} }
          else if (e.name === "apply_change") { kept.phase = "waiting"; kept.step = {{ tq "ask.step.approval" }} }
          else if (e.name === "undo") { kept.phase = "working"; kept.step = {{ tq "ask.step.undoing" }} }
          else if (root.phase !== "working" && root.phase !== "waiting") { kept.phase = "thinking"; kept.step = {{ tq "ask.step.looking" }} }
        } else if (e.event === "applied") {
          root.applied = true
          kept.undoId = e.id || ""
        } else if (e.event === "declined") {
          root.declined = true
        } else if (e.event === "done" || e.answer !== undefined) {
          root.finish(e)
        }
      }
    }
  }
  function finish(e) {
    if (kept.doneFor === kept.log) return
    kept.doneFor = kept.log
    kept.agentName = e.name || ""
    kept.account = e.account || ""
    if (e.session) kept.session = e.session
    kept.resumeJ = JSON.stringify(e.resume || null)
    if (e.problem) {
      kept.turnsJ = JSON.stringify(turns.concat([{ me: false, text: e.problem, problem: true }]))
      kept.phase = /limit/i.test(e.problem) ? "sleeping" : "error"
    } else {
      kept.turnsJ = JSON.stringify(turns.concat([{ me: false, text: e.answer || "" }]))
      kept.phase = root.applied ? "done" : root.declined ? "declined" : "idle"
    }
    kept.step = ""
    kept.log = ""
    follower.running = false
    Qt.callLater(() => { flick.contentY = Math.max(0, flick.contentHeight - flick.height); field.focusInput() })
  }
  // Ended without an answer (it failed, or was stopped): said, from what it wrote on stderr.
  Process {
    id: ended
    command: ["sh", "-c", 'cat -- "$0.exit" 2>/dev/null || exit 1; tail -n 1 -- "$0.err"', kept.log]
    stdout: StdioCollector {
      onStreamFinished: {
        if (kept.log === "" || text.trim() === "") return
        // The answer may still be on its way through the follower: a moment's grace.
        grace.problem = text.trim().split("\n").slice(1).join(" ")
        if (!grace.running) grace.start()
      }
    }
  }
  Timer {
    id: grace
    property string problem: ""
    interval: 1500
    onTriggered: if (kept.log !== "" && kept.doneFor !== kept.log) root.finish({ problem: problem || {{ tq "ask.failed" }} })
  }
  Timer {
    interval: 1000; repeat: true; running: root.busy || kept.undoLog !== ""
    onTriggered: { root.now = Date.now(); if (root.busy && !ended.running) ended.running = true }
  }
  // A jump for a change made, a shrug for one turned down: then back to listening.
  Timer { interval: 2600; running: root.phase === "done" || root.phase === "declined"; onTriggered: kept.phase = "idle" }

  // Undone: the change it made here, by its id (only if it's still the last one).
  // It reloads the shell as the change did: run on its own, its outcome read back.
  function undo() {
    if (undoId === "" || kept.undoLog !== "") return
    kept.phase = "working"
    kept.step = {{ tq "ask.step.undoing" }}
    const log = (Quickshell.env("XDG_RUNTIME_DIR") || "/tmp") + "/mazapan-ask/undo-" + Date.now() + ".log"
    kept.undoLog = log
    kept.started = Date.now()
    root.now = kept.started
    Quickshell.execDetached(["setsid", "sh", "-c", 'mazapan undo -y --id="$1" > "$0" 2>&1; echo $? > "$0.exit"', log, undoId])
  }
  Process {
    id: undone
    command: ["cat", "--", kept.undoLog + ".exit"]
    stdout: StdioCollector {
      onStreamFinished: {
        const code = text.trim()
        if (kept.undoLog === "" || code === "") return
        kept.undoLog = ""
        kept.turnsJ = JSON.stringify(root.turns.concat([{ me: false, text: code === "0" ? {{ tq "ask.undone" }} : {{ tq "ask.undo_failed" }}, problem: code !== "0" }]))
        if (code === "0") kept.undoId = ""
        kept.phase = code === "0" ? "idle" : "error"
        kept.step = ""
      }
    }
  }
  Timer { interval: 700; repeat: true; running: kept.undoLog !== ""; onTriggered: if (!undone.running) undone.running = true }

  // The microphone: dictation listens; what you said comes back as the next turn.
  Process { id: dictate }
  function listen() {
    if (!canDictate) return
    dictate.command = ["sh", home + "/.local/share/mazapan/bin/dictate", root.turns.length > 0 ? "reply" : "ask"]
    dictate.running = true
  }
  // Listening (here or from its key): dictation says so in its own file.
  Process {
    id: hearing
    command: ["sh", "-c", 'f="${XDG_RUNTIME_DIR:-/tmp}/mazapan-dictation/pid"; [ -f "$f" ] && read -r p h m < "$f" && kill -0 "$p" 2>/dev/null && [ "$m" != type ]']
    onExited: code => {
      if (code === 0 && !root.busy) kept.phase = "listening"
      else if (code !== 0 && root.phase === "listening") kept.phase = "idle"
    }
  }
  Timer { interval: 500; repeat: true; running: root.open && root.canDictate; onTriggered: if (!hearing.running) hearing.running = true }

  function terminal(argv) {
    // The person's terminal, as other panels open one (xdg-terminal-exec, else foot).
    Quickshell.execDetached({ command: ["sh", "-c", 'if command -v xdg-terminal-exec >/dev/null; then exec xdg-terminal-exec "$@"; else exec foot "$@"; fi', "sh"].concat(argv),
      workingDirectory: Quickshell.env("HOME") })
  }

  readonly property string lastAnswer: {
    for (let i = turns.length - 1; i >= 0; i--) if (!turns[i].me && !turns[i].problem) return turns[i].text
    return ""
  }

  // The phase as a word and a color, for the pill under Mazapan.
  readonly property string phaseWord: phase === "listening" ? {{ tq "ask.state.listening" }}
    : phase === "thinking" ? {{ tq "ask.state.thinking" }} : phase === "working" ? {{ tq "ask.state.working" }}
    : phase === "waiting" ? {{ tq "ask.state.waiting" }} : phase === "done" ? {{ tq "ask.state.done" }}
    : phase === "declined" ? {{ tq "ask.state.declined" }} : phase === "error" ? {{ tq "ask.state.error" }}
    : phase === "sleeping" ? {{ tq "ask.state.sleeping" }} : readOnly ? {{ tq "ask.state.reading" }} : {{ tq "ask.state.idle" }}
  readonly property color phaseColor: phase === "done" ? Theme.success : phase === "error" ? Theme.danger
    : phase === "waiting" ? Theme.warning : phase === "sleeping" ? Theme.info
    : phase === "idle" || phase === "declined" ? Theme.fgMuted : Theme.accent
  readonly property bool working: busy || kept.undoLog !== ""

  // Things to ask, for an empty card: what it can do, one click away.
  readonly property var ideas: [{{ tq "ask.idea.theme" }}, {{ tq "ask.idea.slow" }}, {{ tq "ask.idea.night" }}]

  PanelWindow {
    id: win
    visible: root.open || card.opacity > 0.01
    screen: root.screenAtOpen
    readonly property real screenHeight: screen ? screen.height : 1080
    implicitWidth: Math.max(560, Math.min(820, (screen ? screen.width : 1280) * 0.58)) + 48
    implicitHeight: Math.min(card.implicitHeight, screenHeight * 0.8) + 56
    anchors.top: true
    margins.top: Math.round(screenHeight * 0.12) - 24
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-ask"
    // Mazapan's approval card needs the pointer and keys while a change waits.
    WlrLayershell.keyboardFocus: root.phase === "waiting" ? WlrKeyboardFocus.OnDemand : WlrKeyboardFocus.Exclusive
    mask: Region { item: card }

    RectangularShadow {
      anchors.fill: card
      radius: card.radius
      blur: 36
      offset.y: 12
      opacity: card.opacity
      color: Qt.rgba(0, 0, 0, Theme.mode === "light" ? 0.16 : 0.42)
    }

    Rectangle {
      id: card
      x: 24
      y: 12
      width: parent.width - 48
      implicitHeight: body.implicitHeight + 40
      height: Math.min(implicitHeight, win.screenHeight * 0.8)
      color: Theme.bg
      border.color: root.phase === "waiting" ? Theme.warning : Theme.border
      border.width: 1
      radius: Math.max(Theme.radius, 4)
      clip: true
      focus: true
      Keys.onEscapePressed: root.close()
      Behavior on border.color { enabled: Theme.motion; ColorAnimation { duration: 200 } }

      opacity: root.open ? 1 : 0
      transform: Translate { y: root.open ? 0 : -10; Behavior on y { enabled: Theme.motion; NumberAnimation { duration: 240; easing.type: Easing.OutCubic } } }
      Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }

      // A glow of the phase's color behind Mazapan's side.
      Rectangle {
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        width: stage.width + 40
        gradient: Gradient {
          orientation: Gradient.Horizontal
          GradientStop { position: 0; color: Qt.alpha(root.phaseColor, Theme.mode === "light" ? 0.07 : 0.1) }
          GradientStop { position: 1; color: "transparent" }
        }
        Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 300 } }
      }

      // Working: a light that runs along the top.
      Rectangle {
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        height: 2
        color: "transparent"
        visible: root.working
        clip: true
        Rectangle {
          id: runner
          width: parent.width * 0.3
          height: 2
          radius: 1
          color: root.phaseColor
          NumberAnimation on x {
            running: root.working && root.open && Theme.motion
            from: -runner.width; to: card.width
            duration: 1300
            loops: Animation.Infinite
            easing.type: Easing.InOutCubic
          }
        }
      }

      RowLayout {
        id: body
        anchors.fill: parent
        anchors.margins: 20
        spacing: 20

        // --- Mazapan, on its stage ----------------------------------------------------
        ColumnLayout {
          id: stage
          Layout.alignment: Qt.AlignTop
          Layout.preferredWidth: 156
          spacing: 12

          Item {
            Layout.alignment: Qt.AlignHCenter
            Layout.preferredWidth: 156
            Layout.preferredHeight: root.mascot ? 156 : 72
            // Its shadow on the ground, in the phase's color.
            Rectangle {
              visible: root.mascot
              anchors.horizontalCenter: parent.horizontalCenter
              anchors.horizontalCenterOffset: -4
              anchors.bottom: parent.bottom
              anchors.bottomMargin: 15
              width: 78
              height: 8
              radius: 4
              color: Qt.alpha(root.phase === "idle" ? Theme.fg : root.phaseColor, root.phase === "idle" ? 0.1 : 0.3)
              Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 300 } }
            }
            Mazapan {
              visible: root.mascot
              anchors.centerIn: parent
              anchors.verticalCenterOffset: -4
              mood: root.mood
              zoom: 3
            }
            Rectangle {
              visible: !root.mascot
              anchors.centerIn: parent
              width: 64
              height: 64
              radius: 32
              color: Qt.alpha(root.phaseColor, 0.15)
              border.width: 1
              border.color: Qt.alpha(root.phaseColor, 0.5)
              Glyph {
                anchors.centerIn: parent
                text: root.phase === "waiting" ? "󰔟" : root.phase === "done" ? "󰄬" : root.phase === "error" ? "󰀦"
                  : root.phase === "listening" ? "󰍬" : root.phase === "sleeping" ? "󰒲" : root.readOnly ? "󰈈" : "󰚩"
                color: root.phaseColor
                font.pointSize: 22
              }
            }
          }

          // What it's doing, in a word.
          Rectangle {
            Layout.alignment: Qt.AlignHCenter
            implicitWidth: pillRow.implicitWidth + 22
            implicitHeight: 26
            radius: 13
            color: Qt.alpha(root.phaseColor, 0.14)
            border.width: 1
            border.color: Qt.alpha(root.phaseColor, 0.45)
            Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 250 } }
            Row {
              id: pillRow
              anchors.centerIn: parent
              spacing: 7
              Rectangle {
                anchors.verticalCenter: parent.verticalCenter
                width: 7
                height: 7
                radius: 3.5
                color: root.phaseColor
                SequentialAnimation on opacity {
                  running: (root.working || root.phase === "listening") && Theme.motion && root.open
                  loops: Animation.Infinite
                  NumberAnimation { to: 0.25; duration: 600 }
                  NumberAnimation { to: 1; duration: 600 }
                }
              }
              Text {
                anchors.verticalCenter: parent.verticalCenter
                text: root.phaseWord
                color: Theme.fg
                font.family: Theme.fontMono
                font.pixelSize: Theme.fontSize * 0.95
                font.bold: true
              }
            }
          }
          Text {
            Layout.alignment: Qt.AlignHCenter
            visible: root.working
            text: Math.max(0, Math.round((root.now - root.started) / 1000)) + " s"
            color: Theme.fgSubtle
            font.family: Theme.fontMono
            font.pixelSize: Theme.fontSize * 0.9
          }
        }

        // --- the conversation ---------------------------------------------------------------
        ColumnLayout {
          Layout.fillWidth: true
          Layout.fillHeight: true
          spacing: 12

          // Who it is, and what it's about.
          RowLayout {
            Layout.fillWidth: true
            spacing: 10
            Text {
              text: {{ tq "ask.title" }}
              color: Theme.fg
              font.family: Theme.fontMono
              font.pixelSize: Theme.fontSize * 1.45
              font.bold: true
            }
            Rectangle {
              visible: root.files.length > 0
              Layout.fillWidth: true
              Layout.maximumWidth: implicitWidth
              implicitWidth: aboutText.implicitWidth + 20
              implicitHeight: 24
              radius: 12
              color: Qt.alpha(root.readOnly ? Theme.warning : Theme.info, 0.12)
              border.width: 1
              border.color: Qt.alpha(root.readOnly ? Theme.warning : Theme.info, 0.4)
              Text {
                id: aboutText
                anchors.centerIn: parent
                width: Math.min(implicitWidth, parent.width - 20)
                elide: Text.ElideMiddle
                text: root.aboutDesktop ? "󰍹  " + {{ tq "ask.desktop.short" }}
                  : "󰈈  " + root.files.map(f => f.split("/").pop()).join(", ") + " · " + {{ tq "ask.readonly" }}
                color: Theme.fg
                font.family: Theme.fontMono
                font.pixelSize: Theme.fontSize * 0.9
                textFormat: Text.PlainText
              }
            }
            Item { Layout.fillWidth: true }
          }

          // Nothing asked yet: what it can do.
          ColumnLayout {
            visible: root.turns.length === 0 && root.phase !== "listening"
            Layout.fillWidth: true
            spacing: 10
            Text {
              Layout.fillWidth: true
              text: root.readOnly ? {{ tq "ask.hello.readonly" }} : {{ tq "ask.hello" }}
              color: Theme.fgMuted
              wrapMode: Text.Wrap
              font.family: Theme.fontUi
              font.pointSize: Theme.fontSize
            }
            Flow {
              visible: !root.readOnly
              Layout.fillWidth: true
              spacing: 8
              Repeater {
                model: root.ideas
                delegate: Rectangle {
                  id: idea
                  required property string modelData
                  implicitWidth: ideaText.implicitWidth + 24
                  implicitHeight: 30
                  radius: 15
                  color: ideaHover.hovered ? Qt.alpha(Theme.accent, 0.16) : Theme.surface
                  border.width: 1
                  border.color: ideaHover.hovered ? Qt.alpha(Theme.accent, 0.6) : Theme.border
                  Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 120 } }
                  Text {
                    id: ideaText
                    anchors.centerIn: parent
                    text: idea.modelData
                    color: Theme.fg
                    font.family: Theme.fontMono
                    font.pixelSize: Theme.fontSize * 0.98
                  }
                  HoverHandler { id: ideaHover; cursorShape: Qt.PointingHandCursor }
                  TapHandler { onTapped: root.ask(idea.modelData) }
                }
              }
            }
          }

          // The conversation, as bubbles, scrolled when long.
          Flickable {
            id: flick
            visible: root.turns.length > 0
            Layout.fillWidth: true
            Layout.fillHeight: true
            Layout.preferredHeight: Math.min(talk.implicitHeight, win.screenHeight * 0.48)
            contentWidth: width
            contentHeight: talk.implicitHeight
            clip: true
            boundsBehavior: Flickable.StopAtBounds
            ColumnLayout {
              id: talk
              width: flick.width
              spacing: 10
              Repeater {
                model: root.turns
                delegate: Item {
                  id: turn
                  required property var modelData
                  required property int index
                  readonly property bool me: !!modelData.me
                  readonly property bool bad: !!modelData.problem
                  readonly property color tone: me ? Theme.accent : bad ? Theme.danger : Theme.fg
                  Layout.fillWidth: true
                  implicitHeight: bubble.implicitHeight
                  Rectangle {
                    id: bubble
                    anchors.right: turn.me ? parent.right : undefined
                    anchors.left: turn.me ? undefined : parent.left
                    width: Math.min(parent.width * (turn.me ? 0.82 : 0.96), said.implicitWidth + 28)
                    implicitHeight: said.implicitHeight + 20
                    radius: Math.max(Theme.radius, 6)
                    color: turn.me ? Qt.alpha(Theme.accent, 0.16) : turn.bad ? Qt.alpha(Theme.danger, 0.1) : Theme.surface
                    border.width: 1
                    border.color: turn.me ? Qt.alpha(Theme.accent, 0.4) : turn.bad ? Qt.alpha(Theme.danger, 0.4) : Theme.border
                    opacity: 0
                    Component.onCompleted: opacity = 1
                    Behavior on opacity { enabled: Theme.motion; NumberAnimation { duration: 220 } }
                    TextEdit {
                      id: said
                      x: 14
                      y: 10
                      width: Math.min(implicitWidth, turn.width * (turn.me ? 0.82 : 0.96) - 28)
                      readOnly: true
                      selectByMouse: true
                      textFormat: turn.me || turn.bad ? TextEdit.PlainText : TextEdit.MarkdownText
                      text: turn.me || turn.bad ? turn.modelData.text : root.safe(turn.modelData.text)
                      wrapMode: TextEdit.Wrap
                      color: turn.bad ? Theme.danger : Theme.fg
                      selectionColor: Theme.selection
                      font.family: Theme.fontUi
                      font.pointSize: Theme.fontSize
                      font.bold: turn.me
                      onLinkActivated: link => { if (/^https?:\/\//.test(link)) Qt.openUrlExternally(link) }
                    }
                  }
                }
              }
            }
          }

          // Waiting for you: where to look.
          Rectangle {
            visible: root.phase === "waiting"
            Layout.fillWidth: true
            implicitHeight: waitRow.implicitHeight + 16
            radius: Math.max(Theme.radius, 6)
            color: Qt.alpha(Theme.warning, 0.12)
            border.width: 1
            border.color: Qt.alpha(Theme.warning, 0.45)
            RowLayout {
              id: waitRow
              anchors.fill: parent
              anchors.margins: 8
              anchors.leftMargin: 12
              spacing: 10
              Glyph { text: "󰔟"; color: Theme.warning }
              Label { text: {{ tq "ask.hint.approval" }}; wrapMode: Text.Wrap; Layout.fillWidth: true }
            }
          }

          // What it's doing now, in words.
          Text {
            visible: root.working && root.phase !== "waiting"
            Layout.fillWidth: true
            text: root.step
            color: Theme.fgMuted
            elide: Text.ElideRight
            font.family: Theme.fontMono
            font.pixelSize: Theme.fontSize
          }
          Text {
            visible: root.phase === "listening"
            Layout.fillWidth: true
            text: {{ tq "ask.listening" }}
            color: Theme.accentText
            wrapMode: Text.Wrap
            font.family: Theme.fontMono
            font.pixelSize: Theme.fontSize
          }

          // What you say next: a field with its microphone and its send.
          Rectangle {
            Layout.fillWidth: true
            implicitHeight: 46
            radius: Math.max(Theme.radius, 6)
            color: Theme.surface
            border.width: field.activeFocus ? 2 : 1
            border.color: field.activeFocus ? Theme.accent : Theme.border
            opacity: root.busy ? 0.6 : 1
            Behavior on border.color { enabled: Theme.motion; ColorAnimation { duration: 140 } }
            RowLayout {
              anchors.fill: parent
              anchors.leftMargin: 14
              anchors.rightMargin: 6
              spacing: 6
              TextInput {
                id: field
                Layout.fillWidth: true
                enabled: !root.busy
                color: Theme.fg
                selectionColor: Theme.selection
                font.family: Theme.fontUi
                font.pointSize: Theme.fontSize * 1.08
                clip: true
                function focusInput() { forceActiveFocus() }
                onAccepted: { const q = text.trim(); if (q !== "") { text = ""; root.ask(q) } }
                Keys.onEscapePressed: root.close()
                Text {
                  anchors.fill: parent
                  verticalAlignment: Text.AlignVCenter
                  visible: field.text === ""
                  text: root.turns.length > 0 ? {{ tq "ask.more" }} : root.readOnly ? {{ tq "ask.placeholder" }} : {{ tq "ask.placeholder.act" }}
                  color: Theme.fgSubtle
                  font: field.font
                  elide: Text.ElideRight
                }
              }
              IconButton {
                visible: root.canDictate
                glyph: root.phase === "listening" ? "󰏤" : "󰍬"
                lit: root.phase === "listening"
                enabled: !root.busy
                onClicked: root.listen()
              }
              IconButton {
                glyph: "󰒊"
                lit: field.text.trim() !== ""
                enabled: !root.busy && field.text.trim() !== ""
                onClicked: field.accepted()
              }
            }
          }

          // Who answered, and what can be done with it.
          RowLayout {
            Layout.fillWidth: true
            spacing: 8
            Rectangle {
              visible: root.agentName !== ""
              implicitWidth: whoText.implicitWidth + 18
              implicitHeight: 24
              radius: 12
              color: Qt.alpha(Theme.fg, 0.06)
              Text {
                id: whoText
                anchors.centerIn: parent
                text: "󰚩  " + [root.agentName, AgentsService.masked(root.account)].filter(s => s).join(" · ")
                color: Theme.fgMuted
                font.family: Theme.fontMono
                font.pixelSize: Theme.fontSize * 0.85
                textFormat: Text.PlainText
              }
            }
            Item { Layout.fillWidth: true }
            Chip {
              visible: root.busy
              glyph: "󰓛"
              text: {{ tq "ask.cancel" }}
              onClicked: root.cancel()
            }
            Chip {
              visible: root.undoId !== "" && !root.working
              glyph: "󰕌"
              text: {{ tq "ask.undo" }}
              onClicked: root.undo()
            }
            Chip {
              visible: root.lastAnswer !== "" && !root.busy
              glyph: copied ? "󰄬" : "󰆏"
              text: {{ tq "ask.copy" }}
              property bool copied: false
              onClicked: { Quickshell.execDetached(["wl-copy", "--", root.lastAnswer]); copied = true; copiedTimer.restart() }
              Timer { id: copiedTimer; interval: 1500; onTriggered: parent.copied = false }
            }
            Chip {
              visible: !!root.resume && !root.busy
              glyph: "󰆍"
              text: {{ tq "ask.continue" }}
              onClicked: { root.terminal(root.resume); root.close() }
            }
          }
        }
      }
    }
  }

  // A small round button with a glyph; lit when it's what's next.
  component IconButton: Rectangle {
    id: ib
    property string glyph: ""
    property bool lit: false
    signal clicked()
    implicitWidth: 34
    implicitHeight: 34
    radius: 17
    opacity: enabled ? 1 : 0.4
    color: lit ? Theme.accent : ibHover.hovered ? Qt.alpha(Theme.fg, 0.08) : "transparent"
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 120 } }
    Text {
      anchors.centerIn: parent
      text: ib.glyph
      color: ib.lit ? Theme.accentFg : Theme.fgMuted
      font.family: Theme.fontMono
      font.pixelSize: 16
    }
    HoverHandler { id: ibHover; cursorShape: Qt.PointingHandCursor }
    TapHandler { onTapped: if (ib.enabled) ib.clicked() }
  }

  // An action under the conversation: a glyph and a word.
  component Chip: Rectangle {
    id: chip
    property string glyph: ""
    property string text: ""
    signal clicked()
    implicitWidth: chipRow.implicitWidth + 20
    implicitHeight: 30
    radius: 15
    color: chipHover.hovered ? Theme.surfaceRaised : Theme.surface
    border.width: 1
    border.color: chipHover.hovered ? Qt.alpha(Theme.accent, 0.55) : Theme.border
    Behavior on color { enabled: Theme.motion; ColorAnimation { duration: 120 } }
    Row {
      id: chipRow
      anchors.centerIn: parent
      spacing: 7
      Text { anchors.verticalCenter: parent.verticalCenter; text: chip.glyph; color: Theme.accentText; font.family: Theme.fontMono; font.pixelSize: 14 }
      Text { anchors.verticalCenter: parent.verticalCenter; text: chip.text; color: Theme.fg; font.family: Theme.fontMono; font.pixelSize: Theme.fontSize * 0.95 }
    }
    HoverHandler { id: chipHover; cursorShape: Qt.PointingHandCursor }
    TapHandler { onTapped: chip.clicked() }
  }
}
