// Generated by mazapan (plugin {{ plugin }}).
//
// The answer to a question asked from the palette ("? question"), or
// about something (a capture, the selected text, files: asked here): the
// first coding agent answers it without its interface (`mazapan agents
// ask`: Claude with the account that has room and Mazapán's read-only
// tools), shown here; copied, or continued in a terminal.
//   qs ipc -c mazapan call mazapan open ask PATH
// PATH: a request in $XDG_RUNTIME_DIR/mazapan-ask, {"question": "…",
// "files": ["/…"]} (bin/agent-ask writes it; an argument's brackets are
// qs ipc's own).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  property string question: ""
  property var files: []           // what it's about
  property bool typing: false      // waiting for the question
  property string answer: ""
  property string problem: ""
  property string agentName: ""
  property var resume: null
  property double started: 0
  property double now: 0
  property int asked: 0            // which ask a result belongs to (a cancelled one's is dropped)
  property int running_: 0

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    open = true
  }
  function close() {
    open = false
    cancel()
  }

  // A request written for this (read, then gone).
  function showWith(path) {
    if (!/^\/.*\/mazapan-ask\/r-\d+\.json$/.test(path)) return
    reader.command = ["sh", "-c", 'cat -- "$0" && rm -f -- "$0"', path]
    reader.running = true
  }
  Process {
    id: reader
    stdout: StdioCollector {
      onStreamFinished: {
        let r = {}
        try { r = JSON.parse(text) } catch (e) { return }
        root.cancel()
        root.files = (r.files || []).filter(f => typeof f === "string" && f.startsWith("/"))
        root.answer = ""
        root.problem = ""
        root.resume = null
        root.agentName = ""
        root.question = (r.question || "").trim()
        root.typing = root.question === ""
        root.show()
        if (root.typing) Qt.callLater(() => field.focusInput())
        else root.ask()
      }
    }
  }
  function ask() {
    if (question === "") return
    typing = false
    // The field goes: Esc still has to close the card.
    card.forceActiveFocus()
    asked++
    running_ = asked
    asking.command = ["mazapan", "agents", "ask", "--json"].concat(...files.map(f => ["--file", f])).concat(["--", question])
    started = Date.now()
    now = started
    asking.running = true
  }
  // Shown as Markdown, without what would load by itself: an image (or HTML)
  // the answer names could carry what the agent read to a server, unclicked.
  // Every "![" made a plain link (nothing loads by itself), reference
  // definitions taken out (they'd make "[x]" a link to anywhere), and tags.
  function safe(md) {
    return md.replace(/!\[/g, "[").replace(/^ {0,3}\[[^\]\n]+\]:.*$/gm, "").replace(/<[^>]*>/g, "")
  }
  function cancel() {
    running_ = 0
    if (asking.running) asking.running = false
  }
  Process {
    id: asking
    stdout: StdioCollector {
      onStreamFinished: {
        if (root.running_ !== root.asked) return
        try {
          const r = JSON.parse(text)
          root.agentName = r.name || ""
          root.answer = r.answer || ""
          root.problem = r.problem || ""
          root.resume = r.resume || null
        } catch (e) {
          if (root.answer === "") root.problem = text.trim() || {{ tq "ask.failed" }}
        }
      }
    }
    stderr: StdioCollector { id: askErr }
    onExited: code => {
      if (root.running_ !== root.asked) return
      if (root.answer === "" && root.problem === "") root.problem = askErr.text.trim().split("\n").pop() || {{ tq "ask.failed" }}
    }
  }
  Timer { interval: 1000; repeat: true; running: asking.running; onTriggered: root.now = Date.now() }

  function terminal(argv) {
    // The person's terminal, as other panels open one (xdg-terminal-exec, else foot).
    Quickshell.execDetached({ command: ["sh", "-c", 'if command -v xdg-terminal-exec >/dev/null; then exec xdg-terminal-exec "$@"; else exec foot "$@"; fi', "sh"].concat(argv),
      workingDirectory: Quickshell.env("HOME") })
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    readonly property real screenHeight: screen ? screen.height : 1080
    implicitWidth: Math.max(480, Math.min(720, (screen ? screen.width : 1280) * 0.55))
    implicitHeight: Math.min(card.implicitHeight, screenHeight * 0.75)
    anchors.top: true
    margins.top: Math.round(screenHeight * 0.16)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-ask"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      anchors.fill: parent
      implicitHeight: col.implicitHeight + 32
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: root.close()

      ColumnLayout {
        id: col
        anchors.fill: parent
        anchors.margins: 16
        spacing: 10

        // What it's about.
        Caption {
          visible: root.files.length > 0
          text: "󰁦 " + root.files.map(f => f.split("/").pop()).join(", ")
          color: Theme.fgMuted
          elide: Text.ElideMiddle
          Layout.fillWidth: true
        }
        TextField {
          id: field
          visible: root.typing
          Layout.fillWidth: true
          placeholder: {{ tq "ask.placeholder" }}
          onAccepted: { root.question = text.trim(); text = ""; root.ask() }
        }

        RowLayout {
          visible: !root.typing
          Layout.fillWidth: true
          spacing: 8
          Glyph { text: "󰚩"; color: Theme.fgMuted }
          Label {
            text: root.question
            font.bold: true
            wrapMode: Text.Wrap
            maximumLineCount: 3
            elide: Text.ElideRight
            Layout.fillWidth: true
          }
        }

        Caption {
          visible: asking.running
          text: {{ tq "ask.thinking" }}.arg(Math.round((root.now - root.started) / 1000))
          color: Theme.fgSubtle
        }
        Caption {
          visible: root.problem !== ""
          text: root.problem
          color: Theme.danger
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }

        // The answer, as the agent wrote it (Markdown); selectable, scrolled when long.
        Flickable {
          id: flick
          visible: root.answer !== ""
          Layout.fillWidth: true
          Layout.fillHeight: true
          Layout.preferredHeight: Math.min(answerText.implicitHeight, win.screenHeight * 0.55)
          contentWidth: width
          contentHeight: answerText.implicitHeight
          clip: true
          boundsBehavior: Flickable.StopAtBounds
          TextEdit {
            id: answerText
            width: flick.width
            readOnly: true
            selectByMouse: true
            textFormat: TextEdit.MarkdownText
            text: root.safe(root.answer)
            wrapMode: TextEdit.Wrap
            color: Theme.fg
            selectionColor: Theme.selection
            font.family: Theme.fontUi
            font.pointSize: Theme.fontSize
            onLinkActivated: link => { if (/^https?:\/\//.test(link)) Qt.openUrlExternally(link) }
          }
        }

        RowLayout {
          Layout.fillWidth: true
          spacing: 8
          Caption { text: root.agentName; color: Theme.fgSubtle; Layout.fillWidth: true }
          Button {
            visible: asking.running
            text: {{ tq "ask.cancel" }}
            onClicked: root.cancel()
          }
          Button {
            visible: root.answer !== ""
            text: {{ tq "ask.copy" }}
            onClicked: Quickshell.execDetached(["wl-copy", "--", root.answer])
          }
          Button {
            visible: !!root.resume
            text: {{ tq "ask.continue" }}
            onClicked: { root.terminal(root.resume); root.close() }
          }
        }
      }
    }
  }
}
