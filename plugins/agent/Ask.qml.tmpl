// Generated by mazapan (plugin {{ plugin }}).
//
// The Ask card: Mazapan's agent, the mazapán. Asked by typing (here, or
// "? question" in the palette) or by voice (dictation's "ask by voice", or
// the microphone here), it answers, and when you ask for a change it makes
// it through Mazapan: Mazapan's own card shows you the diff and asks first
// (`mazapan agents ask --act`: Claude with Mazapan's tools, nothing else).
// The conversation goes on here; undone, copied, or continued in a
// terminal. About something not yours (a capture, the selected text, a
// notification, files) it only answers: what came from elsewhere can hold
// words meant to steer it.
//   qs ipc -c mazapan call mazapan open ask PATH
// PATH: a request in $XDG_RUNTIME_DIR/mazapan-ask, {"question": "…",
// "files": ["/…"], "follow": true, "listening": true} (bin/agent-ask writes
// it; an argument's brackets are qs ipc's own).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/agents"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null

  readonly property bool mascot: {{ settings.mascot }}
  readonly property bool canDictate: {{ if (under "~/.local/share/mazapan/bin/dictate").size > 0 }}true{{ else }}false{{ end }}
  readonly property string home: Quickshell.env("HOME")

  // The conversation: [{ me: bool, text }], the agent's session to go on with.
  property var turns: []
  property var files: []           // what it's about
  readonly property bool aboutDesktop: files.length === 1 && files[0].endsWith("/mazapan-ask/desktop.txt")
  // Material from elsewhere: it only answers.
  readonly property bool readOnly: files.length > 0 && !aboutDesktop
  property string session: ""
  property var resume: null
  property string agentName: ""
  property string account: ""
  property string undoId: ""       // the last change made here, to undo

  // What it's doing: idle, listening, thinking, working, waiting, done,
  // declined, error, sleeping; and the step, said.
  property string phase: "idle"
  property string step: ""
  property double started: 0
  property double now: 0
  property int asked: 0            // which ask a line belongs to (a cancelled one's are dropped)
  property int running_: 0

  readonly property string mood: phase === "listening" ? "listen" : phase === "thinking" ? "think"
    : phase === "working" ? "work" : phase === "waiting" ? "wait" : phase === "done" ? "happy"
    : phase === "declined" ? "shrug" : phase === "error" ? "dizzy" : phase === "sleeping" ? "sleep"
    : readOnly ? "read" : "idle"

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    open = true
    Qt.callLater(() => field.focusInput())
  }
  function close() {
    open = false
    cancel()
  }
  function reset() {
    cancel()
    turns = []
    session = ""
    resume = null
    agentName = ""
    account = ""
    undoId = ""
    phase = "idle"
    step = ""
  }

  // A request written for this (read, then gone).
  function showWith(path) {
    if (!/^\/.*\/mazapan-ask\/r-\d+\.json$/.test(path)) return
    reader.command = ["sh", "-c", 'cat -- "$0" && rm -f -- "$0"', path]
    reader.running = true
  }
  Process {
    id: reader
    stdout: StdioCollector {
      onStreamFinished: {
        let r = {}
        try { r = JSON.parse(text) } catch (e) { return }
        const q = (r.question || "").trim()
        // Said by voice in this conversation (the microphone here): goes on with it.
        const goOn = r.follow === true && root.open && root.turns.length > 0
        if (!goOn) {
          root.reset()
          root.files = (r.files || []).filter(f => typeof f === "string" && f.startsWith("/"))
        }
        root.show()
        if (r.listening === true) root.phase = "listening"
        else if (q !== "") root.ask(q)
      }
    }
  }

  function ask(q) {
    if (q === "" || asking.running) return
    turns = turns.concat([{ me: true, text: q }])
    asked++
    running_ = asked
    phase = "thinking"
    step = {{ tq "ask.step.looking" }}
    const flags = ["--stream", "--agent", {{ quote settings.ask_agent }}, "--model", {{ quote settings.ask_model }},
      "--account", {{ quote settings.ask_account }}, "--key", {{ quote settings.ask_credential }}]
    if (!readOnly) flags.push("--act")
    if (session !== "") flags.push("--resume", session)
    // This desktop's report is still being made when the card opens (it
    // takes seconds): waited for, up to 30 s, else asked without it.
    asking.command = ["sh", "-c", 'r=; for a in "$@"; do case "$a" in */mazapan-ask/desktop.txt) r=$a ;; esac; done; '
      + 'if [ -n "$r" ]; then n=0; while [ ! -e "$r" ] && [ -e "$r.part" ] && [ $n -lt 300 ]; do sleep 0.1; n=$((n+1)); done; '
      + '[ -e "$r" ] || { p=; for a; do shift; if [ -n "$p" ]; then [ "$a" = "$r" ] || set -- "$@" --file "$a"; p=; '
      + 'elif [ "$a" = "--file" ]; then p=1; else set -- "$@" "$a"; fi; done; }; fi; '
      + 'exec mazapan "$@"', "sh", "agents", "ask"].concat(flags)
      // The material goes with the first question only; then it's in the conversation.
      .concat(...(session === "" ? files : []).map(f => ["--file", f])).concat(["--", q])
    started = Date.now()
    now = started
    asking.running = true
  }

  // Shown as Markdown, without what would load by itself: an image (or HTML)
  // the answer names could carry what the agent read to a server, unclicked.
  // Every "![" made a plain link (nothing loads by itself), reference
  // definitions taken out (they'd make "[x]" a link to anywhere), and "<"
  // written as text (a tag shows as what it says: `--theme <id>`, never runs).
  function safe(md) {
    return md.replace(/!\[/g, "[").replace(/^ {0,3}\[[^\]\n]+\]:.*$/gm, "").replace(/&/g, "&amp;").replace(/</g, "&lt;")
  }
  function cancel() {
    running_ = 0
    if (asking.running) asking.running = false
    if (phase === "thinking" || phase === "working" || phase === "waiting") phase = "idle"
  }

  // Each line the agent says as it goes: a tool (looking, preparing a change,
  // waiting for you), a change made or turned down, and the answer, last.
  Process {
    id: asking
    property bool applied: false
    property bool declined: false
    onRunningChanged: if (running) { applied = false; declined = false }
    stdout: SplitParser {
      onRead: line => {
        if (root.running_ !== root.asked) return
        let e = {}
        try { e = JSON.parse(line) } catch (x) { return }
        if (e.event === "tool") {
          if (e.name === "preview_change") { root.phase = "working"; root.step = {{ tq "ask.step.preparing" }} }
          else if (e.name === "apply_change") { root.phase = "waiting"; root.step = {{ tq "ask.step.approval" }} }
          else if (e.name === "undo") { root.phase = "working"; root.step = {{ tq "ask.step.undoing" }} }
          else if (root.phase !== "working" && root.phase !== "waiting") { root.phase = "thinking"; root.step = {{ tq "ask.step.looking" }} }
        } else if (e.event === "applied") {
          asking.applied = true
          root.undoId = e.id || ""
        } else if (e.event === "declined") {
          asking.declined = true
        } else if (e.event === "done" || e.answer !== undefined) {
          root.agentName = e.name || ""
          root.account = e.account || ""
          if (e.session) root.session = e.session
          root.resume = e.resume || null
          if (e.problem) {
            root.turns = root.turns.concat([{ me: false, text: e.problem, problem: true }])
            root.phase = /limit/i.test(e.problem) ? "sleeping" : "error"
          } else {
            root.turns = root.turns.concat([{ me: false, text: e.answer || "" }])
            root.phase = asking.applied ? "done" : asking.declined ? "declined" : "idle"
          }
          root.step = ""
          Qt.callLater(() => { flick.contentY = Math.max(0, flick.contentHeight - flick.height); field.focusInput() })
        }
      }
    }
    stderr: StdioCollector { id: askErr }
    onExited: code => {
      if (root.running_ !== root.asked) return
      if (root.phase === "thinking" || root.phase === "working" || root.phase === "waiting") {
        root.turns = root.turns.concat([{ me: false, text: askErr.text.trim().split("\n").pop() || {{ tq "ask.failed" }}, problem: true }])
        root.phase = "error"
        root.step = ""
      }
    }
  }
  Timer { interval: 1000; repeat: true; running: asking.running; onTriggered: root.now = Date.now() }
  // A jump for a change made, a shrug for one turned down: then back to listening.
  Timer { interval: 2600; running: root.phase === "done" || root.phase === "declined"; onTriggered: root.phase = "idle" }

  // Undone: the change it made here, by its id (only if it's still the last one).
  Process {
    id: undoer
    onExited: code => {
      root.turns = root.turns.concat([{ me: false, text: code === 0 ? {{ tq "ask.undone" }} : {{ tq "ask.undo_failed" }}, problem: code !== 0 }])
      if (code === 0) root.undoId = ""
      root.phase = code === 0 ? "idle" : "error"
    }
  }
  function undo() {
    if (undoId === "" || undoer.running) return
    root.phase = "working"
    undoer.command = ["mazapan", "undo", "-y", "--id=" + undoId]
    undoer.running = true
  }

  // The microphone: dictation listens; what you said comes back as the next turn.
  Process { id: dictate }
  function listen() {
    if (!canDictate) return
    dictate.command = ["sh", home + "/.local/share/mazapan/bin/dictate", root.turns.length > 0 ? "reply" : "ask"]
    dictate.running = true
  }
  // Listening (here or from its key): dictation says so in its own file.
  Process {
    id: hearing
    command: ["sh", "-c", 'f="${XDG_RUNTIME_DIR:-/tmp}/mazapan-dictation/pid"; [ -f "$f" ] && read -r p h m < "$f" && kill -0 "$p" 2>/dev/null && [ "$m" != type ]']
    onExited: code => {
      if (code === 0 && !asking.running) root.phase = "listening"
      else if (code !== 0 && root.phase === "listening") root.phase = "idle"
    }
  }
  Timer { interval: 500; repeat: true; running: root.open && root.canDictate; onTriggered: if (!hearing.running) hearing.running = true }

  function terminal(argv) {
    // The person's terminal, as other panels open one (xdg-terminal-exec, else foot).
    Quickshell.execDetached({ command: ["sh", "-c", 'if command -v xdg-terminal-exec >/dev/null; then exec xdg-terminal-exec "$@"; else exec foot "$@"; fi', "sh"].concat(argv),
      workingDirectory: Quickshell.env("HOME") })
  }

  readonly property string lastAnswer: {
    for (let i = turns.length - 1; i >= 0; i--) if (!turns[i].me && !turns[i].problem) return turns[i].text
    return ""
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    readonly property real screenHeight: screen ? screen.height : 1080
    implicitWidth: Math.max(520, Math.min(760, (screen ? screen.width : 1280) * 0.55))
    implicitHeight: Math.min(card.implicitHeight, screenHeight * 0.78)
    anchors.top: true
    margins.top: Math.round(screenHeight * 0.14)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-ask"
    // Mazapan's approval card needs the pointer and keys while a change waits.
    WlrLayershell.keyboardFocus: root.phase === "waiting" ? WlrKeyboardFocus.OnDemand : WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      anchors.fill: parent
      implicitHeight: body.implicitHeight + 32
      color: Theme.surfaceRaised
      border.color: root.phase === "waiting" ? Theme.accent : Theme.border
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: root.close()
      Behavior on border.color { enabled: Theme.motion; ColorAnimation { duration: 200 } }

      RowLayout {
        id: body
        anchors.fill: parent
        anchors.margins: 16
        spacing: 16

        // The face: the mazapán, or a glyph and the step in words.
        ColumnLayout {
          Layout.alignment: Qt.AlignTop
          spacing: 6
          Mazapan {
            visible: root.mascot
            mood: root.mood
            zoom: 2
            Layout.alignment: Qt.AlignHCenter
          }
          Glyph {
            visible: !root.mascot
            text: root.phase === "waiting" ? "󰔟" : root.phase === "done" ? "󰄬" : root.phase === "error" ? "󰀦" : root.phase === "listening" ? "󰍬" : "󰚩"
            color: root.phase === "error" ? Theme.danger : root.phase === "done" ? Theme.success : Theme.accentText
            font.pointSize: 22
            Layout.alignment: Qt.AlignHCenter
          }
        }

        ColumnLayout {
          Layout.fillWidth: true
          Layout.fillHeight: true
          spacing: 10

          // What it's about: this desktop (mazapan's report), or the files, and if it only reads.
          Caption {
            visible: root.files.length > 0
            text: root.aboutDesktop ? "󰍹 " + {{ tq "ask.desktop" }}
              : "󰁦 " + root.files.map(f => f.split("/").pop()).join(", ") + "  ·  " + {{ tq "ask.readonly" }}
            color: Theme.fgMuted
            elide: Text.ElideMiddle
            Layout.fillWidth: true
          }

          // The conversation, scrolled when long.
          Flickable {
            id: flick
            visible: root.turns.length > 0
            Layout.fillWidth: true
            Layout.preferredHeight: Math.min(talk.implicitHeight, win.screenHeight * 0.5)
            contentWidth: width
            contentHeight: talk.implicitHeight
            clip: true
            boundsBehavior: Flickable.StopAtBounds
            ColumnLayout {
              id: talk
              width: flick.width
              spacing: 10
              Repeater {
                model: root.turns
                delegate: Item {
                  id: turn
                  required property var modelData
                  Layout.fillWidth: true
                  implicitHeight: turn.modelData.me ? mine.implicitHeight : theirs.implicitHeight
                  RowLayout {
                    id: mine
                    visible: turn.modelData.me
                    width: parent.width
                    spacing: 8
                    Glyph { text: "󰀄"; color: Theme.fgSubtle; Layout.alignment: Qt.AlignTop }
                    Label {
                      text: turn.modelData.text
                      font.bold: true
                      wrapMode: Text.Wrap
                      Layout.fillWidth: true
                    }
                  }
                  TextEdit {
                    id: theirs
                    visible: !turn.modelData.me
                    width: parent.width
                    readOnly: true
                    selectByMouse: true
                    textFormat: turn.modelData.problem ? TextEdit.PlainText : TextEdit.MarkdownText
                    text: turn.modelData.problem ? turn.modelData.text : root.safe(turn.modelData.text)
                    wrapMode: TextEdit.Wrap
                    color: turn.modelData.problem ? Theme.danger : Theme.fg
                    selectionColor: Theme.selection
                    font.family: Theme.fontUi
                    font.pointSize: Theme.fontSize
                    onLinkActivated: link => { if (/^https?:\/\//.test(link)) Qt.openUrlExternally(link) }
                  }
                }
              }
            }
          }

          // What it's doing now.
          Caption {
            visible: root.phase === "listening" || asking.running || undoer.running
            text: root.phase === "listening" ? {{ tq "ask.listening" }}
              : root.step + "  " + Math.round((root.now - root.started) / 1000) + " s"
            color: root.phase === "waiting" ? Theme.accentText : Theme.fgSubtle
            Layout.fillWidth: true
          }

          // What you say next.
          RowLayout {
            Layout.fillWidth: true
            spacing: 8
            TextField {
              id: field
              Layout.fillWidth: true
              enabled: !asking.running
              placeholder: root.turns.length > 0 ? {{ tq "ask.more" }} : root.readOnly ? {{ tq "ask.placeholder" }} : {{ tq "ask.placeholder.act" }}
              onAccepted: { const q = text.trim(); if (q !== "") { text = ""; root.ask(q) } }
            }
            Button {
              visible: root.canDictate
              text: root.phase === "listening" ? "󰏤" : "󰍬"
              primary: root.phase === "listening"
              enabled: !asking.running
              onClicked: root.listen()
            }
          }

          RowLayout {
            Layout.fillWidth: true
            spacing: 8
            Caption {
              text: [root.agentName, root.account].filter(s => s).join("  ·  ")
              color: Theme.fgSubtle
              elide: Text.ElideRight
              Layout.fillWidth: true
            }
            Button {
              visible: asking.running
              text: {{ tq "ask.cancel" }}
              onClicked: root.cancel()
            }
            Button {
              visible: root.undoId !== "" && !asking.running
              text: {{ tq "ask.undo" }}
              onClicked: root.undo()
            }
            Button {
              visible: root.lastAnswer !== "" && !asking.running
              text: {{ tq "ask.copy" }}
              onClicked: Quickshell.execDetached(["wl-copy", "--", root.lastAnswer])
            }
            Button {
              visible: !!root.resume && !asking.running
              text: {{ tq "ask.continue" }}
              onClicked: { root.terminal(root.resume); root.close() }
            }
          }
        }
      }
    }
  }
}
