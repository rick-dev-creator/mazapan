# Generated by mazapan (plugin {{ plugin }}): an API key into the keyring,
# for one provider, typed hidden (never in a command line or the history).
mazapan agents keys
echo
printf '%s ' {{ shq (t "keys.which") }}
read -r provider
[ -n "$provider" ] && mazapan agents keys set "$provider"
echo
printf '%s' {{ shq (t "keys.close") }}
read -r _
