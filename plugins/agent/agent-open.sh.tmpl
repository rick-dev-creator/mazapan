# Generated by mazapan (plugin {{ plugin }}): agent-open PATH [AGENT]
# reopens a project: its editor ({{ if settings.editor != "" }}{{ inline settings.editor }}{{ else }}none set{{ end }}, `editor`), and a terminal in it with
# the agent's last conversation there (Claude Code with the account that
# has room; opencode, Codex, pi each their own way).
p=$1
agent=${2:-claude}
[ -d "$p" ] || exit 1
cd "$p" || exit 1
{{- if settings.editor != "" }}
setsid sh -c {{ shq settings.editor }}' "$0"' "$p" >/dev/null 2>&1 &
{{- end }}
case "$agent" in
  claude) run='mazapan agents run claude --continue || mazapan agents run claude' ;;
  opencode) run='opencode --continue' ;;
  codex) run='codex resume --last' ;;
  pi) run='pi --continue' ;;
  *) run="$agent" ;;
esac
set -- sh -c "$run; exec \"\${SHELL:-sh}\""
if command -v xdg-terminal-exec >/dev/null; then exec setsid xdg-terminal-exec "$@"; else exec setsid foot "$@"; fi
