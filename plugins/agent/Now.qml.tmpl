// Generated by mazapan (plugin {{ plugin }}): an agent waiting, in the Control Center.
//
// A session that waits for you (a permission, a question): a card under
// Now that says which agent, where and what it asks, and Go to it takes
// you to its window. The pill says it too.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/agents"
import "../../components/control"

Group {
  id: root

  readonly property var waiting: AgentsService.sessions.filter(s => s.state === "waiting")
  readonly property var first: waiting.length > 0 ? waiting[0] : null
  readonly property bool live: first !== null
  readonly property int level: 1
  readonly property string pill: first ? AgentsService.nameOf(first.agent).split(" ")[0] + " · " + AgentsService.base(first.project) + " " + {{ tq "pill" }} : ""

  color: Qt.rgba(Theme.warning.r, Theme.warning.g, Theme.warning.b, 0.12)
  border.color: Theme.warning

  Repeater {
    model: root.waiting.slice(0, 3)
    RowLayout {
      required property var modelData
      Layout.fillWidth: true
      spacing: 10
      Glyph {
        text: "󱙺"
        color: Theme.warning
        font.pointSize: 15
      }
      ColumnLayout {
        Layout.fillWidth: true
        spacing: 2
        Label {
          text: {{ tq "n.waiting" }}.arg(AgentsService.nameOf(modelData.agent)).arg(AgentsService.base(modelData.project))
          font.bold: true
          wrapMode: Text.Wrap
          maximumLineCount: 2
          elide: Text.ElideRight
          Layout.fillWidth: true
        }
        Caption {
          visible: modelData.message !== ""
          text: modelData.message
          font.letterSpacing: 0
          elide: Text.ElideRight
          Layout.fillWidth: true
        }
      }
      Button {
        primary: true
        text: {{ tq "go" }}
        onClicked: {
          ControlService.close()
          AgentsService.focus(modelData.id)
        }
      }
    }
  }
}
