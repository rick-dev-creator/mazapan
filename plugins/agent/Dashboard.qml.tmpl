// Generated by mazapan (plugin {{ plugin }}): the agents' dashboard.
//
// Its own Quickshell process (qs -p this file; the launcher in
// ~/.local/share/mazapan/bin/agents-dashboard), beside the shell's files so it
// has the same theme and kit, but apart from the bar: a heavy view never
// slows it. Everything from `mazapan agents usage|limits --json`: what each
// agent, account, model and project used, by day; the cost as each model's
// API prices it (and what an API key was charged); when the answers come
// (weekday × hour); each account's limits. Numbers only.
//
// Drawn in {{ theme.id }} ({{ theme.colors.accent }}): a new theme or accent
// rewrites this file, and its reload brings an open dashboard along (the
// shell's reload doesn't reach this process).

import QtQuick
import QtQuick.Layouts
import QtGraphs
import Quickshell
import Quickshell.Io
import qs
import "components/kit"

FloatingWindow {
  id: win
  // An account's email, shown with most of it hidden (ri***v@gmail.com: its first
  // two letters and its last, so two accounts are told apart): it's personal,
  // and the screen may be shared or recorded.
  function masked(label) {
    const s = String(label || "")
    const at = s.indexOf("@")
    if (at < 1) return s
    const name = s.slice(0, at)
    return (name.length > 4 ? name.slice(0, 2) + "***" + name.slice(-1) : name.slice(0, 1) + "***") + s.slice(at)
  }
  // The same window across a reload (a new theme): it keeps its place.
  reloadableId: "agents-dashboard"

  title: {{ tq "dash.title" }}
  implicitWidth: 1180
  implicitHeight: 760
  color: Theme.bg
  // Closed, gone (Quickshell itself stays without windows).
  onClosed: Qt.quit()

  IpcHandler {
    target: "dashboard"
    function reload(): void {
      Quickshell.reload(false)
    }
  }
  Connections {
    target: Quickshell
    function onReloadCompleted() {
      Quickshell.inhibitReloadPopup()
    }
  }

  property int days: 30
  property string metric: "cost"   // cost (API prices) or tokens
  property var usageData: null     // usage --json ("data" is a window's children)
  property var limits: []          // limits --json accounts
  property var spend: []           // spend --json providers
  property bool loading: false

  // Each agent its own color, from the theme's terminal palette (the accent
  // stays for what's chosen; amber and red for what needs attention).
  readonly property var agentColor: ({ claude: Theme.ansi.yellow, opencode: Theme.ansi.blue, pi: Theme.ansi.green, codex: Theme.ansi.cyan,
    gemini: Theme.ansi.magenta, crush: Theme.ansi.brightBlue, aider: Theme.ansi.brightGreen })
  function colorOf(id) { return agentColor[id] || Theme.fgMuted }
  readonly property var names: ({ claude: "Claude Code", opencode: "OpenCode", pi: "Pi", codex: "Codex", gemini: "Gemini CLI", crush: "Crush", aider: "Aider" })
  function nameOf(id) { return names[id] || id }
  function base(p) { return String(p || "").split("/").filter(x => x !== "").pop() || "~" }
  function tokens(n) { return n >= 1e9 ? (n / 1e9).toFixed(1) + "B" : n >= 1e6 ? (n / 1e6).toFixed(1) + "M" : n >= 1e3 ? Math.round(n / 1e3) + "k" : String(Math.round(n)) }
  readonly property var locale: Qt.locale("{{ lang }}")
  function whole(n) { return Number(Math.round(n)).toLocaleString(locale, "f", 0) }
  function usd(x) { return "$" + (x >= 100 ? whole(x) : Number(x).toLocaleString(locale, "f", 2)) }
  function tok(r) { return r.input + r.output + r.cache_read + r.cache_write }
  function val(r) { return metric === "cost" ? r.cost_api : tok(r) }
  function show(x) { return metric === "cost" ? usd(x) : tokens(x) }
  // The chart's own: tokens in millions (an axis of nine digits reads badly).
  function chartVal(r) { return metric === "cost" ? r.cost_api : tok(r) / 1e6 }

  // Asked again while a read runs (another period): read again when it ends.
  property bool again: false
  function load() {
    loading = true
    if (usage.running) { again = true; return }
    usage.command = ["mazapan", "agents", "usage", "--json", "--days", String(days)]
    usage.running = true
    if (!limitsProc.running) limitsProc.running = true
    if (!spendProc.running) {
      spendProc.command = ["mazapan", "agents", "spend", "--json", "--days", String(days)]
      spendProc.running = true
    }
  }
  Component.onCompleted: load()

  Process {
    id: usage
    stdout: StdioCollector {
      onStreamFinished: {
        try { win.usageData = JSON.parse(text) } catch (e) { win.usageData = null }
        win.loading = false
        if (win.again) { win.again = false; Qt.callLater(win.load) }
      }
    }
  }
  Process {
    id: limitsProc
    command: ["mazapan", "agents", "limits", "--json"]
    stdout: StdioCollector { onStreamFinished: { try { win.limits = JSON.parse(text).accounts || [] } catch (e) {} } }
  }
  Process {
    id: spendProc
    stdout: StdioCollector { onStreamFinished: { try { win.spend = JSON.parse(text).providers || [] } catch (e) {} } }
  }
  // Fresh every five minutes while open.
  Timer { interval: 300000; repeat: true; running: true; onTriggered: win.load() }

  // --- what the rows say --------------------------------------------------------------

  readonly property var rows: usageData ? usageData.rows || [] : []
  // Every day of the period, oldest first (days with nothing are zero).
  readonly property var dayList: {
    const out = []
    const d = new Date()
    d.setHours(12, 0, 0, 0)
    for (let i = days - 1; i >= 0; i--) {
      const x = new Date(d.getTime() - i * 86400000)
      // The local day (an ISO string is UTC's: a day off east of +12).
      out.push(x.getFullYear() + "-" + String(x.getMonth() + 1).padStart(2, "0") + "-" + String(x.getDate()).padStart(2, "0"))
    }
    return out
  }
  readonly property var agentList: [...new Set(rows.map(r => r.agent))]
  function sumBy(key) {
    const m = {}
    for (const r of rows) {
      const k = r[key] || "?"
      const e = m[k] || (m[k] = { key: k, value: 0, tokens: 0, cost: 0, answers: 0 })
      e.value += val(r); e.tokens += tok(r); e.cost += r.cost_api; e.answers += r.requests
    }
    return Object.values(m).sort((a, b) => b.value - a.value)
  }
  readonly property var byModel: sumBy("model")
  readonly property var byProject: sumBy("project")
  readonly property var totals: {
    const t = { tokens: 0, cost: 0, paid: 0, answers: 0, cacheRead: 0, input: 0, cacheWrite: 0, sessions: 0, unpriced: 0 }
    for (const r of rows) {
      t.tokens += tok(r); t.cost += r.cost_api; t.paid += r.cost_reported; t.answers += r.requests
      t.cacheRead += r.cache_read; t.input += r.input; t.cacheWrite += r.cache_write; t.unpriced += r.unpriced
    }
    for (const s of (usageData && usageData.sessions) || []) t.sessions += s.count
    return t
  }
  // OpenTelemetry's (Claude Code): lines, commits, pull requests, active time over the period.
  readonly property var otel: {
    const t = { added: 0, removed: 0, commits: 0, prs: 0, user: 0, cli: 0, any: false }
    for (const d of (usageData && usageData.otel) || []) {
      t.added += d.lines_added; t.removed += d.lines_removed; t.commits += d.commits; t.prs += d.pull_requests
      t.user += d.active_user_s; t.cli += d.active_cli_s; t.any = true
    }
    return t
  }
  function hm(s) { const m = Math.round(s / 60); return m < 60 ? {{ tq "min" }}.arg(m) : {{ tq "hours" }}.arg(Math.floor(m / 60)).arg(m % 60) }
  readonly property real cacheShare: totals.cacheRead / Math.max(1, totals.cacheRead + totals.input + totals.cacheWrite)
  // Day labels: every one for a week, fewer as the period grows.
  function dayLabel(day, i) {
    const step = days <= 7 ? 1 : days <= 30 ? 5 : 15
    // Each one its own (an axis drops a category it has already): blank, by its count of invisible spaces.
    if (i % step !== 0 && i !== dayList.length - 1) return "\u200b".repeat(i + 1)
    return new Date(day + "T12:00:00").toLocaleDateString(Qt.locale("{{ lang }}"), days <= 7 ? "ddd" : "d MMM")
  }
  readonly property real dayMax: {
    let m = 0
    for (const day of dayList) {
      let s = 0
      for (const r of rows) if (r.day === day) s += chartVal(r)
      m = Math.max(m, s)
    }
    return m
  }

  // --- the view -----------------------------------------------------------------

  // A choice among a few (days, cost or tokens): quiet, the chosen one raised.
  component Segmented: Rectangle {
    id: seg
    property var options: []   // [[value, label]…]
    property var current
    signal picked(var value)
    implicitWidth: row.implicitWidth + 4
    implicitHeight: 30
    radius: Theme.radius
    color: Theme.bgAlt
    Row {
      id: row
      x: 2
      y: 2
      spacing: 2
      Repeater {
        model: seg.options
        Rectangle {
          required property var modelData
          readonly property bool chosen: seg.current === modelData[0]
          implicitWidth: label.implicitWidth + 22
          implicitHeight: 26
          radius: Theme.radius
          color: chosen ? Theme.surfaceRaised : area.containsMouse ? Theme.surface : "transparent"
          border.width: chosen ? 1 : 0
          border.color: Theme.border
          Text {
            id: label
            anchors.centerIn: parent
            text: modelData[1]
            color: chosen ? Theme.fg : Theme.fgMuted
            font.family: Theme.fontMono
            font.pointSize: 9
          }
          MouseArea { id: area; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor; onClicked: seg.picked(modelData[0]) }
        }
      }
    }
  }

  Flickable {
    id: flick
    anchors.fill: parent
    contentWidth: width
    contentHeight: page.implicitHeight + 40
    clip: true

    ColumnLayout {
      id: page
      x: 24
      y: 20
      // The window's width (inside a Flickable, a parent is its content).
      width: flick.width - 48
      spacing: 16

      RowLayout {
        Layout.fillWidth: true
        spacing: 8
        Label { text: {{ tq "dash.title" }}; font.pointSize: 15; font.bold: true }
        Item { Layout.fillWidth: true }
        Segmented {
          options: [[7, {{ tq "dash.days" }}.arg(7)], [30, {{ tq "dash.days" }}.arg(30)], [90, {{ tq "dash.days" }}.arg(90)]]
          current: win.days
          onPicked: v => { win.days = v; win.load() }
        }
        Item { implicitWidth: 8 }
        Segmented {
          options: [["cost", {{ tq "dash.cost" }}], ["tokens", {{ tq "dash.tokens" }}]]
          current: win.metric
          onPicked: v => win.metric = v
        }
      }

      // The period in five numbers.
      RowLayout {
        Layout.fillWidth: true
        spacing: 12
        Repeater {
          model: [
            [{{ tq "dash.api_cost" }}, win.usd(win.totals.cost) + (win.totals.unpriced > 0 ? " *" : "")],
            [{{ tq "dash.paid" }}, win.usd(win.totals.paid)],
            [{{ tq "dash.tok" }}, win.tokens(win.totals.tokens)],
            [{{ tq "dash.answers" }}, win.whole(win.totals.answers)],
            [{{ tq "dash.sessions" }}, win.whole(win.totals.sessions)],
            [{{ tq "dash.cache" }}, Math.round(win.cacheShare * 100) + "%"],
          ]
          Rectangle {
            required property var modelData
            Layout.fillWidth: true
            implicitHeight: 64
            radius: Theme.radius
            color: Theme.bgAlt
            ColumnLayout {
              anchors.fill: parent
              anchors.margins: 10
              spacing: 2
              Caption { text: modelData[0].toUpperCase() }
              Label { text: modelData[1]; font.pointSize: 14; font.bold: true }
            }
          }
        }
      }
      // What Claude Code's OpenTelemetry adds: the work itself.
      RowLayout {
        visible: win.otel.any
        Layout.fillWidth: true
        spacing: 12
        Repeater {
          model: [
            [{{ tq "dash.lines" }}, "+" + win.whole(win.otel.added) + "  −" + win.whole(win.otel.removed)],
            [{{ tq "dash.commits" }}, win.whole(win.otel.commits) + (win.otel.prs > 0 ? "  · " + {{ tq "dash.prs" }}.arg(win.whole(win.otel.prs)) : "")],
            [{{ tq "dash.active_you" }}, win.hm(win.otel.user)],
            [{{ tq "dash.active_agent" }}, win.hm(win.otel.cli)],
          ]
          Rectangle {
            required property var modelData
            Layout.fillWidth: true
            implicitHeight: 64
            radius: Theme.radius
            color: Theme.bgAlt
            ColumnLayout {
              anchors.fill: parent
              anchors.margins: 10
              spacing: 2
              Caption { text: modelData[0].toUpperCase() }
              Label { text: modelData[1]; font.pointSize: 14; font.bold: true }
            }
          }
        }
      }
      Caption {
        visible: win.totals.unpriced > 0 || (win.usageData && (win.usageData.problems || []).length > 0)
        text: (win.totals.unpriced > 0 ? {{ tq "dash.unpriced" }} : "") + ((win.usageData && win.usageData.problems || []).length ? "  " + win.usageData.problems.join(" · ") : "")
        color: Theme.fgSubtle
        wrapMode: Text.Wrap
        Layout.fillWidth: true
      }

      // By day, each agent a color.
      Caption { text: (win.metric === "cost" ? {{ tq "dash.by_day_cost" }} : {{ tq "dash.by_day_tokens" }}).toUpperCase() }
      GraphsView {
        Layout.fillWidth: true
        Layout.preferredHeight: 260
        theme: GraphsTheme {
          colorScheme: Theme.mode === "light" ? GraphsTheme.ColorScheme.Light : GraphsTheme.ColorScheme.Dark
          backgroundVisible: false
          plotAreaBackgroundColor: "transparent"
          labelTextColor: Theme.fgMuted
          labelFont.family: Theme.fontMono
          grid.mainColor: Qt.rgba(Theme.border.r, Theme.border.g, Theme.border.b, 0.5)
          grid.subColor: "transparent"
          axisX.mainColor: Theme.border
          axisY.mainColor: Theme.border
        }
        axisX: BarCategoryAxis { categories: win.dayList.map((d, i) => win.dayLabel(d, i)) }
        axisY: ValueAxis {
          max: Math.max(1, win.dayMax * 1.1)
          labelDecimals: win.dayMax < 10 ? 1 : 0
        }
        BarSeries {
          id: series
          barsType: BarSeries.BarsType.Stacked
          barWidth: 0.7
        }
        // One set per agent, made again when the data changes.
        Instantiator {
          model: win.agentList
          delegate: BarSet {
            required property string modelData
            required property int index
            label: win.nameOf(modelData)
            color: win.colorOf(modelData)
            values: win.dayList.map(day => win.rows.filter(r => r.day === day && r.agent === modelData).reduce((s, r) => s + win.chartVal(r), 0))
          }
          onObjectAdded: (i, set) => series.append(set)
          onObjectRemoved: (i, set) => series.remove(set)
        }
      }
      RowLayout {
        spacing: 16
        Repeater {
          model: win.agentList
          RowLayout {
            required property string modelData
            required property int index
            spacing: 6
            Rectangle { implicitWidth: 10; implicitHeight: 10; radius: 2; color: win.colorOf(modelData) }
            Caption { text: win.nameOf(modelData) }
          }
        }
      }

      // By model and by project: bars of their share.
      RowLayout {
        Layout.fillWidth: true
        spacing: 24
        Repeater {
          model: [[{{ tq "dash.by_model" }}, win.byModel, false], [{{ tq "dash.by_project" }}, win.byProject, true]]
          ColumnLayout {
            id: col
            required property var modelData
            Layout.fillWidth: true
            Layout.preferredWidth: 1
            Layout.alignment: Qt.AlignTop
            spacing: 6
            Caption { text: col.modelData[0].toUpperCase() }
            Repeater {
              model: col.modelData[1].slice(0, 8)
              RowLayout {
                required property var modelData
                Layout.fillWidth: true
                spacing: 8
                Label { text: col.modelData[2] ? win.base(modelData.key) : modelData.key; elide: Text.ElideMiddle; Layout.preferredWidth: 200 }
                Rectangle {
                  Layout.fillWidth: true
                  implicitHeight: 8
                  radius: 3
                  color: Theme.bgAlt
                  Rectangle {
                    width: parent.width * (modelData.value / Math.max(1e-9, col.modelData[1][0].value))
                    height: parent.height
                    radius: 3
                    color: Theme.fgMuted
                    opacity: 0.55
                  }
                }
                Caption { text: win.show(modelData.value); Layout.preferredWidth: 70; horizontalAlignment: Text.AlignRight }
              }
            }
          }
        }
      }

      // When the answers come, and each account's limits.
      RowLayout {
        Layout.fillWidth: true
        spacing: 24
        ColumnLayout {
          Layout.alignment: Qt.AlignTop
          spacing: 4
          Caption { text: {{ tq "dash.hours" }}.toUpperCase() }
          Repeater {
            model: (win.usageData && win.usageData.hours) || []
            RowLayout {
              id: dayRow
              required property var modelData
              required property int index
              spacing: 2
              readonly property real peak: Math.max(1, ...((win.usageData && win.usageData.hours) || [[1]]).map(h => Math.max(...h)))
              Caption {
                text: Qt.locale("{{ lang }}").dayName((dayRow.index + 1) % 7, Locale.ShortFormat)
                Layout.preferredWidth: 36
              }
              Repeater {
                model: dayRow.modelData
                Rectangle {
                  required property var modelData
                  implicitWidth: 16
                  implicitHeight: 14
                  radius: 2
                  color: modelData > 0 ? Theme.fg : Theme.bgAlt
                  opacity: modelData > 0 ? 0.08 + 0.8 * modelData / dayRow.peak : 1
                }
              }
            }
          }
          // The hours under their cells (each 16 px and 2 apart, after the day's name).
          Item {
            implicitWidth: 38 + 24 * 18
            implicitHeight: 14
            Repeater {
              model: [0, 6, 12, 18, 23]
              Caption {
                required property int modelData
                x: 38 + modelData * 18
                text: modelData + "h"
                color: Theme.fgSubtle
              }
            }
          }
        }
        ColumnLayout {
          Layout.fillWidth: true
          Layout.alignment: Qt.AlignTop
          spacing: 6
          Caption { text: {{ tq "limits" }}.toUpperCase() }
          Caption { visible: win.limits.length === 0; text: {{ tq "dash.no_limits" }}; color: Theme.fgSubtle }
          Repeater {
            model: win.limits
            ColumnLayout {
              id: acct
              required property var modelData
              Layout.fillWidth: true
              spacing: 4
              RowLayout {
                Layout.fillWidth: true
                Label { text: win.masked(acct.modelData.account.label); Layout.fillWidth: true; elide: Text.ElideRight }
                Caption { text: acct.modelData.account.plan + (acct.modelData.stale && acct.modelData.read !== "" ? " · " + {{ tq "dash.stale" }} : ""); color: Theme.fgSubtle }
              }
              Caption {
                visible: acct.modelData.windows.length === 0 && acct.modelData.problem !== ""
                text: acct.modelData.problem
                color: Theme.fgSubtle
                wrapMode: Text.Wrap
                Layout.fillWidth: true
              }
              Repeater {
                model: acct.modelData.windows
                RowLayout {
                  required property var modelData
                  Layout.fillWidth: true
                  spacing: 8
                  Caption { text: modelData.name === "session" ? {{ tq "w.session" }} : modelData.name === "week" ? {{ tq "w.week" }} : modelData.name; Layout.preferredWidth: 120; elide: Text.ElideRight }
                  Rectangle {
                    Layout.fillWidth: true
                    implicitHeight: 8
                    radius: 3
                    color: Theme.bgAlt
                    Rectangle {
                      width: parent.width * Math.min(1, modelData.percent / 100)
                      height: parent.height
                      radius: 3
                      color: modelData.percent >= 90 ? Theme.danger : modelData.percent >= 80 ? Theme.warning : Theme.fgMuted
                      opacity: acct.modelData.stale ? 0.4 : 1
                    }
                  }
                  Caption { text: Math.round(modelData.percent) + "%"; Layout.preferredWidth: 40; horizontalAlignment: Text.AlignRight }
                }
              }
            }
          }

          // What the providers themselves say was spent (their keys in the keyring).
          Item { implicitHeight: 6 }
          Caption { text: {{ tq "spend" }}.toUpperCase() }
          Caption { visible: win.spend.length === 0; text: {{ tq "dash.no_spend" }}; color: Theme.fgSubtle; wrapMode: Text.Wrap; Layout.fillWidth: true }
          Repeater {
            model: win.spend
            ColumnLayout {
              id: prov
              required property var modelData
              Layout.fillWidth: true
              spacing: 4
              RowLayout {
                Layout.fillWidth: true
                Label { text: prov.modelData.name; Layout.fillWidth: true; elide: Text.ElideRight }
                Caption {
                  text: prov.modelData.problem !== "" ? prov.modelData.problem
                    : {{ tq "spend.row" }}.arg(win.usd(prov.modelData.today)).arg(win.days).arg(win.usd(prov.modelData.period))
                  color: Theme.fgSubtle
                }
              }
              // Its limit, where the key has one.
              RowLayout {
                visible: prov.modelData.limit !== null && prov.modelData.remaining !== null
                Layout.fillWidth: true
                spacing: 8
                Rectangle {
                  readonly property real used: prov.modelData.limit ? 1 - prov.modelData.remaining / prov.modelData.limit : 0
                  Layout.fillWidth: true
                  implicitHeight: 8
                  radius: 3
                  color: Theme.bgAlt
                  Rectangle {
                    width: parent.width * Math.min(1, Math.max(0, parent.used))
                    height: parent.height
                    radius: 3
                    color: parent.used >= 0.9 ? Theme.danger : parent.used >= 0.8 ? Theme.warning : Theme.fgMuted
                  }
                }
                Caption { text: {{ tq "spend.left" }}.arg(win.usd(prov.modelData.remaining || 0)).arg(win.usd(prov.modelData.limit || 0)) }
              }
            }
          }
        }
      }
    }
  }
}
