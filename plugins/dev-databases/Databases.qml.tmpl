// Generated by mazapan (plugin {{ plugin }}).
//
// Databases for development, one click each: PostgreSQL, MySQL, Redis, SQL
// Server, MongoDB in containers (bin/devdb), on this computer alone, their
// data kept between starts. Start or stop, copy how to connect (.NET's
// connection string, or a URL), or remove one with its data.
//   qs ipc -c mazapan call mazapan panel databases

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  property var dbs: []            // [{name, state, port}]
  property string busy: ""        // the one being started, stopped or removed
  property string armed: ""       // remove: asked once
  property string message: ""
  property bool failed: false

  readonly property string script: Quickshell.env("HOME") + "/.local/share/mazapan/bin/devdb"
  readonly property var names: ({ postgres: "PostgreSQL", mysql: "MySQL", redis: "Redis", sqlserver: "SQL Server", mongodb: "MongoDB" })

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    message = ""
    armed = ""
    lister.running = true
    open = true
  }
  function close() { open = false }

  Process {
    id: lister
    command: ["sh", root.script, "list"]
    stdout: StdioCollector { onStreamFinished: { try { root.dbs = JSON.parse(text) } catch (e) {} } }
  }
  Timer { interval: 3000; repeat: true; running: root.open; onTriggered: if (!lister.running) lister.running = true }

  function act(verb, name) {
    if (busy !== "") return
    if (verb === "remove" && armed !== name) {
      armed = name
      message = {{ tq "remove_confirm" }}.arg(names[name])
      failed = false
      return
    }
    armed = ""
    busy = name
    message = verb === "start" ? {{ tq "starting" }}.arg(names[name]) : verb === "stop" ? {{ tq "stopping" }}.arg(names[name]) : {{ tq "removing" }}.arg(names[name])
    failed = false
    doing.command = ["sh", root.script, verb, name]
    doing.running = true
  }
  Process {
    id: doing
    stderr: StdioCollector { id: doingErr }
    onExited: code => {
      root.failed = code !== 0
      root.message = code === 0 ? "" : (doingErr.text.trim().split("\n").pop() || {{ tq "failed" }})
      root.busy = ""
      lister.running = true
    }
  }

  // How to connect, to the clipboard (marked secret: the history doesn't keep it).
  function copy(name, kind) {
    copier.command = ["sh", "-c", 'sh "$0" string "$1" "$2" | tr -d "\\n" | { wl-copy --sensitive 2>/dev/null || wl-copy; }', root.script, name, kind]
    copier.running = true
    message = {{ tq "copied" }}.arg(names[name])
    failed = false
  }
  Process { id: copier }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: 620
    implicitHeight: card.implicitHeight
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-databases"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      anchors.fill: parent
      implicitHeight: col.implicitHeight + 32
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: root.close()

      ColumnLayout {
        id: col
        anchors { left: parent.left; right: parent.right; top: parent.top; margins: 16 }
        spacing: 10

        Caption { text: {{ tq "title" }}.toUpperCase() }
        Caption { text: {{ tq "intro" }}; color: Theme.fgSubtle; wrapMode: Text.Wrap; Layout.fillWidth: true }

        Repeater {
          model: root.dbs
          RowLayout {
            id: row
            required property var modelData
            readonly property bool up: modelData.state === "running"
            readonly property bool made: modelData.state !== "none"
            Layout.fillWidth: true
            spacing: 8
            Rectangle { implicitWidth: 8; implicitHeight: 8; radius: 4; color: row.up ? Theme.success : row.made ? Theme.fgSubtle : "transparent"; border.width: row.made ? 0 : 1; border.color: Theme.fgSubtle }
            ColumnLayout {
              spacing: 0
              Layout.preferredWidth: 220
              Label { text: root.names[row.modelData.name] || row.modelData.name }
              Caption {
                text: (root.busy === row.modelData.name ? {{ tq "working" }} : row.up ? {{ tq "running" }} : row.made ? {{ tq "stopped" }} : {{ tq "not_yet" }}) + " · 127.0.0.1:" + row.modelData.port
                color: Theme.fgSubtle
              }
            }
            Item { Layout.fillWidth: true }
            Button {
              visible: row.up
              text: {{ tq "copy_dotnet" }}
              onClicked: root.copy(row.modelData.name, "dotnet")
            }
            Button {
              visible: row.up
              text: {{ tq "copy_url" }}
              onClicked: root.copy(row.modelData.name, "url")
            }
            Button {
              text: row.up ? {{ tq "stop" }} : {{ tq "start" }}
              primary: !row.up
              onClicked: root.act(row.up ? "stop" : "start", row.modelData.name)
            }
            Button {
              visible: row.made && !row.up
              text: root.armed === row.modelData.name ? {{ tq "remove_sure" }} : {{ tq "remove" }}
              onClicked: root.act("remove", row.modelData.name)
            }
          }
        }

        Caption {
          visible: root.message !== ""
          text: root.message
          color: root.failed ? Theme.danger : Theme.fgMuted
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
      }
    }
  }
}
