# Generated by mazapan (plugin {{ plugin }}): databases for development, in
# containers (Podman; Docker when it's the one there).
#   devdb list                      each one: name, state, port (JSON)
#   devdb start|stop NAME           made the first time, its data kept
#   devdb remove NAME               the container and its data
#   devdb string NAME dotnet|url    how to connect, password included
# Each listens on this computer alone (127.0.0.1); its password is made the
# first time and kept for you alone in ~/.local/state/mazapan/devdb.
set -e
engine=podman
command -v podman >/dev/null 2>&1 || engine=docker
state="${XDG_STATE_HOME:-$HOME/.local/state}/mazapan/devdb"

known="postgres mysql redis sqlserver mongodb"
image() { case "$1" in
  postgres) echo docker.io/library/postgres:17 ;;
  mysql) echo docker.io/library/mysql:8.4 ;;
  redis) echo docker.io/library/redis:7 ;;
  sqlserver) echo mcr.microsoft.com/mssql/server:2022-latest ;;
  mongodb) echo docker.io/library/mongo:8 ;;
esac; }
port() { case "$1" in postgres) echo 5432 ;; mysql) echo 3306 ;; redis) echo 6379 ;; sqlserver) echo 1433 ;; mongodb) echo 27017 ;; esac; }
data() { case "$1" in
  postgres) echo /var/lib/postgresql/data ;; mysql) echo /var/lib/mysql ;; redis) echo /data ;;
  sqlserver) echo /var/opt/mssql ;; mongodb) echo /data/db ;;
esac; }

valid() { case " $known " in *" $1 "*) return 0 ;; esac; echo "devdb: no database \"$1\" ($known)" >&2; exit 2; }

# Its password: made once (SQL Server wants upper, lower, a digit and a sign).
password() {
  mkdir -p "$state" && chmod 700 "$state"
  f="$state/$1.password"
  if [ ! -s "$f" ]; then
    (umask 077; printf 'Mz%s1!' "$(head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n')" > "$f")
  fi
  cat "$f"
}

st() { $engine inspect -f '{{"{{"}}.State.Status{{"}}"}}' "mazapan-$1" 2>/dev/null || echo none; }

case "$1" in
  list)
    printf '['
    sep=
    for n in $known; do
      printf '%s{"name":"%s","state":"%s","port":%s}' "$sep" "$n" "$(st "$n")" "$(port "$n")"
      sep=,
    done
    printf ']\n'
    ;;
  start)
    valid "$2"; n=$2
    if [ "$(st "$n")" != none ]; then exec $engine start "mazapan-$n" >/dev/null; fi
    pw=$(password "$n")
    # The password in a file of its own (never on a command line others can read).
    envf="$state/$n.env"
    (umask 077; case "$n" in
      postgres) printf 'POSTGRES_PASSWORD=%s\n' "$pw" ;;
      mysql) printf 'MYSQL_ROOT_PASSWORD=%s\n' "$pw" ;;
      redis) printf 'REDIS_PASSWORD=%s\n' "$pw" ;;
      sqlserver) printf 'ACCEPT_EULA=Y\nMSSQL_SA_PASSWORD=%s\n' "$pw" ;;
      mongodb) printf 'MONGO_INITDB_ROOT_USERNAME=root\nMONGO_INITDB_ROOT_PASSWORD=%s\n' "$pw" ;;
    esac > "$envf")
    if [ "$n" = redis ]; then
      # Redis reads its password from its config, given from the environment inside.
      exec $engine run -d --name "mazapan-$n" --label mazapan.devdb="$n" -p "127.0.0.1:$(port "$n"):$(port "$n")" \
        -v "mazapan-$n-data:$(data "$n")" --env-file "$envf" "$(image "$n")" \
        sh -c 'printf "requirepass %s\nappendonly yes\n" "$REDIS_PASSWORD" > /tmp/redis.conf && exec redis-server /tmp/redis.conf' >/dev/null
    fi
    exec $engine run -d --name "mazapan-$n" --label mazapan.devdb="$n" -p "127.0.0.1:$(port "$n"):$(port "$n")" \
      -v "mazapan-$n-data:$(data "$n")" --env-file "$envf" "$(image "$n")" >/dev/null
    ;;
  stop) valid "$2"; exec $engine stop "mazapan-$2" >/dev/null ;;
  remove)
    valid "$2"
    $engine rm -f "mazapan-$2" >/dev/null 2>&1 || true
    $engine volume rm -f "mazapan-$2-data" >/dev/null 2>&1 || true
    rm -f "$state/$2.password" "$state/$2.env"
    ;;
  string)
    valid "$2"; n=$2; pw=$(password "$n"); p=$(port "$n")
    case "$n:$3" in
      postgres:dotnet) echo "Host=localhost;Port=$p;Username=postgres;Password=$pw;Database=postgres" ;;
      postgres:*) echo "postgresql://postgres:$pw@localhost:$p/postgres" ;;
      mysql:dotnet) echo "Server=localhost;Port=$p;User ID=root;Password=$pw" ;;
      mysql:*) echo "mysql://root:$pw@localhost:$p" ;;
      redis:dotnet) echo "localhost:$p,password=$pw" ;;
      redis:*) echo "redis://:$pw@localhost:$p" ;;
      sqlserver:dotnet) echo "Server=localhost,$p;User ID=sa;Password=$pw;TrustServerCertificate=True" ;;
      sqlserver:*) echo "sqlserver://sa:$pw@localhost:$p" ;;
      mongodb:*) echo "mongodb://root:$pw@localhost:$p" ;;
    esac
    ;;
  *) echo "usage: devdb list | start|stop|remove NAME | string NAME dotnet|url" >&2; exit 2 ;;
esac
