// Generated by myarch (plugin {{ plugin }}) from theme "{{ theme.id }}".
// Widgets use it as `import qs` ... `Theme.accent`.
//
// The colors can be previewed live (the theme picker): preview() morphs
// every widget to other colors, restore() back to these.
pragma Singleton

import QtQuick
import Quickshell

Singleton {
  id: theme

  // As generated: what restore() goes back to.
  readonly property var saved: ({{ json theme.colors }})
  readonly property var savedShape: ({
    radius: {{ theme.shape.radius }}, borderWidth: {{ theme.shape.border }},
    mode: "{{ theme.meta.mode }}", wallpaper: {{ json theme.effects.wallpaper }},
    terminalOpacity: {{ num theme.effects.terminal_opacity }}, blur: {{ theme.effects.blur }},
  })
{{ for name in theme.colors | object.keys }}
  property color {{ camel name }}: "{{ theme.colors[name] }}"
  Behavior on {{ camel name }} { ColorAnimation { duration: theme.morph; easing.type: Easing.OutCubic } }
{{- end }}

  readonly property QtObject ansi: QtObject {
{{- for name in theme.ansi | object.keys }}
    readonly property color {{ camel name }}: "{{ theme.ansi[name] }}"
{{- end }}
  }

  readonly property string fontMono: "{{ theme.font.mono }}"
  readonly property string fontUi: "{{ theme.font.ui }}"
  readonly property real fontSize: {{ num theme.font.size }}

  property int radius: {{ theme.shape.radius }}
  property int borderWidth: {{ theme.shape.border }}
  property string mode: "{{ theme.meta.mode }}"
  // "grid", "plain" or an image's path (plugin wallpaper draws it).
  property string wallpaper: {{ json theme.effects.wallpaper }}
  property real terminalOpacity: {{ num theme.effects.terminal_opacity }}
  property bool blur: {{ theme.effects.blur }}
  readonly property int gapIn: {{ theme.shape.gap_in }}
  readonly property int gapOut: {{ theme.shape.gap_out }}

  readonly property bool motion: {{ theme.motion.enabled }}
  readonly property int duration: {{ theme.motion.duration_ms }}
  readonly property int response: {{ theme.motion.response_ms }}
  readonly property real damping: {{ num theme.motion.damping }}

  // How long a previewed theme takes to morph in.
  readonly property int morph: motion ? 320 : 0

  // colors: token name -> #rrggbb ("bg_alt": "#141311"); other: radius,
  // borderWidth, mode, wallpaper, terminalOpacity, blur. Missing ones stay
  // as they are.
  function preview(colors, other) {
    for (const k in colors) {
      const prop = k.replace(/_(.)/g, (m, c) => c.toUpperCase())
      if (prop in theme) theme[prop] = colors[k]
    }
    for (const k in (other || {})) {
      if (["radius", "borderWidth", "mode", "wallpaper", "terminalOpacity", "blur"].includes(k)) theme[k] = other[k]
    }
  }

  function restore() {
    preview(saved, savedShape)
  }
}
