-- Generated by mazapan (plugin {{ plugin }}).
--
-- Windows are laid out as side-by-side columns (Hyprland's scrolling
-- layout) instead of dwindle, where every new window halves the previous
-- one. {{ if settings.auto }}Every change shares the screen out again (auto).{{ else }}As Niri does: a new window opens to the right at {{ inline settings.width }} of
-- the screen, the others keep their width, and the strip scrolls to show
-- the focused one.{{ end }} {{ inline settings.widths_key }} cycles the focused column through a third,
-- a half, two thirds and all of the screen; {{ inline settings.maximize_key }} makes it all of it and back;
-- {{ inline settings.consume_left_key }} / {{ inline settings.consume_right_key }} put the window in the next column or out of its own.
-- {{ inline settings.next_workspace_key }} / {{ inline settings.previous_workspace_key }}: workspaces one after another, a new
-- empty one after the last. Three arrangements on top, remembered per
-- workspace:
--
--   equal  {{ inline settings.key }}: every column the same width, filling the screen
--   phone  {{ inline settings.phone_key }}: phone-width columns, centered as a group
--   focus  {{ inline settings.focus_key }}: the focused window in the middle at {{ inline settings.focus_ratio }} of the
--          width, the rest stacked in a column on each side
--
-- Plus, on the focused column: {{ inline settings.grow_key }} / {{ inline settings.shrink_key }} grow and
-- shrink it (in focus mode: the middle), {{ inline settings.move_left_key }} / {{ inline settings.move_right_key }}
-- move it along the row.
--
-- Centering in phone mode works through the workspace's outer gaps: the
-- side gap is set to half the unused width, then the columns share what's
-- left equally. Focus mode switches just that workspace to Hyprland's
-- master layout, centered.

local MIN_WIDTH = {{ settings.min_width }} -- logical px
local PHONE_ASPECT = {{ settings.phone_aspect }} -- column width / height
local FOCUS_RATIO = {{ settings.focus_ratio }} -- middle window / screen width
local STEP = {{ settings.resize_step }} -- fraction of the screen width
local GAP_IN, GAP_OUT = {{ theme.shape.gap_in }}, {{ theme.shape.gap_out }}

hl.config({
  general = { layout = "scrolling" },
  scrolling = {
    column_width = {{ settings.width }},
    -- The focused column brought into view with as little scrolling as
    -- can be (Niri's way), not centered every time.
    focus_fit_method = 1,
    follow_focus = true,
  },
  -- Only focus mode uses master. Center it even with a single other window,
  -- and keep new windows on the sides.
  master = {
    orientation = "center",
    mfact = FOCUS_RATIO,
    slave_count_for_center_master = 0,
    new_status = "slave",
  },
})

local mode = {} -- workspace id -> "equal" | "phone" | "focus"
local before_focus = {} -- workspace id -> mode to return to from focus

local function tiled_count(ws)
  local n = 0
  for _, w in ipairs(hl.get_windows({ workspace = ws.id }) or {}) do
    if not w.floating then n = n + 1 end
  end
  return n
end

-- Logical size of the workspace's monitor, with rotation (transform 1, 3,
-- 5, 7 turn it 90/270 degrees) taken into account.
local function screen(ws)
  local m = ws.monitor
  local w, h = m.width, m.height
  if m.transform % 2 == 1 then w, h = h, w end
  return w / m.scale, h / m.scale
end

local function side_gaps(ws, side)
  hl.workspace_rule({
    workspace = tostring(ws.id),
    gaps_out = { top = GAP_OUT, right = side, bottom = GAP_OUT, left = side },
  })
end

local function set_layout(ws, layout)
  hl.workspace_rule({ workspace = tostring(ws.id), layout = layout })
end

-- Hyprland applies some changes only on the next turn of its event loop: a
-- layout switched by workspace rule, a window moved into a workspace (its
-- event fires before the window is placed). Layout messages sent before
-- that reach the old state and are lost, so run them a moment later.
local function later(fn)
  hl.timer(fn, { timeout = 30, type = "oneshot" })
end

-- Every column 1/n of the width, then bring them all into view. `fit all`
-- alone only shrinks columns that don't fit; it never widens them when a
-- window leaves and space frees up.
local function share(n)
  hl.dispatch(hl.dsp.layout(string.format("colresize all %.4f", 1 / n)))
  hl.dispatch(hl.dsp.layout("fit all"))
end

local function equal(ws, n)
  side_gaps(ws, GAP_OUT)
  local w = screen(ws)
  local fits = math.max(1, math.floor(w / MIN_WIDTH))
  if n <= fits then
    share(n)
  else
    -- Too many to fit at MIN_WIDTH: keep that width and let the row scroll.
    hl.dispatch(hl.dsp.layout(string.format("colresize all %.4f", 1 / fits)))
  end
end

local function phone(ws, n)
  local w, h = screen(ws)
  local col = (h - 2 * GAP_OUT) * PHONE_ASPECT
  local group = n * col + (n - 1) * 2 * GAP_IN
  local side = math.floor((w - group) / 2)
  if side < GAP_OUT then
    -- Phone-width columns don't fit side by side: fill the screen instead.
    return equal(ws, n)
  end
  side_gaps(ws, side)
  share(n)
end

-- Apply a column mode (equal or phone) to the focused workspace, leaving
-- focus mode if it's on. With no argument, re-apply the workspace's
-- current mode (auto mode).
local function arrange(which)
  local ws = hl.get_active_workspace()
  if not ws then return end
  if not which and mode[ws.id] == "focus" then
    return -- master places new windows on the sides by itself
  end
  which = which or mode[ws.id] or "equal"
  local apply = function()
    local n = tiled_count(ws)
    if n < 1 then return end
    if which == "phone" then phone(ws, n) else equal(ws, n) end
  end
  if mode[ws.id] == "focus" then
    set_layout(ws, "scrolling")
    mode[ws.id] = which
    return later(apply)
  end
  mode[ws.id] = which
  apply()
end

-- The middle window is FOCUS_RATIO of the screen, the side ones at most
-- half of what's left: anything wider than 40% is the middle one.
local function is_middle(win, ws)
  return win.size.x > 0.4 * screen(ws)
end

local function focus()
  local ws, win = hl.get_active_workspace(), hl.get_active_window()
  if not ws or not win or win.floating then return end

  if mode[ws.id] ~= "focus" then
    before_focus[ws.id] = mode[ws.id] or "equal"
    mode[ws.id] = "focus"
    side_gaps(ws, GAP_OUT) -- undo phone mode's wide side gaps
    set_layout(ws, "master")
    later(function()
      hl.dispatch(hl.dsp.layout(string.format("mfact exact %.4f", FOCUS_RATIO)))
      hl.dispatch(hl.dsp.layout("swapwithmaster master ignoremaster"))
    end)
  elseif not is_middle(win, ws) then
    -- A side window: bring it to the middle.
    hl.dispatch(hl.dsp.layout("swapwithmaster master ignoremaster"))
  else
    -- The middle window again: back to the mode from before.
    arrange(before_focus[ws.id])
  end
end

-- In focus mode, resize the middle; otherwise the focused column, never
-- below MIN_WIDTH (held down, it would shrink to a sliver).
local function resize(sign)
  local ws, win = hl.get_active_workspace(), hl.get_active_window()
  if not ws or not win or win.floating then return end
  if mode[ws.id] == "focus" then
    hl.dispatch(hl.dsp.layout(string.format("mfact %s%.4f", sign, STEP)))
    return
  end
  if sign == "-" and win.size.x - STEP * screen(ws) < MIN_WIDTH then return end
  hl.dispatch(hl.dsp.layout(string.format("colresize %s%.4f", sign, STEP)))
end

-- All of the screen's width, and back to the width it had (per window).
local before_max = {} -- window address -> width share
local function maximize()
  local ws, win = hl.get_active_workspace(), hl.get_active_window()
  if not ws or not win or win.floating then return end
  local w = screen(ws)
  local key = tostring(win.address)
  if win.size.x >= 0.95 * (w - 2 * GAP_OUT) then
    hl.dispatch(hl.dsp.layout(string.format("colresize %.4f", before_max[key] or {{ settings.width }})))
    before_max[key] = nil
  else
    before_max[key] = math.max(0.1, math.min(1, (win.size.x + 2 * GAP_IN) / (w - 2 * GAP_OUT)))
    hl.dispatch(hl.dsp.layout("colresize 1.0"))
  end
end

-- The same as commands (`hyprctl eval 'mazapan_columns.equal()'`): the
-- command palette runs and shows these.
mazapan_columns = {
  maximize = maximize,
  equal = function() arrange("equal") end,
  phone = function()
    local ws = hl.get_active_workspace()
    arrange(ws and mode[ws.id] == "phone" and "equal" or "phone")
  end,
  focus = focus,
  grow = function() resize("+") end,
  shrink = function() resize("-") end,
}

hl.bind({{ lq settings.key }}, mazapan_columns.equal)
hl.bind({{ lq settings.phone_key }}, mazapan_columns.phone)
hl.bind({{ lq settings.focus_key }}, mazapan_columns.focus)
hl.bind({{ lq settings.grow_key }}, mazapan_columns.grow, { repeating = true })
hl.bind({{ lq settings.shrink_key }}, mazapan_columns.shrink, { repeating = true })
hl.bind({{ lq settings.move_left_key }}, hl.dsp.layout("swapcol l"))
hl.bind({{ lq settings.move_right_key }}, hl.dsp.layout("swapcol r"))

-- The same key with SHIFT, after its first modifier ("SUPER + R" ->
-- "SUPER + SHIFT + R"): the other way round.
local function shifted(key)
  return (key:gsub("^([%w_]+) %+ ", "%1 + SHIFT + ", 1))
end

-- Niri's: widths in turn, all of the width, windows into columns and out.
hl.bind({{ lq settings.widths_key }}, hl.dsp.layout("colresize +conf"))
hl.bind(shifted({{ lq settings.widths_key }}), hl.dsp.layout("colresize -conf"))
hl.bind({{ lq settings.maximize_key }}, maximize)
hl.bind({{ lq settings.fullscreen_key }}, hl.dsp.window.fullscreen())
hl.bind({{ lq settings.consume_left_key }}, hl.dsp.layout("consume_or_expel prev"))
hl.bind({{ lq settings.consume_right_key }}, hl.dsp.layout("consume_or_expel next"))

-- Workspaces one after another on each screen (r: empty ones count, so
-- after the last one there's always a new one).
hl.bind({{ lq settings.next_workspace_key }}, hl.dsp.focus({ workspace = "r+1" }))
hl.bind({{ lq settings.previous_workspace_key }}, hl.dsp.focus({ workspace = "r-1" }))
hl.bind(shifted({{ lq settings.next_workspace_key }}), hl.dsp.window.move({ workspace = "r+1" }))
hl.bind(shifted({{ lq settings.previous_workspace_key }}), hl.dsp.window.move({ workspace = "r-1" }))
{{- if settings.wheel }}

-- SUPER and the wheel: along the strip; with SHIFT, workspaces.
hl.bind("SUPER + mouse_down", hl.dsp.layout("move +col"))
hl.bind("SUPER + mouse_up", hl.dsp.layout("move -col"))
hl.bind("SUPER + SHIFT + mouse_down", hl.dsp.focus({ workspace = "r+1" }))
hl.bind("SUPER + SHIFT + mouse_up", hl.dsp.focus({ workspace = "r-1" }))
{{- end }}
{{- if settings.gestures }}

-- Three fingers: sideways along the strip, up and down between workspaces.
hl.gesture({ fingers = 3, direction = "horizontal", action = "scroll_move" })
hl.gesture({ fingers = 3, direction = "vertical", action = "workspace" })
{{- end }}
{{- if settings.auto }}

-- Re-apply whatever mode the workspace is in when its windows change.
-- Layout messages only reach the workspace on screen, so a workspace that
-- got a window while out of sight is re-arranged when you arrive.
for _, ev in ipairs({ "window.open", "window.destroy", "window.move_to_workspace", "workspace.active" }) do
  hl.on(ev, function() later(function() arrange() end) end)
end
{{- end }}
