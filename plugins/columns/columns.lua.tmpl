-- Generated by myarch (plugin {{.Plugin}}).
--
-- Windows are laid out as side-by-side columns (Hyprland's scrolling
-- layout) instead of dwindle, where every new window halves the previous
-- one. {{.Settings.key}} gives every column of the workspace the same width.

local MIN_WIDTH = {{.Settings.min_width}} -- logical px

hl.config({ general = { layout = "scrolling" } })

local function tiled_count(ws)
  local n = 0
  for _, w in ipairs(hl.get_windows({ workspace = ws.id }) or {}) do
    if not w.floating then n = n + 1 end
  end
  return n
end

local function equalize()
  local ws = hl.get_active_workspace()
  if not ws then return end
  local n = tiled_count(ws)
  if n < 1 then return end

  local mon = ws.monitor
  -- Rotated 90/270 (transform 1, 3, 5, 7): the row runs along the height.
  local px = (mon.transform % 2 == 1) and mon.height or mon.width
  local fits = math.max(1, math.floor(px / mon.scale / MIN_WIDTH))

  if n <= fits then
    -- Every column gets 1/n of the screen and all of them come into view.
    hl.dispatch(hl.dsp.layout("fit all"))
  else
    -- Too many to fit at MIN_WIDTH: keep that width and let the row scroll.
    hl.dispatch(hl.dsp.layout(string.format("colresize all %.4f", 1 / fits)))
  end
end

hl.bind("{{.Settings.key}}", equalize)
{{- if .Settings.auto}}

for _, ev in ipairs({ "window.open", "window.destroy", "window.move_to_workspace" }) do
  hl.on(ev, equalize)
end
{{- end}}
