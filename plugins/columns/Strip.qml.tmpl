// Generated by mazapan (plugin {{ plugin }}).
//
// Where you are on the workspace's strip of columns, as Niri shows it: a
// block per column, as wide as it is, the ones on the screen filled, the
// focused one in the accent. Only with two columns or more. A click goes
// to that column.

import QtQuick
import Quickshell
import Quickshell.Hyprland
import qs
import "../../components/kit"

BarItem {
  id: root

  readonly property var ws: Hyprland.focusedWorkspace
  readonly property var mon: ws && ws.monitor ? ws.monitor : null
  readonly property real monX: mon && mon.lastIpcObject ? mon.lastIpcObject.x : 0
  readonly property real monW: mon ? (mon.lastIpcObject && mon.lastIpcObject.transform % 2 === 1 ? mon.height : mon.width) / mon.scale : 1920
  property var columns: []   // [{x, w, on, focused, window}]

  shown: columns.length > 1 && !!mon && mon.name === (barScreen ? barScreen.name : "")
  // The bar item's own area takes the clicks: which block is under it.
  onClicked: mouse => {
    const p = strip.mapFromItem(root, mouse.x, mouse.y)
    const it = strip.childAt(p.x, strip.height / 2)
    if (it && it.modelData) Hyprland.dispatch(`hl.dsp.focus({ window = "address:${root.address(it.modelData.window)}" })`)
  }

  function address(t) {
    const a = String(t.address)
    return a.startsWith("0x") ? a : "0x" + a
  }

  function update() {
    if (!ws) { columns = []; return }
    const active = Hyprland.activeToplevel
    const byX = {}
    for (const t of Hyprland.toplevels.values) {
      const i = t.lastIpcObject
      if (!t.workspace || t.workspace.id !== ws.id || !i || !i.at || i.floating || i.fullscreen) continue
      const x = Math.round(i.at[0])
      const c = byX[x] || (byX[x] = { x: x, w: i.size[0], focused: false, window: t })
      c.w = Math.max(c.w, i.size[0])
      if (active && address(active) === address(t)) c.focused = true
    }
    // On the screen: a good part of it (not a gap's sliver at the edge).
    columns = Object.values(byX).sort((a, b) => a.x - b.x).map(c => Object.assign(c, {
      on: Math.min(c.x + c.w, root.monX + root.monW) - Math.max(c.x, root.monX) > 0.3 * c.w
    }))
  }

  // Positions change as windows come, go and scroll: looked at again then,
  // and every so often (scrolling the strip says nothing).
  Connections {
    target: Hyprland
    function onRawEvent(e) {
      if (["openwindow", "closewindow", "movewindow", "movewindowv2", "activewindow", "activewindowv2", "workspace", "workspacev2", "changefloatingmode", "fullscreen"].includes(e.name))
        later.restart()
    }
  }
  // Asked for afresh, then read once the answer is in.
  Timer { id: later; interval: 120; onTriggered: { Hyprland.refreshToplevels(); after.restart() } }
  Timer { id: after; interval: 150; onTriggered: root.update() }
  Connections {
    target: Hyprland.toplevels
    function onValuesChanged() { root.update() }
  }
  Timer { interval: 1500; repeat: true; running: true; triggeredOnStart: true; onTriggered: later.restart() }
  Component.onCompleted: update()

  Row {
    id: strip
    anchors.verticalCenter: parent.verticalCenter
    spacing: 3
    Repeater {
      model: root.columns
      Rectangle {
        required property var modelData
        anchors.verticalCenter: parent.verticalCenter
        width: Math.max(5, Math.round(modelData.w / root.monW * 28))
        height: 9
        radius: Theme.radius > 0 ? 2 : 0
        color: modelData.focused ? Theme.accent : modelData.on ? Theme.fgMuted : "transparent"
        border.width: modelData.on || modelData.focused ? 0 : 1
        border.color: Theme.fgSubtle
      }
    }
  }
}
