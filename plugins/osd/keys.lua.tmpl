-- Generated by mazapan (plugin {{ plugin }}): the volume, microphone,
-- brightness and media keys. They work on the lock screen too (locked),
-- and held down they repeat. Volume goes through wpctl (the shell sees the
-- change and shows it); brightness through brightnessctl, then told to the
-- shell; media through the shell (MPRIS), which shows the track.
local opt = { locked = true, repeating = true }
local once = { locked = true }
-- Raising unmutes; it stops at max_volume, and above it (the bar let it go
-- higher) it leaves the volume alone rather than bring it down.
local up = "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; "
  .. "v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | cut -d' ' -f2); "
  .. "awk -v v=\"$v\" 'BEGIN { exit !(v + 0 < {{ num settings.max_volume }}) }' && "
  .. "wpctl set-volume -l {{ num settings.max_volume }} @DEFAULT_AUDIO_SINK@ {{ settings.volume_step }}%+"
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd(up), opt)
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ {{ settings.volume_step }}%-"), opt)
hl.bind("XF86AudioMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"), once)
hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"), once)

-- The screen's backlight only (-c backlight: never a keyboard's LED where
-- there's none), on brightnessctl's curve (-e4, as the battery's slider).
local function light(change)
  return hl.dsp.exec_cmd("p=$(brightnessctl -c backlight -m -e4 -n2 set " .. change .. " | cut -d, -f4 | tr -d %); "
    .. "[ -n \"$p\" ] && qs ipc -c mazapan call osd brightness \"$p\"")
end
hl.bind("XF86MonBrightnessUp", light("{{ settings.brightness_step }}%+"), opt)
hl.bind("XF86MonBrightnessDown", light("{{ settings.brightness_step }}%-"), opt)

hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("qs ipc -c mazapan call osd playPause"), once)
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("qs ipc -c mazapan call osd playPause"), once)
hl.bind("XF86AudioNext", hl.dsp.exec_cmd("qs ipc -c mazapan call osd next"), once)
hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("qs ipc -c mazapan call osd previous"), once)
