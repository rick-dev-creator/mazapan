// Generated by myarch (plugin {{ plugin }}).
//
// What a volume, brightness or media key did, for a moment: a small card
// on the focused screen with its level. Volume and the microphone are
// followed as PipeWire has them (whatever changed them: the keys, the
// bar, an app); brightness and media are told by their keys
// (qs ipc -c myarch call osd …). Nothing to click: it's never in the way.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import Quickshell.Services.Pipewire
import Quickshell.Services.Mpris
import qs
import "../components/kit"

Item {
  id: root

  // A panel by contract (see shell.qml): the keys open it, not a toggle.
  property bool open: false
  function toggle() {}
  function close() { shown = false }

  // What's shown: kind (volume, mic, brightness, media), glyph, words,
  // level 0..1 (or -1: none).
  property bool shown: false
  property string glyph: ""
  property string title: ""
  property string detail: ""
  property real level: -1
  property bool muted: false

  function show(g, t, d, l, m) {
    glyph = g
    title = t
    detail = d
    level = l
    muted = !!m
    shown = true
    hide.restart()
  }

  Timer {
    id: hide
    interval: {{ settings.seconds }} * 1000
    onTriggered: root.shown = false
  }

  // --- volume and microphone, as PipeWire has them ---------------------------------

  readonly property var sink: Pipewire.defaultAudioSink
  readonly property var source: Pipewire.defaultAudioSource
  PwObjectTracker { objects: [root.sink, root.source] }

  // PipeWire's first values aren't news: only what changes after a moment
  // (at start, and when another output or microphone becomes the default:
  // a headset connecting).
  property bool settled: false
  Timer {
    id: settle
    interval: 2000
    running: true
    onTriggered: root.settled = true
  }
  onSinkChanged: {
    settled = false
    settle.restart()
  }
  onSourceChanged: {
    settled = false
    settle.restart()
  }

  function volumeGlyph(v, m) {
    if (m || v <= 0) return String.fromCodePoint(0xF075F) // volume off
    if (v < 0.34) return String.fromCodePoint(0xF057F)
    if (v < 0.67) return String.fromCodePoint(0xF0580)
    return String.fromCodePoint(0xF057E)
  }

  function showVolume() {
    if (!settled || !sink || !sink.audio) return
    const v = sink.audio.volume, m = sink.audio.muted
    show(volumeGlyph(v, m), m ? {{ tq "muted" }} : {{ tq "volume" }},
      Math.round(v * 100) + "%", Math.min(1, v / {{ num settings.max_volume }}), m)
  }

  Connections {
    target: root.sink ? root.sink.audio : null
    function onVolumesChanged() { root.showVolume() }
    function onMutedChanged() { root.showVolume() }
  }

  Connections {
    target: root.source ? root.source.audio : null
    function onMutedChanged() {
      if (!root.settled) return
      const m = root.source.audio.muted
      root.show(String.fromCodePoint(m ? 0xF036D : 0xF036C), m ? {{ tq "mic.off" }} : {{ tq "mic.on" }}, "", -1, m)
    }
  }

  // --- brightness and media, told by their keys --------------------------------------

  // The player a key means: the one playing, else the first there is.
  function player() {
    const all = Mpris.players.values
    return all.find(p => p.isPlaying) || all[0] || null
  }

  function showTrack(p) {
    if (!p) return
    show(String.fromCodePoint(p.isPlaying ? 0xF040A : 0xF03E4), p.trackTitle || p.identity || "", p.trackArtist || "", -1, false)
  }

  // A key only asks the player: what it did is known when the player says
  // so (or, if it says nothing, a moment later).
  // Play/pause is answered by the player playing or not; next and
  // previous by the new track (a paused player starts playing before its
  // new title arrives).
  property var asked: null
  property bool forTrack: false
  function ask(p, track) {
    asked = p
    forTrack = !!track
    answer.restart()
  }
  Timer {
    id: answer
    interval: 1000
    onTriggered: root.answered()
  }
  function answered() {
    answer.stop()
    showTrack(asked)
    asked = null
  }
  Connections {
    target: root.asked
    function onIsPlayingChanged() { if (!root.forTrack) root.answered() }
    function onPostTrackChanged() { root.answered() }
  }

  IpcHandler {
    target: "osd"
    // brightnessctl's percentage, after a brightness key.
    function brightness(percent: int): void {
      root.show(String.fromCodePoint(percent < 50 ? 0xF00DE : 0xF00E0), {{ tq "brightness" }}, percent + "%", percent / 100, false)
    }
    function playPause(): void {
      const p = root.player()
      if (!p) return
      p.togglePlaying()
      root.ask(p)
    }
    function next(): void {
      const p = root.player()
      if (!p || !p.canGoNext) return
      p.next()
      root.ask(p, true)
    }
    function previous(): void {
      const p = root.player()
      if (!p || !p.canGoPrevious) return
      p.previous()
      root.ask(p, true)
    }
  }

  // --- the card ------------------------------------------------------------------

  PanelWindow {
    id: win
    visible: root.shown || card.opacity > 0
    screen: Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    anchors {
      bottom: {{ settings.position == "bottom" }}
      top: {{ settings.position == "top" }}
    }
    margins.bottom: 90
    margins.top: 60
    implicitWidth: 320
    implicitHeight: 64
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    // Clicks go through: it's never in the way.
    mask: Region {}
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "myarch-osd"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.None

    Rectangle {
      id: card
      anchors.fill: parent
      radius: Theme.radius
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      opacity: root.shown ? 1 : 0
      Behavior on opacity { NumberAnimation { duration: Theme.motion ? 180 : 0 } }

      RowLayout {
        anchors.fill: parent
        anchors.leftMargin: 16
        anchors.rightMargin: 16
        spacing: 14

        Glyph {
          text: root.glyph
          color: root.muted ? Theme.fgSubtle : Theme.accentText
          font.pointSize: 18
          Layout.preferredWidth: 26
          horizontalAlignment: Text.AlignHCenter
        }

        ColumnLayout {
          Layout.fillWidth: true
          spacing: 6
          RowLayout {
            Layout.fillWidth: true
            Label {
              text: root.title
              font.bold: true
              elide: Text.ElideRight
              Layout.fillWidth: true
            }
            Caption { text: root.level >= 0 ? root.detail : "" }
          }
          // A level, or a line of words (the artist).
          Rectangle {
            visible: root.level >= 0
            Layout.fillWidth: true
            implicitHeight: 5
            radius: 3
            color: Theme.surface
            Rectangle {
              width: parent.width * Math.max(0, Math.min(1, root.level))
              height: parent.height
              radius: 3
              color: root.muted ? Theme.fgSubtle : Theme.accent
              Behavior on width { NumberAnimation { duration: Theme.motion ? 90 : 0 } }
            }
          }
          Caption {
            visible: root.level < 0 && text !== ""
            text: root.detail
            elide: Text.ElideRight
            Layout.fillWidth: true
          }
        }
      }
    }
  }
}
