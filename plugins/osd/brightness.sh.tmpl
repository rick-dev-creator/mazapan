# Generated by mazapan (plugin {{ plugin }}): brightness up|down STEP
# The laptop's own screen (brightnessctl, on its curve), and external
# screens over DDC/CI when they can be reached (the ddc-brightness plugin),
# then the new level shown. External screens change in the background, one
# change at a time (a held key doesn't queue a minute of them).
sign=+
[ "$1" = down ] && sign=-
step=${2:-5}
p=$(brightnessctl -c backlight -m -e4 -n2 set "$step%$sign" 2>/dev/null | cut -d, -f4 | tr -d %)
[ -n "$p" ] && qs ipc -c mazapan call osd brightness "$p" >/dev/null 2>&1
command -v ddcutil >/dev/null 2>&1 || exit 0
[ -n "$(find /dev -maxdepth 1 -name 'i2c-*' -readable 2>/dev/null | head -n 1)" ] || exit 0
run="${XDG_RUNTIME_DIR:-/tmp}/mazapan-ddc"
mkdir -p "$run" && chmod 700 "$run" || exit 0
(
  flock -n 9 || exit 0
  # The screens that answer DDC, found once a while (finding them is slow).
  list="$run/displays"
  if [ -z "$(find "$list" -mmin -10 2>/dev/null)" ]; then
    ddcutil detect --brief 2>/dev/null | sed -n 's/^Display \([0-9]*\).*/\1/p' > "$list"
  fi
  first=
  while read -r d; do
    [ -n "$d" ] || continue
    ddcutil --display "$d" --noverify setvcp 10 "$sign" "$step" >/dev/null 2>&1
    [ -n "$first" ] || first=$d
  done < "$list"
  # No screen of its own (a desktop): the external one's level is shown.
  if [ -z "$p" ] && [ -n "$first" ]; then
    set -- $(ddcutil --display "$first" getvcp 10 --brief 2>/dev/null)
    [ "$4" -gt 0 ] 2>/dev/null && qs ipc -c mazapan call osd brightness "$(( $4 * 100 / $5 ))" >/dev/null 2>&1
  fi
) 9>"$run/lock" &
