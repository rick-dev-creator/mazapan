// Generated by mazapan (plugin {{ plugin }}): every key, on top of everything.
//
// Shown while SUPER is held alone (learn.lua watches the keys and tells
// it: hold, once held a moment with nothing else pressed; release), or
// toggled with its own key. Read from every plugin's actions, so a key
// changed in Settings › Keys shows changed. It never takes the keyboard:
// SUPER and what's pressed with it still go where they always do, and
// anything that happens meanwhile (a key with SUPER did something) hides it.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  // Shown by holding SUPER (letting go hides it) or by its key (stays).
  property bool byHold: false
  readonly property bool holdEnabled: {{ settings.hold_super }}

  readonly property var actions: {{ json actions }}
  readonly property var keyNames: ({ left: "←", right: "→", up: "↑", down: "↓", Return: "↵", space: "Space", equal: "=", minus: "-",
    Tab: "Tab", period: ".", comma: ",", slash: "/", bracketleft: "[", bracketright: "]", Page_Down: "PgDn", Page_Up: "PgUp", Print: "Print" })
  function pretty(key) {
    return key.split(" + ").map(k => keyNames[k] ?? k).join(" + ")
  }

  // "Columns: same width for every window" -> "Same width for every
  // window": the group already says whose it is.
  function short(name) {
    const s = name.replace(/^[^:]{2,24}:\s+/, "")
    return s.charAt(0).toUpperCase() + s.slice(1)
  }
  // Which group a plugin's keys go in; the rest, Everyday.
  readonly property var groupOf: ({
    "hypr-base": "windows", "columns": "windows", "window-titles": "windows",
    "bar-workspaces": "workspaces", "monitors": "workspaces",
    "palette": "open", "apps": "open", "settings": "open", "control-center": "open", "themes": "open",
    "plugin-manager": "open", "learn": "open", "updates": "open", "history": "open", "wallpaper": "open",
  })
  readonly property var groups: {
    const g = { windows: [], workspaces: [], open: [], everyday: [] }
    for (const a of actions) {
      // Keys a keyboard has for one thing (volume, brightness) and switches
      // (the lid) aren't keys to learn.
      if (!a.key || a.key.startsWith("XF86") || a.key.startsWith("switch:")) continue
      g[groupOf[a.plugin] || "everyday"].push({ name: short(a.label || a.name), key: pretty(a.key) })
    }
    return [
      { title: {{ tq "keys.windows" }}, rows: g.windows },
      { title: {{ tq "keys.workspaces" }}, rows: g.workspaces },
      { title: {{ tq "keys.open" }}, rows: g.open },
      { title: {{ tq "keys.everyday" }}, rows: g.everyday },
    ].filter(x => x.rows.length > 0)
  }

  function reveal(hold) {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    byHold = hold
    open = true
  }
  function toggle() {
    if (open) close()
    else reveal(false)
  }
  function close() {
    open = false
  }

  // The last press let go (learn.lua numbers them): a hold for it or an
  // earlier one, arriving late, is stale.
  property int released: 0
  IpcHandler {
    target: "keys"
    // SUPER has been held alone a moment (press n): the keys, until it's let go.
    function hold(n: int): void {
      if (n <= root.released) return
      if (root.holdEnabled && !root.open) root.reveal(true)
    }
    // SUPER came up (presses up to n): gone, unless its own key opened it.
    function release(n: int): void {
      root.released = Math.max(root.released, n)
      if (root.open && root.byHold) root.close()
    }
    function toggle(): void { root.toggle() }
  }

  // Something a shortcut does happened while they show by holding (a
  // mouse with SUPER moved a window): gone. What happens by itself (a
  // title changing) doesn't count, nor its own window.
  readonly property var shortcutEvents: ["activewindowv2", "workspacev2", "focusedmonv2", "movewindowv2", "openwindow",
    "closewindow", "openlayer", "closelayer", "changefloatingmode", "fullscreen", "activespecialv2", "moveworkspacev2"]
  Connections {
    target: Hyprland
    function onRawEvent(event) {
      if (!(root.open && root.byHold)) return
      if (root.shortcutEvents.indexOf(event.name) < 0) return
      if (/mazapan-panel-keys/.test(event.data)) return
      root.close()
    }
  }

  PanelWindow {
    visible: root.open
    screen: root.screenAtOpen
    anchors { top: true; bottom: true; left: true; right: true }
    color: Qt.alpha(Theme.bg, 0.55)
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "mazapan-panel-keys"
    // Never the keyboard: SUPER and the rest keep working underneath.
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.None

    MouseArea { anchors.fill: parent; onClicked: root.close() }

    Rectangle {
      id: card
      anchors.centerIn: parent
      width: Math.min(1100, parent.width - 60)
      height: Math.min(body.implicitHeight + 40, parent.height - 60)
      radius: Theme.radius
      color: Qt.alpha(Theme.surfaceRaised, 0.97)
      border.color: Theme.accent
      border.width: 1
      clip: true

      ColumnLayout {
        id: body
        anchors.fill: parent
        anchors.margins: 20
        spacing: 14

        RowLayout {
          Layout.fillWidth: true
          Label { text: {{ tq "keys.title" }}; font.pointSize: 14; font.bold: true; Layout.fillWidth: true }
          Caption {
            text: root.byHold ? {{ tq "keys.hint_hold" }} : {{ tq "keys.hint_toggle" }}
            font.letterSpacing: 0
          }
        }

        GridLayout {
          Layout.fillWidth: true
          columns: Math.max(1, Math.min(root.groups.length, Math.floor(card.width / 260)))
          columnSpacing: 26
          rowSpacing: 18

          Repeater {
            model: root.groups
            ColumnLayout {
              id: group
              required property var modelData
              Layout.fillWidth: true
              Layout.preferredWidth: 1
              Layout.alignment: Qt.AlignTop
              spacing: 5
              Text {
                textFormat: Text.PlainText
                text: group.modelData.title
                color: Theme.accentText
                font.family: Theme.fontMono
                font.pointSize: 8.5
                font.letterSpacing: 1
                font.capitalization: Font.AllUppercase
                Layout.bottomMargin: 2
              }
              Repeater {
                model: group.modelData.rows
                RowLayout {
                  required property var modelData
                  Layout.fillWidth: true
                  spacing: 10
                  Text {
                    textFormat: Text.PlainText
                    Layout.fillWidth: true
                    text: modelData.name
                    wrapMode: Text.Wrap
                    maximumLineCount: 2
                    elide: Text.ElideRight
                    color: Theme.fg
                    font.family: Theme.fontMono
                    font.pointSize: 9
                  }
                  Rectangle {
                    implicitWidth: keyText.implicitWidth + 12
                    implicitHeight: keyText.implicitHeight + 6
                    radius: Theme.radius
                    color: Theme.bg
                    border.width: 1
                    border.color: Theme.border
                    Text {
                      id: keyText
                      textFormat: Text.PlainText
                      anchors.centerIn: parent
                      text: modelData.key
                      color: Theme.fgMuted
                      font.family: Theme.fontMono
                      font.pointSize: 8.5
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
