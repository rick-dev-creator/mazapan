{{~ # Generated by mazapan (plugin learn): the lessons, in the desktop's
  # language, with the keys as they're bound now (a key changed in Settings
  # shows changed). Read by the Learn panel and the palette's Learn filter.
  #
  # Each lesson: its recording (media/ID.webp, `length` seconds, made by
  # vm/learn-record), the steps it shows (`at`: the second its move happens
  # in the recording), what to do to try it (`check`, see Learn.qml) and the
  # practice windows that takes (`setup`: how they start, learn-practice). `links`: the actions whose rows in the
  # palette show this lesson beside them.
  func key(p, s, fallback)
    for a in actions
      if a.plugin == p && a.key_setting == s
        ret a.key
      end
    end
    ret fallback
  end
  func has(p)
    for a in actions
      if a.plugin == p
        ret true
      end
    end
    ret false
  end
~}}
