// Generated by mazapan (plugin {{ plugin }}): the Learn panel.
//
// Short lessons on moving around: each a real recording of the move, its
// keys lit as it happens, then "Try it": the panel steps aside to a small
// card at the bottom, practice windows open on a workspace of their own,
// and the move is checked for real (learn-practice state) and ticked off.
// The lessons, in your language and with your keys, come from
// learn/lessons.json (the palette's Learn filter reads it too).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  // The panel on screen; `open` (what the shell asks) is it or a practice
  // going on, so closing every panel (SUPER + Q) stops a practice too.
  property bool shown: false
  readonly property bool open: shown || practicing
  property var screenAtOpen: null
  property int cur: 0
  property var data: null
  property var done: []
  readonly property var lessons: data ? data.lessons || [] : []
  readonly property var lesson: lessons[cur] ?? null
  readonly property string practiceCmd: Quickshell.env("HOME") + "/.local/share/mazapan/bin/learn-practice"

  // The practice: "" (none), "setup" (windows opening), "doing", "done";
  // the lesson it's for (kept: another can be picked meanwhile).
  property string phase: ""
  readonly property bool practicing: phase !== ""
  property var practiceLesson: null
  property var base: null
  property bool baseOk: false
  // A panel the lesson opens (the palette, the overview, the keys): seen
  // open, then closed again, is done.
  property bool seen: false
  // Stopped while its windows were still opening: closed once they are.
  property bool closeWhenOpen: false

  function toggle() {
    if (open) close()
    else show()
  }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    lessonsFile.reload()
    progressFile.reload()
    shown = true
    Qt.callLater(() => card.forceActiveFocus())
  }
  // Opened on one lesson (the palette's Learn filter, the welcome).
  function showWith(id) {
    if (practicing) stop()
    const i = lessons.findIndex(l => l.id === id)
    if (i >= 0) cur = i
    if (!shown) show()
  }
  function close() {
    if (practicing) stop()
    shown = false
  }

  FileView {
    id: lessonsFile
    path: Quickshell.env("HOME") + "/.config/quickshell/mazapan/learn/lessons.json"
    printErrors: false
    watchChanges: true
    onFileChanged: reload()
    onLoaded: { try { root.data = JSON.parse(text()) } catch (e) { root.data = null } }
    onLoadFailed: root.data = null
  }
  // What's been tried and done: {"done": [ids]}.
  FileView {
    id: progressFile
    path: Quickshell.env("HOME") + "/.local/state/mazapan/learn.json"
    printErrors: false
    atomicWrites: true
    onLoaded: { try { root.done = JSON.parse(text()).done || [] } catch (e) { root.done = [] } }
    onLoadFailed: root.done = []
  }
  function markDone(id) {
    if (done.indexOf(id) >= 0) return
    done = done.concat([id])
    progressFile.setText(JSON.stringify({ done: done }))
  }

  // "SUPER + SHIFT + right" -> ["SUPER", "SHIFT", "→"].
  readonly property var keyNames: ({ left: "←", right: "→", up: "↑", down: "↓", Return: "↵", space: "Space", equal: "=", minus: "-",
    Tab: "Tab", period: ".", comma: ",", slash: "/", bracketleft: "[", bracketright: "]", Page_Down: "PgDn", Page_Up: "PgUp" })
  function chips(keys) {
    return keys ? keys.split(" + ").map(k => keyNames[k] ?? k) : []
  }

  // --- trying it ------------------------------------------------------------

  function tryIt() {
    if (!lesson || practicing) return
    practiceLesson = lesson
    base = null
    seen = false
    shown = false
    if (lesson.windows > 0) {
      phase = "setup"
      opener.command = ["sh", practiceCmd, "open", String(lesson.windows)].concat(lesson.setup ? [lesson.setup] : [])
      opener.running = true
    } else {
      phase = "doing"
      poll.start()
    }
  }
  function stop() {
    poll.stop()
    celebrate.stop()
    if (practiceLesson && practiceLesson.windows > 0 && phase !== "") {
      if (opener.running) closeWhenOpen = true
      else closer.running = true
    }
    phase = ""
  }
  // The shell reloading (an apply) in the middle: its windows go too.
  Component.onDestruction: if (practicing && practiceLesson && practiceLesson.windows > 0)
    Quickshell.execDetached(["sh", practiceCmd, "close"])
  // Back to the panel, on the next lesson not done yet.
  function finish() {
    stop()
    const next = lessons.findIndex((l, i) => i > cur && done.indexOf(l.id) < 0)
    if (next >= 0) cur = next
    show()
  }

  Process {
    id: opener
    onExited: {
      if (root.closeWhenOpen) { root.closeWhenOpen = false; closer.running = true; return }
      if (root.phase === "setup") { root.phase = "doing"; poll.start() }
    }
  }
  Process {
    id: closer
    command: ["sh", root.practiceCmd, "close"]
  }
  Process {
    id: probe
    command: ["sh", root.practiceCmd, "state"]
    stdout: StdioCollector {
      onStreamFinished: {
        let s = null
        try { s = JSON.parse(text) } catch (e) { return }
        const l = root.practiceLesson
        if (root.phase !== "doing" || !l) return
        // Already so before anything was pressed (a setup that didn't
        // take): it has to change first, it's not done by itself.
        if (!root.base) { root.base = s; root.baseOk = root.passed(l.check, s, s); return }
        if (root.baseOk) { root.baseOk = root.passed(l.check, s, s); root.base = s; return }
        if (root.passed(l.check, root.base, s)) {
          poll.stop()
          root.phase = "done"
          root.markDone(l.id)
          celebrate.restart()
        }
      }
    }
  }
  Timer {
    id: poll
    interval: 450
    repeat: true
    triggeredOnStart: true
    onTriggered: if (!probe.running) probe.running = true
  }
  Timer {
    id: celebrate
    interval: 1800
    onTriggered: root.finish()
  }

  // Whether the move was made: what changed since the practice began.
  function passed(check, b, s) {
    switch (check) {
    case "focus": return s.window !== "" && s.window !== b.window
    case "move": return s.window === b.window && Math.abs(s.x - b.x) > 20
    case "width": return s.window === b.window && Math.abs(s.width - b.width) > 10
    case "equal": {
      if (s.widths.length < 2) return false
      const hi = Math.max(...s.widths), lo = Math.min(...s.widths)
      return hi - lo <= hi * 0.05
    }
    case "max": return s.width >= s.screen * 0.9
    case "workspace": return s.workspace !== b.workspace
    // Seen open, then closed: done (the lesson's own last step).
    case "overview": case "palette": case "keys": {
      const up = s.layers.indexOf("mazapan-panel-" + check) >= 0
      if (b === s) return up
      if (up) seen = true
      return seen && !up
    }
    }
    return false
  }

  // --- pieces -----------------------------------------------------------------

  component KeyChips: Row {
    property var keys: []
    property bool lit: false
    spacing: 4
    Repeater {
      model: parent.keys
      Row {
        required property var modelData
        required property int index
        spacing: 4
        Text {
          visible: index > 0
          anchors.verticalCenter: parent.verticalCenter
          text: "+"
          color: Theme.fgSubtle
          font.family: Theme.fontMono
          font.pointSize: 8
        }
        Rectangle {
          implicitWidth: Math.max(24, keyLabel.implicitWidth + 12)
          implicitHeight: keyLabel.implicitHeight + 7
          radius: Theme.radius
          color: lit ? Theme.accent : Theme.bg
          border.width: 1
          border.color: lit ? Theme.accent : Theme.border
          Behavior on color { ColorAnimation { duration: 150 } }
          Text {
            id: keyLabel
            anchors.centerIn: parent
            textFormat: Text.PlainText
            text: modelData
            color: lit ? Theme.accentFg : Theme.fgMuted
            font.family: Theme.fontMono
            font.pointSize: 8.5
          }
        }
      }
    }
  }

  // --- the panel ----------------------------------------------------------------

  PanelWindow {
    visible: root.shown
    screen: root.screenAtOpen
    anchors { top: true; bottom: true; left: true; right: true }
    color: Qt.alpha(Theme.bg, 0.6)
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "mazapan-panel-learn"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    MouseArea { anchors.fill: parent; onClicked: root.close() }

    Rectangle {
      id: card
      anchors.centerIn: parent
      width: Math.min(980, parent.width - 40)
      height: Math.min(620, parent.height - 40)
      radius: Theme.radius
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      focus: true
      Keys.onEscapePressed: root.close()
      Keys.onUpPressed: root.cur = Math.max(0, root.cur - 1)
      Keys.onDownPressed: root.cur = Math.min(root.lessons.length - 1, root.cur + 1)
      Keys.onReturnPressed: root.tryIt()
      Keys.onEnterPressed: root.tryIt()
      Keys.onPressed: event => { if (event.key === Qt.Key_R) { anim.currentFrame = 0; event.accepted = true } }
      MouseArea { anchors.fill: parent }

      RowLayout {
        anchors.fill: parent
        spacing: 0

        // The lessons, by topic, ticked when done.
        ColumnLayout {
          Layout.preferredWidth: 270
          Layout.fillHeight: true
          Layout.margins: 16
          spacing: 2

          Label { text: {{ tq "title" }}; font.pointSize: 15; font.bold: true }
          Caption {
            Layout.topMargin: 4
            text: {{ tq "progress" }}.arg(root.lessons.filter(l => root.done.indexOf(l.id) >= 0).length).arg(root.lessons.length)
            font.letterSpacing: 0
          }
          Rectangle {
            Layout.fillWidth: true
            Layout.topMargin: 6
            Layout.bottomMargin: 8
            implicitHeight: 4
            color: Theme.bg
            Rectangle {
              height: parent.height
              width: root.lessons.length ? parent.width * root.lessons.filter(l => root.done.indexOf(l.id) >= 0).length / root.lessons.length : 0
              color: Theme.success
              Behavior on width { NumberAnimation { duration: 300 } }
            }
          }

          Repeater {
            model: root.lessons
            ColumnLayout {
              id: entry
              required property var modelData
              required property int index
              readonly property bool first: index === 0 || root.lessons[index - 1].topic !== modelData.topic
              readonly property bool isDone: root.done.indexOf(modelData.id) >= 0
              Layout.fillWidth: true
              spacing: 2
              Text {
                visible: entry.first
                Layout.topMargin: entry.index === 0 ? 0 : 10
                textFormat: Text.PlainText
                text: entry.modelData.topic
                color: Theme.fgSubtle
                font.family: Theme.fontMono
                font.pointSize: 8
                font.letterSpacing: 1
                font.capitalization: Font.AllUppercase
              }
              Rectangle {
                Layout.fillWidth: true
                implicitHeight: 32
                radius: Theme.radius
                color: entry.index === root.cur ? Theme.accentDeep : lessonArea.containsMouse ? Theme.surface : "transparent"
                border.width: 1
                border.color: entry.index === root.cur ? Theme.accent : "transparent"
                RowLayout {
                  anchors.fill: parent
                  anchors.leftMargin: 8
                  anchors.rightMargin: 8
                  spacing: 8
                  Text { text: entry.isDone ? "✓" : "○"; color: entry.isDone ? Theme.success : Theme.fgSubtle; font.family: Theme.fontMono; font.pointSize: 9 }
                  Text {
                    textFormat: Text.PlainText
                    Layout.fillWidth: true
                    text: entry.modelData.title
                    elide: Text.ElideRight
                    color: Theme.fg
                    font.family: Theme.fontMono
                    font.pointSize: 9
                  }
                  Text { text: {{ tq "seconds" }}.arg(Math.round(entry.modelData.length)); color: Theme.fgSubtle; font.family: Theme.fontMono; font.pointSize: 8 }
                }
                MouseArea {
                  id: lessonArea
                  anchors.fill: parent
                  hoverEnabled: true
                  cursorShape: Qt.PointingHandCursor
                  onClicked: root.cur = entry.index
                }
              }
            }
          }
          Item { Layout.fillHeight: true }
          Caption { text: {{ tq "hint" }}; font.letterSpacing: 0; wrapMode: Text.Wrap; Layout.fillWidth: true }
        }

        Rectangle { Layout.fillHeight: true; implicitWidth: 1; color: Theme.border }

        // The lesson: why, the recording with its keys, and trying it.
        ColumnLayout {
          id: lessonCol
          Layout.fillWidth: true
          Layout.fillHeight: true
          Layout.margins: 18
          spacing: 10

          Label {
            visible: root.lessons.length === 0
            text: {{ tq "no_lessons" }}
            color: Theme.fgMuted
            wrapMode: Text.Wrap
            Layout.fillWidth: true
          }

          RowLayout {
            visible: root.lesson !== null
            Layout.fillWidth: true
            Label { text: root.lesson ? root.lesson.title : ""; font.pointSize: 13; font.bold: true; Layout.fillWidth: true; elide: Text.ElideRight }
            Caption {
              visible: root.lesson !== null && root.done.indexOf(root.lesson.id) >= 0
              text: "✓ " + {{ tq "done_tag" }}
              color: Theme.success
              font.letterSpacing: 0
            }
          }
          Label {
            visible: root.lesson !== null
            text: root.lesson ? root.lesson.why : ""
            color: Theme.fgMuted
            wrapMode: Text.Wrap
            Layout.fillWidth: true
          }

          // The recording, looping; its steps lit as they happen in it.
          Rectangle {
            id: frame
            visible: root.lesson !== null
            Layout.fillWidth: true
            Layout.preferredHeight: Math.min(width * 9 / 16, 300)
            color: Theme.bg
            border.width: 1
            border.color: Theme.border
            AnimatedImage {
              id: anim
              anchors.fill: parent
              anchors.margins: 1
              fillMode: Image.PreserveAspectFit
              source: root.lesson && root.data ? "file://" + root.data.media + "/" + root.lesson.id + ".webp" : ""
              playing: root.shown
              cache: false
              // A loop starts: its clock too (frames last as long as they
              // need, so time is kept by the clock, not by counting them).
              onCurrentFrameChanged: if (currentFrame === 0) lessonCol.loopStart = Date.now()
            }
            Caption {
              anchors.centerIn: parent
              visible: anim.status === Image.Error
              text: {{ tq "no_media" }}
              font.letterSpacing: 0
            }
          }
          // Seconds into the recording's loop: which step is happening.
          property double loopStart: Date.now()
          property real at: -1
          Timer {
            interval: 100
            repeat: true
            running: root.shown && anim.status === Image.Ready
            onTriggered: lessonCol.at = (Date.now() - lessonCol.loopStart) / 1000
          }

          Repeater {
            model: root.lesson ? root.lesson.steps : []
            Rectangle {
              id: step
              required property var modelData
              readonly property real t: lessonCol.at
              readonly property bool now: t >= modelData.at && t < modelData.at + 1.6
              Layout.fillWidth: true
              implicitHeight: 34
              radius: Theme.radius
              color: now ? Theme.accentDeep : "transparent"
              border.width: 1
              border.color: now ? Theme.accent : "transparent"
              Behavior on color { ColorAnimation { duration: 150 } }
              RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 8
                anchors.rightMargin: 8
                spacing: 12
                KeyChips { keys: root.chips(step.modelData.keys); lit: step.now }
                Text {
                  textFormat: Text.PlainText
                  Layout.fillWidth: true
                  text: step.modelData.what
                  elide: Text.ElideRight
                  color: Theme.fg
                  font.family: Theme.fontMono
                  font.pointSize: 9.5
                }
              }
            }
          }

          Item { Layout.fillHeight: true }

          RowLayout {
            visible: root.lesson !== null
            Layout.fillWidth: true
            spacing: 8
            Button { text: {{ tq "again" }}; onClicked: anim.currentFrame = 0 }
            Item { Layout.fillWidth: true }
            Button { text: {{ tq "try" }} + "  ↵"; primary: true; onClicked: root.tryIt() }
          }
        }
      }
    }
  }

  // --- trying it: a card at the bottom, the keyboard left to you ----------------

  PanelWindow {
    visible: root.practicing
    screen: root.screenAtOpen
    anchors.bottom: true
    margins.bottom: 36
    implicitWidth: 660
    implicitHeight: practiceBody.implicitHeight + 28
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q stops it, as it closes any panel.
    WlrLayershell.namespace: "mazapan-panel-learn-practice"
    // Never the keyboard: the keys you're learning go where they always do.
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.None

    Rectangle {
      anchors.fill: parent
      radius: Theme.radius
      color: Theme.surfaceRaised
      border.width: 1
      border.color: root.phase === "done" ? Theme.success : Theme.accent

      ColumnLayout {
        id: practiceBody
        anchors.fill: parent
        anchors.margins: 14
        spacing: 8

        RowLayout {
          Layout.fillWidth: true
          Label { text: root.practiceLesson ? root.practiceLesson.title : ""; font.bold: true; Layout.fillWidth: true; elide: Text.ElideRight }
          Button { visible: root.phase !== "done"; text: {{ tq "back" }}; onClicked: { root.stop(); root.show() } }
          Button { visible: root.phase !== "done"; text: {{ tq "stop" }}; onClicked: root.stop() }
        }
        Label {
          Layout.fillWidth: true
          wrapMode: Text.Wrap
          text: root.phase === "setup" ? {{ tq "setup" }}
            : root.phase === "done" ? "✓  " + {{ tq "success" }}
            : root.practiceLesson ? {{ tq "your_turn" }}.arg(root.practiceLesson.task) : ""
          color: root.phase === "done" ? Theme.success : Theme.fg
          font.pointSize: root.phase === "done" ? 12 : Theme.fontSize
        }
        Caption {
          visible: root.phase === "doing"
          text: {{ tq "card.stop" }}
          font.letterSpacing: 0
        }
        Flow {
          visible: root.phase === "doing"
          Layout.fillWidth: true
          spacing: 14
          Repeater {
            model: root.practiceLesson ? root.practiceLesson.steps.filter(s => s.keys !== "") : []
            Row {
              required property var modelData
              spacing: 8
              KeyChips { keys: root.chips(modelData.keys) }
              Text {
                anchors.verticalCenter: parent.verticalCenter
                textFormat: Text.PlainText
                text: modelData.what
                color: Theme.fgMuted
                font.family: Theme.fontMono
                font.pointSize: 8.5
              }
            }
          }
        }
      }
    }
  }
}
