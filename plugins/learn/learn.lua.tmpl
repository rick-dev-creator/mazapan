-- Generated by mazapan (plugin {{ plugin }}): the Learn panel and the keys.
hl.bind({{ lq settings.key }}, hl.dsp.exec_cmd("qs ipc -c mazapan call mazapan panel learn"))
hl.bind({{ lq settings.keys_key }}, hl.dsp.exec_cmd("qs ipc -c mazapan call keys toggle"))

-- Only one watcher of SUPER: the one an earlier load of this file left (a
-- reload keeps it) goes, also when holding SUPER is turned off now.
if mazapan_learn_watch then pcall(function() mazapan_learn_watch:remove() end) end
mazapan_learn_watch = nil
{{- if settings.hold_super }}

-- SUPER held alone for a moment shows every key; letting go hides them.
-- Watched here, key by key, so nothing races: any other key pressed with
-- it (it was a shortcut, not a hold) calls it off. Nothing is taken from
-- anything else: SUPER and its shortcuts work as always.
local HOLD_MS = {{ settings.hold_ms }}
local SUPER = { [133] = true, [134] = true } -- the two SUPER keys (XKB keycodes)
-- Its state where `hyprctl eval` can see it (for checking it works).
mazapan_learn = { down = false, shown = false, presses = 0, fired = 0, error = nil }
local st = mazapan_learn
-- A timer of its own for each press (a Hyprland timer stopped before it
-- fires doesn't fire again when started anew); `press` tells it whether
-- it's still the hold it was made for.
local press = 0
local function hide()
  press = press + 1
  if st.shown then
    st.shown = false
    -- Numbered as the presses are: a hold that arrives after this release
    -- (two processes, either can be first) is known to be older.
    hl.exec_cmd("qs ipc -c mazapan call keys release " .. press)
  end
end
mazapan_learn_watch = hl.on("input.keyboard.key", function(code, _, state)
  local ok, err = pcall(function()
    if SUPER[code] then
      if state == 1 and not st.down then
        st.presses = st.presses + 1
        st.down = true
        press = press + 1
        local mine = press
        hl.timer(function()
          st.fired = st.fired + 1
          if st.down and press == mine then
            st.shown = true
            hl.exec_cmd("qs ipc -c mazapan call keys hold " .. mine)
          end
        end, { timeout = HOLD_MS, type = "oneshot" })
      elseif state == 0 then
        st.down = false
        hide()
      end
    elseif state == 1 then
      st.down = false
      hide()
    end
  end)
  if not ok then st.error = tostring(err) end
end)
{{- end }}
