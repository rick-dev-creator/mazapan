# Generated by mazapan (plugin {{ plugin }}): learn-practice open N [uneven|narrow] | close | state
# The Learn panel's practice: N windows to try a lesson on, on a workspace
# of their own (the one you were on is left as it was, and come back to);
# `uneven`, the first one wider (to even them out); `narrow`, the first one
# half the screen (to make it all of it). `state` says what the panel
# checks: the focused window, the workspace, the practice windows' widths
# and columns, the screen's width and the panels open.
dir=${XDG_RUNTIME_DIR:-/tmp}/mazapan-learn
mkdir -p "$dir"
practice() { hyprctl clients -j | jq -c '[.[] | select(.class == "mazapan-practice")] | sort_by(.at[0])'; }

case "$1" in
open)
  n=${2:-3}
  # Whatever an earlier practice left (stopped while it opened, a shell
  # reload in the middle) goes first.
  practice | jq -r '.[].pid' | xargs -r kill 2>/dev/null
  hyprctl activeworkspace -j | jq -r .id > "$dir/back"
  # A workspace number nobody uses (an empty one may be on another screen).
  ws=$(hyprctl workspaces -j | jq '[.[].id] as $used
    | first(range(1; 100) | select(. as $i | $used | index($i) | not))')
  hyprctl dispatch "hl.dsp.focus({ workspace = $ws })" >/dev/null
  i=1
  while [ "$i" -le "$n" ]; do
    label=$(printf {{ shq (t "practice.window") }} "$i")
    # Its name big in the middle, so it's clear which is which as they move.
    LANG=${LANG:-C.UTF-8} setsid -f foot -a mazapan-practice -T "$label" -f "monospace:size=22" \
      sh -c 'printf "\n\n\n\n    %s\n" "$1"; exec sleep infinity' sh "$label" </dev/null >/dev/null 2>&1
    i=$((i + 1))
    sleep 0.35
  done
  # Until they're all there (foot takes a moment), then the first focused.
  here() { practice | jq -c --argjson ws "$ws" '[.[] | select(.workspace.id == $ws)]'; }
  t=0
  while [ "$(here | jq length)" -lt "$n" ] && [ "$t" -lt 30 ]; do sleep 0.2; t=$((t + 1)); done
  first=$(here | jq -r '.[0].address // empty')
  [ -n "$first" ] && hyprctl dispatch "hl.dsp.focus({ window = \"address:$first\" })" >/dev/null
  if [ -n "$first" ]; then
    case "$3" in
    uneven) sleep 0.3; hyprctl dispatch 'hl.dsp.layout("colresize 0.7")' >/dev/null ;;
    narrow) sleep 0.3; hyprctl dispatch 'hl.dsp.layout("colresize 0.5")' >/dev/null ;;
    esac
  fi
  ;;
close)
  practice | jq -r '.[].pid' | xargs -r kill 2>/dev/null
  if [ -f "$dir/back" ]; then
    hyprctl dispatch "hl.dsp.focus({ workspace = $(cat "$dir/back") })" >/dev/null
    rm -f "$dir/back"
  fi
  ;;
state)
  jq -cn \
    --argjson win "$(hyprctl activewindow -j 2>/dev/null || echo '{}')" \
    --argjson ws "$(hyprctl activeworkspace -j)" \
    --argjson mons "$(hyprctl monitors -j)" \
    --argjson layers "$(hyprctl layers -j)" \
    --argjson practice "$(practice)" \
    '{
      window: ($win.address // ""),
      x: ($win.at[0] // 0),
      width: ($win.size[0] // 0),
      workspace: $ws.id,
      # Turned sideways (an odd transform), its width is its height.
      screen: ([$mons[] | select(.focused)][0] | (if .transform % 2 == 1 then .height else .width end) / .scale),
      widths: [$practice[] | select(.workspace.id == $ws.id) | .size[0]],
      columns: ([$practice[] | select(.workspace.id == $ws.id) | .at[0]] | unique | length),
      layers: [$layers | .. | .namespace? // empty]
    }'
  ;;
*)
  echo "learn-practice open N [uneven] | close | state" >&2
  exit 2
  ;;
esac
