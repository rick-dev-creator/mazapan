// Generated by mazapan (plugin {{ plugin }}).
//
// The ISO's installer: a screen each for the language (the live desktop
// switches at once), the keyboard (tried right there), where you are, the
// disk (the whole of it: only which one), your account, and what you'll use
// the computer for (profiles, several at once; their apps come on the first
// login). Then a review, and `mazapan install run` does it, detached (it
// outlives a shell reload) and followed through its log. Where it was is
// kept (~/.local/state/mazapan/installer.json), the password only in memory.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import Quickshell.Networking
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null

  readonly property string stateFile: Quickshell.env("HOME") + "/.local/state/mazapan/installer.json"
  // Only the user's own runtime folder (0700): the answers carry the password.
  readonly property string runDir: Quickshell.env("XDG_RUNTIME_DIR") || ""
  readonly property string runLog: runDir + "/mazapan-install.log"
  readonly property string answersFile: runDir + "/mazapan-install.json"
  readonly property string applyLog: Quickshell.env("HOME") + "/.local/state/mazapan/installer-apply.log"
  // Where you are before the keyboard: its suggestions come from there.
  readonly property var steps: ["language", "region", "keyboard", "network", "disk", "account", "apps", "review"]
  property string step: "language"
  property string problem: ""

  // Across reloads: the password (never on disk but for the install's own
  // moment), and whether it was closed.
  PersistentProperties {
    id: session
    reloadableId: "mazapan-installer"
    property string password: ""
    property string again: ""
    property bool dismissed: false
    onLoaded: if (store.loaded_) root.maybeOpen()
  }

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    probe.running = true
    disksProbe.running = true
    keysProbe.running = true
    kbNow.running = true
    stepAt = Date.now() + 800
    open = true
    Qt.callLater(() => card.forceActiveFocus())
  }

  function close() {
    if (phase === "running") return
    open = false
    session.dismissed = true
  }

  // Clicks right after it opens, or a step changes, aren't taken.
  property double stepAt: 0
  function settled() { return Date.now() - stepAt > 400 }

  // --- what's asked, kept ---------------------------------------------------------

  property string language: {{ quote lang_code }}
  property string layout: "us"
  property string variant: ""
  property string timezone: ""
  property string disk: ""
  property bool encrypt: false
  property string fullname: ""
  property string user: ""
  property bool userEdited: false
  property string hostname: ""
  property bool hostEdited: false
  // Profiles chosen, and apps added or taken out of them one by one.
  property var chosen: ({})
  property var plus: ({})
  property var minus: ({})
  property bool details: false
  // "", "running", "done", "failed"; the run's id, to tell its log from an older one's.
  property string phase: ""
  property string runId: ""

  FileView {
    id: store
    property bool loaded_: false
    path: root.stateFile
    printErrors: false
    atomicWrites: true
    onLoaded: {
      try {
        const o = JSON.parse(text())
        // The step last: arriving at it acts on what's already been done
        // (a time zone asked for, a keyboard picked).
        for (const k of ["timezone", "disk", "fullname", "user", "hostname", "phase", "runId"])
          if (typeof o[k] === "string") root[k] = o[k]
        for (const k of ["encrypt", "userEdited", "hostEdited", "kbPicked", "zoneAsked"]) root[k] = o[k] === true
        if (root.steps.includes(o.step)) root.step = o.step
        for (const k of ["chosen", "plus", "minus"]) if (o[k] && typeof o[k] === "object") root[k] = o[k]
      } catch (e) {}
      loaded_ = true
      if (root.phase === "running") runView.reload()
      root.maybeOpen()
    }
    onLoadFailed: {
      loaded_ = true
      root.maybeOpen()
    }
  }
  function save() {
    store.setText(JSON.stringify({
      step: step, timezone: timezone, disk: disk, encrypt: encrypt, fullname: fullname, user: user,
      userEdited: userEdited, hostname: hostname, hostEdited: hostEdited, chosen: chosen, plus: plus, minus: minus,
      kbPicked: kbPicked, zoneAsked: zoneAsked,
      phase: phase, runId: runId,
    }))
  }

  // On the live system it opens by itself, once the desktop is up.
  function maybeOpen() {
    if (!session.dismissed || phase === "running") firstRun.start()
  }
  Timer {
    id: firstRun
    interval: 1200
    onTriggered: if (!root.open) root.show()
  }

  function go(s) {
    step = s
    stepAt = Date.now()
    problem = ""
    save()
  }
  // Wi-Fi only when there's no connection (nothing needs it to install).
  function shown(s) { return s !== "network" || !online }
  function next() {
    let i = steps.indexOf(step) + 1
    while (i < steps.length - 1 && !shown(steps[i])) i++
    go(steps[Math.min(i, steps.length - 1)])
  }
  function back() {
    let i = steps.indexOf(step) - 1
    while (i > 0 && !shown(steps[i])) i--
    go(steps[Math.max(i, 0)])
  }

  // --- what's there ----------------------------------------------------------------

  property var zones: []
  // The languages there are mazapan translations for (their locales/*.toml).
  property var languages: ["en"]
  // The world's main languages, each in its own words. Any of them: the
  // system and its apps speak it (its locale); mazapan's own screens too
  // where there's a translation, else in English until someone adds it.
  readonly property var worldLanguages: [
    ["en", "English"], ["es", "Español"], ["pt", "Português"], ["fr", "Français"], ["de", "Deutsch"],
    ["it", "Italiano"], ["nl", "Nederlands"], ["pl", "Polski"], ["ru", "Русский"], ["uk", "Українська"],
    ["tr", "Türkçe"], ["ar", "العربية"], ["he", "עברית"], ["fa", "فارسی"], ["hi", "हिन्दी"],
    ["bn", "বাংলা"], ["id", "Bahasa Indonesia"], ["ms", "Bahasa Melayu"], ["vi", "Tiếng Việt"], ["th", "ไทย"],
    ["zh", "中文"], ["ja", "日本語"], ["ko", "한국어"], ["sv", "Svenska"], ["nb", "Norsk"],
    ["da", "Dansk"], ["fi", "Suomi"], ["cs", "Čeština"], ["el", "Ελληνικά"], ["ro", "Română"],
    ["hu", "Magyar"], ["ca", "Català"],
  ]
  // Translated ones first (in their own names), then the rest.
  readonly property var languagesShown: {
    const q = langSearch.text.toLowerCase().trim()
    const all = languages.map(c => [c, nativeName(c)])
      .concat(worldLanguages.filter(w => !languages.includes(w[0])))
    return q === "" ? all : all.filter(l => (l[0] + " " + l[1] + " " + Qt.locale(l[0]).nativeLanguageName).toLowerCase().includes(q))
  }
  // A language in its own words: "Español", "Français", "日本語".
  property var selfNames: ({})
  function nativeName(code) {
    if (selfNames[code]) return selfNames[code]
    const w = worldLanguages.find(l => l[0] === code.split("_")[0])
    if (w) return w[1]
    const n = Qt.locale(code).nativeLanguageName || code
    return n.charAt(0).toUpperCase() + n.slice(1)
  }
  // The SSH keys that will let in (only when the live system was set up to
  // be reached over SSH): said in the review.
  property var sshKeys: []
  Process {
    id: keysProbe
    command: ["sudo", "-n", "mazapan", "install", "keys", "--json"]
    stdout: StdioCollector { onStreamFinished: { try { root.sshKeys = JSON.parse(text) } catch (e) { root.sshKeys = [] } } }
  }

  // Which country each time zone is in (tzdata): the keyboards to suggest.
  property var zoneCountry: ({})
  FileView {
    path: "/usr/share/zoneinfo/zone1970.tab"
    printErrors: false
    onLoaded: {
      const m = {}
      for (const line of text().split("\n")) {
        const f = line.split("\t")
        if (f.length >= 3 && !line.startsWith("#")) m[f[2].trim()] = f[0].split(",")[0]
      }
      root.zoneCountry = m
    }
  }
  readonly property string country: zoneCountry[timezone] || ""
  property var profiles: []
  property var apps: []
  property var disks: []
  property string theme: ""
  property bool detecting: false
  property string suggested: ""

  Process {
    id: probe
    command: ["sh", "-c", 'echo "tz:$(timedatectl show -p Timezone --value 2>/dev/null)"; '
      // Today's zones (tzdata's zone1970.tab), not the old names kept for compatibility (Mexico/BajaNorte).
      + 'echo "zones:$(awk -F"\\t" "!/^#/ {print \\$3}" /usr/share/zoneinfo/zone1970.tab 2>/dev/null | sort | tr "\\n" " ") UTC"; '
      + 'echo "themes:$(mazapan themes --json 2>/dev/null | tr -d "\\n")"; '
      + 'echo "apps:$(mazapan apps list --json 2>/dev/null | tr -d "\\n")"; '
      // The languages there are translations for (a new one, contributed, shows up by itself).
      + 'r=$(dirname "$(dirname "$(readlink -f "$(command -v mazapan)")")"); '
      // Each says its own name (self = "Español").
      + "for f in \"$r\"/plugins/installer/locales/*.toml; do c=${f##*/}; echo \"lang:${c%.toml}=$(sed -n 's/^self *= *\"\\(.*\\)\"$/\\1/p' \"$f\")\"; done"]
    stdout: StdioCollector {
      onStreamFinished: {
        const get = k => (text.split("\n").find(l => l.startsWith(k + ":")) || "").slice(k.length + 1)
        root.zones = get("zones").trim().split(" ").filter(z => z !== "")
        if (root.timezone === "") root.timezone = get("tz").trim() || "UTC"
        const names = {}
        for (const l of text.split("\n")) {
          const m = /^lang:([a-z]{2,3}(?:_[A-Z]{2})?)=(.*)$/.exec(l)
          if (m) names[m[1]] = m[2]
        }
        if (Object.keys(names).length > 0) {
          root.selfNames = names
          root.languages = Object.keys(names).sort((a, b) => root.nativeName(a).localeCompare(root.nativeName(b)))
        }
        try { root.theme = JSON.parse(get("themes")).current || "" } catch (e) {}
        try {
          const a = JSON.parse(get("apps"))
          root.profiles = a.profiles || []
          root.apps = a.apps || []
          // The basic one, to start with.
          if (Object.keys(root.chosen).length === 0) {
            const c = {}
            for (const p of root.profiles) if (p.basic) c[p.id] = true
            root.chosen = c
          }
        } catch (e) {}
      }
    }
  }

  Process {
    id: disksProbe
    command: ["mazapan", "install", "disks", "--json"]
    stdout: StdioCollector {
      onStreamFinished: {
        try { root.disks = JSON.parse(text) } catch (e) { root.disks = [] }
        // One disk that fits: it's that one.
        const fit = root.disks.filter(d => !d.too_small)
        if (root.disk === "" || !root.disks.some(d => d.path === root.disk)) root.disk = fit.length === 1 ? fit[0].path : ""
      }
    }
  }

  Process {
    id: kbNow
    command: ["sh", "-c", "grep -E '^ *kb_(layout|variant) *=' ~/.config/hypr/hyprland.lua | sed -E 's/.*\"(.*)\".*/\\1/'"]
    stdout: StdioCollector {
      onStreamFinished: {
        const l = text.split("\n")
        root.layout = l[0] || "us"
        root.variant = l[1] || ""
      }
    }
  }

  property var allLayouts: []
  FileView {
    path: "/usr/share/X11/xkb/rules/base.lst"
    printErrors: false
    onLoaded: {
      const out = []
      let section = ""
      for (const line of text().split("\n")) {
        if (line.startsWith("! ")) { section = line.slice(2).trim(); continue }
        const m = /^\s+(\S+)\s+(.*)$/.exec(line)
        if (!m) continue
        if (section === "layout") out.push({ layout: m[1], variant: "", name: m[2] })
        else if (section === "variant") {
          const v = /^(\S+):\s*(.*)$/.exec(m[2])
          if (v) out.push({ layout: v[1], variant: m[1], name: v[2] })
        }
      }
      root.allLayouts = out
    }
  }

  readonly property var commonLayouts: [
    ["us", "", {{ tq "kb.us" }}], ["us", "intl", {{ tq "kb.us_intl" }}], ["latam", "", {{ tq "kb.latam" }}],
    ["es", "", {{ tq "kb.es" }}], ["gb", "", {{ tq "kb.gb" }}], ["de", "", {{ tq "kb.de" }}], ["fr", "", {{ tq "kb.fr" }}],
    ["it", "", {{ tq "kb.it" }}], ["pt", "", {{ tq "kb.pt" }}], ["br", "", {{ tq "kb.br" }}],
  ].map(c => ({ layout: c[0], variant: c[1], name: c[2] }))

  // The keyboards of where you are and your language, first: Germany's in
  // Germany, Latin America's for Spanish there, the UK's in the UK…
  readonly property var suggestedLayouts: {
    const out = []
    const add = (l, v) => {
      if (out.some(k => k.layout === l && k.variant === v)) return
      const k = commonLayouts.find(c => c.layout === l && c.variant === v) || allLayouts.find(c => c.layout === l && c.variant === v)
      if (k) out.push(k)
    }
    const cc = country.toLowerCase()
    const latam = ["mx", "ar", "co", "cl", "pe", "ve", "ec", "gt", "cu", "bo", "do", "hn", "py", "sv", "ni", "cr", "pa", "uy"]
    if (language.startsWith("es") && latam.includes(cc)) add("latam", "")
    if (cc !== "") add(cc, "")
    // The language's own keyboard, where its code isn't the layout's.
    const lang = language.split("_")[0]
    const byLang = { en: "us", ja: "jp", ko: "kr", uk: "ua", el: "gr", cs: "cz", sv: "se", da: "dk", he: "il",
                     fa: "ir", ar: "ara", hi: "in", vi: "vn", ca: "es", nb: "no", zh: "cn", bn: "bd", ms: "us", id: "us" }
    add(byLang[lang] || lang, "")
    return out
  }
  property bool kbPicked: false
  onStepChanged: {
    // The account's first field takes the keys; elsewhere the card (Enter, Esc).
    if (open) Qt.callLater(() => step === "account" ? nameField.focusInput() : card.forceActiveFocus())
    // The keyboard it suggests, taken already (one click to change it);
    // the time zone from the connection, when there's one.
    // Until one is picked by hand, it follows where you are (changed on the way back).
    const k = suggestedLayouts[0]
    if (step === "keyboard" && !kbPicked && k && (k.layout !== layout || k.variant !== variant)) setKeyboard(k.layout, k.variant)
    if (step === "region" && online && !zoneAsked) {
      zoneAsked = true
      detectZone()
    }
  }
  property bool zoneAsked: false

  readonly property var kbShown: {
    const q = kbSearch.text.toLowerCase().trim()
    if (q === "") return suggestedLayouts.concat(commonLayouts.filter(c => !suggestedLayouts.some(k => k.layout === c.layout && k.variant === c.variant)))
    const match = k => (k.name + " " + k.layout + " " + k.variant).toLowerCase().includes(q)
    const mine = commonLayouts.filter(match)
    return mine.concat(allLayouts.filter(k => match(k) && !mine.some(c => c.layout === k.layout && c.variant === k.variant))).slice(0, 80)
  }
  readonly property var zonesShown: {
    const q = tzSearch.text.toLowerCase().trim().replace(/ /g, "_")
    return q === "" ? [] : zones.filter(z => z.toLowerCase().includes(q)).slice(0, 60)
  }

  readonly property bool online: Networking.devices.values.some(d => d.connected)
  readonly property var wifi: Networking.devices.values.find(d => d.type === DeviceType.Wifi) ?? null

  // The apps it'll install: the chosen profiles', plus and minus one by one.
  readonly property var appIds: {
    const ids = []
    for (const p of profiles) if (chosen[p.id]) for (const id of p.apps) if (!ids.includes(id)) ids.push(id)
    for (const id of Object.keys(plus)) if (plus[id] && !ids.includes(id)) ids.push(id)
    return ids.filter(id => !minus[id])
  }
  function appName(id) { return (apps.find(a => a.id === id) || { name: id }).name }
  readonly property var diskNow: disks.find(d => d.path === disk) ?? null
  function size(b) { return b >= 1e12 ? (b / 1e12).toFixed(1) + " TB" : Math.round(b / 1e9) + " GB" }

  // --- taking effect (on the live system) -------------------------------------------

  function setLanguage(code) {
    if (code === language) return
    language = code
    next()
    Quickshell.execDetached(["sh", "-c", 'mkdir -p ~/.local/state/mazapan; mazapan apply "$@" > "$0" 2>&1', root.applyLog, "--language=" + code])
  }

  property var kbWanted: null
  function setKeyboard(l, v) {
    layout = l
    variant = v
    kbWanted = [l, v]
    if (!kbApply.running) kbNext()
  }
  function kbNext() {
    if (!kbWanted) return
    const [l, v] = kbWanted
    kbWanted = null
    kbApply.command = ["mazapan", "apply", "--set=hypr-base.kb_layout=" + JSON.stringify(l), "--set=hypr-base.kb_variant=" + JSON.stringify(v)]
    kbApply.running = true
  }
  Process {
    id: kbApply
    stderr: StdioCollector { id: kbErr }
    onExited: code => {
      if (code !== 0) root.problem = {{ tq "apply_failed" }}.arg(kbErr.text.replace(/^mazapan: /, "").trim())
      if (root.kbWanted) root.kbNext()
      else kbNow.running = true
    }
  }

  function detectZone() {
    detecting = true
    detect.running = true
  }
  Process {
    id: detect
    command: ["curl", "-fsS", "--max-time", "6", "https://ipinfo.io/timezone"]
    stdout: StdioCollector {
      onStreamFinished: {
        const z = text.trim()
        root.suggested = root.zones.includes(z) ? z : ""
        if (root.suggested !== "") { root.timezone = root.suggested; root.save() }
      }
    }
    onExited: code => {
      root.detecting = false
      // Only when there's none yet: one found already stays, said or not.
      if ((code !== 0 || root.suggested === "") && (root.timezone === "" || root.timezone === "UTC")) root.problem = {{ tq "tz_undetected" }}
    }
  }

  // A user name from the full name: "María José" → "maria".
  function userFrom(name) {
    let first = name.trim().split(/\s+/)[0] || ""
    if (first.normalize) first = first.normalize("NFD")
    const u = first.replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9_-]/g, "").replace(/^[^a-z_]+/, "").slice(0, 32)
    // A name in another script (李, Анна, محمد): a plain one to start from, theirs to change.
    return u !== "" || name.trim() === "" ? u : "user"
  }
  onFullnameChanged: if (!userEdited) user = userFrom(fullname)
  onUserChanged: if (!hostEdited) hostname = user !== "" ? (user.replace(/_/g, "-").replace(/^-+|-+$/g, "") + "-pc") : ""

  // As core checks them (Setup/Answers.cs): the system's own names.
  readonly property var taken: ["root", "bin", "daemon", "mail", "ftp", "http", "nobody", "dbus", "polkitd", "git", "live",
    "systemd-journal-remote", "systemd-network", "systemd-oom", "systemd-resolve", "systemd-timesync", "systemd-coredump",
    "uuidd", "avahi", "rtkit", "colord", "flatpak", "geoclue", "alpm", "tss", "admin", "greeter", "systemd-imds", "pcscd", "usbmux", "brltty"]

  readonly property string accountProblem: {
    if (fullname.trim() === "") return {{ tq "acc.need_name" }}
    if (!/^[a-z_][a-z0-9_-]{0,31}$/.test(user)) return {{ tq "acc.bad_user" }}
    if (root.taken.includes(user)) return {{ tq "acc.taken_user" }}
    if (fullname.length > 100 || /[:,\n\r]/.test(fullname)) return {{ tq "acc.bad_name" }}
    if (session.password === "") return {{ tq "acc.need_password" }}
    if (session.password !== session.again) return {{ tq "acc.mismatch" }}
    if (encrypt && !/^[ -~]*$/.test(session.password)) return {{ tq "acc.ascii" }}
    if (!/^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$/.test(hostname)) return {{ tq "acc.bad_host" }}
    return ""
  }

  // What's wrong with the account, said as it's fixed (never a stale one).
  onAccountProblemChanged: if (step === "account" && problem !== "") problem = accountProblem

  function canGo() {
    if (step === "disk") return !!diskNow && !diskNow.too_small
    if (step === "account") return accountProblem === ""
    if (step === "review") return !!diskNow && !diskNow.too_small && accountProblem === "" && theme !== "" && runDir !== ""
    return true
  }

  // Enter moves on, but never starts the install: that one is a click.
  function primary(byKey) {
    if (!settled()) return
    if (step === "review" && byKey) return
    if (!canGo()) {
      if (step === "account") problem = accountProblem
      // Something changed since (the password is kept in memory only, a
      // disk went away): back to where it's asked.
      if (step === "review") {
        const to = !diskNow || diskNow.too_small ? "disk" : accountProblem !== "" ? "account" : ""
        if (to !== "") { go(to); problem = to === "account" ? accountProblem : "" }
        else problem = {{ tq "not_ready" }}
      }
      return
    }
    if (step === "review") install()
    else next()
  }

  // --- installing -------------------------------------------------------------------

  // The answers go to a file only root and this user can read, through
  // stdin (not a command line anyone could see); mazapan deletes it on
  // reading it. Then the install, detached.
  function install() {
    if (phase === "running") return
    runId = String(Date.now())
    progress = 0
    runStep = "disk"
    runFail = ""
    phase = "running"
    save()
    writeAnswers.running = true
  }
  Process {
    id: writeAnswers
    command: ["sh", "-c", 'umask 077; cat > "$0"', root.answersFile]
    stdinEnabled: true
    onStarted: {
      write(JSON.stringify({
        disk: root.disk, encrypt: root.encrypt, user: root.user, fullname: root.fullname.trim(),
        password: session.password, hostname: root.hostname, timezone: root.timezone,
        language: root.language, locale: "", kb_layout: root.layout, kb_variant: root.variant,
        theme: root.theme, apps: root.appIds,
      }))
      stdinEnabled = false
    }
    onExited: code => {
      stdinEnabled = true
      if (code !== 0) { root.runFail = "answers"; root.phase = "failed"; root.save(); return }
      // Nothing sleeps or locks while it runs; the answers go even if sudo doesn't take them.
      Quickshell.execDetached(["sh", "-c", 'log=$0; echo "START $1" > "$log"; '
        + 'systemd-inhibit --what=sleep:idle:handle-lid-switch --who=mazapan --why=installing sudo -n mazapan install run "$2" >> "$log" 2>&1; '
        + 'code=$?; rm -f "$2"; echo "EXIT $code" >> "$log"',
        root.runLog, root.runId, root.answersFile])
      runView.reload()
    }
  }

  property string runStep: "disk"
  property real progress: 0
  property string runFail: ""
  property string runLast: ""
  // Where each step starts, and how much of the bar it takes (packages go by count).
  readonly property var stepAt_: ({ disk: [0, 0.04], base: [0.04, 0.5], boot: [0.54, 0.08], account: [0.62, 0.03], desktop: [0.65, 0.3], finish: [0.95, 0.05] })

  // The log may not be there yet when it starts, and a new file isn't
  // watched: looked at every second while it runs.
  Timer {
    interval: 1000
    repeat: true
    running: root.phase === "running"
    onTriggered: runView.reload()
  }
  FileView {
    id: runView
    path: root.runLog
    printErrors: false
    watchChanges: true
    onFileChanged: reload()
    onLoaded: {
      const lines = text().split("\n")
      if (!lines[0] || lines[0] !== "START " + root.runId) return
      let st = "disk", frac = 0, fail = "", exit = null, last = ""
      for (const l of lines) {
        if (l.startsWith("step ")) { st = l.slice(5).trim(); frac = 0 }
        else if (l.startsWith("progress ")) { const [n, of] = l.slice(9).split(" ").map(Number); if (of > 0) frac = n / of }
        else if (l.startsWith("fail ")) fail = l.slice(5)
        else if (l.startsWith("EXIT ")) exit = Number(l.slice(5))
        else if (l.startsWith("mazapan: ")) last = l.slice(8)
      }
      root.runStep = st
      const at = root.stepAt_[st] || [0, 0]
      root.progress = Math.max(root.progress, at[0] + at[1] * frac)
      root.runLast = last
      if (exit === null) return
      if (exit === 0) {
        root.progress = 1
        root.phase = "done"
        session.password = ""
        session.again = ""
      } else {
        root.runFail = fail || "unknown"
        root.phase = "failed"
      }
      root.save()
    }
  }

  // --- the screen -------------------------------------------------------------------

  component Choice: Rectangle {
    id: choice
    property string text: ""
    property string detail: ""
    property bool selected: false
    signal picked()
    Layout.fillWidth: true
    implicitHeight: detail !== "" ? 52 : 40
    radius: Theme.radius
    color: selected ? Theme.selection : ch.containsMouse ? Theme.surface : "transparent"
    border.color: selected ? Theme.accent : "transparent"
    border.width: 1
    MouseArea {
      id: ch
      anchors.fill: parent
      hoverEnabled: true
      cursorShape: Qt.PointingHandCursor
      onClicked: if (root.settled()) choice.picked()
    }
    ColumnLayout {
      anchors.fill: parent
      anchors.leftMargin: 14
      anchors.rightMargin: 14
      spacing: 0
      Item { Layout.fillHeight: true }
      Label { text: choice.text; font.bold: choice.selected; elide: Text.ElideRight; Layout.fillWidth: true }
      Caption { visible: choice.detail !== ""; text: choice.detail; elide: Text.ElideRight; Layout.fillWidth: true }
      Item { Layout.fillHeight: true }
    }
  }

  component Field: ColumnLayout {
    property alias text: f.text
    property alias echoMode: f.echoMode
    property string label: ""
    property string placeholder: ""
    signal edited()
    signal accepted()
    function focusInput() { f.focusInput() }
    spacing: 4
    Layout.fillWidth: true
    Caption { text: parent.label }
    TextField {
      id: f
      Layout.fillWidth: true
      implicitHeight: 32
      placeholder: parent.placeholder
      onTextChanged: parent.edited()
      onAccepted: parent.accepted()
    }
  }

  component Row2: RowLayout {
    property string key: ""
    property string value: ""
    Layout.fillWidth: true
    spacing: 16
    Caption { text: parent.key; Layout.preferredWidth: 150 }
    Label { text: parent.value; wrapMode: Text.Wrap; Layout.fillWidth: true }
  }


  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    anchors { top: true; bottom: true; left: true; right: true }
    color: Qt.alpha(Theme.bg, 0.86)
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.namespace: "mazapan-panel-installer"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      anchors.centerIn: parent
      width: Math.min(820, parent.width - 40)
      height: Math.min(600, parent.height - 40)
      radius: Theme.radius
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      focus: true
      Keys.onEscapePressed: root.close()
      Keys.onReturnPressed: if (root.phase === "") root.primary(true)
      Keys.onEnterPressed: if (root.phase === "") root.primary(true)

      // --- asking ---------------------------------------------------------------------
      ColumnLayout {
        visible: root.phase === ""
        anchors.fill: parent
        anchors.margins: 28
        spacing: 14

        Row {
          Layout.alignment: Qt.AlignHCenter
          spacing: 8
          Repeater {
            model: root.steps.filter(s => root.shown(s))
            Rectangle {
              required property string modelData
              width: root.step === modelData ? 22 : 8
              height: 8
              radius: 4
              color: root.step === modelData ? Theme.accent : Theme.border
              Behavior on width { NumberAnimation { duration: Theme.motion ? 150 : 0 } }
            }
          }
        }

        // Mazapán's icon, on the first screen.
        Image {
          visible: root.step === "language"
          Layout.alignment: Qt.AlignHCenter
          source: Qt.resolvedUrl("../assets/mazapan.svg")
          sourceSize: Qt.size(80, 80)
          Layout.preferredWidth: 80
          Layout.preferredHeight: 80
          smooth: false
        }
        Label {
          text: ({ language: {{ tq "t.language" }}, keyboard: {{ tq "t.keyboard" }}, region: {{ tq "t.region" }}, network: {{ tq "t.network" }},
                   disk: {{ tq "t.disk" }}, account: {{ tq "t.account" }}, apps: {{ tq "t.apps" }}, review: {{ tq "t.review" }} })[root.step] || ""
          font.pointSize: 18
          font.bold: true
          Layout.alignment: Qt.AlignHCenter
        }
        Caption {
          text: ({ language: {{ tq "d.language" }}, keyboard: {{ tq "d.keyboard" }}, region: {{ tq "d.region" }}, network: {{ tq "d.network" }},
                   disk: {{ tq "d.disk" }}, account: {{ tq "d.account" }}, apps: {{ tq "d.apps" }}, review: {{ tq "d.review" }} })[root.step] || ""
          horizontalAlignment: Text.AlignHCenter
          wrapMode: Text.Wrap
          Layout.fillWidth: true
          Layout.preferredWidth: 0
        }

        Item {
          Layout.fillWidth: true
          Layout.fillHeight: true

          // Language: in its own name.
          ColumnLayout {
            visible: root.step === "language"
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            anchors.bottom: parent.bottom
            width: Math.min(460, parent.width)
            spacing: 8
            TextField {
              id: langSearch
              Layout.fillWidth: true
              placeholder: {{ tq "lang.search" }}
              onAccepted: if (root.languagesShown.length > 0) root.setLanguage(root.languagesShown[0][0])
            }
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.languagesShown
              delegate: Choice {
                required property var modelData
                width: ListView.view.width
                text: modelData[1]
                // Not translated yet: said, so it's no surprise.
                detail: root.languages.includes(modelData[0]) ? "" : {{ tq "lang.partial" }}
                selected: root.language === modelData[0] || root.language.split("_")[0] === modelData[0]
                onPicked: root.setLanguage(modelData[0])
              }
            }
          }

          // Keyboard: the common ones, then all of them; tried in a field.
          ColumnLayout {
            visible: root.step === "keyboard"
            anchors.fill: parent
            spacing: 8
            TextField {
              id: kbSearch
              Layout.fillWidth: true
              placeholder: {{ tq "kb.search" }}
              onAccepted: if (root.kbShown.length > 0) root.setKeyboard(root.kbShown[0].layout, root.kbShown[0].variant)
            }
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.kbShown
              delegate: Choice {
                required property var modelData
                width: ListView.view.width
                text: modelData.name
                detail: modelData.layout + (modelData.variant ? " · " + modelData.variant : "")
                selected: root.layout === modelData.layout && root.variant === modelData.variant
                onPicked: { root.kbPicked = true; root.setKeyboard(modelData.layout, modelData.variant) }
              }
            }
            TextField {
              Layout.fillWidth: true
              placeholder: {{ tq "kb.try" }}
            }
          }

          // Region: the time zone, from the connection when there's one.
          ColumnLayout {
            visible: root.step === "region"
            anchors.fill: parent
            spacing: 8
            RowLayout {
              Layout.fillWidth: true
              Label { text: {{ tq "tz.now" }}.arg((root.timezone || "UTC").replace(/_/g, " ")); Layout.fillWidth: true }
              Button {
                visible: root.online
                enabled: !root.detecting
                text: root.detecting ? {{ tq "tz.detecting" }} : {{ tq "tz.detect" }}
                onClicked: if (root.settled()) root.detectZone()
              }
            }
            TextField {
              id: tzSearch
              Layout.fillWidth: true
              placeholder: {{ tq "tz.search" }}
              onAccepted: if (root.zonesShown.length > 0) { root.timezone = root.zonesShown[0]; root.save() }
            }
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.zonesShown
              delegate: Choice {
                required property string modelData
                width: ListView.view.width
                text: modelData.replace(/_/g, " ")
                selected: root.timezone === modelData
                onPicked: { root.timezone = modelData; root.save() }
              }
            }
          }

          // Wi-Fi: not needed to install, but for the apps afterwards.
          ColumnLayout {
            id: netStep
            visible: root.step === "network"
            anchors.fill: parent
            spacing: 8
            property var asking: null
            property string failed: ""
            onAskingChanged: if (asking) Qt.callLater(() => pass.focusInput())
            Binding {
              target: root.wifi
              when: !!root.wifi
              property: "scannerEnabled"
              value: root.open && root.step === "network"
            }
            Connections {
              target: root.wifi
              ignoreUnknownSignals: true
              function onConnectionFailed() { netStep.failed = {{ tq "net.failed" }} }
            }
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.wifi && Networking.wifiEnabled ? root.wifi.networks.values.slice().sort((a, b) => b.signalStrength - a.signalStrength) : []
              delegate: Choice {
                required property var modelData
                width: ListView.view.width
                text: modelData.name
                detail: modelData.connected ? {{ tq "net.connected" }} : ""
                selected: modelData.connected
                onPicked: {
                  netStep.failed = ""
                  if (modelData.connected) return
                  if (modelData.known || modelData.security === WifiSecurityType.Open || modelData.security === WifiSecurityType.Unknown) modelData.connect()
                  else netStep.asking = modelData
                }
              }
            }
            Label {
              visible: !root.wifi
              Layout.alignment: Qt.AlignHCenter
              text: {{ tq "net.none" }}
              color: Theme.fgSubtle
            }
            Caption { visible: netStep.failed !== ""; text: netStep.failed; color: Theme.danger }
            TextField {
              id: pass
              visible: !!netStep.asking
              Layout.fillWidth: true
              echoMode: TextInput.Password
              placeholder: netStep.asking ? {{ tq "net.password" }}.arg(netStep.asking.name) : ""
              onAccepted: {
                if (netStep.asking && text !== "") netStep.asking.connectWithPsk(text)
                netStep.asking = null
                text = ""
              }
            }
          }

          // Disk: which one; all of it is used.
          ColumnLayout {
            visible: root.step === "disk"
            anchors.fill: parent
            spacing: 8
            ListView {
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 4
              model: root.disks
              delegate: Choice {
                required property var modelData
                width: ListView.view.width
                enabled: !modelData.too_small
                opacity: enabled ? 1 : 0.5
                text: (modelData.model || modelData.path) + " · " + root.size(modelData.size)
                detail: modelData.too_small ? {{ tq "disk.small" }}
                  : modelData.systems.length > 0 ? {{ tq "disk.has" }}.arg(modelData.systems.map(s => s === "windows" ? "Windows" : s === "macos" ? "macOS" : "Linux").join(", "))
                  : modelData.partitions > 0 ? {{ tq "disk.used" }} : {{ tq "disk.empty" }}
                selected: root.disk === modelData.path
                onPicked: { root.disk = modelData.path; root.save() }
              }
            }
            Label {
              visible: root.disks.length === 0
              Layout.alignment: Qt.AlignHCenter
              text: {{ tq "disk.none" }}
              color: Theme.fgSubtle
            }
            Rectangle {
              visible: !!root.diskNow
              Layout.fillWidth: true
              implicitHeight: warn.implicitHeight + 16
              radius: Theme.radius
              color: Qt.alpha(Theme.danger, 0.12)
              border.color: Theme.danger
              Label {
                id: warn
                anchors.fill: parent
                anchors.margins: 8
                wrapMode: Text.Wrap
                text: root.diskNow ? {{ tq "disk.erase" }}.arg((root.diskNow.model || root.diskNow.path) + " (" + root.size(root.diskNow.size) + ")") : ""
              }
            }
            RowLayout {
              Layout.fillWidth: true
              ColumnLayout {
                Layout.fillWidth: true
                spacing: 0
                Label { text: {{ tq "disk.encrypt" }} }
                Caption { text: {{ tq "disk.encrypt_d" }}; wrapMode: Text.Wrap; Layout.fillWidth: true }
              }
              Toggle {
                checked: root.encrypt
                onToggled: on => { root.encrypt = on; root.save() }
              }
            }
          }

          // Account: one screen.
          ColumnLayout {
            visible: root.step === "account"
            anchors.horizontalCenter: parent.horizontalCenter
            width: Math.min(460, parent.width)
            spacing: 10
            Field {
              id: nameField
              label: {{ tq "acc.name" }}
              placeholder: {{ tq "acc.name_p" }}
              text: root.fullname
              onEdited: if (text !== root.fullname) root.fullname = text
              onAccepted: userField.focusInput()
            }
            Field {
              id: userField
              label: {{ tq "acc.user" }}
              text: root.user
              onEdited: if (text !== root.user) { root.userEdited = true; root.user = text }
              onAccepted: pw.focusInput()
            }
            Field {
              id: pw
              label: root.encrypt ? {{ tq "acc.password_disk" }} : {{ tq "acc.password" }}
              echoMode: TextInput.Password
              text: session.password
              onEdited: session.password = text
              onAccepted: pw2.focusInput()
            }
            Field {
              id: pw2
              label: {{ tq "acc.again" }}
              echoMode: TextInput.Password
              text: session.again
              onEdited: session.again = text
              onAccepted: root.primary(true)
            }
            Field {
              label: {{ tq "acc.host" }}
              text: root.hostname
              onEdited: if (text !== root.hostname) { root.hostEdited = true; root.hostname = text }
              onAccepted: root.primary(true)
            }
          }

          // What for: profiles, several at once; each app, for whoever wants to see.
          ColumnLayout {
            visible: root.step === "apps"
            anchors.fill: parent
            spacing: 8
            GridLayout {
              visible: !root.details
              Layout.fillWidth: true
              Layout.fillHeight: true
              columns: 2
              rowSpacing: 8
              columnSpacing: 8
              Repeater {
                model: root.profiles
                Choice {
                  required property var modelData
                  Layout.fillHeight: true
                  text: modelData.name
                  detail: modelData.apps.slice(0, 4).map(id => root.appName(id)).join(", ") + (modelData.apps.length > 4 ? "…" : "")
                  selected: !!root.chosen[modelData.id]
                  onPicked: {
                    const c = Object.assign({}, root.chosen)
                    c[modelData.id] = !c[modelData.id]
                    root.chosen = c
                    root.save()
                  }
                }
              }
            }
            ListView {
              visible: root.details
              Layout.fillWidth: true
              Layout.fillHeight: true
              clip: true
              spacing: 2
              model: root.apps
              delegate: Choice {
                required property var modelData
                width: ListView.view.width
                text: modelData.name
                detail: modelData.description
                selected: root.appIds.includes(modelData.id)
                onPicked: {
                  const on = root.appIds.includes(modelData.id)
                  const p = Object.assign({}, root.plus), m = Object.assign({}, root.minus)
                  if (on) { delete p[modelData.id]; m[modelData.id] = true } else { delete m[modelData.id]; p[modelData.id] = true }
                  root.plus = p
                  root.minus = m
                  root.save()
                }
              }
            }
            RowLayout {
              Layout.fillWidth: true
              Caption { text: {{ tq "apps.count" }}.arg(root.appIds.length); Layout.fillWidth: true }
              Button {
                text: root.details ? {{ tq "apps.profiles" }} : {{ tq "apps.details" }}
                onClicked: if (root.settled()) root.details = !root.details
              }
            }
          }

          // Review: all of it, before anything happens.
          ColumnLayout {
            visible: root.step === "review"
            anchors.fill: parent
            spacing: 10
            Row2 { key: {{ tq "r.disk" }}; value: root.diskNow ? (root.diskNow.model || root.diskNow.path) + " · " + root.size(root.diskNow.size) + (root.encrypt ? " · " + {{ tq "r.encrypted" }} : "") : "" }
            Row2 { key: {{ tq "r.account" }}; value: root.fullname.trim() + " (" + root.user + ") · " + root.hostname }
            Row2 { key: {{ tq "r.language" }}; value: root.nativeName(root.language) + " · " + root.layout + (root.variant ? " " + root.variant : "") + " · " + (root.timezone || "UTC").replace(/_/g, " ") }
            Row2 { key: {{ tq "r.apps" }}; value: root.appIds.length === 0 ? {{ tq "r.no_apps" }} : root.appIds.map(id => root.appName(id)).join(", ") }
            Row2 { visible: root.sshKeys.length > 0; key: {{ tq "r.ssh" }}; value: {{ tq "r.ssh_d" }}.arg(root.sshKeys.join(", ")) }
            Item { Layout.fillHeight: true }
            Rectangle {
              Layout.fillWidth: true
              implicitHeight: rwarn.implicitHeight + 16
              radius: Theme.radius
              color: Qt.alpha(Theme.danger, 0.12)
              border.color: Theme.danger
              Label {
                id: rwarn
                anchors.fill: parent
                anchors.margins: 8
                wrapMode: Text.Wrap
                text: root.diskNow ? {{ tq "disk.erase" }}.arg((root.diskNow.model || root.diskNow.path) + " (" + root.size(root.diskNow.size) + ")") : ""
              }
            }
          }
        }

        Caption {
          visible: root.problem !== ""
          text: root.problem
          color: Theme.danger
          wrapMode: Text.Wrap
          Layout.fillWidth: true
          Layout.preferredWidth: 0
        }

        RowLayout {
          Layout.fillWidth: true
          Button {
            visible: root.step !== "language"
            text: {{ tq "back" }}
            onClicked: if (root.settled()) root.back()
          }
          Item { Layout.fillWidth: true }
          Button {
            primary: true
            opacity: root.canGo() ? 1 : 0.5
            text: root.step === "review" ? {{ tq "install" }} : {{ tq "continue" }}
            onClicked: root.primary()
          }
        }
      }

      // --- installing, and after ------------------------------------------------------
      ColumnLayout {
        visible: root.phase !== ""
        anchors.fill: parent
        anchors.margins: 40
        spacing: 18

        Item { Layout.fillHeight: true }
        Label {
          text: root.phase === "running" ? {{ tq "run.title" }} : root.phase === "done" ? {{ tq "done.title" }} : {{ tq "fail.title" }}
          font.pointSize: 20
          font.bold: true
          Layout.alignment: Qt.AlignHCenter
        }
        Caption {
          text: root.phase === "running" ? ({ disk: {{ tq "run.disk" }}, base: {{ tq "run.base" }}, boot: {{ tq "run.boot" }}, account: {{ tq "run.account" }},
                                               desktop: {{ tq "run.desktop" }}, finish: {{ tq "run.finish" }} })[root.runStep] || ""
            : root.phase === "done" ? {{ tq "done.d" }}
            : ({ uefi: {{ tq "fail.uefi" }}, answers: {{ tq "fail.answers" }} })[root.runFail.split(" ")[0]] || {{ tq "fail.d" }}
          horizontalAlignment: Text.AlignHCenter
          wrapMode: Text.Wrap
          Layout.fillWidth: true
          Layout.preferredWidth: 0
        }
        Rectangle {
          visible: root.phase === "running"
          Layout.fillWidth: true
          Layout.maximumWidth: 520
          Layout.alignment: Qt.AlignHCenter
          implicitHeight: 8
          radius: 4
          color: Theme.surface
          Rectangle {
            width: parent.width * root.progress
            height: parent.height
            radius: 4
            color: Theme.accent
            Behavior on width { NumberAnimation { duration: Theme.motion ? 400 : 0 } }
          }
        }
        Caption {
          visible: root.phase === "failed" && root.runLast !== ""
          text: root.runLast
          color: Theme.danger
          horizontalAlignment: Text.AlignHCenter
          wrapMode: Text.Wrap
          Layout.fillWidth: true
          Layout.preferredWidth: 0
        }
        RowLayout {
          Layout.alignment: Qt.AlignHCenter
          spacing: 10
          Button {
            visible: root.phase === "failed"
            text: {{ tq "fail.log" }}
            onClicked: Quickshell.execDetached(["foot", "-e", "less", "+G", "/var/log/mazapan-install.log"])
          }
          Button {
            visible: root.phase === "failed"
            text: {{ tq "fail.back" }}
            onClicked: { root.phase = ""; root.go(root.accountProblem !== "" ? "account" : "review") }
          }
          Button {
            visible: root.phase === "done"
            primary: true
            text: {{ tq "done.restart" }}
            onClicked: Quickshell.execDetached(["systemctl", "reboot"])
          }
        }
        Item { Layout.fillHeight: true }
      }
    }
  }
}
