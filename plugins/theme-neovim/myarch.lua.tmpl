-- Generated by myarch (plugin {{.Plugin}}) from theme "{{.Theme.ID}}".
-- :colorscheme myarch
vim.cmd("highlight clear")
if vim.g.syntax_on then vim.cmd("syntax reset") end
vim.g.colors_name = "myarch"
vim.o.background = "{{.Theme.Meta.Mode}}"
vim.o.termguicolors = true

local c = {
  bg = "{{solid (c "bg")}}", bg_alt = "{{solid (c "bg_alt")}}", surface = "{{solid (c "surface")}}", raised = "{{solid (c "surface_raised")}}",
  border = "{{solid (c "border")}}", fg = "{{solid (c "fg")}}", muted = "{{solid (c "fg_muted")}}", subtle = "{{solid (c "fg_subtle")}}",
  accent = "{{solid (c "accent")}}", accent_fg = "{{solid (c "accent_fg")}}", accent_text = "{{solid (c "accent_text")}}",
  deep = "{{solid (c "accent_deep")}}", selection = "{{solid (c "selection")}}",
  success = "{{solid (c "success")}}", warning = "{{solid (c "warning")}}", danger = "{{solid (c "danger")}}", info = "{{solid (c "info")}}",
  red = "{{solid (c "red")}}", green = "{{solid (c "green")}}", yellow = "{{solid (c "yellow")}}", blue = "{{solid (c "blue")}}",
  magenta = "{{solid (c "magenta")}}", cyan = "{{solid (c "cyan")}}",
}
-- See-through terminals: the editor lets their background through.
local bg = {{if lt .Theme.Effects.TerminalOpacity 1.0}}"NONE"{{else}}c.bg{{end}}

local function hl(group, spec) vim.api.nvim_set_hl(0, group, spec) end

-- Editor
hl("Normal", { fg = c.fg, bg = bg })
hl("NormalNC", { fg = c.fg, bg = bg })
hl("NormalFloat", { fg = c.fg, bg = c.raised })
hl("FloatBorder", { fg = c.border, bg = c.raised })
hl("FloatTitle", { fg = c.accent_text, bg = c.raised, bold = true })
hl("Cursor", { fg = c.accent_fg, bg = c.accent })
hl("CursorLine", { bg = c.surface })
hl("CursorColumn", { bg = c.surface })
hl("ColorColumn", { bg = c.surface })
hl("CursorLineNr", { fg = c.accent_text, bold = true })
hl("LineNr", { fg = c.subtle })
hl("SignColumn", { bg = bg })
hl("FoldColumn", { fg = c.subtle, bg = bg })
hl("Folded", { fg = c.muted, bg = c.surface })
hl("VertSplit", { fg = c.border })
hl("WinSeparator", { fg = c.border })
hl("EndOfBuffer", { fg = c.bg_alt })
hl("NonText", { fg = c.subtle })
hl("Whitespace", { fg = c.border })
hl("Visual", { bg = c.selection })
hl("VisualNOS", { bg = c.selection })
hl("Search", { fg = c.fg, bg = c.deep })
hl("IncSearch", { fg = c.accent_fg, bg = c.accent })
hl("CurSearch", { fg = c.accent_fg, bg = c.accent })
hl("Substitute", { fg = c.accent_fg, bg = c.warning })
hl("MatchParen", { fg = c.accent_text, bold = true, underline = true })
hl("Pmenu", { fg = c.fg, bg = c.raised })
hl("PmenuSel", { fg = c.accent_fg, bg = c.accent })
hl("PmenuSbar", { bg = c.surface })
hl("PmenuThumb", { bg = c.border })
hl("StatusLine", { fg = c.fg, bg = c.bg_alt })
hl("StatusLineNC", { fg = c.subtle, bg = c.bg_alt })
hl("TabLine", { fg = c.muted, bg = c.bg_alt })
hl("TabLineFill", { bg = c.bg_alt })
hl("TabLineSel", { fg = c.fg, bg = c.raised, bold = true })
hl("WinBar", { fg = c.muted, bg = bg })
hl("Title", { fg = c.accent_text, bold = true })
hl("Directory", { fg = c.accent_text })
hl("Question", { fg = c.success })
hl("MoreMsg", { fg = c.success })
hl("ModeMsg", { fg = c.fg, bold = true })
hl("ErrorMsg", { fg = c.danger })
hl("WarningMsg", { fg = c.warning })
hl("SpecialKey", { fg = c.subtle })
hl("Conceal", { fg = c.subtle })
hl("QuickFixLine", { bg = c.surface })
hl("SpellBad", { undercurl = true, sp = c.danger })
hl("SpellCap", { undercurl = true, sp = c.warning })
hl("SpellRare", { undercurl = true, sp = c.info })
hl("SpellLocal", { undercurl = true, sp = c.info })

-- Syntax: the theme's roles (keywords warm, strings green, numbers blue…)
hl("Comment", { fg = c.subtle, italic = true })
hl("Constant", { fg = c.magenta })
hl("String", { fg = c.success })
hl("Character", { fg = c.success })
hl("Number", { fg = c.info })
hl("Float", { fg = c.info })
hl("Boolean", { fg = c.warning })
hl("Identifier", { fg = c.fg })
hl("Function", { fg = c.yellow })
hl("Statement", { fg = c.warning })
hl("Keyword", { fg = c.warning })
hl("Conditional", { fg = c.warning })
hl("Repeat", { fg = c.warning })
hl("Exception", { fg = c.warning })
hl("Label", { fg = c.warning })
hl("Operator", { fg = c.muted })
hl("PreProc", { fg = c.accent_text })
hl("Include", { fg = c.accent_text })
hl("Define", { fg = c.accent_text })
hl("Macro", { fg = c.accent_text })
hl("Type", { fg = c.cyan })
hl("StorageClass", { fg = c.warning })
hl("Structure", { fg = c.cyan })
hl("Typedef", { fg = c.cyan })
hl("Special", { fg = c.accent_text })
hl("SpecialChar", { fg = c.accent_text })
hl("Tag", { fg = c.yellow })
hl("Delimiter", { fg = c.muted })
hl("SpecialComment", { fg = c.muted, italic = true })
hl("Underlined", { fg = c.accent_text, underline = true })
hl("Error", { fg = c.danger })
hl("Todo", { fg = c.accent_fg, bg = c.accent, bold = true })

-- Treesitter
local links = {
  ["@comment"] = "Comment", ["@string"] = "String", ["@string.escape"] = "SpecialChar",
  ["@string.special"] = "SpecialChar", ["@character"] = "Character", ["@number"] = "Number",
  ["@boolean"] = "Boolean", ["@constant"] = "Constant", ["@constant.builtin"] = "Constant",
  ["@function"] = "Function", ["@function.call"] = "Function", ["@function.method"] = "Function",
  ["@function.builtin"] = "Function", ["@constructor"] = "Type", ["@keyword"] = "Keyword",
  ["@keyword.function"] = "Keyword", ["@keyword.return"] = "Keyword", ["@keyword.import"] = "Include",
  ["@conditional"] = "Conditional", ["@repeat"] = "Repeat", ["@operator"] = "Operator",
  ["@type"] = "Type", ["@type.builtin"] = "Type", ["@module"] = "Identifier",
  ["@variable"] = "Identifier", ["@variable.builtin"] = "Constant", ["@variable.parameter"] = "Identifier",
  ["@punctuation"] = "Delimiter", ["@punctuation.bracket"] = "Delimiter", ["@tag"] = "Tag",
  ["@tag.attribute"] = "Constant", ["@markup.heading"] = "Title", ["@markup.link"] = "Underlined",
  ["@markup.raw"] = "String",
}
for group, target in pairs(links) do hl(group, { link = target }) end
hl("@property", { fg = c.magenta })
hl("@field", { fg = c.magenta })
hl("@variable.member", { fg = c.magenta })
hl("@markup.strong", { bold = true })
hl("@markup.italic", { italic = true })
hl("@lsp.type.property", { link = "@property" })
hl("@lsp.type.parameter", { link = "@variable.parameter" })
hl("@lsp.type.function", { link = "@function" })
hl("@lsp.type.method", { link = "@function.method" })
hl("@lsp.type.type", { link = "@type" })
hl("@lsp.type.namespace", { link = "@module" })

-- Diagnostics
for name, color in pairs({ Error = c.danger, Warn = c.warning, Info = c.info, Hint = c.accent_text, Ok = c.success }) do
  hl("Diagnostic" .. name, { fg = color })
  hl("DiagnosticVirtualText" .. name, { fg = color })
  hl("DiagnosticUnderline" .. name, { undercurl = true, sp = color })
  hl("DiagnosticSign" .. name, { fg = color })
end
hl("LspReferenceText", { bg = c.surface })
hl("LspReferenceRead", { bg = c.surface })
hl("LspReferenceWrite", { bg = c.surface })
hl("LspInlayHint", { fg = c.subtle, italic = true })

-- Diff and git
hl("DiffAdd", { bg = "{{mix (c "bg") (c "success") 0.18}}" })
hl("DiffChange", { bg = "{{mix (c "bg") (c "info") 0.14}}" })
hl("DiffDelete", { fg = c.danger, bg = "{{mix (c "bg") (c "danger") 0.16}}" })
hl("DiffText", { bg = "{{mix (c "bg") (c "info") 0.30}}" })
hl("Added", { fg = c.success })
hl("Changed", { fg = c.info })
hl("Removed", { fg = c.danger })
hl("GitSignsAdd", { fg = c.success })
hl("GitSignsChange", { fg = c.info })
hl("GitSignsDelete", { fg = c.danger })

-- Plugins people use most
hl("TelescopeNormal", { link = "NormalFloat" })
hl("TelescopeBorder", { link = "FloatBorder" })
hl("TelescopeSelection", { fg = c.fg, bg = c.surface })
hl("TelescopeMatching", { fg = c.accent_text, bold = true })
hl("TelescopePromptPrefix", { fg = c.accent_text })
hl("WhichKey", { fg = c.accent_text })
hl("WhichKeyGroup", { fg = c.info })
hl("WhichKeyDesc", { fg = c.fg })
hl("WhichKeySeparator", { fg = c.subtle })
hl("NeoTreeNormal", { fg = c.fg, bg = c.bg_alt })
hl("NeoTreeNormalNC", { fg = c.fg, bg = c.bg_alt })
hl("NvimTreeNormal", { fg = c.fg, bg = c.bg_alt })
hl("MiniStatuslineModeNormal", { fg = c.accent_fg, bg = c.accent, bold = true })
hl("SnacksPickerMatch", { fg = c.accent_text, bold = true })
hl("SnacksDashboardHeader", { fg = c.accent_text })
hl("BlinkCmpMenu", { link = "Pmenu" })
hl("BlinkCmpMenuSelection", { link = "PmenuSel" })

-- The terminal inside Neovim: the theme's 16 colors.
{{- range $i, $name := list "black" "red" "green" "yellow" "blue" "magenta" "cyan" "white" "bright_black" "bright_red" "bright_green" "bright_yellow" "bright_blue" "bright_magenta" "bright_cyan" "bright_white"}}
vim.g.terminal_color_{{$i}} = "{{solid (c $name)}}"
{{- end}}
