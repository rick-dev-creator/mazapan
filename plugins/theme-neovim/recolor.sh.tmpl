# Generated by mazapan (plugin {{ plugin }}): every running Neovim that uses
# the mazapan colorscheme loads it again, so a new theme shows at once.
for s in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*.0; do
  [ -S "$s" ] || continue
  # A Neovim suspended with ctrl-z never answers: don't wait for it.
  timeout 2 nvim --server "$s" --remote-expr "execute(get(g:, 'colors_name', '') ==# 'mazapan' ? 'colorscheme mazapan' : '')" >/dev/null 2>&1
done
exit 0
