// Generated by mazapan (plugin {{ plugin }}).
//
// Bluetooth for Share, on the shell's side: connected to the nearby service
// (mazapan-nearby.service, $XDG_RUNTIME_DIR/mazapan-nearby.sock), it sends
// files to a device, and keeps what the service asks (a pairing's code to
// confirm, a file a phone wants to send) and what arrives. The Share panel
// is where all of it goes on, and it opens by itself when a phone asks or
// sends (attention). A notification only says what happened (arrived,
// sent, couldn't be sent), and only when the panel isn't open to show it.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Bluetooth

Singleton {
  id: root

  readonly property string socketPath: (Quickshell.env("XDG_RUNTIME_DIR") || "/tmp") + "/mazapan-nearby.sock"
  // Connected to the service (Socket's own flag says what's wanted, not
  // what is, after an error).
  property bool ready: false

  // What's being asked: [{id, kind ("confirm" | "offer"), device, address,
  // passkey?, name?, size?}].
  property var asks: []
  // Sending, by address: {state, device, file, index, count, sent, total, error?}.
  property var sends: ({})
  // Arriving, newest first: [{id, path (once it's arrived), file, device,
  // state, sent, total}].
  property var receives: []

  // This computer visible to phones nearby, to pair from one: for the
  // adapter's discoverable time (three minutes), then hidden again.
  readonly property var adapter: Bluetooth.defaultAdapter
  readonly property bool visible: adapter !== null && adapter.enabled && adapter.discoverable
  function setVisible(on) {
    if (!adapter) return
    if (on && !adapter.enabled) adapter.enabled = true
    adapter.pairable = on
    adapter.discoverable = on
  }
  // Hidden again by itself: not pairable either.
  Connections {
    target: root.adapter
    function onDiscoverableChanged() { if (!root.adapter.discoverable && root.adapter.pairable) root.adapter.pairable = false }
  }

  // Something the person should see in the panel: a question, or a file
  // arriving.
  signal attention()
  property bool panelOpen: false

  // The settings (receive: "ask", "paired", "off"), read live: the service
  // reads the same file.
  property var settings: ({ receive: "ask" })
  FileView {
    path: Quickshell.shellPath("components/share/settings.json")
    blockLoading: true
    watchChanges: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: { try { root.settings = Object.assign({ receive: "ask" }, JSON.parse(text())) } catch (e) {} }
  }

  function send(address, files) {
    if (files.length === 0) return
    const s = Object.assign({}, sends)
    s[address] = { state: "connecting", device: "", file: "", index: 0, count: files.length, sent: 0, total: 0 }
    sends = s
    write({ cmd: "send", address: address, files: files })
  }
  function cancel(address) { write({ cmd: "cancel", address: address }) }
  function answer(id, ok) {
    write({ cmd: "answer", id: id, ok: ok })
    asks = asks.filter(a => a.id !== id)
  }
  // What ended, once seen: gone from the panel.
  function clearEnded() {
    const s = {}
    for (const a in sends)
      if (sends[a].state === "connecting" || sends[a].state === "sending") s[a] = sends[a]
    sends = s
    receives = receives.filter(r => r.state === "receiving")
  }

  function write(o) {
    if (!ready) return
    sock.write(JSON.stringify(o) + "\n")
    sock.flush()
  }

  function size(n) {
    if (n >= 1e9) return (n / 1e9).toFixed(1) + " GB"
    if (n >= 1e6) return (n / 1e6).toFixed(1) + " MB"
    if (n >= 1e3) return Math.round(n / 1e3) + " KB"
    return n + " B"
  }

  Socket {
    id: sock
    path: root.socketPath
    connected: true
    parser: SplitParser {
      onRead: line => {
        let ev
        try { ev = JSON.parse(line) } catch (e) { return }
        root.event(ev)
      }
    }
    onConnectionStateChanged: {
      root.ready = connected
      if (!connected) root.asks = []
    }
    onError: root.ready = false
  }
  // The service starts with the session, maybe after the shell; and again
  // when it restarts.
  Timer {
    interval: 2000
    repeat: true
    running: !root.ready
    onTriggered: { sock.connected = false; sock.connected = true }
  }

  function event(ev) {
    switch (ev.ev) {
    case "ask":
      if (asks.some(a => a.id === ev.id)) return
      asks = asks.concat([ev])
      attention()
      return
    case "asked":
      asks = asks.filter(a => a.id !== ev.id)
      return
    case "send": {
      const s = Object.assign({}, sends)
      s[ev.address] = ev
      sends = s
      if (!panelOpen && ev.state === "done")
        notify("document-send", {{ tq "n.sent" }}.arg(ev.device), ev.count === 1 ? ev.file : {{ tq "files" }}.arg(ev.count), "")
      else if (!panelOpen && ev.state === "error" && ev.error !== "cancelled")
        notify("dialog-warning", why(ev), ev.count === 1 ? ev.file : {{ tq "files" }}.arg(ev.count), "")
      return
    }
    case "receive": {
      const r = { id: ev.id, path: ev.path, file: ev.file, device: ev.device, state: ev.state, sent: ev.sent, total: ev.total }
      const i = receives.findIndex(x => x.id === ev.id)
      receives = i < 0 ? [r].concat(receives) : receives.map((x, j) => j === i ? r : x)
      // Accepted without asking (from a paired device): seen as it goes.
      if (i < 0 && ev.state === "receiving") attention()
      if (!panelOpen && ev.state === "done") notify("document-save", {{ tq "n.received" }}.arg(ev.device), ev.file, ev.path)
      else if (!panelOpen && ev.state === "error") notify("dialog-warning", {{ tq "n.receive_failed" }}.arg(ev.device), ev.file, "")
      return
    }
    }
  }

  function why(ev) {
    if (ev.error === "declined") return {{ tq "e.declined" }}.arg(ev.device)
    if (ev.error === "unreachable") return {{ tq "e.unreachable" }}.arg(ev.device)
    if (ev.error === "missing") return {{ tq "e.missing" }}
    return {{ tq "e.failed" }}.arg(ev.device)
  }

  // What happened, said once; a file that arrived opens from it.
  function notify(icon, title, body, file) {
    if (file === "") {
      Quickshell.execDetached(["notify-send", "-a", {{ tq "title" }}, "-i", icon, "--", title, body])
      return
    }
    Quickshell.execDetached(["sh", "-c", 'a=$(notify-send -a "$1" -i "$2" -w -A default="$5" -- "$3" "$4"); [ "$a" = default ] && exec xdg-open "$6"',
      "share", {{ tq "title" }}, icon, title, body, {{ tq "open" }}, file])
  }
}
