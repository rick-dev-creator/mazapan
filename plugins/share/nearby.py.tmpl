#!/usr/bin/env python3
# Generated by mazapan (plugin {{ plugin }}): Bluetooth for Share, as a
# service of the person's session (mazapan-nearby.service, started by its
# socket when the shell connects).
#
# - Pairing: BlueZ's agent. A phone shows a code; the shell asks to confirm
#   the same code here (the Share panel, or a notification).
# - Receiving: obexd's agent. A phone sends a file; the shell asks (or
#   accepts, as the settings say) and it goes to Downloads.
# - Sending: files to a phone (OBEX Object Push), one after the other, with
#   their progress.
#
# The shell talks to it through $XDG_RUNTIME_DIR/mazapan-nearby.sock, a JSON
# object a line each way. To the shell (to all connected):
#   {"ev":"ask","id":N,"kind":"confirm"|"authorize"|"offer",...}  answer it
#   {"ev":"asked","id":N}                 an ask that's over (answered or gone)
#   {"ev":"send",...}  {"ev":"receive",...}  a transfer's progress and end
# From the shell:
#   {"cmd":"answer","id":N,"ok":true}
#   {"cmd":"send","address":"AA:BB:…","files":["/path",…]}
#   {"cmd":"cancel","address":"AA:BB:…"}
# With nobody connected to ask, what would be asked is declined.

import json
import os
import shutil
import socket
import sys

import dbus
import dbus.mainloop.glib
import dbus.service
from gi.repository import GLib

BLUEZ = "org.bluez"
OBEX = "org.bluez.obex"
PROPS = "org.freedesktop.DBus.Properties"
SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "mazapan-nearby.sock")
SETTINGS = os.path.expanduser("~/.config/quickshell/mazapan/components/share/settings.json")
# obexd writes only under its own folder: what arrives lands there, then
# goes to Downloads once it's whole.
STAGE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "obexd")
# How long an ask waits: BlueZ and obexd give up on their own around 25 s.
ASK_SECONDS = 24


def log(*a):
    print(*a, file=sys.stderr, flush=True)


def settings():
    s = {"receive": "ask"}
    try:
        with open(SETTINGS) as f:
            s.update(json.load(f))
    except (OSError, ValueError):
        pass
    return s


def downloads():
    # xdg-user-dirs' Downloads, else ~/Downloads.
    d = ""
    try:
        with open(os.path.expanduser("~/.config/user-dirs.dirs")) as f:
            for line in f:
                if line.startswith("XDG_DOWNLOAD_DIR="):
                    d = os.path.expandvars(line.split("=", 1)[1].strip().strip('"'))
    except OSError:
        pass
    d = d or os.path.expanduser("~/Downloads")
    os.makedirs(d, exist_ok=True)
    return d


def free_name(folder, name):
    # The name a phone gave, made safe; "photo (2).jpg" when it's taken.
    name = os.path.basename(name.replace("\\", "/")).strip() or "file"
    if name in (".", ".."):
        name = "file"
    base, ext = os.path.splitext(name)
    path, n = os.path.join(folder, name), 2
    while os.path.exists(path):
        path = os.path.join(folder, f"{base} ({n}){ext}")
        n += 1
    return path


class Shell:
    """The shell's connections, and what's asked of them."""

    def __init__(self):
        self.clients = []
        self.asks = {}  # id → (answer(ok), timeout source)
        self.next = 1
        if os.environ.get("LISTEN_FDS") == "1" and os.environ.get("LISTEN_PID") == str(os.getpid()):
            # Started by its socket (mazapan-nearby.socket): systemd's, fd 3.
            self.server = socket.socket(fileno=3)
            self.owned = False
        else:
            try:
                os.unlink(SOCK)
            except FileNotFoundError:
                pass
            self.server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.server.bind(SOCK)
            os.chmod(SOCK, 0o600)
            self.server.listen(4)
            self.owned = True
        GLib.io_add_watch(self.server.fileno(), GLib.IO_IN, self._accept)

    def _accept(self, *_):
        conn, _ = self.server.accept()
        conn.setblocking(False)
        client = {"sock": conn, "buf": b""}
        self.clients.append(client)
        GLib.io_add_watch(conn.fileno(), GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._read, client)
        # What's waiting for an answer, to one that came after (a reload).
        for i, (_, _, ev) in self.asks.items():
            self._write(client, ev)
        for ev in nearby.ongoing():
            self._write(client, ev)
        return True

    def _read(self, fd, cond, client):
        try:
            data = client["sock"].recv(65536)
        except BlockingIOError:
            return True
        except OSError:
            data = b""
        if not data:
            self._drop(client)
            return False
        client["buf"] += data
        while b"\n" in client["buf"]:
            line, client["buf"] = client["buf"].split(b"\n", 1)
            try:
                self.command(json.loads(line))
            except Exception as e:  # one bad line doesn't end the service
                log("command:", e)
        return True

    def _drop(self, client):
        if client in self.clients:
            self.clients.remove(client)
        try:
            client["sock"].close()
        except OSError:
            pass

    def _write(self, client, ev):
        try:
            client["sock"].sendall((json.dumps(ev) + "\n").encode())
        except OSError:
            self._drop(client)

    def emit(self, ev):
        for c in list(self.clients):
            self._write(c, ev)

    def ask(self, ev, answer):
        """Asks the shell; answer(True|False) once, whatever happens."""
        if not self.clients:
            answer(False)
            return
        i = self.next
        self.next += 1
        ev = dict(ev, ev="ask", id=i)
        timer = GLib.timeout_add_seconds(ASK_SECONDS, self._expire, i)
        self.asks[i] = (answer, timer, ev)
        self.emit(ev)

    def _expire(self, i):
        a = self.asks.pop(i, None)
        if a:
            self.emit({"ev": "asked", "id": i})
            a[0](False)
        return False

    def cancel_all(self):
        for i in list(self.asks):
            self.answer(i, False)

    def answer(self, i, ok):
        a = self.asks.get(i)
        if not a:
            return
        try:
            GLib.source_remove(a[1])
        except Exception:
            pass
        self.asks.pop(i)
        self.emit({"ev": "asked", "id": i})
        a[0](bool(ok))

    def command(self, c):
        cmd = c.get("cmd")
        if cmd == "answer":
            self.answer(int(c.get("id", 0)), bool(c.get("ok")))
        elif cmd == "send":
            files = [f for f in c.get("files", []) if isinstance(f, str) and os.path.isfile(f)]
            address = str(c.get("address", ""))
            if files:
                nearby.send(address, files)
            else:
                # Gone since it was chosen: said, not waited for.
                self.emit({"ev": "send", "state": "error", "error": "missing", "address": address,
                           "device": address, "file": "", "index": 0, "count": 0, "sent": 0, "total": 0})
        elif cmd == "cancel":
            nearby.cancel(str(c.get("address", "")))


def device_name(path):
    try:
        p = dbus.Interface(system.get_object(BLUEZ, path), PROPS)
        return str(p.Get("org.bluez.Device1", "Alias"))
    except dbus.DBusException:
        return path.rsplit("dev_", 1)[-1].replace("_", ":")


def device_of(address):
    for path, ifaces in dbus.Interface(system.get_object(BLUEZ, "/"), "org.freedesktop.DBus.ObjectManager").GetManagedObjects().items():
        d = ifaces.get("org.bluez.Device1")
        if d and str(d.get("Address", "")).upper() == address.upper():
            return path, d
    return None, None


class PairingAgent(dbus.service.Object):
    """BlueZ's agent: pairing's codes, confirmed in the shell."""

    I = "org.bluez.Agent1"

    def _ask(self, kind, device, ok, err, passkey=None):
        ev = {"kind": kind, "device": device_name(device), "address": str(device).rsplit("dev_", 1)[-1].replace("_", ":")}
        if passkey is not None:
            ev["passkey"] = "%06d" % int(passkey)

        def answer(yes):
            if yes:
                if kind == "confirm":
                    # Trusted, so it reconnects (and sends) without asking again.
                    try:
                        dbus.Interface(system.get_object(BLUEZ, device), PROPS).Set("org.bluez.Device1", "Trusted", True)
                    except dbus.DBusException:
                        pass
                ok()
            else:
                err(dbus.DBusException("Rejected", name="org.bluez.Error.Rejected"))

        shell.ask(ev, answer)

    @dbus.service.method(I, in_signature="ou", out_signature="", async_callbacks=("ok", "err"))
    def RequestConfirmation(self, device, passkey, ok, err):
        self._ask("confirm", device, ok, err, passkey)

    @dbus.service.method(I, in_signature="o", out_signature="", async_callbacks=("ok", "err"))
    def RequestAuthorization(self, device, ok, err):
        self._ask("confirm", device, ok, err)

    @dbus.service.method(I, in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        # Only what's paired gets here asking for a service: let it.
        return

    @dbus.service.method(I, in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        # Old devices with a fixed PIN (no screen): the usual one.
        return "0000"

    @dbus.service.method(I, in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        raise dbus.DBusException("Rejected", name="org.bluez.Error.Rejected")

    @dbus.service.method(I, in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        return

    @dbus.service.method(I, in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        return

    @dbus.service.method(I, in_signature="", out_signature="")
    def Cancel(self):
        shell.cancel_all()

    @dbus.service.method(I, in_signature="", out_signature="")
    def Release(self):
        return


class PushAgent(dbus.service.Object):
    """obexd's agent: a file a phone sends, accepted to Downloads."""

    I = "org.bluez.obex.Agent1"

    @dbus.service.method(I, in_signature="o", out_signature="s", async_callbacks=("ok", "err"))
    def AuthorizePush(self, transfer, ok, err):
        t = dbus.Interface(session.get_object(OBEX, transfer), PROPS).GetAll("org.bluez.obex.Transfer1")
        name = str(t.get("Name", "")) or "file"
        size = int(t.get("Size", 0))
        address = ""
        try:
            s = dbus.Interface(session.get_object(OBEX, str(t["Session"])), PROPS)
            address = str(s.Get("org.bluez.obex.Session1", "Destination"))
        except (dbus.DBusException, KeyError):
            pass
        path, dev = device_of(address) if address else (None, None)
        who = str(dev.get("Alias", address)) if dev else address
        mode = settings().get("receive", "ask")
        log(f"push from {address or '?'}: {name} ({size} bytes), {mode}")

        def answer(yes):
            if not yes:
                log("declined")
                err(dbus.DBusException("Rejected", name="org.bluez.obex.Error.Rejected"))
                return
            os.makedirs(STAGE, exist_ok=True)
            stage = free_name(STAGE, "mazapan-" + os.path.basename(name.replace("\\", "/")))
            log("accepted, arriving in", stage)
            nearby.incoming(str(transfer), who, address, stage, os.path.basename(name), size)
            ok(stage)

        if mode == "off":
            answer(False)
        elif mode == "paired" and dev and dev.get("Paired"):
            answer(True)
        else:
            shell.ask({"kind": "offer", "device": who, "address": address, "name": os.path.basename(name), "size": size}, answer)

    @dbus.service.method(I, in_signature="", out_signature="")
    def Cancel(self):
        shell.cancel_all()

    @dbus.service.method(I, in_signature="", out_signature="")
    def Release(self):
        return


class Nearby:
    """Transfers: what's being sent to each device, and what arrives."""

    def __init__(self):
        self.out = {}  # address → {name, files, index, session, transfer, sent, size, total}
        self.inc = {}  # transfer path → {device, address, path, size, sent}
        session.add_signal_receiver(self._changed, signal_name="PropertiesChanged", dbus_interface=PROPS,
                                    bus_name=OBEX, path_keyword="path")

    def ongoing(self):
        evs = [self._send_ev(a, "sending") for a in self.out]
        evs += [self._recv_ev(t, "receiving") for t in self.inc]
        return evs

    # --- sending ---

    def _send_ev(self, address, state, error=""):
        o = self.out.get(address, {})
        ev = {"ev": "send", "state": state, "address": address, "device": o.get("name", address),
              "file": os.path.basename(o["files"][o["index"]]) if o and o["index"] < len(o["files"]) else "",
              "index": o.get("index", 0), "count": len(o.get("files", [])),
              "sent": o.get("done", 0) + o.get("sent", 0), "total": o.get("total", 0)}
        if error:
            ev["error"] = error
        return ev

    def send(self, address, files):
        log(f"send to {address}: {len(files)} file(s)")
        if address in self.out:
            # One transfer to a device at a time: more files join it.
            self.out[address]["files"] += files
            self.out[address]["total"] += sum(os.path.getsize(f) for f in files)
            return
        _, dev = device_of(address)
        name = str(dev.get("Alias", address)) if dev else address
        self.out[address] = {"name": name, "files": files, "index": 0, "session": None, "transfer": None,
                             "sent": 0, "done": 0, "total": sum(os.path.getsize(f) for f in files)}
        shell.emit(self._send_ev(address, "connecting"))
        client = dbus.Interface(session.get_object(OBEX, "/org/bluez/obex"), "org.bluez.obex.Client1")
        client.CreateSession(address, {"Target": "opp"}, timeout=60,
                             reply_handler=lambda s: self._session(address, s),
                             error_handler=lambda e: self._send_end(address, self._why(e)))

    def _why(self, e):
        name = e.get_dbus_name() if isinstance(e, dbus.DBusException) else ""
        msg = e.get_dbus_message() if isinstance(e, dbus.DBusException) else str(e)
        if "Forbidden" in msg or "Rejected" in msg or "Refused" in msg:
            return "declined"
        if "Timed out" in msg or "NoReply" in name or "not available" in msg.lower() or "Host is down" in msg or "connect" in msg.lower():
            return "unreachable"
        return msg or "failed"

    def _session(self, address, path):
        o = self.out.get(address)
        if not o:
            return
        o["session"] = str(path)
        self._next(address)

    def _next(self, address):
        o = self.out.get(address)
        if not o:
            return
        if o["index"] >= len(o["files"]):
            self._send_end(address, "")
            return
        push = dbus.Interface(session.get_object(OBEX, o["session"]), "org.bluez.obex.ObjectPush1")
        o["sent"] = 0

        def started(t, props):
            o["transfer"] = str(t)
            shell.emit(self._send_ev(address, "sending"))

        push.SendFile(o["files"][o["index"]], reply_handler=started,
                      error_handler=lambda e: self._send_end(address, self._why(e)))

    def _send_end(self, address, error):
        o = self.out.pop(address, None)
        if not o:
            return
        log(f"send to {address}: " + (error or "done"))
        self.out[address] = o  # for the event's details
        ev = self._send_ev(address, "error" if error else "done", error)
        del self.out[address]
        if o.get("session"):
            try:
                dbus.Interface(session.get_object(OBEX, "/org/bluez/obex"), "org.bluez.obex.Client1").RemoveSession(o["session"])
            except dbus.DBusException:
                pass
        shell.emit(ev)

    def cancel(self, address):
        o = self.out.get(address)
        if not o:
            return
        if o.get("transfer"):
            try:
                dbus.Interface(session.get_object(OBEX, o["transfer"]), "org.bluez.obex.Transfer1").Cancel()
            except dbus.DBusException:
                pass
        self._send_end(address, "cancelled")

    # --- receiving ---

    def _recv_ev(self, t, state):
        i = self.inc[t]
        return {"ev": "receive", "id": t, "state": state, "device": i["device"], "address": i["address"],
                "path": i.get("final", ""), "file": os.path.basename(i.get("final") or i["name"]),
                "sent": i["sent"], "total": i["size"]}

    def incoming(self, transfer, who, address, stage, name, size):
        self.inc[transfer] = {"device": who, "address": address, "stage": stage, "name": name, "size": size, "sent": 0}
        shell.emit(self._recv_ev(transfer, "receiving"))

    # --- both: obexd's transfers as they go ---

    def _changed(self, iface, changed, invalidated, path=None):
        if iface != "org.bluez.obex.Transfer1":
            return
        status = str(changed.get("Status", ""))
        if path in self.inc:
            i = self.inc[path]
            if "Transferred" in changed:
                i["sent"] = int(changed["Transferred"])
                shell.emit(self._recv_ev(path, "receiving"))
            if status in ("complete", "error"):
                if status == "complete":
                    i["sent"] = i["size"] or i["sent"]
                    try:
                        i["final"] = free_name(downloads(), i["name"])
                        shutil.move(i["stage"], i["final"])
                        # obexd's 600: the usual for a download (the umask's).
                        mask = os.umask(0)
                        os.umask(mask)
                        os.chmod(i["final"], 0o666 & ~mask)
                        log("received:", i["final"])
                    except OSError as e:
                        log("received, but not moved:", e)
                        status = "error"
                if status == "error":
                    log("receive failed:", i["name"])
                    try:
                        os.unlink(i["stage"])  # what's left of it
                    except OSError:
                        pass
                ev = self._recv_ev(path, "done" if status == "complete" else "error")
                del self.inc[path]
                shell.emit(ev)
            return
        for address, o in list(self.out.items()):
            if o.get("transfer") != path:
                continue
            if "Transferred" in changed:
                o["sent"] = int(changed["Transferred"])
                shell.emit(self._send_ev(address, "sending"))
            if status == "complete":
                o["done"] += os.path.getsize(o["files"][o["index"]])
                o["sent"] = 0
                o["transfer"] = None
                o["index"] += 1
                self._next(address)
            elif status == "error":
                self._send_end(address, "declined" if o["sent"] == 0 else "failed")


def register_pairing():
    try:
        m = dbus.Interface(system.get_object(BLUEZ, "/org/bluez"), "org.bluez.AgentManager1")
        m.RegisterAgent(AGENT_PATH, "KeyboardDisplay")
        m.RequestDefaultAgent(AGENT_PATH)
        log("pairing agent registered")
    except dbus.DBusException as e:
        log("pairing agent:", e.get_dbus_message())
    return False


def register_push():
    # Asking obexd starts it (D-Bus activation): it receives from then on.
    try:
        m = dbus.Interface(session.get_object(OBEX, "/org/bluez/obex"), "org.bluez.obex.AgentManager1")
        m.RegisterAgent(PUSH_PATH)
        log("push agent registered")
    except dbus.DBusException as e:
        log("push agent:", e.get_dbus_message())
    return False


AGENT_PATH = "/org/mazapan/nearby/pairing"
PUSH_PATH = "/org/mazapan/nearby/push"

if __name__ == "__main__":
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    system = dbus.SystemBus()
    session = dbus.SessionBus()
    shell = Shell()
    nearby = Nearby()
    PairingAgent(system, AGENT_PATH)
    PushAgent(session, PUSH_PATH)
    register_pairing()
    register_push()
    # BlueZ or obexd started again: their agent again (a name that changes
    # owner; the first call, now, is the one there already).
    owners = {}

    def again(key, owner, fn):
        if owner and owners.get(key) not in (None, owner):
            GLib.timeout_add(500, fn)
        owners[key] = owner

    system.watch_name_owner(BLUEZ, lambda o: again("bluez", o, register_pairing))
    session.watch_name_owner(OBEX, lambda o: again("obex", o, register_push))
    loop = GLib.MainLoop()
    try:
        from gi.repository import GLibUnix
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, 15, loop.quit)
    except ImportError:  # an older GLib
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, 15, loop.quit)
    loop.run()
    if shell.owned:
        try:
            os.unlink(SOCK)
        except OSError:
            pass
