// Generated by mazapan (plugin {{ plugin }}).
//
// The Share panel: what's being shared (files; the clipboard made one), and
// the devices it can go to, as bubbles: phones and computers nearby over
// Bluetooth (paired, or found while it's open: a click pairs it, the code
// confirmed here, and sends), a device nearby through LocalSend (its window
// opens with them), your devices on your tailnet (Taildrop). A click sends;
// the bubble's ring shows how far it's gone, and it can close meanwhile.
// Below: this computer visible to phones (to pair from one), and what
// happens when one sends a file here. It opens by itself, without taking
// the keyboard, when a phone asks something (a file to accept, a code to
// confirm); what arrives shows here as it goes, then to open. Nothing of
// it goes to the notifications.
//   ~/.local/share/mazapan/bin/share [--to ADDRESS] FILE… | --clipboard | --choose
// (which writes {files, to} as JSON in $XDG_RUNTIME_DIR/mazapan-share and
// opens this with its path: qs ipc call mazapan open share PATH). With
// "to" (the Control Center's Bluetooth devices), sent to it at once.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import Quickshell.Bluetooth
import qs
import "../components/kit"
import "../components/share"

Item {
  id: root

  readonly property var nearby: NearbyService
  property bool open: false
  property var screenAtOpen: null
  property var files: []
  property string localsend: ""   // "native", "flatpak" or "" (not here)
  property var peers: []          // [{ip, name}] Taildrop can send to
  property string tailscaleProblem: ""
  property string sending: ""      // the tailnet device being sent to
  property string tailSent: ""     // and the one it went to
  // Opened by a phone's question: the keyboard stays where it was.
  property bool quiet: false
  // Only what's arriving and asked (opened by it, nothing to share).
  readonly property bool incoming: files.length === 0 && (nearby.asks.length > 0 || nearby.receives.length > 0)
  property string problem: ""

  readonly property var adapter: Bluetooth.defaultAdapter
  readonly property bool btOn: adapter !== null && adapter.enabled
  // Phones and computers: paired ones always, new ones as they're found.
  // (Headphones, keyboards and the like don't take files.)
  readonly property var devices: btOn
    ? adapter.devices.values
        .filter(d => d.paired ? !/audio|head|keyboard|mouse|input|gaming|printer|camera/.test(d.icon || "")
                              : /phone|computer|tablet|pda/.test(d.icon || "") && (d.name || "") !== "")
        .sort((a, b) => (b.paired - a.paired) || (b.connected - a.connected) || a.name.localeCompare(b.name))
    : []
  // Looking for devices: while open, if it wasn't already.
  property bool scanning: false

  function toggle() { open ? close() : show() }
  function show() {
    quiet = false
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    problem = ""
    sending = ""
    tailSent = ""
    pairingFailed = ""
    find.running = true
    targets.running = true
    open = true
    scan(true)
  }
  // A list the share script wrote (read, then gone).
  function showWith(path) {
    if (!/^\/.*\/mazapan-share\/list-\d+\.json$/.test(path)) return
    reader.command = ["sh", "-c", 'cat -- "$0" && rm -f -- "$0"', path]
    reader.running = true
  }
  Process {
    id: reader
    stdout: StdioCollector {
      onStreamFinished: {
        let to = ""
        try {
          const o = JSON.parse(text)
          root.files = (Array.isArray(o) ? o : o.files || []).filter(f => typeof f === "string" && f.startsWith("/"))
          to = Array.isArray(o) ? "" : String(o.to || "")
        } catch (e) { root.files = [] }
        root.show()
        if (to !== "" && root.files.length > 0) {
          const d = root.adapter ? root.adapter.devices.values.find(x => x.address.toUpperCase() === to.toUpperCase()) : null
          if (d) root.choose(d)
        }
      }
    }
  }
  function close() {
    open = false
    quiet = false
    scan(false)
    // Closed with a question open: a no. What ended is seen: gone.
    for (const a of nearby.asks) nearby.answer(a.id, false)
    nearby.clearEnded()
  }
  onOpenChanged: nearby.panelOpen = open
  // A phone asks, or sends: open, the keyboard left alone.
  Connections {
    target: root.nearby
    function onAttention() {
      if (root.open) return
      root.screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
      root.quiet = true
      root.open = true
    }
  }

  function scan(on) {
    if (!btOn) return
    if (on && !adapter.discovering) { adapter.discovering = true; scanning = true }
    else if (!on && scanning) { if (adapter.discovering) adapter.discovering = false; scanning = false }
  }
  // Bluetooth turned on with the panel open: look now.
  onBtOnChanged: if (btOn && open) scan(true)

  function base(p) { return p.split("/").pop() }

  // --- Bluetooth: pairing from here, then sending ----------------------------------------

  property var pairingDevice: null
  property string pairingFailed: ""     // the address that couldn't be paired
  // The questions: codes to confirm, files to accept.
  readonly property var pairAsks: nearby.asks.filter(a => a.kind === "confirm")
  readonly property var offers: nearby.asks.filter(a => a.kind === "offer")
  // Sends that failed, said why.
  readonly property var failures: Object.values(nearby.sends).filter(s => s.state === "error" && s.error !== "cancelled")
  function why(s) { return nearby.why(s) }

  function choose(d) {
    if (root.files.length === 0) return
    const s = nearby.sends[d.address]
    if (s && (s.state === "connecting" || s.state === "sending")) { nearby.cancel(d.address); return }
    pairingFailed = ""
    if (d.paired) {
      nearby.send(d.address, root.files)
    } else {
      // Paired first (the code confirmed below), then sent.
      pairingDevice = d
      d.pair()
    }
  }
  Connections {
    target: root.pairingDevice
    function onPairedChanged() {
      const d = root.pairingDevice
      if (!d || !d.paired) return
      root.pairingDevice = null
      d.trusted = true
      nearby.send(d.address, root.files)
    }
    function onPairingChanged() {
      const d = root.pairingDevice
      // Over: BlueZ answers before it says "paired", so it's given a moment.
      if (d && !d.pairing && !d.paired) pairCheck.restart()
    }
  }
  Timer {
    id: pairCheck
    interval: 2500
    onTriggered: {
      const d = root.pairingDevice
      // Still not paired: declined, or it went away.
      if (d && !d.paired && !d.pairing) {
        root.pairingFailed = d.address
        root.pairingDevice = null
      }
    }
  }

  function bubbleState(d) {
    const s = nearby.sends[d.address]
    if (s) {
      if (s.state === "connecting") return { text: {{ tq "waiting" }}, progress: -1 }
      if (s.state === "sending") return { text: s.total > 0 ? Math.floor(s.sent * 100 / s.total) + "%" : {{ tq "sending" }}, progress: s.total > 0 ? s.sent / s.total : 0 }
      if (s.state === "done") return { text: {{ tq "sent_short" }}, progress: 1, done: true }
      if (s.state === "error") return { text: s.error === "cancelled" ? {{ tq "cancelled" }} : s.error === "declined" ? {{ tq "declined" }} : {{ tq "not_sent" }}, progress: 0, failed: s.error !== "cancelled" }
    }
    if (d.pairing || root.pairingDevice === d) return { text: {{ tq "pairing" }}, progress: -1 }
    if (root.pairingFailed === d.address) return { text: {{ tq "not_paired" }}, progress: 0, failed: true }
    return { text: d.paired ? "Bluetooth" : {{ tq "tap_to_pair" }}, progress: 0 }
  }

  function deviceGlyph(icon) {
    if (/phone/.test(icon)) return "󰄜"
    if (/tablet|pda/.test(icon)) return "󰓶"
    if (/computer/.test(icon)) return "󰌢"
    return "󰂯"
  }

  // --- what this computer receives ------------------------------------------------------

  function setReceive(mode) {
    Quickshell.execDetached(["mazapan", "apply", "--set", "share.receive=\"" + mode + "\""])
  }

  // --- LocalSend and Taildrop -----------------------------------------------------------

  Process {
    id: find
    command: ["sh", "-c", "command -v localsend >/dev/null && echo native || { flatpak info org.localsend.localsend_app >/dev/null 2>&1 && echo flatpak; }; true"]
    stdout: StdioCollector { onStreamFinished: root.localsend = text.trim() }
  }
  // Taildrop's targets: your own devices (and those shared with you) online, "IP<space>name".
  Process {
    id: targets
    command: ["sh", "-c", "command -v tailscale >/dev/null || exit 3; tailscale file cp --targets 2>&1"]
    stdout: StdioCollector {
      onStreamFinished: {
        const out = []
        // IP <tab> name [<tab> offline; last seen…]: the online ones.
        for (const line of text.split("\n")) {
          const f = line.split("\t")
          if (f.length >= 2 && /^[0-9a-f.:]+$/i.test(f[0].trim()) && !/offline/.test(f[2] || ""))
            out.push({ ip: f[0].trim(), name: f[1].trim() })
        }
        root.peers = out
        // Its service off: said plainly; anything else, its own first line.
        root.tailscaleProblem = out.length === 0 && text.trim() !== "" && !/no targets/i.test(text)
          ? (/failed to connect to local tailscale|tailscaled.*not running/i.test(text) ? {{ tq "tailscale_down" }} : "Tailscale: " + text.trim().split("\n")[0]) : ""
      }
    }
    onExited: code => { if (code === 3) { root.peers = []; root.tailscaleProblem = "" } }
  }

  function viaLocalSend() {
    if (root.localsend === "flatpak")
      Quickshell.execDetached(["flatpak", "run", "--file-forwarding", "org.localsend.localsend_app", "@@"].concat(root.files).concat(["@@"]))
    else
      Quickshell.execDetached(["localsend"].concat(root.files))
    close()
  }
  function viaTailscale(peer) {
    root.sending = peer.name
    root.tailSent = ""
    root.problem = ""
    send.command = ["tailscale", "file", "cp", "--"].concat(root.files).concat([peer.ip + ":"])
    send.running = true
  }
  Process {
    id: send
    stderr: StdioCollector { id: sendErr }
    onExited: code => {
      if (code === 0) {
        root.tailSent = root.sending
      } else {
        // Without being its operator, Taildrop asks for root: said how.
        root.problem = /access denied|permission|operator/i.test(sendErr.text) ? {{ tq "tailscale_operator" }} : (sendErr.text.trim().split("\n")[0] || {{ tq "failed" }})
      }
      root.sending = ""
    }
  }

  // --- the card -------------------------------------------------------------------------

  component Bubble: Item {
    id: bubble
    property string glyph: ""
    property string title: ""
    property string detail: ""
    property real progress: 0        // -1: going, how far unknown
    property bool done: false
    property bool failed: false
    property bool busy: progress < 0 || (progress > 0 && progress < 1 && !done)
    signal clicked()

    implicitWidth: 96
    implicitHeight: 118
    opacity: root.files.length > 0 ? 1 : 0.45

    Rectangle {
      id: disc
      anchors.horizontalCenter: parent.horizontalCenter
      y: 4
      width: 60; height: 60; radius: 30
      color: area.containsMouse && root.files.length > 0 ? Theme.surface : Theme.bgAlt
      border.width: 1
      border.color: bubble.failed ? Theme.danger : Theme.border
      scale: area.pressed ? 0.94 : 1
      Behavior on scale { NumberAnimation { duration: 90 } }

      Glyph {
        anchors.centerIn: parent
        text: bubble.done ? "󰄬" : bubble.glyph
        font.pointSize: 20
        color: bubble.done ? Theme.success : bubble.failed ? Theme.danger : Theme.fg
      }
      Ring {
        anchors.fill: parent
        anchors.margins: -5
        visible: bubble.progress > 0 && !bubble.done
        progress: Math.max(0, bubble.progress)
        thickness: 3
        track: "transparent"
      }
      // Going, how far not known yet (pairing, the phone asked to accept).
      Ring {
        id: spinner
        anchors.fill: parent
        anchors.margins: -5
        visible: bubble.progress < 0
        progress: 0.25
        thickness: 3
        track: "transparent"
        RotationAnimation on rotation { running: spinner.visible; from: 0; to: 360; duration: 1100; loops: Animation.Infinite }
      }
    }
    Label {
      id: name
      anchors { top: disc.bottom; topMargin: 10; left: parent.left; right: parent.right }
      horizontalAlignment: Text.AlignHCenter
      text: bubble.title
      elide: Text.ElideRight
      maximumLineCount: 1
    }
    Caption {
      anchors { top: name.bottom; topMargin: 2; left: parent.left; right: parent.right }
      horizontalAlignment: Text.AlignHCenter
      text: bubble.detail
      elide: Text.ElideRight
      color: bubble.failed ? Theme.danger : bubble.done ? Theme.success : Theme.fgSubtle
    }
    MouseArea {
      id: area
      anchors.fill: parent
      hoverEnabled: true
      cursorShape: root.files.length > 0 ? Qt.PointingHandCursor : Qt.ArrowCursor
      onClicked: bubble.clicked()
    }
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: 500
    implicitHeight: card.implicitHeight
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-share"
    WlrLayershell.keyboardFocus: root.quiet ? WlrKeyboardFocus.OnDemand : WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      anchors.fill: parent
      implicitHeight: col.implicitHeight + 32
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: root.close()

      ColumnLayout {
        id: col
        anchors { left: parent.left; right: parent.right; top: parent.top; margins: 16 }
        spacing: 10

        Caption { text: {{ tq "title" }}.toUpperCase() }

        // A phone sends a file: accept it (to Downloads) or not.
        Repeater {
          model: root.offers
          Rectangle {
            required property var modelData
            Layout.fillWidth: true
            implicitHeight: offerCol.implicitHeight + 24
            radius: Theme.radius
            color: Theme.bgAlt
            border.width: 1
            border.color: Theme.accent
            ColumnLayout {
              id: offerCol
              anchors { left: parent.left; right: parent.right; top: parent.top; margins: 12 }
              spacing: 6
              Label { text: {{ tq "offer" }}.arg(modelData.device); font.bold: true; elide: Text.ElideRight; Layout.fillWidth: true }
              Caption {
                Layout.fillWidth: true
                text: modelData.name + (modelData.size > 0 ? " · " + root.nearby.size(modelData.size) : "")
                color: Theme.fgMuted
                elide: Text.ElideMiddle
              }
              RowLayout {
                spacing: 8
                Button { text: {{ tq "accept" }}; primary: true; onClicked: root.nearby.answer(modelData.id, true) }
                Button { text: {{ tq "decline" }}; onClicked: root.nearby.answer(modelData.id, false) }
              }
            }
          }
        }

        // A pairing's code, to confirm against the phone's.
        Repeater {
          model: root.pairAsks
          Rectangle {
            required property var modelData
            Layout.fillWidth: true
            implicitHeight: pairCol.implicitHeight + 24
            radius: Theme.radius
            color: Theme.bgAlt
            border.width: 1
            border.color: Theme.accent
            ColumnLayout {
              id: pairCol
              anchors { left: parent.left; right: parent.right; top: parent.top; margins: 12 }
              spacing: 6
              Label { text: {{ tq "pair_title" }}.arg(modelData.device); font.bold: true; elide: Text.ElideRight; Layout.fillWidth: true }
              Text {
                visible: !!modelData.passkey
                text: modelData.passkey ? modelData.passkey.slice(0, 3) + " " + modelData.passkey.slice(3) : ""
                color: Theme.accentText
                font.family: Theme.fontMono
                font.pointSize: 24
                font.letterSpacing: 4
              }
              Caption {
                Layout.fillWidth: true
                text: modelData.passkey ? {{ tq "pair_same" }} : {{ tq "pair_plain" }}
                color: Theme.fgMuted
                wrapMode: Text.Wrap
              }
              RowLayout {
                spacing: 8
                Button { text: {{ tq "pair" }}; primary: true; onClicked: root.nearby.answer(modelData.id, true) }
                Button { text: {{ tq "cancel" }}; onClicked: root.nearby.answer(modelData.id, false) }
              }
            }
          }
        }

        // What arrives: how far, then open it or its folder.
        Repeater {
          model: root.nearby.receives
          RowLayout {
            required property var modelData
            Layout.fillWidth: true
            spacing: 10
            Item {
              implicitWidth: 36; implicitHeight: 36
              Ring {
                anchors.fill: parent
                visible: modelData.state === "receiving"
                progress: modelData.total > 0 ? modelData.sent / modelData.total : 0
                thickness: 3
              }
              Glyph {
                anchors.centerIn: parent
                text: modelData.state === "done" ? "󰄬" : modelData.state === "error" ? "󰅖" : "󰇚"
                color: modelData.state === "done" ? Theme.success : modelData.state === "error" ? Theme.danger : Theme.fg
              }
            }
            ColumnLayout {
              Layout.fillWidth: true
              spacing: 0
              Label { text: modelData.file; elide: Text.ElideMiddle; Layout.fillWidth: true }
              Caption {
                Layout.fillWidth: true
                elide: Text.ElideRight
                color: modelData.state === "error" ? Theme.danger : Theme.fgSubtle
                text: modelData.state === "receiving"
                  ? {{ tq "receiving" }}.arg(modelData.device) + (modelData.total > 0 ? " · " + Math.floor(modelData.sent * 100 / modelData.total) + "%" : "")
                  : modelData.state === "done" ? {{ tq "received" }}.arg(modelData.device) : {{ tq "receive_failed" }}.arg(modelData.device)
              }
            }
            Button {
              visible: modelData.state === "done"
              text: {{ tq "open" }}
              primary: true
              onClicked: { Quickshell.execDetached(["xdg-open", modelData.path]); root.close() }
            }
            Button {
              visible: modelData.state === "done"
              text: {{ tq "show" }}
              onClicked: { Quickshell.execDetached(["xdg-open", modelData.path.replace(/\/[^\/]*$/, "")]); root.close() }
            }
          }
        }
        Rule { visible: (root.nearby.asks.length > 0 || root.nearby.receives.length > 0) && !root.incoming; Layout.fillWidth: true }

        // What: the first few, and how many more.
        Label {
          visible: root.files.length > 0
          Layout.topMargin: 2
          text: root.files.slice(0, 3).map(root.base).join(", ") + (root.files.length > 3 ? " " + {{ tq "more" }}.arg(root.files.length - 3) : "")
          elide: Text.ElideMiddle
          Layout.fillWidth: true
        }
        Caption {
          visible: root.files.length === 0 && !root.incoming
          text: {{ tq "nothing" }}
          color: Theme.fgSubtle
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
        RowLayout {
          visible: root.files.length === 0 && !root.incoming
          spacing: 8
          Button {
            text: {{ tq "choose" }}
            primary: true
            onClicked: { root.close(); Quickshell.execDetached(["sh", Quickshell.env("HOME") + "/.local/share/mazapan/bin/share", "--choose"]) }
          }
          Button {
            text: {{ tq "clipboard" }}
            onClicked: { root.close(); Quickshell.execDetached(["sh", Quickshell.env("HOME") + "/.local/share/mazapan/bin/share", "--clipboard"]) }
          }
        }

        Rule { visible: !root.incoming; Layout.fillWidth: true }

        // The devices, as bubbles.
        Flow {
          visible: !root.incoming
          Layout.fillWidth: true
          spacing: 4

          Repeater {
            model: root.devices
            Bubble {
              required property var modelData
              readonly property var st: root.bubbleState(modelData)
              glyph: root.deviceGlyph(modelData.icon || "")
              title: modelData.name || modelData.address
              detail: st.text
              progress: st.progress
              done: st.done === true
              failed: st.failed === true
              onClicked: root.choose(modelData)
            }
          }
          Bubble {
            visible: root.localsend !== ""
            glyph: "󰒖"
            title: "LocalSend"
            detail: {{ tq "nearby_wifi" }}
            onClicked: if (root.files.length > 0) root.viaLocalSend()
          }
          Repeater {
            model: root.peers
            Bubble {
              required property var modelData
              glyph: String.fromCodePoint(0xF0322) // a device
              title: modelData.name
              detail: root.sending === modelData.name ? {{ tq "sending" }} : root.tailSent === modelData.name ? {{ tq "sent_short" }} : "Tailscale"
              progress: root.sending === modelData.name ? -1 : 0
              done: root.tailSent === modelData.name
              onClicked: if (root.files.length > 0 && root.sending === "") root.viaTailscale(modelData)
            }
          }
        }

        // Looking, with nothing found yet; or Bluetooth off.
        Caption {
          visible: root.btOn && root.devices.length === 0 && !root.incoming
          text: {{ tq "looking" }}
          color: Theme.fgSubtle
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
        RowLayout {
          visible: root.adapter !== null && !root.btOn
          Layout.fillWidth: true
          Caption {
            Layout.fillWidth: true
            text: {{ tq "bt_off" }}
            color: Theme.fgSubtle
            wrapMode: Text.Wrap
          }
          Button {
            text: {{ tq "bt_turn_on" }}
            onClicked: root.adapter.enabled = true
          }
        }
        Caption {
          visible: root.adapter === null && root.localsend === "" && root.peers.length === 0
          text: {{ tq "no_way" }}
          color: Theme.fgSubtle
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }

        // Sends that failed, and why.
        Repeater {
          model: root.failures
          Caption {
            required property var modelData
            Layout.fillWidth: true
            text: root.why(modelData)
            color: Theme.danger
            wrapMode: Text.Wrap
          }
        }

        Caption {
          visible: root.tailscaleProblem !== "" && root.files.length > 0
          text: root.tailscaleProblem
          color: Theme.fgSubtle
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
        Caption {
          visible: root.problem !== ""
          text: root.problem
          color: Theme.danger
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }

        // This computer: visible to phones nearby (to pair from one), and
        // what happens when one sends a file here.
        Rule { visible: root.btOn; Layout.fillWidth: true }
        RowLayout {
          visible: root.btOn
          Layout.fillWidth: true
          spacing: 8
          Glyph { text: "󰂯" }
          ColumnLayout {
            Layout.fillWidth: true
            spacing: 0
            Label { text: {{ tq "visible" }}.arg(root.adapter ? root.adapter.name : "") ; elide: Text.ElideRight; Layout.fillWidth: true }
            Caption { text: {{ tq "visible_detail" }}; color: Theme.fgSubtle; wrapMode: Text.Wrap; Layout.fillWidth: true }
          }
          Toggle {
            checked: root.nearby.visible
            onToggled: on => root.nearby.setVisible(on)
          }
        }
        RowLayout {
          visible: root.btOn
          Layout.fillWidth: true
          spacing: 6
          Caption { text: {{ tq "receive" }}; color: Theme.fgMuted; Layout.fillWidth: true }
          Repeater {
            model: [["ask", {{ tq "receive.ask" }}], ["paired", {{ tq "receive.paired" }}], ["off", {{ tq "receive.off" }}]]
            Button {
              required property var modelData
              text: modelData[1]
              primary: (root.nearby.settings.receive || "ask") === modelData[0]
              onClicked: root.setReceive(modelData[0])
            }
          }
        }
      }
    }
  }
}
