// Generated by mazapan (plugin {{ plugin }}).
//
// The Share panel: what's being shared (files; the clipboard made one),
// and where it can go: a device nearby through LocalSend (its window opens
// with them, to pick the device) or one of your devices on your tailnet
// (Taildrop, sent at once). Only the ways this computer has are offered.
//   ~/.local/share/mazapan/bin/share FILE… | --clipboard
// (which writes the list as JSON in $XDG_RUNTIME_DIR/mazapan-share and
// opens this with its path: qs ipc call mazapan open share PATH).

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  property var files: []
  property string localsend: ""   // "native", "flatpak" or "" (not here)
  property var peers: []          // [{ip, name}] Taildrop can send to
  property string tailscaleProblem: ""
  property string sending: ""      // the device being sent to
  property string problem: ""

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    problem = ""
    sending = ""
    find.running = true
    targets.running = true
    open = true
  }
  // A list the share script wrote (read, then gone).
  function showWith(path) {
    if (!/^\/.*\/mazapan-share\/list-\d+\.json$/.test(path)) return
    reader.command = ["sh", "-c", 'cat -- "$0" && rm -f -- "$0"', path]
    reader.running = true
  }
  Process {
    id: reader
    stdout: StdioCollector {
      onStreamFinished: {
        try { root.files = JSON.parse(text).filter(f => typeof f === "string" && f.startsWith("/")) } catch (e) { root.files = [] }
        root.show()
      }
    }
  }
  function close() { open = false }

  function base(p) { return p.split("/").pop() }

  // --- where it can go ----------------------------------------------------------------

  Process {
    id: find
    command: ["sh", "-c", "command -v localsend >/dev/null && echo native || { flatpak info org.localsend.localsend_app >/dev/null 2>&1 && echo flatpak; }; true"]
    stdout: StdioCollector { onStreamFinished: root.localsend = text.trim() }
  }
  // Taildrop's targets: your own devices (and those shared with you) online, "IP<space>name".
  Process {
    id: targets
    command: ["sh", "-c", "command -v tailscale >/dev/null || exit 3; tailscale file cp --targets 2>&1"]
    stdout: StdioCollector {
      onStreamFinished: {
        const out = []
        // IP <tab> name [<tab> offline; last seen…]: the online ones.
        for (const line of text.split("\n")) {
          const f = line.split("\t")
          if (f.length >= 2 && /^[0-9a-f.:]+$/i.test(f[0].trim()) && !/offline/.test(f[2] || ""))
            out.push({ ip: f[0].trim(), name: f[1].trim() })
        }
        root.peers = out
        root.tailscaleProblem = out.length === 0 && text.trim() !== "" && !/no targets/i.test(text) ? "Tailscale: " + text.trim().split("\n")[0] : ""
      }
    }
    onExited: code => { if (code === 3) { root.peers = []; root.tailscaleProblem = "" } }
  }

  // --- sending -----------------------------------------------------------------------

  function viaLocalSend() {
    if (root.localsend === "flatpak")
      Quickshell.execDetached(["flatpak", "run", "--file-forwarding", "org.localsend.localsend_app", "@@"].concat(root.files).concat(["@@"]))
    else
      Quickshell.execDetached(["localsend"].concat(root.files))
    close()
  }
  function viaTailscale(peer) {
    root.sending = peer.name
    root.problem = ""
    send.command = ["tailscale", "file", "cp", "--"].concat(root.files).concat([peer.ip + ":"])
    send.running = true
  }
  Process {
    id: send
    stderr: StdioCollector { id: sendErr }
    onExited: code => {
      if (code === 0) {
        Quickshell.execDetached(["notify-send", "-a", {{ tq "title" }}, "-i", "document-send", {{ tq "sent" }}.arg(root.sending),
          root.files.length === 1 ? root.base(root.files[0]) : {{ tq "files" }}.arg(root.files.length)])
        root.close()
      } else {
        // Without being its operator, Taildrop asks for root: said how.
        root.problem = /access denied|permission|operator/i.test(sendErr.text) ? {{ tq "tailscale_operator" }} : (sendErr.text.trim().split("\n")[0] || {{ tq "failed" }})
      }
      root.sending = ""
    }
  }


  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: 440
    implicitHeight: card.implicitHeight
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-share"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      id: card
      anchors.fill: parent
      implicitHeight: col.implicitHeight + 32
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius
      focus: true
      Keys.onEscapePressed: root.close()

      ColumnLayout {
        id: col
        anchors { left: parent.left; right: parent.right; top: parent.top; margins: 16 }
        spacing: 8

        Caption { text: {{ tq "title" }}.toUpperCase() }

        // What: the first few, and how many more.
        Label {
          visible: root.files.length > 0
          text: root.files.slice(0, 3).map(root.base).join(", ") + (root.files.length > 3 ? " " + {{ tq "more" }}.arg(root.files.length - 3) : "")
          elide: Text.ElideMiddle
          Layout.fillWidth: true
        }
        Caption {
          visible: root.files.length === 0
          text: {{ tq "nothing" }}
          color: Theme.fgSubtle
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
        Button {
          visible: root.files.length === 0
          text: {{ tq "clipboard" }}
          onClicked: { root.close(); Quickshell.execDetached(["sh", Quickshell.env("HOME") + "/.local/share/mazapan/bin/share", "--clipboard"]) }
        }

        Rule { visible: root.files.length > 0; Layout.fillWidth: true }

        // Nearby: LocalSend.
        ListRow {
          visible: root.files.length > 0 && root.localsend !== ""
          Layout.fillWidth: true
          glyph: "󰒖"
          active: false
          title: {{ tq "nearby" }}
          detail: {{ tq "nearby_detail" }}
          onClicked: root.viaLocalSend()
        }
        // Your tailnet: Taildrop.
        Repeater {
          model: root.files.length > 0 ? root.peers : []
          ListRow {
            required property var modelData
            Layout.fillWidth: true
            glyph: String.fromCodePoint(0xF0322) // a device
            active: root.sending === modelData.name
            title: modelData.name
            detail: root.sending === modelData.name ? {{ tq "sending" }} : {{ tq "tailnet_detail" }}
            onClicked: if (root.sending === "") root.viaTailscale(modelData)
          }
        }
        Caption {
          visible: root.files.length > 0 && root.localsend === "" && root.peers.length === 0
          text: {{ tq "no_way" }}
          color: Theme.fgSubtle
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
        Caption {
          visible: root.tailscaleProblem !== "" && root.files.length > 0
          text: root.tailscaleProblem
          color: Theme.fgSubtle
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
        Caption {
          visible: root.problem !== ""
          text: root.problem
          color: Theme.danger
          wrapMode: Text.Wrap
          Layout.fillWidth: true
        }
      }
    }
  }
}
