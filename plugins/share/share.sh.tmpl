# Generated by mazapan (plugin {{ plugin }}): share [--clipboard | FILE…]
# opens the Share panel with these files, or with what the clipboard holds
# (a picture, files copied in Files, or text: each made a file in the
# runtime directory, the person's alone). The list goes to the panel as a
# file there (qs ipc reads brackets in an argument its own way).
d="${XDG_RUNTIME_DIR:-/tmp}/mazapan-share"
mkdir -p "$d" && chmod 700 "$d" || exit 1
# What was shared before (captures, clipboard copies), gone after a day.
find "$d" -maxdepth 1 -type f -mmin +1440 -delete 2>/dev/null
if [ "$1" = "--clipboard" ]; then
  rm -f "$d"/clipboard.*
  types=$(wl-paste --list-types 2>/dev/null)
  set --
  case "$types" in
    *text/uri-list*)
      # Files copied in a file manager: file:// addresses, %-escaped.
      list=$(wl-paste --type text/uri-list 2>/dev/null)
      while IFS= read -r u; do
        u=$(printf '%s' "$u" | tr -d '\r')
        case "$u" in
          file://*) p=$(printf '%s' "${u#file://}" | sed 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g'); set -- "$@" "$(printf '%b' "$p")" ;;
        esac
      done <<LIST
$list
LIST
      ;;
    *image/png*) wl-paste --type image/png > "$d/clipboard.png" && set -- "$d/clipboard.png" ;;
    *text/plain*|*UTF8_STRING*|*STRING*) (umask 077; wl-paste --no-newline > "$d/clipboard.txt") && set -- "$d/clipboard.txt" ;;
  esac
fi
# Nothing (the clipboard empty, or none named): the panel says how.
# Whole paths, as JSON (any name: spaces, quotes, newlines).
n=$#
for f in "$@"; do set -- "$@" "$(realpath -- "$f")"; done
shift "$n"
list="$d/list-$$.json"
jq -cn '$ARGS.positional' --args "$@" > "$list" || exit 1
exec qs ipc -c mazapan call mazapan open share "$list" >/dev/null
