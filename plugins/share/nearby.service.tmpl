# Generated by mazapan (plugin {{ plugin }}): Bluetooth for Share: pairing's
# codes, files sent to a phone, files a phone sends here. Started by its
# socket (mazapan-nearby.socket) when the shell connects.
[Unit]
Description=Mazapan: Bluetooth for Share (pairing, sending, receiving)
Requires=mazapan-nearby.socket
# Never "failed" for starting often: the shell reconnects.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/mazapan/bin/nearby
Restart=on-failure
RestartSec=3
