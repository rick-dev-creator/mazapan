// Generated by mazapan (plugin {{ plugin }}): Share in the Control Center.
//
// A big switch: this computer visible to phones nearby (for three minutes,
// to pair from one; then hidden again by itself). Its arrow: send files
// (a file chooser, then the Share panel), or what you copied. Without a
// Bluetooth adapter, only the arrow's two.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/control"
import "../../components/share"

Tile {
  id: root

  readonly property var nearby: NearbyService
  readonly property bool listing: ControlService.detail === list
  readonly property string share: Quickshell.env("HOME") + "/.local/share/mazapan/bin/share"

  function run(arg) {
    ControlService.close()
    Quickshell.execDetached(["sh", share, arg])
  }

  glyph: "󰒖"
  title: {{ tq "title" }}
  detail: nearby.visible ? {{ tq "tile.visible" }} : {{ tq "tile.hidden" }}
  checked: nearby.visible
  more: true
  expanded: listing
  onToggled: nearby.setVisible(!nearby.visible)
  onOpened: ControlService.detail = listing ? null : list

  Component {
    id: list
    Group {
      title: {{ tq "title" }}
      ListRow {
        Layout.fillWidth: true
        glyph: "󰈔"
        title: {{ tq "choose" }}
        detail: {{ tq "tile.choose_detail" }}
        onClicked: root.run("--choose")
      }
      ListRow {
        Layout.fillWidth: true
        glyph: "󰅍"
        title: {{ tq "clipboard" }}
        onClicked: root.run("--clipboard")
      }
      Caption {
        Layout.fillWidth: true
        visible: root.nearby.visible
        text: {{ tq "visible_detail" }}
        wrapMode: Text.Wrap
        font.letterSpacing: 0
      }
    }
  }
}
