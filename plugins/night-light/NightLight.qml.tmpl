// Generated by mazapan (plugin {{ plugin }}).
//
// Night light: the screens warmer at night, fading in and out over a
// while rather than at once. By the hours you give, or from sunset to
// sunrise where you are (worked out here: nothing is looked up). Turned
// on or off by hand, it stays so until the schedule agrees again (on now
// in the afternoon: on through the night; off tonight: back tomorrow
// night). hyprsunset does the tinting; it lives with the shell, so if
// the shell goes the screens go back to normal.

import QtQuick
import Quickshell
import Quickshell.Io

Item {
  id: root

  // A panel by contract (see shell.qml): nothing to open.
  readonly property bool open: false
  function toggle() {}
  function close() {}

  readonly property int warm: {{ settings.temperature }}
  readonly property int neutral: 6500
  readonly property int fade: {{ settings.fade }}
  readonly property bool scheduled: {{ settings.schedule != "off" }}

  // Night from `from` to `to`, in minutes of the day.
  function hhmm(s, fallback) {
    const m = /^(\d{1,2}):(\d{2})$/.exec(String(s).trim())
    if (!m || Number(m[1]) > 23 || Number(m[2]) > 59) return fallback
    return Number(m[1]) * 60 + Number(m[2])
  }

  // Sunrise and sunset (NOAA's approximation), in local minutes of the
  // day; null in a polar night (all night) or midnight sun (no night).
  function sun(date, lat, lon) {
    const start = new Date(date.getFullYear(), 0, 1)
    const n = Math.floor((date - start) / 86400000) + 1
    const g = 2 * Math.PI / 365 * (n - 1)
    const eq = 229.18 * (0.000075 + 0.001868 * Math.cos(g) - 0.032077 * Math.sin(g)
      - 0.014615 * Math.cos(2 * g) - 0.040849 * Math.sin(2 * g))
    const decl = 0.006918 - 0.399912 * Math.cos(g) + 0.070257 * Math.sin(g) - 0.006758 * Math.cos(2 * g)
      + 0.000907 * Math.sin(2 * g) - 0.002697 * Math.cos(3 * g) + 0.00148 * Math.sin(3 * g)
    const phi = lat * Math.PI / 180
    const c = Math.cos(90.833 * Math.PI / 180) / (Math.cos(phi) * Math.cos(decl)) - Math.tan(phi) * Math.tan(decl)
    if (c > 1) return { polar: "night" }
    if (c < -1) return { polar: "day" }
    const ha = Math.acos(c) * 180 / Math.PI
    const utc = m => m - date.getTimezoneOffset()
    return { rise: utc(720 - 4 * (lon + ha) - eq), set: utc(720 - 4 * (lon - ha) - eq) }
  }

  // How far into the night it is now: 0 (day) to 1 (night), fading over
  // `fade` minutes after dusk and before dawn.
  function night(now) {
    const t = now.getHours() * 60 + now.getMinutes() + now.getSeconds() / 60
    let dusk, dawn
{{- if settings.schedule == "sun" }}
    const at = {{ quote settings.sun_at }}.split(",").map(Number)
    const s = at.length === 2 && at.every(x => isFinite(x)) && Math.abs(at[0]) <= 90 && Math.abs(at[1]) <= 180
      ? sun(now, at[0], at[1]) : null
    if (!s) {
      console.warn("night-light: sun_at should be latitude,longitude (a dot for decimals), e.g. 40.4,-3.7")
      return 0
    }
    if (s.polar) return s.polar === "night" ? 1 : 0
    dusk = s.set
    dawn = s.rise
{{- else }}
    dusk = hhmm({{ quote settings.from }}, -1)
    dawn = hhmm({{ quote settings.to }}, -1)
    if (dusk < 0 || dawn < 0 || dusk === dawn) {
      console.warn("night-light: from and to should be two different times, HH:MM; using 20:00 to 07:00")
      dusk = 20 * 60
      dawn = 7 * 60
    }
{{- end }}
    // Minutes since dusk, and until dawn, along a day that wraps.
    const since = ((t - dusk) % 1440 + 1440) % 1440
    const length = ((dawn - dusk) % 1440 + 1440) % 1440
    if (since >= length) return 0
    const left = length - since
    const f = Math.max(1, fade)
    return Math.min(1, since / f, left / f)
  }

  // By hand: "on" or "off" until the schedule agrees (kept across reloads).
  PersistentProperties {
    id: kept
    reloadableId: "mazapan-night-light"
    property string override: ""
    property bool sawNight: false
    // Held by a mode (the modes plugin): "on" or "off" while it lasts.
    property string held: ""
    onLoaded: root.update()
  }

  property int applied: -1 // what hyprsunset was last told (0: nothing)

  // How warm now, 0 to 1: the schedule's, or what was asked by hand. By
  // hand lasts until the schedule gets there: "off" until the night is
  // over (the fade out done), "on" until the night is at its warmest (or,
  // a night too short to get there, over).
  function level() {
    if (kept.held === "on") return 1
    if (kept.held === "off") return 0
    const f = scheduled ? night(new Date()) : 0
    if (kept.override === "off" && f === 0) kept.override = ""
    if (kept.override === "on") {
      if (f > 0) kept.sawNight = true
      if (f >= 1 || (kept.sawNight && f === 0)) kept.override = ""
    }
    if (kept.override === "") kept.sawNight = false
    return kept.override === "on" ? 1 : kept.override === "off" ? 0 : f
  }

  function update() {
    const l = level()
    const k = l <= 0 ? 0 : Math.round((neutral - (neutral - warm) * l) / 50) * 50
    // Gone (it failed, or was stopped): started again, then told.
    if (!sunset.running) {
      if (!sweep.running) sunset.running = true
      return
    }
    // Told every time (it may have missed one: still starting).
    applied = k
    Quickshell.execDetached(["hyprctl", "hyprsunset"].concat(k === 0 ? ["identity"] : ["temperature", String(k)]))
  }

  // hyprsunset, with the shell (and gone with it). One left by an older
  // shell (a reload), or started by something else, goes first: two would
  // fight over the screens.
  Process {
    id: sweep
    running: true
    command: ["sh", "-c", "systemctl --user stop hyprsunset.service 2>/dev/null; pkill -u \"$(id -u)\" -x hyprsunset; sleep 0.2"]
    onExited: sunset.running = true
  }
  Process {
    id: sunset
    command: ["setpriv", "--pdeathsig", "TERM", "hyprsunset", "--identity"]
    onRunningChanged: {
      root.applied = -1
      if (running) settle.restart()
    }
  }
  // Once it's listening.
  Timer {
    id: settle
    interval: 700
    onTriggered: root.update()
  }
  Timer {
    interval: 30000
    running: true
    repeat: true
    onTriggered: root.update()
  }

  IpcHandler {
    target: "nightlight"
    // On now if it's off, off if it's on (until the schedule agrees).
    // By hand wins over a mode's hold.
    function toggle(): void {
      const on = root.level() > 0
      kept.held = ""
      kept.override = on ? "off" : "on"
      root.update()
    }
    function on(): void {
      kept.held = ""
      kept.override = "on"
      root.update()
    }
    function off(): void {
      kept.held = ""
      kept.override = "off"
      root.update()
    }
    function isOn(): bool { return root.level() > 0 }
    // A mode's: "on" or "off" while it lasts, "" when it's over (the
    // schedule again).
    function hold(state: string): void {
      kept.held = state === "on" || state === "off" ? state : ""
      root.update()
    }
  }
}
