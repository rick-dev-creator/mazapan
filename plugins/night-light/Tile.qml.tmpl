// Generated by mazapan (plugin {{ plugin }}): night light in the Control Center.
//
// A big switch: on now, or off now, until the schedule agrees again (as
// its key does). Whether it's on is read from the file the night light
// keeps in the session's runtime folder.

import QtQuick
import Quickshell
import Quickshell.Io
import qs
import "../../components/kit"

Tile {
  id: root

  property bool on: false
  FileView {
    path: (Quickshell.env("XDG_RUNTIME_DIR") || "/tmp") + "/mazapan-night-light"
    watchChanges: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: root.on = text().trim() === "on"
  }

  glyph: "󰖔"
  title: {{ tq "tile" }}
  detail: root.on ? {{ tq "tile.on" }} : {{ tq "tile.off" }}
  checked: root.on
  onToggled: {
    root.on = !root.on
    Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "nightlight", "toggle"])
  }
}
