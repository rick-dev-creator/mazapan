#!/bin/sh
# Generated by mazapan (plugin {{ plugin }}): on a laptop with an NVIDIA
# card beside the integrated GPU, the game launchers start on the NVIDIA
# card (and their games with them): launchers of our own, made from the
# apps' (~/.local/share/applications), and Heroic's Flatpak told so. With
# one GPU, or turned off, ours are taken away. Run again as apps come.
{{- nvidia = false }}{{ for g in machine.gpus }}{{ if g.id | string.starts_with "10de:" }}{{ nvidia = true }}{{ end }}{{ end }}
hybrid={{ if nvidia && machine.gpus.size > 1 && settings.discrete_gpu }}1{{ else }}0{{ end }}
apps="$HOME/.local/share/applications"
mark="X-Mazapan-Gaming=discrete GPU"
for f in steam.desktop net.lutris.Lutris.desktop; do
  ours="$apps/$f"
  if [ "$hybrid" = 1 ] && [ -f "/usr/share/applications/$f" ] && command -v prime-run >/dev/null; then
    mkdir -p "$apps"
    # Every Exec= through prime-run; marked as ours.
    sed -e 's|^Exec=\(.*\)|Exec=prime-run \1|' -e "/^\[Desktop Entry\]/a $mark" "/usr/share/applications/$f" > "$ours.tmp" && mv "$ours.tmp" "$ours"
  elif [ -f "$ours" ] && grep -qx "$mark" "$ours"; then
    rm -f "$ours"
  fi
done
if command -v flatpak >/dev/null && flatpak info com.heroicgameslauncher.hgl >/dev/null 2>&1; then
  if [ "$hybrid" = 1 ]; then
    flatpak override --user --env=__NV_PRIME_RENDER_OFFLOAD=1 --env=__GLX_VENDOR_LIBRARY_NAME=nvidia --env=__VK_LAYER_NV_optimus=NVIDIA_only com.heroicgameslauncher.hgl
  else
    flatpak override --user --unset-env=__NV_PRIME_RENDER_OFFLOAD --unset-env=__GLX_VENDOR_LIBRARY_NAME --unset-env=__VK_LAYER_NV_optimus com.heroicgameslauncher.hgl 2>/dev/null
  fi
fi
command -v update-desktop-database >/dev/null && update-desktop-database "$apps" 2>/dev/null
true
