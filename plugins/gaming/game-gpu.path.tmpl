# Generated by mazapan (plugin {{ plugin }}): a game launcher installed or
# updated (Steam, Lutris, Heroic): its NVIDIA-card launcher made again.
[Unit]
Description=Mazapan: game launchers on the right GPU

[Path]
PathChanged=/usr/share/applications/steam.desktop
PathChanged=/usr/share/applications/net.lutris.Lutris.desktop
PathChanged=%h/.local/share/flatpak/exports/share/applications/com.heroicgameslauncher.hgl.desktop
PathChanged=/var/lib/flatpak/exports/share/applications/com.heroicgameslauncher.hgl.desktop

[Install]
WantedBy=default.target
