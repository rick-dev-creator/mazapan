-- Generated by mazapan (plugin {{ plugin }}): games. Steam's (steam_app_*),
-- gamescope, and anything that says it's a game: the screen never dims or
-- locks while one is in front{{ if settings.low_latency }}, and drawn the moment it's ready (tearing
-- allowed, for these only: less delay){{ end }}.
{{- if settings.low_latency }}
hl.config({ general = { allow_tearing = true } })
{{- end }}
for _, m in ipairs({
  { class = "^steam_app_.*$" },
  { class = "^gamescope$" },
  { content = "game" },
}) do
  hl.window_rule({
    match = m,
    idle_inhibit = "focus",
{{- if settings.low_latency }}
    immediate = true,
{{- end }}
  })
end
