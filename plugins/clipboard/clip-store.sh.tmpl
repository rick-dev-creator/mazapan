# Generated by mazapan (plugin {{ plugin }}): keeps one clipboard entry.
# wl-paste --watch runs it with what was copied on stdin, and "txt" or
# "png"; it prints the entry's file, for the shell to show.
#
# Kept in ~/.local/state/mazapan-clipboard (only its owner reads it), one
# file each: <time>-<hash>.<txt|png>, pin-… for pinned ones. The same
# thing copied again moves up instead of coming twice. What a password
# manager marks as secret (x-kde-passwordManagerHint) isn't kept at all.
set -u
ext="$1"
dir="$HOME/.local/state/mazapan-clipboard"
mkdir -p -m 700 "$dir" || exit 0
chmod 700 "$dir"
# wl-paste says what the clipboard holds: data, or "sensitive" (marked
# secret), "nil", "clear". Older ones don't: then its types tell.
case "${CLIPBOARD_STATE:-data}" in
  data) ;;
  *) exit 0 ;;
esac
types=$(wl-paste --list-types 2>/dev/null </dev/null)
printf '%s\n' "$types" | grep -qx 'x-kde-passwordManagerHint' && exit 0
# One copy, one entry: a picture copied in a browser comes with its HTML
# (the picture is kept), cells in a spreadsheet with a picture of them
# (the text is kept).
plain() { printf '%s\n' "$types" | grep -qiE '^(text/plain|UTF8_STRING|STRING|TEXT)'; }
if [ "$ext" = txt ]; then
  plain || { printf '%s\n' "$types" | grep -qx 'image/png' && exit 0; }
else
  plain && exit 0
fi
tmp=$(mktemp "$dir/.new.XXXXXX") || exit 0
cat > "$tmp"
size=$(wc -c < "$tmp")
# Nothing, or too big to be worth keeping.
if [ "$size" -eq 0 ] || [ "$size" -gt {{ settings.max_kb * 1024 }} ]; then
  rm -f "$tmp"
  exit 0
fi
hash=$(sha256sum "$tmp" | cut -c1-16)
old=$(ls -A "$dir" | grep -- "-$hash\.$ext\$" | head -n 1)
if [ -n "$old" ]; then
  rm -f "$tmp"
  touch "$dir/$old"
  file="$dir/$old"
else
  file="$dir/$(date +%s%3N)-$hash.$ext"
  mv "$tmp" "$file"
fi
# The newest ones kept; pinned ones always. Pictures, larger, fewer.
ls -t "$dir" | grep -v -e '^pin-' -e '^\.' | tail -n +{{ settings.keep + 1 }} | while IFS= read -r x; do rm -f "$dir/$x"; done
ls -t "$dir" | grep -v -e '^pin-' -e '^\.' | grep '\.png$' | tail -n +{{ settings.keep_images + 1 }} | while IFS= read -r x; do rm -f "$dir/$x"; done
printf '%s\n' "$file"
