// Generated by mazapan (plugin {{ plugin }}).
//
// The clipboard's history: wl-paste watches it (text, and pictures) and
// clip-store keeps each entry as a file; this reads them back, newest
// first, and puts one on the clipboard again (and pastes it, with wtype).
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
  id: root

  readonly property string dir: Quickshell.env("HOME") + "/.local/state/mazapan-clipboard"
  readonly property string store: Quickshell.env("HOME") + "/.local/share/mazapan/bin/clip-store"
  readonly property bool pastes: {{ settings.paste }}

  // [{path, name, image, pinned, time, text, lower}], pinned first, then
  // newest.
  property var entries: []

  // Read again on each copy only while the history is open (it says so);
  // else once, when it opens.
  property bool active: false
  property bool stale: true
  onActiveChanged: if (active && stale) refresh()
  function copied() {
    if (active) refresh()
    else stale = true
  }

  // Only clip-store's own names: <time>-<hash>.<txt|png>, pin-… when
  // pinned. Anything else (a name made up by what was copied) is never
  // read, pasted or removed.
  function valid(name) {
    return /^(pin-)?[0-9]+-[0-9a-f]{16}\.(txt|png)$/.test(String(name))
  }

  // --- watching the clipboard --------------------------------------------------------

  // Watchers left by an older shell (a reload): theirs, gone first. Each
  // dies with this shell (pdeathsig): never two at once.
  Process {
    id: sweep
    running: true
    command: ["pkill", "-f", "wl-paste --type (text|image/png) --watch sh " + root.store]
    onExited: {
      textWatch.running = true
{{- if settings.images }}
      imageWatch.running = true
{{- end }}
      root.refresh()
    }
  }

  Process {
    id: textWatch
    command: ["setpriv", "--pdeathsig", "TERM", "wl-paste", "--type", "text", "--watch", "sh", root.store, "txt"]
    stdout: SplitParser { onRead: root.copied() }
  }

{{- if settings.images }}
  Process {
    id: imageWatch
    command: ["setpriv", "--pdeathsig", "TERM", "wl-paste", "--type", "image/png", "--watch", "sh", root.store, "png"]
    stdout: SplitParser { onRead: root.copied() }
  }
{{- end }}

  // --- reading it back -----------------------------------------------------------------

  // All at once: each entry's name and time, then (for text) its first
  // 2000 bytes, without the bytes that separate them.
  function refresh() {
    stale = false
    if (reader.running) again = true
    else reader.running = true
  }
  property bool again: false

  Process {
    id: reader
    command: ["sh", "-c", 'cd "$0" 2>/dev/null || exit 0; '
      + 'find . -maxdepth 1 -type f ! -name ".*" -printf "%T@ %f\\n" | sort -rn | while read -r t f; do '
      + 'printf "\\036%s\\037%s\\037" "$f" "${t%.*}"; case "$f" in *.txt) head -c 2000 "$f" | tr -d "\\036\\037";; esac; done', root.dir]
    stdout: StdioCollector {
      onStreamFinished: {
        const list = []
        for (const chunk of this.text.split("\x1e")) {
          if (chunk === "") continue
          const [name, time, ...rest] = chunk.split("\x1f")
          if (!root.valid(name)) continue
          const text = rest.join("")
          list.push({
            path: root.dir + "/" + name,
            name: name,
            image: name.endsWith(".png"),
            pinned: name.startsWith("pin-"),
            time: Number(time) * 1000,
            text: text,
            lower: text.toLowerCase(),
          })
        }
        root.entries = list.filter(e => e.pinned).concat(list.filter(e => !e.pinned))
      }
    }
    onExited: if (root.again) {
      root.again = false
      running = true
    }
  }

  // --- using it ------------------------------------------------------------------------

  // On the clipboard again (it moves to the top by itself: it's copied),
  // and pasted where the focus is: Ctrl+V, or Ctrl+Shift+V in a terminal
  // (where Ctrl+V is a key of its own).
  function use(e) {
    if (!valid(e.name)) return
    const paste = !pastes ? "" : '; sleep 0.15; command -v wtype >/dev/null || exit 0; '
      + 'cls=$(hyprctl activewindow -j 2>/dev/null | sed -n \'s/.*"class": *"\\([^"]*\\)".*/\\1/p\' | head -n 1); '
      + 'case "$cls" in foot|footclient|kitty|Alacritty|alacritty|*[Ww]ez[Tt]erm*|*ghostty*|*konsole*|*[Tt]erminal*|*[Cc]onsole*|kgx|xterm*|*urxvt*|st|st-*|*tilix*|*terminator*|*rio*|*contour*|*blackbox*) '
      + 'wtype -M ctrl -M shift -k v -m shift -m ctrl;; *) wtype -M ctrl -k v -m ctrl;; esac'

    Quickshell.execDetached(["sh", "-c", (e.image ? 'wl-copy --type image/png < "$0"' : 'wl-copy --type "text/plain;charset=utf-8" < "$0"') + paste, e.path])
  }

  // Changes to the files, one after another, each read back once done.
  property var jobs: []
  function job(command) {
    jobs = jobs.concat([command])
    if (!worker.running) next()
  }
  function next() {
    if (jobs.length === 0) return
    worker.command = jobs[0]
    jobs = jobs.slice(1)
    worker.running = true
  }
  Process {
    id: worker
    onExited: {
      root.refresh()
      root.next()
    }
  }

  function remove(e) {
    if (!valid(e.name)) return
    entries = entries.filter(x => x.path !== e.path)
    job(["rm", "-f", "--", e.path])
  }

  function pin(e) {
    if (!valid(e.name)) return
    const to = root.dir + "/" + (e.pinned ? e.name.replace(/^pin-/, "") : "pin-" + e.name)
    job(["mv", "-f", "--", e.path, to])
  }

  // Everything but the pinned ones.
  function clear() {
    entries = entries.filter(e => e.pinned)
    job(["sh", "-c", 'cd "$0" && ls | grep -v "^pin-" | grep -v "^\\." | while IFS= read -r f; do rm -f -- "$f"; done', root.dir])
  }
}
