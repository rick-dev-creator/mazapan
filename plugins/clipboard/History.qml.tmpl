// Generated by myarch (plugin {{ plugin }}).
//
// The clipboard's history: what you copied, newest first (pinned ones on
// top), text and pictures; type to find, ↵ to paste it where you were.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/clipboard"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null
  property string query: ""
  property int current: 0

  readonly property var shown: {
    const words = query.toLowerCase().split(/\s+/).filter(w => w !== "")
    return ClipboardService.entries.filter(e => e.image ? words.length === 0 || words.every(w => {{ tq "picture" }}.toLowerCase().includes(w))
      : words.every(w => e.lower.includes(w)))
  }
  // Always on an entry (one removed, a search that narrows).
  onShownChanged: current = Math.max(0, Math.min(current, shown.length - 1))

  // The history reads itself again on each copy only while it's open.
  Binding {
    target: ClipboardService
    property: "active"
    value: root.open
  }

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    search.text = ""
    current = 0
    open = true
    Qt.callLater(() => search.focusInput())
  }

  function close() {
    open = false
  }

  // Closed first: the paste goes to the window that had the focus.
  function use(e) {
    if (!e) return
    close()
    ClipboardService.use(e)
  }

  function ago(ms) {
    const s = Math.max(0, (Date.now() - ms) / 1000)
    if (s < 60) return {{ tq "now" }}
    if (s < 3600) return {{ tq "minutes" }}.arg(Math.floor(s / 60))
    if (s < 86400) return {{ tq "hours" }}.arg(Math.floor(s / 3600))
    return new Date(ms).toLocaleDateString(Qt.locale("{{ lang }}"), Locale.ShortFormat)
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: Math.min(640, (screen ? screen.width : 1280) * 0.8)
    implicitHeight: Math.min(560, (screen ? screen.height : 900) * 0.75)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "myarch-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "myarch-panel-clipboard"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      anchors.fill: parent
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius

      ColumnLayout {
        anchors.fill: parent
        anchors.margins: 16
        spacing: 10

        RowLayout {
          Layout.fillWidth: true
          Caption { text: {{ tq "title" }}.toUpperCase() }
          Item { Layout.fillWidth: true }
          Button {
            visible: ClipboardService.entries.some(e => !e.pinned)
            text: {{ tq "clear" }}
            onClicked: ClipboardService.clear()
          }
        }

        TextField {
          id: search
          Layout.fillWidth: true
          placeholder: {{ tq "search" }}
          onTextChanged: {
            root.query = text
            root.current = 0
          }
          onAccepted: root.use(root.shown[root.current])
          Keys.onPressed: event => {
            const n = root.shown.length
            const e = root.shown[root.current]
            if (event.key === Qt.Key_Down) root.current = Math.max(0, Math.min(n - 1, root.current + 1))
            else if (event.key === Qt.Key_Up) root.current = Math.max(0, root.current - 1)
            else if (event.key === Qt.Key_Escape) root.close()
            else if (event.key === Qt.Key_Delete && e) ClipboardService.remove(e)
            else if (event.key === Qt.Key_P && (event.modifiers & Qt.ControlModifier) && e) ClipboardService.pin(e)
            else return
            event.accepted = true
          }
        }

        ListView {
          id: list
          Layout.fillWidth: true
          Layout.fillHeight: true
          clip: true
          spacing: 4
          model: root.shown
          currentIndex: root.current
          boundsBehavior: Flickable.StopAtBounds

          delegate: Rectangle {
            id: row
            required property var modelData
            required property int index
            readonly property var e: modelData
            width: ListView.view.width
            height: e.image ? 96 : Math.min(84, Math.max(44, preview.implicitHeight + 20))
            radius: Theme.radius
            color: index === root.current ? Theme.selection : area.containsMouse ? Theme.surface : "transparent"

            MouseArea {
              id: area
              anchors.fill: parent
              hoverEnabled: true
              acceptedButtons: Qt.LeftButton | Qt.RightButton
              cursorShape: Qt.PointingHandCursor
              onEntered: root.current = row.index
              onClicked: mouse => mouse.button === Qt.RightButton ? ClipboardService.remove(row.e) : root.use(row.e)
            }

            RowLayout {
              anchors.fill: parent
              anchors.margins: 10
              spacing: 10

              Image {
                visible: row.e.image
                Layout.preferredWidth: 136
                Layout.preferredHeight: 76
                source: row.e.image ? "file://" + row.e.path.split("/").map(encodeURIComponent).join("/") : ""
                sourceSize.width: 272
                fillMode: Image.PreserveAspectFit
                asynchronous: true
              }
              Label {
                id: preview
                visible: !row.e.image
                text: row.e.text.replace(/\s+$/, "")
                font.family: Theme.fontMono
                wrapMode: Text.WrapAnywhere
                maximumLineCount: 3
                elide: Text.ElideRight
                Layout.fillWidth: true
              }
              Item { visible: row.e.image; Layout.fillWidth: true }
              ColumnLayout {
                spacing: 2
                Layout.alignment: Qt.AlignTop
                Glyph {
                  Layout.alignment: Qt.AlignRight
                  text: String.fromCodePoint(row.e.pinned ? 0xF0403 : 0xF0931) // pin, pin-outline
                  color: row.e.pinned ? Theme.accentText : Theme.fgSubtle
                  visible: row.e.pinned || area.containsMouse
                  MouseArea {
                    anchors.fill: parent
                    cursorShape: Qt.PointingHandCursor
                    onClicked: ClipboardService.pin(row.e)
                  }
                }
                Caption {
                  Layout.alignment: Qt.AlignRight
                  text: root.ago(row.e.time)
                }
              }
            }
          }

          Label {
            anchors.centerIn: parent
            visible: root.shown.length === 0
            text: ClipboardService.entries.length === 0 ? {{ tq "empty" }} : {{ tq "none" }}
            color: Theme.fgSubtle
          }
        }

        Caption {
          text: ClipboardService.pastes ? {{ tq "hints" }} : {{ tq "hints.copy" }}
          elide: Text.ElideRight
          Layout.fillWidth: true
        }
      }
    }
  }
}
