// Generated by mazapan (plugin {{ plugin }}).
//
// Pomodoro: on the left the timer, a ring that fills as the phase goes,
// the time left in it, the sessions of this set, what it's for, and its
// buttons; on the right today (sessions against the day's goal, minutes
// focused, the streak of days) and the week. Space starts and pauses, S
// skips, R starts over, Esc closes.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/pomodoro"

Item {
  id: root

  property bool open: false
  property var screenAtOpen: null

  readonly property var pom: PomodoroService
  readonly property color tone: pom.phase === "short" ? Theme.success : pom.phase === "long" ? Theme.info : Theme.accent
  readonly property string phaseName: pom.phase === "focus" ? {{ tq "phase.focus" }}
    : pom.phase === "short" ? {{ tq "phase.short" }} : pom.phase === "long" ? {{ tq "phase.long" }} : {{ tq "phase.idle" }}

  function toggle() { open ? close() : show() }
  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    task.text = pom.task
    open = true
    Qt.callLater(() => keys.forceActiveFocus())
  }
  function close() {
    if (task.text !== pom.task) pom.setTask(task.text)
    open = false
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: 780
    implicitHeight: 540
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "mazapan-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "mazapan-panel-pomodoro"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      anchors.fill: parent
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius

      FocusScope {
        id: keys
        anchors.fill: parent
        focus: true
        Keys.onPressed: event => {
          if (event.key === Qt.Key_Escape) root.close()
          else if (event.key === Qt.Key_Space) pom.toggle()
          else if (event.key === Qt.Key_S) pom.skip()
          else if (event.key === Qt.Key_R) pom.reset()
          else return
          event.accepted = true
        }

        RowLayout {
          anchors.fill: parent
          anchors.margins: 24
          spacing: 28

          // --- the timer --------------------------------------------------------
          ColumnLayout {
            Layout.preferredWidth: 380
            Layout.fillHeight: true
            spacing: 14

            Caption {
              Layout.alignment: Qt.AlignHCenter
              text: root.phaseName.toUpperCase()
              color: pom.active ? root.tone : Theme.fgMuted
            }

            Item {
              Layout.alignment: Qt.AlignHCenter
              implicitWidth: 250
              implicitHeight: 250

              Ring {
                anchors.fill: parent
                thickness: 12
                progress: pom.progress
                color: root.tone
              }
              ColumnLayout {
                anchors.centerIn: parent
                spacing: 2
                Label {
                  Layout.alignment: Qt.AlignHCenter
                  text: pom.clock
                  font.family: Theme.fontMono
                  font.pixelSize: 56
                  font.bold: true
                  color: pom.running || !pom.active ? Theme.fg : Theme.fgMuted
                }
                Caption {
                  Layout.alignment: Qt.AlignHCenter
                  font.letterSpacing: 0
                  text: !pom.active ? {{ tq "ready" }}.arg(pom.focusMinutes)
                    : pom.running ? {{ tq "ends" }}.arg(new Date(pom.endsAt).toLocaleTimeString(Qt.locale("{{ lang }}"), Locale.ShortFormat))
                    : {{ tq "paused" }}
                }
              }
            }

            // The sessions of this set: done, the one going, still to come.
            Row {
              Layout.alignment: Qt.AlignHCenter
              spacing: 8
              Repeater {
                model: pom.sessionsPerSet
                Rectangle {
                  required property int index
                  readonly property int doneHere: pom.cycle % pom.sessionsPerSet
                  readonly property bool done: index < doneHere || (pom.phase === "long" && index < pom.sessionsPerSet)
                  readonly property bool current: pom.phase === "focus" && index === doneHere
                  width: 10; height: 10; radius: 5
                  color: done ? Theme.accent : "transparent"
                  border.width: done ? 0 : 1.5
                  border.color: current ? Theme.accent : Theme.border
                }
              }
            }

            TextField {
              id: task
              Layout.fillWidth: true
              placeholder: {{ tq "task" }}
              onAccepted: { pom.setTask(text); keys.forceActiveFocus() }
            }

            RowLayout {
              Layout.alignment: Qt.AlignHCenter
              spacing: 8
              Button { text: {{ tq "reset" }}; visible: pom.active; onClicked: pom.reset() }
              Button {
                primary: true
                text: !pom.active ? {{ tq "start" }} : pom.running ? {{ tq "pause" }} : {{ tq "resume" }}
                onClicked: { if (task.text !== pom.task) pom.setTask(task.text); pom.toggle() }
              }
              Button { text: {{ tq "skip" }}; visible: pom.active; onClicked: pom.skip() }
              Button { text: {{ tq "more" }}; visible: pom.active; onClicked: pom.extend(5) }
            }
          }

          Rectangle { Layout.fillHeight: true; implicitWidth: 1; color: Theme.border }

          // --- today and the week ---------------------------------------------------
          ColumnLayout {
            Layout.fillWidth: true
            Layout.fillHeight: true
            spacing: 14

            Caption { text: {{ tq "today" }}.toUpperCase() }

            RowLayout {
              spacing: 16
              Item {
                implicitWidth: 84
                implicitHeight: 84
                Ring {
                  anchors.fill: parent
                  thickness: 7
                  progress: Math.min(1, pom.today.sessions / Math.max(1, pom.dailyGoal))
                  color: Theme.success
                }
                Label {
                  anchors.centerIn: parent
                  text: `${pom.today.sessions}/${pom.dailyGoal}`
                  font.bold: true
                }
              }
              ColumnLayout {
                spacing: 4
                Label { text: (pom.today.sessions === 1 ? {{ tq "sessions.one" }} : {{ tq "sessions" }}).arg(pom.today.sessions); font.bold: true }
                Caption { text: (pom.today.minutes === 1 ? {{ tq "minutes.one" }} : {{ tq "minutes" }}).arg(pom.today.minutes); font.letterSpacing: 0 }
                Caption {
                  visible: pom.streak > 0
                  text: "󰈸 " + (pom.streak === 1 ? {{ tq "streak.one" }} : {{ tq "streak" }}).arg(pom.streak)
                  color: Theme.warning
                  font.letterSpacing: 0
                }
              }
            }

            Caption { text: {{ tq "week" }}.toUpperCase(); Layout.topMargin: 6 }

            // Minutes focused each day, the week's busiest the tallest.
            RowLayout {
              id: chart
              Layout.fillWidth: true
              Layout.preferredHeight: 150
              spacing: 10
              readonly property int most: Math.max(1, ...pom.week.map(d => d.minutes))
              Repeater {
                model: pom.week
                ColumnLayout {
                  required property var modelData
                  Layout.fillWidth: true
                  Layout.fillHeight: true
                  spacing: 6
                  Caption {
                    Layout.alignment: Qt.AlignHCenter
                    text: modelData.minutes > 0 ? modelData.minutes : ""
                    font.letterSpacing: 0
                  }
                  Item {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    Rectangle {
                      anchors.bottom: parent.bottom
                      anchors.horizontalCenter: parent.horizontalCenter
                      width: Math.min(26, parent.width)
                      height: Math.max(3, parent.height * modelData.minutes / chart.most)
                      radius: 4
                      color: modelData.today ? Theme.accent : modelData.minutes > 0 ? Theme.accentDeep : Theme.border
                    }
                  }
                  Caption {
                    Layout.alignment: Qt.AlignHCenter
                    text: modelData.label
                    color: modelData.today ? Theme.accentText : Theme.fgSubtle
                  }
                }
              }
            }

            Item { Layout.fillHeight: true }

            RowLayout {
              Layout.fillWidth: true
              Caption {
                Layout.fillWidth: true
                wrapMode: Text.Wrap
                font.letterSpacing: 0
                text: {{ tq "plan" }}.arg(pom.focusMinutes).arg(pom.shortMinutes).arg(pom.longMinutes).arg(pom.sessionsPerSet)
              }
              Button {
                text: {{ tq "settings" }}
                onClicked: {
                  root.close()
                  Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "plugins", "open", "pomodoro"])
                }
              }
            }
            Caption {
              text: {{ tq "keys" }}
              color: Theme.fgSubtle
              font.letterSpacing: 0
            }
          }
        }
      }
    }
  }
}
