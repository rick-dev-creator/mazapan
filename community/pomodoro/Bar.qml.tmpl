// Generated by mazapan (plugin {{ plugin }}).
//
// In the bar while a session is on (running or paused), as a live activity:
// a small ring and the time left, in the phase's color, dimmed when
// paused. Gone when there's none (the Control Center's card starts one).
// Its Control Center section has another name, so it isn't folded into
// the Control Center's pill. A click opens the panel; a right click
// starts or pauses.

import QtQuick
import Quickshell
import qs
import "../../components/kit"
import "../../components/pomodoro"

BarItem {
  id: root

  readonly property var pom: PomodoroService
  readonly property color tone: pom.phase === "short" ? Theme.success : pom.phase === "long" ? Theme.info : Theme.accent

  shown: pom.inBar && pom.active
  // The digits change every second: the icons beside it stay put.
  steady: true
  acceptedButtons: Qt.LeftButton | Qt.RightButton
  onClicked: mouse => {
    if (mouse.button === Qt.RightButton) pom.toggle()
    else Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "pomodoro"])
  }

  Ring {
    anchors.verticalCenter: parent.verticalCenter
    width: 14
    height: 14
    thickness: 2.5
    progress: pom.progress
    color: pom.running ? root.tone : Theme.fgSubtle
  }

  Label {
    anchors.verticalCenter: parent.verticalCenter
    text: pom.clock
    font.family: Theme.fontMono
    color: pom.running ? Theme.fg : Theme.fgMuted
  }
}
