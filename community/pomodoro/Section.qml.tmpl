// Generated by mazapan (plugin {{ plugin }}): the timer, in the Control Center.
//
// What phase it is and the time left, a button to start or pause and one
// to skip; today's sessions against the goal. The arrow opens the panel.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/pomodoro"
import "../../components/control"

Group {
  id: root

  readonly property var pom: PomodoroService
  readonly property color tone: pom.phase === "short" ? Theme.success : pom.phase === "long" ? Theme.info : Theme.accent
  property bool shown: true

  title: {{ tq "title" }}
  trailing: "󰅂"
  onTrailingClicked: {
    ControlService.close()
    Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "pomodoro"])
  }

  RowLayout {
    Layout.fillWidth: true
    spacing: 12

    Item {
      implicitWidth: 40
      implicitHeight: 40
      Ring {
        anchors.fill: parent
        thickness: 4
        progress: pom.progress
        color: pom.running ? root.tone : Theme.fgSubtle
      }
      Glyph {
        anchors.centerIn: parent
        text: "󰔛"
        color: pom.active ? root.tone : Theme.fgMuted
      }
    }
    ColumnLayout {
      Layout.fillWidth: true
      spacing: 0
      Label {
        text: pom.active ? pom.clock : {{ tq "phase.idle" }}
        font.family: pom.active ? Theme.fontMono : Theme.fontUi
        font.bold: true
      }
      Caption {
        font.letterSpacing: 0
        text: (pom.phase === "focus" ? {{ tq "phase.focus" }} : pom.phase === "short" ? {{ tq "phase.short" }}
          : pom.phase === "long" ? {{ tq "phase.long" }} : "") + (pom.active ? " · " : "")
          + {{ tq "sessions_of" }}.arg(pom.today.sessions).arg(pom.dailyGoal)
      }
    }
    Button {
      primary: !pom.running
      text: !pom.active ? {{ tq "start" }} : pom.running ? {{ tq "pause" }} : {{ tq "resume" }}
      onClicked: pom.toggle()
    }
    Button { visible: pom.active; text: {{ tq "skip" }}; onClicked: pom.skip() }
  }
}
