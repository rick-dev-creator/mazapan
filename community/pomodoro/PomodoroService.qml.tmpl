// Generated by mazapan (plugin {{ plugin }}).
//
// The Pomodoro timer for the whole shell: one, however many bars and
// panels show it. Focus, a short break, focus again; every few sessions a
// long break. Its state is kept in a file (when the phase ends, not a count
// that stops with the shell), so a reload or a restart picks it up where it
// was; and each day's sessions and focus minutes, for the stats.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

Singleton {
  id: root

  readonly property string file: Quickshell.env("HOME") + "/.local/state/mazapan/pomodoro.json"

  // The settings.
  readonly property int focusMinutes: {{ settings.focus_minutes }}
  readonly property int shortMinutes: {{ settings.short_break }}
  readonly property int longMinutes: {{ settings.long_break }}
  readonly property int sessionsPerSet: {{ settings.sessions_before_long }}
  readonly property bool autoBreaks: {{ settings.auto_start_breaks }}
  readonly property bool autoFocus: {{ settings.auto_start_focus }}
  readonly property int dailyGoal: {{ settings.daily_goal }}
  readonly property bool quietFocus: {{ settings.do_not_disturb }}
  readonly property bool sound: {{ settings.sound }}

  // The state: "idle", "focus", "short" or "long"; running or paused (with
  // what's left); the focus sessions done in this set; what it's for.
  property string phase: "idle"
  property bool running: false
  property real endsAt: 0
  property real left: 0
  property int cycle: 0
  property string task: ""
  // Day ("2026-10-06") → { sessions, minutes }.
  property var days: ({})
  property bool loaded: false

  property real now: Date.now()
  readonly property real total: lengthOf(phase)
  readonly property real remaining: phase === "idle" ? focusMinutes * 60000
    : running ? Math.max(0, endsAt - now) : left
  readonly property real progress: phase === "idle" || total <= 0 ? 0 : 1 - remaining / total
  readonly property bool active: phase !== "idle"
  readonly property bool focusing: phase === "focus"
  readonly property string clock: format(remaining)

  readonly property var today: days[dayKey(new Date(now))] ?? ({ sessions: 0, minutes: 0 })
  readonly property int streak: streakDays()
  // The last 7 days, oldest first: { label, minutes, today }.
  readonly property var week: lastDays(7)

  function lengthOf(p) {
    return (p === "short" ? shortMinutes : p === "long" ? longMinutes : focusMinutes) * 60000
  }
  function format(ms) {
    const s = Math.ceil(ms / 1000)
    const m = Math.floor(s / 60)
    return `${m < 10 ? "0" : ""}${m}:${s % 60 < 10 ? "0" : ""}${s % 60}`
  }
  function dayKey(d) {
    const p = n => (n < 10 ? "0" : "") + n
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`
  }
  function streakDays() {
    let n = 0
    const d = new Date(now)
    // Today counts once it has a session; until then yesterday's run goes on.
    if (!(days[dayKey(d)]?.sessions > 0)) d.setDate(d.getDate() - 1)
    while (days[dayKey(d)]?.sessions > 0) { n++; d.setDate(d.getDate() - 1) }
    return n
  }
  function lastDays(n) {
    const out = []
    const d = new Date(now)
    d.setDate(d.getDate() - (n - 1))
    for (let i = 0; i < n; i++) {
      const k = dayKey(d)
      out.push({ label: Qt.locale("{{ lang }}").dayName(d.getDay(), Locale.NarrowFormat), minutes: days[k]?.minutes ?? 0, today: i === n - 1 })
      d.setDate(d.getDate() + 1)
    }
    return out
  }

  // --- what a person does ------------------------------------------------------

  function start() {
    if (phase === "idle") begin("focus", true)
    else if (!running) {
      endsAt = Date.now() + left
      running = true
      quiet()
      save()
    }
  }
  function pause() {
    if (!running) return
    left = Math.max(0, endsAt - Date.now())
    running = false
    quiet()
    save()
  }
  function toggle() { running ? pause() : start() }
  // To the next phase now: a focus session cut short isn't counted.
  function skip() {
    if (phase === "idle") return
    advance(false)
  }
  function reset() {
    phase = "idle"
    running = false
    left = 0
    cycle = 0
    quiet()
    save()
  }
  function extend(minutes) {
    if (phase === "idle") return
    if (running) endsAt += minutes * 60000
    else left += minutes * 60000
    save()
  }
  function setTask(t) { task = t; save() }

  // --- how it goes on ----------------------------------------------------------

  function begin(p, go) {
    phase = p
    running = go
    left = lengthOf(p)
    endsAt = Date.now() + left
    quiet()
    save()
  }
  // The phase is over (counted when it ran to its end), and the next one
  // starts, or waits for a start, as the settings say.
  function advance(finished) {
    if (phase === "focus") {
      if (finished) {
        const k = dayKey(new Date())
        const d = Object.assign({}, days)
        const t = d[k] ?? { sessions: 0, minutes: 0 }
        d[k] = { sessions: t.sessions + 1, minutes: t.minutes + Math.round(total / 60000) }
        days = d
      }
      cycle = finished ? cycle + 1 : cycle
      const next = finished && cycle % sessionsPerSet === 0 ? "long" : "short"
      begin(next, autoBreaks)
      if (finished) tell(next === "long" ? {{ tq "n.long" }} : {{ tq "n.short" }}, autoBreaks)
    } else {
      if (phase === "long") cycle = 0
      begin("focus", autoFocus)
      tell({{ tq "n.focus" }}, autoFocus)
    }
  }
  function tick() {
    now = Date.now()
    if (running && endsAt <= now) advance(true)
  }

  // Said when a phase ends: a sound, and a notification that offers the
  // next step when it waits for one.
  function tell(text, started) {
    if (sound) Quickshell.execDetached(["sh", "-c", 'for f in /usr/share/sounds/freedesktop/stereo/complete.oga /usr/share/sounds/freedesktop/stereo/bell.oga; do [ -f "$f" ] && exec pw-play "$f"; done'])
    const app = {{ tq "title" }}
    // What it's for, under it, when there's something.
    const body = task.trim() !== "" ? {{ tq "n.task" }}.arg(task.trim()) : ""
    if (started) {
      Quickshell.execDetached(["notify-send", "-a", app, "-i", "appointment-soon", "--", text, body])
      return
    }
    // A button that starts it; answered (or not) in the background.
    Quickshell.execDetached(["sh", "-c", 'a=$(notify-send -a "$1" -i appointment-soon -A start="$4" -w -- "$2" "$3"); [ "$a" = start ] && qs ipc -c mazapan call pomodoro start',
      "pomodoro", app, text, body, {{ tq "n.start" }}])
  }

  // Do Not Disturb while a focus session runs, through a mode of its own
  // (its notifications still come). Only when no other mode is on: one the
  // person set is left as it is.
  property bool quietOn: false
  function quiet() {
    const want = quietFocus && phase === "focus" && running
    if (want === quietOn) return
    if (want) modeCheck.running = true
    else {
      quietOn = false
      Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "notifications", "setMode", "", "false", ""])
    }
  }
  Process {
    id: modeCheck
    command: ["qs", "ipc", "-c", "mazapan", "call", "modes", "active"]
    stdout: StdioCollector {
      onStreamFinished: {
        if (text.trim() !== "" || !(root.phase === "focus" && root.running)) return
        root.quietOn = true
        Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "notifications", "setMode", {{ tq "title" }}, "true", "{{ t "title" }}"])
      }
    }
  }

  // --- kept --------------------------------------------------------------------

  function save() {
    if (!loaded) return
    store.setText(JSON.stringify({ version: 1, phase: phase, running: running, endsAt: endsAt, left: left,
      cycle: cycle, task: task, days: days }))
  }
  FileView {
    id: store
    path: root.file
    atomicWrites: true
    printErrors: false
    onLoaded: {
      try {
        const o = JSON.parse(text())
        root.phase = ["focus", "short", "long"].includes(o.phase) ? o.phase : "idle"
        root.running = !!o.running
        root.endsAt = Number(o.endsAt) || 0
        root.left = Number(o.left) || 0
        root.cycle = Number(o.cycle) || 0
        root.task = String(o.task ?? "")
        root.days = o.days ?? {}
      } catch (e) {}
      root.loaded = true
      // Over while the shell was away: on to the next, quietly.
      if (root.running && root.endsAt <= Date.now()) root.advance(true)
      root.quiet()
    }
    onLoadFailed: root.loaded = true
  }
  Component.onCompleted: Quickshell.execDetached(["mkdir", "-p", Quickshell.env("HOME") + "/.local/state/mazapan"])

  Timer {
    interval: root.running ? 250 : 30000
    running: true
    repeat: true
    onTriggered: root.tick()
  }

  IpcHandler {
    target: "pomodoro"
    function toggle(): void { root.toggle() }
    function start(): void { root.start() }
    function pause(): void { root.pause() }
    function skip(): void { root.skip() }
    function reset(): void { root.reset() }
    function extend(minutes: int): void { root.extend(minutes) }
    function state(): string { return JSON.stringify({ phase: root.phase, running: root.running, remaining: Math.round(root.remaining / 1000), cycle: root.cycle, today: root.today }) }
  }
}
