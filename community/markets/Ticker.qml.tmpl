// Generated by mazapan (plugin {{ plugin }}).
//
// The symbols pinned in the Main list (three at most), one at a time:
// symbol and timeframe, a small trend, price, and the current candle's
// change. A click opens the Markets panel.

import QtQuick
import Quickshell
import qs
import "../../components/kit"
import "../../components/markets"

BarItem {
  id: root

  readonly property var pins: MarketsService.main.filter(e => e.pinned).slice(0, 3)
  property int turn: 0
  readonly property var entry: pins.length > 0 ? pins[turn % pins.length] : null
  readonly property var quote: entry ? MarketsService.get(entry.kind, entry.symbol, entry.tf) : null
  readonly property bool up: quote !== null && quote.change >= 0

  shown: {{ settings.bar }} && pins.length > 0
  onClicked: Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "markets"])
  onWheel: event => root.turn += event.angleDelta.y > 0 ? pins.length - 1 : 1

  Label {
    anchors.verticalCenter: parent.verticalCenter
    text: root.entry ? MarketsService.label(root.entry.symbol) : ""
    font.bold: true
  }

  Caption {
    anchors.verticalCenter: parent.verticalCenter
    text: root.entry ? root.entry.tf : ""
  }

  Sparkline {
    anchors.verticalCenter: parent.verticalCenter
    width: 36
    height: 14
    lineWidth: 1.2
    values: root.quote && root.quote.candles ? root.quote.candles.slice(-30).map(c => c.c) : []
    color: root.up ? Theme.success : Theme.danger
  }

  Label {
    anchors.verticalCenter: parent.verticalCenter
    text: root.quote ? MarketsService.compact(root.quote.price) : "…"
  }

  Label {
    anchors.verticalCenter: parent.verticalCenter
    text: root.quote ? MarketsService.percent(root.quote.change) : ""
    color: root.up ? Theme.success : Theme.danger
  }

  Timer {
    interval: {{ settings.bar_rotate_seconds }} * 1000
    running: root.pins.length > 1
    repeat: true
    onTriggered: root.turn++
  }
}
