// Generated by mazapan (plugin {{ plugin }}): the markets, in the Control Center.
//
// The symbols pinned in the Main list (three at most): symbol and
// timeframe, a small trend, price and the current candle's change. A click
// opens the Markets panel.

import QtQuick
import QtQuick.Layouts
import Quickshell
import qs
import "../../components/kit"
import "../../components/markets"
import "../../components/control"

Group {
  id: root

  readonly property var pins: MarketsService.main.filter(e => e.pinned).slice(0, 3)
  property bool shown: {{ settings.bar }} && pins.length > 0

  title: {{ tq "title" }}
  trailing: "󰅂"
  onTrailingClicked: {
    ControlService.close()
    Quickshell.execDetached(["qs", "ipc", "-c", "mazapan", "call", "mazapan", "panel", "markets"])
  }

  Repeater {
    model: root.pins
    RowLayout {
      required property var modelData
      readonly property var quote: MarketsService.get(modelData.kind, modelData.symbol, modelData.tf)
      readonly property bool up: quote !== null && quote.change >= 0
      Layout.fillWidth: true
      spacing: 8
      Label { text: MarketsService.label(modelData.symbol); font.bold: true }
      Caption { text: modelData.tf; font.letterSpacing: 0 }
      Item { Layout.fillWidth: true }
      Sparkline {
        width: 60
        height: 16
        lineWidth: 1.2
        values: quote && quote.candles ? quote.candles.slice(-30).map(c => c.c) : []
        color: up ? Theme.success : Theme.danger
      }
      Label { text: quote ? MarketsService.compact(quote.price) : "…" }
      Label {
        text: quote ? MarketsService.percent(quote.change) : ""
        color: up ? Theme.success : Theme.danger
        Layout.preferredWidth: 64
        horizontalAlignment: Text.AlignRight
      }
    }
  }
}
