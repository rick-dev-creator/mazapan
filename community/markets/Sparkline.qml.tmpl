// Generated by myarch (plugin {{ plugin }}).
//
// A trend at a glance: the closes as a line, the area under it faintly
// filled, in the color of the change.

import QtQuick
import qs

Canvas {
  id: spark

  property var values: []
  property color color: Theme.fgMuted
  property real lineWidth: 1.5

  // The same line again isn't drawn again: prices arrive in batches.
  property string drawn: ""
  onValuesChanged: {
    const now = JSON.stringify(values || [])
    if (now === drawn) return
    drawn = now
    requestPaint()
  }
  onColorChanged: requestPaint()
  onWidthChanged: requestPaint()
  onHeightChanged: requestPaint()

  onPaint: {
    const ctx = getContext("2d")
    ctx.reset()
    const v = values || []
    if (v.length < 2 || width <= 0 || height <= 0) return
    let lo = Infinity, hi = -Infinity
    for (const x of v) {
      lo = Math.min(lo, x)
      hi = Math.max(hi, x)
    }
    const span = hi - lo || 1
    const pad = lineWidth
    const x = i => i / (v.length - 1) * width
    const y = n => pad + (1 - (n - lo) / span) * (height - pad * 2)

    ctx.beginPath()
    ctx.moveTo(0, y(v[0]))
    for (let i = 1; i < v.length; i++) ctx.lineTo(x(i), y(v[i]))
    ctx.lineWidth = lineWidth
    ctx.lineJoin = "round"
    ctx.strokeStyle = spark.color
    ctx.stroke()

    ctx.lineTo(width, height)
    ctx.lineTo(0, height)
    ctx.closePath()
    ctx.globalAlpha = 0.14
    ctx.fillStyle = spark.color
    ctx.fill()
  }
}
