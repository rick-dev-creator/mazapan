// Generated by mazapan (plugin {{ plugin }}).
//
// The detail chart: candles (or a line) over their volume, the price scale
// on the right, and under the pointer a crosshair on the candle it's over
// (hovered tells which).

import QtQuick
import qs

Item {
  id: chart

  property var candles: []
  property bool line: false
  property color up: Theme.success
  property color down: Theme.danger
  // The candle under the pointer, or null.
  readonly property var hovered: hoverIndex >= 0 && hoverIndex < (candles || []).length ? candles[hoverIndex] : null
  property int hoverIndex: -1

  // As wide as the widest price on it: the highest, or the lowest (below
  // 1 a price has more digits).
  readonly property int scaleWidth: Math.ceil(Math.max(highest.width, lowest.width)) + 16
  TextMetrics {
    id: highest
    font.family: Theme.fontMono
    font.pointSize: 9
    text: (chart.candles || []).length ? chart.fmt(Math.max(...chart.candles.map(c => c.h))) : "0"
  }
  TextMetrics {
    id: lowest
    font.family: Theme.fontMono
    font.pointSize: 9
    text: (chart.candles || []).length ? chart.fmt(Math.min(...chart.candles.map(c => c.l))) : "0"
  }
  // Drawn again when the theme changes (or is previewed).
  readonly property var colors: [Theme.border, Theme.fgSubtle, Theme.fgMuted, Theme.bg, Theme.fontMono, up, down]
  onColorsChanged: canvas.requestPaint()
  onCandlesChanged: canvas.requestPaint()
  onLineChanged: canvas.requestPaint()
  onHoverIndexChanged: canvas.requestPaint()

  function fmt(v) { return MarketsService.price(v) }

  Canvas {
    id: canvas
    anchors.fill: parent
    onWidthChanged: requestPaint()
    onHeightChanged: requestPaint()

    onPaint: {
      const ctx = getContext("2d")
      ctx.reset()
      const cs = chart.candles || []
      if (cs.length < 2 || width <= chart.scaleWidth) return
      const w = width - chart.scaleWidth
      const priceH = height * 0.8
      const volTop = height * 0.84
      let lo = Infinity, hi = -Infinity, vmax = 0
      for (const c of cs) {
        lo = Math.min(lo, chart.line ? c.c : c.l)
        hi = Math.max(hi, chart.line ? c.c : c.h)
        vmax = Math.max(vmax, c.v)
      }
      const span = hi - lo || 1
      const step = w / cs.length
      const y = n => 6 + (1 - (n - lo) / span) * (priceH - 12)
      const cx = i => i * step + step / 2

      // Grid and scale: five prices, evenly apart.
      ctx.font = "9pt '" + Theme.fontMono + "'"
      ctx.textBaseline = "middle"
      for (let k = 0; k <= 4; k++) {
        const p = lo + span * k / 4
        const yy = Math.round(y(p)) + 0.5
        ctx.strokeStyle = Theme.border
        ctx.globalAlpha = 0.6
        ctx.lineWidth = 1
        ctx.beginPath()
        ctx.moveTo(0, yy)
        ctx.lineTo(w, yy)
        ctx.stroke()
        ctx.globalAlpha = 1
        ctx.fillStyle = Theme.fgSubtle
        ctx.fillText(chart.fmt(p), w + 8, yy)
      }

      // Volume, faint, at the bottom.
      if (vmax > 0)
        for (let i = 0; i < cs.length; i++) {
          const c = cs[i]
          const hh = (height - volTop) * c.v / vmax
          ctx.globalAlpha = 0.3
          ctx.fillStyle = c.c >= c.o ? chart.up : chart.down
          ctx.fillRect(i * step + step * 0.15, height - hh, Math.max(1, step * 0.7), hh)
        }
      ctx.globalAlpha = 1

      if (chart.line) {
        const first = cs[0].c, last = cs[cs.length - 1].c
        ctx.strokeStyle = last >= first ? chart.up : chart.down
        ctx.lineWidth = 2
        ctx.lineJoin = "round"
        ctx.beginPath()
        ctx.moveTo(cx(0), y(cs[0].c))
        for (let i = 1; i < cs.length; i++) ctx.lineTo(cx(i), y(cs[i].c))
        ctx.stroke()
      } else
        for (let i = 0; i < cs.length; i++) {
          const c = cs[i]
          const color = c.c >= c.o ? chart.up : chart.down
          ctx.strokeStyle = color
          ctx.fillStyle = color
          ctx.lineWidth = 1
          const x = Math.round(cx(i)) + 0.5
          ctx.beginPath()
          ctx.moveTo(x, y(c.h))
          ctx.lineTo(x, y(c.l))
          ctx.stroke()
          const top = y(Math.max(c.o, c.c))
          const body = Math.max(1, Math.abs(y(c.o) - y(c.c)))
          ctx.fillRect(x - Math.max(1, step * 0.35), top, Math.max(2, step * 0.7), body)
        }

      // The last price, marked on the scale.
      const last = cs[cs.length - 1]
      const ly = Math.round(y(last.c)) + 0.5
      ctx.strokeStyle = last.c >= last.o ? chart.up : chart.down
      ctx.setLineDash([3, 3])
      ctx.beginPath()
      ctx.moveTo(0, ly)
      ctx.lineTo(w, ly)
      ctx.stroke()
      ctx.setLineDash([])
      ctx.fillStyle = last.c >= last.o ? chart.up : chart.down
      ctx.fillRect(w + 2, ly - 9, chart.scaleWidth - 2, 18)
      ctx.fillStyle = Theme.bg
      ctx.fillText(chart.fmt(last.c), w + 8, ly)

      // Crosshair on the hovered candle.
      if (chart.hoverIndex >= 0 && chart.hoverIndex < cs.length) {
        const hx = Math.round(cx(chart.hoverIndex)) + 0.5
        ctx.strokeStyle = Theme.fgMuted
        ctx.globalAlpha = 0.7
        ctx.setLineDash([2, 3])
        ctx.beginPath()
        ctx.moveTo(hx, 0)
        ctx.lineTo(hx, height)
        ctx.stroke()
        ctx.setLineDash([])
        ctx.globalAlpha = 1
      }
    }
  }

  MouseArea {
    anchors.fill: parent
    anchors.rightMargin: chart.scaleWidth
    hoverEnabled: true
    onPositionChanged: mouse => {
      const n = (chart.candles || []).length
      chart.hoverIndex = n ? Math.max(0, Math.min(n - 1, Math.floor(mouse.x / width * n))) : -1
    }
    onExited: chart.hoverIndex = -1
  }
}
