// Generated by mazapan (plugin {{ plugin }}).
//
// Prices and candles for the whole shell, fetched once however many bars
// and panels show them. Crypto candles come from Binance's public market
// data (data-api.binance.vision), the top 20 by market cap from
// CoinPaprika, stocks from Yahoo Finance or Twelve Data: no account but for
// Twelve Data's key.
//
// Every entry is a symbol and a timeframe ("BTC 4H", "SOL 1D"): its change
// is the current candle's, as a trader's chart shows it, and its sparkline
// the candles before.
pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs

Singleton {
  id: root

  readonly property var locale: Qt.locale("{{ lang }}")
  readonly property string dir: Quickshell.env("HOME") + "/.local/state/mazapan-markets"
  readonly property int refreshSeconds: {{ settings.refresh_seconds }}
  readonly property bool barOn: {{ settings.bar }}
  readonly property string stockSource: {{ quote settings.stock_source }}
  readonly property string twelveKey: {{ quote settings.twelvedata_key }}
  readonly property bool hideStable: {{ settings.hide_stablecoins }}
  readonly property var timeframes: ["15m", "1H", "4H", "1D", "1W", "1M"]
  // How long each timeframe's candle is, in ms (a month: its shortest).
  readonly property var span: ({ "15m": 9e5, "1H": 36e5, "4H": 144e5, "1D": 864e5, "1W": 6048e5, "1M": 24192e5 })
  // Candles fetched per series: the detail chart shows them all, a
  // sparkline the last ones.
  readonly property int candles: 100

  // The lists, as watchlist.json has them. main: [{kind, symbol, tf,
  // pinned, name}]; crypto: symbols shown after the top 20; stocks: symbols.
  property var main: []
  property var crypto: []
  property var stocks: []
  property bool loaded: false
  // watchlist.json is there but can't be read: shown, and never saved over
  // (it would lose the list) until it's fixed or deleted.
  property string fileError: ""

  // The Crypto and Stocks tabs show every row in one timeframe.
  property string cryptoTf: "1D"
  property string stocksTf: "1D"

  // Top 20 by market cap: [{rank, symbol, name, price, change24}].
  // CoinPaprika updates it every few minutes: asked at most that often.
  property var top: []
  property string topError: ""
  property double topAt: 0

  // While the panel is open everything it shows is kept fresh; otherwise
  // only the symbols pinned to the bar.
  property bool browsing: false
  property string browsingTab: "main"
  // The detail chart's series, fetched too.
  property var detail: null // {kind, symbol, tf}

  // Series by key "kind:symbol:tf": {candles: [{t, o, h, l, c, v}], price,
  // change, name, currency, closed, error, loading, since}. version changes
  // once the ones arriving together are in: what reads a series through
  // get() follows it.
  property var series: ({})
  property int version: 0
  property string updated: ""

  function key(kind, symbol, tf) { return kind + ":" + symbol + ":" + tf }

  function get(kind, symbol, tf) {
    version // a binding that asks is told when it changes
    return series[key(kind, symbol, tf)] || null
  }

  // The top list's row for a coin (its CoinPaprika price, name), or null.
  function topFor(symbol) {
    return top.find(r => r.symbol === symbol) || null
  }

  function nameOf(symbol) {
    const t = topFor(symbol)
    return t ? t.name : ""
  }

  // --- the lists ---------------------------------------------------------------

  readonly property var defaults: ({
    main: [
      { kind: "crypto", symbol: "BTC", tf: "4H", pinned: true, name: "Bitcoin" },
      { kind: "crypto", symbol: "BTC", tf: "1W", pinned: false, name: "Bitcoin" },
      { kind: "crypto", symbol: "ETH", tf: "1D", pinned: false, name: "Ethereum" },
      { kind: "crypto", symbol: "SOL", tf: "1D", pinned: true, name: "Solana" },
      { kind: "stock", symbol: "^GSPC", tf: "1D", pinned: false, name: "" },
      { kind: "stock", symbol: "NVDA", tf: "1D", pinned: false, name: "" },
    ],
    crypto: [],
    stocks: ["^GSPC", "^IXIC", "^DJI", "AAPL", "MSFT", "NVDA", "AMZN", "TSLA"],
  })

  // What a symbol may be: letters, digits and what tickers use (^GSPC,
  // BRK-B, SHOP.TO, EURUSD=X).
  function valid(kind, symbol) {
    return kind === "crypto" ? /^[A-Z0-9]{2,20}$/.test(symbol) : /^[A-Z0-9^.=-]{1,20}$/.test(symbol)
  }

  function use(o) {
    const clean = e => ({
      kind: e.kind === "stock" ? "stock" : "crypto",
      symbol: String(e.symbol || "").toUpperCase(),
      tf: timeframes.includes(e.tf) ? e.tf : "1D",
      pinned: e.pinned === true,
      name: typeof e.name === "string" ? e.name : "",
    })
    const symbols = (list, kind) => (Array.isArray(list) ? list : [])
      .map(s => String(s).toUpperCase()).filter(s => valid(kind, s))
    main = (Array.isArray(o.main) ? o.main : []).filter(e => e && typeof e === "object")
      .map(clean).filter(e => valid(e.kind, e.symbol))
    crypto = symbols(o.crypto, "crypto")
    stocks = symbols(o.stocks, "stock")
    fileError = ""
    loaded = true
    if (top.length === 0) fetchTop() // names for the coins in Main too
    refresh()
  }

  // What was last written: the file watcher sees our own save too, and
  // that one isn't news.
  property string written: ""

  function save() {
    if (fileError !== "") return
    written = JSON.stringify({ main: main, crypto: crypto, stocks: stocks }, null, 2) + "\n"
    store.setText(written)
  }

  function has(kind, symbol, tf) {
    return main.some(e => e.kind === kind && e.symbol === symbol && e.tf === tf)
  }

  function addMain(kind, symbol, tf, name) {
    if (has(kind, symbol, tf)) return
    main = main.concat([{ kind: kind, symbol: symbol, tf: tf, pinned: false, name: name || "" }])
    save()
    fetch(kind, symbol, tf)
  }

  function removeMain(i) {
    main = main.filter((_, n) => n !== i)
    save()
  }

  function moveMain(i, by) {
    const j = i + by
    if (j < 0 || j >= main.length) return
    const next = main.slice()
    const [e] = next.splice(i, 1)
    next.splice(j, 0, e)
    main = next
    save()
  }

  function changeMain(i, fields) {
    main = main.map((e, n) => n === i ? Object.assign({}, e, fields) : e)
    save()
    const e = main[i]
    if (fields.tf) fetch(e.kind, e.symbol, e.tf)
  }

  // The bar shows three at most: pinning a fourth unpins the first.
  function pin(i, on) {
    let next = main.map((e, n) => n === i ? Object.assign({}, e, { pinned: on }) : e)
    const pinned = next.map((e, n) => e.pinned ? n : -1).filter(n => n >= 0)
    if (pinned.length > 3) {
      const drop = pinned.find(n => n !== i)
      next = next.map((e, n) => n === drop ? Object.assign({}, e, { pinned: false }) : e)
    }
    main = next
    save()
  }

  function addTo(list, symbol) {
    if (list === "crypto" && !crypto.includes(symbol)) crypto = crypto.concat([symbol])
    if (list === "stocks" && !stocks.includes(symbol)) stocks = stocks.concat([symbol])
    save()
    fetch(list === "crypto" ? "crypto" : "stock", symbol, list === "crypto" ? cryptoTf : stocksTf)
  }

  function removeFrom(list, symbol) {
    if (list === "crypto") crypto = crypto.filter(s => s !== symbol)
    else stocks = stocks.filter(s => s !== symbol)
    save()
  }

  // The Crypto tab's rows: the top 20, then yours that aren't in it. Only
  // what they are: prices come from get() and topFor(), so a new price
  // doesn't make a new list.
  function cryptoRows() {
    const rows = top.map(r => ({ kind: "crypto", symbol: r.symbol, name: r.name, rank: r.rank }))
    for (const s of crypto)
      if (!rows.some(r => r.symbol === s)) rows.push({ kind: "crypto", symbol: s, name: "", rank: 0, yours: true })
    return rows
  }

  // --- fetching ----------------------------------------------------------------

  function request(url, done, fail) {
    const xhr = new XMLHttpRequest()
    xhr.onreadystatechange = () => {
      if (xhr.readyState !== XMLHttpRequest.DONE) return
      let o = null
      try {
        o = JSON.parse(xhr.responseText)
      } catch (e) {}
      if (xhr.status === 400 || xhr.status === 404) return fail("not_found")
      if (xhr.status !== 200) {
        // A service that says why (Twelve Data: a wrong key, too many requests).
        if (o && typeof o.message === "string") return fail(o.message)
        return fail(xhr.status ? {{ tq "http_error" }}.arg(xhr.status) : {{ tq "offline" }})
      }
      if (o === null) return fail({{ tq "bad_response" }})
      try {
        done(o)
      } catch (e) {
        fail({{ tq "bad_response" }})
      }
    }
    xhr.open("GET", url)
    xhr.send()
  }

  // BTC -> BTCUSDT; a whole pair (ETHBTC, SOLUSDC) as it is.
  function pair(symbol) {
    return symbol.length > 5 && /(USDT|USDC|FDUSD|BTC|ETH|BNB)$/.test(symbol) ? symbol : symbol + "USDT"
  }

  // What a pair's price is in: dollars for the dollar coins, else the coin.
  function quoteOf(p) {
    const m = p.match(/(USDT|USDC|FDUSD|BTC|ETH|BNB)$/)
    return !m || ["USDT", "USDC", "FDUSD"].includes(m[1]) ? "USD" : m[1]
  }

  readonly property var binance: ({ "15m": "15m", "1H": "1h", "4H": "4h", "1D": "1d", "1W": "1w", "1M": "1M" })
  // Yahoo has no 4-hour candles: hourly ones, four by four within a day.
  readonly property var yahoo: ({
    "15m": ["15m", "5d", 1], "1H": ["60m", "1mo", 1], "4H": ["60m", "3mo", 4],
    "1D": ["1d", "6mo", 1], "1W": ["1wk", "2y", 1], "1M": ["1mo", "10y", 1],
  })
  readonly property var twelve: ({ "15m": "15min", "1H": "1h", "4H": "4h", "1D": "1day", "1W": "1week", "1M": "1month" })
  // Yahoo's index tickers, as Twelve Data writes them.
  readonly property var twelveIndex: ({ "^GSPC": "SPX", "^IXIC": "IXIC", "^DJI": "DJI", "^RUT": "RUT", "^VIX": "VIX" })

  function fetch(kind, symbol, tf) {
    const k = key(kind, symbol, tf)
    const old = series[k]
    // One request at a time per series; one that never answered (a laptop
    // that slept) is given up after 20 seconds.
    if (old && old.loading && Date.now() - old.since < 20000) return
    put(k, Object.assign({}, old || {}, { loading: true, since: Date.now() }))
    const done = s => {
      put(k, Object.assign({ loading: false, error: "" }, s, {
        price: s.candles.length ? s.candles[s.candles.length - 1].c : NaN,
        change: s.candles.length ? change(s.candles[s.candles.length - 1]) : NaN,
      }))
      updated = new Date().toLocaleTimeString(locale, Locale.ShortFormat)
    }
    const fail = why => put(k, Object.assign({}, old || {}, {
      loading: false,
      error: why === "not_found" ? {{ tq "not_found" }}.arg(symbol) : why,
    }))
    if (!valid(kind, symbol)) return fail("not_found")
    if (kind === "crypto") {
      const p = pair(symbol)
      request(`https://data-api.binance.vision/api/v3/klines?symbol=${encodeURIComponent(p)}&interval=${binance[tf]}&limit=${candles}`,
        rows => {
          const list = rows.map(r => ({ t: r[0], o: +r[1], h: +r[2], l: +r[3], c: +r[4], v: +r[5] }))
          // A pair Binance no longer trades still answers, with its last
          // candles, years old: not a price.
          if (!list.length || Date.now() - list[list.length - 1].t > span[tf] * 3) return fail("not_found")
          done({ name: "", currency: quoteOf(p), closed: false, candles: list })
        }, fail)
      return
    }
    if (stockSource === "twelvedata") {
      if (twelveKey === "") return fail({{ tq "needs_key" }})
      if (queue.some(x => x.k === k)) return // in the line already
      queue.push({ k: k, run: () => request(`https://api.twelvedata.com/time_series?symbol=${encodeURIComponent(twelveIndex[symbol] || symbol)}`
        + `&interval=${twelve[tf]}&outputsize=${candles}&timezone=UTC&apikey=${encodeURIComponent(twelveKey)}`,
        o => {
          if (o.status === "error") return fail(o.code === 400 || o.code === 404 ? "not_found" : String(o.message))
          // In UTC (asked for): "2026-09-28" or "2026-09-28 15:30:00".
          const utc = s => Date.parse(s.length === 10 ? s + "T00:00:00Z" : s.replace(" ", "T") + "Z")
          done({
            name: "",
            currency: o.meta && o.meta.currency || "USD",
            closed: false,
            candles: o.values.slice().reverse().map(v => ({
              t: utc(v.datetime), o: +v.open, h: +v.high, l: +v.low, c: +v.close, v: +(v.volume || 0),
            })),
          })
        }, fail) })
      pace.start()
      return
    }
    const [interval, range, group] = yahoo[tf]
    request(`https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(symbol)}?interval=${interval}&range=${range}`,
      o => {
        const r = o.chart && o.chart.result && o.chart.result[0]
        if (!r) return fail("not_found")
        const q = r.indicators.quote[0]
        let list = []
        for (let i = 0; i < (r.timestamp || []).length; i++)
          if (q.close[i] !== null && q.open[i] !== null)
            list.push({ t: r.timestamp[i] * 1000, o: q.open[i], h: q.high[i], l: q.low[i], c: q.close[i], v: q.volume[i] || 0 })
        const offset = (r.meta.gmtoffset || 0) * 1000
        list = settle(list, group > 1 ? span["1H"] : span[tf], tf === "1M", offset)
        if (group > 1) list = regroup(list, group, offset)
        const period = r.meta.currentTradingPeriod && r.meta.currentTradingPeriod.regular
        const now = Date.now()
        done({
          name: r.meta.shortName || r.meta.longName || "",
          currency: r.meta.currency || "USD",
          closed: !!period && (now < period.start * 1000 || now > period.end * 1000),
          candles: list.slice(-candles),
        })
      }, fail)
  }

  // Yahoo ends a series with what isn't a candle of its own: the closing
  // print (a flat bar with no volume after the last one) and, for weeks
  // and months, today's quote as a row of its own (for months: in the same
  // month as the last candle). The first goes; the second is the last
  // candle's latest price.
  function settle(list, each, monthly, offset) {
    // The month where the exchange is.
    const month = t => new Date(t + offset).toISOString().slice(0, 7)
    while (list.length > 1) {
      const last = list[list.length - 1], prev = list[list.length - 2]
      if (last.v === 0 && last.o === last.c && last.h === last.l) {
        list.pop()
        continue
      }
      if (last.t - prev.t < each * 0.9 || (monthly && month(last.t) === month(prev.t))) {
        prev.c = last.c
        prev.h = Math.max(prev.h, last.h)
        prev.l = Math.min(prev.l, last.l)
        list.pop()
        continue
      }
      break
    }
    return list
  }

  // Hourly candles into candles of n hours, never across a day.
  function regroup(list, n, offset) {
    const out = []
    let day = "", count = 0
    for (const c of list) {
      const d = new Date(c.t + offset).toISOString().slice(0, 10)
      if (d !== day || count === n) {
        out.push(Object.assign({}, c))
        day = d
        count = 1
        continue
      }
      const g = out[out.length - 1]
      g.h = Math.max(g.h, c.h)
      g.l = Math.min(g.l, c.l)
      g.c = c.c
      g.v += c.v
      count++
    }
    return out
  }

  function change(c) { return c.o ? (c.c - c.o) / c.o : NaN }

  // Stored at once; told (version) once the ones arriving together are in:
  // twenty rows repaint once, not twenty times.
  function put(k, s) {
    series[k] = s
    tell.restart()
  }

  Timer {
    id: tell
    interval: 60
    onTriggered: root.version++
  }

  // Twelve Data's free plan takes 8 requests a minute: one every 8 seconds,
  // each series once in the line.
  property var queue: []
  Timer {
    id: pace
    interval: 8000
    repeat: true
    triggeredOnStart: true
    onTriggered: {
      const next = root.queue.shift()
      if (next) next.run()
      else stop()
    }
  }

  // Stablecoins and wrapped or staked copies of other coins: not what one
  // watches the market for.
  readonly property var stable: ["USDT", "USDC", "USDS", "DAI", "FDUSD", "USDE", "TUSD", "PYUSD", "USD1", "USDD", "BUSD",
    "GUSD", "USDP", "FRAX", "RLUSD", "USDX", "USDF", "BFUSD", "USDG", "USDTB", "SUSDE", "SUSDS"]

  function copyOfAnother(t) {
    return /^(wrapped|coinbase wrapped|lido|staked|binance staked|wrapped liquid)/i.test(t.name)
      || ["WBTC", "WETH", "STETH", "WSTETH", "WEETH", "CBBTC", "RETH", "METH", "WBETH", "JITOSOL", "MSOL", "BSOL"].includes(t.symbol)
  }

  function fetchTop(force) {
    if (!force && Date.now() - topAt < 5 * 60 * 1000) return
    topAt = Date.now()
    request("https://api.coinpaprika.com/v1/tickers?limit=60", list => {
      const next = list
        .filter(t => !hideStable || (!stable.includes(t.symbol) && !copyOfAnother(t)))
        .slice(0, 20)
        .map(t => ({ rank: t.rank, symbol: t.symbol, name: t.name, price: t.quotes.USD.price, change24: t.quotes.USD.percent_change_24h / 100 }))
      top = next
      topError = ""
      // A coin new to the list: its candles now, not at the next refresh.
      if (browsing && browsingTab === "crypto")
        for (const r of top)
          if (!series[key("crypto", r.symbol, cryptoTf)]) fetch("crypto", r.symbol, cryptoTf)
    }, why => {
      topAt = 0 // try again at the next refresh
      topError = why === "not_found" ? {{ tq "bad_response" }} : why
    })
  }

  function refresh() {
    if (!loaded) return
    const want = new Map()
    const add = (kind, symbol, tf) => want.set(key(kind, symbol, tf), [kind, symbol, tf])
    for (const e of main)
      if ((e.pinned && barOn) || browsing) add(e.kind, e.symbol, e.tf)
    if (browsing && browsingTab === "crypto") {
      fetchTop(false)
      for (const r of cryptoRows()) add("crypto", r.symbol, cryptoTf)
    }
    if (browsing && browsingTab === "stocks")
      for (const s of stocks) add("stock", s, stocksTf)
    if (browsing && detail) add(detail.kind, detail.symbol, detail.tf)
    for (const [kind, symbol, tf] of want.values()) fetch(kind, symbol, tf)
  }

  onBrowsingChanged: if (browsing) refresh()
  // Back online: the prices now, not at the next turn of the timer.
  Connections {
    target: Online
    function onBack() { root.refresh() }
  }
  onBrowsingTabChanged: if (browsing) refresh()
  onCryptoTfChanged: if (browsing) refresh()
  onStocksTfChanged: if (browsing) refresh()
  onDetailChanged: if (detail) fetch(detail.kind, detail.symbol, detail.tf)

  // Symbols matching what's typed: stocks from Yahoo's search, crypto from
  // CoinPaprika's. done gets [{symbol, name}].
  function search(kind, text, done) {
    const q = encodeURIComponent(text)
    if (kind === "stock")
      request(`https://query1.finance.yahoo.com/v1/finance/search?q=${q}&quotesCount=8&newsCount=0`,
        o => done((o.quotes || []).filter(x => ["EQUITY", "ETF", "INDEX", "MUTUALFUND"].includes(x.quoteType))
          .map(x => ({ symbol: x.symbol, name: x.shortname || x.longname || "" }))), () => done([]))
    else
      request(`https://api.coinpaprika.com/v1/search?q=${q}&c=currencies&limit=8`,
        o => done((o.currencies || []).map(x => ({ symbol: x.symbol, name: x.name }))), () => done([]))
  }

  // Checks a symbol before it's added: done() when there's a chart for it,
  // fail(why) when not.
  property var checking: []
  function check(kind, symbol, tf, done, fail) {
    if (!valid(kind, symbol)) return fail({{ tq "not_found" }}.arg(symbol))
    const k = key(kind, symbol, tf)
    checking.push({ k: k, done: done, fail: fail })
    fetch(kind, symbol, tf)
    settleChecks() // one that failed at once (no key) needn't wait
  }
  function settleChecks() {
    const still = []
    for (const c of checking) {
      const s = series[c.k]
      if (!s || s.loading) still.push(c)
      else if (s.error) c.fail(s.error)
      else c.done()
    }
    checking = still
  }
  onVersionChanged: if (checking.length) settleChecks()

  // --- numbers as the language writes them --------------------------------------

  // Two decimals from 1 up; below, four significant digits (0.3344,
  // 0.000004123): a meme coin's price moves in its last digits.
  function decimals(v) {
    const a = Math.abs(v)
    if (a >= 1 || a === 0) return 2
    return Math.min(12, Math.ceil(-Math.log10(a)) + 3)
  }

  function price(v) {
    return v === undefined || v === null || isNaN(v) ? "—" : Number(v).toLocaleString(locale, "f", decimals(v))
  }

  // 97,216 -> 97.2k; the units in the language's words.
  function scaled(v, digits) {
    const a = Math.abs(v)
    if (a >= 1e9) return {{ tq "unit.billion" }}.arg(Number(v / 1e9).toLocaleString(locale, "f", 2))
    if (a >= 1e6) return {{ tq "unit.million" }}.arg(Number(v / 1e6).toLocaleString(locale, "f", 2))
    if (a >= 1e4) return {{ tq "unit.thousand" }}.arg(Number(v / 1e3).toLocaleString(locale, "f", digits))
    return null
  }

  // For the bar.
  function compact(v) {
    if (v === undefined || v === null || isNaN(v)) return "—"
    return scaled(v, 1) || price(v)
  }

  function percent(v) {
    if (v === undefined || v === null || isNaN(v)) return "—"
    return (v >= 0 ? "▲ " : "▼ ") + Number(Math.abs(v) * 100).toLocaleString(locale, "f", 2) + "%"
  }

  function volume(v) {
    if (!v) return "—"
    return scaled(v, 1) || Number(v).toLocaleString(locale, "f", 0)
  }

  // A candle's time, as the language writes dates.
  function when(t, tf) {
    const d = new Date(t)
    if (tf === "1M") return d.toLocaleDateString(locale, "MMM yyyy")
    if (tf === "1W" || tf === "1D") return d.toLocaleDateString(locale, Locale.ShortFormat)
    return d.toLocaleString(locale, Locale.ShortFormat)
  }

  // Index symbols have names people know better.
  function label(symbol) {
    return ({ "^GSPC": "S&P 500", "^IXIC": "Nasdaq", "^DJI": "Dow Jones", "^RUT": "Russell 2000", "^VIX": "VIX" })[symbol] || symbol
  }

  // --- the file ------------------------------------------------------------------

  FileView {
    id: store
    path: root.dir + "/watchlist.json"
    watchChanges: true
    atomicWrites: true
    printErrors: false
    onFileChanged: reload()
    onLoaded: {
      const t = text()
      if (t === root.written) return // our own save
      let o
      try {
        o = JSON.parse(t)
      } catch (e) {
        o = null
      }
      if (!o || typeof o !== "object") {
        root.fileError = {{ tq "file_error" }}.arg(path)
        root.loaded = true
        return
      }
      root.use(o)
    }
    // Not there yet: the defaults, written on the first change.
    onLoadFailed: root.use(root.defaults)
  }

  Component.onCompleted: Quickshell.execDetached(["mkdir", "-p", root.dir])

  Timer {
    interval: root.refreshSeconds * 1000
    running: root.loaded
    repeat: true
    onTriggered: root.refresh()
  }
}
