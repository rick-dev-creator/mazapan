// Generated by myarch (plugin {{ plugin }}).
//
// Markets: on the left a list (Main: yours, each symbol in its own
// timeframe; Crypto: the top 20 by market cap and yours; Stocks: yours),
// each row with its trend, price and the current candle's change; on the
// right the chosen one's chart, in any timeframe. Edit adds (with search),
// removes, reorders, changes timeframes and pins to the bar.

import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Wayland
import Quickshell.Hyprland
import qs
import "../components/kit"
import "../components/markets"

Item {
  id: root

  property bool open: false
  property string tab: "main"
  property bool editing: false
  property var chosen: null // {kind, symbol, tf, name}
  property string detailTf: "1D"
  property var screenAtOpen: null

  // Adding: what's typed, as what, in which timeframe; what the search found.
  property string addKind: "crypto"
  property string addTf: "1D"
  property var suggestions: []
  property string addError: ""
  property bool adding: false

  // The list's rows: only what they are (prices come from the service),
  // and a new list only when that changes, so the list keeps its place
  // (and its scroll) while prices come and go.
  property var rows: []
  readonly property var rowsNow: {
    if (tab === "main")
      return MarketsService.main.map((e, i) => ({ kind: e.kind, symbol: e.symbol, tf: e.tf, pinned: e.pinned, index: i, name: e.name }))
    if (tab === "crypto")
      return MarketsService.cryptoRows().map(r => Object.assign({ tf: MarketsService.cryptoTf }, r))
    return MarketsService.stocks.map(s => ({ kind: "stock", symbol: s, tf: MarketsService.stocksTf, name: "" }))
  }
  onRowsNowChanged: {
    if (JSON.stringify(rowsNow) === JSON.stringify(rows)) return
    const y = list.contentY
    const sameTab = rowsTab === tab
    rows = rowsNow
    rowsTab = tab
    if (sameTab) Qt.callLater(() => list.contentY = Math.max(0, Math.min(y, list.contentHeight - list.height)))
  }
  property string rowsTab: ""
  Component.onCompleted: {
    rows = rowsNow
    rowsTab = tab
  }
  readonly property var detail: chosen ? MarketsService.get(chosen.kind, chosen.symbol, detailTf) : null
  readonly property bool detailCharted: !!detail && !!detail.candles && detail.candles.length > 1
  // A top-20 coin Binance doesn't trade: CoinPaprika's price and 24-hour change.
  readonly property var detailFallback: chosen && chosen.kind === "crypto" && !detailCharted ? MarketsService.topFor(chosen.symbol) : null
  readonly property var shownCandle: detail && detail.candles && detail.candles.length
    ? (chart.hovered || detail.candles[detail.candles.length - 1]) : null

  function toggle() {
    if (open) close()
    else show()
  }

  function show() {
    screenAtOpen = Quickshell.screens.find(s => Hyprland.focusedMonitor && s.name === Hyprland.focusedMonitor.name) ?? Quickshell.screens[0]
    open = true
    MarketsService.browsingTab = tab
    MarketsService.browsing = true
    if (!chosen && rows.length) choose(rows[0])
    Qt.callLater(() => list.forceActiveFocus())
  }

  function close() {
    open = false
    editing = false
    MarketsService.browsing = false
  }

  // Out of editing, the keys are the list's again.
  onEditingChanged: if (!editing) list.forceActiveFocus()

  onTabChanged: {
    MarketsService.browsingTab = tab
    addKind = tab === "stocks" ? "stock" : "crypto"
    suggestions = []
    addError = ""
    Qt.callLater(() => { if (rows.length && !rows.some(r => same(r, chosen))) choose(rows[0]) })
  }

  function same(a, b) { return !!a && !!b && a.kind === b.kind && a.symbol === b.symbol && a.tf === b.tf }

  function choose(r) {
    chosen = { kind: r.kind, symbol: r.symbol, tf: r.tf, name: r.name || "" }
    detailTf = r.tf
    MarketsService.detail = { kind: r.kind, symbol: r.symbol, tf: r.tf }
  }

  onDetailTfChanged: if (chosen) MarketsService.detail = { kind: chosen.kind, symbol: chosen.symbol, tf: detailTf }

  // A symbol from a row's star: in Main in this tab's timeframe, or out again.
  function star(r) {
    const i = MarketsService.main.findIndex(e => e.kind === r.kind && e.symbol === r.symbol && e.tf === r.tf)
    if (i >= 0) MarketsService.removeMain(i)
    else MarketsService.addMain(r.kind, r.symbol, r.tf, r.name || "")
  }

  function add(symbol, name) {
    const s = symbol.trim().toUpperCase()
    if (s === "" || adding) return
    // Where it goes is where it was asked for, whatever tab is shown when
    // the check comes back.
    const into = tab
    const kind = into === "main" ? addKind : into === "crypto" ? "crypto" : "stock"
    const tf = into === "main" ? addTf : into === "crypto" ? MarketsService.cryptoTf : MarketsService.stocksTf
    if (into === "main" && MarketsService.has(kind, s, tf)) {
      addError = {{ tq "duplicate" }}.arg(s).arg(tf)
      return
    }
    adding = true
    addError = ""
    MarketsService.check(kind, s, tf, () => {
      adding = false
      if (into === "main") MarketsService.addMain(kind, s, tf, name || "")
      else MarketsService.addTo(into, s)
      field.text = ""
      suggestions = []
    }, why => {
      adding = false
      addError = why
    })
  }

  readonly property var glyphs: ({
    star: String.fromCodePoint(0xF04CE), starOff: String.fromCodePoint(0xF04D2),
    pin: String.fromCodePoint(0xF0403), up: String.fromCodePoint(0xF005D), down: String.fromCodePoint(0xF0045),
    remove: String.fromCodePoint(0xF0156), refresh: String.fromCodePoint(0xF0450),
  })

  // A glyph that's a button.
  component IconButton: Rectangle {
    id: ib
    property string glyph: ""
    property bool active: false
    property color tint: Theme.fgMuted
    signal clicked()
    implicitWidth: 24
    implicitHeight: 24
    radius: Theme.radius
    color: iba.containsMouse ? Theme.surface : "transparent"
    Glyph {
      anchors.centerIn: parent
      text: ib.glyph
      color: ib.active ? Theme.accentText : ib.tint
      font.pointSize: 11
    }
    MouseArea {
      id: iba
      anchors.fill: parent
      hoverEnabled: true
      cursorShape: Qt.PointingHandCursor
      onClicked: ib.clicked()
    }
  }

  // The change, as a colored pill.
  component Pill: Rectangle {
    id: pill
    property real change: NaN
    readonly property color tone: isNaN(change) ? Theme.fgSubtle : change >= 0 ? Theme.success : Theme.danger
    implicitWidth: pillText.implicitWidth + 12
    implicitHeight: pillText.implicitHeight + 4
    radius: Theme.radius
    color: Qt.rgba(tone.r, tone.g, tone.b, 0.16)
    Label {
      id: pillText
      anchors.centerIn: parent
      text: MarketsService.percent(pill.change)
      color: pill.tone
    }
  }

  // A small choice: a timeframe, a kind.
  component Chip: Rectangle {
    id: chip
    property string text: ""
    property bool on: false
    signal clicked()
    implicitWidth: chipText.implicitWidth + 12
    implicitHeight: 22
    radius: Theme.radius
    color: on ? Theme.accent : ca.containsMouse ? Theme.surface : "transparent"
    border.color: on ? Theme.accent : Theme.border
    border.width: 1
    Label {
      id: chipText
      anchors.centerIn: parent
      text: chip.text
      color: chip.on ? Theme.accentFg : Theme.fgMuted
    }
    MouseArea {
      id: ca
      anchors.fill: parent
      hoverEnabled: true
      cursorShape: Qt.PointingHandCursor
      onClicked: chip.clicked()
    }
  }

  // Timeframe chips: the one chosen, and a way to pick another.
  component Timeframes: Row {
    id: tfs
    property string current: ""
    signal picked(string tf)
    spacing: 3
    Repeater {
      model: MarketsService.timeframes
      Chip {
        required property string modelData
        text: modelData
        on: tfs.current === modelData
        onClicked: tfs.picked(modelData)
      }
    }
  }

  component Stat: ColumnLayout {
    property string name: ""
    property string value: ""
    spacing: 0
    Caption { text: parent.name }
    Label { text: parent.value }
  }

  PanelWindow {
    id: win
    visible: root.open
    screen: root.screenAtOpen
    implicitWidth: Math.min(1180, (screen ? screen.width : 1280) * 0.9)
    implicitHeight: Math.min(720, (screen ? screen.height : 900) * 0.85)
    color: "transparent"
    exclusionMode: ExclusionMode.Ignore
    WlrLayershell.layer: WlrLayer.Overlay
    // "myarch-panel-…": SUPER + Q closes it (see hypr-base).
    WlrLayershell.namespace: "myarch-panel-markets"
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

    Rectangle {
      anchors.fill: parent
      color: Theme.surfaceRaised
      border.color: Theme.border
      border.width: 1
      radius: Theme.radius

      RowLayout {
        anchors.fill: parent
        anchors.margins: 16
        spacing: 16

        // --- the list -------------------------------------------------------------
        ColumnLayout {
          // Narrower on a small screen: the chart needs room too.
          readonly property int w: Math.min(470, Math.round(win.width * 0.44))
          Layout.preferredWidth: w
          Layout.minimumWidth: w
          Layout.maximumWidth: w
          Layout.fillHeight: true
          spacing: 10

          RowLayout {
            Layout.fillWidth: true
            Caption { text: {{ tq "title" }}.toUpperCase() }
            Item { Layout.fillWidth: true }
            Caption {
              text: MarketsService.updated !== "" ? {{ tq "updated" }}.arg(MarketsService.updated) : {{ tq "loading" }}
            }
            IconButton {
              glyph: root.glyphs.refresh
              onClicked: MarketsService.refresh()
            }
          }

          RowLayout {
            Layout.fillWidth: true
            spacing: 6
            Repeater {
              model: [["main", {{ tq "tab.main" }}], ["crypto", {{ tq "tab.crypto" }}], ["stocks", {{ tq "tab.stocks" }}]]
              Button {
                required property var modelData
                text: modelData[1]
                primary: root.tab === modelData[0]
                onClicked: root.tab = modelData[0]
              }
            }
            Item { Layout.fillWidth: true }
            Button {
              text: root.editing ? {{ tq "done" }} : {{ tq "edit" }}
              primary: root.editing
              onClicked: {
                root.editing = !root.editing
                if (root.editing) field.focusInput()
              }
            }
          }

          // Crypto and Stocks: every row in one timeframe.
          Timeframes {
            visible: root.tab !== "main"
            current: root.tab === "crypto" ? MarketsService.cryptoTf : MarketsService.stocksTf
            onPicked: tf => {
              if (root.tab === "crypto") MarketsService.cryptoTf = tf
              else MarketsService.stocksTf = tf
              if (root.chosen) root.choose(Object.assign({}, root.chosen, { tf: tf }))
            }
          }

          // Adding a symbol.
          ColumnLayout {
            visible: root.editing
            Layout.fillWidth: true
            spacing: 6

            RowLayout {
              Layout.fillWidth: true
              spacing: 6
              TextField {
                id: field
                Layout.fillWidth: true
                placeholder: root.tab === "stocks" || (root.tab === "main" && root.addKind === "stock")
                  ? {{ tq "add.stock" }} : {{ tq "add.crypto" }}
                onTextChanged: {
                  root.addError = ""
                  searchLater.restart()
                }
                onAccepted: root.add(text)
                Keys.onEscapePressed: root.editing = false
              }
              Button {
                text: root.adding ? "…" : {{ tq "add" }}
                primary: true
                onClicked: root.add(field.text)
              }
            }
            RowLayout {
              visible: root.tab === "main"
              spacing: 6
              Chip {
                text: {{ tq "kind.crypto" }}
                on: root.addKind === "crypto"
                onClicked: {
                  root.addKind = "crypto"
                  searchLater.restart()
                }
              }
              Chip {
                text: {{ tq "kind.stock" }}
                on: root.addKind === "stock"
                onClicked: {
                  root.addKind = "stock"
                  searchLater.restart()
                }
              }
              Item { width: 6 }
              Timeframes {
                current: root.addTf
                onPicked: tf => root.addTf = tf
              }
            }
            Repeater {
              model: root.suggestions
              Rectangle {
                required property var modelData
                Layout.fillWidth: true
                implicitHeight: 26
                radius: Theme.radius
                color: sa.containsMouse ? Theme.surface : "transparent"
                RowLayout {
                  anchors.fill: parent
                  anchors.leftMargin: 8
                  anchors.rightMargin: 8
                  Label { text: modelData.symbol; font.bold: true }
                  Label {
                    text: modelData.name
                    color: Theme.fgMuted
                    Layout.fillWidth: true
                  }
                }
                MouseArea {
                  id: sa
                  anchors.fill: parent
                  hoverEnabled: true
                  cursorShape: Qt.PointingHandCursor
                  onClicked: root.add(modelData.symbol, modelData.name)
                }
              }
            }
            Label {
              visible: root.addError !== ""
              text: root.addError
              color: Theme.danger
              wrapMode: Text.Wrap
              Layout.fillWidth: true
              Layout.preferredWidth: 0 // wraps, never widens the column
            }
            Timer {
              id: searchLater
              interval: 350
              onTriggered: {
                const t = field.text.trim()
                if (t.length < 1) {
                  root.suggestions = []
                  return
                }
                const kind = root.tab === "main" ? root.addKind : root.tab === "crypto" ? "crypto" : "stock"
                MarketsService.search(kind, t, found => { if (field.text.trim() === t) root.suggestions = found.slice(0, 6) })
              }
            }
          }

          Label {
            visible: MarketsService.fileError !== ""
            text: MarketsService.fileError
            color: Theme.danger
            wrapMode: Text.Wrap
            Layout.fillWidth: true
            Layout.preferredWidth: 0 // wraps, never widens the column
          }

          Caption {
            visible: root.tab === "crypto"
            text: MarketsService.topError !== "" ? MarketsService.topError : {{ tq "top" }}
            color: MarketsService.topError !== "" ? Theme.danger : Theme.fgSubtle
          }

          ListView {
            id: list
            Layout.fillWidth: true
            Layout.fillHeight: true
            clip: true
            spacing: 2
            model: root.rows
            currentIndex: Math.max(0, root.rows.findIndex(r => root.same(r, root.chosen)))
            boundsBehavior: Flickable.StopAtBounds
            focus: true

            Keys.onPressed: event => {
              const n = root.rows.length
              if (event.key === Qt.Key_Down || event.key === Qt.Key_J) {
                if (n) root.choose(root.rows[Math.min(n - 1, currentIndex + 1)])
              } else if (event.key === Qt.Key_Up || event.key === Qt.Key_K) {
                if (n) root.choose(root.rows[Math.max(0, currentIndex - 1)])
              } else if (event.key === Qt.Key_E) {
                root.editing = !root.editing
                if (root.editing) field.focusInput()
              } else if (event.key === Qt.Key_Tab) {
                root.tab = ({ main: "crypto", crypto: "stocks", stocks: "main" })[root.tab]
              } else if (event.key === Qt.Key_Escape) {
                if (root.editing) root.editing = false
                else root.close()
              } else return
              event.accepted = true
            }

            delegate: Rectangle {
              id: row
              required property var modelData
              readonly property var r: modelData
              readonly property var q: MarketsService.get(r.kind, r.symbol, r.tf)
              readonly property bool charted: !!q && !!q.candles && q.candles.length > 1
              // A coin Binance doesn't trade: CoinPaprika's price and 24-hour change.
              readonly property var fallback: !charted && r.kind === "crypto" ? MarketsService.topFor(r.symbol) : null
              readonly property real price: charted ? q.price : fallback ? fallback.price : NaN
              readonly property real change: charted ? q.change : fallback ? fallback.change24 : NaN
              readonly property bool failed: !!q && !!q.error && !charted && !fallback
              readonly property bool starred: root.tab !== "main" && MarketsService.has(r.kind, r.symbol, r.tf)
              readonly property bool chosenOne: root.same(r, root.chosen)
              readonly property bool editMain: root.editing && root.tab === "main"
              width: ListView.view.width
              height: editMain ? 82 : 56
              radius: Theme.radius
              color: chosenOne ? Theme.selection : area.containsMouse ? Theme.surface : "transparent"

              MouseArea {
                id: area
                anchors.fill: parent
                hoverEnabled: true
                onClicked: {
                  root.choose(row.r)
                  list.forceActiveFocus()
                }
              }

              ColumnLayout {
                anchors.fill: parent
                anchors.margins: 8
                spacing: 6

                RowLayout {
                  Layout.fillWidth: true
                  spacing: 10

                  ColumnLayout {
                    Layout.preferredWidth: 128
                    Layout.maximumWidth: 128
                    spacing: 2
                    RowLayout {
                      spacing: 6
                      Label {
                        text: MarketsService.label(row.r.symbol)
                        font.bold: true
                        elide: Text.ElideRight
                        Layout.maximumWidth: 90
                      }
                      Caption {
                        text: root.tab === "main" ? row.r.tf : row.r.rank ? "#" + row.r.rank : ""
                        color: Theme.accentText
                      }
                    }
                    Caption {
                      text: row.failed ? row.q.error
                        : (row.q && row.q.name) || row.r.name || (row.r.kind === "crypto" ? MarketsService.nameOf(row.r.symbol) || {{ tq "kind.crypto" }} : row.r.symbol)
                      color: row.failed ? Theme.danger : Theme.fgSubtle
                      elide: Text.ElideRight
                      Layout.fillWidth: true
                    }
                  }

                  Sparkline {
                    Layout.fillWidth: true
                    Layout.preferredHeight: 30
                    values: row.charted ? row.q.candles.slice(-48).map(c => c.c) : []
                    color: isNaN(row.change) ? Theme.fgSubtle : row.change >= 0 ? Theme.success : Theme.danger
                  }

                  ColumnLayout {
                    Layout.preferredWidth: 104
                    spacing: 2
                    Label {
                      Layout.alignment: Qt.AlignRight
                      text: MarketsService.price(row.price) + (row.q && row.q.currency && row.q.currency !== "USD" ? " " + row.q.currency : "")
                    }
                    Pill {
                      Layout.alignment: Qt.AlignRight
                      change: row.change
                    }
                  }

                  IconButton {
                    visible: root.tab !== "main" && !root.editing
                    glyph: row.starred ? root.glyphs.star : root.glyphs.starOff
                    active: row.starred
                    onClicked: root.star(row.r)
                  }
                  IconButton {
                    // The top 20 come and go on their own; yours are removed.
                    visible: root.editing && root.tab !== "main" && (root.tab === "stocks" || row.r.yours === true)
                    glyph: root.glyphs.remove
                    tint: Theme.danger
                    onClicked: MarketsService.removeFrom(root.tab, row.r.symbol)
                  }
                }

                // Editing Main: its timeframe, the bar, its place, out.
                RowLayout {
                  visible: row.editMain
                  Layout.fillWidth: true
                  spacing: 4
                  Timeframes {
                    current: row.r.tf
                    onPicked: tf => {
                      if (!MarketsService.has(row.r.kind, row.r.symbol, tf)) MarketsService.changeMain(row.r.index, { tf: tf })
                    }
                  }
                  Item { Layout.fillWidth: true }
                  IconButton {
                    glyph: root.glyphs.pin
                    active: row.r.pinned === true
                    onClicked: MarketsService.pin(row.r.index, row.r.pinned !== true)
                  }
                  IconButton {
                    glyph: root.glyphs.up
                    onClicked: MarketsService.moveMain(row.r.index, -1)
                  }
                  IconButton {
                    glyph: root.glyphs.down
                    onClicked: MarketsService.moveMain(row.r.index, 1)
                  }
                  IconButton {
                    glyph: root.glyphs.remove
                    tint: Theme.danger
                    onClicked: MarketsService.removeMain(row.r.index)
                  }
                }
              }
            }

            Label {
              anchors.centerIn: parent
              visible: root.rows.length === 0
              text: root.tab === "crypto" && MarketsService.top.length === 0 ? {{ tq "loading" }} : {{ tq "empty" }}
              color: Theme.fgSubtle
            }
          }

          Caption { text: {{ tq "hints" }} }
        }

        Rule { Layout.fillWidth: false; Layout.fillHeight: true; implicitWidth: 1 }

        // --- the chart ------------------------------------------------------------
        ColumnLayout {
          Layout.fillWidth: true
          Layout.fillHeight: true
          Layout.minimumWidth: 0
          Layout.preferredWidth: 0 // what's left: never wider than that
          spacing: 12

          Label {
            visible: !root.chosen
            text: {{ tq "pick" }}
            color: Theme.fgSubtle
          }

          RowLayout {
            visible: !!root.chosen
            Layout.fillWidth: true
            spacing: 12
            ColumnLayout {
              spacing: 2
              Label {
                text: root.chosen ? MarketsService.label(root.chosen.symbol) : ""
                font.bold: true
                font.pointSize: 16
              }
              Caption {
                text: root.chosen ? [
                  (root.detail && root.detail.name) || root.chosen.name || (root.chosen.kind === "crypto" ? MarketsService.nameOf(root.chosen.symbol) : ""),
                  (root.detail && root.detail.currency) || (root.chosen.kind === "crypto" ? "USD" : ""),
                  root.detail && root.detail.closed ? {{ tq "closed" }} : "",
                ].filter(x => x).join("  ·  ") : ""
              }
            }
            Item { Layout.fillWidth: true }
            ColumnLayout {
              spacing: 4
              Label {
                Layout.alignment: Qt.AlignRight
                text: root.detailCharted ? MarketsService.price(root.detail.price)
                  : root.detailFallback ? MarketsService.price(root.detailFallback.price) : "…"
                font.bold: true
                font.pointSize: 16
              }
              Pill {
                Layout.alignment: Qt.AlignRight
                change: root.detailCharted ? root.detail.change : root.detailFallback ? root.detailFallback.change24 : NaN
              }
            }
          }

          RowLayout {
            visible: !!root.chosen
            Layout.fillWidth: true
            Timeframes {
              current: root.detailTf
              onPicked: tf => root.detailTf = tf
            }
            Item { Layout.fillWidth: true }
            Caption {
              text: root.shownCandle ? MarketsService.when(root.shownCandle.t, root.detailTf) : ""
            }
          }

          Label {
            visible: !root.detailCharted && (!!root.detailFallback || (!!root.detail && !!root.detail.error))
            text: root.detailFallback ? {{ tq "no_chart" }} : root.detail ? root.detail.error : ""
            color: root.detailFallback ? Theme.fgMuted : Theme.danger
            wrapMode: Text.Wrap
            Layout.fillWidth: true
          }

          CandleChart {
            id: chart
            visible: !!root.chosen
            Layout.fillWidth: true
            Layout.fillHeight: true
            line: {{ quote settings.chart }} === "line"
            candles: root.detail && root.detail.candles ? root.detail.candles : []
          }

          // The candle under the pointer, or the current one; and the whole
          // chart's range.
          Flow {
            visible: !!root.shownCandle
            Layout.fillWidth: true
            spacing: 18
            Stat { name: {{ tq "open" }}; value: root.shownCandle ? MarketsService.price(root.shownCandle.o) : "" }
            Stat { name: {{ tq "high" }}; value: root.shownCandle ? MarketsService.price(root.shownCandle.h) : "" }
            Stat { name: {{ tq "low" }}; value: root.shownCandle ? MarketsService.price(root.shownCandle.l) : "" }
            Stat { name: {{ tq "close" }}; value: root.shownCandle ? MarketsService.price(root.shownCandle.c) : "" }
            Stat { name: {{ tq "volume" }}; value: root.shownCandle ? MarketsService.volume(root.shownCandle.v) : "" }
            Stat {
              name: {{ tq "range" }}
              value: root.detail && root.detail.candles && root.detail.candles.length
                ? MarketsService.price(Math.min(...root.detail.candles.map(c => c.l))) + " – " + MarketsService.price(Math.max(...root.detail.candles.map(c => c.h)))
                : ""
            }
          }
        }
      }
    }
  }
}
