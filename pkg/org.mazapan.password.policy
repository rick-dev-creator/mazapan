<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- What the password dialog says when `mazapan password` changes the disk's
     and the account's password (the only thing mazapan runs through pkexec
     itself). Asked every time: never kept. -->
<policyconfig>
  <vendor>mazapan</vendor>
  <action id="org.mazapan.password">
    <description>Change your password</description>
    <description xml:lang="es">Cambiar tu contraseña</description>
    <description xml:lang="pt">Trocar sua senha</description>
    <description xml:lang="fr">Changer votre mot de passe</description>
    <description xml:lang="de">Dein Passwort ändern</description>
    <message>Your current password is needed to change it for the disk and your account</message>
    <message xml:lang="es">Se necesita tu contraseña actual para cambiarla en el disco y en tu cuenta</message>
    <message xml:lang="pt">Sua senha atual é necessária para trocá-la no disco e na sua conta</message>
    <message xml:lang="fr">Votre mot de passe actuel est nécessaire pour le changer pour le disque et votre compte</message>
    <message xml:lang="de">Dein aktuelles Passwort wird benötigt, um es für die Festplatte und dein Konto zu ändern</message>
    <icon_name>dialog-password</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mazapan/bin/mazapan</annotate>
  </action>
</policyconfig>
