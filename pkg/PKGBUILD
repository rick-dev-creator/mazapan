# myarch as a package: the core (built beforehand with core/build), the
# built-in plugins, themes and catalog, and what they run. Built from this
# checkout, not downloaded:
#   cd pkg && makepkg
# (iso/build does it for the ISO's own repository.)

pkgname=myarch
pkgver=0.1.0
pkgrel=1
pkgdesc="A desktop on plain Arch: Hyprland + Quickshell, one theme across the whole system, everything a plugin"
arch=(x86_64)
license=(unknown)
options=(!strip !debug)

_repo=$(realpath "${MYARCH_REPO:-$startdir/..}")

# The desktop itself, and what every plugin that's on by default names in
# its [packages] (hardware plugins are off until the machine needs them).
depends=(
  hyprland quickshell qt6-wayland qt6-svg qt6-imageformats xdg-desktop-portal-hyprland
  pipewire pipewire-pulse wireplumber networkmanager polkit
  noto-fonts noto-fonts-emoji ttf-jetbrains-mono-nerd
  git jq curl flatpak power-profiles-daemon gnome-keyring
  $(for f in "$_repo"/plugins/*/plugin.toml; do
      grep -q '^\[hardware' "$f" && continue
      sed -n '/^\[packages\]/,/^\[/{s/^pacman *= *\[\(.*\)\]/\1/p}' "$f"
    done | tr -d '",' | tr ' ' '\n' | sed '/^$/d' | sort -u)
)

pkgver() {
  local n
  n=$(git -C "$_repo" rev-list --count HEAD 2>/dev/null) || { echo 0.1.0; return; }
  printf '0.1.0.r%s.g%s' "$n" "$(git -C "$_repo" rev-parse --short HEAD)"
}

package() {
  [[ -x $_repo/bin/myarch ]] || { echo "no $_repo/bin/myarch: run core/build first" >&2; return 1; }
  # myarch finds its plugins/, themes/ and catalog/ next to the directory
  # its binary is in (through the symlink).
  install -Dm755 "$_repo/bin/myarch" "$pkgdir/usr/lib/myarch/bin/myarch"
  cp -r --no-preserve=ownership "$_repo/plugins" "$_repo/themes" "$_repo/catalog" "$pkgdir/usr/lib/myarch/"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/myarch/bin/myarch "$pkgdir/usr/bin/myarch"
  # The password dialog's words for pacman through pkexec.
  install -Dm644 "$_repo/pkg/org.myarch.pacman.policy" "$pkgdir/usr/share/polkit-1/actions/org.myarch.pacman.policy"
  install -Dm644 "$_repo/README.md" "$pkgdir/usr/share/doc/myarch/README.md"
  cp -r --no-preserve=ownership "$_repo/docs/." "$pkgdir/usr/share/doc/myarch/"
}
