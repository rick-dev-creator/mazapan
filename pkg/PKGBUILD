# mazapan as a package: the core (built beforehand with core/build), the
# built-in plugins, themes and catalog, and what they run. Built from this
# checkout, not downloaded:
#   cd pkg && makepkg
# (iso/build does it for the ISO's own repository.)

pkgname=mazapan
pkgver=0.1.0
pkgrel=1
pkgdesc="A desktop on plain Arch: Hyprland + Quickshell, one theme across the whole system, everything a plugin"
arch=(x86_64)
license=(MIT)
options=(!strip !debug)

_repo=$(realpath "${MAZAPAN_REPO:-$startdir/..}")

# The desktop itself, and what every plugin that's on by default names in
# its [packages] (hardware plugins are off until the machine needs them).
depends=(
  # Its keys: the repository it updates from signs with them.
  mazapan-keyring
  hyprland quickshell qt6-wayland qt6-svg qt6-imageformats xdg-desktop-portal-hyprland
  pipewire pipewire-pulse wireplumber networkmanager polkit
  noto-fonts noto-fonts-emoji ttf-jetbrains-mono-nerd
  git jq curl flatpak power-profiles-daemon gnome-keyring
  $(for f in "$_repo"/plugins/*/plugin.toml; do
      # Hardware and optional plugins' packages come when they're turned on.
      grep -q '^\[hardware' "$f" && continue
      grep -q '^optional *= *true' "$f" && continue
      sed -n '/^\[packages\]/,/^\[/{s/^pacman *= *\[\(.*\)\]/\1/p}' "$f"
    done | tr -d '",' | tr ' ' '\n' | sed '/^$/d' | sort -u)
)

pkgver() {
  "$_repo/pkg/version"
}

package() {
  [[ -x $_repo/bin/mazapan ]] || { echo "no $_repo/bin/mazapan: run core/build first" >&2; return 1; }
  # The binary says the version it was built as: a stale one isn't packaged
  # under a new version.
  local built
  built=$("$_repo/bin/mazapan" --version)
  [[ $built == "mazapan $pkgver" ]] || { echo "bin/mazapan is \"$built\", the package $pkgver: run core/build" >&2; return 1; }
  # mazapan finds its plugins/, themes/ and catalog/ next to the directory
  # its binary is in (through the symlink); community/ too: plugins others
  # made, shipped so they can be installed offline (off until they are, so
  # their packages aren't depends).
  install -Dm755 "$_repo/bin/mazapan" "$pkgdir/usr/lib/mazapan/bin/mazapan"
  cp -r --no-preserve=ownership "$_repo/plugins" "$_repo/community" "$_repo/themes" "$_repo/catalog" "$pkgdir/usr/lib/mazapan/"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/mazapan/bin/mazapan "$pkgdir/usr/bin/mazapan"
  # Mazapan's icon: the mazapán alone, and the app's (on its sunset).
  install -Dm644 "$_repo/assets/mazapan.svg" "$pkgdir/usr/share/pixmaps/mazapan.svg"
  install -Dm644 "$_repo/assets/mazapan-app.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/mazapan.svg"
  # The password dialog's words for pacman through pkexec.
  install -Dm644 "$_repo/pkg/org.mazapan.pacman.policy" "$pkgdir/usr/share/polkit-1/actions/org.mazapan.pacman.policy"
  install -Dm644 "$_repo/pkg/org.mazapan.password.policy" "$pkgdir/usr/share/polkit-1/actions/org.mazapan.password.policy"
  # Where its own updates come from (Pacman.Repository); a test build can
  # point it elsewhere (a file:// repository in a VM).
  install -Dm644 "$_repo/pkg/repository.toml" "$pkgdir/usr/lib/mazapan/pkg/repository.toml"
  if [[ -n ${MAZAPAN_REPO_SERVER:-} ]]; then
    sed -i "s|^server = .*|server = \"$MAZAPAN_REPO_SERVER\"|" "$pkgdir/usr/lib/mazapan/pkg/repository.toml"
  fi
  install -Dm644 "$_repo/README.md" "$pkgdir/usr/share/doc/mazapan/README.md"
  install -Dm644 "$_repo/LICENSE" "$pkgdir/usr/share/licenses/mazapan/LICENSE"
  install -Dm644 "$_repo/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/licenses/mazapan/THIRD_PARTY_NOTICES.md"
  install -Dm644 "$_repo/CHANGELOG.md" "$pkgdir/usr/share/doc/mazapan/CHANGELOG.md"
  cp -r --no-preserve=ownership "$_repo/docs/." "$pkgdir/usr/share/doc/mazapan/"
}
